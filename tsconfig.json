{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "lib": ["ES2015", "DOM", "DOM.Iterable"],
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true
  }
}
