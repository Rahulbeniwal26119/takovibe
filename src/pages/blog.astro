  // Smart image loading with color extraction
  (window as any).handleImageLoad = function(img: HTMLImageElement) {
    try {
      // Extract dominant colors from image
      extractImageColors(img, (colors) => {
        const container = img.closest('[data-image-container]') as HTMLElement;
        const placeholder = container?.querySelector('[data-image-placeholder]') as HTMLElement;
        
        if (container && colors.length > 0) {
          // Create gradient background from extracted colors
          const gradient = createSmartGradient(colors);
          container.style.background = gradient;
        }
        
        // Hide placeholder and show image
        if (placeholder) {
          placeholder.style.opacity = '0';
          setTimeout(() => {
            placeholder.style.display = 'none';
          }, 300);
        }
        
        // Show image with fade-in effect
        img.style.opacity = '1';
      });
    } catch (error) {
      const container = img.closest('[data-image-container]') as HTMLElement;
      const placeholder = container?.querySelector('[data-image-placeholder]') as HTMLElement;
      
      if (placeholder) {
        placeholder.style.display = 'none';
      }
      img.style.opacity = '1';
    }
  };
  
  (window as any).handleImageError = function(img: HTMLImageElement) {
    const container = img.closest('[data-image-container]') as HTMLElement;
    const placeholder = container?.querySelector('[data-image-placeholder]') as HTMLElement;
    
    if (placeholder) {
      // Update placeholder to show error state
      placeholder.innerHTML = `
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-3 rounded-lg bg-gradient-to-br from-red-200 to-orange-200 dark:from-red-800 to-orange-800 flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
          </div>
          <div class="text-sm text-gray-600 dark:text-gray-400 font-medium">Image unavailable</div>
        </div>
      `;
      placeholder.classList.remove('animate-pulse');
    }
    
    // Hide the failed image
    img.style.display = 'none';
  };
  
  // Extract dominant colors from image
  function extractImageColors(img: HTMLImageElement, callback: (colors: string[]) => void) {
    try {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      
      if (!ctx) {
        callback([]);
        return;
      }
      
      // Set small canvas size for performance
      canvas.width = 100;
      canvas.height = 100;
      
      // Draw image to canvas
      ctx.drawImage(img, 0, 0, 100, 100);
      
      // Get image data
      const imageData = ctx.getImageData(0, 0, 100, 100);
      const data = imageData.data;
      
      // Extract colors (sample every 10th pixel for performance)
      const colorCounts: { [key: string]: number } = {};
      
      for (let i = 0; i < data.length; i += 40) { // Sample every 10th pixel (4 bytes per pixel)
        const r = data[i];
        const g = data[i + 1];
        const b = data[i + 2];
        const alpha = data[i + 3];
        
        // Skip transparent or very light/dark pixels
        if (alpha < 128 || (r + g + b) < 50 || (r + g + b) > 650) continue;
        
        // Group similar colors
        const colorKey = `${Math.floor(r/30)*30},${Math.floor(g/30)*30},${Math.floor(b/30)*30}`;
        colorCounts[colorKey] = (colorCounts[colorKey] || 0) + 1;
      }
      
      // Get top 3 most frequent colors
      const sortedColors = Object.entries(colorCounts)
        .sort(([,a], [,b]) => b - a)
        .slice(0, 3)
        .map(([color]) => `rgb(${color})`);
      
      callback(sortedColors);
    } catch (error) {
      console.log('Color extraction error:', error);
      callback([]);
    }
  }
  
  // Create smart gradient from extracted colors
  function createSmartGradient(colors: string[]): string {
    if (colors.length === 0) {
      return 'linear-gradient(135deg, #f3f4f6, #e5e7eb)';
    }
    
    if (colors.length === 1) {
      // Single color - create tonal variations
      const baseColor = colors[0];
      return `linear-gradient(135deg, ${baseColor}, ${adjustColorBrightness(baseColor, -20)}, ${adjustColorBrightness(baseColor, 20)})`;
    }
    
    if (colors.length === 2) {
      return `linear-gradient(135deg, ${colors[0]}, ${colors[1]})`;
    }
    
    // Multiple colors
    return `linear-gradient(135deg, ${colors[0]}, ${colors[1]}, ${colors[2]})`;
  }
  
  // Adjust color brightness
  function adjustColorBrightness(color: string, percent: number): string {
    const rgb = color.match(/\d+/g);
    if (!rgb) return color;
    
    const r = Math.max(0, Math.min(255, parseInt(rgb[0]) + percent));
    const g = Math.max(0, Math.min(255, parseInt(rgb[1]) + percent));
    const b = Math.max(0, Math.min(255, parseInt(rgb[2]) + percent));
    
    return `rgb(${r}, ${g}, ${b})`;
  }
  
