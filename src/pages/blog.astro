---
import Layout from "../layouts/Layout.astro";
import type { APIResponse } from "../types/api";
import type { BlogPost } from "../types/blog";
import { getCollection } from "astro:content";

const searchEndpoint = "https://backend.takovibe.com/api/blogs/blogs/";
const tagsEndpoint = "https://backend.takovibe.com/api/blogs/tags/";

interface TagData {
  tag: string;
  count: number;
}

let posts: BlogPost[] = [];
let totalCount = 0;
let popularTags: TagData[] = [];

// Fetch blog posts
try {
  const response = await fetch(`${searchEndpoint}?paginate=1&page_size=9`);
  if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

  const data = (await response.json()) as APIResponse<BlogPost>;
  posts = data.results || [];
  totalCount = data.count || 0;
} catch (err) {
  posts = null;
  console.error("Failed to fetch posts:", err);
}

// Fetch popular tags
try {
  const tagsResponse = await fetch(tagsEndpoint);
  if (tagsResponse.ok) {
    const tagsData = (await tagsResponse.json()) as {
      data: Record<string, number>;
    };
    if (tagsData.data) {
      popularTags = Object.entries(tagsData.data)
        .map(([tag, count]) => ({ tag, count: Number(count) }))
        .sort((a, b) => b.count - a.count)
        .slice(0, 15);
    }
  }
} catch (err) {
  console.error("Failed to fetch tags:", err);
}

if (posts === null) {
  // Fallback to local content
  const allPosts = await getCollection("blog");
  totalCount = allPosts.length;

  // Filter out unpublished posts and sort by date
  const currentDate = new Date();
  const publishedPosts = allPosts.filter(
    (post) => new Date(post.data.date) <= currentDate,
  );
  posts = publishedPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    uri: `/blog/${post.slug}`,
    slug: post.slug,
    tags: post.data.tags,
    image_url: post.data.image,
    created_at: post.data.date,
    author: {
      name: "Rahul Beniwal",
      username: "rahulbeniwal26119",
    },
  }));
}

// Pagination
const POSTS_PER_PAGE = 9;
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<Layout
  title="All Articles | TakoVibe"
  description="Browse all technical articles, tutorials, and insights about software engineering, system design, and modern development practices."
  tags={[
    "blog",
    "articles",
    "software engineering",
    "tutorials",
    "programming",
  ]}
>
  <div class="relative w-full overflow-x-hidden min-h-screen bg-stone-50 dark:bg-neutral-950">
    <!-- Subtle warm tint — no orbs, no blobs -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute top-0 left-0 right-0 h-[600px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"></div>
    </div>

    <div class="relative z-10 w-full">
      <!-- Masthead -->
      <div class="border-b border-neutral-200 dark:border-neutral-800">
        <div class="max-w-5xl mx-auto px-6 pt-16 pb-10">
          <h1 class="text-4xl md:text-5xl font-bold font-display text-neutral-900 dark:text-neutral-50 mb-3">
            Articles
          </h1>
          <p class="text-neutral-500 dark:text-neutral-400 text-lg max-w-xl">
            Deep dives, tutorials, and insights on software engineering.
          </p>

          <!-- Search -->
          <div class="mt-8 relative max-w-md">
            <input
              type="text"
              id="search-input"
              placeholder="Search articles..."
              class="w-full pl-10 pr-4 py-3 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg text-sm text-neutral-900 dark:text-white placeholder-neutral-400 dark:placeholder-neutral-500 focus:outline-none focus:border-orange-400 dark:focus:border-orange-600 transition-colors"
            />
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Tag Bar -->
      <div class="border-b border-neutral-200 dark:border-neutral-800 sticky top-[64px] z-30 bg-stone-50/90 dark:bg-neutral-950/90 backdrop-blur-md">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-center gap-1 overflow-x-auto scrollbar-hide py-0 -mb-px">
            <button class="tag-filter active" data-tag="all">All</button>
            {
              popularTags.map(({ tag, count }) => (
                <button class="tag-filter" data-tag={tag}>
                  {tag}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="max-w-5xl mx-auto px-6 py-10">
        <!-- Results Count -->
        <div class="mb-6">
          <span
            id="results-count"
            class="text-xs font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wider"
          >
            Latest
          </span>
        </div>

        <!-- Articles Container -->
        <div id="articles-container">
          <!-- Articles will be loaded dynamically via JavaScript -->
        </div>

        <!-- No Results -->
        <div id="no-results" class="hidden text-center py-24">
          <div class="max-w-sm mx-auto">
            <p class="text-5xl mb-4">🔍</p>
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-50 mb-2">
              No articles found
            </h3>
            <p class="text-neutral-500 dark:text-neutral-400 text-sm mb-6">
              Try adjusting your search or filters.
            </p>
            <button
              id="clear-filters-btn"
              class="px-5 py-2 bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 text-sm font-medium rounded-lg hover:opacity-90 transition-opacity"
            >
              Clear Filters
            </button>
          </div>
        </div>

        <!-- Pagination -->
        <div
          id="pagination"
          class="flex items-center justify-center gap-3 mt-16"
        >
          <!-- Pagination will be generated by JavaScript -->
        </div>
      </div>
    </div>
  </div>
</Layout>
<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tag Bar — tab underline style */
  .tag-filter {
    @apply relative px-3 py-3 text-sm font-medium transition-colors duration-200 whitespace-nowrap;
    @apply text-neutral-500 dark:text-neutral-400;
    @apply hover:text-neutral-900 dark:hover:text-neutral-100;
    border-bottom: 2px solid transparent;
  }

  .tag-filter.active {
    @apply text-neutral-900 dark:text-neutral-50;
    border-bottom-color: theme('colors.orange.500');
  }

  /* Hide scrollbar for tag bar */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: #d6d3d1;
    border-radius: 3px;
  }
  .dark ::-webkit-scrollbar-thumb {
    background: #57534e;
  }
</style>

<script>
  // API endpoints
  const API_BASE = import.meta.env.PUBLIC_API_URL + "/api/blogs/blogs/";
  import {
    saveBookmark,
    removeBookmark,
    checkBookmarkStatus,
  } from "../utils/bookmarks";

  let currentPage = 1;
  const ARTICLES_PER_PAGE_MOBILE = 6;
  const ARTICLES_PER_PAGE_DESKTOP = 9;
  let currentArticlesPerPage = ARTICLES_PER_PAGE_MOBILE;
  let currentSearchTerm = "";
  let currentTag = "all";
  let currentSort = "date-desc";
  let totalCount = 0;
  let allArticles = [];

  // Function to get current page size based on screen width
  function getCurrentPageSize() {
    if (typeof window !== "undefined") {
      return window.innerWidth >= 1024
        ? ARTICLES_PER_PAGE_DESKTOP
        : ARTICLES_PER_PAGE_MOBILE;
    }
    return ARTICLES_PER_PAGE_MOBILE;
  }

  // DOM elements
  const searchInput = document.getElementById(
    "search-input",
  ) as HTMLInputElement;
  const articlesContainer = document.getElementById("articles-container");
  const resultsCount = document.getElementById("results-count");
  const noResults = document.getElementById("no-results");
  const pagination = document.getElementById("pagination");
  const clearFiltersBtn = document.getElementById("clear-filters-btn");
  const tagFilters = document.querySelectorAll(".tag-filter");

  // Initialize
  function init() {
    // Read URL parameters on load
    const urlParams = new URLSearchParams(window.location.search);
    const urlTag = urlParams.get("category") || urlParams.get("tag");
    const urlSearch = urlParams.get("q");
    const urlPage = urlParams.get("page");

    // Apply URL parameters
    if (urlTag && urlTag !== "all") {
      currentTag = urlTag;
      tagFilters.forEach((b) => b.classList.remove("active"));
      const matchingTag = document.querySelector(`[data-tag="${urlTag}"]`);
      if (matchingTag) {
        matchingTag.classList.add("active");
      }
    }
    if (urlSearch) {
      currentSearchTerm = urlSearch;
      if (searchInput) searchInput.value = urlSearch;
    }
    if (urlPage) {
      currentPage = parseInt(urlPage) || 1;
    }

    // Event Listeners
    searchInput?.addEventListener(
      "input",
      debounce((e) => {
        currentSearchTerm = (e.target as HTMLInputElement).value;
        currentPage = 1;
        updateURL();
        fetchAndDisplayArticles();
      }, 500),
    );

    tagFilters.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Update active state
        tagFilters.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        currentTag = btn.getAttribute("data-tag") || "all";
        currentPage = 1;
        updateURL();
        fetchAndDisplayArticles();
      });
    });

    clearFiltersBtn?.addEventListener("click", () => {
      currentSearchTerm = "";
      currentTag = "all";
      currentPage = 1;
      if (searchInput) searchInput.value = "";
      tagFilters.forEach((b) => b.classList.remove("active"));
      document.querySelector('[data-tag="all"]')?.classList.add("active");
      updateURL();
      fetchAndDisplayArticles();
    });

    // Initial fetch
    fetchAndDisplayArticles();
  }

  // Update URL without page reload
  function updateURL() {
    const params = new URLSearchParams();

    if (currentSearchTerm) {
      params.set("q", currentSearchTerm);
    }
    if (currentTag && currentTag !== "all") {
      params.set("category", currentTag);
    }
    if (currentPage > 1) {
      params.set("page", currentPage.toString());
    }

    const newURL = params.toString()
      ? `${window.location.pathname}?${params.toString()}`
      : window.location.pathname;

    window.history.pushState({}, "", newURL);
  }

  // Debounce helper
  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Fetch articles from backend
  async function fetchAndDisplayArticles() {
    try {
      // Show loading state
      if (articlesContainer) {
        articlesContainer.innerHTML = `
          <div class="flex justify-center items-center py-24">
            <div class="flex items-center gap-3 text-neutral-400 dark:text-neutral-500">
              <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
              <span class="text-sm">Loading...</span>
            </div>
          </div>
        `;
      }

      currentArticlesPerPage = getCurrentPageSize();

      const params = new URLSearchParams({
        paginate: "1",
        page_size: currentArticlesPerPage.toString(),
        page: currentPage.toString(),
      });

      if (currentSearchTerm) params.set("q", currentSearchTerm);
      if (currentTag !== "all") params.set("tags", currentTag);

      const response = await fetch(`${API_BASE}?${params}`);
      if (!response.ok) throw new Error("Failed to fetch articles");

      const data = await response.json();
      allArticles = data.results || [];
      totalCount = data.count || 0;

      displayArticles();
      updateResultsCount();
      updatePagination();
    } catch (error) {
      console.error("Error fetching articles:", error);
      if (articlesContainer) articlesContainer.innerHTML = "";
      noResults?.classList.remove("hidden");
    }
  }

  // Display articles — magazine layout
  function displayArticles() {
    if (articlesContainer) articlesContainer.innerHTML = "";

    if (allArticles.length === 0) {
      noResults?.classList.remove("hidden");
      pagination?.classList.add("hidden");
      return;
    }

    noResults?.classList.add("hidden");
    pagination?.classList.remove("hidden");

    // First article gets featured treatment (only on page 1 with no search)
    const showFeatured = currentPage === 1 && !currentSearchTerm;

    if (showFeatured && allArticles.length > 0) {
      const featured = createArticleElement(allArticles[0], 0, true);
      articlesContainer?.appendChild(featured);
    }

    // Rest go in a list
    const startIndex = showFeatured ? 1 : 0;
    if (startIndex < allArticles.length) {
      const listContainer = document.createElement("div");
      listContainer.className = "divide-y divide-neutral-200 dark:divide-neutral-800";
      if (showFeatured) listContainer.classList.add("mt-10", "border-t", "border-neutral-200", "dark:border-neutral-800");

      for (let i = startIndex; i < allArticles.length; i++) {
        const article = createArticleElement(allArticles[i], i, false);
        listContainer.appendChild(article);
      }
      articlesContainer?.appendChild(listContainer);
    }

    // Setup save buttons after rendering
    setupSaveButtons();
  }

  // Setup save buttons logic
  import { showToast } from "../utils/toast";

  function setupSaveButtons() {
    const saveBtns = document.querySelectorAll(".save-btn");

    saveBtns.forEach(async (btn) => {
      const blogId = btn.getAttribute("data-blog-id");
      if (!blogId) return;

      // Check initial status
      const { isBookmarked, bookmarkId } = await checkBookmarkStatus(blogId);
      updateSaveButtonState(btn, isBookmarked);
      if (bookmarkId)
        btn.setAttribute("data-bookmark-id", bookmarkId.toString());

      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const token = localStorage.getItem("access_token");
        if (!token) {
          showToast("Please login to save articles for later.", "info");
          return;
        }

        const currentIsBookmarked = btn.classList.contains("text-orange-600");
        const currentBookmarkId = btn.getAttribute("data-bookmark-id");

        // Optimistic UI update
        updateSaveButtonState(btn, !currentIsBookmarked);

        let success = false;
        if (currentIsBookmarked && currentBookmarkId) {
          success = await removeBookmark(parseInt(currentBookmarkId));
          if (success) {
            btn.removeAttribute("data-bookmark-id");
            showToast("Article removed from saved list", "success");
          }
        } else {
          success = await saveBookmark(blogId);
          if (success) showToast("Article saved for later", "success");
        }

        if (!success) {
          // Revert UI if failed
          updateSaveButtonState(btn, currentIsBookmarked);
          showToast("Failed to update bookmark. Please try again.", "error");
        } else {
          // Re-fetch to get ID
          const { isBookmarked: newStatus, bookmarkId: newId } =
            await checkBookmarkStatus(blogId);
          if (newId) btn.setAttribute("data-bookmark-id", newId.toString());
        }
      });
    });
  }

  function updateSaveButtonState(btn: Element, isSaved: boolean) {
    if (isSaved) {
      btn.classList.add("text-orange-600", "dark:text-orange-400");
      btn.classList.remove("text-gray-400");
      btn.innerHTML = `
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
        </svg>
      `;
    } else {
      btn.classList.remove("text-orange-600", "dark:text-orange-400");
      btn.classList.add("text-gray-400");
      btn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
        </svg>
      `;
    }
  }

  // Create article element — featured or list item
  function createArticleElement(post: any, index: number, isFeatured: boolean = false) {
    const article = document.createElement("article");
    article.className = "group relative";
    article.style.animation = `fadeInUp 0.4s ease-out forwards ${Math.min(index, 6) * 0.05}s`;
    article.style.opacity = "0";

    const postTags = post.tags || [];
    const date = new Date(post.created_at).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    });

    if (isFeatured) {
      // Featured: large horizontal card
      article.innerHTML = `
        <a href="/blog/${post.slug}/" class="block md:flex gap-8 items-start">
          <div class="md:w-1/2 aspect-[16/10] rounded-xl overflow-hidden bg-neutral-100 dark:bg-neutral-800 shrink-0">
            ${post.image_url
              ? `<img src="${post.image_url}" alt="${post.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" loading="lazy" />`
              : `<div class="w-full h-full flex items-center justify-center"><span class="text-4xl">📝</span></div>`
            }
          </div>
          <div class="md:w-1/2 py-4 md:py-2">
            <div class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-3">
              ${postTags[0] ? `<span class="text-orange-600 dark:text-orange-400 font-medium">${postTags[0]}</span><span>·</span>` : ""}
              <span>${date}</span>
            </div>
            <h2 class="text-2xl md:text-3xl font-bold font-display text-neutral-900 dark:text-neutral-50 mb-3 leading-tight group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
              ${post.title}
            </h2>
            <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed mb-4 line-clamp-3">
              ${post.description}
            </p>
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-neutral-200 dark:bg-neutral-700 flex items-center justify-center text-[10px] font-bold text-neutral-600 dark:text-neutral-300">
                ${post.author?.name?.charAt(0) || "T"}
              </div>
              <span class="text-xs text-neutral-500">${post.author?.name || "TakoVibe Team"}</span>
              <span class="text-neutral-300 dark:text-neutral-600">·</span>
              <span class="text-xs text-neutral-400">${post.readingTime || "5 min read"}</span>
            </div>
          </div>
        </a>
        <button class="save-btn absolute top-3 right-3 md:top-3 md:left-[calc(50%-2rem)] md:right-auto z-20 p-1.5 rounded-lg bg-white/80 dark:bg-neutral-800/80 text-neutral-400 hover:text-orange-600 dark:hover:text-orange-400 transition-all opacity-0 group-hover:opacity-100" data-blog-id="${post.slug}" aria-label="Save">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
        </button>
      `;
    } else {
      // List item: horizontal row with thumbnail
      article.innerHTML = `
        <a href="/blog/${post.slug}/" class="flex items-start gap-4 py-5 group">
          ${post.image_url
            ? `<div class="w-24 h-24 sm:w-32 sm:h-20 shrink-0 rounded-lg overflow-hidden bg-neutral-100 dark:bg-neutral-800">
                <img src="${post.image_url}" alt="${post.title}" class="w-full h-full object-cover" loading="lazy" />
              </div>`
            : `<div class="w-24 h-24 sm:w-32 sm:h-20 shrink-0 rounded-lg bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
                <span class="text-xl">📝</span>
              </div>`
          }
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 text-[11px] text-neutral-400 dark:text-neutral-500 mb-1.5">
              ${postTags[0] ? `<span class="text-orange-600 dark:text-orange-400 font-medium">${postTags[0]}</span><span>·</span>` : ""}
              <span>${date}</span>
              <span>·</span>
              <span>${post.readingTime || "5 min read"}</span>
            </div>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-50 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors line-clamp-2 leading-snug mb-1">
              ${post.title}
            </h3>
            <p class="text-neutral-500 dark:text-neutral-400 text-sm line-clamp-1 hidden sm:block">
              ${post.description}
            </p>
            <div class="flex items-center gap-2 mt-2">
              <div class="w-5 h-5 rounded-full bg-neutral-200 dark:bg-neutral-700 flex items-center justify-center text-[9px] font-bold text-neutral-600 dark:text-neutral-300">
                ${post.author?.name?.charAt(0) || "T"}
              </div>
              <span class="text-xs text-neutral-500">${post.author?.name || "TakoVibe Team"}</span>
            </div>
          </div>
        </a>
      `;
    }

    return article;
  }

  // Update results count text
  function updateResultsCount() {
    if (resultsCount) {
      resultsCount.textContent = `${totalCount} articles`;
    }
  }

  // Update pagination — clean prev/next
  function updatePagination() {
    if (!pagination) return;

    const totalPages = Math.ceil(totalCount / currentArticlesPerPage);
    pagination.innerHTML = "";

    if (totalPages <= 1) return;

    const nav = document.createElement("nav");
    nav.className = "flex items-center gap-6";

    // Previous
    const prevBtn = document.createElement("button");
    prevBtn.className = currentPage > 1
      ? "flex items-center gap-1.5 text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
      : "flex items-center gap-1.5 text-sm font-medium text-neutral-300 dark:text-neutral-700 cursor-not-allowed";
    prevBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> Prev`;
    if (currentPage > 1) {
      prevBtn.addEventListener("click", () => {
        currentPage--;
        updateURL();
        fetchAndDisplayArticles();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
    nav.appendChild(prevBtn);

    // Page indicator
    const indicator = document.createElement("span");
    indicator.className = "text-xs text-neutral-400 dark:text-neutral-500 tabular-nums";
    indicator.textContent = `${currentPage} / ${totalPages}`;
    nav.appendChild(indicator);

    // Next
    const nextBtn = document.createElement("button");
    nextBtn.className = currentPage < totalPages
      ? "flex items-center gap-1.5 text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
      : "flex items-center gap-1.5 text-sm font-medium text-neutral-300 dark:text-neutral-700 cursor-not-allowed";
    nextBtn.innerHTML = `Next <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>`;
    if (currentPage < totalPages) {
      nextBtn.addEventListener("click", () => {
        currentPage++;
        updateURL();
        fetchAndDisplayArticles();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
    nav.appendChild(nextBtn);

    pagination.appendChild(nav);
  }

  function createPaginationButton(html, enabled, onClick) {
    const btn = document.createElement("button");
    btn.innerHTML = html;

    if (enabled) {
      btn.className =
        "text-sm text-neutral-500 dark:text-neutral-400 hover:text-orange-600 dark:hover:text-orange-400 transition-colors";
      btn.addEventListener("click", onClick);
    } else {
      btn.className =
        "text-sm text-neutral-300 dark:text-neutral-700 cursor-not-allowed";
    }
    return btn;
  }

  // Initialize on load
  init();

  // Handle view transitions navigation
  document.addEventListener("astro:after-swap", init);
</script>
