  // Search functionality using backend API
  async function performSearch(e: Event) {
    const searchTerm = (e.target as HTMLInputElement)?.value || '';
    if (currentSearchTerm !== searchTerm) {
      currentSearchTerm = searchTerm;
      currentPage = 1; // Reset to first page on new search
      await fetchAndDisplayArticles();
    }
  }

  // Tag filtering using backend API
  async function filterByTag(tag: string) {
    if (currentTag !== tag) {
      // Update active tag button
      document.querySelectorAll('.tag-filter').forEach(btn => {
        btn.classList.remove('active');
      });
      document.querySelector(`[data-tag="${tag}"]`)?.classList.add('active');
      
      currentTag = tag;
      currentPage = 1; // Reset to first page on new filter
      
      // Show/hide clear filters button
      const searchTerm = searchInput?.value || '';
      if (tag !== 'all' || searchTerm) {
        clearFilters?.classList.remove('hidden');
      } else {
        clearFilters?.classList.add('hidden');
      }
      
      await fetchAndDisplayArticles();
    }
  }

  // Pagination
  function updatePagination() {
    const totalPages = Math.max(1, Math.ceil(totalCount / currentArticlesPerPage));
    
    if (!pagination || totalPages <= 1) {
      if (pagination) pagination.innerHTML = '';
      return;
    }

    let paginationHTML = '';

    // Previous button
    paginationHTML += `
      <button 
        onclick="changePage(${currentPage - 1})" 
        ${currentPage === 1 ? 'disabled' : ''}
        class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-50 hover:text-gray-700 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
      >
        Previous
      </button>
    `;

    // Page numbers
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);

    // First page button (if not in range)
    if (startPage > 1) {
      paginationHTML += `
        <button 
          onclick="changePage(1)" 
          class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
        >
          1
        </button>
      `;
      if (startPage > 2) {
        paginationHTML += `<span class="px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400">...</span>`;
      }
    }

    // Page number buttons
    for (let i = startPage; i <= endPage; i++) {
      const isCurrentPage = i === currentPage;
      paginationHTML += `
        <button 
          onclick="changePage(${i})" 
          class="px-3 py-2 text-sm font-medium border transition-colors ${
            isCurrentPage 
              ? 'text-white bg-indigo-600 border-indigo-600 shadow-sm cursor-default dark:bg-indigo-500 dark:border-indigo-500' 
              : 'text-gray-500 bg-white border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white'
          }"
          ${isCurrentPage ? 'aria-current="page"' : ''}
        >
          ${i}
        </button>
      `;
    }

    // Last page button (if not in range)
    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        paginationHTML += `<span class="px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400">...</span>`;
      }
      paginationHTML += `
        <button 
          onclick="changePage(${totalPages})" 
          class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
        >
          ${totalPages}
        </button>
      `;
    }

    // Next button
    paginationHTML += `
      <button 
        onclick="changePage(${currentPage + 1})" 
        ${currentPage === totalPages ? 'disabled' : ''}
        class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-50 hover:text-gray-700 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
      >
        Next
      </button>
    `;

    pagination.innerHTML = paginationHTML;
  }

  // Global function for pagination buttons
  (window as any).changePage = async function(page: number) {
    // Validate page number
    const totalPages = Math.max(1, Math.ceil(totalCount / currentArticlesPerPage));
    if (page < 1 || page > totalPages || page === currentPage) {
      return;
    }
    
    currentPage = page;
    await fetchAndDisplayArticles();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

