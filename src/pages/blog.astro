<style>
  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tag filter styles */
  .tag-filter {
    @apply px-3 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm font-medium text-gray-900 dark:text-white hover:border-indigo-300 dark:hover:border-indigo-600 transition-all duration-200 flex items-center gap-2;
  }

  .tag-filter.active {
    @apply bg-indigo-600 dark:bg-indigo-500 text-white border-indigo-600 dark:border-indigo-500;
  }

  .tag-count {
    @apply text-xs opacity-75 bg-black/10 dark:bg-white/10 px-1.5 py-0.5 rounded-full;
  }

  .tag-filter.active .tag-count {
    @apply bg-white/20;
  }

  /* View toggle styles */
  .view-toggle {
    @apply text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white;
  }

  .view-toggle.active {
    @apply bg-white dark:bg-gray-700 text-indigo-600 dark:text-indigo-400 shadow-sm;
  }

  /* List view styles */
  .list-view .article-card {
    @apply col-span-full;
  }

  .list-view .article-card > a > div {
    @apply flex flex-row;
  }

  .list-view .article-card img {
    @apply w-48 h-32 object-cover;
  }

  .list-view .article-card .aspect-video {
    @apply aspect-auto w-48 h-32 flex-shrink-0;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .article-card {
    animation: fadeInUp 0.5s ease-out;
  }

  .article-card:nth-child(1) { animation-delay: 0.05s; }
  .article-card:nth-child(2) { animation-delay: 0.1s; }
  .article-card:nth-child(3) { animation-delay: 0.15s; }
  .article-card:nth-child(4) { animation-delay: 0.2s; }
  .article-card:nth-child(5) { animation-delay: 0.25s; }
  .article-card:nth-child(6) { animation-delay: 0.3s; }

  /* Hover effects */
  .featured-card:hover {
    transform: translateY(-8px);
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  .dark ::-webkit-scrollbar-thumb {
    background: #64748b;
  }

  /* Focus styles */
  button:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }
</style>

<script>
  // API endpoints
  const API_BASE = 'https://backend.takovibe.com/api/blogs/blogs/';
  
  let currentPage = 1;
  const ARTICLES_PER_PAGE = 9;
  let currentSearchTerm = '';
  let currentTag = 'all';
  let currentSort = 'date-desc';
  let totalCount = 0;
  let allArticles = [];

  // DOM elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const articlesContainer = document.getElementById('articles-container');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const pagination = document.getElementById('pagination');
  const clearFilters = document.getElementById('clear-filters');

  // Fetch articles from backend with current filters
  async function fetchAndDisplayArticles() {
    try {
      // Show loading state
      if (articlesContainer) {
        articlesContainer.innerHTML = '<div class="col-span-full flex justify-center items-center py-12"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div></div>';
      }
      
      // Build API URL with current filters
      const params = new URLSearchParams({
        paginate: '1',
        page_size: ARTICLES_PER_PAGE.toString(),
        page: currentPage.toString()
      });
      
      // Add search query if present
      if (currentSearchTerm) {
        params.set('q', currentSearchTerm);
      }
      
      // Add tag filter if not 'all'
      if (currentTag !== 'all') {
        params.set('tags', currentTag);
      }
      
      const response = await fetch(`${API_BASE}?${params}`);
      if (!response.ok) throw new Error('Failed to fetch articles');
      
      const data = await response.json();
      allArticles = data.results || [];
      totalCount = data.count || 0;
      
      displayArticles();
      updateResultsCount();
      updatePagination();
      
    } catch (error) {
      console.error('Error fetching articles:', error);
      showNoResults();
    }
  }

  // Display articles from backend response
  function displayArticles() {
    // Clear current articles
    if (articlesContainer) {
      articlesContainer.innerHTML = '';
    }
    
    if (allArticles.length === 0) {
      showNoResults();
      return;
    }
    
    // Create article elements from backend data
    allArticles.forEach((post, index) => {
      const article = createArticleElement(post, index);
      articlesContainer?.appendChild(article);
    });
    
    // Hide no results
    noResults?.classList.add('hidden');
    pagination?.classList.remove('hidden');
  }
  
  // Create article element from post data
  function createArticleElement(post: any, index: number) {
    const article = document.createElement('article');
    article.className = 'article-card group';
    article.style.animationDelay = `${index * 0.05}s`;
    
    const postTags = post.tags || [];
    
    article.innerHTML = `
      <a href="/blog/${post.slug}" class="block">
        <div class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-500 border border-gray-100 dark:border-gray-700 hover:border-purple-200 dark:hover:border-purple-700 transform hover:-translate-y-2 text-gray-900 dark:text-white">
          ${post.image_url ? `
            <div class="aspect-video overflow-hidden">
              <img 
                src="${post.image_url}" 
                alt="${post.title}"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
              />
            </div>
          ` : `
            <div class="aspect-video bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/20 to-transparent"></div>
              <div class="absolute inset-0 flex items-center justify-center p-6">
                <div class="text-center text-white">
                  <h3 class="text-lg font-bold mb-3 line-clamp-2">${post.title}</h3>
                  <div class="flex flex-wrap gap-2 justify-center">
                    ${postTags.slice(0, 2).map(tag => `
                      <span class="px-2 py-1 bg-white/25 backdrop-blur-md text-white text-xs font-medium rounded-full border border-white/20">
                        ${tag}
                      </span>
                    `).join('')}
                  </div>
                </div>
              </div>
            </div>
          `}
          <div class="p-6">
            <div class="flex flex-wrap gap-2 mb-4">
              ${postTags.slice(0, 3).map(tag => `
                <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full text-xs font-medium hover:bg-purple-200 dark:hover:bg-purple-900/50 transition-colors">
                  ${tag}
                </span>
              `).join('')}
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors line-clamp-2 leading-tight">
              ${post.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-3">
              ${post.description}
            </p>
            <div class="flex items-center justify-between">
              <div class="flex items-center text-xs text-gray-500 dark:text-gray-400">
                <span>${new Date(post.created_at).toLocaleDateString('en-US', { 
                  month: 'short', 
                  day: 'numeric' 
                })}</span>
                <span class="mx-2">•</span>
                <span>5 min read</span>
              </div>
              <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </div>
      </a>
    `;
    
    return article;
  }
  
  // Show no results message
  function showNoResults() {
    noResults?.classList.remove('hidden');
    pagination?.classList.add('hidden');
  }
  
  // Update results count
  function updateResultsCount() {
    if (resultsCount) {
      resultsCount.textContent = `Showing ${totalCount} article${totalCount === 1 ? '' : 's'}`;
    }
    
    // Update the "All Articles" button count
    const allButton = document.querySelector('[data-tag="all"] .tag-count');
    if (allButton && currentTag === 'all') {
      allButton.textContent = totalCount.toString();
    }
  }

  // Search functionality using backend API
  async function performSearch(e: Event) {
    const searchTerm = (e.target as HTMLInputElement)?.value || '';
    if (currentSearchTerm !== searchTerm) {
      currentSearchTerm = searchTerm;
      currentPage = 1; // Reset to first page on new search
      await fetchAndDisplayArticles();
    }
  }

  // Tag filtering using backend API
  async function filterByTag(tag: string) {
    if (currentTag !== tag) {
      // Update active tag button
      document.querySelectorAll('.tag-filter').forEach(btn => {
        btn.classList.remove('active');
      });
      document.querySelector(`[data-tag="${tag}"]`)?.classList.add('active');
      
      currentTag = tag;
      currentPage = 1; // Reset to first page on new filter
      
      // Show/hide clear filters button
      const searchTerm = searchInput?.value || '';
      if (tag !== 'all' || searchTerm) {
        clearFilters?.classList.remove('hidden');
      } else {
        clearFilters?.classList.add('hidden');
      }
      
      await fetchAndDisplayArticles();
    }
  }

  // Pagination
  function updatePagination() {
    const totalPages = Math.max(1, Math.ceil(totalCount / ARTICLES_PER_PAGE));
    
    if (!pagination || totalPages <= 1) {
      if (pagination) pagination.innerHTML = '';
      return;
    }

    let paginationHTML = '';

    // Previous button
    paginationHTML += `
      <button 
        onclick="changePage(${currentPage - 1})" 
        ${currentPage === 1 ? 'disabled' : ''}
        class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-50 hover:text-gray-700 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
      >
        Previous
      </button>
    `;

    // Page numbers
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);

    // First page button (if not in range)
    if (startPage > 1) {
      paginationHTML += `
        <button 
          onclick="changePage(1)" 
          class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
        >
          1
        </button>
      `;
      if (startPage > 2) {
        paginationHTML += `<span class="px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400">...</span>`;
      }
    }

    // Page number buttons
    for (let i = startPage; i <= endPage; i++) {
      const isCurrentPage = i === currentPage;
      paginationHTML += `
        <button 
          onclick="changePage(${i})" 
          class="px-3 py-2 text-sm font-medium border transition-colors ${
            isCurrentPage 
              ? 'text-white bg-indigo-600 border-indigo-600 shadow-sm cursor-default dark:bg-indigo-500 dark:border-indigo-500' 
              : 'text-gray-500 bg-white border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white'
          }"
          ${isCurrentPage ? 'aria-current="page"' : ''}
        >
          ${i}
        </button>
      `;
    }

    // Last page button (if not in range)
    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        paginationHTML += `<span class="px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400">...</span>`;
      }
      paginationHTML += `
        <button 
          onclick="changePage(${totalPages})" 
          class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
        >
          ${totalPages}
        </button>
      `;
    }

    // Next button
    paginationHTML += `
      <button 
        onclick="changePage(${currentPage + 1})" 
        ${currentPage === totalPages ? 'disabled' : ''}
        class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-50 hover:text-gray-700 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
      >
        Next
      </button>
    `;

    pagination.innerHTML = paginationHTML;
  }

  // Global function for pagination buttons
  (window as any).changePage = async function(page: number) {
    // Validate page number
    const totalPages = Math.max(1, Math.ceil(totalCount / ARTICLES_PER_PAGE));
    if (page < 1 || page > totalPages || page === currentPage) {
      return;
    }
    
    currentPage = page;
    await fetchAndDisplayArticles();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Event listeners
  searchInput?.addEventListener('input', performSearch);
  
  sortSelect?.addEventListener('change', async (e) => {
    currentSort = (e.target as HTMLSelectElement).value;
    await fetchAndDisplayArticles();
  });

  // Tag filter event listeners
  document.querySelectorAll('.tag-filter').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const tag = (e.currentTarget as HTMLElement).dataset.tag || 'all';
      filterByTag(tag);
    });
  });

  // Clear filters
  clearFilters?.addEventListener('click', async () => {
    currentSearchTerm = '';
    currentTag = 'all';
    currentPage = 1;
    if (searchInput) searchInput.value = '';
    if (sortSelect) sortSelect.value = 'date-desc';
    currentSort = 'date-desc';
    
    document.querySelectorAll('.tag-filter').forEach(btn => {
      btn.classList.remove('active');
    });
    document.querySelector('[data-tag="all"]')?.classList.add('active');
    
    clearFilters.classList.add('hidden');
    await fetchAndDisplayArticles();
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey) {
      switch (e.key) {
        case 'k':
          e.preventDefault();
          searchInput?.focus();
          break;
        case '/':
          e.preventDefault();
          searchInput?.focus();
          break;
      }
    }
  });

  // Initialize
  document.addEventListener('DOMContentLoaded', async () => {
    // Check for category parameter in URL
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');
    
    if (categoryParam) {
      // Apply the category filter
      currentTag = categoryParam;
      const tagButton = document.querySelector(`[data-tag="${categoryParam}"]`);
      if (tagButton) {
        tagButton.classList.add('active');
        document.querySelector('[data-tag="all"]')?.classList.remove('active');
      }
    }
    
    // Initial load
    await fetchAndDisplayArticles();
    
    // Update URL when changing categories
    document.querySelectorAll('.tag-filter').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tag = (e.currentTarget as HTMLElement).dataset.tag || 'all';
        if (tag === 'all') {
          // Remove category parameter if selecting 'all'
          const url = new URL(window.location.href);
          url.searchParams.delete('category');
          window.history.pushState({}, '', url);
        } else {
          // Update URL with new category
          const url = new URL(window.location.href);
          url.searchParams.set('category', tag);
          window.history.pushState({}, '', url);
        }
      });
    });
    
    // Add keyboard shortcut hint
    if (searchInput) {
      searchInput.placeholder = 'Search articles... (Ctrl+K)';
    }
  });
</script>