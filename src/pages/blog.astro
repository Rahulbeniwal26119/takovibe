  /* Loading state improvements */
  .loading-shimmer {
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    animation: shimmer 1.5s infinite;
  }

  /* Smooth transitions for all interactive elements */
  #articles-container a,
  #articles-container img,
  #articles-container .tag,
  #articles-container .read-more {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  // API endpoints
  const API_BASE = 'https://backend.takovibe.com/api/blogs/blogs/';
  
  let currentPage = 1;
  const ARTICLES_PER_PAGE_MOBILE = 6;
  const ARTICLES_PER_PAGE_DESKTOP = 9;
  let currentArticlesPerPage = ARTICLES_PER_PAGE_MOBILE; // Default to mobile
  let currentSearchTerm = '';
  let currentTag = 'all';
  let currentSort = 'date-desc';
  let totalCount = 0;
  let allArticles = [];

  // Function to get current page size based on screen width
  function getCurrentPageSize() {
    if (typeof window !== 'undefined') {
      return window.innerWidth >= 1024 ? ARTICLES_PER_PAGE_DESKTOP : ARTICLES_PER_PAGE_MOBILE;
    }
    return ARTICLES_PER_PAGE_MOBILE;
  }

  // Update current page size and refresh if needed
  function updatePageSize() {
    const newPageSize = getCurrentPageSize();
    if (newPageSize !== currentArticlesPerPage) {
      currentArticlesPerPage = newPageSize;
      // Recalculate current page to maintain position
      const currentPosition = (currentPage - 1) * (newPageSize === ARTICLES_PER_PAGE_DESKTOP ? ARTICLES_PER_PAGE_MOBILE : ARTICLES_PER_PAGE_DESKTOP);
      currentPage = Math.floor(currentPosition / newPageSize) + 1;
      fetchAndDisplayArticles();
    }
  }

  // DOM elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const articlesContainer = document.getElementById('articles-container');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const pagination = document.getElementById('pagination');
  const clearFilters = document.getElementById('clear-filters');

  // Fetch articles from backend with current filters
  async function fetchAndDisplayArticles() {
    try {
      // Show loading state
      if (articlesContainer) {
        articlesContainer.innerHTML = '<div class="col-span-full flex justify-center items-center py-12"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div></div>';
      }
      
      // Update page size based on screen size
      currentArticlesPerPage = getCurrentPageSize();
      
      // Build API URL with current filters
      const params = new URLSearchParams({
        paginate: '1',
        page_size: currentArticlesPerPage.toString(),
        page: currentPage.toString()
      });
      
      // Add search query if present
      if (currentSearchTerm) {
        params.set('q', currentSearchTerm);
      }
      
      // Add tag filter if not 'all'
      if (currentTag !== 'all') {
        params.set('tags', currentTag);
      }
      
      const response = await fetch(`${API_BASE}?${params}`);
      if (!response.ok) throw new Error('Failed to fetch articles');
      
      const data = await response.json();
      allArticles = data.results || [];
      totalCount = data.count || 0;
      
      displayArticles();
      updateResultsCount();
      updatePagination();
      
    } catch (error) {
      console.error('Error fetching articles:', error);
      showNoResults();
    }
  }

  // Display articles from backend response
  function displayArticles() {
    // Clear current articles
    if (articlesContainer) {
      articlesContainer.innerHTML = '';
    }
    
    if (allArticles.length === 0) {
      showNoResults();
      return;
    }
    
    // Create article elements from backend data
    allArticles.forEach((post, index) => {
      const article = createArticleElement(post, index);
      articlesContainer?.appendChild(article);
    });
    
    // Hide no results
    noResults?.classList.add('hidden');
    pagination?.classList.remove('hidden');
  }
  
  // Create article element from post data
  function createArticleElement(post: any, index: number) {
    const article = document.createElement('article');
