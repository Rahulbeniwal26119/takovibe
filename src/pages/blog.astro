---
import Layout from "../layouts/Layout.astro";
import type { APIResponse } from '../types/api';
import type { BlogPost, TagCount } from '../types/blog';
import { getCollection } from "astro:content";

const searchEndpoint = 'https://backend.takovibe.com/api/blogs/blogs/';
const tagsEndpoint = 'https://backend.takovibe.com/api/blogs/tags/';

interface TagData {
  tag: string;
  count: number;
}

let posts: BlogPost[] = [];
let totalCount = 0;
let popularTags: TagData[] = [];

// Fetch blog posts
try {
  const response = await fetch(`${searchEndpoint}?paginate=1&page_size=9`);
  if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
  
  const data = await response.json() as APIResponse<BlogPost>;
  posts = data.results || [];
  totalCount = data.count || 0;
} catch (err) {
  posts = null;
  console.error('Failed to fetch posts:', err);
}

// Fetch popular tags
try {
  const tagsResponse = await fetch(tagsEndpoint);
  if (tagsResponse.ok) {
    const tagsData = await tagsResponse.json() as { data: Record<string, number> };
    if (tagsData.data) {
      popularTags = Object.entries(tagsData.data)
        .map(([tag, count]) => ({ tag, count: Number(count) }))
        .sort((a, b) => b.count - a.count)
        .slice(0, 15);
    }
  }
} catch (err) {
  console.error('Failed to fetch tags:', err);
}

if (posts === null) {
  console.error('Failed to fetch from API, falling back to local content:', error);
  // Fallback to local content
  const allPosts = await getCollection("blog");
  totalCount = allPosts.length;

  // Filter out unpublished posts and sort by date
  const currentDate = new Date();
  const publishedPosts = allPosts.filter(post => new Date(post.data.date) <= currentDate);
  posts = publishedPosts.map(post => ({
    title: post.data.title,
    description: post.data.description,
    uri: `/blog/${post.slug}`,
    slug: post.slug,
    tags: post.data.tags,
    image_url: post.data.image,
    created_at: post.data.date,
    author: {
      name: "Rahul Beniwal",
      username: "rahulbeniwal26119"
    }
  }));
}

// Function to normalize tags
function normalizeTag(tag: string) {
  return tag.toLowerCase()
    .replace(/['"]/g, '') // Remove quotes
    .trim(); // Remove extra spaces
}

// Function to find similar tags
function findSimilarTags(tags: string[]) {
  const similarTags = new Map<string, string[]>();
  
  tags.forEach(tag => {
    const normalizedTag = normalizeTag(tag);
    const existing = Array.from(similarTags.entries()).find(([key, group]) => 
      group.some(t => normalizeTag(t) === normalizedTag)
    );
    
    if (existing) {
      existing[1].push(tag);
    } else {
      similarTags.set(tag, [tag]);
    }
  });
  
  return similarTags;
}

// Pagination
const POSTS_PER_PAGE = 9;
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

const regularPosts = posts;
---

