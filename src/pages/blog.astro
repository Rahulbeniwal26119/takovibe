  // Initialize
  document.addEventListener('DOMContentLoaded', async () => {
    // Check for category or tag parameter in URL
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');
    const tagParam = urlParams.get('tag');
    
    if (categoryParam || tagParam) {
      // Apply the category/tag filter
      const selectedTag = categoryParam || tagParam;
      currentTag = selectedTag;
      
      // Find the tag button (case-insensitive search)
      const tagButton = Array.from(document.querySelectorAll('.tag-filter')).find(btn => {
        const btnTag = (btn as HTMLElement).dataset.tag;
        return btnTag && btnTag.toLowerCase() === selectedTag.toLowerCase();
      });
      
      if (tagButton) {
        // Remove active from all buttons first
        document.querySelectorAll('.tag-filter').forEach(btn => btn.classList.remove('active'));
        // Add active to the matched button
        tagButton.classList.add('active');
        // Update currentTag to match the actual button's data-tag value
        currentTag = (tagButton as HTMLElement).dataset.tag || selectedTag;
      }
    }
    
    // Initial load
    await fetchAndDisplayArticles();
    
    // Add window resize listener for responsive pagination
    let resizeTimeout: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(updatePageSize, 300);
    });
    
    // Update URL when changing categories
    document.querySelectorAll('.tag-filter').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tag = (e.currentTarget as HTMLElement).dataset.tag || 'all';
        if (tag === 'all') {
          // Remove category parameter if selecting 'all'
          const url = new URL(window.location.href);
          url.searchParams.delete('category');
          window.history.pushState({}, '', url);
        } else {
          // Update URL with new category
          const url = new URL(window.location.href);
          url.searchParams.set('category', tag);
          window.history.pushState({}, '', url);
        }
      });
