<style>
  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tag filter styles */
  .tag-filter {
    @apply px-3 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:border-indigo-300 dark:hover:border-indigo-600 transition-all duration-200 flex items-center gap-2;
  }

  .tag-filter.active {
    @apply bg-indigo-600 dark:bg-indigo-500 text-white border-indigo-600 dark:border-indigo-500;
  }

  .tag-count {
    @apply text-xs opacity-75 bg-black/10 dark:bg-white/10 px-1.5 py-0.5 rounded-full;
  }

  .tag-filter.active .tag-count {
    @apply bg-white/20;
  }

  /* View toggle styles */
  .view-toggle {
    @apply text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white;
  }

  .view-toggle.active {
    @apply bg-white dark:bg-gray-700 text-indigo-600 dark:text-indigo-400 shadow-sm;
  }

  /* List view styles */
  .list-view .article-card {
    @apply col-span-full;
  }

  .list-view .article-card > a > div {
    @apply flex flex-row;
  }

  .list-view .article-card img {
    @apply w-48 h-32 object-cover;
  }

  .list-view .article-card .aspect-video {
    @apply aspect-auto w-48 h-32 flex-shrink-0;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .article-card {
    animation: fadeInUp 0.5s ease-out;
  }

  .article-card:nth-child(1) { animation-delay: 0.05s; }
  .article-card:nth-child(2) { animation-delay: 0.1s; }
  .article-card:nth-child(3) { animation-delay: 0.15s; }
  .article-card:nth-child(4) { animation-delay: 0.2s; }
  .article-card:nth-child(5) { animation-delay: 0.25s; }
  .article-card:nth-child(6) { animation-delay: 0.3s; }

  /* Hover effects */
  .featured-card:hover {
    transform: translateY(-8px);
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  .dark ::-webkit-scrollbar-thumb {
    background: #64748b;
  }

  /* Focus styles */
  button:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }
</style>

<script>
  // Get all articles data for filtering
  const articles = Array.from(document.querySelectorAll('.article-card')).map(card => {
    const htmlCard = card as HTMLElement;
    return {
      element: card,
      title: htmlCard.dataset.title || '',
      tags: JSON.parse(htmlCard.dataset.tags || '[]'),
      date: new Date(htmlCard.dataset.date || ''),
    };
  });

  const featuredArticles = Array.from(document.querySelectorAll('.featured-card'));
  
  let currentPage = 1;
  const ARTICLES_PER_PAGE = 9;
  let filteredArticles = [...articles];
  let currentSearchTerm = '';
  let currentTag = 'all';
  let currentSort = 'date-desc';

  // DOM elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const articlesContainer = document.getElementById('articles-container');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const pagination = document.getElementById('pagination');
  const clearFilters = document.getElementById('clear-filters');
  const gridViewBtn = document.getElementById('grid-view');
  const listViewBtn = document.getElementById('list-view');

  // View mode management
  let currentView = 'grid';

  function toggleView(view: string) {
    currentView = view;
    
    if (view === 'list') {
      articlesContainer?.classList.add('list-view');
      articlesContainer?.classList.remove('grid', 'md:grid-cols-2', 'lg:grid-cols-3');
      listViewBtn?.classList.add('active');
      gridViewBtn?.classList.remove('active');
    } else {
      articlesContainer?.classList.remove('list-view');
      articlesContainer?.classList.add('grid', 'md:grid-cols-2', 'lg:grid-cols-3');
      gridViewBtn?.classList.add('active');
      listViewBtn?.classList.remove('active');
    }
  }

  // Event listeners for view toggle
  gridViewBtn?.addEventListener('click', () => toggleView('grid'));
  listViewBtn?.addEventListener('click', () => toggleView('list'));

  // Search functionality
  function performSearch() {
    currentSearchTerm = searchInput?.value.toLowerCase() || '';
    filterAndDisplayArticles();
  }

  // Function to normalize tags (same as server-side)
  function normalizeTag(tag: string) {
    return tag.toLowerCase()
      .replace(/['"]/g, '')
      .trim();
  }

  // Tag filtering
  function filterByTag(tag: string) {
    currentTag = tag;
    
    // Update active tag button
    document.querySelectorAll('.tag-filter').forEach(btn => {
      btn.classList.remove('active');
    });
    document.querySelector(`[data-tag="${tag}"]`)?.classList.add('active');
    
    // Show/hide clear filters button
    if (tag !== 'all' || currentSearchTerm) {
      clearFilters?.classList.remove('hidden');
    } else {
      clearFilters?.classList.add('hidden');
    }
    
    filterAndDisplayArticles();
  }

  // Sort functionality
  function sortArticles(articles: typeof filteredArticles) {
    return articles.sort((a, b) => {
      switch (currentSort) {
        case 'date-desc':
          return b.date.getTime() - a.date.getTime();
        case 'date-asc':
          return a.date.getTime() - b.date.getTime();
        case 'title-asc':
          return a.title.localeCompare(b.title);
        case 'title-desc':
          return b.title.localeCompare(a.title);
        case 'popular':
          // Could be based on views, likes, etc. For now, use date
          return b.date.getTime() - a.date.getTime();
        default:
          return 0;
      }
    });
  }

  // Main filter and display function
  function filterAndDisplayArticles() {
    // Filter articles
    filteredArticles = articles.filter(article => {
      // Search filter
      const matchesSearch = !currentSearchTerm || 
        article.title.includes(currentSearchTerm) ||
        article.tags.some(tag => tag.toLowerCase().includes(currentSearchTerm));
      
      // Tag filter
      const matchesTag = currentTag === 'all' || 
        article.tags.some(t => normalizeTag(t) === normalizeTag(currentTag));
      
      return matchesSearch && matchesTag;
    });

    // Sort articles
    filteredArticles = sortArticles(filteredArticles);

    // Update results count
    if (resultsCount) {
      resultsCount.textContent = `Showing ${filteredArticles.length} article${filteredArticles.length === 1 ? '' : 's'}`;
    }

    // Show/hide articles and featured section
    const shouldShowFeatured = currentTag === 'all' && !currentSearchTerm;
    
    featuredArticles.forEach(card => {
      (card as HTMLElement).style.display = shouldShowFeatured ? 'block' : 'none';
    });

    // Hide all articles first
    articles.forEach(article => {
      (article.element as HTMLElement).style.display = 'none';
    });

    // Show/hide no results
    if (filteredArticles.length === 0) {
      noResults?.classList.remove('hidden');
      pagination?.classList.add('hidden');
    } else {
      noResults?.classList.add('hidden');
      pagination?.classList.remove('hidden');
    }

    // Calculate pagination
    const totalPages = Math.ceil(filteredArticles.length / ARTICLES_PER_PAGE);
    currentPage = Math.min(currentPage, totalPages || 1);

    // Show articles for current page
    const startIndex = (currentPage - 1) * ARTICLES_PER_PAGE;
    const endIndex = startIndex + ARTICLES_PER_PAGE;
    
    filteredArticles.slice(startIndex, endIndex).forEach((article, index) => {
      (article.element as HTMLElement).style.display = 'block';
      // Stagger animation
      (article.element as HTMLElement).style.animationDelay = `${index * 0.05}s`;
    });

    // Update pagination
    updatePagination(totalPages);
  }

  // Pagination
  function updatePagination(totalPages: number) {
    if (!pagination || totalPages <= 1) {
      if (pagination) pagination.innerHTML = '';
      return;
    }

    let paginationHTML = '';

    // Previous button
    paginationHTML += `
      <button 
        onclick="changePage(${currentPage - 1})" 
        ${currentPage === 1 ? 'disabled' : ''}
        class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-50 hover:text-gray-700 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
      >
        Previous
      </button>
    `;

    // Page numbers
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);

    if (startPage > 1) {
      paginationHTML += `
        <button onclick="changePage(1)" class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
          1
        </button>
      `;
      if (startPage > 2) {
        paginationHTML += `<span class="px-3 py-2 text-sm font-medium text-gray-500">...</span>`;
      }
    }

    for (let i = startPage; i <= endPage; i++) {
      paginationHTML += `
        <button 
          onclick="changePage(${i})" 
          class="px-3 py-2 text-sm font-medium ${
            i === currentPage 
              ? 'text-indigo-600 bg-indigo-50 border-indigo-500 dark:text-indigo-400 dark:bg-indigo-900/30 dark:border-indigo-400' 
              : 'text-gray-500 bg-white border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white'
          } border"
        >
          ${i}
        </button>
      `;
    }

    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        paginationHTML += `<span class="px-3 py-2 text-sm font-medium text-gray-500">...</span>`;
      }
      paginationHTML += `
        <button onclick="changePage(${totalPages})" class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white">
          ${totalPages}
        </button>
      `;
    }

    // Next button
    paginationHTML += `
      <button 
        onclick="changePage(${currentPage + 1})" 
        ${currentPage === totalPages ? 'disabled' : ''}
        class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-50 hover:text-gray-700 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
      >
        Next
      </button>
    `;

    pagination.innerHTML = paginationHTML;
  }

  // Global function for pagination buttons
  (window as any).changePage = function(page: number) {
    currentPage = page;
    filterAndDisplayArticles();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Event listeners
  searchInput?.addEventListener('input', performSearch);
  
  sortSelect?.addEventListener('change', (e) => {
    currentSort = (e.target as HTMLSelectElement).value;
    filterAndDisplayArticles();
  });

  // Tag filter event listeners
  document.querySelectorAll('.tag-filter').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const tag = (e.currentTarget as HTMLElement).dataset.tag || 'all';
      filterByTag(tag);
    });
  });

  // Clear filters
  clearFilters?.addEventListener('click', () => {
    currentSearchTerm = '';
    currentTag = 'all';
    currentPage = 1;
    if (searchInput) searchInput.value = '';
    if (sortSelect) sortSelect.value = 'date-desc';
    
    document.querySelectorAll('.tag-filter').forEach(btn => {
      btn.classList.remove('active');
    });
    document.querySelector('[data-tag="all"]')?.classList.add('active');
    
    clearFilters.classList.add('hidden');
    filterAndDisplayArticles();
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey) {
      switch (e.key) {
        case 'k':
          e.preventDefault();
          searchInput?.focus();
          break;
        case '/':
          e.preventDefault();
          searchInput?.focus();
          break;
      }
    }
  });

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    filterAndDisplayArticles();
    
    // Add keyboard shortcut hint
    if (searchInput) {
      searchInput.placeholder = 'Search articles... (Ctrl+K)';
    }
  });
</script>