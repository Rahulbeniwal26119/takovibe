---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get all blog posts
const allPosts = await getCollection("blog");

// Filter out unpublished posts and sort by date
const currentDate = new Date();
const publishedPosts = allPosts.filter(post => new Date(post.data.date) <= currentDate);
const sortedPosts = publishedPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Function to normalize tags
function normalizeTag(tag: string) {
  return tag.toLowerCase()
    .replace(/['"]/g, '') // Remove quotes
    .trim(); // Remove extra spaces
}

// Function to find similar tags
function findSimilarTags(tags: string[]) {
  const similarTags = new Map<string, string[]>();
  
  tags.forEach(tag => {
    const normalizedTag = normalizeTag(tag);
    const existing = Array.from(similarTags.entries()).find(([key, group]) => 
      group.some(t => normalizeTag(t) === normalizedTag)
    );
    
    if (existing) {
      existing[1].push(tag);
    } else {
      similarTags.set(tag, [tag]);
    }
  });
  
  return similarTags;
}

// Extract all tags and normalize them
const rawTags = sortedPosts.flatMap(post => post.data.tags || []);
const similarTagGroups = findSimilarTags(rawTags);

// Count combined tags
const tagCounts = new Map();
sortedPosts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      const normalizedTag = normalizeTag(tag);
      const mainTag = Array.from(similarTagGroups.entries())
        .find(([, group]) => group.some(t => normalizeTag(t) === normalizedTag))?.[0] || tag;
      tagCounts.set(mainTag, (tagCounts.get(mainTag) || 0) + 1);
    });
  }
});

const popularTags = Array.from(tagCounts.entries())
  .sort(([,a], [,b]) => b - a)
  .slice(0, 10)
  .map(([tag]) => tag);

// Pagination
const POSTS_PER_PAGE = 9;
const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);

// Featured posts (latest 3)
const featuredPosts = sortedPosts.slice(0, 3);
const regularPosts = sortedPosts.slice(3);
---

