    if (searchInput) {
      searchInput.placeholder = 'Search articles... (Ctrl+K)';
    }

    // Setup image placeholder functionality
    setupImagePlaceholders();
  });

  // Image placeholder functionality
  function setupImagePlaceholders() {
    // Handle existing images
    document.querySelectorAll('img').forEach(setupImageErrorHandling);
    
    // Setup mutation observer for dynamically added images
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (node.nodeType === Node.ELEMENT_NODE) {
            const element = node as Element;
            const images = element.querySelectorAll ? element.querySelectorAll('img') : [];
            images.forEach(setupImageErrorHandling);
            if (element.tagName === 'IMG') {
              setupImageErrorHandling(element as HTMLImageElement);
            }
          }
        });
      });
    });
    
    observer.observe(document.body, { childList: true, subtree: true });
  }

  function setupImageErrorHandling(img: HTMLImageElement) {
    if (img.dataset.placeholderSetup) return; // Already setup
    
    img.dataset.placeholderSetup = 'true';
    img.dataset.loading = 'true';
    
    const handleLoad = () => {
      img.dataset.loading = 'false';
      img.dataset.loaded = 'true';
    };
    
    const handleError = () => {
      img.dataset.loading = 'false';
      img.dataset.error = 'true';
      
      // Create placeholder
      const placeholder = createImagePlaceholder(img);
      img.parentNode?.insertBefore(placeholder, img);
    };
    
    // Remove existing listeners to avoid duplicates
    img.removeEventListener('load', handleLoad);
    img.removeEventListener('error', handleError);
    
    // Add new listeners
    img.addEventListener('load', handleLoad);
    img.addEventListener('error', handleError);
    
    // Check if image is already loaded
    if (img.complete) {
      if (img.naturalWidth === 0) {
        handleError();
      } else {
        handleLoad();
      }
    }
  }

  function createImagePlaceholder(originalImg: HTMLImageElement): HTMLElement {
    const placeholder = document.createElement('div');
    placeholder.className = `image-placeholder ${originalImg.className}`;
    
    // Copy dimensions and styles
    const computedStyle = window.getComputedStyle(originalImg);
    placeholder.style.width = originalImg.offsetWidth ? `${originalImg.offsetWidth}px` : computedStyle.width;
    placeholder.style.height = originalImg.offsetHeight ? `${originalImg.offsetHeight}px` : computedStyle.height;
    placeholder.style.aspectRatio = computedStyle.aspectRatio || 'auto';
    
    // Get random tech theme
    const theme = getTechTheme();
    
    // Create placeholder content with particles
    placeholder.innerHTML = `
      <div class="tech-particles">
        ${generateParticles()}
      </div>
      <div class="image-placeholder-content">
        <div class="tech-icon-container">
          ${theme.icon}
        </div>
        <div class="placeholder-title">${theme.title}</div>
        <div class="placeholder-subtitle">${theme.subtitle}</div>
      </div>
    `;
    
    return placeholder;
  }

  function getTechTheme() {
