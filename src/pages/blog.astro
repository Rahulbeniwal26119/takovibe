---
import Layout from "../layouts/Layout.astro";
import type { APIResponse } from "../types/api";
import type { BlogPost, TagCount } from "../types/blog";
import { getCollection } from "astro:content";

const searchEndpoint = "https://backend.takovibe.com/api/blogs/blogs/";
const tagsEndpoint = "https://backend.takovibe.com/api/blogs/tags/";

interface TagData {
  tag: string;
  count: number;
}

let posts: BlogPost[] = [];
let totalCount = 0;
let popularTags: TagData[] = [];

// Fetch blog posts
try {
  const response = await fetch(`${searchEndpoint}?paginate=1&page_size=9`);
  if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

  const data = (await response.json()) as APIResponse<BlogPost>;
  posts = data.results || [];
  totalCount = data.count || 0;
} catch (err) {
  posts = null;
  console.error("Failed to fetch posts:", err);
}

// Fetch popular tags
try {
  const tagsResponse = await fetch(tagsEndpoint);
  if (tagsResponse.ok) {
    const tagsData = (await tagsResponse.json()) as {
      data: Record<string, number>;
    };
    if (tagsData.data) {
      popularTags = Object.entries(tagsData.data)
        .map(([tag, count]) => ({ tag, count: Number(count) }))
        .sort((a, b) => b.count - a.count)
        .slice(0, 15);
    }
  }
} catch (err) {
  console.error("Failed to fetch tags:", err);
}

if (posts === null) {
  // Fallback to local content
  const allPosts = await getCollection("blog");
  totalCount = allPosts.length;

  // Filter out unpublished posts and sort by date
  const currentDate = new Date();
  const publishedPosts = allPosts.filter(
    (post) => new Date(post.data.date) <= currentDate,
  );
  posts = publishedPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    uri: `/blog/${post.slug}`,
    slug: post.slug,
    tags: post.data.tags,
    image_url: post.data.image,
    created_at: post.data.date,
    author: {
      name: "Rahul Beniwal",
      username: "rahulbeniwal26119",
    },
  }));
}

// Pagination
const POSTS_PER_PAGE = 9;
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<Layout
  title="All Articles | TakoVibe"
  description="Browse all technical articles, tutorials, and insights about software engineering, system design, and modern development practices."
  author="Rahul Beniwal"
  tags={[
    "blog",
    "articles",
    "software engineering",
    "tutorials",
    "programming",
  ]}
>
  <div class="min-h-screen bg-gray-50 dark:bg-[#0B1120]">
    <!-- Hero Section -->
    <section class="relative py-24 lg:py-32 overflow-hidden">
      <!-- Animated Background -->
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-100 via-gray-50 to-gray-50 dark:from-purple-900/20 dark:via-[#0B1120] dark:to-[#0B1120]"
      >
      </div>

      <!-- Blobs -->
      <div
        class="absolute top-0 left-1/4 w-96 h-96 bg-purple-400/20 dark:bg-purple-500/10 rounded-full blur-3xl animate-blob"
      >
      </div>
      <div
        class="absolute top-0 right-1/4 w-96 h-96 bg-blue-400/20 dark:bg-blue-500/10 rounded-full blur-3xl animate-blob animation-delay-2000"
      >
      </div>
      <div
        class="absolute bottom-0 left-1/2 w-96 h-96 bg-indigo-400/20 dark:bg-indigo-500/10 rounded-full blur-3xl animate-blob animation-delay-4000"
      >
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/50 dark:bg-white/5 backdrop-blur-md text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium mb-8 border border-purple-200/50 dark:border-white/10 shadow-sm animate-fade-in-up"
        >
          <span class="text-base">📚</span>
          <span>Knowledge Base</span>
        </div>

        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold mb-8 animate-fade-in-up animation-delay-200 tracking-tight"
        >
          <span class="block text-gray-900 dark:text-white mb-2"
            >Explore Our</span
          >
          <span
            class="bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 bg-clip-text text-transparent animate-gradient"
            >Latest Insights</span
          >
        </h1>

        <p
          class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-12 leading-relaxed animate-fade-in-up animation-delay-400"
        >
          Discover in-depth tutorials, technical deep dives, and the latest
          trends in software engineering.
        </p>

        <!-- Search Bar -->
        <div
          class="max-w-2xl mx-auto relative group animate-fade-in-up animation-delay-600"
        >
          <div
            class="absolute -inset-1 bg-gradient-to-r from-purple-600 to-blue-600 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"
          >
          </div>
          <div class="relative">
            <input
              type="text"
              id="search-input"
              placeholder="Search articles, topics, or keywords..."
              class="w-full pl-14 pr-6 py-5 bg-white dark:bg-[#131B2E] border border-gray-200 dark:border-gray-700/50 rounded-2xl focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500/50 transition-all shadow-xl shadow-purple-500/5 text-lg text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
            />
            <svg
              class="absolute left-5 top-1/2 transform -translate-y-1/2 w-6 h-6 text-gray-400 dark:text-gray-500 group-focus-within:text-purple-500 transition-colors"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <!-- Tags Filter -->
        <div class="mt-12 animate-fade-in-up animation-delay-800">
          <div class="flex flex-wrap justify-center gap-2">
            <button class="tag-filter active group" data-tag="all">
              <span class="relative z-10">All Posts</span>
            </button>
            {
              popularTags.map(({ tag, count }) => (
                <button class="tag-filter group" data-tag={tag}>
                  <span class="relative z-10">{tag}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 pb-32">
      <!-- Results Info -->
      <div class="flex items-center justify-between mb-10">
        <span
          id="results-count"
          class="text-sm font-medium text-gray-500 dark:text-gray-400"
        >
          Showing latest articles
        </span>
      </div>

      <!-- Articles Grid -->
      <div
        id="articles-container"
        class="grid md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        <!-- Articles will be loaded dynamically via JavaScript -->
      </div>

      <!-- No Results -->
      <div id="no-results" class="hidden text-center py-32">
        <div class="max-w-md mx-auto">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-gray-100 dark:bg-gray-800/50 rounded-full flex items-center justify-center"
          >
            <svg
              class="w-12 h-12 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.034 0-3.935.785-5.365 2.077l-.673-.673a.75.75 0 01.673-1.404H8z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
            No articles found
          </h3>
          <p class="text-gray-500 dark:text-gray-400 mb-8">
            We couldn't find any articles matching your search. Try adjusting
            your keywords or filters.
          </p>
          <button
            id="clear-filters-btn"
            class="px-8 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-xl transition-all shadow-lg shadow-purple-600/20 hover:shadow-purple-600/40 hover:-translate-y-0.5"
          >
            Clear Filters
          </button>
        </div>
      </div>

      <!-- Pagination -->
      <div id="pagination" class="flex items-center justify-center gap-3 mt-24">
        <!-- Pagination will be generated by JavaScript -->
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Animations */
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-4000 {
    animation-delay: 4s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }
  .animation-delay-200 {
    animation-delay: 0.2s;
  }
  .animation-delay-400 {
    animation-delay: 0.4s;
  }
  .animation-delay-600 {
    animation-delay: 0.6s;
  }
  .animation-delay-800 {
    animation-delay: 0.8s;
  }

  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
  .animate-gradient {
    background-size: 200% auto;
    animation: gradient 4s linear infinite;
  }

  /* Tag Filters */
  .tag-filter {
    @apply relative px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300;
    @apply bg-white dark:bg-[#131B2E] text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700/50;
    @apply hover:border-purple-400 dark:hover:border-purple-500/50 hover:text-purple-600 dark:hover:text-purple-400 hover:shadow-md;
  }

  .tag-filter.active {
    @apply bg-purple-600 dark:bg-purple-600 text-white border-purple-600 dark:border-purple-600 shadow-lg shadow-purple-600/20;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }
  .dark ::-webkit-scrollbar-thumb {
    background: #475569;
  }
</style>

<script>
  // API endpoints
  const API_BASE = "https://backend.takovibe.com/api/blogs/blogs/";

  let currentPage = 1;
  const ARTICLES_PER_PAGE_MOBILE = 6;
  const ARTICLES_PER_PAGE_DESKTOP = 9;
  let currentArticlesPerPage = ARTICLES_PER_PAGE_MOBILE;
  let currentSearchTerm = "";
  let currentTag = "all";
  let currentSort = "date-desc";
  let totalCount = 0;
  let allArticles = [];

  // Function to get current page size based on screen width
  function getCurrentPageSize() {
    if (typeof window !== "undefined") {
      return window.innerWidth >= 1024
        ? ARTICLES_PER_PAGE_DESKTOP
        : ARTICLES_PER_PAGE_MOBILE;
    }
    return ARTICLES_PER_PAGE_MOBILE;
  }

  // DOM elements
  const searchInput = document.getElementById(
    "search-input",
  ) as HTMLInputElement;
  const articlesContainer = document.getElementById("articles-container");
  const resultsCount = document.getElementById("results-count");
  const noResults = document.getElementById("no-results");
  const pagination = document.getElementById("pagination");
  const clearFiltersBtn = document.getElementById("clear-filters-btn");
  const tagFilters = document.querySelectorAll(".tag-filter");

  // Initialize
  function init() {
    // Read URL parameters on load
    const urlParams = new URLSearchParams(window.location.search);
    const urlTag = urlParams.get("category") || urlParams.get("tag");
    const urlSearch = urlParams.get("q");
    const urlPage = urlParams.get("page");

    // Apply URL parameters
    if (urlTag && urlTag !== "all") {
      currentTag = urlTag;
      tagFilters.forEach((b) => b.classList.remove("active"));
      const matchingTag = document.querySelector(`[data-tag="${urlTag}"]`);
      if (matchingTag) {
        matchingTag.classList.add("active");
      }
    }
    if (urlSearch) {
      currentSearchTerm = urlSearch;
      if (searchInput) searchInput.value = urlSearch;
    }
    if (urlPage) {
      currentPage = parseInt(urlPage) || 1;
    }

    // Event Listeners
    searchInput?.addEventListener(
      "input",
      debounce((e) => {
        currentSearchTerm = (e.target as HTMLInputElement).value;
        currentPage = 1;
        updateURL();
        fetchAndDisplayArticles();
      }, 500),
    );

    tagFilters.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Update active state
        tagFilters.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        currentTag = btn.getAttribute("data-tag") || "all";
        currentPage = 1;
        updateURL();
        fetchAndDisplayArticles();
      });
    });

    clearFiltersBtn?.addEventListener("click", () => {
      currentSearchTerm = "";
      currentTag = "all";
      currentPage = 1;
      if (searchInput) searchInput.value = "";
      tagFilters.forEach((b) => b.classList.remove("active"));
      document.querySelector('[data-tag="all"]')?.classList.add("active");
      updateURL();
      fetchAndDisplayArticles();
    });

    // Initial fetch
    fetchAndDisplayArticles();
  }

  // Update URL without page reload
  function updateURL() {
    const params = new URLSearchParams();

    if (currentSearchTerm) {
      params.set("q", currentSearchTerm);
    }
    if (currentTag && currentTag !== "all") {
      params.set("category", currentTag);
    }
    if (currentPage > 1) {
      params.set("page", currentPage.toString());
    }

    const newURL = params.toString()
      ? `${window.location.pathname}?${params.toString()}`
      : window.location.pathname;

    window.history.pushState({}, "", newURL);
  }

  // Debounce helper
  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Fetch articles from backend
  async function fetchAndDisplayArticles() {
    try {
      // Show loading state
      if (articlesContainer) {
        articlesContainer.innerHTML = `
          <div class="col-span-full flex flex-col justify-center items-center py-32">
            <div class="relative w-16 h-16">
              <div class="absolute inset-0 border-4 border-purple-100 dark:border-purple-900/30 rounded-full"></div>
              <div class="absolute inset-0 border-4 border-purple-600 rounded-full border-t-transparent animate-spin"></div>
            </div>
            <p class="mt-4 text-gray-500 dark:text-gray-400 font-medium animate-pulse">Loading articles...</p>
          </div>
        `;
      }

      currentArticlesPerPage = getCurrentPageSize();

      const params = new URLSearchParams({
        paginate: "1",
        page_size: currentArticlesPerPage.toString(),
        page: currentPage.toString(),
      });

      if (currentSearchTerm) params.set("q", currentSearchTerm);
      if (currentTag !== "all") params.set("tags", currentTag);

      const response = await fetch(`${API_BASE}?${params}`);
      if (!response.ok) throw new Error("Failed to fetch articles");

      const data = await response.json();
      allArticles = data.results || [];
      totalCount = data.count || 0;

      displayArticles();
      updateResultsCount();
      updatePagination();
    } catch (error) {
      console.error("Error fetching articles:", error);
      if (articlesContainer) articlesContainer.innerHTML = "";
      noResults?.classList.remove("hidden");
    }
  }

  // Display articles
  function displayArticles() {
    if (articlesContainer) articlesContainer.innerHTML = "";

    if (allArticles.length === 0) {
      noResults?.classList.remove("hidden");
      pagination?.classList.add("hidden");
      return;
    }

    noResults?.classList.add("hidden");
    pagination?.classList.remove("hidden");

    allArticles.forEach((post, index) => {
      const article = createArticleElement(post, index);
      articlesContainer?.appendChild(article);
    });
  }

  // Create article element
  function createArticleElement(post: any, index: number) {
    const article = document.createElement("article");
    article.className = "group relative flex flex-col h-full";
    article.style.animation = `fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards ${index * 0.1}s`;
    article.style.opacity = "0";

    const postTags = post.tags || [];
    const date = new Date(post.created_at).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    });

    article.innerHTML = `
      <a href="/blog/${post.slug}" class="relative flex flex-col h-full bg-white dark:bg-[#131B2E] border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-purple-500/10 hover:-translate-y-2 group-hover:border-purple-500/20 dark:group-hover:border-purple-500/20">
        <!-- Image Container -->
        <div class="relative aspect-[16/9] overflow-hidden bg-gray-100 dark:bg-gray-800">
          ${
            post.image_url
              ? `
            <img 
              src="${post.image_url}" 
              alt="${post.title}"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#131B2E]/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          `
              : `
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-500/5 to-blue-500/5">
              <span class="text-4xl filter grayscale group-hover:grayscale-0 transition-all duration-500">📝</span>
            </div>
          `
          }
          
          <!-- Category Badge -->
          ${
            postTags[0]
              ? `
            <div class="absolute top-4 left-4 z-10">
              <span class="px-3 py-1.5 bg-white/90 dark:bg-[#0B1120]/90 backdrop-blur-md text-xs font-bold text-purple-600 dark:text-purple-400 rounded-lg shadow-lg border border-white/20 dark:border-white/10 tracking-wide uppercase">
                ${postTags[0]}
              </span>
            </div>
          `
              : ""
          }
        </div>

        <!-- Content -->
        <div class="flex-1 p-6 flex flex-col">
          <div class="flex items-center gap-3 text-xs font-medium text-gray-500 dark:text-gray-400 mb-4">
            <span class="flex items-center gap-1.5 bg-gray-50 dark:bg-white/5 px-2.5 py-1 rounded-md">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              ${date}
            </span>
            <span class="flex items-center gap-1.5 bg-gray-50 dark:bg-white/5 px-2.5 py-1 rounded-md">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              ${post.readingTime || "5 min read"}
            </span>
          </div>

          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 line-clamp-2 leading-tight group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            ${post.title}
          </h3>

          <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2 mb-6 flex-1 leading-relaxed">
            ${post.description}
          </p>

          <div class="flex items-center justify-between pt-5 border-t border-gray-100 dark:border-gray-800 mt-auto">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-xs text-white font-bold shadow-md">
                ${post.author?.name?.charAt(0) || "T"}
              </div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
                ${post.author?.name || "TakoVibe Team"}
              </span>
            </div>
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-purple-50 dark:bg-purple-500/10 text-purple-600 dark:text-purple-400 group-hover:bg-purple-600 group-hover:text-white dark:group-hover:bg-purple-500 dark:group-hover:text-white transition-all duration-300">
              <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </div>
      </a>
    `;

    return article;
  }

  // Update results count text
  function updateResultsCount() {
    if (resultsCount) {
      resultsCount.textContent = `Showing ${allArticles.length} of ${totalCount} articles`;
    }
  }

  // Update pagination
  function updatePagination() {
    if (!pagination) return;

    const totalPages = Math.ceil(totalCount / currentArticlesPerPage);
    pagination.innerHTML = "";

    if (totalPages <= 1) return;

    // Container for pagination
    const nav = document.createElement("nav");
    nav.className =
      "inline-flex items-center p-1.5 bg-white dark:bg-[#131B2E] border border-gray-200 dark:border-gray-700/50 rounded-2xl shadow-lg shadow-gray-200/50 dark:shadow-black/20";

    // Previous button
    const prevBtn = createPaginationButton(
      `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>`,
      currentPage > 1,
      () => {
        if (currentPage > 1) {
          currentPage--;
          fetchAndDisplayArticles();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      },
    );
    nav.appendChild(prevBtn);

    // Page numbers
    for (let i = 1; i <= totalPages; i++) {
      if (
        i === 1 ||
        i === totalPages ||
        (i >= currentPage - 1 && i <= currentPage + 1)
      ) {
        const pageBtn = createPaginationButton(i.toString(), true, () => {
          currentPage = i;
          updateURL();
          fetchAndDisplayArticles();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        if (i === currentPage) {
          pageBtn.className =
            "w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold bg-purple-600 text-white shadow-md shadow-purple-600/20 transition-all scale-105";
        } else {
          pageBtn.className =
            "w-10 h-10 flex items-center justify-center rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-purple-600 dark:hover:text-purple-400 transition-all";
        }
        nav.appendChild(pageBtn);
      } else if (
        (i === currentPage - 2 && currentPage > 3) ||
        (i === currentPage + 2 && currentPage < totalPages - 2)
      ) {
        const dots = document.createElement("span");
        dots.className =
          "w-10 h-10 flex items-center justify-center text-gray-400";
        dots.textContent = "...";
        nav.appendChild(dots);
      }
    }

    // Next button
    const nextBtn = createPaginationButton(
      `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>`,
      currentPage < totalPages,
      () => {
        if (currentPage < totalPages) {
          currentPage++;
          fetchAndDisplayArticles();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      },
    );
    nav.appendChild(nextBtn);

    pagination.appendChild(nav);
  }

  function createPaginationButton(html, enabled, onClick) {
    const btn = document.createElement("button");
    btn.innerHTML = html;

    if (enabled) {
      btn.className =
        "w-10 h-10 flex items-center justify-center rounded-xl text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-purple-600 dark:hover:text-purple-400 transition-all";
      btn.addEventListener("click", onClick);
    } else {
      btn.className =
        "w-10 h-10 flex items-center justify-center rounded-xl text-gray-300 dark:text-gray-700 cursor-not-allowed";
    }
    return btn;
  }

  // Initialize on load
  init();

  // Handle view transitions if enabled
  document.addEventListener("astro:page-load", init);
</script>
