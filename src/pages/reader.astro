---
import Layout from "../layouts/Layout.astro";
import EbookReaderHydrator from "../components/EbookReaderHydrator";
---

<Layout
    title="TakoVibe Reader - Your EPUB and PDF Library"
    description="A distraction-free reader for EPUBs and PDFs. Upload your files, read in focus, and pick up right where you left off."
    no_footer={true}
    no_header={true}
>
    <!-- Fully immersive: no site header or promo banner on the reader -->
    <style is:global>
        #top-banner { display: none !important; }
        :root { --top-banner-height: 0px !important; }
    </style>
    <div class="relative min-h-screen bg-stone-50 dark:bg-neutral-950">
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div
                class="absolute left-0 right-0 top-0 h-[420px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"
            >
            </div>
        </div>
        <div class="relative z-10">
            <EbookReaderHydrator client:only="react" />
        </div>
    </div>
</Layout>
