---
export const prerender = true;

import { getCollection } from "astro:content";
import { processBackendContent } from "../../utils/backend-renderer";
import ArticleTemplate from "../../components/ArticleTemplate.astro";
import { blockedSlugs } from "../../config/retired-content";
import { fetchBlogPostBySlug } from "../../lib/blogPreview";

export async function getStaticPaths() {
  const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
  const blogEntries = await getCollection("blog");
  try {
    const response = await fetch(
      `${API_BASE}/api/blogs/blogs/?include_content=true`,
    );
    if (!response.ok) {
      console.error("Failed to fetch posts for static paths");
      return blogEntries
        .filter((post) => !blockedSlugs.has(post.slug))
        .map((post) => ({
          params: { slug: post.slug },
        }));
    }
    const data = await response.json();
    // Handle both direct array and results object formats
    const posts = Array.isArray(data) ? data : data.results || [];

    const paths = posts
      .filter((post: any) => !blockedSlugs.has(post.slug))
      .map((post: any) => ({
        params: { slug: post.slug },
        props: { initialPostData: post },
      }));
    const backendSlugs = new Set(posts.map((post: any) => post.slug));
    // MDX is only a fallback for slugs the backend has never heard of. A slug
    // in `blockedSlugs` stays unbuilt even if its MDX file is still present,
    // otherwise unpublishing a post would silently serve the stale MDX copy.
    const staticPaths = blogEntries
      .filter(
        (post) => !backendSlugs.has(post.slug) && !blockedSlugs.has(post.slug),
      )
      .map((post) => ({
        params: { slug: post.slug },
      }));
    return [...paths, ...staticPaths];
  } catch (e) {
    console.error("Error fetching static paths:", e);
    // The API is unreachable, so every MDX entry becomes a candidate. Retired
    // slugs must still stay out, or an outage would republish them.
    return blogEntries
      .filter((post) => !blockedSlugs.has(post.slug))
      .map((post) => ({
        params: { slug: post.slug },
      }));
  }
}

const { slug } = Astro.params;
const { initialPostData } = Astro.props;

if (!slug || blockedSlugs.has(slug)) {
  return Astro.redirect("/404");
}

let post: any = null;
let headings: any[] = [];
let htmlContent = ""; // For backend content
let Content = null; // For static content
let isStatic = false;

// 1. Try Backend Data (either from props or fetch)
try {
  let apiData: any = initialPostData;

  // Local dev serves this route on demand. Try the slug filter first, then
  // the complete list for backends that do not support filtering by slug.
  if (!apiData) {
    const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
    apiData = await fetchBlogPostBySlug(slug, API_BASE);
  }

  // 1.1 Fetch Series Data (Separate API per user request)
  if (apiData) {
    try {
      const API_BASE =
        import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
      const seriesResponse = await fetch(
        `${API_BASE}/api/blogs/series/get-series-by-article/?slug=${slug}`,
      );
      if (seriesResponse.ok) {
        const seriesData = await seriesResponse.json();
        if (seriesData.data && seriesData.data.title) {
          apiData.series = seriesData.data.title;
          // You could also store specific series data if needed
          // apiData.seriesDetails = seriesData.data;
        }
      }
    } catch (seriesErr) {
      console.warn("Failed to fetch series details:", seriesErr);
    }
  }

  if (apiData && !apiData.is_legacy) {
    // Transform API data to match local post structure
    post = {
      data: {
        title: apiData.title,
        description: apiData.description,
        author: apiData.author?.name || apiData.author?.username || "Unknown",
        date: new Date(apiData.created_at),
        image: apiData.image_url,
        tags: apiData.tags || [],
        series: apiData.series || "",
        readingTime: apiData.reading_time
          ? `${apiData.reading_time} min read`
          : "5 min read",
        support_url: apiData.author?.support_url,
      },
      slug: apiData.slug,
      id: apiData.id,
      authorUsername: apiData.author?.username || "",
    };

    if (apiData.content) {
      const result = await processBackendContent(apiData.content);
      htmlContent = result.htmlContent;
      headings = result.headings;

      // Pass raw JSON for client-side rendering (TiptapRenderer)
      post.contentJson = apiData.content;
    }
  }
} catch (e) {
  console.error("API post processing failed:", e);
}

// 2. Try Static Collection if not found
if (!post) {
  const blogEntries = await getCollection("blog");
  const staticPost = blogEntries.find((p) => p.slug === slug);
  if (staticPost) {
    post = staticPost;
    isStatic = true;
    const rendered = await staticPost.render();
    Content = rendered.Content;
    headings = rendered.headings;
  }
}

// 3. Fallback
if (!post) {
  return Astro.redirect("/404");
}
---

<ArticleTemplate
  post={post}
  headings={headings}
  htmlContent={htmlContent}
  Content={Content}
  isStatic={isStatic}
/>
