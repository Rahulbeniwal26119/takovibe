---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import CopyButton from '../../components/CopyButton.astro';
import BlogInteractions from '../../components/BlogInteractions.astro';
import PomodoroTimer from '../../components/PomodoroTimer.astro';
import { Image } from 'astro:assets';
import SocialShare from '../../components/SocialShare.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import FontSizeControl from '../../components/FontSizeControl.astro';

// Add this function to sanitize the HTML content
const removeTabIndex = (content: string) => {
  return content.replace(/tabindex="-1"/g, '');
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
console.log(Content)
---
<Layout title={post.data.title} description={post.data.description} type="article" author={post.data.author} tags={post.data.tags} published_date={post.data.date} no_footer={true}>
  <!-- <PomodoroTimer /> -->
    <CopyButton />
    <FontSizeControl />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">

    
    <header class="my-8">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">{post.data.title}</h1>
      <div class="flex items-center text-base sm:text-lg text-gray-600 dark:text-gray-400 mb-8">
        <span>{post.data.date}</span>
        <span class="mx-3">•</span>
        <span>{post.data.author}</span>
      </div>
      
      <div class="flex items-center justify-center space-x-2 sm:space-x-4 my-6">
        <div class="h-px bg-gradient-to-r from-transparent via-purple-500 to-transparent w-16 sm:w-32"></div>
        <div class="flex space-x-1 sm:space-x-2">
          <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-purple-500"></span>
          <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-purple-400"></span>
          <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-purple-300"></span>
        </div>
        <div class="h-px bg-gradient-to-r from-transparent via-purple-500 to-transparent w-16 sm:w-32"></div>
      </div>
    </header>

    {post.data.image && (
      <div class="relative mb-8 -mx-4 md:mx-0">
        <div class="aspect-[16/10] md:aspect-[16/9] overflow-hidden rounded-none md:rounded-2xl">
          <Image 
            src={post.data.image} 
            alt={post.data.title}
            width={1200}
            height={675}
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-[1.02]"
            loading="eager"
            format="webp"
            quality={85}
          />
        </div>
        <div class="text-sm text-gray-500 dark:text-gray-400 text-center mt-4 italic">
          Photo by 
          <a href={post.data.image} class="text-purple-500 hover:text-purple-600 transition-colors duration-200">Unsplash</a>
        </div>
      </div>
    )}

    <article class="prose prose-lg lg:prose-xl dark:prose-invert max-w-none prose-headings:text-purple-900 dark:prose-headings:text-purple-300 prose-a:text-purple-600 dark:prose-a:text-purple-400" id="Article">
      <div class="mdx-content">
        <Content />
      </div>
    </article>

    <div class="mt-6 border-t border-gray-700 pt-6">
      <RelatedPosts currentSlug={post.slug} tags={post.data.tags || []} />
    </div>

    <footer class="mt-8 mb-0">
      <div class="text-center text-gray-600 dark:text-gray-400 mb-8">
        <p class="text-sm">Thanks for reading!</p>
      </div>

      <div class="flex items-center justify-center space-x-4">
        <div class="h-px bg-gradient-to-r from-transparent via-purple-500 to-transparent w-32"></div>
        <div class="flex space-x-2">
          <span class="w-2 h-2 rounded-full bg-purple-300"></span>
          <span class="w-2 h-2 rounded-full bg-purple-400"></span>
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
        </div>
        <div class="h-px bg-gradient-to-r from-transparent via-purple-500 to-transparent w-32"></div>
      </div>
      <div>
        <BlogInteractions post={post} />
      </div>
      <div class="text-center text-gray-600 dark:text-gray-400 mt-6 mb-0">
        <Footer />
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  .prose {
    font-size: 1.25rem;
    line-height: 1.8;
  }

  .prose h2 {
    font-size: 2.5rem;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 2rem;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    font-size: 1.25rem; /* Remove !important to allow FontSizeControl to work */
    line-height: 1.8;
  }

  .prose code {
    font-size: 1.15em;
    background-color: rgba(0,0,0,0.1);
    padding: 0.2em 0.4em;
    border-radius: 0.375rem;
  }

  .dark .prose code {
    /* background-color: rgba(255,255,255,0.1); */
  }

  .prose pre {
    position: relative;
    font-size: 1.15em;
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin: 2rem 0;
    background-color: #1a1a1a;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  .dark .prose pre {
    background-color: #1a1a1a;
  }

  .prose pre {
    border: 1px solid rgba(255,255,255,0.1);
  }

  .prose ul, .prose ol {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    font-size: 1.25rem;
  }

  .prose li {
    margin: 0.75rem 0;
  }

  .prose blockquote {
    font-size: 1.35rem;
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid #6366f1;
    background-color: rgba(99, 102, 241, 0.1);
  }

  article.prose p {
    font-size: 25px !important; /* Remove !important to allow FontSizeControl to work */
    line-height: 1.4;
    margin-bottom: 3rem;
    transition: font-size 0.3s ease;
  }
  
  article.prose li {
    transition: font-size 0.3s ease;
  }
  
  article.prose blockquote {
    transition: font-size 0.3s ease;
  }

  main {
    background-color: transparent !important;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 0.4; }
  }

  .rounded-full {
    transition: transform 0.2s ease;
  }

  .rounded-full:hover {
    transform: scale(1.2);
  }

  /* Add these styles to fix accessibility */
  .mdx-content [tabindex="-1"] {
    outline: none !important;
  }

  .mdx-content pre,
  .mdx-content code {
    tab-index: 0;
  }

  /* Optional: If you want to remove tabindex from specific elements */
  .mdx-content h1[tabindex],
  .mdx-content h2[tabindex],
  .mdx-content h3[tabindex],
  .mdx-content h4[tabindex],
  .mdx-content h5[tabindex],
  .mdx-content h6[tabindex] {
    tabindex: none;
  }
</style>

<script>
  // Remove tabindex from elements after the page loads
  document.addEventListener('astro:page-load', () => {
    const elements = document.querySelectorAll('[tabindex="-1"]');
    elements.forEach(element => {
      element.removeAttribute('tabindex');
    });
  });
</script> 