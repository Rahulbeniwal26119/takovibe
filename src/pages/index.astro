---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "https://backend.takovibe.com";
const newsletterApiUrl = import.meta.env.PUBLIC_API_URL || "https://backend.takovibe.com";

interface ApiBlogPost {
  id: number;
  created_at: string;
  author: {
    name: string;
  };
  title: string;
  slug: string;
  tags: string[];
  description: string;
  image_url: string;
  is_published: boolean;
}

let featuredPosts: ApiBlogPost[] = [];

try {
  const response = await fetch(`${API_URL}/api/blogs/home/home-blogs/`);
  if (response.ok) {
    const result = await response.json();
    featuredPosts = (result.data || [])
      .filter((post: ApiBlogPost) => post.is_published)
      .sort(
        (a: ApiBlogPost, b: ApiBlogPost) =>
          new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
      )
      .slice(0, 4);
  }
} catch (error) {
  console.warn("Homepage articles could not be loaded.", error);
}

const tools = [
  {
    title: "Vellora",
    role: "Read EPUBs and PDFs, local-first.",
    href: "/vellora",
    tag: "Reader",
  },
  {
    title: "Sketch Notes",
    role: "Diagram systems while you're learning them.",
    href: "/notes",
    tag: "Visual",
  },
  {
    title: "Runo",
    role: "Self-hosted, Postman-style API client.",
    href: "/runo",
    tag: "API",
  },
  {
    title: "ResumeVibe",
    role: "Audit the resume before a recruiter does.",
    href: "https://resumevibe.takovibe.com/",
    tag: "Career",
  },
  {
    title: "Playground",
    role: "Run Python, JS, Go, Rust, HTML in the browser.",
    href: "/playground",
    tag: "Runnable",
  },
  {
    title: "Tasks",
    role: "A daily surface for notes, checklists, carry-over.",
    href: "/tasks",
    tag: "Planning",
  },
];
---

<Layout
  title="TakoVibe — small, honest web tools, built in the open"
  description="Rahul Beniwal's workshop of practical web tools. Vellora for reading, Sketch Notes for diagrams, Runo for APIs, ResumeVibe, Playground, Tasks — and a DPDP-compliant PDF redactor shipping next."
  type="website"
  author="Rahul Beniwal"
  tags={["developer tools", "web tools", "DPDP redactor", "local-first", "build in public"]}
>
  <div class="home-shell min-h-screen overflow-hidden bg-[#f4f0e8] text-neutral-950 dark:bg-[#11100e] dark:text-stone-100">

    <!-- HERO -->
    <section class="relative isolate overflow-hidden border-b border-black/10 dark:border-white/10">
      <div class="hero-grid absolute inset-0 -z-20 opacity-60 dark:opacity-35"></div>
      <svg class="home-hero-map absolute inset-0 -z-10 h-full w-full opacity-70 dark:opacity-45" viewBox="0 0 1440 860" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="home-hero-flow" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="#34d399"></stop>
            <stop offset=".32" stop-color="#38bdf8"></stop>
            <stop offset=".68" stop-color="#fb923c"></stop>
            <stop offset="1" stop-color="#f43f5e"></stop>
          </linearGradient>
        </defs>
        <path class="home-flow-line" d="M-80 232C164 80 252 438 472 260s322-250 550-58 280 180 518 18" fill="none" stroke="url(#home-hero-flow)" stroke-width="4"></path>
        <path class="home-flow-line home-flow-delay" d="M-120 664C130 456 326 760 544 548s372-236 568-70 274 116 440-44" fill="none" stroke="url(#home-hero-flow)" stroke-width="4"></path>
      </svg>

      <div class="mx-auto grid max-w-[1440px] gap-10 px-5 pb-16 pt-14 sm:px-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-14 lg:px-12 lg:pb-20 lg:pt-20">
        <div class="min-w-0">
          <p class="home-kicker home-rise">The workshop</p>
          <h1 class="home-rise home-delay-1 mt-6 max-w-[12ch] font-display text-[clamp(2.75rem,10vw,5.5rem)] font-extrabold leading-[0.94] sm:text-[clamp(3rem,5.2vw,5.5rem)]">
            Small, honest tools, built in the open.
          </h1>
          <p class="home-rise home-delay-2 mt-6 max-w-xl text-base leading-7 text-neutral-700 dark:text-stone-300 sm:text-lg sm:leading-8">
            One builder's workshop of practical web tools. Each one does one job clearly and ships with the reasoning behind it. Pick the one that fits the job in front of you.
          </p>
          <div class="home-rise home-delay-3 mt-8 flex flex-wrap gap-3">
            <a class="home-button home-button-primary" href="#tools">
              Browse the tools
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13m-5-5 5 5-5 5"></path>
              </svg>
            </a>
            <a class="home-button home-button-secondary" href="/blog">
              Read the blog
            </a>
          </div>
        </div>

        <!-- Hero tools grid: every tool one click away -->
        <div id="tools" class="home-rise home-delay-2 min-w-0 scroll-mt-28">
          <div class="grid gap-3 sm:grid-cols-2">
            {tools.map((tool) => (
              <a
                href={tool.href}
                class="hero-tool-tile group relative flex min-h-[10rem] flex-col justify-between rounded-2xl border border-neutral-900/15 bg-white p-5 shadow-sm shadow-neutral-900/5 transition dark:border-white/15 dark:bg-[#1c1917] dark:shadow-black/30"
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="font-display text-2xl font-bold text-neutral-950 transition group-hover:text-orange-700 dark:text-white dark:group-hover:text-orange-300">
                    {tool.title}
                  </span>
                  <span class="rounded-full border border-neutral-900/15 bg-neutral-100 px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.14em] text-neutral-800 dark:border-white/15 dark:bg-white/[0.08] dark:text-stone-200">
                    {tool.tag}
                  </span>
                </div>
                <p class="mt-3 text-sm leading-6 text-neutral-700 dark:text-stone-300">
                  {tool.role}
                </p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-orange-700 dark:text-orange-300">
                  Open
                  <svg class="hero-tool-arrow h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h13m-5-5 5 5-5 5"></path>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SHIPPING NEXT -->
    <section class="border-b border-black/10 bg-[#efeadd] px-5 py-14 dark:border-white/10 dark:bg-[#141310] sm:px-8 sm:py-16 lg:px-12">
      <div class="mx-auto max-w-[1440px]">
        <div class="grid gap-8 rounded-[1.75rem] border border-black/10 bg-white/75 p-6 shadow-xl shadow-orange-950/5 backdrop-blur dark:border-white/10 dark:bg-[#1b1a16] dark:shadow-black/30 sm:p-9 lg:grid-cols-[0.95fr_1fr] lg:items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-orange-400/35 bg-orange-400/10 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] text-orange-700 dark:text-orange-300">
              <span class="h-1.5 w-1.5 rounded-full bg-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.6)]"></span>
              Shipping next
            </span>
            <h2 class="mt-6 max-w-2xl font-display text-4xl font-extrabold leading-[0.95] sm:text-5xl">
              A DPDP-compliant PDF redactor.
            </h2>
            <p class="mt-5 max-w-xl text-base leading-7 text-neutral-700 dark:text-stone-300">
              Redact personal data from PDFs under the Digital Personal Data Protection Act without uploading the document anywhere you don't control. Local-first, auditable, free. Built in the open on the changelog.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href="/changelog" class="home-button home-button-primary">
                Follow the build
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h13m-5-5 5 5-5 5"></path>
                </svg>
              </a>
              <a href="/blog" class="home-button home-button-secondary">
                Why this tool
              </a>
            </div>
          </div>

          <div class="relative overflow-hidden rounded-[1.5rem] border border-black/10 bg-[#11100e] p-5 text-stone-100 shadow-2xl shadow-orange-950/15 dark:border-white/10">
            <div class="absolute inset-0 dpdp-grid opacity-30"></div>
            <div class="relative">
              <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-orange-500"></span>
                  <span class="home-kicker text-stone-500">Redactor preview</span>
                </div>
                <span class="rounded-full border border-orange-400/30 bg-orange-400/10 px-2.5 py-1 text-[9px] font-black uppercase text-orange-200">
                  Draft
                </span>
              </div>

              <div class="mt-5 rounded-lg border border-white/10 bg-white/[0.035] p-5">
                <div class="home-kicker text-orange-300">Agreement · page 3 of 7</div>
                <div class="mt-5 space-y-2.5 text-sm leading-6 text-stone-300">
                  <p>
                    This Agreement is entered into between
                    <span class="dpdp-redact">[redacted name]</span>
                    (PAN
                    <span class="dpdp-redact">[redacted PAN]</span>) and the Company.
                  </p>
                  <p>
                    Correspondence shall be sent to
                    <span class="dpdp-redact">[redacted address]</span>
                    or
                    <span class="dpdp-redact">[redacted phone]</span>.
                  </p>
                </div>
              </div>

              <div class="mt-4 grid gap-2">
                <div class="flex items-center justify-between rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-[11px] text-stone-300">
                  <span class="font-mono">Name</span>
                  <span class="font-mono text-orange-200">3 occurrences · redacted</span>
                </div>
                <div class="flex items-center justify-between rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-[11px] text-stone-300">
                  <span class="font-mono">PAN · address · phone</span>
                  <span class="font-mono text-orange-200">4 occurrences · redacted</span>
                </div>
                <div class="flex items-center justify-between rounded-lg border border-orange-400/25 bg-orange-400/10 px-3 py-2 text-[11px]">
                  <span class="font-mono text-orange-200">Export</span>
                  <span class="font-mono text-orange-100">flattened · audit log</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOG -->
    <section class="px-5 py-20 sm:px-8 sm:py-24 lg:px-12" id="articles">
      <div class="mx-auto max-w-[1440px]">
        <div class="flex flex-wrap items-end justify-between gap-6 border-b border-black/15 pb-6 dark:border-white/15">
          <div>
            <p class="home-kicker">From the blog</p>
            <h2 class="mt-4 font-display text-4xl font-bold sm:text-5xl">How the tools got built.</h2>
            <p class="mt-4 max-w-xl text-base leading-7 text-neutral-600 dark:text-stone-400">
              Each piece is the reasoning behind a tool, a choice, or a failure worth remembering.
            </p>
          </div>
          <a class="home-text-link" href="/blog">
            All posts
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h13m-5-5 5 5-5 5"></path>
            </svg>
          </a>
        </div>

        {featuredPosts.length > 0 ? (
          <div>
            {featuredPosts.map((post, index) => (
              <a href={`/blog/${post.slug}`} class="article-row group grid gap-5 border-b border-black/15 py-7 dark:border-white/15 sm:grid-cols-[3rem_1fr_10rem] sm:items-center">
                <span class="font-mono text-xs text-neutral-500">0{index + 1}</span>
                <div class="min-w-0">
                  <div class="flex flex-wrap gap-2 text-[10px] font-bold uppercase text-orange-600 dark:text-orange-400">
                    <span>{post.tags?.[0] || "Engineering"}</span>
                    <span class="text-neutral-400">/</span>
                    <span class="text-neutral-500">{post.author?.name || "TakoVibe"}</span>
                  </div>
                  <h3 class="mt-3 max-w-4xl font-display text-2xl font-bold leading-tight transition group-hover:text-orange-600 dark:group-hover:text-orange-400 sm:text-3xl">
                    {post.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 max-w-3xl text-sm leading-6 text-neutral-600 dark:text-stone-400">{post.description}</p>
                </div>
                <div class="hidden justify-self-end sm:block">
                  {post.image_url ? (
                    <img src={`${post.image_url}?tr=w-320`} alt="" class="h-20 w-32 rounded-lg object-cover grayscale transition duration-500 group-hover:grayscale-0" loading="lazy" />
                  ) : (
                    <span class="home-text-link">Read</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="border-b border-black/15 py-12 text-neutral-600 dark:border-white/15 dark:text-stone-400">
            The next piece is being written. The tools work in the meantime.
          </div>
        )}
      </div>
    </section>

    <!-- NEWSLETTER -->
    <section id="newsletter-wrapper" class="border-t border-black/10 bg-[#efeadd] px-5 py-16 dark:border-white/10 dark:bg-[#141310] sm:px-8 sm:py-20 lg:px-12">
      <div class="mx-auto max-w-2xl text-center">
        <p class="home-kicker">Stay close</p>
        <h2 class="mt-5 font-display text-3xl font-bold leading-[0.96] sm:text-4xl">
          One email when the next tool ships.
        </h2>
        <p class="mt-4 text-base leading-7 text-neutral-600 dark:text-stone-400">
          No weekly cadence promise, no marketing. You'll hear from me when something real ships or a post is worth your time.
        </p>
        <form id="home-newsletter-form" class="mt-8">
          <label for="home-newsletter-email" class="sr-only">Email address</label>
          <div class="mx-auto flex max-w-lg flex-col gap-3 rounded-2xl border border-black/10 bg-white/70 p-2 shadow-xl shadow-orange-950/5 backdrop-blur dark:border-white/10 dark:bg-white/[0.045] sm:flex-row">
            <input
              id="home-newsletter-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="you@example.com"
              class="min-h-12 flex-1 rounded-xl border-0 bg-transparent px-4 text-sm text-neutral-900 placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-orange-500 dark:text-white dark:placeholder:text-stone-500"
            />
            <button type="submit" class="home-button home-button-primary justify-center">
              Subscribe
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13m-5-5 5 5-5 5"></path>
              </svg>
            </button>
          </div>
          <p id="home-newsletter-status" class="mt-3 min-h-5 text-sm font-medium text-neutral-600 dark:text-stone-400"></p>
        </form>
      </div>
    </section>

  </div>
</Layout>

<script define:vars={{ newsletterApiUrl }}>
  const form = document.getElementById("home-newsletter-form");
  const emailInput = document.getElementById("home-newsletter-email");
  const status = document.getElementById("home-newsletter-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!emailInput?.value || !status) return;

    const submitButton = form.querySelector('button[type="submit"]');

    status.textContent = "Subscribing...";
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.classList.add("opacity-70");
    }

    try {
      const response = await fetch(`${newsletterApiUrl}/api/users/newsletter/`, {
        method: "POST",
        body: JSON.stringify({ email: emailInput.value }),
        headers: { "Content-Type": "application/json" },
      });

      if (!response.ok) {
        throw new Error("Newsletter request failed");
      }

      status.textContent = "You're in. You'll hear from me when the next tool ships.";
      emailInput.value = "";
    } catch (error) {
      status.textContent = "Something failed. Please try again.";
    }  finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.classList.remove("opacity-70");
      }
    }
  });
</script>

<style>
  .home-shell {
    --line: rgba(28, 25, 23, 0.13);
  }

  :global(.dark) .home-shell {
    --line: rgba(255, 255, 255, 0.1);
  }

  .home-kicker {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-grid {
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .dpdp-grid {
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 36px 36px;
  }

  .dpdp-redact {
    display: inline-block;
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
    background: #1c1917;
    color: transparent;
    user-select: none;
    letter-spacing: 0;
    /* ponytail: color transparent on near-black background hides the placeholder text while preserving the character width — reads as a redaction mark, not a chip */
  }

  .home-button {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    font-size: 0.875rem;
    font-weight: 700;
    transition: 180ms ease;
  }

  .home-button svg,
  .home-text-link svg {
    height: 1rem;
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transition: transform 180ms ease;
  }

  .home-button:hover svg,
  .home-text-link:hover svg,
  .hero-tool-tile:hover .hero-tool-arrow {
    transform: translateX(0.25rem);
  }

  .home-button-primary {
    background: #ea580c;
    color: white;
  }

  .home-button-primary:hover {
    background: #c2410c;
    transform: translateY(-2px);
  }

  .home-button-secondary {
    border: 1px solid var(--line);
  }

  .home-button-secondary:hover {
    border-color: #ea580c;
    color: #c2410c;
  }

  :global(.dark) .home-button-secondary:hover {
    color: #fb923c;
  }

  .home-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #c2410c;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.dark) .home-text-link {
    color: #fb923c;
  }

  .home-flow-line {
    stroke-dasharray: 18 20;
    animation: homeSignal 20s linear infinite;
  }

  .home-flow-delay {
    animation-delay: -8s;
  }

  .home-hero-map {
    mask-image: linear-gradient(to bottom, transparent, black 16%, black 86%, transparent);
  }

  .hero-tool-tile {
    position: relative;
  }

  .hero-tool-tile:hover {
    transform: translateY(-2px);
    border-color: rgba(234, 88, 12, 0.5);
    box-shadow:
      0 12px 32px -12px rgba(249, 115, 22, 0.25),
      0 2px 6px rgba(28, 25, 23, 0.05);
  }

  :global(.dark) .hero-tool-tile:hover {
    border-color: rgba(251, 146, 60, 0.55);
    box-shadow:
      0 0 24px rgba(251, 146, 60, 0.18),
      0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .article-row {
    transition: 220ms ease;
  }

  .article-row:hover {
    padding-left: 1rem;
    padding-right: 1rem;
    background: rgba(234, 88, 12, 0.055);
  }

  .home-rise {
    animation: rise 700ms both cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-delay-1 {
    animation-delay: 90ms;
  }

  .home-delay-2 {
    animation-delay: 180ms;
  }

  .home-delay-3 {
    animation-delay: 270ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes homeSignal {
    to {
      stroke-dashoffset: -520;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-rise,
    .home-flow-line {
      animation: none;
    }
  }
</style>
