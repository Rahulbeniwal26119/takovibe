                  1K+
                </div>
                <div class="text-blue-600 dark:text-blue-400 text-sm font-light">
                  Readers
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Mobile Stats Section - Visible only on mobile/tablet -->
        <div class="xl:hidden mt-12 sm:mt-16">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 stats-grid-mobile">
            <!-- Articles Count -->
            <div class="bg-white/90 dark:bg-blue-900/20 rounded-2xl p-4 sm:p-6 border border-blue-200/50 dark:border-blue-700/30 text-center zen-shadow backdrop-blur-sm">
              <div class="text-xl sm:text-2xl font-light text-blue-900 dark:text-blue-100 mb-2">
                {sortedPosts.length || 26}
              </div>
              <div class="text-blue-600 dark:text-blue-400 text-xs sm:text-sm font-light">
                Articles
              </div>
            </div>

            <!-- Categories Count -->
            <div class="bg-white/90 dark:bg-blue-900/20 rounded-2xl p-4 sm:p-6 border border-blue-200/50 dark:border-blue-700/30 text-center zen-shadow backdrop-blur-sm">
              <div class="text-xl sm:text-2xl font-light text-blue-900 dark:text-blue-100 mb-2">
                6+
              </div>
              <div class="text-blue-600 dark:text-blue-400 text-xs sm:text-sm font-light">
                Categories
              </div>
            </div>

            <!-- Contributors -->
            <div class="bg-white/90 dark:bg-blue-900/20 rounded-2xl p-4 sm:p-6 border border-blue-200/50 dark:border-blue-700/30 text-center zen-shadow backdrop-blur-sm">
              <div class="text-xl sm:text-2xl font-light text-blue-900 dark:text-blue-100 mb-2">
                5+
              </div>
              <div class="text-blue-600 dark:text-blue-400 text-xs sm:text-sm font-light">
                Contributors
              </div>
            </div>

            <!-- Readers -->
            <div class="bg-white/90 dark:bg-blue-900/20 rounded-2xl p-4 sm:p-6 border border-blue-200/50 dark:border-blue-700/30 text-center zen-shadow backdrop-blur-sm">
              <div class="text-xl sm:text-2xl font-light text-blue-900 dark:text-blue-100 mb-2">
                1K+
              </div>
              <div class="text-blue-600 dark:text-blue-400 text-xs sm:text-sm font-light">
                Readers
              </div>
            </div>
          </div>
        </div>
              <div class="text-blue-600 dark:text-blue-400 text-xs sm:text-sm font-light">
                Contributors
              </div>
            </div>

            <!-- Community -->
            <div class="bg-white/90 dark:bg-blue-900/20 rounded-2xl p-4 sm:p-6 border border-blue-200/50 dark:border-blue-700/30 text-center zen-shadow backdrop-blur-sm">
              <div class="text-xl sm:text-2xl font-light text-blue-900 dark:text-blue-100 mb-2">
                1K+
              </div>
              <div class="text-blue-600 dark:text-blue-400 text-xs sm:text-sm font-light">
                Readers
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Articles Section -->
    <section class="py-12 sm:py-20 px-4 sm:px-6 zen-gradient" id="articles">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 sm:mb-12">
          <div class="mb-4 sm:mb-0">
            <h2 class="text-2xl sm:text-3xl font-light text-blue-900 dark:text-blue-100 mb-2 sm:mb-4">Latest <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent font-medium">Insights</span></h2>
            <p class="text-blue-700 dark:text-blue-300 text-sm sm:text-base font-light">
              Fresh perspectives and timeless wisdom from our mindful community of creators.
            </p>
          </div>
          <a href="/blog" class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium group text-sm sm:text-base">
            All articles
            <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Articles List -->
        <div class="space-y-1 articles-list">
          {featuredPosts.slice(0, 5).map((post, index) => (
            <a href={`/blog/${(post as any).slug}`} class="group block p-4 sm:p-6 rounded-xl hover:bg-blue-50/50 dark:hover:bg-blue-900/20 transition-all duration-300 article-item zen-breathing">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center space-x-3 sm:space-x-4 mb-2">
                    <span class="text-xs sm:text-sm text-blue-500 dark:text-blue-400 font-medium">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div class="flex gap-1 sm:gap-2">
                      {((post.data as any).tags || []).slice(0, 2).map((tag: string) => (
                        <span class="px-2 py-1 bg-blue-100 dark:bg-blue-800 text-blue-700 dark:text-blue-300 rounded-full text-xs font-medium">
                          {tag}
                        </span>
                      ))}
