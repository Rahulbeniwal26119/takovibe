              const gradient = gradients[index % gradients.length];
              
              return (
                <article 
                  class={`group relative overflow-hidden rounded-2xl transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 ${gridClass}`}
                  style={`animation-delay: ${index * 0.1}s`}
                >
                  <!-- Save Button -->
