---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";    
import { getCollection } from "astro:content";

// Fetch all blog posts
let blogEntries = [];
try {
  blogEntries = await getCollection("blog");
} catch (error) {
  console.error("Error fetching blog posts:", error);
}

// Filter out unpublished posts and sort by date
const currentDate = new Date();
const publishedPosts = blogEntries.filter(post => new Date((post.data as any).date) <= currentDate);
const sortedPosts = publishedPosts.sort(
  (a, b) => new Date((b.data as any).date).getTime() - new Date((a.data as any).date).getTime(),
);

// Get featured posts (top 6)
const featuredPosts = sortedPosts.slice(0, 6);

// Get unique tags for categories
const allTags = Array.from(new Set(sortedPosts.flatMap(post => (post.data as any).tags || [])));
const popularTags = allTags.slice(0, 8);
---

<Layout
  title="TakoVibe - Modern Tech Platform for Developers"
  description="Join TakoVibe, a collaborative platform where developers and tech writers share insights on software engineering, system design, and modern technologies."
  type="website"
  author="TakoVibe Team"
  tags={["software engineering", "system design", "technology", "programming", "web development", "tech community"]}
>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-slate-900 dark:via-blue-950 dark:to-indigo-950 sakura-petals">
    
    <!-- Hero Section -->
    <section class="py-16 sm:py-24 px-4 sm:px-6" id="about">
      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Main Content - Full width on mobile, left on desktop -->
          <div class="lg:col-span-12 xl:col-span-7 order-1">
            <div class="text-center lg:text-left">
              <div class="inline-flex items-center gap-3 px-6 py-3 bg-gradient-to-r from-blue-100/80 to-indigo-100/80 dark:from-blue-900/30 dark:to-indigo-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-medium mb-8 sm:mb-10 zen-shadow zen-breathing">
                <span class="text-xl">💎</span>
                Modern Platform for Developers
              </div>
              <h1 class="text-5xl sm:text-6xl lg:text-7xl font-light text-blue-900 dark:text-blue-100 mb-6 sm:mb-8 leading-tight zen-breathing">
                Welcome to
                <br/>
                <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-blue-500 bg-clip-text text-transparent font-medium">
                  TakoVibe
                </span>
              </h1>
              <p class="text-xl sm:text-2xl text-blue-700 dark:text-blue-300 mb-8 sm:mb-10 leading-relaxed max-w-3xl mx-auto lg:mx-0 font-light">
                A modern platform where developers and tech writers share insights on 
                <span class="text-blue-600 dark:text-blue-400 font-normal">software engineering</span>, 
                system design, and cutting-edge technologies. Join our community of innovative creators.
              </p>
              <div class="flex flex-col sm:flex-row gap-5 justify-center lg:justify-start">
                <a href="#articles" class="group inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 text-white font-medium rounded-2xl transition-all duration-300 transform hover:scale-105 zen-shadow">
                  <span>📚</span>
                  <span class="ml-2">Explore Articles</span>
                  <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
                <a href="/categories" class="group inline-flex items-center justify-center px-8 py-4 bg-white/80 dark:bg-blue-900/30 border-2 border-blue-200 dark:border-blue-700 text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900/50 font-medium rounded-2xl transition-all duration-300 transform hover:scale-105 zen-shadow">
                  <span>🔍</span>
                  <span class="ml-2">Browse Topics</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Stats Grid - Hidden on mobile, visible on xl screens -->
          <div class="xl:col-span-5 order-2 hidden xl:block">
            <div class="grid grid-cols-2 gap-6 stats-grid">
              <!-- Articles Count -->
              <div class="bg-white/90 dark:bg-blue-900/20 rounded-3xl p-6 border border-blue-200/50 dark:border-blue-700/30 zen-shadow zen-breathing backdrop-blur-sm">
                <div class="text-3xl font-light text-blue-900 dark:text-blue-100 mb-3">
                  {sortedPosts.length || 26}
                </div>
                <div class="text-blue-600 dark:text-blue-400 text-sm font-light">
                  Articles
                </div>
              </div>

              <!-- Categories -->
              <div class="bg-white/90 dark:bg-blue-900/20 rounded-3xl p-6 border border-blue-200/50 dark:border-blue-700/30 zen-shadow zen-breathing backdrop-blur-sm">
                <div class="text-3xl font-light text-blue-900 dark:text-blue-100 mb-3">
                  6+
                </div>
                <div class="text-blue-600 dark:text-blue-400 text-sm font-light">
                  Categories
                </div>
              </div>

              <!-- Contributors -->
              <div class="bg-white/90 dark:bg-blue-900/20 rounded-3xl p-6 border border-blue-200/50 dark:border-blue-700/30 text-center zen-shadow zen-breathing backdrop-blur-sm">
                <div class="text-3xl font-light text-blue-900 dark:text-blue-100 mb-3">
                  5+
                </div>
                <div class="text-blue-600 dark:text-blue-400 text-sm font-light">
                  Contributors
                </div>
              </div>

              <!-- Readers -->
              <div class="bg-white/90 dark:bg-blue-900/20 rounded-3xl p-6 border border-blue-200/50 dark:border-blue-700/30 text-center zen-shadow zen-breathing backdrop-blur-sm">
