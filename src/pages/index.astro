              <div class="text-xs text-gray-500 dark:text-gray-400">Step-by-step</div>
            </div>
          </a>

          <!-- Divider -->
          <div class="hidden md:block w-px h-12 bg-gradient-to-b from-transparent via-gray-300 dark:via-gray-700 to-transparent"></div>

          <!-- Community -->
          <div class="flex items-center gap-3 group cursor-default">
