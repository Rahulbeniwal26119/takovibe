---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";    
import { getCollection } from "astro:content";

// Fetch all blog posts
let blogEntries = [];
try {
  blogEntries = await getCollection("blog");
} catch (error) {
  console.error("Error fetching blog posts:", error);
}

// Filter out unpublished posts and sort by date
const currentDate = new Date();
const publishedPosts = blogEntries.filter(post => new Date((post.data as any).date) <= currentDate);
const sortedPosts = publishedPosts.sort(
  (a, b) => new Date((b.data as any).date).getTime() - new Date((a.data as any).date).getTime(),
);

// Get featured posts (top 6)
const featuredPosts = sortedPosts.slice(0, 6);

// Get unique tags for categories
const allTags = Array.from(new Set(sortedPosts.flatMap(post => (post.data as any).tags || [])));
const popularTags = allTags.slice(0, 8);
---

<Layout
  title="TakoVibe - Modern Tech Platform for Developers"
  description="Join TakoVibe, a collaborative platform where developers and tech writers share insights on software engineering, system design, and modern technologies."
  type="website"
  author="TakoVibe Team"
  tags={["software engineering", "system design", "technology", "programming", "web development", "tech community"]}
>
  <div class="min-h-screen bg-white dark:bg-[#171923]">
    
    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-4 sm:px-6" id="about">
      <div class="max-w-5xl mx-auto">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Main Content -->
          <div class="lg:col-span-12 order-1">
            <div class="text-center">
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 rounded-full text-sm font-medium mb-8 border border-gray-200 dark:border-gray-700">
                <span class="text-base">💎</span>
                From Developers to Developers
              </div>
              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-light text-gray-900 dark:text-gray-100 mb-6 sm:mb-8 leading-tight">
                Welcome to
                <br/>
                <span class="bg-gradient-to-r from-purple-600 via-purple-500 to-blue-600 bg-clip-text text-transparent font-semibold">
                  TakoVibe
                </span>
              </h1>
              <p class="text-lg sm:text-xl text-gray-700 dark:text-gray-300 mb-10 leading-relaxed max-w-2xl mx-auto font-normal">
                A modern platform where developers share insights on 
                <span class="text-blue-700 dark:text-blue-300 font-semibold">software engineering</span> 
                and cutting-edge technologies.
              </p>
              <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="#articles" class="group inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105">
                  <span>Explore Articles</span>
                  <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
                <a href="/categories" class="group inline-flex items-center justify-center px-8 py-4 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 font-semibold rounded-xl border-2 border-gray-300 dark:border-gray-600 hover:border-purple-400 dark:hover:border-purple-500 transition-all duration-300">
                  Browse Topics
                </a>
              </div>
            </div>
          </div>

          <!-- Stats Grid - Minimal Version -->
          <div class="lg:col-span-12 order-2 mt-16">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto stats-grid">
              <!-- Articles Count -->
              <div class="bg-gradient-to-br from-purple-50 to-blue-50 dark:from-purple-900/20 dark:to-blue-900/20 border border-purple-200/50 dark:border-purple-400/30 rounded-xl p-6 text-center transition-all duration-300 hover:shadow-lg hover:scale-105">
                <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                  { "25+"}
                </div>
                <div class="text-gray-600 dark:text-gray-400 text-sm font-medium">
                  Articles
                </div>
              </div>

              <!-- Categories -->
              <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200/50 dark:border-blue-400/30 rounded-xl p-6 text-center transition-all duration-300 hover:shadow-lg hover:scale-105">
                <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                  10+
                </div>
                <div class="text-gray-600 dark:text-gray-400 text-sm font-medium">
                  Categories
                </div>
              </div>

              <!-- Contributors -->
              <div class="bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 border border-indigo-200/50 dark:border-indigo-400/30 rounded-xl p-6 text-center transition-all duration-300 hover:shadow-lg hover:scale-105">
                <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                  2+
                </div>
                <div class="text-gray-600 dark:text-gray-400 text-sm font-medium">
                  Writers
                </div>
              </div>

              <!-- Readers -->
              <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 border border-green-200/50 dark:border-green-400/30 rounded-xl p-6 text-center transition-all duration-300 hover:shadow-lg hover:scale-105">
                <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                  3K+
                </div>
                <div class="text-gray-600 dark:text-gray-400 text-sm font-medium">
                  Readers (This Month)
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- No duplicate mobile section needed as we have responsive grid already -->
      </div>
    </section>

    <!-- Latest Articles Section -->
    <section class="py-20 px-4 sm:px-6 border-t border-black/10 dark:border-white/10 relative overflow-hidden" id="articles">
      <!-- Background decorative elements -->
      <div class="absolute inset-0 bg-gradient-to-b from-purple-50/30 via-transparent to-blue-50/30 dark:from-purple-900/10 dark:via-transparent dark:to-blue-900/10"></div>
      <div class="absolute top-20 right-10 w-32 h-32 bg-gradient-to-r from-purple-400/10 to-blue-400/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-10 w-24 h-24 bg-gradient-to-r from-blue-400/10 to-indigo-400/10 rounded-full blur-2xl"></div>
      
      <div class="max-w-5xl mx-auto relative z-10">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-12">
          <div class="mb-6 sm:mb-0">
            <h2 class="text-3xl sm:text-4xl font-light text-black dark:text-white mb-2">
              Latest <span class="bg-gradient-to-r from-purple-500 via-purple-400 to-blue-500 bg-clip-text text-transparent font-medium">Articles</span>
            </h2>
            <p class="text-black/60 dark:text-white/60 text-lg leading-relaxed">
              Fresh perspectives from our developer community.
            </p>
          </div>
          <a href="/blog" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-500 to-blue-500 text-white font-medium rounded-xl hover:from-purple-600 hover:to-blue-600 hover:shadow-lg hover:shadow-purple-500/25 transition-all duration-300 group">
            <span>View all</span>
            <svg class="ml-2 w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Articles List with enhanced container -->
        <div class="space-y-8 articles-list">
          {featuredPosts.slice(0, 5).map((post, index) => (
            <div class="transform transition-all duration-300 hover:scale-[1.02]" style={`animation-delay: ${index * 0.1}s`}>
              <BlogCard post={post} index={index} />
            </div>
          ))}
        </div>
        
        <!-- Bottom decorative line -->
        <div class="mt-16 flex justify-center">
          <div class="w-24 h-1 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full"></div>
        </div>
      </div>
    </section>

    <!-- Topics Showcase Section -->
    <section class="py-16 sm:py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 via-purple-50/30 to-blue-50/30 dark:from-gray-900 dark:via-purple-900/10 dark:to-blue-900/10 relative overflow-hidden" id="projects">
      <!-- Animated background elements -->
      <div class="absolute top-10 left-10 w-72 h-72 bg-gradient-to-r from-purple-400/10 to-blue-400/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-gradient-to-r from-blue-400/10 to-indigo-400/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s"></div>
      
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="text-center mb-16 sm:mb-20">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 rounded-full text-sm font-medium mb-6 border border-gray-200 dark:border-gray-700">
            <span class="text-base">🎯</span>
            Featured Content
          </div>
          <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-6 sm:mb-8">
            Explore <span class="bg-gradient-to-r from-purple-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent">Topics</span>
          </h2>
          <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed">
            Dive deep into comprehensive guides and tutorials across cutting-edge technology domains.
          </p>
        </div>

        <!-- Featured Topic Cards -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 projects-grid">
          {popularTags.slice(0, 6).map((tag, index) => {
            const tagPosts = sortedPosts.filter(post => ((post.data as any).tags || []).includes(tag));
            const colors = [
              'from-blue-500 to-blue-600',
              'from-indigo-500 to-indigo-600', 
              'from-blue-400 to-indigo-500',
              'from-indigo-400 to-blue-500',
              'from-blue-600 to-indigo-600',
              'from-indigo-600 to-blue-600'
            ];
            const icons = {
              'python': '🐍',
              'javascript': '🟨',
              'react': '⚛️',
              'django': '🎸',
              'database': '🗄️',
              'devops': '⚙️',
              'nginx': '🌐',
              'docker': '🐳',
              'system design': '🏗️',
              'programming': '💻'
            };
            
            const cardGradients = [
              'from-purple-500/20 via-purple-400/10 to-blue-500/20',
              'from-blue-500/20 via-blue-400/10 to-indigo-500/20',
              'from-indigo-500/20 via-indigo-400/10 to-purple-500/20',
              'from-green-500/20 via-green-400/10 to-emerald-500/20',
              'from-orange-500/20 via-orange-400/10 to-red-500/20',
              'from-pink-500/20 via-pink-400/10 to-purple-500/20'
            ];
            
            const borderGradients = [
              'from-purple-400/30 to-blue-400/30',
              'from-blue-400/30 to-indigo-400/30',
              'from-indigo-400/30 to-purple-400/30',
              'from-green-400/30 to-emerald-400/30',
              'from-orange-400/30 to-red-400/30',
              'from-pink-400/30 to-purple-400/30'
            ];
            
            return (
              <div class="group relative">
                {/* Animated background glow */}
                <div class={`absolute inset-0 bg-gradient-to-br ${cardGradients[index % cardGradients.length]} rounded-2xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500`}></div>
                
                <div class="relative bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm rounded-2xl p-8 border border-gray-200/50 dark:border-gray-700/50 hover:border-purple-300 dark:hover:border-purple-400/50 transition-all duration-300 hover:shadow-2xl hover:shadow-purple-500/10 dark:hover:shadow-purple-500/20 transform hover:-translate-y-2 hover:scale-105">
                  <div class="flex items-center justify-between mb-6">
                    <div class={`text-4xl p-3 rounded-xl bg-gradient-to-br ${cardGradients[index % cardGradients.length]} backdrop-blur-sm border border-white/20 dark:border-gray-700/20`}>
                      {icons[tag.toLowerCase()] || '📝'}
                    </div>
                    <div class="text-right">
                      <div class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                        {tagPosts.length}
                      </div>
                      <div class="text-xs text-gray-500 dark:text-gray-400 font-medium uppercase tracking-wider">
                        Articles
                      </div>
                    </div>
                  </div>
                  
                  <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3 capitalize group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-purple-600 group-hover:to-blue-600 group-hover:bg-clip-text transition-all duration-300">
                    {tag}
                  </h3>
                  
                  <p class="text-gray-600 dark:text-gray-400 text-base mb-6 line-clamp-3 leading-relaxed">
                    {tag === 'python' && 'Master Python programming from fundamentals to advanced concepts, with real-world examples and industry best practices.'}
                    {tag === 'javascript' && 'Explore modern JavaScript, ES6+ features, and popular frameworks like React, Vue, and Node.js.'}
                    {tag === 'django' && 'Learn Django web framework development, from basic concepts to production deployment strategies.'}
                    {tag === 'programming' && 'Discover programming concepts, algorithms, data structures, and software engineering principles.'}
                    {tag === 'devops' && 'Dive into DevOps practices, containerization, CI/CD pipelines, and infrastructure automation.'}
                    {tag === 'database' && 'Master database design, optimization, query performance, and data management for modern applications.'}
                    {!['python', 'javascript', 'django', 'programming', 'devops', 'database'].includes(tag) && `Comprehensive guides and tutorials covering everything about ${tag} development and best practices.`}
                  </p>
                  
                  <button 
                    class="category-modal-btn group/btn w-full inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white font-semibold rounded-xl transition-all duration-300 transform hover:scale-105 hover:shadow-lg"
                    data-category={tag}
                    data-articles={JSON.stringify(tagPosts.map(post => ({
                      title: (post.data as any).title,
                      description: (post.data as any).description,
                      date: (post.data as any).date,
                      slug: (post as any).slug,
                      tags: (post.data as any).tags || [],
                      readingTime: (post.data as any).readingTime || "5 min read"
                    })))}
                  >
                    <span>Explore {tag} Articles</span>
                    <svg class="ml-2 w-5 h-5 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

  </div>

  <!-- Category Modal -->
  <div id="categoryModal" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 hidden opacity-0 transition-all duration-300">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-4xl w-full max-h-[80vh] overflow-hidden transform scale-95 transition-transform duration-300" id="modalContent">
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center gap-3">
            <div id="modalIcon" class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl flex items-center justify-center text-white text-xl">
              🐍
            </div>
            <div>
              <h2 id="modalTitle" class="text-2xl font-bold text-gray-900 dark:text-white capitalize">Python</h2>
              <p id="modalCount" class="text-gray-600 dark:text-gray-400 text-sm">16 articles</p>
            </div>
          </div>
          <button id="closeModalBtn" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-6 h-6 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="p-6 border-b border-gray-200 dark:border-gray-700">
          <div class="relative">
            <input 
              type="text" 
              id="articleSearch" 
              placeholder="Search articles..." 
              class="w-full pl-10 pr-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <!-- Articles List -->
        <div class="max-h-96 overflow-y-auto" id="modalArticlesList">
          <!-- Articles will be populated here -->
        </div>

        <!-- Modal Footer -->
        <div class="p-6 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50">
          <div class="flex items-center justify-between">
            <p class="text-gray-600 dark:text-gray-400 text-sm">
              Browse all articles or use search to find specific topics
            </p>
            <a href="/categories" class="inline-flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-medium text-sm">
              View all categories
              <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script>
  let currentArticles = [];

  // Declare global functions
  declare global {
    interface Window {
      openCategoryModal: (category: string, articles: any[]) => void;
      closeCategoryModal: () => void;
    }
  }

  // Make functions globally available
  (window as any).openCategoryModal = function(category, articles) {
    currentArticles = articles;
    const modal = document.getElementById('categoryModal');
    const modalContent = document.getElementById('modalContent');
    const modalTitle = document.getElementById('modalTitle');
    const modalCount = document.getElementById('modalCount');
    const modalIcon = document.getElementById('modalIcon');
    const searchInput = document.getElementById('articleSearch');
    
    // Icon mapping
    const icons = {
      'python': '🐍',
      'javascript': '🟨',
      'react': '⚛️',
      'django': '🎸',
      'database': '🗄️',
      'devops': '⚙️',
      'nginx': '🌐',
      'docker': '🐳',
      'system design': '🏗️',
      'programming': '💻'
    };

    // Color mapping
    const colors = {
      'python': 'from-blue-500 to-blue-600',
      'javascript': 'from-yellow-500 to-yellow-600',
      'react': 'from-cyan-500 to-cyan-600',
      'django': 'from-green-500 to-green-600',
      'database': 'from-purple-500 to-purple-600',
      'devops': 'from-orange-500 to-orange-600',
      'nginx': 'from-indigo-500 to-indigo-600',
      'docker': 'from-blue-500 to-blue-600',
      'system design': 'from-pink-500 to-pink-600',
      'programming': 'from-gray-500 to-gray-600'
    };
    
    // Update modal content
    modalTitle.textContent = category.charAt(0).toUpperCase() + category.slice(1);
    modalCount.textContent = `${articles.length} article${articles.length !== 1 ? 's' : ''}`;
    modalIcon.textContent = icons[category.toLowerCase()] || '📝';
    modalIcon.className = `w-10 h-10 bg-gradient-to-r ${colors[category.toLowerCase()] || 'from-gray-500 to-gray-600'} rounded-xl flex items-center justify-center text-white text-xl`;
    
    // Clear search
    (searchInput as HTMLInputElement).value = '';
    
    // Show modal with animation
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
    }, 10);
    
    // Render articles
    renderArticles(articles);
    
    // Prevent body scrolling
    document.body.style.overflow = 'hidden';
  };

  (window as any).closeCategoryModal = function() {
    const modal = document.getElementById('categoryModal');
    const modalContent = document.getElementById('modalContent');
    
    modal.classList.add('opacity-0');
    modalContent.classList.remove('scale-100');
    modalContent.classList.add('scale-95');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  };

  function renderArticles(articles) {
    const articlesList = document.getElementById('modalArticlesList');
    
    if (articles.length === 0) {
      articlesList.innerHTML = `
        <div class="p-8 text-center">
          <div class="text-gray-400 text-6xl mb-4">🔍</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No articles found</h3>
          <p class="text-gray-600 dark:text-gray-400">Try adjusting your search terms.</p>
        </div>
      `;
      return;
    }
    
    articlesList.innerHTML = articles.map(article => `
      <a href="/blog/${article.slug}" class="block p-6 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors border-b border-gray-200 dark:border-gray-700 last:border-b-0">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              ${article.tags.slice(0, 3).map(tag => `
                <span class="px-2 py-1 bg-gray-100 dark:bg-gray-600 text-gray-600 dark:text-gray-300 rounded text-xs">
                  ${tag}
                </span>
              `).join('')}
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              ${article.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2">
              ${article.description}
            </p>
          </div>
          <div class="flex items-center gap-4 mt-3 sm:mt-0 sm:ml-6 text-xs sm:text-sm text-gray-500 dark:text-gray-400">
            <span>${new Date(article.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
            <span>${article.readingTime}</span>
          </div>
        </div>
      </a>
    `).join('');
  }

  // Event delegation and initialization
  document.addEventListener('DOMContentLoaded', function() {
    // Handle category modal buttons
    document.addEventListener('click', function(e) {
      const target = e.target as HTMLElement;
      
      if (target.closest('.category-modal-btn')) {
        e.preventDefault();
        const btn = target.closest('.category-modal-btn') as HTMLElement;
        const category = btn.getAttribute('data-category');
        const articles = JSON.parse(btn.getAttribute('data-articles') || '[]');
        (window as any).openCategoryModal(category, articles);
      }
      
      // Handle close button
      if (target.closest('#closeModalBtn')) {
        (window as any).closeCategoryModal();
      }
    });

    // Search functionality
    const searchInput = document.getElementById('articleSearch');
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        const filteredArticles = currentArticles.filter(article => 
          article.title.toLowerCase().includes(query) ||
          article.description.toLowerCase().includes(query) ||
          article.tags.some(tag => tag.toLowerCase().includes(query))
        );
        renderArticles(filteredArticles);
      });
    }

    // Close modal on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        (window as any).closeCategoryModal();
      }
    });

    // Close modal on backdrop click
    const modal = document.getElementById('categoryModal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) {
          (window as any).closeCategoryModal();
        }
      });
    }
  });
</script>

