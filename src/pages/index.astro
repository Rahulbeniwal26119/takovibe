---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import ParticlesBackground from "../components/ParticlesBackground.astro";

// API configuration
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

// Interface for API blog post
interface ApiBlogPost {
  id: number;
  created_at: string;
  updated_at: string;
  author: {
    id: number;
    name: string;
    email: string;
    username: string;
  };
  title: string;
  uri: string;
  slug: string;
  tags: string[];
  description: string;
  image_url: string;
  is_published: boolean;
  series?: any;
}

// Fetch blog posts and tags from API
let blogEntries: ApiBlogPost[] = [];
let publishedPosts: ApiBlogPost[] = [];
let sortedPosts: ApiBlogPost[] = [];
let featuredPosts: ApiBlogPost[] = [];
let tagsData: { [key: string]: number } = {};
let popularTags: Array<{ name: string; count: number }> = [];
let error: string | null = null;

try {
  // Fetch blog posts
  const blogsResponse = await fetch(`${API_URL}/api/blogs/home/home-blogs/`);
  if (blogsResponse.ok) {
    const blogsResult = await blogsResponse.json();
    if (blogsResult.code === 0 && blogsResult.data) {
      blogEntries = blogsResult.data;

      // Filter out unpublished posts
      publishedPosts = blogEntries.filter(post => post.is_published);

      // Sort by created_at date (newest first)
      sortedPosts = publishedPosts.sort(
        (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
      );

      // Get featured posts (top 6)
      featuredPosts = sortedPosts.slice(0, 6);
    }
  }

  // Fetch tags statistics
  const tagsResponse = await fetch(`${API_URL}/api/blogs/tags/`);
  if (tagsResponse.ok) {
    const tagsResult = await tagsResponse.json();
    if (tagsResult.code === 0 && tagsResult.data) {
      tagsData = tagsResult.data;

      // Convert tags object to array and sort by count (most popular first)
      popularTags = Object.entries(tagsData)
        .map(([name, count]) => ({ name, count }))
        .sort((a, b) => b.count - a.count)
        .slice(0, 8); // Get top 8 tags
    }
  }
} catch (err) {
  console.error("Error fetching data from API:", err);
  // Capture error for display
  error = err instanceof Error ? err.message : String(err);
  if (error.includes('fetch failed')) {
    error = `Backend API connection failed (${API_URL}). Please ensure the backend server is running.`;
  }
}
