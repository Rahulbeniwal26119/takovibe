---
import Layout from "../layouts/Layout.astro";
import FloatingCard from "../components/FloatingCard.astro";
import { getCollection } from "astro:content";

// Fetch all blog posts
let blogEntries = [];
try {
  blogEntries = await getCollection("blog");
} catch (error) {
  console.error("Error fetching blog posts:", error);
}

// Filter out unpublished posts (future dates) and sort by date
const currentDate = new Date();
const publishedPosts = blogEntries.filter(post => new Date(post.data.date) <= currentDate);

const sortedPosts = publishedPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Pagination configuration
const POSTS_PER_PAGE = 9;
const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<Layout
  title="TakoVibe"
  description="TakoVibe - Exploring software engineering, system design, and technology innovations"
  type="website"
  author="Rahul Beniwal"
  tags={["software engineering", "system design", "technology innovations"]}
>
  <div class="relative min-h-screen">
    <!-- Hero Section -->
    <div class="relative min-h-[90vh] flex items-center justify-center overflow-hidden hero-section bg-gradient-to-b from-indigo-900/20 via-purple-900/10 to-transparent dark:from-indigo-950/40 dark:via-purple-950/20">
      <!-- 3D Canvas with enhanced interactivity -->
      <canvas id="hero-canvas" class="absolute inset-0 w-full h-full"></canvas>

      <!-- Floating Elements -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="floating-element" style="--delay: 0s; --x: 10%; --y: 20%;">
          <div class="w-24 h-24 rounded-xl bg-gradient-to-br from-purple-500/10 to-indigo-500/10 backdrop-blur-sm border border-white/10 transform rotate-12"></div>
        </div>
        <div class="floating-element" style="--delay: 2s; --x: 85%; --y: 60%;">
          <div class="w-32 h-32 rounded-full bg-gradient-to-br from-indigo-500/10 to-purple-500/10 backdrop-blur-sm border border-white/10"></div>
        </div>
        <div class="floating-element" style="--delay: 1s; --x: 20%; --y: 80%;">
          <div class="w-20 h-20 rounded-lg bg-gradient-to-br from-purple-500/10 to-indigo-500/10 backdrop-blur-sm border border-white/10 transform -rotate-12"></div>
        </div>
      </div>

      <!-- Content -->
      <div class="relative z-10 text-center px-4 py-20">
        <div class="glow-effect mb-8 ">
          <svg class="mx-auto h-24 w-24 text-purple-500 animate-float" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        
        <h1 class="fluid-text mb-6 animate-title">TakoVibe</h1>
        
        <p class="text-xl md:text-2xl text-gray-700 dark:text-gray-200 max-w-2xl mx-auto mb-12 font-light leading-relaxed animate-fade-in">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600 dark:from-purple-400 dark:to-indigo-400 font-medium">Exploring</span> the frontiers of software engineering, one byte at a time.
        </p>
        
        <div class="flex flex-col md:flex-row gap-6 md:gap-8 justify-center items-center animate-fade-in-up mt-8 mb-12">
          <a 
            href="#latest-posts" 
            class="group relative w-full md:w-auto px-8 py-4 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-xl hover:scale-105 transition-all duration-300 font-medium overflow-hidden shadow-xl shadow-purple-500/25 hover:shadow-purple-500/50 text-center"
          >
            <span class="absolute inset-0 bg-white/20 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-200"></span>
            <span class="relative flex items-center justify-center gap-2">
              Start Reading
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </span>
          </a>
          
          <a 
            href="/about" 
            class="group w-full md:w-auto px-8 py-4 bg-white/10 backdrop-blur border border-white/20 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-white/20 transition-all duration-300 font-medium flex items-center justify-center gap-2"
          >
            About Me
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Scroll Indicator -->
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Featured Post -->
    {sortedPosts[0] && (
      <div class="max-w-7xl mx-auto px-4 -mt-32 relative z-20">
        <div class="bg-white dark:bg-gray-800/60 backdrop-blur rounded-2xl shadow-xl overflow-hidden transform hover:scale-[1.02] transition-transform duration-300">
          <a href={`/blog/${sortedPosts[0].slug}`} class="block">
            <div class="flex flex-col lg:flex-row">
              <div class="lg:w-1/2 relative h-64 lg:h-auto overflow-hidden">
                <img 
                  src={sortedPosts[0].data.image} 
                  alt={sortedPosts[0].data.title}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="lg:w-1/2 p-8 lg:p-12 flex flex-col justify-center">
                <div class="flex gap-3 mb-4">
                  {sortedPosts[0].data.tags.slice(0, 3).map((tag) => (
                    <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full text-sm">
                      {tag}
                    </span>
                  ))}
                </div>
                <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
                  {sortedPosts[0].data.title}
                </h2>
                <p class="text-gray-600 dark:text-gray-300 mb-6 line-clamp-2">
                  {sortedPosts[0].data.description}
                </p>
                <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <span>{new Date(sortedPosts[0].data.date).toLocaleDateString()}</span>
                  <span class="mx-2">•</span>
                  <span>{sortedPosts[0].data.readingTime}</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    )}

    <!-- Blog Posts Section -->
    <div class="max-w-7xl mx-auto px-4 py-16" id="latest-posts">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">Latest Articles</h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Dive into in-depth technical articles, tutorials, and insights about software development.
        </p>
      </div>

      <!-- Tags Filter -->
      <div class="flex flex-wrap gap-2 justify-center mb-12">
        <button 
          class="px-4 py-2 rounded-full border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200 text-sm tag-filter active"
          data-tag="all"
        >
          All Posts
        </button>
        {Array.from(new Set(sortedPosts.flatMap(post => post.data.tags))).slice(0, 8).map((tag) => (
          <button 
            class="px-4 py-2 rounded-full border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200 text-sm tag-filter"
            data-tag={tag}
          >
            {tag}
          </button>
        ))}
      </div>

      <!-- Posts Grid -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        id="posts-grid"
      >
        {
          sortedPosts.map((post) => (
            <FloatingCard
              title={post.data.title}
              date={post.data.date}
              author={post.data.author}
              image={post.data.image}
              slug={post.slug}
              tags={post.data.tags}
            />
          ))
        }
      </div>

      <!-- Pagination -->
      {
        totalPages > 1 && (
          <nav class="pagination mt-12" aria-label="Pagination">
            <div class="pagination-container">
              <a
                href="#"
                class="pagination-link prev-page"
                aria-label="Previous page"
              >
                ←
              </a>

              {pageNumbers.map((pageNum) => (
                <a
                  href="#"
                  class="pagination-link page-number"
                  data-page={pageNum}
                  aria-label={`Page ${pageNum}`}
                >
                  {pageNum}
                </a>
              ))}

              <a
                href="#"
                class="pagination-link next-page"
                aria-label="Next page"
              >
                →
              </a>
            </div>
          </nav>
        )
      }
    </div>
  </div>

  <script>
    import * as THREE from "three";
    import { OrbitControls } from "three/examples/jsm/controls/OrbitControls";

    // Scene setup
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      75,
      window.innerWidth / (window.innerHeight * 0.5),
      0.1,
      1000,
    );

    const canvas = document.querySelector("#hero-canvas") as HTMLCanvasElement;
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });

    renderer.setSize(window.innerWidth, window.innerHeight * 0.5);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Create floating spheres
    const sphereGeometry = new THREE.SphereGeometry(1, 32, 32);
    const sphereMaterial = new THREE.MeshPhongMaterial({
      color: 0x6366f1,
      shininess: 100,
      transparent: true,
      opacity: 0.9,
    });

    const spheres = [];
    for (let i = 0; i < 15; i++) {
      const sphere = new THREE.Mesh(sphereGeometry, sphereMaterial.clone());
      sphere.position.set(
        (Math.random() - 0.5) * 20,
        (Math.random() - 0.5) * 20,
        (Math.random() - 0.5) * 20,
      );
      sphere.scale.setScalar(Math.random() * 0.5 + 0.5);
      sphere.material.color.setHSL(Math.random(), 0.7, 0.7);
      spheres.push(sphere);
      scene.add(sphere);
    }

    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambientLight);

    const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
    directionalLight.position.set(5, 5, 5);
    scene.add(directionalLight);

    camera.position.z = 15;

    // Controls
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.enableZoom = false;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.5;

    // Animation
    function animate() {
      requestAnimationFrame(animate);

      spheres.forEach((sphere, i) => {
        sphere.rotation.x += 0.001 * (i + 1);
        sphere.rotation.y += 0.002 * (i + 1);

        // Add floating animation
        sphere.position.y += Math.sin(Date.now() * 0.001 + i) * 0.01;
      });

      controls.update();
      renderer.render(scene, camera);
    }

    // Handle window resize
    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / (window.innerHeight * 0.5);
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight * 0.5);
    });

    // Start animation
    animate();

    // Mouse interaction
    const mouse = new THREE.Vector2();
    window.addEventListener("mousemove", (event) => {
      mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

      spheres.forEach((sphere) => {
        sphere.rotation.x += mouse.y * 0.01;
        sphere.rotation.y += mouse.x * 0.01;
      });
    });
  </script>
</Layout>

<style>
  canvas {
    touch-action: none;
  }

  .pagination-container {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    background: rgba(30, 41, 59, 0.5);
    padding: 0.5rem;
    border-radius: 6px;
    backdrop-filter: blur(8px);
  }

  .pagination-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }

  .pagination-link:hover:not(.disabled) {
    background: rgba(51, 65, 85, 0.5);
    color: #e2e8f0;
  }

  .pagination-link.active {
    background: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%);
    color: white;
    font-weight: 500;
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);
  }

  .pagination-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .hero-section {
    height: 90vh;
  }

  @keyframes colorAnimation {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  .fluid-text {
    background: linear-gradient(270deg, #818cf8, #6366f1, #4f46e5, #4338ca);
    background-size: 400% 400%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: colorAnimation 8s ease infinite;
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    filter: drop-shadow(0 0 2em rgba(99, 102, 241, 0.2));
  }

  #posts-grid {
    opacity: 0;
    animation: fadeInUp 1s ease forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tag-filter {
    transition: all 0.3s ease;
  }

  .tag-filter.active {
    background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
    border-color: transparent;
    color: white;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
  }

  #posts-grid > * {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hero Section Animations */
  .floating-element {
    position: absolute;
    left: var(--x);
    top: var(--y);
    animation: float-around 20s ease-in-out infinite;
    animation-delay: var(--delay);
    opacity: 0;
    animation: appear 0.6s ease forwards;
  }

  @keyframes float-around {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(50px, -30px) rotate(10deg);
    }
    50% {
      transform: translate(0, 50px) rotate(-5deg);
    }
    75% {
      transform: translate(-30px, 20px) rotate(5deg);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-title {
    animation: title-reveal 1s ease forwards;
    opacity: 0;
  }

  @keyframes title-reveal {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 1s ease forwards 0.5s;
    opacity: 0;
  }

  .animate-fade-in-up {
    animation: fade-in-up 1s ease forwards 0.7s;
    opacity: 0;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .glow-effect {
    position: relative;
  }

  .glow-effect::after {
    content: '';
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
    z-index: -1;
    animation: glow 3s ease-in-out infinite;
  }

  @keyframes glow {
    0%, 100% {
      transform: scale(1);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.8;
    }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const POSTS_PER_PAGE = 9;
    
    // Tag filtering
    const tagButtons = document.querySelectorAll('.tag-filter') as NodeListOf<HTMLElement>;
    const allCards = document.querySelectorAll('#posts-grid > *') as NodeListOf<HTMLElement>;
    
    tagButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tag;
        
        // Update active state
        tagButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        
        // Filter cards
        allCards.forEach(card => {
          const cardTags = JSON.parse(card.dataset.tags || '[]');
          const shouldShow = tag === 'all' || cardTags.includes(tag);
          
          if (shouldShow) {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
            card.style.pointerEvents = 'auto';
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.pointerEvents = 'none';
          }
        });
      });
    });

    // Get current page from URL using window
    const urlParams = new URLSearchParams(window.location.search);
    const currentPage = Number(urlParams.get("page")) || 1;
    const totalPages = document.querySelectorAll(".page-number").length;

    // Show only current page posts
    const start = (currentPage - 1) * POSTS_PER_PAGE;
    const end = start + POSTS_PER_PAGE;
    const posts = document.querySelectorAll("#posts-grid > *");

    posts.forEach((post, index) => {
      if (index >= start && index < end) {
        post.style.display = "";
      } else {
        post.style.display = "none";
      }
    });

    // Add click handlers
    document.querySelectorAll(".page-number").forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const pageNum = Number(e.currentTarget.dataset.page);
        window.location.href = `/?page=${pageNum}`;
      });
    });

    document.querySelector(".prev-page")?.addEventListener("click", (e) => {
      e.preventDefault();
      if (currentPage > 1) {
        window.location.href = `/?page=${currentPage - 1}`;
      }
    });

    document.querySelector(".next-page")?.addEventListener("click", (e) => {
      e.preventDefault();
      if (currentPage < totalPages) {
        window.location.href = `/?page=${currentPage + 1}`;
      }
    });

    // Update active states
    document.querySelectorAll(".pagination-link").forEach((link) => {
      if (link.dataset.page === currentPage.toString()) {
        link.classList.add("active");
      }
    });

    // Update prev/next buttons state
    document
      .querySelector(".prev-page")
      ?.classList.toggle("disabled", currentPage <= 1);
    document
      .querySelector(".next-page")
      ?.classList.toggle("disabled", currentPage >= totalPages);
    // Tag filtering setup
  });
</script>
