                  </div>
                  <h3 class="text-lg sm:text-xl font-light text-blue-900 dark:text-blue-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {(post.data as any).title}
                  </h3>
                  <p class="text-blue-700 dark:text-blue-300 text-sm sm:text-base line-clamp-2 font-light">
                    {(post.data as any).description}
                  </p>
                </div>
                <div class="flex items-center gap-4 mt-3 sm:mt-0 sm:ml-6">
                  <span class="text-xs sm:text-sm text-blue-500 dark:text-blue-400 font-light">
                    {new Date((post.data as any).date).toLocaleDateString('en-US', { 
                      month: 'short', 
                      day: 'numeric' 
                    })}
                  </span>
                  <span class="text-xs sm:text-sm text-blue-500 dark:text-blue-400 font-light">
                    {(post.data as any).readingTime || "5 min read"}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Topics Showcase Section -->
    <section class="py-12 sm:py-20 px-4 sm:px-6 bg-white/50 dark:bg-blue-900/10" id="projects">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl font-light text-blue-900 dark:text-blue-100 mb-4 sm:mb-6">
            Featured <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent font-medium">Topics</span>
          </h2>
          <p class="text-base sm:text-lg text-blue-700 dark:text-blue-300 max-w-3xl mx-auto font-light">
            Explore comprehensive guides and tutorials across different technology domains.
          </p>
        </div>

        <!-- Featured Topic Cards -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 projects-grid">
          {popularTags.slice(0, 6).map((tag, index) => {
            const tagPosts = sortedPosts.filter(post => ((post.data as any).tags || []).includes(tag));
            const colors = [
              'from-blue-500 to-blue-600',
              'from-indigo-500 to-indigo-600', 
              'from-blue-400 to-indigo-500',
              'from-indigo-400 to-blue-500',
              'from-blue-600 to-indigo-600',
              'from-indigo-600 to-blue-600'
            ];
            const icons = {
              'python': '🐍',
              'javascript': '🟨',
              'react': '⚛️',
              'django': '🎸',
              'database': '🗄️',
              'devops': '⚙️',
              'nginx': '🌐',
              'docker': '🐳',
              'system design': '🏗️',
              'programming': '💻'
            };
            
            return (
              <div class="group bg-white/80 dark:bg-blue-900/20 rounded-2xl p-6 sm:p-8 border border-blue-200/50 dark:border-blue-700/30 hover:border-blue-300 dark:hover:border-blue-600 transition-all duration-300 hover-lift zen-shadow zen-breathing backdrop-blur-sm">
                <div class="flex items-center justify-between mb-4 sm:mb-6">
                  <div class={`w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-r ${colors[index]} rounded-xl flex items-center justify-center text-white text-lg sm:text-xl zen-shadow`}>
                    {icons[tag.toLowerCase()] || '📝'}
                  </div>
                  <button 
                    class="category-modal-btn flex items-center gap-2 px-3 py-1 bg-blue-100 dark:bg-blue-800 hover:bg-blue-200 dark:hover:bg-blue-700 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 rounded-lg text-xs sm:text-sm transition-colors"
                    data-category={tag}
                    data-articles={JSON.stringify(tagPosts.map(post => ({
                      title: (post.data as any).title,
                      description: (post.data as any).description,
                      date: (post.data as any).date,
                      slug: (post as any).slug,
                      tags: (post.data as any).tags || [],
                      readingTime: (post.data as any).readingTime || "5 min read"
                    })))}
                  >
                    <span>{tagPosts.length} articles</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>
                
                <h3 class="text-lg sm:text-xl font-light text-blue-900 dark:text-blue-100 mb-3 capitalize group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {tag}
                </h3>
                
                <p class="text-blue-700 dark:text-blue-300 text-sm sm:text-base mb-4 line-clamp-2 font-light">
                  {tag === 'python' && 'Learn Python programming from basics to advanced concepts, including frameworks and best practices.'}
                  {tag === 'javascript' && 'Modern JavaScript development, ES6+ features, and popular frameworks like React and Node.js.'}
                  {tag === 'django' && 'Django web framework tutorials, from basic concepts to advanced deployment strategies.'}
                  {tag === 'programming' && 'General programming concepts, algorithms, and software engineering best practices.'}
                  {tag === 'devops' && 'DevOps practices, containerization, CI/CD pipelines, and infrastructure automation.'}
                  {tag === 'database' && 'Database design, optimization, and management for modern web applications.'}
                  {!['python', 'javascript', 'django', 'programming', 'devops', 'database'].includes(tag) && `Comprehensive guides and tutorials about ${tag} development and best practices.`}
                </p>
                
                <button 
                  class="category-modal-btn inline-flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-medium text-sm group-hover:underline"
                  data-category={tag}
                  data-articles={JSON.stringify(tagPosts.map(post => ({
                    title: (post.data as any).title,
                    description: (post.data as any).description,
                    date: (post.data as any).date,
                    slug: (post as any).slug,
                    tags: (post.data as any).tags || [],
                    readingTime: (post.data as any).readingTime || "5 min read"
                  })))}
                >
                  Explore {tag}
                  <svg class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            );
          })}
        </div>
      </div>
    </section>

  </div>

  <!-- Category Modal -->
  <div id="categoryModal" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 hidden opacity-0 transition-all duration-300">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-4xl w-full max-h-[80vh] overflow-hidden transform scale-95 transition-transform duration-300" id="modalContent">
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center gap-3">
            <div id="modalIcon" class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl flex items-center justify-center text-white text-xl">
              🐍
            </div>
            <div>
              <h2 id="modalTitle" class="text-2xl font-bold text-gray-900 dark:text-white capitalize">Python</h2>
              <p id="modalCount" class="text-gray-600 dark:text-gray-400 text-sm">16 articles</p>
            </div>
          </div>
          <button id="closeModalBtn" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-6 h-6 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="p-6 border-b border-gray-200 dark:border-gray-700">
          <div class="relative">
            <input 
              type="text" 
              id="articleSearch" 
              placeholder="Search articles..." 
              class="w-full pl-10 pr-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <!-- Articles List -->
        <div class="max-h-96 overflow-y-auto" id="modalArticlesList">
          <!-- Articles will be populated here -->
        </div>

        <!-- Modal Footer -->
        <div class="p-6 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50">
          <div class="flex items-center justify-between">
            <p class="text-gray-600 dark:text-gray-400 text-sm">
              Browse all articles or use search to find specific topics
            </p>
            <a href="/categories" class="inline-flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-medium text-sm">
              View all categories
              <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script>
  let currentArticles = [];

  // Declare global functions
  declare global {
    interface Window {
      openCategoryModal: (category: string, articles: any[]) => void;
      closeCategoryModal: () => void;
    }
  }

  // Make functions globally available
  (window as any).openCategoryModal = function(category, articles) {
    currentArticles = articles;
    const modal = document.getElementById('categoryModal');
    const modalContent = document.getElementById('modalContent');
    const modalTitle = document.getElementById('modalTitle');
    const modalCount = document.getElementById('modalCount');
    const modalIcon = document.getElementById('modalIcon');
    const searchInput = document.getElementById('articleSearch');
    
    // Icon mapping
    const icons = {
      'python': '🐍',
      'javascript': '🟨',
      'react': '⚛️',
      'django': '🎸',
      'database': '🗄️',
      'devops': '⚙️',
      'nginx': '🌐',
      'docker': '🐳',
      'system design': '🏗️',
      'programming': '💻'
    };

    // Color mapping
    const colors = {
      'python': 'from-blue-500 to-blue-600',
      'javascript': 'from-yellow-500 to-yellow-600',
      'react': 'from-cyan-500 to-cyan-600',
      'django': 'from-green-500 to-green-600',
      'database': 'from-purple-500 to-purple-600',
      'devops': 'from-orange-500 to-orange-600',
      'nginx': 'from-indigo-500 to-indigo-600',
      'docker': 'from-blue-500 to-blue-600',
      'system design': 'from-pink-500 to-pink-600',
      'programming': 'from-gray-500 to-gray-600'
    };
    
    // Update modal content
    modalTitle.textContent = category.charAt(0).toUpperCase() + category.slice(1);
    modalCount.textContent = `${articles.length} article${articles.length !== 1 ? 's' : ''}`;
    modalIcon.textContent = icons[category.toLowerCase()] || '📝';
    modalIcon.className = `w-10 h-10 bg-gradient-to-r ${colors[category.toLowerCase()] || 'from-gray-500 to-gray-600'} rounded-xl flex items-center justify-center text-white text-xl`;
    
    // Clear search
    (searchInput as HTMLInputElement).value = '';
    
    // Show modal with animation
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
    }, 10);
    
    // Render articles
    renderArticles(articles);
    
    // Prevent body scrolling
    document.body.style.overflow = 'hidden';
  };

  (window as any).closeCategoryModal = function() {
    const modal = document.getElementById('categoryModal');
    const modalContent = document.getElementById('modalContent');
    
    modal.classList.add('opacity-0');
    modalContent.classList.remove('scale-100');
    modalContent.classList.add('scale-95');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  };

  function renderArticles(articles) {
    const articlesList = document.getElementById('modalArticlesList');
    
    if (articles.length === 0) {
      articlesList.innerHTML = `
        <div class="p-8 text-center">
          <div class="text-gray-400 text-6xl mb-4">🔍</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No articles found</h3>
          <p class="text-gray-600 dark:text-gray-400">Try adjusting your search terms.</p>
        </div>
      `;
      return;
    }
    
    articlesList.innerHTML = articles.map(article => `
      <a href="/blog/${article.slug}" class="block p-6 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors border-b border-gray-200 dark:border-gray-700 last:border-b-0">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              ${article.tags.slice(0, 3).map(tag => `
                <span class="px-2 py-1 bg-gray-100 dark:bg-gray-600 text-gray-600 dark:text-gray-300 rounded text-xs">
                  ${tag}
                </span>
              `).join('')}
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              ${article.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2">
              ${article.description}
            </p>
          </div>
          <div class="flex items-center gap-4 mt-3 sm:mt-0 sm:ml-6 text-xs sm:text-sm text-gray-500 dark:text-gray-400">
            <span>${new Date(article.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
            <span>${article.readingTime}</span>
          </div>
        </div>
      </a>
    `).join('');
  }

  // Event delegation and initialization
  document.addEventListener('DOMContentLoaded', function() {
    // Handle category modal buttons
    document.addEventListener('click', function(e) {
      const target = e.target as HTMLElement;
      
      if (target.closest('.category-modal-btn')) {
        e.preventDefault();
        const btn = target.closest('.category-modal-btn') as HTMLElement;
        const category = btn.getAttribute('data-category');
        const articles = JSON.parse(btn.getAttribute('data-articles') || '[]');
        (window as any).openCategoryModal(category, articles);
      }
      
      // Handle close button
      if (target.closest('#closeModalBtn')) {
        (window as any).closeCategoryModal();
      }
    });

    // Search functionality
    const searchInput = document.getElementById('articleSearch');
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        const filteredArticles = currentArticles.filter(article => 
          article.title.toLowerCase().includes(query) ||
          article.description.toLowerCase().includes(query) ||
          article.tags.some(tag => tag.toLowerCase().includes(query))
        );
        renderArticles(filteredArticles);
      });
    }

    // Close modal on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        (window as any).closeCategoryModal();
      }
    });

    // Close modal on backdrop click
    const modal = document.getElementById('categoryModal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) {
          (window as any).closeCategoryModal();
        }
      });
    }
  });
</script>

