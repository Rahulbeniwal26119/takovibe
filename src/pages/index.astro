            };
            
            const scheme = colorSchemes[index % colorSchemes.length];
            const tagLower = tag.name.toLowerCase();
            const icon = icons[tagLower] || '📝';
            
            return (
              <article 
                class="group relative animate-fade-up hover:z-10" 
                style={`animation-delay: ${index * 0.1}s`}
              >
                {/* Hover glow effect */}
                <div class={`absolute -inset-2 bg-gradient-to-r ${scheme.gradient} opacity-0 group-hover:opacity-20 rounded-2xl blur-xl transition-all duration-500`}></div>
                
                <div class={`relative bg-gradient-to-br ${scheme.bg} backdrop-blur-sm rounded-2xl p-6 border ${scheme.border} hover:border-opacity-100 transition-all duration-300 hover:shadow-2xl hover:shadow-black/5 dark:hover:shadow-white/5 transform hover:-translate-y-2 hover:scale-105 h-full flex flex-col`}>
                  
                  {/* Header with icon and stats */}
                  <div class="flex items-start justify-between mb-4">
                    <div class={`relative p-3 rounded-xl bg-gradient-to-br ${scheme.gradient} shadow-lg`}>
                      <span class="text-2xl filter drop-shadow-sm">{icon}</span>
                      <div class={`absolute -inset-1 ${scheme.accent} opacity-20 rounded-xl blur-sm group-hover:opacity-40 transition-opacity`}></div>
                    </div>
                    
                    <div class="text-right">
                      <div class={`text-2xl font-bold ${scheme.text} mb-1`}>
                        {tag.count}
                      </div>
                      <div class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">
                        {tag.count === 1 ? 'Article' : 'Articles'}
                      </div>
                    </div>
                  </div>
                  
                  {/* Topic name */}
                  <h3 class={`text-xl font-bold text-slate-900 dark:text-slate-100 mb-3 capitalize group-hover:${scheme.text} transition-colors duration-300 leading-tight`}>
                    {tag.name.replace(/[-_]/g, ' ')}
                  </h3>
                  
                  {/* Description */}
                  <p class="text-slate-600 dark:text-slate-400 text-sm mb-6 leading-relaxed flex-1">
                    Comprehensive guides and tutorials covering {tag.name.replace(/[-_]/g, ' ')} development and best practices.
