---
import Layout from '../layouts/Layout.astro';
import FloatingCard from '../components/FloatingCard.astro';
import { getCollection } from 'astro:content';

// Fetch all blog posts from the blog directory
let blogEntries = [];
try {
  blogEntries = await getCollection('blog');
  console.log('Blog entries:', blogEntries); // Debug log
} catch (error) {
  console.error('Error fetching blog posts:', error);
}
// If your posts are in a different directory, adjust the path above
// For example: './blog/*.{md,mdx}' or '../pages/blog/*.{md,mdx}'

// Sort posts by date (optional)
const sortedPosts = blogEntries.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title="Tech Insights">
  <div class="relative min-h-screen">
    <!-- Hero Section -->
    <div class="relative h-[80vh] flex items-center justify-center overflow-hidden">
      <!-- 3D Canvas -->
      <canvas id="hero-canvas" class="absolute inset-0 w-full h-full"></canvas>
      
      <!-- Content -->
      <div class="relative z-10 text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-blue-600">
          Tech Insights
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Exploring the depths of software engineering and system design
        </p>
      </div>
    </div>

    <!-- Blog Posts Grid -->
    <div class="max-w-6xl mx-auto px-4 py-16">
      {sortedPosts.length === 0 ? (
        <div class="text-center text-gray-600 dark:text-gray-400">
          <p>No posts yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <FloatingCard
              title={post.data.title}
              date={post.data.date}
              author={post.data.author}
              image={post.data.image}
              slug={post.slug}
            />
          ))}
        </div>
      )}
    </div>
  </div>

  <script>
    // Three.js script remains the same
  </script>
</Layout>

<style>
  canvas {
    touch-action: none;
  }
</style>