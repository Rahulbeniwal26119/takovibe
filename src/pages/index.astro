              'machine learning': '🧠',
              'web development': '🌍',
              'backend': '🔧',
              'frontend': '🎨',
              'api': '🔗',
              'microservices': '🔀',
              'cloud': '☁️',
              'security': '🔒',
              'performance': '⚡',
              'tutorial': '📚',
              'guide': '📖',
