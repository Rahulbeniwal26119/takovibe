              <span>Browse All Categories</span>
              <svg class="ml-3 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            
            <div class="text-slate-600 dark:text-slate-400 text-sm">
              <span class="font-medium">{popularTags.reduce((sum, tag) => sum + tag.count, 0)}+</span> articles across <span class="font-medium">{popularTags.length}</span> topics
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Category Modal -->
  <div id="categoryModal" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 hidden opacity-0 transition-all duration-300">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-4xl w-full max-h-[80vh] overflow-hidden transform scale-95 transition-transform duration-300" id="modalContent">
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center gap-3">
            <div id="modalIcon" class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl flex items-center justify-center text-white text-xl">
              🐍
            </div>
            <div>
              <h2 id="modalTitle" class="text-2xl font-bold text-gray-900 dark:text-white capitalize">Python</h2>
              <p id="modalCount" class="text-gray-600 dark:text-gray-400 text-sm">16 articles</p>
            </div>
          </div>
          <button id="closeModalBtn" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-6 h-6 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="p-6 border-b border-gray-200 dark:border-gray-700">
          <div class="relative">
            <input 
              type="text" 
              id="articleSearch" 
              placeholder="Search articles..." 
              class="w-full pl-10 pr-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <!-- Articles List -->
        <div class="max-h-96 overflow-y-auto" id="modalArticlesList">
          <!-- Articles will be populated here -->
        </div>

        <!-- Modal Footer -->
        <div class="p-6 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50">
          <div class="flex items-center justify-between">
            <p class="text-gray-600 dark:text-gray-400 text-sm">
              Browse all articles or use search to find specific topics
            </p>
            <a href="/categories" class="inline-flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-medium text-sm">
              View all categories
              <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script>
  let currentArticles = [];

  // API configuration
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

  // Helper functions for series
  function getSeriesIcon(topics = []) {
    const topicLower = topics.join(' ').toLowerCase();
    if (topicLower.includes('ai') || topicLower.includes('machine learning') || topicLower.includes('rag')) return "🤖";
    if (topicLower.includes('django') || topicLower.includes('web')) return "🌐";
    if (topicLower.includes('system') || topicLower.includes('design')) return "🏗️";
    if (topicLower.includes('algorithm') || topicLower.includes('dsa')) return "🧠";
    if (topicLower.includes('python')) return "🐍";
    if (topicLower.includes('javascript') || topicLower.includes('react')) return "⚛️";
    return "📚";
  }

  function getDifficultyColor(startLevel, endLevel) {
    const levels = { beginner: 1, intermediate: 2, advanced: 3 };
    const start = levels[startLevel] || 1;
    const end = levels[endLevel] || 1;
    const avg = (start + end) / 2;
    
    if (avg <= 1.5) return "from-purple-500 to-blue-500";
    if (avg <= 2.5) return "from-blue-500 to-purple-500";
    return "from-orange-500 to-red-500";
  }

  function capitalize(text) {
    return text.charAt(0).toUpperCase() + text.slice(1);
  }

  function formatDate(dateString) {
    return new Date(dateString).toLocaleDateString('en-US', { 
      month: 'long', 
      day: 'numeric', 
      year: 'numeric' 
    });
  }

  // Format number for display (add + suffix for large numbers)
  function formatStatNumber(number) {
    if (number >= 1000) {
      return (number / 1000).toFixed(1).replace(/\.0$/, '') + 'K+';
    }
    return number + '+';
  }

  // Fetch and display homepage stats
  async function loadHomeStats() {
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
    
    try {
      const response = await fetch(`${API_URL}/api/blogs/home/our-stats/`);
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      
      const result = await response.json();
      const stats = result.data;
      
      // Update each stat with animation
      const statElements = [
        { id: 'total-blogs', value: stats.total_blogs },
        { id: 'total-categories', value: stats.total_categories },
        { id: 'total-authors', value: stats.total_authors },
        { id: 'total-views', value: stats.total_views }
      ];
      
      statElements.forEach(({ id, value }, index) => {
        setTimeout(() => {
          const element = document.getElementById(id);
          if (element) {
            element.innerHTML = formatStatNumber(value);
            element.style.animation = 'slideUp 0.5s ease-out';
          }
        }, index * 100); // Stagger the animations
      });
      
    } catch (error) {
      console.error('Failed to load stats:', error);
      
      // Fallback to default values on error
      const fallbackStats = [
        { id: 'total-blogs', value: '25+' },
        { id: 'total-categories', value: '10+' },
        { id: 'total-authors', value: '2+' },
        { id: 'total-views', value: '3K+' }
      ];
      
      fallbackStats.forEach(({ id, value }, index) => {
        setTimeout(() => {
          const element = document.getElementById(id);
          if (element) {
            element.innerHTML = value;
            element.style.animation = 'slideUp 0.5s ease-out';
          }
        }, index * 100);
      });
    }
  }

  // Fetch and display featured series
  async function loadFeaturedSeries() {
    const container = document.getElementById('featured-series-container');
    
    // Show loading state
    container.innerHTML = `
      <div class="col-span-full flex items-center justify-center py-8">
        <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
          <svg class="animate-spin w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span class="text-sm">Loading series...</span>
        </div>
      </div>
    `;

    try {
      const response = await fetch(`${API_URL}/api/blogs/series/?page_size=10`);
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      
      const data = await response.json();
      const allSeries = data.results || []; // Show all series, not just live ones
      
      if (allSeries.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-8">
            <div class="text-4xl mb-3">🚀</div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
              New Series Coming Soon!
            </h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">
              We're preparing amazing content series for you.
            </p>
            <a href="/blog" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-200 hover:scale-105 text-sm">
              <span>Explore Articles</span>
              <svg class="ml-2 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        `;
        return;
      }

      // Display series as a simple list
      const displaySeries = allSeries.slice(0, 10); // Show more series in list format
      
      container.innerHTML = `
        <!-- Series List -->
        <div class="space-y-4">
          ${displaySeries.map((series, index) => {
            const articlesCount = series.articles_count || 0;
            const plannedArticles = series.planned_articles || 0;
            const icon = getSeriesIcon(series.topic_covered || []);
            
            return `
              <div class="flex items-center justify-between p-4 bg-white/95 dark:bg-gray-900/95 backdrop-blur-sm rounded-lg border border-purple-200/50 dark:border-purple-700/30 hover:border-purple-300 dark:hover:border-purple-400/50 hover:shadow-md transition-all duration-200" style="animation-delay: ${index * 0.05}s">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 bg-gradient-to-r from-purple-600 to-blue-600 rounded-lg flex items-center justify-center text-lg flex-shrink-0">
                    ${icon}
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-3 mb-1">
                      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                        ${series.title}
                      </h3>
                      <div class="flex items-center gap-1 ${series.is_live ? 'bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400' : 'bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-400'} px-2 py-1 rounded-full text-xs font-medium">
                        <div class="w-1.5 h-1.5 ${series.is_live ? 'bg-purple-500 animate-pulse' : 'bg-green-500'} rounded-full"></div>
                        ${series.is_live ? 'Live' : 'Complete'}
                      </div>
                    </div>
                    <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400">
                      ${series.topic_covered && series.topic_covered.length > 0 ? `
                        <span>${series.topic_covered.slice(0, 2).join(', ')}</span>
                      ` : ''}
                    </div>
                  </div>
                </div>
                <a href="/series/${series.slug}" class="text-purple-600 dark:text-purple-400 font-medium hover:underline text-sm">
                  View Series →
                </a>
              </div>
            `;
          }).join('')}
        </div>
      `;
    } catch (error) {
      console.error('Failed to load ongoing series:', error);
      container.innerHTML = `
        <div class="col-span-full text-center py-8">
          <div class="text-4xl mb-3">⚠️</div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
            Unable to Load Series
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">
            Connection issue. Please try again.
          </p>
          <button 
            onclick="loadFeaturedSeries()" 
            class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-200 hover:scale-105 text-sm"
          >
            <svg class="w-3 h-3 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Retry
          </button>
        </div>
      `;
    }
  }

  // Declare global functions
  declare global {
    interface Window {
      openCategoryModal: (category: string, articles: any[]) => void;
      closeCategoryModal: () => void;
      loadFeaturedSeries: () => Promise<void>;
      loadHomeStats: () => Promise<void>;
    }
  }

  // Make functions globally available
  (window as any).loadFeaturedSeries = loadFeaturedSeries;
  (window as any).loadHomeStats = loadHomeStats;

  (window as any).openCategoryModal = function(category, articles) {
    currentArticles = articles;
    const modal = document.getElementById('categoryModal');
    const modalContent = document.getElementById('modalContent');
    const modalTitle = document.getElementById('modalTitle');
    const modalCount = document.getElementById('modalCount');
    const modalIcon = document.getElementById('modalIcon');
    const searchInput = document.getElementById('articleSearch');
    
    // Icon mapping
    const icons = {
      'python': '🐍',
      'javascript': '🟨',
      'react': '⚛️',
      'django': '🎸',
      'database': '🗄️',
      'devops': '⚙️',
      'nginx': '🌐',
      'docker': '🐳',
      'system design': '🏗️',
      'programming': '💻'
    };

    // Color mapping
    const colors = {
      'python': 'from-blue-500 to-blue-600',
      'javascript': 'from-yellow-500 to-yellow-600',
      'react': 'from-cyan-500 to-cyan-600',
      'django': 'from-purple-500 to-purple-600',
      'database': 'from-purple-500 to-purple-600',
      'devops': 'from-orange-500 to-orange-600',
      'nginx': 'from-indigo-500 to-indigo-600',
      'docker': 'from-blue-500 to-blue-600',
      'system design': 'from-pink-500 to-pink-600',
      'programming': 'from-gray-500 to-gray-600'
    };
    
    // Update modal content
    modalTitle.textContent = category.charAt(0).toUpperCase() + category.slice(1);
    modalCount.textContent = `${articles.length} article${articles.length !== 1 ? 's' : ''}`;
    modalIcon.textContent = icons[category.toLowerCase()] || '📝';
    modalIcon.className = `w-10 h-10 bg-gradient-to-r ${colors[category.toLowerCase()] || 'from-gray-500 to-gray-600'} rounded-xl flex items-center justify-center text-white text-xl`;
    
    // Clear search
    (searchInput as HTMLInputElement).value = '';
    
    // Show modal with animation
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
    }, 10);
    
    // Render articles
    renderArticles(articles);
    
    // Prevent body scrolling
    document.body.style.overflow = 'hidden';
  };

  (window as any).closeCategoryModal = function() {
    const modal = document.getElementById('categoryModal');
    const modalContent = document.getElementById('modalContent');
    
    modal.classList.add('opacity-0');
    modalContent.classList.remove('scale-100');
    modalContent.classList.add('scale-95');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  };

  function renderArticles(articles) {
    const articlesList = document.getElementById('modalArticlesList');
    
    if (articles.length === 0) {
      articlesList.innerHTML = `
        <div class="p-8 text-center">
          <div class="text-gray-400 text-6xl mb-4">🔍</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No articles found</h3>
          <p class="text-gray-600 dark:text-gray-400">Try adjusting your search terms.</p>
        </div>
      `;
      return;
    }
    
    articlesList.innerHTML = articles.map(article => `
      <a href="/blog/${article.slug}" class="block p-6 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors border-b border-gray-200 dark:border-gray-700 last:border-b-0">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              ${article.tags.slice(0, 3).map(tag => `
                <span class="px-2 py-1 bg-gray-100 dark:bg-gray-600 text-gray-600 dark:text-gray-300 rounded text-xs">
                  ${tag}
                </span>
              `).join('')}
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              ${article.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2">
              ${article.description}
            </p>
          </div>
          <div class="flex items-center gap-4 mt-3 sm:mt-0 sm:ml-6 text-xs sm:text-sm text-gray-500 dark:text-gray-400">
            <span>${new Date(article.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
            <span>${article.readingTime}</span>
          </div>
        </div>
      </a>
    `).join('');
  }

  // Event delegation and initialization
  document.addEventListener('DOMContentLoaded', function() {
    // Load stats and featured series on page load
    loadHomeStats();
    loadFeaturedSeries();

    // Handle category modal buttons
    document.addEventListener('click', function(e) {
      const target = e.target as HTMLElement;
      
      if (target.closest('.category-modal-btn')) {
        e.preventDefault();
        const btn = target.closest('.category-modal-btn') as HTMLElement;
        const category = btn.getAttribute('data-category');
        const articles = JSON.parse(btn.getAttribute('data-articles') || '[]');
        (window as any).openCategoryModal(category, articles);
      }
      
      // Handle close button
      if (target.closest('#closeModalBtn')) {
        (window as any).closeCategoryModal();
      }
    });

    // Search functionality
    const searchInput = document.getElementById('articleSearch');
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        const filteredArticles = currentArticles.filter(article => 
          article.title.toLowerCase().includes(query) ||
          article.description.toLowerCase().includes(query) ||
          article.tags.some(tag => tag.toLowerCase().includes(query))
        );
        renderArticles(filteredArticles);
      });
    }

    // Close modal on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        (window as any).closeCategoryModal();
      }
    });

    // Close modal on backdrop click
    const modal = document.getElementById('categoryModal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) {
          (window as any).closeCategoryModal();
        }
      });
    }
  });
</script>

