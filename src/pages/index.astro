<script>
  // API configuration
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

  // Helper functions for series
  function getSeriesIcon(topics = []) {
    const topicLower = topics.join(' ').toLowerCase();
    if (topicLower.includes('ai') || topicLower.includes('machine learning') || topicLower.includes('rag')) return "🤖";
    if (topicLower.includes('django') || topicLower.includes('web')) return "🌐";
    if (topicLower.includes('system') || topicLower.includes('design')) return "🏗️";
    if (topicLower.includes('algorithm') || topicLower.includes('dsa')) return "🧠";
    if (topicLower.includes('python')) return "🐍";
    if (topicLower.includes('javascript') || topicLower.includes('react')) return "⚛️";
    return "📚";
  }

  function getDifficultyColor(startLevel, endLevel) {
    const levels = { beginner: 1, intermediate: 2, advanced: 3 };
    const start = levels[startLevel] || 1;
    const end = levels[endLevel] || 1;
    const avg = (start + end) / 2;

    if (avg <= 1.5) return "from-purple-500 to-blue-500";
    if (avg <= 2.5) return "from-blue-500 to-purple-500";
    return "from-orange-500 to-red-500";
  }

  function capitalize(text) {
    return text.charAt(0).toUpperCase() + text.slice(1);
  }

  function formatDate(dateString) {
    return new Date(dateString).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    });
  }

  // Format number for display (add + suffix for large numbers)
  function formatStatNumber(number) {
    if (number >= 1000) {
      return (number / 1000).toFixed(1).replace(/\.0$/, '') + 'K+';
    }
    return number + '+';
  }

  // Fetch and display homepage stats
  async function loadHomeStats() {
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
    try {
      const response = await fetch(`${API_URL}/api/blogs/home/our-stats/`);
      const result = await response.json();

      if (result.code === 0 && result.data) {
        const stats = result.data;

        // Update hero stats
        const heroBlogs = document.getElementById('total-blogs-hero');
        const heroCategories = document.getElementById('total-categories-hero');
        const heroAuthors = document.getElementById('total-authors-hero');
        const heroViews = document.getElementById('total-views-hero');

        if (heroBlogs) {
          heroBlogs.innerHTML = `${stats.total_blogs}+`;
        }
        if (heroCategories) {
          heroCategories.innerHTML = `${stats.total_categories}+`;
        }
        if (heroAuthors) {
          heroAuthors.innerHTML = `${stats.total_authors}+`;
        }
        if (heroViews) {
          // Format views (e.g., 5500 -> 5.5k)
          const formattedViews = stats.total_views >= 1000 
            ? `${(stats.total_views / 1000).toFixed(1)}k` 
            : stats.total_views;
          heroViews.innerHTML = `${formattedViews}+`;
        }
      }
    } catch (error) {
      console.error('Failed to load stats:', error);
      // Show fallback values
      const heroBlogs = document.getElementById('total-blogs-hero');
      const heroCategories = document.getElementById('total-categories-hero');
      const heroAuthors = document.getElementById('total-authors-hero');
      const heroViews = document.getElementById('total-views-hero');

      if (heroBlogs) heroBlogs.innerHTML = '25+';
      if (heroCategories) heroCategories.innerHTML = '10+';
      if (heroAuthors) heroAuthors.innerHTML = '2+';
      if (heroViews) heroViews.innerHTML = '5k+';
    }
  }

  // Fetch and display featured series
  async function loadFeaturedSeries() {
    const container = document.getElementById('featured-series-container');

    // Show loading state
    container.innerHTML = `
      <div class="col-span-full flex items-center justify-center py-8">
        <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
          <svg class="animate-spin w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span class="text-sm">Loading series...</span>
        </div>
      </div>
    `;

    try {
      const response = await fetch(`${API_URL}/api/blogs/series/?page_size=10`);
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

      const data = await response.json();
      const allSeries = data.results || [];

      // Filter series: only check if not deactivated for now to ensure visibility
      const featuredSeries = allSeries.filter(series => 
        !series.is_deactivated && series.show_on_featured
      );

      if (featuredSeries.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-8">
            <div class="text-4xl mb-3">🚀</div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
              New Series Coming Soon!
            </h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">
              We're preparing amazing content series for you.
            </p>
            <a href="/blog" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-200 hover:scale-105 text-sm">
              <span>Explore Articles</span>
              <svg class="ml-2 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        `;
        return;
      }

      // Display series as a simple list
      const displaySeries = featuredSeries.slice(0, 10); // Show top 10 featured series

      container.innerHTML = displaySeries.map((series, index) => {
        const articlesCount = series.total_published_articles || 0;
        const icon = getSeriesIcon(series.topic_covered || []);
        const author = series.authors && series.authors[0] ? series.authors[0] : null;
        
        // Premium Card Template
        return `
          <article 
            class="group relative flex flex-col h-full bg-white dark:bg-slate-900 border border-gray-100 dark:border-gray-800 rounded-3xl overflow-hidden hover:shadow-2xl hover:shadow-purple-500/10 transition-all duration-500 hover:-translate-y-2"
            style="animation: fadeInUp 0.6s ease-out forwards; animation-delay: ${index * 0.1}s; opacity: 0;"
          >
             <!-- Cover Gradient (Top) -->
             <div class="h-32 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-slate-800 dark:to-slate-900 relative p-6 flex flex-col justify-between group-hover:h-36 transition-all duration-500">
                <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-30"></div>
                
                <!-- Floating Icon -->
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 shadow-lg flex items-center justify-center text-2xl z-10 border border-gray-100 dark:border-gray-700 group-hover:scale-110 transition-transform duration-300">
                   ${icon}
                </div>

                <!-- Status Badge -->
                <div class="absolute top-6 right-6 z-10">
                   <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-white/50 dark:bg-black/20 backdrop-blur border border-white/20 dark:border-white/5 text-gray-600 dark:text-gray-300">
                      ${articlesCount} Articles
                   </span>
                </div>
             </div>

             <!-- Content -->
             <div class="p-6 flex-1 flex flex-col bg-white dark:bg-slate-900 relative">
                <!-- Decorative Arc -->
                <div class="absolute -top-6 left-0 right-0 h-6 bg-white dark:bg-slate-900 rounded-t-3xl"></div>

                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 line-clamp-2 leading-tight group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                   <a href="/series/${series.slug}" class="block">
                     ${series.title}
                   </a>
                </h3>
                
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-6 line-clamp-2 leading-relaxed">
                   ${series.description || 'Master this topic with our comprehensive, step-by-step guide.'}
                </p>

                <!-- Footer -->
                <div class="mt-auto pt-4 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between">
                   <!-- Author -->
                   <div class="flex items-center gap-2">
                      ${author ? `
                        <div class="w-6 h-6 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center overflow-hidden">
                           ${author.profile_image ? 
                             `<img src="${author.profile_image}" class="w-full h-full object-cover">` : 
                             `<span class="text-[10px] font-bold text-gray-600">${author.first_name[0]}</span>`
                           }
                        </div>
                        <span class="text-xs font-medium text-gray-600 dark:text-gray-400">${author.first_name}</span>
                      ` : ''}
                   </div>
                   
                   <a href="/series/${series.slug}" class="text-sm font-bold text-purple-600 dark:text-purple-400 flex items-center gap-1 group/link">
                      Start Learning
                      <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                   </a>
                </div>
             </div>
          </article>
        `;
      }).join('');
    } catch (error) {
      console.error('Failed to load ongoing series:', error);
      container.innerHTML = `
        <div class="col-span-full text-center py-8">
          <div class="text-4xl mb-3">⚠️</div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
            Unable to Load Series
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">
            Connection issue. Please try again.
          </p>
          <button
            onclick="loadFeaturedSeries()"
            class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-200 hover:scale-105 text-sm"
          >
            <svg class="w-3 h-3 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Retry
          </button>
        </div>
      `;
    }
  }

  // Declare global functions
  declare global {
    interface Window {
      loadFeaturedSeries: () => Promise<void>;
      loadHomeStats: () => Promise<void>;
    }
  }

  // Make functions globally available
  (window as any).loadFeaturedSeries = loadFeaturedSeries;
  (window as any).loadHomeStats = loadHomeStats;
  // Event delegation and initialization
  document.addEventListener('DOMContentLoaded', function() {
    // Load stats and featured series on page load
    loadHomeStats();
    loadFeaturedSeries();


  });
</script>

