                    class={`category-modal-btn w-full inline-flex items-center justify-center px-4 py-3 bg-gradient-to-r ${scheme.gradient} text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-black/20 dark:hover:shadow-white/10 transition-all duration-300 transform hover:scale-105 group/btn`}
