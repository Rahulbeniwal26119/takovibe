<script>
  // API configuration
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

  // Helper functions for series
  function getSeriesIcon(topics = []) {
    const topicLower = topics.join(' ').toLowerCase();
    if (topicLower.includes('ai') || topicLower.includes('machine learning') || topicLower.includes('rag')) return "🤖";
    if (topicLower.includes('django') || topicLower.includes('web')) return "🌐";
    if (topicLower.includes('system') || topicLower.includes('design')) return "🏗️";
    if (topicLower.includes('algorithm') || topicLower.includes('dsa')) return "🧠";
    if (topicLower.includes('python')) return "🐍";
    if (topicLower.includes('javascript') || topicLower.includes('react')) return "⚛️";
    return "📚";
  }

  function getDifficultyColor(startLevel, endLevel) {
    const levels = { beginner: 1, intermediate: 2, advanced: 3 };
    const start = levels[startLevel] || 1;
    const end = levels[endLevel] || 1;
    const avg = (start + end) / 2;

    if (avg <= 1.5) return "from-purple-500 to-blue-500";
    if (avg <= 2.5) return "from-blue-500 to-purple-500";
    return "from-orange-500 to-red-500";
  }

  function capitalize(text) {
    return text.charAt(0).toUpperCase() + text.slice(1);
  }

  function formatDate(dateString) {
    return new Date(dateString).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    });
  }

  // Format number for display (add + suffix for large numbers)
  function formatStatNumber(number) {
    if (number >= 1000) {
      return (number / 1000).toFixed(1).replace(/\.0$/, '') + 'K+';
    }
    return number + '+';
  }

  // Fetch and display homepage stats
  async function loadHomeStats() {
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
    try {
      const response = await fetch(`${API_URL}/api/blogs/home/our-stats/`);
      const result = await response.json();

      if (result.code === 0 && result.data) {
        const stats = result.data;

        // Update hero stats
        const heroBlogs = document.getElementById('total-blogs-hero');
        const heroCategories = document.getElementById('total-categories-hero');
        const heroAuthors = document.getElementById('total-authors-hero');
        const heroViews = document.getElementById('total-views-hero');

        if (heroBlogs) {
          heroBlogs.innerHTML = `${stats.total_blogs}+`;
        }
        if (heroCategories) {
          heroCategories.innerHTML = `${stats.total_categories}+`;
        }
        if (heroAuthors) {
          heroAuthors.innerHTML = `${stats.total_authors}+`;
        }
        if (heroViews) {
          // Format views (e.g., 5500 -> 5.5k)
          const formattedViews = stats.total_views >= 1000 
            ? `${(stats.total_views / 1000).toFixed(1)}k` 
            : stats.total_views;
          heroViews.innerHTML = `${formattedViews}+`;
        }
      }
    } catch (error) {
      console.error('Failed to load stats:', error);
      // Show fallback values
      const heroBlogs = document.getElementById('total-blogs-hero');
      const heroCategories = document.getElementById('total-categories-hero');
      const heroAuthors = document.getElementById('total-authors-hero');
      const heroViews = document.getElementById('total-views-hero');

      if (heroBlogs) heroBlogs.innerHTML = '25+';
      if (heroCategories) heroCategories.innerHTML = '10+';
      if (heroAuthors) heroAuthors.innerHTML = '2+';
      if (heroViews) heroViews.innerHTML = '5k+';
    }
  }

  // Fetch and display featured series
  async function loadFeaturedSeries() {
    const container = document.getElementById('featured-series-container');

    // Show loading state
    container.innerHTML = `
      <div class="col-span-full flex items-center justify-center py-8">
        <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
          <svg class="animate-spin w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span class="text-sm">Loading series...</span>
        </div>
      </div>
    `;

    try {
      const response = await fetch(`${API_URL}/api/blogs/series/?page_size=10`);
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

      const data = await response.json();
      const allSeries = data.results || [];

      // Filter series: show_on_featured=true AND (is_live=true OR is_completed=true) AND is_deactivated=false
      const featuredSeries = allSeries.filter(series => 
        series.show_on_featured && 
        (series.is_live || series.is_completed) && 
        !series.is_deactivated
      );

      if (featuredSeries.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-8">
            <div class="text-4xl mb-3">🚀</div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
              New Series Coming Soon!
            </h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">
              We're preparing amazing content series for you.
            </p>
            <a href="/blog" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-200 hover:scale-105 text-sm">
              <span>Explore Articles</span>
              <svg class="ml-2 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        `;
        return;
      }

      // Display series as a simple list
      const displaySeries = featuredSeries.slice(0, 10); // Show top 10 featured series

      container.innerHTML = displaySeries.map((series, index) => {
        const articlesCount = series.articles_count || 0;
        const plannedArticles = series.planned_articles || 0;
        const progress = plannedArticles > 0 ? Math.round((articlesCount / plannedArticles) * 100) : 0;
        const icon = getSeriesIcon(series.topic_covered || []);
        
        // Determine vibrant gradient based on topic
        let gradient = "from-purple-600 via-pink-600 to-blue-600";
        let bgGradient = "from-purple-500/20 to-blue-500/20";
        let borderClass = "border-purple-200/50 dark:border-purple-700/50";
        let textGradient = "from-purple-600 to-blue-600";
        
        const topicLower = (series.topic_covered || []).join(' ').toLowerCase();
        
        if (topicLower.includes('python') || topicLower.includes('django')) {
          gradient = "from-blue-600 via-cyan-500 to-teal-400";
          bgGradient = "from-blue-500/20 to-cyan-500/20";
          borderClass = "border-blue-200/50 dark:border-blue-700/50";
          textGradient = "from-blue-600 to-cyan-500";
        } else if (topicLower.includes('javascript') || topicLower.includes('react')) {
          gradient = "from-orange-500 via-amber-500 to-yellow-400";
          bgGradient = "from-orange-500/20 to-yellow-500/20";
          borderClass = "border-orange-200/50 dark:border-orange-700/50";
          textGradient = "from-orange-600 to-yellow-500";
        } else if (topicLower.includes('ai') || topicLower.includes('ml')) {
          gradient = "from-emerald-500 via-green-500 to-lime-400";
          bgGradient = "from-emerald-500/20 to-lime-500/20";
          borderClass = "border-emerald-200/50 dark:border-emerald-700/50";
          textGradient = "from-emerald-600 to-lime-500";
        }

        return `
          <article 
            class="group relative flex flex-col h-full bg-white dark:bg-slate-800/80 backdrop-blur-xl rounded-2xl border ${borderClass} hover:border-transparent transition-all duration-300 hover:shadow-2xl hover:shadow-purple-500/20 hover:-translate-y-2 overflow-hidden"
            style="animation: fadeInUp 0.6s ease-out forwards; animation-delay: ${index * 0.1}s; opacity: 0;"
          >
            <!-- Animated Gradient Border on Hover -->
            <div class="absolute inset-0 bg-gradient-to-r ${gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10" style="margin: -1px; border-radius: 1rem;"></div>
            <div class="absolute inset-[1px] bg-white dark:bg-slate-900 rounded-2xl -z-10"></div>

            <!-- Top Gradient Bar -->
            <div class="h-2 w-full bg-gradient-to-r ${gradient}"></div>
            
            <div class="p-6 flex-1 flex flex-col relative z-10">
              <!-- Header -->
              <div class="flex items-start justify-between mb-6">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br ${bgGradient} flex items-center justify-center text-3xl shadow-sm group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
                  ${icon}
                </div>
                
                <div class="flex items-center gap-2">
                  ${series.is_live ? `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800/50 shadow-sm">
                      <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                      </span>
                      LIVE
                    </span>
                  ` : `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50 shadow-sm">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      DONE
                    </span>
                  `}
                </div>
              </div>
              
              <!-- Content -->
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 group-hover:bg-gradient-to-r ${textGradient} group-hover:bg-clip-text group-hover:text-transparent transition-all duration-300">
                ${series.title}
              </h3>
              
              <p class="text-slate-600 dark:text-slate-400 text-sm mb-6 line-clamp-2 flex-1 leading-relaxed">
                ${series.description || `Master ${series.title} with our comprehensive, step-by-step guide designed for developers.`}
              </p>
              
              <!-- Footer Info -->
              <div class="mt-auto pt-4 border-t border-slate-100 dark:border-slate-700/50">
                <div class="flex items-center justify-center text-sm">
                  <span class="font-bold bg-gradient-to-r ${textGradient} bg-clip-text text-transparent group-hover:scale-105 transition-transform inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-50 dark:bg-slate-800/50 group-hover:bg-white dark:group-hover:bg-slate-800 border border-transparent group-hover:border-purple-200 dark:group-hover:border-purple-700/30 shadow-sm group-hover:shadow-md">
                    Start Learning
                    <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
            
            <a href="/series/${series.slug}" class="absolute inset-0 z-10" aria-label="View Series: ${series.title}"></a>
          </article>
        `;
      }).join('');
    } catch (error) {
      console.error('Failed to load ongoing series:', error);
      container.innerHTML = `
        <div class="col-span-full text-center py-8">
          <div class="text-4xl mb-3">⚠️</div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
            Unable to Load Series
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm">
            Connection issue. Please try again.
          </p>
          <button
            onclick="loadFeaturedSeries()"
            class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-200 hover:scale-105 text-sm"
          >
            <svg class="w-3 h-3 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Retry
          </button>
        </div>
      `;
    }
  }

  // Declare global functions
  declare global {
    interface Window {
      loadFeaturedSeries: () => Promise<void>;
      loadHomeStats: () => Promise<void>;
    }
  }

  // Make functions globally available
  (window as any).loadFeaturedSeries = loadFeaturedSeries;
  (window as any).loadHomeStats = loadHomeStats;
  // Event delegation and initialization
  document.addEventListener('DOMContentLoaded', function() {
    // Load stats and featured series on page load
    loadHomeStats();
    loadFeaturedSeries();


  });
</script>

