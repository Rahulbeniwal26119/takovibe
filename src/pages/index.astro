---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

interface ApiBlogPost {
  id: number;
  created_at: string;
  author: {
    name: string;
  };
  title: string;
  slug: string;
  tags: string[];
  description: string;
  image_url: string;
  is_published: boolean;
}

let featuredPosts: ApiBlogPost[] = [];

try {
  const response = await fetch(`${API_URL}/api/blogs/home/home-blogs/`);
  if (response.ok) {
    const result = await response.json();
    featuredPosts = (result.data || [])
      .filter((post: ApiBlogPost) => post.is_published)
      .sort(
        (a: ApiBlogPost, b: ApiBlogPost) =>
          new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
      )
      .slice(0, 4);
  }
} catch (error) {
  console.warn("Homepage articles could not be loaded.", error);
}

const productSuite = [
  {
    number: "01",
    title: "ResumeVibe",
    copy: "Audit your resume, sharpen the story, and understand what a hiring screen sees before you send the next application.",
    href: "https://resumevibe.takovibe.com/",
    label: "Career tool",
    cta: "Open ResumeVibe",
    accent: "from-orange-500/30 via-orange-400/5 to-transparent",
    layout: "xl:col-span-2",
  },
  {
    number: "02",
    title: "CodeDiff",
    copy: "Review a patch with less noise. Compare changes, follow the reasoning, and share a cleaner engineering conversation.",
    href: "https://codediff.takovibe.com/",
    label: "Developer tool",
    cta: "Open CodeDiff",
    accent: "from-sky-500/25 via-sky-400/5 to-transparent",
    layout: "xl:col-span-2",
  },
  {
    number: "03",
    title: "Reader",
    copy: "Read EPUBs in a calmer space. Sync progress, collect colored highlights, attach memory notes, translate passages, and keep Kumi nearby.",
    href: "/reader",
    label: "Learning tool",
    cta: "Open Reader",
    accent: "from-amber-500/25 via-amber-400/5 to-transparent",
    layout: "xl:col-span-2",
  },
  {
    number: "04",
    title: "Sketch Notes",
    copy: "Capture a system visually while you learn it. Keep the diagram close enough to the source that it still makes sense tomorrow.",
    href: "/notes",
    label: "Thinking tool",
    cta: "Open Notes",
    accent: "from-rose-500/20 via-rose-400/5 to-transparent",
    layout: "xl:col-span-2",
  },
  {
    number: "05",
    title: "Learning Tasks",
    copy: "Turn reading, sketch notes, and learning goals into a plan. Filter by priority, collection, and date, then log the hours you actually spent.",
    href: "/tasks",
    label: "Planning tool",
    cta: "Open Tasks",
    accent: "from-violet-500/20 via-violet-400/5 to-transparent",
    layout: "xl:col-span-2",
  },
  {
    number: "06",
    title: "Playground",
    copy: "Run Python, JavaScript, Go, Rust, or front-end experiments in the browser and share the result without setup.",
    href: "/playground",
    label: "Code tool",
    cta: "Open Playground",
    accent: "from-emerald-500/20 via-emerald-400/5 to-transparent",
    layout: "xl:col-span-2",
  },
];
---

<Layout
  title="TakoVibe - Learn by following the idea"
  description="A technical reading workspace for articles, EPUBs, visual notes, runnable code, and focused AI help."
  type="website"
  author="TakoVibe Team"
  tags={["software engineering", "system design", "developer learning", "EPUB reader", "visual notes"]}
>
  <div class="home-shell min-h-screen overflow-hidden bg-[#f4f0e8] text-neutral-950 dark:bg-[#11100e] dark:text-stone-100">
    <section class="relative isolate overflow-hidden border-b border-black/10 dark:border-white/10">
      <div class="hero-grid absolute inset-0 -z-20 opacity-60 dark:opacity-35"></div>
      <div class="absolute -right-24 top-28 -z-10 h-72 w-72 rounded-full bg-orange-400/20 blur-3xl sm:h-[34rem] sm:w-[34rem]"></div>

      <div class="mx-auto grid min-h-[calc(100vh-5rem)] max-w-[1440px] gap-10 px-5 pb-14 pt-16 sm:px-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-end lg:px-12 lg:pb-16 lg:pt-20">
        <div class="max-w-4xl">
          <p class="home-kicker home-rise">A workspace for technical curiosity</p>
          <h1 class="home-rise home-delay-1 mt-8 max-w-5xl font-display text-[clamp(4.25rem,11vw,10rem)] font-extrabold leading-[0.82] tracking-[-0.085em]">
            Follow
            <span class="block text-orange-600 dark:text-orange-400">the idea.</span>
          </h1>
          <p class="home-rise home-delay-2 mt-9 max-w-2xl text-lg leading-8 text-neutral-700 dark:text-stone-300 sm:text-xl sm:leading-9">
            Read deeply. Ask better questions. Sketch the system. Run the code.
            TakoVibe keeps the tools of understanding close to the thing you are
            trying to understand.
          </p>
          <div class="home-rise home-delay-3 mt-9 flex flex-wrap gap-3">
            <a class="home-button home-button-primary" href="/blog">
              Start reading
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13m-5-5 5 5-5 5"></path>
              </svg>
            </a>
            <a class="home-button home-button-secondary" href="/reader">
              Open EPUB reader
            </a>
          </div>
        </div>

        <div class="home-rise home-delay-2 lg:justify-self-end">
          <p class="max-w-md text-sm leading-6 text-neutral-600 dark:text-stone-400">
            Not another tab full of disconnected tools. One place to stay with a
            difficult idea long enough for it to become useful.
          </p>
          <div class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-black/10 bg-black/10 dark:border-white/10 dark:bg-white/10">
            <div class="bg-[#f4f0e8] p-4 dark:bg-[#11100e]">
              <span class="home-kicker">Mode</span>
              <strong class="mt-2 block text-sm">Active reading</strong>
            </div>
            <div class="bg-[#f4f0e8] p-4 dark:bg-[#11100e]">
              <span class="home-kicker">Context</span>
              <strong class="mt-2 block text-sm">Kept nearby</strong>
            </div>
            <div class="bg-[#f4f0e8] p-4 dark:bg-[#11100e]">
              <span class="home-kicker">Output</span>
              <strong class="mt-2 block text-sm">Notes that stick</strong>
            </div>
            <div class="bg-[#f4f0e8] p-4 dark:bg-[#11100e]">
              <span class="home-kicker">Pace</span>
              <strong class="mt-2 block text-sm">Yours</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-black/10 bg-[#181713] text-stone-200 dark:border-white/10">
        <div class="home-marquee flex min-w-max items-center gap-10 py-3 text-[10px] font-bold uppercase tracking-[0.24em] text-stone-400">
          <span>Reader</span><i></i><span>Learning tasks</span><i></i><span>System design</span><i></i><span>Runnable code</span><i></i><span>Sketch notes</span><i></i><span>Contextual AI</span><i></i><span>Reader</span><i></i><span>Learning tasks</span><i></i><span>System design</span><i></i><span>Runnable code</span><i></i><span>Sketch notes</span><i></i><span>Contextual AI</span>
        </div>
      </div>
    </section>

    <section class="px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
      <div class="mx-auto max-w-[1440px]">
        <div class="grid gap-10 lg:grid-cols-[0.42fr_1fr] lg:gap-20">
          <div>
            <p class="home-kicker">The learning surface</p>
            <h2 class="mt-5 font-display text-4xl font-bold leading-[0.96] tracking-[-0.065em] sm:text-6xl">
              Stay with the difficult part.
            </h2>
            <p class="mt-6 max-w-sm text-base leading-7 text-neutral-600 dark:text-stone-400">
              The best learning tools do not interrupt the thought. They open at
              the moment they are needed, then get out of the way.
            </p>
          </div>

          <div class="workspace-frame relative overflow-hidden rounded-[1.75rem] border border-black/10 bg-[#181713] text-stone-100 shadow-2xl shadow-orange-950/15 dark:border-white/10">
            <div class="flex items-center justify-between border-b border-white/10 px-4 py-3 sm:px-5">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-orange-500"></span>
                <span class="home-kicker text-stone-400">Reading workspace</span>
              </div>
              <span class="rounded-full border border-white/10 px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.18em] text-orange-300">Focus mode</span>
            </div>

            <div class="grid min-h-[560px] lg:grid-cols-[1.12fr_0.88fr]">
              <article class="relative border-b border-white/10 p-6 sm:p-9 lg:border-b-0 lg:border-r">
                <p class="home-kicker text-orange-300">System design / queues</p>
                <h3 class="mt-7 max-w-xl font-display text-3xl font-bold leading-[1.02] tracking-[-0.06em] sm:text-5xl">
                  Backpressure is a promise to the rest of your system.
                </h3>
                <div class="mt-8 max-w-xl space-y-4 text-sm leading-7 text-stone-400 sm:text-base">
                  <p>
                    When incoming work arrives faster than your workers can
                    process it, the queue gives the system somewhere honest to
                    put the pressure.
                  </p>
                  <p class="border-l-2 border-orange-500 bg-white/[0.045] px-4 py-3 text-stone-200">
                    The goal is not infinite capacity. It is graceful behavior
                    when capacity is finite.
                  </p>
                  <p class="home-kicker text-orange-300">Saved highlight / memory note attached</p>
                </div>
                <div class="mt-8 flex flex-wrap gap-2 text-[10px] font-bold uppercase tracking-[0.16em]">
                  <span class="rounded-full border border-orange-400/30 bg-orange-400/10 px-3 py-1.5 text-orange-200">Highlight</span>
                  <span class="rounded-full border border-white/10 px-3 py-1.5 text-stone-400">Ask Kumi</span>
                  <span class="rounded-full border border-white/10 px-3 py-1.5 text-stone-400">Translate</span>
                </div>
                <div class="absolute inset-x-6 bottom-6 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.14em] text-stone-500 sm:inset-x-9">
                  <span>42%</span>
                  <span class="h-px flex-1 bg-white/10"><span class="block h-px w-[42%] bg-orange-500"></span></span>
                  <span>07:14</span>
                </div>
              </article>

              <aside class="grid bg-[#12110f] sm:grid-cols-2 lg:grid-cols-1">
                <div class="border-b border-white/10 p-5">
                  <div class="flex items-center justify-between">
                    <p class="home-kicker text-stone-500">Sketch note</p>
                    <span class="text-orange-400">+</span>
                  </div>
                  <div class="mt-5 rounded-xl border border-white/10 bg-white/[0.035] p-4">
                    <div class="flex items-center justify-between gap-2 text-[10px] font-bold uppercase tracking-[0.12em] text-stone-300">
                      <span class="rounded-lg border border-orange-400/30 bg-orange-400/10 px-2 py-2">API</span>
                      <span class="text-orange-400">-&gt;</span>
                      <span class="rounded-lg border border-amber-400/30 bg-amber-400/10 px-2 py-2">Queue</span>
                      <span class="text-orange-400">-&gt;</span>
                      <span class="rounded-lg border border-white/10 px-2 py-2">Worker</span>
                    </div>
                    <p class="mt-4 text-xs leading-5 text-stone-500">
                      Buffer the spike. Keep consumers moving at a sustainable rate.
                    </p>
                  </div>
                </div>
                <div class="border-b border-white/10 p-5 sm:border-b-0 lg:border-b">
                  <p class="home-kicker text-stone-500">Run the assumption</p>
                  <pre class="mt-5 overflow-hidden rounded-xl border border-white/10 bg-black/20 p-4 text-[11px] leading-6 text-stone-400"><code><span class="text-orange-300">const</span> capacity = 120;
<span class="text-orange-300">const</span> incoming = 360;

queue.buffer(incoming - capacity);</code></pre>
                </div>
                <div class="col-span-full p-5">
                  <p class="home-kicker text-stone-500">Kumi asks</p>
                  <p class="mt-3 max-w-sm text-sm leading-6 text-stone-300">
                    What should happen when the queue itself reaches its limit?
                  </p>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-black/10 bg-[#e9e3d8] px-5 py-20 text-neutral-950 dark:border-white/10 dark:bg-[#181713] dark:text-stone-100 sm:px-8 sm:py-28 lg:px-12">
      <div class="mx-auto max-w-[1440px]">
        <div class="grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end">
          <div>
            <p class="home-kicker text-orange-700 dark:text-orange-300">The TakoVibe toolkit</p>
            <h2 class="mt-5 max-w-4xl font-display text-5xl font-bold leading-[0.92] tracking-[-0.075em] sm:text-7xl">
              Useful tools for the work around the work.
            </h2>
          </div>
          <p class="max-w-xl text-base leading-7 text-neutral-600 dark:text-stone-400">
            TakoVibe is more than the reading surface. These tools help you
            understand, test, review, and present the things you are building.
          </p>
        </div>

        <div class="mt-14 grid gap-px overflow-hidden rounded-[1.75rem] border border-black/10 bg-black/10 dark:border-white/10 dark:bg-white/10 md:grid-cols-2 xl:grid-cols-6">
          {productSuite.map((product) => (
            <a href={product.href} class={`product-card group relative min-h-[19rem] overflow-hidden bg-[#f4f0e8] p-5 transition-colors hover:bg-white dark:bg-[#12110f] dark:hover:bg-[#201d19] sm:p-6 ${product.layout}`}>
              <div class={`absolute inset-x-0 top-0 h-36 bg-gradient-to-b ${product.accent}`}></div>
              <div class="relative flex h-full flex-col">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-mono text-xs text-orange-700 dark:text-orange-300">{product.number}</span>
                  <span class="rounded-full border border-black/10 px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-neutral-500 dark:border-white/10 dark:text-stone-400">{product.label}</span>
                </div>
                <h3 class="mt-16 font-display text-3xl font-bold tracking-[-0.055em] text-neutral-950 dark:text-white">{product.title}</h3>
                <p class="mt-4 text-sm leading-6 text-neutral-600 dark:text-stone-400">{product.copy}</p>
                <span class="home-product-link mt-auto pt-8">
                  {product.cta}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h13m-5-5 5 5-5 5"></path>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-20 sm:px-8 sm:py-28 lg:px-12" id="articles">
      <div class="mx-auto max-w-[1440px]">
        <div class="flex items-end justify-between gap-6 border-b border-black/15 pb-6 dark:border-white/15">
          <div>
            <p class="home-kicker">From the library</p>
            <h2 class="mt-4 font-display text-4xl font-bold tracking-[-0.06em] sm:text-6xl">Keep reading.</h2>
          </div>
          <a class="home-text-link" href="/blog">
            All articles
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h13m-5-5 5 5-5 5"></path>
            </svg>
          </a>
        </div>

        {featuredPosts.length > 0 ? (
          <div>
            {featuredPosts.map((post, index) => (
              <a href={`/blog/${post.slug}`} class="article-row group grid gap-5 border-b border-black/15 py-7 dark:border-white/15 sm:grid-cols-[3rem_1fr_10rem] sm:items-center">
                <span class="font-mono text-xs text-neutral-500">0{index + 1}</span>
                <div>
                  <div class="flex flex-wrap gap-2 text-[10px] font-bold uppercase tracking-[0.18em] text-orange-600 dark:text-orange-400">
                    <span>{post.tags?.[0] || "Engineering"}</span>
                    <span class="text-neutral-400">/</span>
                    <span class="text-neutral-500">{post.author?.name || "TakoVibe"}</span>
                  </div>
                  <h3 class="mt-3 max-w-4xl font-display text-2xl font-bold leading-tight tracking-[-0.04em] transition group-hover:text-orange-600 dark:group-hover:text-orange-400 sm:text-4xl">
                    {post.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 max-w-3xl text-sm leading-6 text-neutral-600 dark:text-stone-400">{post.description}</p>
                </div>
                <div class="hidden justify-self-end sm:block">
                  {post.image_url ? (
                    <img src={`${post.image_url}?tr=w-320`} alt="" class="h-20 w-32 rounded-lg object-cover grayscale transition duration-500 group-hover:grayscale-0" loading="lazy" />
                  ) : (
                    <span class="home-text-link">Read article</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="border-b border-black/15 py-12 text-neutral-600 dark:border-white/15 dark:text-stone-400">
            The next article is being prepared. Explore the full library in the meantime.
          </div>
        )}
      </div>
    </section>

    <section class="relative overflow-hidden bg-orange-600 px-5 py-20 text-white sm:px-8 sm:py-28 lg:px-12">
      <div class="cta-grid absolute inset-0 opacity-20"></div>
      <div class="relative mx-auto max-w-[1440px]">
        <p class="home-kicker text-orange-100">A quieter way to go deeper</p>
        <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <h2 class="max-w-5xl font-display text-5xl font-extrabold leading-[0.9] tracking-[-0.08em] sm:text-7xl lg:text-8xl">
            Bring the book.<br />Keep the thinking.
          </h2>
          <a class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-bold text-orange-700 transition hover:bg-orange-50" href="/reader">
            Open the reader
          </a>
          <a class="inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10" href="/tasks">
            Plan learning tasks
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .home-shell {
    --line: rgba(28, 25, 23, 0.13);
  }

  :global(.dark) .home-shell {
    --line: rgba(255, 255, 255, 0.1);
  }

  .home-kicker {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-grid,
  .cta-grid {
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .home-button {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    font-size: 0.875rem;
    font-weight: 700;
    transition: 180ms ease;
  }

  .home-button svg,
  .home-text-link svg,
  .home-product-link svg {
    height: 1rem;
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transition: transform 180ms ease;
  }

  .home-button:hover svg,
  .home-text-link:hover svg,
  .product-card:hover .home-product-link svg {
    transform: translateX(0.25rem);
  }

  .home-button-primary {
    background: #ea580c;
    color: white;
  }

  .home-button-primary:hover {
    background: #c2410c;
    transform: translateY(-2px);
  }

  .home-button-secondary {
    border: 1px solid var(--line);
  }

  .home-button-secondary:hover {
    border-color: #ea580c;
    color: #c2410c;
  }

  :global(.dark) .home-button-secondary:hover {
    color: #fb923c;
  }

  .home-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #c2410c;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.dark) .home-text-link {
    color: #fb923c;
  }

  .home-product-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fdba74;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-row {
    transition: 220ms ease;
  }

  .article-row:hover {
    padding-left: 1rem;
    padding-right: 1rem;
    background: rgba(234, 88, 12, 0.055);
  }

  .home-marquee {
    animation: drift 22s linear infinite;
  }

  .home-marquee i {
    height: 0.25rem;
    width: 0.25rem;
    border-radius: 999px;
    background: #f97316;
  }

  .home-rise {
    animation: rise 700ms both cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-delay-1 {
    animation-delay: 90ms;
  }

  .home-delay-2 {
    animation-delay: 180ms;
  }

  .home-delay-3 {
    animation-delay: 270ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-marquee,
    .home-rise {
      animation: none;
    }
  }
</style>
