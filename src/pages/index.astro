            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-pink-500 to-purple-500 flex items-center justify-center text-lg shadow-md group-hover:shadow-lg group-hover:scale-110 transition-all duration-300">
              📖
            </div>
            <div>
