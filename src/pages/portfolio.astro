---
import Layout from '../layouts/Layout.astro';

const skills = [
  { name: "Python", level: 90 },
  { name: "JavaScript", level: 85 },
  { name: "React", level: 80 },
  { name: "Node.js", level: 85 },
  { name: "Django", level: 90 },
  { name: "PostgreSQL", level: 85 },
  { name: "Docker", level: 75 },
  { name: "AWS", level: 70 }
];

const projects = [
  {
    title: "AI Code Assistant",
    description: "A VS Code extension that helps developers write better code using AI. Features include code completion, refactoring suggestions, and bug detection.",
    tech: ["TypeScript", "OpenAI API", "VS Code API"],
    image: "/projects/ai-code.webp",
    link: "https://github.com/yourusername/ai-code-assistant"
  },
  {
    title: "DevSpace Blog",
    description: "A modern blog platform built with Astro and TailwindCSS. Features MDX support, code syntax highlighting, and dark mode.",
    tech: ["Astro", "TailwindCSS", "TypeScript"],
    image: "/projects/blog-platform.webp",
    link: "https://github.com/yourusername/blog-platform"
  },
  {
    title: "Real-time Chat App",
    description: "End-to-end encrypted chat application with real-time messaging, file sharing, and voice calls.",
    tech: ["React", "Node.js", "Socket.io"],
    image: "/projects/chat-app.webp",
    link: "https://github.com/yourusername/chat-app"
  }
];
---

<Layout title="Portfolio | Rahul Beniwal">
  <div class="relative min-h-screen bg-gradient-to-br from-gray-900 via-indigo-950 to-gray-900">
    <div class="absolute inset-0 bg-black/40 z-0"></div>
    
    <canvas 
      id="starfield" 
      class="fixed inset-0 pointer-events-none opacity-40"
      style="z-index: 1;"
    ></canvas>

    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center px-4" style="z-index: 2;">
      <div class="text-center">
        <h1 
          class="text-6xl md:text-7xl font-bold text-white mb-6 opacity-0 transform translate-y-10 text-shadow-lg" 
          id="hero-title"
          style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);"
        >
          I'm Rahul Beniwal
        </h1>
        <p 
          class="text-xl md:text-2xl text-gray-100 mb-8 opacity-0 transform translate-y-10" 
          id="hero-subtitle"
          style="text-shadow: 0 1px 2px rgba(0,0,0,0.5);"
        >
          Full Stack Developer & AI Enthusiast
        </p>
        <div class="flex justify-center space-x-6 opacity-0 transform translate-y-10" id="hero-links">
          <a href="https://linkedin.com/in/yourusername" 
             class="text-white hover:text-purple-400 transition-colors"
             target="_blank">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="https://github.com/yourusername" 
             class="text-white hover:text-purple-400 transition-colors"
             target="_blank">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="relative py-20 px-4" style="z-index: 2;">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl font-bold text-center text-white mb-16" style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);">
          Skills
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {skills.map((skill, index) => (
            <div 
              class="skill-card bg-gray-900/80 backdrop-blur-sm rounded-lg p-6 opacity-0 transform translate-y-10 border border-gray-700/50"
              style={`animation: fadeInUp 0.5s ease forwards ${index * 0.1}s`}
            >
              <div class="flex justify-between mb-2">
                <span class="text-gray-100 font-medium">{skill.name}</span>
                <span class="text-purple-300">{skill.level}%</span>
              </div>
              <div class="w-full bg-gray-800 rounded-full h-2">
                <div 
                  class="bg-purple-500 h-2 rounded-full transform scale-x-0 origin-left"
                  style={`animation: scaleX 1s ease forwards ${index * 0.1 + 0.5}s; width: ${skill.level}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section class="relative py-20 px-4" style="z-index: 2;">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl font-bold text-center text-white mb-16" style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);">
          Featured Projects
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projects.map((project, index) => (
            <div 
              class="project-card bg-gray-900/80 backdrop-blur-sm rounded-lg overflow-hidden opacity-0 transform translate-y-10 border border-gray-700/50"
              style={`animation: fadeInUp 0.5s ease forwards ${index * 0.1}s`}
            >
              <img 
                src={project.image} 
                alt={project.title}
                class="w-full h-48 object-cover"
              />
              <div class="p-6">
                <h3 class="text-xl font-bold text-white mb-2">{project.title}</h3>
                <p class="text-gray-300 mb-4">{project.description}</p>
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.tech.map(tech => (
                    <span class="text-xs bg-purple-500/20 text-purple-200 px-2 py-1 rounded border border-purple-500/20">
                      {tech}
                    </span>
                  ))}
                </div>
                <a 
                  href={project.link}
                  class="inline-block bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition-colors"
                  target="_blank"
                >
                  View Project
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scaleX {
    to {
      transform: scaleX(1);
    }
  }
</style>

<script is:inline>
  (function() {
    function initStarfield() {
      const canvas = document.getElementById('starfield');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      let stars = [];
      let animationFrame;

      // Star class
      class Star {
        constructor() {
          this.reset();
        }

        reset() {
          this.x = Math.random() * canvas.width;
          this.y = Math.random() * canvas.height;
          this.z = Math.random() * 2;
          this.size = Math.random() * 2;
          this.speed = Math.random() * 0.5 + 0.1;
          this.brightness = Math.random();
        }

        update() {
          this.y += this.speed;
          if (this.y > canvas.height) {
            this.reset();
            this.y = 0;
          }
        }

        draw() {
          const alpha = this.brightness * (Math.sin(Date.now() * 0.001 + this.x) + 1) * 0.5;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
          ctx.fill();
        }
      }

      function initStars() {
        stars = [];
        const starCount = Math.floor((canvas.width * canvas.height) / 3000);
        for (let i = 0; i < starCount; i++) {
          stars.push(new Star());
        }
      }

      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        initStars();
      }

      function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        stars.forEach(star => {
          star.update();
          star.draw();
        });
        animationFrame = requestAnimationFrame(animate);
      }

      // Initialize
      resizeCanvas();
      animate();

      // Handle resize
      window.addEventListener('resize', resizeCanvas);

      return () => {
        cancelAnimationFrame(animationFrame);
        window.removeEventListener('resize', resizeCanvas);
      };
    }

    // Initialize animations
    function initAnimations() {
      const cleanup = initStarfield();

      // Trigger hero animations
      setTimeout(() => {
        document.getElementById('hero-title').style.animation = 'fadeInUp 1s ease forwards';
        setTimeout(() => {
          document.getElementById('hero-subtitle').style.animation = 'fadeInUp 1s ease forwards';
          setTimeout(() => {
            document.getElementById('hero-links').style.animation = 'fadeInUp 1s ease forwards';
          }, 200);
        }, 200);
      }, 100);

      return cleanup;
    }

    document.addEventListener('DOMContentLoaded', initAnimations);
    document.addEventListener('astro:page-load', initAnimations);
  })();
</script> 