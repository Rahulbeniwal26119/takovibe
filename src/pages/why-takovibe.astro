            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6"
                    >
                        Who TakoVibe Is For
                    </h2>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
                >
                    {
                        [
                            "Engineers who want to go beyond surface-level learning",
                            "Developers interested in system internals and architecture",
                            "Professionals working on real-world production systems",
                            "Writers who want to share authentic engineering experiences",
                        ].map((target) => (
                            <div class="p-6 rounded-2xl bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 text-center hover:border-purple-500/50 transition-colors">
                                <p class="text-gray-700 dark:text-gray-300 font-medium">
                                    {target}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Write With Us Section -->
        <section class="py-24 relative overflow-hidden z-10">
            <div class="max-w-7xl mx-auto px-6">
                <div
                    class="bg-white dark:bg-[#131B2E] rounded-3xl p-12 border border-gray-200 dark:border-gray-700 shadow-xl overflow-hidden relative"
                >
                    <div class="absolute top-0 right-0 p-8 opacity-5">
                        <svg
                            class="w-64 h-64"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 2.029c-5.514 0-10 4.486-10 10s4.486 10 10 10 10-4.486 10-10-4.486-10-10-10zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8zM11 7h2v3h3v2h-3v3h-2v-3h-3v-2h3v-3z"
                            ></path>
                        </svg>
                    </div>

                    <div class="relative z-10 lg:flex items-center gap-16">
                        <div class="lg:w-2/3">
                            <h2
                                class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6"
                            >
                                Want to Write With Us?
                            </h2>
                            <p
                                class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed"
                            >
                                Takovibe welcomes engineers who want to share
                                genuine, experience-backed knowledge. We value
                                clear thinking, technical accuracy, and honest
