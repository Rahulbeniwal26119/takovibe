                                            {tag}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>
                        <div class="lg:w-1/3 text-center lg:text-right">
                            <a
                                href="/contact"
                                class="inline-block px-10 py-5 bg-purple-600 text-white font-bold rounded-2xl hover:bg-purple-700 transition-all shadow-lg hover:shadow-xl hover:-translate-y-1"
                            >
                                Join the Community
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

