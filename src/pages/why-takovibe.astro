---
import Layout from "../layouts/Layout.astro";

const principles = [
    {
        title: "Depth over noise",
        description:
            "We publish for engineers who want the reasoning, trade-offs, and failure modes behind real systems.",
    },
    {
        title: "Practice over theory",
        description:
            "Articles are shaped around implementation details, debugging stories, architecture decisions, and production constraints.",
    },
    {
        title: "Tools near the work",
        description:
            "Learning is better when you can run code, save notes, read with focus, and turn your work into proof.",
    },
];

const tools = [
    {
        label: "Sketch Notes",
        href: "/notes",
        description: "Keep visual notes close to the ideas you are learning.",
    },
    {
        label: "Reader",
        href: "/reader",
        description: "Upload EPUBs, read with focus, and continue from your saved position.",
    },
    {
        label: "Learning Tasks",
        href: "/tasks",
        description: "Plan learning goals, attach notes and books, and log focused hours.",
    },
    {
        label: "ResumeVibe",
        href: "https://resumevibe.takovibe.com/",
        description: "Audit, rewrite, and present your resume with more signal.",
    },
    {
        label: "Playground",
        href: "/playground",
        description: "Run and share snippets while reading.",
    },
];

const audience = [
    "Engineers moving beyond surface-level tutorials",
    "Builders who care about why a system behaves the way it does",
    "Writers with practical lessons from real projects",
];
---

<Layout
    title="Why TakoVibe? | Engineering Knowledge for Practitioners"
    description="Why TakoVibe exists and the gap we fill in modern technical content."
>
    <main class="min-h-screen bg-neutral-50 text-neutral-950 dark:bg-neutral-950 dark:text-neutral-50">
        <section class="relative overflow-hidden border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950">
            <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-[0.035] dark:opacity-[0.06]"></div>
            <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-32">
                <div class="max-w-3xl">
                    <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-sm font-bold text-orange-700 dark:border-orange-500/20 dark:bg-orange-500/10 dark:text-orange-300">
                        <span class="h-2 w-2 rounded-full bg-orange-500"></span>
                        Why TakoVibe
                    </div>

                    <h1 class="text-4xl font-black leading-tight tracking-tight text-neutral-950 md:text-6xl dark:text-white">
                        Engineering knowledge should feel useful after the tab closes.
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
                        TakoVibe exists for the space between quick tutorials and real engineering work. We focus on how systems behave, why choices are made, and what builders learn while shipping.
                    </p>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a
                            href="/blog"
                            class="inline-flex items-center justify-center rounded-lg bg-orange-500 px-5 py-3 text-sm font-black text-white shadow-lg shadow-orange-950/10 transition hover:bg-orange-600"
                        >
                            Read the blog
                        </a>
                        <a
                            href="#tools"
                            class="inline-flex items-center justify-center rounded-lg border border-neutral-200 bg-white px-5 py-3 text-sm font-bold text-neutral-800 transition hover:border-orange-300 hover:text-orange-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-orange-500/40 dark:hover:text-orange-300"
                        >
                            Explore tools
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="px-4 py-16 sm:px-6">
            <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-3">
                {principles.map((item) => (
                    <article class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900">
                        <div class="mb-4 h-1.5 w-10 rounded-full bg-orange-500"></div>
                        <h2 class="text-xl font-black text-neutral-950 dark:text-white">
                            {item.title}
                        </h2>
                        <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
                            {item.description}
                        </p>
                    </article>
                ))}
            </div>
        </section>

        <section class="border-y border-neutral-200 bg-white px-4 py-16 sm:px-6 dark:border-neutral-800 dark:bg-neutral-900/40">
            <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
                <div>
                    <p class="text-sm font-black uppercase tracking-[0.18em] text-orange-600 dark:text-orange-300">
                        The gap
                    </p>
                    <h2 class="mt-4 text-3xl font-black tracking-tight text-neutral-950 md:text-4xl dark:text-white">
                        Less content churn. More working context.
                    </h2>
                    <p class="mt-5 text-base leading-7 text-neutral-600 dark:text-neutral-300">
                        The goal is not to publish more noise. It is to make hard engineering ideas easier to revisit, test, explain, and apply.
                    </p>
                </div>

                <div class="grid gap-3">
                    {audience.map((item) => (
                        <div class="flex items-start gap-3 rounded-lg border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-950">
                            <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <p class="text-sm font-semibold leading-6 text-neutral-700 dark:text-neutral-300">
                                {item}
                            </p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section id="tools" class="px-4 py-16 sm:px-6">
            <div class="mx-auto max-w-7xl">
                <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                    <div>
                        <p class="text-sm font-black uppercase tracking-[0.18em] text-orange-600 dark:text-orange-300">
                            Ecosystem
                        </p>
                        <h2 class="mt-3 text-3xl font-black tracking-tight text-neutral-950 dark:text-white">
                            Built around how developers actually work.
                        </h2>
                    </div>
                    <a href="/playground" class="text-sm font-bold text-orange-600 hover:text-orange-700 dark:text-orange-300 dark:hover:text-orange-200">
                        Start with Playground
                    </a>
                </div>

                <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
                    {tools.map((tool) => (
                        <a
                            href={tool.href}
                            class="group rounded-lg border border-neutral-200 bg-white p-5 transition hover:border-orange-300 hover:shadow-lg hover:shadow-orange-950/5 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-orange-500/40"
                        >
                            <div class="flex items-center justify-between gap-3">
                                <h3 class="font-black text-neutral-950 dark:text-white">
                                    {tool.label}
                                </h3>
                                <svg class="h-4 w-4 text-neutral-400 transition group-hover:translate-x-0.5 group-hover:text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8M17 7v9"></path>
                                </svg>
                            </div>
                            <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
                                {tool.description}
                            </p>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <section class="px-4 pb-20 sm:px-6">
            <div class="mx-auto max-w-7xl rounded-lg border border-neutral-200 bg-neutral-950 p-8 text-white md:p-10 dark:border-neutral-800">
                <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
                    <div>
                        <h2 class="text-2xl font-black tracking-tight">
                            Write from the work, not around it.
                        </h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-300">
                            TakoVibe is open to practical engineering stories, architecture notes, debugging writeups, and lessons that help another builder move faster with more context.
                        </p>
                    </div>
                    <a
                        href="/contact"
                        class="inline-flex items-center justify-center rounded-lg bg-orange-500 px-5 py-3 text-sm font-black text-white transition hover:bg-orange-400"
                    >
                        Write with us
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>
