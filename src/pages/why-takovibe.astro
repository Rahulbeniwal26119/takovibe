---
import Layout from "../layouts/Layout.astro";
import ParticlesBackground from "../components/ParticlesBackground.astro";
---

<Layout
    title="Why Takovibe? | Engineering Knowledge for Practitioners"
    description="Why TakoVibe exists and the gap we fill in modern technical content."
>
    <div
        class="relative w-full overflow-x-hidden min-h-screen bg-gray-50 dark:bg-[#0B1120]"
    >
        <!-- Immersive Background -->
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div
                class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-purple-100 via-gray-50 to-white dark:from-[#1a103c] dark:via-[#0B1120] dark:to-[#0B1120]"
            >
            </div>
            <div
                class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-purple-400/20 dark:bg-purple-600/10 blur-[100px] animate-blob mix-blend-multiply dark:mix-blend-screen"
            >
            </div>
            <div
                class="absolute top-[20%] right-[-10%] w-[400px] h-[400px] rounded-full bg-blue-400/20 dark:bg-blue-600/10 blur-[100px] animate-blob animation-delay-2000 mix-blend-multiply dark:mix-blend-screen"
            >
            </div>
            <ParticlesBackground />
        </div>

        <!-- Hero Section -->
        <section class="relative z-10 pt-24 pb-16 lg:pt-32 lg:pb-24">
            <div class="max-w-7xl mx-auto px-6 text-center">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 dark:bg-white/5 backdrop-blur-md text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium mb-8 border border-purple-200/50 dark:border-white/10 shadow-sm animate-fade-in-up"
                >
                    <span class="text-base">🚀</span>
                    <span>Our Mission</span>
                </div>

                <h1
                    class="text-4xl md:text-6xl lg:text-7xl font-bold mb-8 animate-fade-in-up animation-delay-200 tracking-tight text-gray-900 dark:text-white"
                >
                    Why <span
                        class="bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 bg-clip-text text-transparent animate-gradient"
                        >Takovibe</span
                    >?
                </h1>

                <div class="max-w-3xl mx-auto space-y-6">
                    <h2
                        class="text-2xl md:text-3xl font-semibold text-gray-800 dark:text-gray-200 animate-fade-in-up animation-delay-400"
                    >
                        Why TakoVibe Exists
                    </h2>
                    <p
                        class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed animate-fade-in-up animation-delay-600"
                    >
                        Modern software engineering problems cannot be solved
                        with surface-level tutorials. Takovibe exists to share
                        real-world engineering knowledge, the kind that comes
                        from building, scaling, and maintaining production
                        systems.
                    </p>
                    <p
                        class="text-lg text-gray-600 dark:text-gray-400 animate-fade-in-up animation-delay-800"
                    >
                        We focus on explaining not just how things work, but <span
                            class="text-purple-600 dark:text-purple-400 font-semibold"
                            >why</span
                        > design decisions are made and what trade-offs engineers
                        face in practice.
                    </p>
                </div>
            </div>
        </section>

        <!-- The Problem Section -->
        <section
            class="py-24 relative z-10 border-y border-gray-200 dark:border-gray-800 bg-white/30 dark:bg-black/10 backdrop-blur-sm"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div>
                        <h2
                            class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6"
                        >
                            The Problem With Today’s <span class="text-red-500"
                                >Tech Content</span
                            >
                        </h2>
                        <p
                            class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed"
                        >
                            The internet is full of technical articles, yet
                            engineers still struggle when systems reach
                            real-world complexity.
                        </p>
                        <div class="space-y-4">
                            {
                                [
                                    "It stops at beginner-level explanations",
                                    "It focuses on tools instead of system behavior",
                                    "It prioritizes trends and speed over depth and accuracy",
                                ].map((issue) => (
                                    <div class="flex items-center gap-4 p-4 rounded-xl bg-red-50 dark:bg-red-900/10 border border-red-100 dark:border-red-900/20">
                                        <svg
                                            class="w-5 h-5 text-red-500 shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M6 18L18 6M6 6l12 12"
                                            />
                                        </svg>
                                        <span class="text-gray-700 dark:text-gray-300 font-medium">
                                            {issue}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                    <div class="relative">
                        <div
                            class="absolute -inset-4 bg-gradient-to-tr from-red-500/20 to-purple-500/20 rounded-[2rem] blur-2xl"
                        >
                        </div>
                        <div
                            class="relative bg-white dark:bg-[#131B2E] p-8 rounded-3xl border border-gray-100 dark:border-gray-800 shadow-xl"
                        >
                            <p
                                class="text-xl text-gray-600 dark:text-gray-300 italic text-center"
                            >
                                "As a result, engineers often lack guidance when
                                facing real production challenges."
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- The Gap Section -->
        <section class="py-24 relative z-10">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6"
                    >
                        The Gap We Fill
                    </h2>
                    <p
                        class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto"
                    >
                        There is a clear gap between basic tutorials and real
                        engineering practice in production environments.
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                    {
                        [
                            {
                                title: "Architectural Reasoning",
                                icon: "🏗️",
                                desc: "Understanding the 'why' behind the high-level design.",
                            },
                            {
                                title: "Performance Bottlenecks",
                                icon: "⚡",
                                desc: "Identifying and resolving real-world constraints.",
                            },
                            {
                                title: "Scalability Constraints",
                                icon: "📈",
                                desc: "How systems behave when load increases exponentially.",
                            },
                            {
                                title: "Long-term Decisions",
                                icon: "⏳",
                                desc: "Living with the consequences of engineering choices.",
                            },
                        ].map((item) => (
                            <div class="p-8 rounded-3xl bg-white dark:bg-[#131B2E] border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-md transition-all hover:-translate-y-1">
                                <div class="text-4xl mb-6">{item.icon}</div>
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Our Approach Section -->
        <section
            class="py-24 relative z-10 bg-purple-600/5 dark:bg-purple-900/10 border-y border-purple-200/50 dark:border-purple-800/20"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-col lg:flex-row gap-16 items-center">
                    <div class="lg:w-1/2">
                        <h2
                            class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6"
                        >
                            Our Approach at <span class="text-purple-600"
                                >TakoVibe</span
                            >
                        </h2>
                        <p
                            class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed"
                        >
                            At TakoVibe, content is treated like
                            engineering—with intent, structure, and
                            responsibility.
                        </p>
                        <div class="grid gap-6">
                            {
                                [
                                    {
                                        title: "Experience-Driven",
                                        desc: "Articles are based on real implementation, not theory.",
                                    },
                                    {
                                        title: "Depth Over Frequency",
                                        desc: "We value clarity and detail more than publishing often.",
                                    },
                                    {
                                        title: "Real-World Context",
                                        desc: "Engineering decisions are explained with reasoning and trade-offs.",
                                    },
                                ].map((item) => (
                                    <div class="flex gap-4">
                                        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold text-sm">
                                            ✓
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-gray-900 dark:text-white mb-1">
                                                {item.title}
                                            </h4>
                                            <p class="text-gray-600 dark:text-gray-400 text-sm">
                                                {item.desc}
                                            </p>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                    <div class="lg:w-1/2">
                        <div
                            class="p-8 md:p-12 rounded-[2.5rem] bg-gradient-to-br from-purple-600 to-blue-700 text-white shadow-2xl"
                        >
                            <h3 class="text-2xl font-bold mb-6">
                                Meaningful Engineering Knowledge
                            </h3>
                            <p
                                class="text-purple-50 text-lg leading-relaxed mb-8"
                            >
                                "We don’t aim to publish more content. We aim to
                                publish meaningful and lasting engineering
                                knowledge."
                            </p>
                            <div class="w-16 h-1 bg-white/30 rounded-full">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

