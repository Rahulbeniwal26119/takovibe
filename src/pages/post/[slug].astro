---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { TiptapRenderer } from "../../components/TiptapRenderer";
import Footer from "../../components/Footer.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import TableOfContents from "../../components/TableOfContents.astro";

const { slug } = Astro.params;

// Fetch post from API
let post;
try {
    const response = await fetch(
        `${import.meta.env.PUBLIC_API_URL}/api/posts/${slug}/`,
    );
    if (!response.ok) {
        return Astro.redirect("/404");
    }
    post = await response.json();
} catch (error) {
    console.error("Failed to fetch post:", error);
    return Astro.redirect("/404"); // Or show an error page
}

const { frontmatter, content } = post;

// Extract headings from JSON content for TOC
const headings = [];
if (content && content.content) {
    content.content.forEach((node: any) => {
        if (node.type === "heading") {
            // Safe access to text content
            const text =
                node.content && node.content[0] ? node.content[0].text : "";
            if (text) {
                headings.push({
                    depth: node.attrs.level,
                    slug: text
                        .toLowerCase()
                        .replace(/\s+/g, "-")
                        .replace(/[^\w-]/g, ""),
                    text: text,
                });
            }
        }
    });
}
---

<Layout
    title={frontmatter.title}
    description={frontmatter.description}
    type="article"
    author={frontmatter.author}
    tags={frontmatter.tags
        ? frontmatter.tags.split(",").map((t: string) => t.trim())
        : []}
    published_date={frontmatter.date}
    image={frontmatter.image}
    no_footer={true}
>
    <!-- Reading Progress Bar -->
    <div
        class="fixed top-0 left-0 w-full h-1 z-50 bg-gray-100 dark:bg-gray-800"
    >
        <div
            id="reading-progress"
            class="h-full bg-gray-900 dark:bg-white w-0 transition-all duration-150 ease-out"
        >
        </div>
    </div>

    <!-- Main Wrapper -->
    <div
        class="min-h-screen bg-white dark:bg-slate-950 text-gray-900 dark:text-gray-100 font-sans selection:bg-green-100 selection:text-green-900 dark:selection:bg-green-900/30 dark:selection:text-green-100"
    >
        <main class="relative pt-12 pb-24">
            <!-- Grid Layout for Desktop -->
            <div
                class="max-w-[1600px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-[1fr_1000px_1fr] gap-12"
            >
                <!-- Left Sidebar (Actions) -->
                <aside class="hidden lg:flex flex-col items-end pt-2">
                    <div class="sticky top-32 flex flex-col gap-6 pr-4">
                        <!-- Author Avatar (Mini) -->
                        <div
                            class="w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-base font-bold mb-4 shadow-sm"
                        >
                            {frontmatter.author.charAt(0)}
                        </div>

                        <div
                            class="w-px h-12 bg-gray-200 dark:bg-gray-800 mx-auto mb-2"
                        >
                        </div>

                        <!-- Like/Clap -->
                        <button
                            class="group flex flex-col items-center gap-1 text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                        >
                            <div
                                class="p-3 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                            >
                                <svg
                                    class="w-7 h-7"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"
                                    ></path></svg
                                >
                            </div>
                            <span
                                class="text-xs font-medium opacity-0 group-hover:opacity-100 transition-opacity"
                                >124</span
                            >
                        </button>

                        <!-- Save -->
                        <button
                            id="sidebar-save-post"
                            class="group relative flex flex-col items-center gap-1 text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                            aria-label="Save"
                        >
                            <div
                                class="p-3 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                            >
                                <svg
                                    class="w-7 h-7"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                                    ></path></svg
                                >
                            </div>
                            <span
                                class="absolute left-full ml-3 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none top-3"
                                >Save</span
                            >
                        </button>

                        <!-- Share -->
                        <button
                            class="group relative flex flex-col items-center gap-1 text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                            aria-label="Share"
                        >
                            <div
                                class="p-3 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                            >
                                <svg
                                    class="w-7 h-7"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
                                    ></path></svg
                                >
                            </div>
                        </button>
                    </div>
                </aside>

                <!-- Center Column (Content) -->
                <article class="w-full max-w-[1000px] mx-auto">
                    <!-- Article Header -->
                    <header class="mb-16">
                        <!-- Series Tag -->
                        {
                            frontmatter.series && (
                                <div class="mb-8">
                                    <a
                                        href={`/series/${frontmatter.series.toLowerCase().replace(/\s+/g, "-")}`}
                                        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                                    >
                                        <span class="w-2 h-2 rounded-full bg-green-500" />
                                        {frontmatter.series} Series
                                    </a>
                                </div>
                            )
                        }

                        <!-- Title -->
                        <h1
                            class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-gray-900 dark:text-white tracking-tight leading-[1.1] mb-10 font-sans"
                        >
                            {frontmatter.title}
                        </h1>

                        <!-- Meta Row -->
                        <div
                            class="flex items-center justify-between py-8 border-b border-gray-100 dark:border-gray-800"
                        >
                            <div class="flex items-center gap-5">
                                <div
                                    class="w-14 h-14 rounded-full bg-gray-200 dark:bg-gray-800 flex items-center justify-center overflow-hidden shadow-sm"
                                >
                                    <!-- Placeholder Avatar -->
                                    <span
                                        class="text-2xl font-bold text-gray-500"
                                        >{frontmatter.author.charAt(0)}</span
                                    >
                                </div>
                                <div>
                                    <div
                                        class="font-bold text-gray-900 dark:text-white text-lg"
                                    >
                                        {frontmatter.author}
                                    </div>
                                    <div
                                        class="flex items-center gap-3 text-base text-gray-500 dark:text-gray-400"
                                    >
                                        <span
                                            >{
                                                frontmatter.readingTime ||
                                                    "5 min read"
                                            }</span
                                        >
                                        <span>·</span>
                                        <span
                                            >{
                                                new Date(
                                                    frontmatter.date,
                                                ).toLocaleDateString("en-US", {
                                                    month: "short",
                                                    day: "numeric",
                                                })
                                            }</span
                                        >
                                    </div>
                                </div>
                            </div>

                            <button
                                class="hidden sm:flex items-center gap-2 px-6 py-3 rounded-full bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 text-base font-medium hover:bg-green-100 dark:hover:bg-green-900/30 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path d="M8 5v14l11-7z"></path></svg
                                >
                                Listen
                            </button>
                        </div>
                    </header>

                    <!-- Article Content -->
                    <div
                        class="prose prose-xl dark:prose-invert max-w-none
                        prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-gray-900 dark:prose-headings:text-white
                        prose-p:font-serif prose-p:text-[1.35rem] prose-p:leading-[2] prose-p:text-gray-800 dark:prose-p:text-gray-300
                        prose-a:text-gray-900 dark:prose-a:text-white prose-a:underline prose-a:decoration-gray-300 dark:prose-a:decoration-gray-600 prose-a:underline-offset-4 hover:prose-a:decoration-green-500 hover:prose-a:text-green-600 transition-colors
                        prose-img:rounded-xl prose-img:shadow-md prose-img:my-12
                        prose-code:font-mono prose-code:text-base prose-code:text-purple-600 dark:prose-code:text-purple-400 prose-code:bg-gray-50 dark:prose-code:bg-gray-800/50 prose-code:px-2 prose-code:py-1 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
                        prose-pre:bg-[#1e1e1e] prose-pre:text-gray-100 prose-pre:rounded-2xl prose-pre:shadow-xl prose-pre:border prose-pre:border-gray-800 prose-pre:p-6
                        prose-blockquote:border-l-4 prose-blockquote:border-gray-900 dark:prose-blockquote:border-white prose-blockquote:pl-8 prose-blockquote:italic prose-blockquote:font-serif prose-blockquote:text-2xl prose-blockquote:text-gray-900 dark:prose-blockquote:text-white
                        prose-li:font-serif prose-li:text-[1.25rem] prose-li:text-gray-800 dark:prose-li:text-gray-300"
                    >
                        <TiptapRenderer content={content} client:only="react" />
                    </div>

                    <!-- Tags -->
                    <div
                        class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800"
                    >
                        <div class="flex flex-wrap gap-3">
                            {
                                frontmatter.tags &&
                                    frontmatter.tags
                                        .split(",")
                                        .map((tag: string) => (
                                            <a
                                                href={`/blog?tag=${encodeURIComponent(tag.trim().toLowerCase())}`}
                                                class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-sm rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                                            >
                                                {tag.trim()}
                                            </a>
                                        ))
                            }
                        </div>
                    </div>

                    <!-- Author Bio Card -->
                    <div
                        class="mt-16 p-8 bg-gray-50 dark:bg-gray-900 rounded-2xl flex items-start gap-6"
                    >
                        <div
                            class="w-16 h-16 rounded-full bg-white dark:bg-gray-800 flex-shrink-0 flex items-center justify-center shadow-sm text-2xl font-bold"
                        >
                            {frontmatter.author.charAt(0)}
                        </div>
                        <div>
                            <h3
                                class="text-lg font-bold text-gray-900 dark:text-white mb-2"
                            >
                                Written by {frontmatter.author}
                            </h3>
                            <p
                                class="text-gray-600 dark:text-gray-400 leading-relaxed"
                            >
                                Security researcher and full-stack developer.
                                Passionate about making the web a safer place.
                            </p>
                            <button
                                class="mt-4 text-sm font-medium text-green-600 dark:text-green-400 hover:underline"
                                >View Profile</button
                            >
                        </div>
                    </div>

                    <!-- Series Navigation (Next/Prev) -->
                    {
                        frontmatter.series && (
                            <div class="mt-12">
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-xs font-bold uppercase tracking-wider text-gray-500">
                                        More in this series
                                    </span>
                                    <a
                                        href={`/series/${frontmatter.series.toLowerCase().replace(/\s+/g, "-")}`}
                                        class="text-sm font-medium text-gray-900 dark:text-white hover:underline"
                                    >
                                        View All
                                    </a>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <a
                                        href="#"
                                        class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700 transition-colors group"
                                    >
                                        <span class="text-xs text-gray-500 mb-2 block">
                                            Part {frontmatter.seriesOrder + 1}
                                        </span>
                                        <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
                                            Advanced SQL Injection Techniques
                                        </h4>
                                    </a>
                                    <a
                                        href="#"
                                        class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700 transition-colors group"
                                    >
                                        <span class="text-xs text-gray-500 mb-2 block">
                                            Part {frontmatter.seriesOrder + 2}
                                        </span>
                                        <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
                                            Securing Your API Endpoints
                                        </h4>
                                    </a>
                                </div>
                            </div>
                        )
                    }
                </article>

                <!-- Right Sidebar (TOC) -->
                <aside class="hidden lg:block pl-8">
                    <div class="sticky top-32">
                        <h4
                            class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-4"
                        >
                            Contents
                        </h4>
                        <TableOfContents headings={headings} />
                    </div>
                </aside>
            </div>

            <!-- Related Posts Grid -->
            <div
                class="max-w-[1200px] mx-auto px-4 mt-24 pt-12 border-t border-gray-100 dark:border-gray-800"
            >
                <h3
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-8"
                >
                    Recommended for you
                </h3>
                <RelatedPosts
                    currentSlug={slug}
                    tags={frontmatter.tags
                        ? frontmatter.tags.split(",").map((t) => t.trim())
                        : []}
                />
            </div>

            <!-- Mobile Bottom Bar -->
            <div
                class="lg:hidden fixed bottom-0 left-0 w-full bg-white/90 dark:bg-slate-950/90 backdrop-blur-lg border-t border-gray-200 dark:border-gray-800 px-6 py-3 flex items-center justify-between z-50"
            >
                <div class="flex items-center gap-6">
                    <button
                        class="flex flex-col items-center gap-1 text-gray-500 dark:text-gray-400"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"
                            ></path></svg
                        >
                        <span class="text-[10px]">124</span>
                    </button>
                    <button
                        class="flex flex-col items-center gap-1 text-gray-500 dark:text-gray-400"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                            ></path></svg
                        >
                        <span class="text-[10px]">24</span>
                    </button>
                </div>
                <div class="flex items-center gap-4">
                    <button class="p-2 text-gray-500 dark:text-gray-400">
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                            ></path></svg
                        >
                    </button>
                    <button class="p-2 text-gray-500 dark:text-gray-400">
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
                            ></path></svg
                        >
                    </button>
                </div>
            </div>
        </main>

        <Footer />
    </div>
</Layout>

<script>
    // Reading Progress Bar
    const progressBar = document.getElementById("reading-progress");
    window.addEventListener("scroll", () => {
        const scrollTop =
            document.documentElement.scrollTop || document.body.scrollTop;
        const scrollHeight =
            document.documentElement.scrollHeight || document.body.scrollHeight;
        const clientHeight =
            document.documentElement.clientHeight || document.body.clientHeight;
        const scrolled = (scrollTop / (scrollHeight - clientHeight)) * 100;
        if (progressBar) {
            progressBar.style.width = scrolled + "%";
        }
    });

    // Smart Header (Hide on scroll down, show on scroll up)
    let lastScroll = 0;
    const header = document.getElementById("main-header");

    window.addEventListener("scroll", () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll <= 0) {
            header.classList.remove("-translate-y-full");
            return;
        }

        if (
            currentScroll > lastScroll &&
            !header.classList.contains("-translate-y-full")
        ) {
            // Scroll Down
            header.classList.add("-translate-y-full");
        } else if (
            currentScroll < lastScroll &&
            header.classList.contains("-translate-y-full")
        ) {
            // Scroll Up
            header.classList.remove("-translate-y-full");
        }
        lastScroll = currentScroll;
    });

    // Save Button Logic
    const saveBtns = document.querySelectorAll("#sidebar-save-post");
    saveBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            const svg = btn.querySelector("svg");
            const span = btn.querySelector("span");
            const isSaved = svg.getAttribute("fill") === "currentColor";

            if (isSaved) {
                svg.setAttribute("fill", "none");
                btn.classList.remove("text-green-600", "dark:text-green-400");
                btn.classList.add("text-gray-400");
                if (span) span.textContent = "Save";
            } else {
                svg.setAttribute("fill", "currentColor");
                btn.classList.remove("text-gray-400");
                btn.classList.add("text-green-600", "dark:text-green-400");
                if (span) span.textContent = "Saved";
            }
        });
    });

    // Copy Code Buttons
    document.addEventListener("DOMContentLoaded", () => {
        const codeBlocks = document.querySelectorAll("pre");
        codeBlocks.forEach((pre) => {
            if (pre.querySelector(".copy-btn")) return;

            const wrapper = document.createElement("div");
            wrapper.className = "relative group";
            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            const btn = document.createElement("button");
            btn.className =
                "absolute top-3 right-3 p-1.5 rounded-md bg-white/10 text-white opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white/20";
            btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`;

            btn.addEventListener("click", async () => {
                const code = pre.querySelector("code");
                await navigator.clipboard.writeText(code.innerText);
                btn.innerHTML = `<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
                setTimeout(() => {
                    btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`;
                }, 2000);
            });

            wrapper.appendChild(btn);
        });
    });
</script>
