---
import Layout from "../../layouts/Layout.astro";
import { BlogEditor } from "../../components/editor/BlogEditor";
import PomodoroTimer from "../../components/PomodoroTimer.astro";
---

<Layout
    title="Write a Story - TakoVibe"
    description="Share your knowledge with the community."
    no_footer={true}
>
    <!-- Auth Check & Client-Side Logic -->
    <div
        id="editor-container"
        class="min-h-screen bg-gray-50 dark:bg-slate-950 pt-20 pb-12"
    >
        <div class="max-w-[1200px] mx-auto px-4">
            <!-- Loading State -->
            <div
                id="auth-loading"
                class="flex flex-col justify-center items-center w-full min-h-[50vh] animate-in fade-in duration-500"
            >
                <div class="relative flex flex-col items-center gap-8">
                    <div class="relative w-16 h-16">
                        <div
                            class="absolute inset-0 rounded-full border-[3px] border-purple-100 dark:border-purple-900/30"
                        >
                        </div>
                        <div
                            class="absolute inset-0 rounded-full border-[3px] border-transparent border-t-purple-600 border-l-purple-600 animate-spin-slow shadow-[0_0_15px_rgba(147,51,234,0.3)]"
                        >
                        </div>
                        <div
                            class="absolute inset-4 bg-gradient-to-tr from-blue-500 to-purple-600 rounded-full animate-pulse-slow shadow-lg"
                        >
                        </div>
                        <div
                            class="absolute -inset-4 bg-purple-500/10 rounded-full blur-xl animate-pulse"
                        >
                        </div>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                        <h3
                            class="text-lg font-semibold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 tracking-tight"
                        >
                            Initializing Editor...
                        </h3>
                        <div
                            class="h-1 w-24 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden"
                        >
                            <div
                                class="h-full bg-gradient-to-r from-purple-500 to-blue-500 w-1/2 animate-progress-indeterminate rounded-full"
                            >
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Editor Wrapper (Hidden initially) -->
            <div
                id="editor-wrapper"
                class="hidden animate-in fade-in duration-500"
            >
                <BlogEditor client:only="react" />
            </div>
        </div>
    </div>
</Layout>

<script>
    const checkAuth = () => {
        const token = localStorage.getItem("access_token");
        if (!token) {
            // Redirect to login with return URL
            const returnUrl = encodeURIComponent(window.location.pathname);
            window.location.href = `/login?redirect=${returnUrl}`;
            return;
        }

        // Show editor if authenticated
        const loading = document.getElementById("auth-loading");
        const wrapper = document.getElementById("editor-wrapper");

        if (loading) loading.style.display = "none";
        if (wrapper) wrapper.classList.remove("hidden");
    };

    // Run immediately
    checkAuth();
</script>
