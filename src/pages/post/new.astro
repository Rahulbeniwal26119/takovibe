---
import Layout from "../../layouts/Layout.astro";
import { BlogEditor } from "../../components/editor/BlogEditor";
---

<Layout
    title="Write a Story - TakoVibe"
    description="Share your knowledge with the community."
    no_footer={true}
    no_header={true}
>
    <!-- Auth Check & Client-Side Logic -->
    <div
        id="editor-container"
        class="min-h-screen w-full bg-stone-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-50"
    >
        <!-- Loading State -->
        <div
            id="auth-loading"
            class="relative flex min-h-screen w-full items-center justify-center overflow-hidden px-6"
        >
            <div
                class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"
            >
            </div>

            <div class="relative flex flex-col items-center gap-6 text-center">
                <div
                    class="relative flex h-16 w-16 items-center justify-center rounded-xl border border-orange-500/20 bg-white shadow-sm dark:bg-neutral-900"
                >
                    <div class="absolute left-4 right-4 top-5 space-y-2">
                        <div class="h-2 w-8 animate-pulse rounded-full bg-orange-500">
                        </div>
                        <div
                            class="h-2 w-10 animate-pulse rounded-full bg-neutral-300 [animation-delay:120ms] dark:bg-neutral-700"
                        >
                        </div>
                        <div
                            class="h-2 w-6 animate-pulse rounded-full bg-neutral-300 [animation-delay:240ms] dark:bg-neutral-700"
                        >
                        </div>
                    </div>
                </div>
                <div class="flex flex-col items-center gap-3">
                    <h3 class="font-display text-xl font-bold tracking-tight">
                        Preparing your writing space
                    </h3>
                    <div class="h-1 w-28 overflow-hidden rounded-full bg-neutral-200 dark:bg-neutral-800">
                        <div
                            class="h-full w-1/2 animate-progress-indeterminate rounded-full bg-orange-500"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Editor Wrapper (Hidden initially) -->
        <div id="editor-wrapper" class="hidden animate-in fade-in duration-500">
            <BlogEditor client:only="react" />
        </div>
    </div>

    <script>
        const checkAuth = () => {
            const token = localStorage.getItem("access_token");
            if (!token) {
                // Redirect to login with return URL
                const returnUrl = encodeURIComponent(window.location.pathname);
                window.location.href = `/login?redirect=${returnUrl}`;
                return;
            }

            // Show editor if authenticated
            const loading = document.getElementById("auth-loading");
            const wrapper = document.getElementById("editor-wrapper");

            if (loading) loading.style.display = "none";
            if (wrapper) wrapper.classList.remove("hidden");
        };

        // Run immediately
        checkAuth();
    </script>
</Layout>
