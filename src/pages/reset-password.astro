---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Reset Password - TakoVibe"
    description="Set a new password"
    no_footer={true}
    no_header={true}
>
    <div
        class="min-h-screen flex items-center justify-center bg-white dark:bg-[#171923] relative overflow-hidden"
    >
        <div
            class="absolute inset-0 pointer-events-none opacity-30 dark:opacity-20"
        >
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(159,122,234,0.15),transparent_70%)]"
            >
            </div>
        </div>

        <div class="relative z-10 text-center p-8 max-w-md w-full">
            <!-- Loading State -->
            <div id="loading-state">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 mb-6"
                >
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-purple-600 to-blue-600 rounded-full blur-xl opacity-50 animate-pulse"
                        >
                        </div>
                        <div
                            class="relative w-16 h-16 bg-gradient-to-r from-purple-600 to-blue-600 rounded-full flex items-center justify-center animate-spin"
                            style="animation-duration: 3s;"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                ></path>
                            </svg>
                        </div>
                    </div>
                </div>
                <h2
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                >
                    Verifying Link...
                </h2>
                <p class="text-gray-600 dark:text-gray-400">
                    Please wait while we validate your reset link.
                </p>
            </div>

            <!-- Reset Form -->
            <div id="reset-form-container" class="hidden text-left">
                <div class="text-center mb-8">
                    <a href="/" class="inline-block mb-4 group">
                        <div class="relative">
                            <div
                                class="absolute inset-0 bg-purple-500/20 rounded-full blur-md group-hover:bg-purple-500/30 transition-colors"
                            >
                            </div>
                            <img
                                src="/images/logo.svg"
                                alt="TakoVibe"
                                class="relative w-12 h-12 rounded-full shadow-sm transform group-hover:scale-105 transition-transform duration-300"
                            />
                        </div>
                    </a>
                    <h2
                        class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                    >
                        Reset Password
                    </h2>
                    <p class="text-gray-600 dark:text-gray-400">
                        Enter your new password below.
                    </p>
                </div>

                <form id="reset-password-form" class="space-y-6">
                    <div>
                        <label
                            for="password"
                            class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                        >
                            New Password
                        </label>
                        <input
                            id="password"
                            name="password"
                            type="password"
                            autocomplete="new-password"
                            required
                            minlength="8"
                            class="appearance-none block w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-800 dark:text-white transition-all duration-200"
                            placeholder="••••••••"
                        />
                    </div>

                    <div>
                        <label
                            for="confirm-password"
                            class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                        >
                            Confirm Password
                        </label>
                        <input
                            id="confirm-password"
                            name="confirm_password"
                            type="password"
                            autocomplete="new-password"
                            required
                            minlength="8"
                            class="appearance-none block w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-800 dark:text-white transition-all duration-200"
                            placeholder="••••••••"
                        />
                    </div>

                    <div
                        id="form-error"
                        class="hidden rounded-xl bg-red-50 dark:bg-red-900/20 p-4 border border-red-100 dark:border-red-800"
                    >
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg
                                    class="h-5 w-5 text-red-400"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                        clip-rule="evenodd"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p
                                    class="text-sm font-medium text-red-800 dark:text-red-200"
                                    id="form-error-message"
                                >
                                    Passwords do not match
                                </p>
                            </div>
                        </div>
                    </div>

                    <button
                        type="submit"
                        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200 transform hover:scale-[1.02]"
                    >
                        Reset Password
                    </button>
                </form>
            </div>

            <!-- Success State -->
            <div id="success-state" class="hidden">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 mb-6"
                >
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-green-500 rounded-full blur-xl opacity-50"
                        >
                        </div>
                        <div
                            class="relative w-16 h-16 bg-green-500 rounded-full flex items-center justify-center"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
                <h2
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                >
                    Password Reset Successful
                </h2>
                <p class="text-gray-600 dark:text-gray-400 mb-6">
                    Your password has been updated. Redirecting to login...
                </p>
                <a
                    href="/login"
                    class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white rounded-xl font-medium transition-colors w-full"
                >
                    Sign In Now
                </a>
            </div>

            <!-- Error State -->
            <div id="error-state" class="hidden">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 mb-6"
                >
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-red-500 rounded-full blur-xl opacity-50"
                        >
                        </div>
                        <div
                            class="relative w-16 h-16 bg-red-500 rounded-full flex items-center justify-center"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </div>
                    </div>
                </div>
                <h2
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                >
                    Invalid or Expired Link
                </h2>
                <p
                    id="global-error-message"
                    class="text-gray-600 dark:text-gray-400 mb-6"
                >
                    The password reset link is invalid or has expired. Please
                    request a new one.
                </p>
                <a
                    href="/forgot-password"
                    class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white rounded-xl font-medium transition-colors w-full"
                >
                    Request New Link
                </a>
            </div>
        </div>
    </div>
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

    let intermediateToken = "";

    async function initPage() {
        const params = new URLSearchParams(window.location.search);
        const uid = params.get("uid");
        const token = params.get("token");

        const loadingState = document.getElementById("loading-state");
        const formContainer = document.getElementById("reset-form-container");
        const successState = document.getElementById("success-state");
        const errorState = document.getElementById("error-state");
        const globalErrorMessage = document.getElementById(
            "global-error-message",
        );
        const form = document.getElementById(
            "reset-password-form",
        ) as HTMLFormElement;
        const formErrorDiv = document.getElementById("form-error");
        const formErrorMessage = document.getElementById("form-error-message");

        if (!uid || !token) {
            loadingState?.classList.add("hidden");
            errorState?.classList.remove("hidden");
            return;
        }

        // Validate Token
        try {
            const response = await fetch(
                `${API_URL}/api/users/validate-reset-token/`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ uid, token }),
                },
            );

            const data = await response.json();

            if (response.ok && data.code === 0) {
                intermediateToken = data.data.intermediate_token;
                loadingState?.classList.add("hidden");
                formContainer?.classList.remove("hidden");
            } else {
                throw new Error(data.message || "Invalid token");
            }
        } catch (error) {
            console.error("Validation error:", error);
            loadingState?.classList.add("hidden");
            errorState?.classList.remove("hidden");
            if (globalErrorMessage && error instanceof Error) {
                globalErrorMessage.textContent = error.message;
            }
        }

        // Handle Reset Submit
        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            formErrorDiv?.classList.add("hidden");

            const formData = new FormData(form);
            const password = formData.get("password") as string;
            const confirmPassword = formData.get("confirm_password") as string;

            if (password !== confirmPassword) {
                if (formErrorDiv) formErrorDiv.classList.remove("hidden");
                if (formErrorMessage)
                    formErrorMessage.textContent = "Passwords do not match";
                return;
            }

            const submitBtn = form.querySelector("button[type='submit']");
            if (submitBtn) {
                const originalText = submitBtn.textContent;
                submitBtn.textContent = "Resetting...";
                (submitBtn as HTMLButtonElement).disabled = true;

                try {
                    const response = await fetch(
                        `${API_URL}/api/users/reset-password/`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify({
                                intermediate_token: intermediateToken,
                                password: password,
                            }),
                        },
                    );

                    const data = await response.json();

                    if (response.ok && data.code === 0) {
                        formContainer?.classList.add("hidden");
                        successState?.classList.remove("hidden");

                        // Redirect after 3 seconds
                        setTimeout(() => {
                            window.location.href = "/login";
                        }, 3000);
                    } else {
                        if (formErrorDiv)
                            formErrorDiv.classList.remove("hidden");

                        let msg = data.message || "Failed to reset password";
                        if (response.status === 429) {
                            msg = "Too many requests. Please try again later.";
                        }

                        if (formErrorMessage)
                            formErrorMessage.textContent = msg;
                    }
                } catch (error) {
                    console.error("Reset error:", error);
                    if (formErrorDiv) formErrorDiv.classList.remove("hidden");
                    if (formErrorMessage)
                        formErrorMessage.textContent =
                            "An unexpected error occurred. Please try again.";
                } finally {
                    submitBtn.textContent = originalText;
                    (submitBtn as HTMLButtonElement).disabled = false;
                }
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initPage);
</script>
