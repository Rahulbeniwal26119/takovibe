---
import Layout from "../../layouts/Layout.astro";
import { ContactManager } from "../../components/admin/ContactManager";
---

<Layout
    title="Admin Console - Contact Requests"
    description="Manage and resolve user contact requests."
    noAds={true}
>
    <div class="relative min-h-screen bg-gray-50 dark:bg-[#0B1120]">
        {/* Immersive Background matching the site theme */}
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div
                class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-100 via-gray-50 to-white dark:from-[#1a1c2e] dark:via-[#0B1120] dark:to-[#0B1120]"
            >
            </div>
            <div
                class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-blue-400/20 dark:bg-blue-600/10 blur-[100px] animate-blob mix-blend-multiply dark:mix-blend-screen"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[20%] w-[600px] h-[600px] rounded-full bg-purple-400/20 dark:bg-purple-600/10 blur-[100px] animate-blob animation-delay-4000 mix-blend-multiply dark:mix-blend-screen"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-20 dark:opacity-10"
            >
            </div>
        </div>

        <div
            class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 py-12 lg:py-20"
        >
            {/* Header */}
            <div
                class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4"
            >
                <div>
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-xs font-bold uppercase tracking-wider mb-2 border border-blue-200 dark:border-blue-800"
                    >
                        Admin Console
                    </div>
                    <h1
                        class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white"
                    >
                        Contact Management
                    </h1>
                </div>

                <div class="flex items-center gap-3">
                    <a
                        href="/dashboard"
                        class="text-sm font-medium text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors"
                    >
                        Dashboard
                    </a>
                    <span class="text-gray-300 dark:text-gray-700">/</span>
                    <span
                        class="text-sm font-medium text-gray-900 dark:text-white"
                    >
                        Contacts
                    </span>
                </div>
            </div>

            {/* Main Content Card */}
            <div
                class="bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-white/60 dark:border-gray-800 rounded-3xl p-6 md:p-8 shadow-xl"
            >
                <ContactManager client:only="react" />
            </div>
        </div>
    </div>
</Layout>

<style>
    .animate-blob {
        animation: blob 7s infinite;
    }
    .animation-delay-4000 {
        animation-delay: 4s;
    }
    @keyframes blob {
        0% {
            transform: translate(0px, 0px) scale(1);
        }
        33% {
            transform: translate(30px, -50px) scale(1.1);
        }
        66% {
            transform: translate(-20px, 20px) scale(0.9);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }
</style>
