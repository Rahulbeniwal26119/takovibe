<script>
    // Remove tabindex from elements after the page loads
    document.addEventListener("DOMContentLoaded", () => {
        const elements = document.querySelectorAll('[tabindex="-1"]');
        elements.forEach((element) => {
            element.removeAttribute("tabindex");
        });
    });

    // Add copy buttons to code blocks
    function addCopyButtons() {
        const codeBlocks = document.querySelectorAll("pre");

        codeBlocks.forEach((pre) => {
            // Skip if button already exists
            if (pre.querySelector(".copy-code-btn")) return;

            // Create wrapper if needed
            if (!pre.parentElement.classList.contains("code-block-wrapper")) {
                const wrapper = document.createElement("div");
                wrapper.className = "code-block-wrapper relative group";
                pre.parentNode.insertBefore(wrapper, pre);
                wrapper.appendChild(pre);
            }

            // Create copy button
            const button = document.createElement("button");
            button.className =
                "copy-code-btn absolute top-2 right-2 p-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-200 flex items-center gap-2 text-sm font-medium";
            button.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <span>Copy</span>
      `;

            button.addEventListener("click", async () => {
                const code = pre.querySelector("code");
                const text = code ? code.textContent : pre.textContent;

                try {
                    await navigator.clipboard.writeText(text);

                    // Visual feedback
                    button.innerHTML = `
            <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-green-400">Copied!</span>
          `;
                    button.classList.add("bg-green-600", "hover:bg-green-500");
                    button.classList.remove("bg-gray-700", "hover:bg-gray-600");

                    // Reset after 2 seconds
                    setTimeout(() => {
                        button.innerHTML = `
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <span>Copy</span>
            `;
                        button.classList.remove(
                            "bg-green-600",
                            "hover:bg-green-500",
                        );
                        button.classList.add(
                            "bg-gray-700",
                            "hover:bg-gray-600",
                        );
                    }, 2000);
                } catch (err) {
                    console.error("Failed to copy code:", err);
                }
            });

            pre.parentElement.appendChild(button);
        });
    }

    // Initialize on page load
    document.addEventListener("DOMContentLoaded", addCopyButtons);
    // Re-initialize after view transitions
    // Re-initialize after view transitions
    document.addEventListener("astro:after-swap", addCopyButtons);

    // Save Button Logic
    import {
        saveBookmark,
        removeBookmark,
        checkBookmarkStatus,
    } from "../../utils/bookmarks";
    import { showToast } from "../../utils/toast";

    function setupSaveButtons() {
        const saveBtns = document.querySelectorAll(".save-btn");

        saveBtns.forEach(async (btn) => {
            if (btn.hasAttribute("data-bound")) return;
            btn.setAttribute("data-bound", "true");

            const blogId = btn.getAttribute("data-blog-id");
            if (!blogId) return;

            // Check initial status
            const { isBookmarked, bookmarkId } =
                await checkBookmarkStatus(blogId);
            updateSaveButtonState(btn, isBookmarked);
            if (bookmarkId)
                btn.setAttribute("data-bookmark-id", bookmarkId.toString());

            btn.addEventListener("click", async (e) => {
                e.preventDefault();
                e.stopPropagation();

                const token = localStorage.getItem("access_token");
                if (!token) {
                    showToast(
                        "Please login to save articles for later.",
                        "info",
                    );
                    return;
                }

                const currentIsBookmarked =
                    btn.classList.contains("bg-purple-600");
                const currentBookmarkId = btn.getAttribute("data-bookmark-id");

                // Optimistic UI update
                updateSaveButtonState(btn, !currentIsBookmarked);

                let success = false;
                if (currentIsBookmarked && currentBookmarkId) {
                    success = await removeBookmark(parseInt(currentBookmarkId));
                    if (success) {
                        btn.removeAttribute("data-bookmark-id");
                        showToast("Article removed from saved list", "success");
                    }
                } else {
                    success = await saveBookmark(blogId);
                    if (success)
                        showToast("Article saved for later", "success");
                }

                if (!success) {
                    // Revert UI if failed
                    updateSaveButtonState(btn, currentIsBookmarked);
                    showToast(
                        "Failed to update bookmark. Please try again.",
                        "error",
                    );
                } else {
                    // Re-fetch to get ID
                    const { isBookmarked: newStatus, bookmarkId: newId } =
                        await checkBookmarkStatus(blogId);
                    if (newId)
                        btn.setAttribute("data-bookmark-id", newId.toString());
                }
            });
        });
    }

    function updateSaveButtonState(btn: Element, isSaved: boolean) {
        const icon = btn.querySelector("svg");
        const text = btn.querySelector("span");

        if (isSaved) {
            btn.classList.add("bg-purple-600", "border-purple-500");
            btn.classList.remove("bg-white/20", "border-white/30");
            if (icon) icon.setAttribute("fill", "currentColor");
            if (text) text.textContent = "Saved";
        } else {
            btn.classList.remove("bg-purple-600", "border-purple-500");
            btn.classList.add("bg-white/20", "border-white/30");
            if (icon) icon.setAttribute("fill", "none");
            if (text) text.textContent = "Save";
        }
    }

    // Initialize
    setupSaveButtons();
    document.addEventListener("astro:after-swap", setupSaveButtons);

    // Edit Button Logic
    function setupEditButton() {
        const container = document.getElementById("post-actions-container");
        const editBtn = document.getElementById("edit-post-btn");

        if (!container || !editBtn) return;

        const authorUsername = container.getAttribute("data-author-username");
        const savedUserStr = localStorage.getItem("user");

        if (savedUserStr && authorUsername) {
            try {
                const user = JSON.parse(savedUserStr);
                // Check against username if available, or email if that is what we have
                // The API returned "username": "testuser_harden@example.com" (email as username)
                // The localStorage "user" object often has email.
                // Let's check both or normalize.

                // If the user matches, show button
                if (
                    user.email === authorUsername ||
                    user.username === authorUsername
                ) {
                    editBtn.classList.remove("hidden");
                }
            } catch (e) {
                console.error("Error parsing user data", e);
            }
        }
    }

    setupEditButton();
    document.addEventListener("astro:after-swap", setupEditButton);
</script>
