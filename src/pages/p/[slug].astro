---
export const prerender = false;

import ArticleTemplate from "../../components/ArticleTemplate.astro";
import { processBackendContent } from "../../utils/backend-renderer";

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect("/404");
}

let post = null;
let headings = [];
let htmlContent = "";

try {
    const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
    // Using the user-confirmed endpoint
    const response = await fetch(`${API_BASE}/api/posts/${slug}/`);

    if (response.ok) {
        const apiData = await response.json();

        // Transform API data to match local post structure
        post = {
            data: {
                title: apiData.title,
                description: apiData.description,
                author:
                    apiData.author?.name ||
                    apiData.author?.username ||
                    "Unknown",
                date: new Date(apiData.created_at),
                image: apiData.image_url,
                tags: apiData.tags || [],
                series: apiData.series || "",
                // API returns reading_time (snake_case)
                readingTime: apiData.reading_time
                    ? `${apiData.reading_time} min read`
                    : "5 min read",
            },
            slug: apiData.slug,
            id: apiData.id,
            authorUsername: apiData.author?.username || "", // Add this for client-side check
        };

        // Process backend content
        if (apiData.content) {
            const result = await processBackendContent(apiData.content);
            htmlContent = result.htmlContent;
            headings = result.headings;
        }
    }
} catch (e) {
    console.error("API post fetch failed:", e);
}

if (!post) {
    return Astro.redirect("/404");
}
---

<ArticleTemplate post={post} headings={headings} htmlContent={htmlContent} />
