---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import ReaderToolbar from "../../components/ReaderToolbar.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import SelectionPopover from "../../components/SelectionPopover.astro";
import { generateHTML } from "@tiptap/html";
import StarterKit from "@tiptap/starter-kit";
import Table from "@tiptap/extension-table";
import TableRow from "@tiptap/extension-table-row";
import TableCell from "@tiptap/extension-table-cell";
import TableHeader from "@tiptap/extension-table-header";
import Heading from "@tiptap/extension-heading";
import Image from "@tiptap/extension-image";
import Underline from "@tiptap/extension-underline";
import CodeBlockLowlight from "@tiptap/extension-code-block-lowlight";
import { common, createLowlight } from "lowlight";
import { QuizExtension } from "../../components/editor/QuizExtension";
import QuizHydrator from "../../components/QuizHydrator";

// Initialize lowlight
const lowlight = createLowlight(common);

// Import Shiki for VS Code quality highlighting
import { createHighlighter } from "shiki";

// Initialize highlighter
// Shiki v1+ uses createHighlighter instead of getHighlighter, or tries to allow both but types might differ.
// Using createHighlighter is safer for newer versions.
const highlighter = await createHighlighter({
    themes: ["github-dark"],
    langs: ["python", "javascript", "html", "css", "json", "bash"],
});

// Helper for async replace
async function replaceAsync(str, regex, asyncFn) {
    const promises = [];
    str.replace(regex, (match, ...args) => {
        const promise = asyncFn(match, ...args);
        promises.push(promise);
    });
    const data = await Promise.all(promises);
    return str.replace(regex, () => data.shift());
}

// Custom extension to render output attributes
const CustomCodeBlock = CodeBlockLowlight.extend({
    addAttributes() {
        return {
            output: {
                default: null,
                parseHTML: (element) => element.getAttribute("data-output"),
                renderHTML: (attributes) => {
                    if (
                        attributes.output === null ||
                        attributes.output === undefined
                    ) {
                        return {};
                    }
                    return {
                        "data-output": attributes.output,
                    };
                },
            },
            showOutput: {
                default: false,
                parseHTML: (element) =>
                    element.getAttribute("data-show-output") === "true",
                renderHTML: (attributes) => {
                    if (!attributes.showOutput) {
                        return {};
                    }
                    return {
                        "data-show-output": "true",
                    };
                },
            },
            language: {
                default: null,
                parseHTML: (element) => {
                    const classList = element.querySelector("code")?.classList;
                    const match = classList
                        ? Array.from(classList).find((cls) =>
                              cls.startsWith("language-"),
                          )
                        : null;
                    return match ? match.replace("language-", "") : null;
                },
                renderHTML: (attributes) => {
                    // CodeBlockLowlight handles language class on code tag,
                    // but we might need to ensure it doesn't conflict or get lost.
                    // Actually, CodeBlockLowlight's own renderHTML should handle language.
                    return {};
                },
            },
        };
    },
});

// Function to highlight code blocks in HTML using Shiki
async function highlightCodeBlocks(html) {
    return replaceAsync(
        html,
        // Capture the opening pre tag attributes in group 1
        /<pre([^>]*)><code[^>]*class="[^"]*language-([a-zA-Z0-9_-]+)[^"]*"[^>]*>([\s\S]*?)<\/code><\/pre>/g,
        async (match, preAttrs, lang, content) => {
            try {
                // Decode entities to get raw code
                const decoded = content
                    .replace(/&lt;/g, "<")
                    .replace(/&gt;/g, ">")
                    .replace(/&amp;/g, "&")
                    .replace(/&quot;/g, '"')
                    .replace(/&apos;/g, "'");

                // Highlight using Shiki
                let highlighted = await highlighter.codeToHtml(decoded, {
                    lang: lang,
                    theme: "github-dark",
                });

                // Check for data-show-output in preAttrs
                const showOutputMatch = preAttrs.match(
                    /data-show-output="true"/,
                );
                const outputMatch = preAttrs.match(/data-output="([^"]*)"/);

                if (showOutputMatch && outputMatch) {
                    const outputText = outputMatch[1]
                        .replace(/&amp;/g, "&")
                        .replace(/&quot;/g, '"')
                        .replace(/&lt;/g, "<")
                        .replace(/&gt;/g, ">")
                        .replace(/&#34;/g, '"');

                    const outputHtml = `
                        <div class="mt-4 bg-[#161b22] rounded-lg border border-gray-700/50 overflow-hidden">
                            <div class="px-4 py-2 bg-[#0d1117] border-b border-gray-700/50 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                Output
                            </div>
                            <div class="p-4 font-mono text-sm text-gray-300 whitespace-pre-wrap">${outputText}</div>
                        </div>
                    `;

                    // Append output to the highlighted block
                    highlighted += outputHtml;
                }

                return highlighted;
            } catch (e) {
                console.error("Highlighting failed", e);
                return match;
            }
        },
    );
}

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect("/404");
}

let post = null;
let headings = [];
let htmlContent = "";

try {
    const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
    // Using the user-confirmed endpoint
    const response = await fetch(`${API_BASE}/api/posts/${slug}/`);

    if (response.ok) {
        const apiData = await response.json();

        // Transform API data to match local post structure
        post = {
            data: {
                title: apiData.title,
                description: apiData.description,
                author:
                    apiData.author?.name ||
                    apiData.author?.username ||
                    "Unknown",
                date: new Date(apiData.created_at),
                image: apiData.image_url,
                tags: apiData.tags || [],
                series: apiData.series || "",
                // API returns reading_time (snake_case)
                readingTime: apiData.reading_time
                    ? `${apiData.reading_time} min read`
                    : "5 min read",
            },
            slug: apiData.slug,
            id: apiData.id,
            authorUsername: apiData.author?.username || "", // Add this for client-side check
        };

        // Transform Tiptap JSON to HTML
        if (apiData.content) {
            // Pre-process content to add IDs to headings and extract TOC
            if (apiData.content.content) {
                const traverseNodes = (nodes) => {
                    nodes.forEach((node) => {
                        if (node.type === "heading") {
                            const text = node.content?.[0]?.text || "";
                            const slug = text
                                .toLowerCase()
                                .replace(/\s+/g, "-")
                                .replace(/[^\w-]/g, "");

                            // Add ID to node attributes for Tiptap to render
                            if (!node.attrs) node.attrs = {};
                            node.attrs.id = slug;

                            headings.push({
                                depth: node.attrs.level,
                                slug: slug,
                                text: text,
                            });
                        }
                        if (node.content) {
                            traverseNodes(node.content);
                        }
                    });
                };
                traverseNodes(apiData.content.content);
            }

            // Custom Heading extension to render ID
            // Custom Heading extension to render ID
            const CustomHeading = Heading.extend({
                addAttributes() {
                    return {
                        ...this.parent?.(),
                        id: {
                            default: null,
                            renderHTML: (attributes) => {
                                if (!attributes.id) {
                                    return {};
                                }
                                return {
                                    id: attributes.id,
                                };
                            },
                            parseHTML: (element) => element.getAttribute("id"),
                        },
                    };
                },
            });

            htmlContent = generateHTML(apiData.content, [
                StarterKit.configure({
                    codeBlock: false,
                    heading: false, // Disable default heading to use custom one
                }),
                CustomHeading,
                Underline,
                Table.configure({
                    HTMLAttributes: {
                        class: "border-collapse table-auto w-full my-4",
                    },
                }),
                TableRow,
                TableHeader.configure({
                    HTMLAttributes: {
                        class: "border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-800 p-2 font-bold text-left",
                    },
                }),
                TableCell.configure({
                    HTMLAttributes: {
                        class: "border border-gray-300 dark:border-gray-600 p-2",
                    },
                }),
                Image.configure({
                    HTMLAttributes: {
                        class: "rounded-xl shadow-lg my-8",
                    },
                }),
                CustomCodeBlock.configure({
                    lowlight,
                }),
                QuizExtension,
            ]);

            // Apply syntax highlighting
            htmlContent = await highlightCodeBlocks(htmlContent);
        }
    }
} catch (e) {
    console.error("API post fetch failed:", e);
}

if (!post) {
    return Astro.redirect("/404");
}

const publishDate = new Date(post.data.date).toISOString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const articleStructuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    datePublished: publishDate,
    dateModified: publishDate,
    author: {
        "@type": "Person",
        name: post.data.author,
        url: "https://takovibe.com/about/",
    },
    description: post.data.description,
    image: {
        "@type": "ImageObject",
        url: post.data.image?.startsWith("http")
            ? post.data.image
            : `https://takovibe.com${post.data.image}`,
        height: "630",
        width: "1200",
    },
    url: canonicalUrl,
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
    },
    keywords: post.data.tags?.join(", "),
    publisher: {
        "@type": "Organization",
        name: "TakoVibe",
        logo: {
            "@type": "ImageObject",
            url: "https://takovibe.com/images/logo.svg",
            width: "192",
            height: "192",
        },
    },
};

const breadcrumbStructuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://takovibe.com",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Blog",
            item: "https://takovibe.com/blog",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: post.data.title,
            item: canonicalUrl,
        },
    ],
};
---

<Layout
    title={post.data.title}
    description={post.data.description}
    type="article"
    author={post.data.author}
    tags={post.data.tags}
    published_date={publishDate}
    modified_date={publishDate}
    no_footer={true}
>
    <!-- Structured Data -->
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(articleStructuredData)}
    />
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(breadcrumbStructuredData)}
    />
    <ReadingProgress />
    <SelectionPopover />

    <div class="min-h-screen">
        <!-- Breadcrumbs -->
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 pt-6">
            <nav
                class="flex text-sm text-gray-500 dark:text-gray-400 mb-6"
                aria-label="Breadcrumb"
            >
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a
                            href="/"
                            class="inline-flex items-center hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
                        >
                            <svg
                                class="w-4 h-4 mr-2"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
                                ></path>
                            </svg>
                            Home
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg
                                class="w-6 h-6 text-gray-400"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            <a
                                href="/blog"
                                class="ml-1 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
                                >Blog</a
                            >
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <svg
                                class="w-6 h-6 text-gray-400"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            <span
                                class="ml-1 text-gray-700 dark:text-gray-200 truncate max-w-[200px] sm:max-w-xs"
                                >{post.data.title}</span
                            >
                        </div>
                    </li>
                </ol>
            </nav>
        </div>

        <!-- Main Content Layout -->
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 pb-24">
            <div class="lg:grid lg:grid-cols-12 lg:gap-8 lg:items-start">
                <!-- Left Sidebar: Table of Contents (Desktop) -->
                <aside class="hidden lg:block lg:col-span-2">
                    <div
                        class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto"
                    >
                        <TableOfContents headings={headings} />
                    </div>
                </aside>

                <!-- Main Article Content -->
                <main class="lg:col-span-10">
                    <!-- Article Header with Gradient Background -->
                    <header class="relative mb-12 overflow-hidden rounded-2xl">
                        <!-- Gradient Background -->
                        <div
                            class="absolute inset-0 bg-gradient-to-br from-purple-600 via-pink-600 to-blue-600"
                        >
                        </div>

                        <!-- Decorative Circle -->
                        <div
                            class="absolute top-6 right-6 w-24 h-24 bg-pink-500 rounded-full opacity-80"
                        >
                        </div>

                        <!-- Content -->
                        <div
                            class="relative z-10 px-4 sm:px-12 py-8 sm:py-16 text-white max-w-4xl"
                        >
                            <!-- Meta Information -->
                            <div class="flex flex-wrap items-center gap-3 mb-6">
                                {
                                    post.data.series && (
                                        <a
                                            href={`/series/${post.data.series.toLowerCase().replace(/\s+/g, "-")}`}
                                            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-yellow-400/90 hover:bg-yellow-400 text-yellow-900 border border-yellow-500/50 transition-colors"
                                        >
                                            📚 {post.data.series}
                                        </a>
                                    )
                                }
                                <span
                                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 backdrop-blur-sm border border-white/30"
                                >
                                    📅 Published
                                </span>
                                <span class="text-sm font-medium text-white/90">
                                    {post.data.readingTime || "5 min read"}
                                </span>
                                {
                                    post.data.tags &&
                                        post.data.tags
                                            .slice(0, 2)
                                            .map((tag) => (
                                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 backdrop-blur-sm border border-white/30">
                                                    #{tag}
                                                </span>
                                            ))
                                }
                            </div>

                            <!-- Title -->
                            <h1
                                class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 leading-tight"
                            >
                                {post.data.title}
                            </h1>

                            <!-- Author and Date -->
                            <div class="flex flex-wrap items-center gap-4">
                                <div class="flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 bg-pink-500 rounded-full flex items-center justify-center text-white font-bold text-lg"
                                    >
                                        {post.data.author.charAt(0)}
                                    </div>
                                    <div>
                                        <div class="font-semibold text-lg">
                                            {post.data.author}
                                        </div>
                                        <time
                                            datetime={post.data.date.toString()}
                                            class="text-sm text-white/80"
                                        >
                                            {
                                                new Date(
                                                    post.data.date,
                                                ).toLocaleDateString("en-US", {
                                                    year: "numeric",
                                                    month: "long",
                                                    day: "numeric",
                                                })
                                            }
                                        </time>
                                    </div>
                                </div>
                                <div
                                    class="ml-auto flex items-center gap-3"
                                    id="post-actions-container"
                                    data-slug={post.slug}
                                    data-author-username={post.authorUsername ||
                                        ""}
                                >
                                    <!-- Edit Button (Hidden by default) -->
                                    <a
                                        href={`/post/edit/${post.slug}`}
                                        id="edit-post-btn"
                                        class="hidden inline-flex items-center gap-2 px-4 py-3 bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl font-semibold transition-all border border-white/30 text-white"
                                    >
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                            ></path>
                                        </svg>
                                        <span class="hidden sm:inline"
                                            >Edit</span
                                        >
                                    </a>

                                    <button
                                        class="save-btn inline-flex items-center gap-2 px-4 py-3 bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl font-semibold transition-all border border-white/30 text-white"
                                        data-blog-id={post.slug}
                                        aria-label="Save for later"
                                    >
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                                            ></path>
                                        </svg>
                                        <span class="hidden sm:inline"
                                            >Save</span
                                        >
                                    </button>
                                    <a
                                        href="#Article"
                                        class="inline-flex items-center gap-2 px-6 py-3 bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl font-semibold transition-all border border-white/30"
                                    >
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                            ></path>
                                        </svg>
                                        <span class="hidden sm:inline"
                                            >Start Reading</span
                                        >
                                        <span class="inline sm:hidden"
                                            >Read</span
                                        >
                                    </a>
                                </div>
                            </div>
                        </div>
                    </header>

                    <!-- Article Body -->
                    <article
                        class="prose md:prose-lg dark:prose-invert max-w-none
            prose-headings:font-bold prose-headings:text-purple-700 dark:prose-headings:text-purple-400
            prose-p:text-gray-900 dark:prose-p:text-gray-300 prose-p:leading-relaxed
            prose-a:text-purple-600 dark:prose-a:text-purple-400 prose-a:no-underline hover:prose-a:underline
            prose-img:rounded-xl prose-img:shadow-lg
            prose-code:text-purple-600 dark:prose-code:text-purple-400 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
            prose-pre:bg-gray-900 dark:prose-pre:bg-[#1e1e1e] prose-pre:border prose-pre:border-gray-800
            prose-blockquote:border-l-4 prose-blockquote:border-purple-500 prose-blockquote:pl-6 prose-blockquote:py-2 prose-blockquote:not-italic
            prose-li:text-gray-900 dark:prose-li:text-gray-300"
                        id="Article"
                    >
                        <div class="mdx-content">
                            <div set:html={htmlContent} />
                        </div>
                    </article>

                    <!-- Series Callout - More Visible -->
                    {
                        post.data.series && (
                            <div class="mt-12 p-6 sm:p-8 bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 border-2 border-yellow-400/50 dark:border-yellow-600/50 rounded-2xl">
                                <div class="flex items-start gap-4">
                                    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-xl flex items-center justify-center text-2xl shadow-lg">
                                        📚
                                    </div>
                                    <div class="flex-1">
                                        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                                            Part of the {post.data.series}{" "}
                                            Series
                                        </h2>
                                        <p class="text-gray-700 dark:text-gray-300 mb-4">
                                            This article is part of a
                                            comprehensive learning series. Check
                                            out all articles in this series to
                                            master the topic!
                                        </p>
                                        <a
                                            href={`/series/${post.data.series.toLowerCase().replace(/\s+/g, "-")}`}
                                            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-yellow-500 to-orange-500 hover:from-yellow-600 hover:to-orange-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105"
                                        >
                                            <span>View Full Series</span>
                                            <svg
                                                class="w-5 h-5"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                                                />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        )
                    }

                    <!-- Feedback Widget -->
                    <!-- <div class="mt-16">
            <FeedbackWidget />
          </div> -->

                    <!-- Tags -->
                    <div
                        class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800"
                    >
                        <div class="flex flex-wrap gap-2">
                            {
                                post.data.tags?.map((tag) => (
                                    <a
                                        href={`/blog?tag=${encodeURIComponent(tag.toLowerCase())}`}
                                        class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-gray-800 hover:bg-purple-100 hover:text-purple-800 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-purple-900/30 dark:hover:text-purple-300 transition-colors"
                                    >
                                        #{tag}
                                    </a>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Related Posts -->
                    <div
                        class="mt-16 pt-10 border-t border-gray-200 dark:border-gray-800"
                    >
                        <h2
                            class="text-2xl font-bold text-gray-900 dark:text-white mb-8"
                        >
                            Read Next
                        </h2>
                        <RelatedPosts
                            currentSlug={post.slug}
                            tags={post.data.tags || []}
                        />
                    </div>

                    <!-- Footer -->
                    <div
                        class="mt-16 pt-10 border-t border-gray-200 dark:border-gray-800 text-center"
                    >
                        <Footer />
                    </div>
                </main>
            </div>
        </div>
    </div>

    <!-- Reader Toolbar -->
    <ReaderToolbar
        headings={headings}
        title={post.data.title}
        description={post.data.description}
        url={Astro.url.href}
        slug={post.slug}
    />
    <QuizHydrator client:only="react" />
</Layout>

<style>
