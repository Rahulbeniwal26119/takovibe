---
import Layout from "../layouts/Layout.astro";

const quickLinks = [
    {
        label: "Articles",
        href: "/blog",
        copy: "Recent deep dives, tutorials, and engineering notes.",
    },
    {
        label: "Topics",
        href: "/series",
        copy: "Browse structured series by subject.",
    },
    {
        label: "Reader",
        href: "/reader",
        copy: "Saved EPUBs, PDFs, highlights, and progress.",
    },
    {
        label: "Tools",
        href: "/tools",
        copy: "Reader, Notes, Tasks, Playground, and more.",
    },
];
---

<Layout
    title="Page Not Found - TakoVibe"
    description="We could not find that page. Use TakoVibe articles, topics, and tools to get back on track."
    type="website"
>
    <div class="bg-stone-50 text-neutral-950 dark:bg-neutral-950 dark:text-neutral-50">
    <section class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-6 py-20 text-center">
        <span
            class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-orange-700 dark:border-orange-500/30 dark:bg-orange-500/10 dark:text-orange-300"
        >
            <span class="h-1.5 w-1.5 rounded-full bg-orange-500"></span>
            404 · Page not found
        </span>

        <h1
            class="mt-6 font-display text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 sm:text-4xl"
        >
            We couldn&rsquo;t find that page.
        </h1>

        <p
            class="mt-4 max-w-md text-base leading-relaxed text-neutral-600 dark:text-neutral-400"
        >
            The link may be old, the page may have moved, or the address has a
            small typo. Try one of these instead.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
                href="/"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-500"
            >
                <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                    ></path>
                </svg>
                Go Home
            </a>
            <a
                href="/blog"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-neutral-200 bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 transition-colors hover:border-orange-300 hover:text-orange-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-orange-700 dark:hover:text-orange-300"
            >
                <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                    ></path>
                </svg>
                Read Articles
            </a>
        </div>

        <div class="mt-14 grid w-full gap-3 sm:grid-cols-2">
            {
                quickLinks.map((link) => (
                    <a
                        href={link.href}
                        class="group flex items-start justify-between gap-3 rounded-lg border border-neutral-200 bg-white p-4 text-left transition-colors hover:border-orange-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-orange-700"
                    >
                        <div class="min-w-0">
                            <div class="text-sm font-bold text-neutral-900 dark:text-white">
                                {link.label}
                            </div>
                            <p class="mt-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                                {link.copy}
                            </p>
                        </div>
                        <svg
                            class="mt-0.5 h-4 w-4 shrink-0 text-neutral-400 transition-colors group-hover:text-orange-600 dark:group-hover:text-orange-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                        </svg>
                    </a>
                ))
            }
        </div>
    </section>
    </div>
</Layout>
