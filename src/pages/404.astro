---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Page Not Found - TakoVibe"
  description="The page you're looking for doesn't exist yet. We're working on it and it will be live soon!"
>
  <div class="min-h-screen flex items-center justify-center px-4 py-8 md:py-16">
    <div class="max-w-4xl mx-auto text-center w-full">
      <!-- 404 Animation/Icon -->
      <div class="mb-6 md:mb-8">
        <div class="inline-flex items-center justify-center w-24 h-24 md:w-32 md:h-32 bg-gradient-to-br from-[#FFB4B4]/20 to-[#B4D4FF]/20 rounded-full mb-4 md:mb-6 animate-float">
          <svg class="w-12 h-12 md:w-16 md:h-16 text-[#FFB4B4] dark:text-[#B4D4FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 0a4 4 0 104 4h-6m-2-5.09V7a3 3 0 015.356-1.857M15 6.34V7a3 3 0 01-3 3"/>
          </svg>
        </div>
      </div>

      <!-- Main Message -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#FFB4B4] to-[#B4D4FF] mb-3 md:mb-4">
        404
      </h1>
      
      <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4 md:mb-6 px-4">
        Oops! Either We Lost It or We're Still Cooking It! 🍳
      </h2>
      
      <p class="text-base sm:text-lg md:text-xl text-gray-600 dark:text-gray-400 mb-6 md:mb-8 max-w-3xl mx-auto px-4 leading-relaxed">
        This page is either playing hide and seek with us 🙈, or it's still in our development kitchen getting seasoned with code! 
        Either way, we promise it's not you—it's definitely us. 😅
      </p>

      <!-- Humorous Progress Indicator -->
      <div class="mb-6 md:mb-8 px-4">
        <div class="flex items-center justify-center space-x-2 mb-2 md:mb-3">
          <div class="w-2.5 h-2.5 md:w-3 md:h-3 bg-[#FFB4B4] rounded-full animate-bounce"></div>
          <div class="w-2.5 h-2.5 md:w-3 md:h-3 bg-[#B4D4FF] rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
          <div class="w-2.5 h-2.5 md:w-3 md:h-3 bg-[#FFE4B4] rounded-full animate-bounce" style="animation-delay: 0.4s;"></div>
        </div>
        <p class="text-xs sm:text-sm md:text-base text-gray-500 dark:text-gray-400">
          Status: Either Lost in Space 🚀 or Brewing in the Lab ⚗️
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center mb-8 md:mb-12 px-4">
        <a href="/" 
           class="inline-flex items-center justify-center px-4 md:px-6 py-2.5 md:py-3 bg-gradient-to-r from-[#FFB4B4] to-[#B4D4FF] text-gray-900 font-semibold text-sm md:text-base rounded-xl hover:from-[#FF9999] hover:to-[#9999FF] transition-all transform hover:scale-105 shadow-lg min-h-[44px]">
          <svg class="w-4 h-4 md:w-5 md:h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span class="whitespace-nowrap">Take Me Home 🏠</span>
        </a>
        
        <a href="/" 
           class="inline-flex items-center justify-center px-4 md:px-6 py-2.5 md:py-3 border-2 border-[#FFB4B4] dark:border-[#B4D4FF] text-[#FFB4B4] dark:text-[#B4D4FF] font-semibold text-sm md:text-base rounded-xl hover:bg-[#FFB4B4] hover:text-gray-900 dark:hover:bg-[#B4D4FF] dark:hover:text-gray-900 transition-all transform hover:scale-105 min-h-[44px]">
          <svg class="w-4 h-4 md:w-5 md:h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          <span class="whitespace-nowrap">Read Some Blogs 📚</span>
        </a>
      </div>

      <!-- Contact Information -->
      <div class="mt-8 md:mt-12 mx-4">
        <div class="max-w-2xl mx-auto p-4 md:p-6 bg-gray-50 dark:bg-gray-800/50 rounded-2xl border border-[#FFB4B4]/20 dark:border-[#B4D4FF]/20">
          <h3 class="text-base md:text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
            Plot Twist: Maybe You Can Help Us Find It! 🕵️
          </h3>
          <p class="text-sm md:text-base text-gray-600 dark:text-gray-400 mb-4 leading-relaxed">
            If you know exactly what should be here, or just want to say hi while we figure this out, these links might help! 
          </p>
          <div class="flex flex-col sm:flex-row sm:flex-wrap justify-center items-center gap-2 md:gap-4 text-sm md:text-base">
            <a href="/about" class="text-[#FFB4B4] dark:text-[#B4D4FF] hover:underline whitespace-nowrap">
              About Me 🤞
            </a>
            <span class="text-gray-400 hidden sm:inline">•</span>
            <!-- <a href="/categories" class="text-[#FFB4B4] dark:text-[#B4D4FF] hover:underline whitespace-nowrap">
              Categories (All Sorted! 📂)
            </a> -->
            <span class="text-gray-400 hidden sm:inline">•</span>
            <a href="/series/rag-mastery" class="text-[#FFB4B4] dark:text-[#B4D4FF] hover:underline whitespace-nowrap">
              Latest Series (Hot & Fresh! 🔥)
            </a>
          </div>
        </div>
      </div>

      <!-- Fun Fact -->
      <div class="mt-6 md:mt-8 px-4">
        <div class="max-w-2xl mx-auto">
          <p class="text-xs sm:text-sm md:text-base text-gray-500 dark:text-gray-400 italic leading-relaxed">
            🎭 Fun fact: You just experienced the classic "404 Adventure"! Consider it a digital treasure hunt where the treasure is... finding your way back! 
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Background Animation -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -top-32 md:-top-40 -right-24 md:-right-32 w-60 h-60 md:w-80 md:h-80 bg-gradient-to-br from-[#FFB4B4]/20 to-[#B4D4FF]/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-32 md:-bottom-40 -left-24 md:-left-32 w-60 h-60 md:w-80 md:h-80 bg-gradient-to-br from-[#B4D4FF]/20 to-[#FFE4B4]/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  /* Ensure proper spacing on mobile */
  @media (max-width: 640px) {
    .min-h-screen {
      min-height: 100vh;
      min-height: 100dvh; /* Dynamic viewport height for mobile */
    }
  }
  
  /* Smooth animations */
  * {
    -webkit-tap-highlight-color: transparent;
  }
  
  /* Better text rendering */
  .text-transparent {
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
