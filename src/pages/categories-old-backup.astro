};

const getCategoryIcon = (tag) => categoryIcons[tag.toLowerCase()] || '📝';

// Group categories by popularity
const featuredTags = sortedTags.slice(0, 6);
const popularTags = sortedTags.slice(6, 15);
const allOtherTags = sortedTags.slice(15);

// Define category colors for lightweight styling
const categoryColors = {
    'python': 'text-green-600 bg-green-50 border-green-200',
    'javascript': 'text-yellow-600 bg-yellow-50 border-yellow-200',
    'typescript': 'text-blue-600 bg-blue-50 border-blue-200',
    'react': 'text-cyan-600 bg-cyan-50 border-cyan-200',
