---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get all blog posts and filter out future posts
const allPosts = await getCollection("blog");
const currentDate = new Date();
const publishedPosts = allPosts.filter(post => new Date(post.data.date) <= currentDate);

// Extract all unique tags and count posts per tag
const tagCounts = new Map();
const tagPosts = new Map();

publishedPosts.forEach(post => {
    if (post.data.tags) {
        post.data.tags.forEach(tag => {
            const normalizedTag = tag.toLowerCase();
            tagCounts.set(normalizedTag, (tagCounts.get(normalizedTag) || 0) + 1);

            if (!tagPosts.has(normalizedTag)) {
                tagPosts.set(normalizedTag, []);
            }
            tagPosts.get(normalizedTag).push(post);
        });
    }
});

// Sort tags by post count (descending) and then alphabetically, filter for 2+ articles
const sortedTags = Array.from(tagCounts.entries())
    .filter(([tag, count]) => count >= 2) // Show categories with 2+ articles
    .sort(([a, countA], [b, countB]) => {
        if (countB !== countA) return countB - countA;
        return a.localeCompare(b);
    });

// Sort posts by date within each tag
tagPosts.forEach((posts, tag) => {
    posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
});

// Define category icons
const categoryIcons = {
