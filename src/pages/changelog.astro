---
import Layout from "../layouts/Layout.astro";
import { changelogData } from "../data/changelog";
import ChangelogNav from "../components/ChangelogNav";

const newestEntry = changelogData[0];
const totalChanges = changelogData.reduce((total, entry) => total + entry.changes.length, 0);
const newFeatureCount = changelogData.reduce(
  (total, entry) => total + entry.changes.filter((change) => change.type === "new").length,
  0,
);

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });

const getEntryId = (date: string, index: number) => `entry-${date}-${index}`;

const getBadgeColor = (type: string) => {
  switch (type) {
    case "new":
      return "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-300 dark:border-emerald-500/20";
    case "improvement":
      return "bg-sky-50 text-sky-700 border-sky-200 dark:bg-sky-500/10 dark:text-sky-300 dark:border-sky-500/20";
    case "fix":
      return "bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-500/10 dark:text-amber-300 dark:border-amber-500/20";
    case "removed":
      return "bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-500/10 dark:text-rose-300 dark:border-rose-500/20";
    default:
      return "bg-neutral-100 text-neutral-700 border-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700";
  }
};
---

<Layout
  title="Changelog - TakoVibe"
  description="Stay up to date with the latest features, improvements, and fixes on TakoVibe."
>
  <main class="min-h-screen bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-50">
    <section class="border-b border-neutral-200/80 bg-white/80 dark:border-neutral-800 dark:bg-neutral-950/80">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_360px] lg:px-8 lg:py-16">
        <div class="max-w-3xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-sm font-semibold text-orange-700 dark:border-orange-500/20 dark:bg-orange-500/10 dark:text-orange-300">
            <span class="h-2 w-2 rounded-full bg-orange-500"></span>
            Product updates
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-neutral-950 dark:text-white sm:text-5xl">
            Changelog
          </h1>

          <p class="mt-4 max-w-2xl text-lg leading-8 text-neutral-600 dark:text-neutral-300">
            Follow the latest improvements across TakoVibe, from editor polish and playground upgrades to fixes that make reading and building smoother.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-900/70">
            <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Latest update</p>
            <p class="mt-1 text-lg font-bold text-neutral-950 dark:text-white">{formatDate(newestEntry.date)}</p>
          </div>
          <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-900/70">
            <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Release notes</p>
            <p class="mt-1 text-lg font-bold text-neutral-950 dark:text-white">{changelogData.length}</p>
          </div>
          <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-900/70">
            <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">New features</p>
            <p class="mt-1 text-lg font-bold text-neutral-950 dark:text-white">{newFeatureCount} of {totalChanges}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:px-8 lg:py-14">
      <div class="space-y-5">
        {changelogData.map((entry, index) => (
          <article
            id={getEntryId(entry.date, index)}
            class="scroll-mt-28 rounded-lg border border-neutral-200 bg-white shadow-sm transition-colors hover:border-orange-200 dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-orange-500/30"
          >
            <div class="grid gap-6 p-5 sm:p-6 lg:grid-cols-[180px_1fr] lg:p-7">
              <aside class="lg:border-r lg:border-neutral-200 lg:pr-6 dark:lg:border-neutral-800">
                <time class="block text-sm font-semibold text-orange-600 dark:text-orange-400">
                  {formatDate(entry.date)}
                </time>
                <p class="mt-3 inline-flex rounded-full border border-neutral-200 bg-neutral-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-neutral-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
                  {entry.version || new Date(entry.date).getFullYear()}
                </p>
              </aside>

              <div>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h2 class="text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
                      {entry.title}
                    </h2>
                    <p class="mt-2 max-w-3xl text-base leading-7 text-neutral-600 dark:text-neutral-300">
                      {entry.description}
                    </p>
                  </div>

                  <span class="shrink-0 rounded-full bg-orange-50 px-3 py-1 text-sm font-semibold text-orange-700 dark:bg-orange-500/10 dark:text-orange-300">
                    {entry.changes.length} {entry.changes.length === 1 ? "change" : "changes"}
                  </span>
                </div>

                <ul class="mt-6 divide-y divide-neutral-200 dark:divide-neutral-800">
                  {entry.changes.map((change) => (
                    <li class="py-5 first:pt-0 last:pb-0">
                      <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
                        <span class={`w-fit shrink-0 rounded-md border px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide ${getBadgeColor(change.type)}`}>
                          {change.type}
                        </span>
                        <p class="text-sm leading-6 text-neutral-700 dark:text-neutral-200">
                          {change.text}
                        </p>
                      </div>

                      {change.images && change.images.length > 0 && (
                        <div class={`mt-4 grid gap-4 ${change.images.length > 1 ? "sm:grid-cols-2" : "grid-cols-1"}`}>
                          {change.images.map((img, idx) => (
                            <button
                              class="group/image overflow-hidden rounded-lg border border-neutral-200 bg-white text-left shadow-sm dark:border-neutral-800 dark:bg-neutral-900"
                              onclick={`window.openImageModal('${img}')`}
                              aria-label={`Open image ${idx + 1} for ${entry.title}`}
                            >
                              <img
                                src={img}
                                alt={`${entry.title} preview ${idx + 1}`}
                                class="h-56 w-full object-cover transition-transform duration-500 group-hover/image:scale-105 sm:h-64"
                              />
                            </button>
                          ))}
                        </div>
                      )}

                      {change.comparisons && change.comparisons.length > 0 && (
                        <div class={`mt-4 grid gap-4 ${change.comparisons.length > 1 ? "xl:grid-cols-2" : "grid-cols-1"}`}>
                          {change.comparisons.map((comp) => (
                            <div class="space-y-2">
                              {comp.label && (
                                <h3 class="text-xs font-bold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
                                  {comp.label}
                                </h3>
                              )}
                              <div class="relative overflow-hidden rounded-lg border border-neutral-200 bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900">
                                <div class="relative h-64 w-full sm:h-80">
                                  <img
                                    src={comp.image_after}
                                    alt={`After ${comp.label || entry.title}`}
                                    class="absolute inset-0 h-full w-full cursor-zoom-in object-cover"
                                    onclick={`window.openImageModal('${comp.image_after}')`}
                                  />
                                  <span class="absolute right-3 top-3 rounded-md bg-black/60 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-white backdrop-blur">
                                    After
                                  </span>

                                  <div
                                    class="before-image-wrapper absolute inset-0 h-full w-full overflow-hidden"
                                    style="clip-path: inset(0 50% 0 0);"
                                  >
                                    <img
                                      src={comp.image_before}
                                      alt={`Before ${comp.label || entry.title}`}
                                      class="absolute inset-0 h-full w-full max-w-none cursor-zoom-in object-cover"
                                      onclick={`window.openImageModal('${comp.image_before}')`}
                                    />
                                    <span class="absolute left-3 top-3 rounded-md bg-black/60 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-white backdrop-blur">
                                      Before
                                    </span>
                                  </div>

                                  <div class="slider-handle pointer-events-none absolute inset-y-0 left-1/2 z-20 -ml-0.5 flex w-1 items-center justify-center bg-white">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-neutral-700 shadow-lg">
                                      <svg class="h-4 w-4 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4" />
                                      </svg>
                                    </div>
                                  </div>

                                  <button
                                    class="absolute bottom-3 right-3 z-40 rounded-full bg-black/60 p-2 text-white shadow-lg backdrop-blur transition-colors hover:bg-black/80"
                                    onclick={`window.openImageModal('${comp.image_after}')`}
                                    aria-label="View full size"
                                  >
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
                                    </svg>
                                  </button>
                                </div>

                                <input
                                  type="range"
                                  min="0"
                                  max="100"
                                  value="50"
                                  class="slider-range absolute inset-0 z-30 h-full w-full cursor-ew-resize opacity-0"
                                  oninput="
                                    const val = this.value;
                                    const wrapper = this.parentElement.querySelector('.before-image-wrapper');
                                    const handle = this.parentElement.querySelector('.slider-handle');
                                    if (wrapper && handle) {
                                      wrapper.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
                                      handle.style.left = `${val}%`;
                                    }
                                  "
                                />
                              </div>
                            </div>
                          ))}
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <ChangelogNav client:load entries={changelogData} />
      </aside>
    </section>

    <section class="border-t border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-10 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div>
          <h2 class="text-xl font-bold text-neutral-950 dark:text-white">Have an idea for TakoVibe?</h2>
          <p class="mt-1 text-neutral-600 dark:text-neutral-300">Send feedback or suggest what should land next.</p>
        </div>
        <a href="/contact" class="inline-flex w-fit items-center gap-2 rounded-full bg-orange-500 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-orange-600">
          Suggest a feature
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <div id="image-modal" class="fixed inset-0 z-[90] hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300 sm:p-8">
    <div class="absolute inset-0 bg-black/90 backdrop-blur-sm" onclick="window.closeImageModal()"></div>
    <div class="relative h-auto max-h-full w-auto max-w-7xl scale-95 transition-transform duration-300" id="modal-content">
      <button onclick="window.closeImageModal()" class="absolute -top-12 right-0 z-10 p-2 text-white transition-colors hover:text-neutral-300" aria-label="Close image preview">
        <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <img id="modal-image" src="" alt="Full size preview" class="max-h-[85vh] max-w-full rounded-lg object-contain shadow-2xl" />
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById("image-modal");
    const modalImg = document.getElementById("modal-image");
    const modalContent = document.getElementById("modal-content");

    window.openImageModal = (src) => {
      if (!modal || !modalImg || !modalContent) return;
      modalImg.src = src;
      modal.classList.remove("hidden");
      modal.classList.add("flex");

      requestAnimationFrame(() => {
        modal.classList.remove("opacity-0");
        modalContent.classList.remove("scale-95");
        modalContent.classList.add("scale-100");
      });

      document.body.style.overflow = "hidden";
    };

    window.closeImageModal = () => {
      if (!modal || !modalImg || !modalContent) return;
      modal.classList.add("opacity-0");
      modalContent.classList.remove("scale-100");
      modalContent.classList.add("scale-95");

      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modalImg.src = "";
        document.body.style.overflow = "";
      }, 300);
    };

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        window.closeImageModal();
      }
    });
  </script>
</Layout>
