---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Unsubscribe - TakoVibe"
    description="Manage your email preferences for TakoVibe"
    no_footer={true}
    no_header={true}
>
    <div
        class="min-h-screen flex items-center justify-center bg-white dark:bg-[#171923] relative overflow-hidden"
    >
        <div
            class="absolute inset-0 pointer-events-none opacity-30 dark:opacity-20"
        >
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(159,122,234,0.15),transparent_70%)]"
            >
            </div>
        </div>

        <div class="relative z-10 text-center p-8 max-w-md w-full">
            <!-- Loading State -->
            <div id="loading-state">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 mb-6"
                >
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-purple-600 to-blue-600 rounded-full blur-xl opacity-50 animate-pulse"
                        >
                        </div>
                        <div
                            class="relative w-16 h-16 bg-gradient-to-r from-purple-600 to-blue-600 rounded-full flex items-center justify-center animate-spin"
                            style="animation-duration: 3s;"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                ></path>
                            </svg>
                        </div>
                    </div>
                </div>
                <h2
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                >
                    Loading Preferences...
                </h2>
                <p class="text-gray-600 dark:text-gray-400">
                    Please wait while we fetch your settings.
                </p>
            </div>

            <!-- Preferences Form -->
            <div id="preferences-form" class="hidden text-left">
                <h2
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center"
                >
                    Manage Email Preferences
                </h2>
                <p class="text-gray-600 dark:text-gray-400 mb-8 text-center">
                    Select the emails you want to unsubscribe from.
                </p>

                <form id="unsubscribe-form" class="space-y-4">
                    <div id="categories-container" class="space-y-3">
                        <!-- Categories will be populated here -->
                    </div>

                    <div class="pt-4">
                        <button
                            type="submit"
                            class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all transform hover:scale-[1.02]"
                        >
                            Update Preferences
                        </button>
                    </div>
                </form>
            </div>

            <!-- Success State -->
            <div id="success-state" class="hidden">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 mb-6"
                >
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-green-500 rounded-full blur-xl opacity-50"
                        >
                        </div>
                        <div
                            class="relative w-16 h-16 bg-green-500 rounded-full flex items-center justify-center"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
                <h2
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                >
                    Preferences Updated
                </h2>
                <p class="text-gray-600 dark:text-gray-400 mb-6">
                    Your email preferences have been successfully updated.
                </p>
                <a
                    href="/"
                    class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white rounded-xl font-medium transition-colors"
                >
                    Return to Home
                </a>
            </div>

            <!-- Error State -->
            <div id="error-state" class="hidden">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 mb-6"
                >
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-red-500 rounded-full blur-xl opacity-50"
                        >
                        </div>
                        <div
                            class="relative w-16 h-16 bg-red-500 rounded-full flex items-center justify-center"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </div>
                    </div>
                </div>
                <h2
                    class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                >
                    Something went wrong
                </h2>
                <p
                    id="error-message"
                    class="text-gray-600 dark:text-gray-400 mb-6"
                >
                    We couldn't process your request. The link may be invalid or
                    expired.
                </p>
                <a
                    href="/"
                    class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white rounded-xl font-medium transition-colors"
                >
                    Return to Home
                </a>
            </div>
        </div>
    </div>
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

    interface ApiResponse {
        ok: boolean;
        json: () => Promise<any>;
    }

    async function initPage() {
        const params = new URLSearchParams(window.location.search);
        const email = params.get("email");
        const signature = params.get("signature");

        const loadingState = document.getElementById("loading-state");
        const preferencesForm = document.getElementById("preferences-form");
        const successState = document.getElementById("success-state");
        const errorState = document.getElementById("error-state");
        const errorMessage = document.getElementById("error-message");
        const form = document.getElementById(
            "unsubscribe-form",
        ) as HTMLFormElement;
        const categoriesContainer = document.getElementById(
            "categories-container",
        );

        if (!email || !signature) {
            loadingState?.classList.add("hidden");
            errorState?.classList.remove("hidden");
            if (errorMessage)
                errorMessage.textContent = "Invalid link parameters.";
            return;
        }

        // Fetch User Preferences
        try {
            const response = await fetch(
                `${API_URL}/api/users/unsubscribe/?email=${encodeURIComponent(email)}&signature=${encodeURIComponent(signature)}`,
            );
            const resData = await response.json();

            if (response.ok && resData.code === 0) {
                const { categories, unsubscribed_ids } = resData.data;

                // Render Categories
                if (categoriesContainer && categories.length > 0) {
                    categoriesContainer.innerHTML = categories
                        .map(
                            (cat) => `
                        <label class="flex items-center space-x-3 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors cursor-pointer group">
                            <input
                                type="checkbox"
                                name="categories"
                                value="${cat.id}"
                                ${unsubscribed_ids.includes(cat.id) ? "checked" : ""}
                                class="w-5 h-5 text-purple-600 rounded border-gray-300 focus:ring-purple-500 dark:border-gray-600 dark:bg-gray-700 dark:focus:ring-offset-gray-900"
                            />
                            <div class="flex-1">
                                <span class="block text-sm font-medium text-gray-900 dark:text-white group-hover:text-purple-400 transition-colors">
                                    ${cat.name}
                                </span>
                                <span class="block text-xs text-gray-500 dark:text-gray-400">
                                    ${cat.description || ""}
                                </span>
                            </div>
                        </label>
                    `,
                        )
                        .join("");
                } else if (categoriesContainer) {
                    categoriesContainer.innerHTML =
                        "<p class='text-gray-500'>No subscription categories found.</p>";
                }

                loadingState?.classList.add("hidden");
                preferencesForm?.classList.remove("hidden");
            } else {
                throw new Error(
                    resData.message || "Failed to load preferences",
                );
            }
        } catch (error) {
            console.error("Fetch error:", error);
            loadingState?.classList.add("hidden");
            errorState?.classList.remove("hidden");
            if (errorMessage)
                errorMessage.textContent =
                    "Failed to load your preferences. Please try again.";
        }

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            const formData = new FormData(form);
            const selectedCategories = formData
                .getAll("categories")
                .map((id) => parseInt(id));

            // Show loading again or button loading state
            const submitBtn = form.querySelector("button[type='submit']");
            if (submitBtn) {
                const originalText = submitBtn.textContent;
                submitBtn.textContent = "Updating...";
                (submitBtn as HTMLButtonElement).disabled = true;

                try {
                    const response = await fetch(
                        `${API_URL}/api/users/unsubscribe/`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify({
                                email,
                                signature,
                                categories: selectedCategories,
                                unsubscribe_all: false,
                            }),
                        },
                    );

                    preferencesForm?.classList.add("hidden");

                    if (response.ok) {
                        successState?.classList.remove("hidden");
                    } else {
                        const data = await response.json();
                        errorState?.classList.remove("hidden");
                        if (errorMessage && data.message) {
                            errorMessage.textContent = data.message;
                        }
                    }
                } catch (error) {
                    console.error("Unsubscribe error:", error);
                    preferencesForm?.classList.add("hidden");
                    errorState?.classList.remove("hidden");
                } finally {
                    if (submitBtn) {
                        submitBtn.textContent = originalText;
                        (submitBtn as HTMLButtonElement).disabled = false;
                    }
                }
            }
        });
    }

    // Run on mount
    document.addEventListener("DOMContentLoaded", initPage);
</script>
