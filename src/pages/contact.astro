---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact | TakoVibe"
  author="TakoVibe Team"
  description="Get in touch with TakoVibe. Questions, feedback, or collaboration ideas — we'd love to hear from you."
  tags={["contact", "get in touch", "collaboration", "feedback"]}
>
  <div class="min-h-screen bg-neutral-50 dark:bg-neutral-950">

    <!-- Editorial Masthead -->
    <section class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-8 bg-orange-500"></div>
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-orange-500">Contact</span>
          </div>
          <h1 class="font-display text-5xl md:text-7xl font-bold text-neutral-900 dark:text-neutral-50 leading-[1.05] mb-6">
            Let's talk.
          </h1>
          <p class="text-xl text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-lg">
            Have a question, feedback, or a collaboration idea? Fill out the form or reach out directly — we read every message.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <form id="contact-form" class="space-y-8">

            <div class="grid sm:grid-cols-2 gap-6">
              <!-- Name -->
              <div class="space-y-2">
                <label for="name" class="text-xs font-bold uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400">
                  Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your full name"
                  class="w-full px-0 py-3 bg-transparent border-0 border-b-2 border-neutral-200 dark:border-neutral-700 focus:border-orange-500 dark:focus:border-orange-500 focus:outline-none transition-colors text-neutral-900 dark:text-neutral-50 placeholder-neutral-300 dark:placeholder-neutral-600 text-base"
                />
              </div>

              <!-- Email -->
              <div class="space-y-2">
                <label for="email" class="text-xs font-bold uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="w-full px-0 py-3 bg-transparent border-0 border-b-2 border-neutral-200 dark:border-neutral-700 focus:border-orange-500 dark:focus:border-orange-500 focus:outline-none transition-colors text-neutral-900 dark:text-neutral-50 placeholder-neutral-300 dark:placeholder-neutral-600 text-base"
                />
              </div>
            </div>

            <!-- Subject -->
            <div class="space-y-2">
              <label for="subject" class="text-xs font-bold uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400">
                Topic
              </label>
              <div class="relative">
                <select
                  id="subject"
                  name="subject"
                  required
                  class="w-full px-0 py-3 bg-transparent border-0 border-b-2 border-neutral-200 dark:border-neutral-700 focus:border-orange-500 dark:focus:border-orange-500 focus:outline-none transition-colors text-neutral-900 dark:text-neutral-50 appearance-none cursor-pointer text-base"
                >
                  <option value="">Select a topic...</option>
                  <option value="general">General Inquiry</option>
                  <option value="feedback">Feedback</option>
                  <option value="collaboration">Collaboration</option>
                  <option value="contribution-writing">Contribution — Writing</option>
                  <option value="contribution-development">Contribution — Development</option>
                  <option value="guest-post">Guest Post</option>
                  <option value="series-suggestion">Series Suggestion</option>
                  <option value="technical-question">Technical Question</option>
                  <option value="other">Other</option>
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pointer-events-none text-neutral-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Message -->
            <div class="space-y-2">
              <label for="message" class="text-xs font-bold uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder="Tell us about your inquiry..."
                class="w-full px-0 py-3 bg-transparent border-0 border-b-2 border-neutral-200 dark:border-neutral-700 focus:border-orange-500 dark:focus:border-orange-500 focus:outline-none transition-colors text-neutral-900 dark:text-neutral-50 placeholder-neutral-300 dark:placeholder-neutral-600 resize-none text-base leading-relaxed"
              ></textarea>
            </div>

            <!-- Submit -->
            <div class="flex items-center gap-6 pt-2">
              <button
                type="submit"
                id="submit-btn"
                class="group inline-flex items-center gap-3 px-8 py-4 bg-neutral-900 dark:bg-neutral-50 text-white dark:text-neutral-900 font-bold text-sm uppercase tracking-[0.1em] hover:bg-orange-600 dark:hover:bg-orange-500 dark:hover:text-white transition-colors duration-200"
              >
                <span>Send Message</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </button>
              <span class="text-xs text-neutral-400 dark:text-neutral-500">We reply within 24–48 hours</span>
            </div>

            <!-- Status -->
            <div id="form-message" class="hidden"></div>
          </form>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-2 space-y-12">

          <!-- Direct Contact -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px w-6 bg-neutral-300 dark:bg-neutral-600"></div>
              <span class="text-xs font-bold uppercase tracking-[0.15em] text-neutral-400">Direct</span>
            </div>
            <div class="space-y-4">
              <a
                href="mailto:contact@takovibe.com"
                class="group flex items-center gap-4 py-4 border-b border-neutral-100 dark:border-neutral-800 hover:border-orange-200 dark:hover:border-orange-800 transition-colors"
              >
                <div class="w-10 h-10 flex items-center justify-center bg-orange-50 dark:bg-orange-950/30 text-orange-600 dark:text-orange-400 shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.1em] text-neutral-400 mb-0.5">Email</p>
                  <p class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors text-sm">
                    contact@takovibe.com
                  </p>
                </div>
              </a>

              <a
                href="https://www.linkedin.com/company/takovibe/"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 py-4 border-b border-neutral-100 dark:border-neutral-800 hover:border-orange-200 dark:hover:border-orange-800 transition-colors"
              >
                <div class="w-10 h-10 flex items-center justify-center bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 shrink-0">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.1em] text-neutral-400 mb-0.5">LinkedIn</p>
                  <p class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors text-sm">
                    TakoVibe on LinkedIn
                  </p>
                </div>
              </a>
            </div>
          </div>

          <!-- FAQ -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px w-6 bg-neutral-300 dark:bg-neutral-600"></div>
              <span class="text-xs font-bold uppercase tracking-[0.15em] text-neutral-400">Common Questions</span>
            </div>
            <div class="space-y-0 divide-y divide-neutral-100 dark:divide-neutral-800">
              <details class="group py-4">
                <summary class="flex items-center justify-between cursor-pointer list-none select-none">
                  <span class="font-semibold text-neutral-800 dark:text-neutral-200 text-sm">Can I suggest a topic or series?</span>
                  <svg class="w-4 h-4 text-neutral-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
                  Absolutely. Use the form and select "Series Suggestion." We genuinely love community-driven ideas.
                </p>
              </details>

              <details class="group py-4">
                <summary class="flex items-center justify-between cursor-pointer list-none select-none">
                  <span class="font-semibold text-neutral-800 dark:text-neutral-200 text-sm">Do you accept guest posts?</span>
                  <svg class="w-4 h-4 text-neutral-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
                  Yes — we welcome well-crafted tech articles. Send us your outline and a writing sample to get started.
                </p>
              </details>

              <details class="group py-4">
                <summary class="flex items-center justify-between cursor-pointer list-none select-none">
                  <span class="font-semibold text-neutral-800 dark:text-neutral-200 text-sm">How long does a reply take?</span>
                  <svg class="w-4 h-4 text-neutral-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
                  Typically 24–48 hours on business days. Complex inquiries may take a little longer.
                </p>
              </details>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  details summary::-webkit-details-marker { display: none; }
  details summary::marker { content: ""; }

  select option {
    background-color: white;
    color: #171717;
  }

  @media (prefers-color-scheme: dark) {
    select option {
      background-color: #0a0a0a;
      color: #fafafa;
    }
  }

  .dark select option {
    background-color: #0a0a0a;
    color: #fafafa;
  }
</style>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const messageDiv = document.getElementById("form-message") as HTMLDivElement;

    const urlParams = new URLSearchParams(window.location.search);
    const subjectParam = urlParams.get("subject");
    if (subjectParam) {
      const subjectSelect = document.getElementById("subject") as HTMLSelectElement;
      if (subjectSelect) subjectSelect.value = subjectParam;
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        name: formData.get("name") as string,
        email: formData.get("email") as string,
        subject: formData.get("subject") as string,
        message: formData.get("message") as string,
      };

      if (!data.name || !data.email || !data.subject || !data.message) {
        showMessage("error", "Please fill in all required fields.");
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalHTML = submitButton.innerHTML;
      submitButton.innerHTML = `<span class="flex items-center gap-2"><svg class="animate-spin w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>Sending...</span>`;
      submitButton.disabled = true;

      try {
        const response = await fetch(`${API_URL}/api/blogs/contact-us/`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || errorData.error || `Error ${response.status}`);
        }

        showMessage("success", "Message sent!", "Thank you for reaching out. We'll get back to you soon.");
        form.reset();
      } catch (error) {
        const msg = error instanceof Error ? error.message : "Unknown error";
        showMessage("error", "Failed to send", msg || "Please try again or email us directly.");
      } finally {
        submitButton.innerHTML = originalHTML;
        submitButton.disabled = false;
      }
    });

    function showMessage(type: "success" | "error", title: string, description?: string) {
      const isSuccess = type === "success";
      messageDiv.className = `p-4 border text-sm ${
        isSuccess
          ? "bg-green-50 dark:bg-green-950/20 border-green-200 dark:border-green-800 text-green-800 dark:text-green-300"
          : "bg-red-50 dark:bg-red-950/20 border-red-200 dark:border-red-800 text-red-800 dark:text-red-300"
      }`;
      messageDiv.innerHTML = `<p class="font-bold">${title}</p>${description ? `<p class="mt-1 opacity-80">${description}</p>` : ""}`;
      messageDiv.classList.remove("hidden");
      if (isSuccess) setTimeout(() => messageDiv.classList.add("hidden"), 6000);
    }
  });
</script>
