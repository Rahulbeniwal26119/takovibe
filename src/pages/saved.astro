---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Saved Articles | TakoVibe"
  description="Your saved TakoVibe articles, tutorials, and references."
>
  <div class="relative w-full min-h-screen overflow-x-hidden bg-stone-50 dark:bg-neutral-950">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute top-0 left-0 right-0 h-[520px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"></div>
    </div>

    <div class="relative z-10 w-full">
      <section class="border-b border-neutral-200 dark:border-neutral-800">
        <div class="max-w-5xl mx-auto px-6 pt-16 pb-10">
          <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
            <div>
              <div class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-orange-600 dark:text-orange-400">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16l-7-3.5L5 21V5Z"></path>
                </svg>
                Reading Library
              </div>
              <h1 class="font-display text-4xl font-bold text-neutral-900 dark:text-neutral-50 md:text-5xl">
                Saved Articles
              </h1>
              <p class="mt-3 max-w-xl text-lg text-neutral-500 dark:text-neutral-400">
                A focused shelf for posts you want to revisit, compare, or finish later.
              </p>
            </div>

            <a
              href="/blog"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90 dark:bg-neutral-100 dark:text-neutral-900"
            >
              Browse Articles
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-[minmax(0,1fr)_180px]">
            <label class="relative block">
              <span class="sr-only">Search saved articles</span>
              <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"></path>
              </svg>
              <input
                id="search-input"
                type="search"
                placeholder="Search your saved articles..."
                class="w-full rounded-lg border border-neutral-200 bg-white py-3 pl-10 pr-4 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-orange-400 focus:outline-none dark:border-neutral-800 dark:bg-neutral-900 dark:text-white dark:placeholder-neutral-500 dark:focus:border-orange-600"
              />
            </label>

            <label class="relative block">
              <span class="sr-only">Sort saved articles</span>
              <select
                id="sort-select"
                class="w-full appearance-none rounded-lg border border-neutral-200 bg-white px-4 py-3 pr-9 text-sm font-medium text-neutral-700 transition-colors focus:border-orange-400 focus:outline-none dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:focus:border-orange-600"
              >
                <option value="date-desc">Newest first</option>
                <option value="date-asc">Oldest first</option>
                <option value="title-asc">Title A-Z</option>
              </select>
              <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path>
              </svg>
            </label>
          </div>
        </div>
      </section>

      <main class="max-w-5xl mx-auto px-6 py-10">
        <div class="mb-6 flex items-center justify-between gap-4">
          <span
            id="results-count"
            class="text-xs font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500"
          >
            Loading
          </span>
          <button
            id="clear-search-btn"
            class="hidden text-sm font-medium text-neutral-500 transition-colors hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400"
            type="button"
          >
            Clear search
          </button>
        </div>

        <div id="loading-state" class="py-24">
          <div class="flex items-center justify-center gap-3 text-neutral-400 dark:text-neutral-500">
            <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
            </svg>
            <span class="text-sm">Loading your saved articles...</span>
          </div>
        </div>

        <div id="login-state" class="hidden py-24 text-center">
          <div class="mx-auto max-w-sm">
            <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-lg border border-neutral-200 bg-white text-neutral-400 dark:border-neutral-800 dark:bg-neutral-900">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H8m8 0-4-4m4 4-4 4m8-10v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2Z"></path>
              </svg>
            </div>
            <h2 class="mb-2 text-lg font-semibold text-neutral-900 dark:text-neutral-50">
              Sign in to see saved articles
            </h2>
            <p class="mb-6 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
              Your reading library is tied to your account so it stays available across devices.
            </p>
            <a
              href="/login"
              class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90 dark:bg-neutral-100 dark:text-neutral-900"
            >
              Log In
            </a>
          </div>
        </div>

        <div id="empty-state" class="hidden py-24 text-center">
          <div class="mx-auto max-w-sm">
            <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-lg border border-neutral-200 bg-white text-neutral-400 dark:border-neutral-800 dark:bg-neutral-900">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16l-7-3.5L5 21V5Z"></path>
              </svg>
            </div>
            <h2 class="mb-2 text-lg font-semibold text-neutral-900 dark:text-neutral-50">
              No saved articles yet
            </h2>
            <p class="mb-6 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
              Save articles from the blog list or article pages and they will appear here.
            </p>
            <a
              href="/blog"
              class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90 dark:bg-neutral-100 dark:text-neutral-900"
            >
              Browse Articles
            </a>
          </div>
        </div>

        <div id="no-results" class="hidden py-24 text-center">
          <div class="mx-auto max-w-sm">
            <h2 class="mb-2 text-lg font-semibold text-neutral-900 dark:text-neutral-50">
              No matches found
            </h2>
            <p class="mb-6 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
              Try a different title, tag, or description.
            </p>
            <button
              id="clear-empty-btn"
              type="button"
              class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90 dark:bg-neutral-100 dark:text-neutral-900"
            >
              Clear Search
            </button>
          </div>
        </div>

        <div
          id="articles-list"
          class="divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800"
        >
        </div>
      </main>
    </div>
  </div>
</Layout>

<script>
  import { fetchBookmarks, removeBookmark } from "../utils/bookmarks";
  import { showToast } from "../utils/toast";

  let bookmarks = [];
  let filteredBookmarks = [];
  let hasInitialized = false;

  const articlesList = document.getElementById("articles-list");
  const loadingState = document.getElementById("loading-state");
  const emptyState = document.getElementById("empty-state");
  const loginState = document.getElementById("login-state");
  const noResults = document.getElementById("no-results");
  const resultsCount = document.getElementById("results-count");
  const clearSearchBtn = document.getElementById("clear-search-btn");
  const clearEmptyBtn = document.getElementById("clear-empty-btn");
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;

  async function init() {
    if (hasInitialized) return;
    hasInitialized = true;

    const token = localStorage.getItem("access_token");
    if (!token) {
      hideElement(loadingState);
      showElement(loginState);
      updateResultsText(0);
      return;
    }

    try {
      bookmarks = await fetchBookmarks();
      filteredBookmarks = [...bookmarks];
      filterAndSort();
    } catch (error) {
      console.error("Failed to load bookmarks:", error);
      showToast("Failed to load your saved articles", "error");
      updateResultsText(0);
    } finally {
      hideElement(loadingState);
    }
  }

  function filterAndSort() {
    const term = (searchInput?.value || "").trim().toLowerCase();
    const sort = sortSelect?.value || "date-desc";

    filteredBookmarks = bookmarks.filter((post) => {
      const haystack = [
        post.title,
        post.description,
        post.author?.name,
        ...(post.tags || []),
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return haystack.includes(term);
    });

    filteredBookmarks.sort((a, b) => {
      if (sort === "date-asc") {
        return getTime(a.created_at) - getTime(b.created_at);
      }
      if (sort === "title-asc") {
        return (a.title || "").localeCompare(b.title || "");
      }
      return getTime(b.created_at) - getTime(a.created_at);
    });

    renderBookmarks(term);
  }

  function renderBookmarks(term = "") {
    if (!articlesList) return;

    articlesList.innerHTML = "";
    hideElement(emptyState);
    hideElement(noResults);

    if (bookmarks.length === 0) {
      hideElement(articlesList);
      showElement(emptyState);
      updateResultsText(0);
      return;
    }

    if (filteredBookmarks.length === 0) {
      hideElement(articlesList);
      showElement(noResults);
      updateResultsText(0, term);
      toggleClearButton(term);
      return;
    }

    showElement(articlesList);
    updateResultsText(filteredBookmarks.length, term);
    toggleClearButton(term);

    filteredBookmarks.forEach((post, index) => {
      const article = createArticleElement(post, index);
      articlesList.appendChild(article);
    });

    setupUnsaveButtons();
  }

  function createArticleElement(post: any, index: number) {
    const article = document.createElement("article");
    article.className = "group relative";
    article.style.animation = `fadeInUp 0.35s ease-out forwards ${Math.min(index, 8) * 0.04}s`;
    article.style.opacity = "0";

    const date = formatDate(post.created_at);
    const firstTag = post.tags?.[0] || "";
    const title = escapeHTML(post.title || "Untitled article");
    const description = escapeHTML(post.description || "No description available.");
    const author = escapeHTML(post.author?.name || "TakoVibe Team");
    const readingTime = escapeHTML(post.readingTime || "5 min read");
    const slug = escapeAttr(post.slug || "");
    const imageUrl = post.image_url ? escapeAttr(post.image_url) : "";
    const initials = escapeHTML((post.author?.name || "T").charAt(0).toUpperCase());

    article.innerHTML = `
      <a href="/blog/${slug}/" class="flex items-start gap-4 py-5">
        ${
          imageUrl
            ? `<div class="h-24 w-24 shrink-0 overflow-hidden rounded-lg bg-neutral-100 dark:bg-neutral-800 sm:h-24 sm:w-36">
                <img src="${imageUrl}" alt="${title}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
              </div>`
            : `<div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-neutral-400 dark:bg-neutral-800 sm:h-24 sm:w-36">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8l6 6v10a2 2 0 0 1-2 2Z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 3v6h6"></path>
                </svg>
              </div>`
        }

        <div class="min-w-0 flex-1 pr-10 sm:pr-12">
          <div class="mb-1.5 flex flex-wrap items-center gap-2 text-[11px] text-neutral-400 dark:text-neutral-500">
            ${firstTag ? `<span class="font-medium text-orange-600 dark:text-orange-400">${escapeHTML(firstTag)}</span><span aria-hidden="true">·</span>` : ""}
            <span>${date}</span>
            <span aria-hidden="true">·</span>
            <span>${readingTime}</span>
          </div>
          <h2 class="mb-1 text-base font-semibold leading-snug text-neutral-900 transition-colors group-hover:text-orange-600 dark:text-neutral-50 dark:group-hover:text-orange-400 sm:text-lg">
            ${title}
          </h2>
          <p class="line-clamp-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
            ${description}
          </p>
          <div class="mt-3 flex items-center gap-2">
            <div class="flex h-5 w-5 items-center justify-center rounded-full bg-neutral-200 text-[9px] font-bold text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
              ${initials}
            </div>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">${author}</span>
          </div>
        </div>
      </a>

      <button
        class="unsave-btn absolute right-0 top-5 rounded-lg p-2 text-orange-600 transition-colors hover:bg-orange-50 hover:text-red-600 dark:text-orange-400 dark:hover:bg-red-950/30 dark:hover:text-red-400 sm:right-2"
        type="button"
        data-blog-slug="${slug}"
        aria-label="Remove ${title} from saved articles"
        title="Remove from saved"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16l-7-3.5L5 21V5Z"></path>
        </svg>
      </button>
    `;

    return article;
  }

  function setupUnsaveButtons() {
    document.querySelectorAll(".unsave-btn").forEach((btn) => {
      if (btn.hasAttribute("data-bound")) return;
      btn.setAttribute("data-bound", "true");

      btn.addEventListener("click", async (event) => {
        event.preventDefault();
        event.stopPropagation();

        const slug = btn.getAttribute("data-blog-slug");
        if (!slug) return;

        btn.setAttribute("disabled", "true");
        const success = await removeBookmark(slug);
        btn.removeAttribute("disabled");

        if (!success) {
          showToast("Failed to remove bookmark.", "error");
          return;
        }

        bookmarks = bookmarks.filter((post) => post.slug !== slug);
        showToast("Article removed from saved list", "success");
        filterAndSort();
      });
    });
  }

  function updateResultsText(count: number, term = "") {
    if (!resultsCount) return;

    if (term) {
      resultsCount.textContent = `${count} ${count === 1 ? "match" : "matches"}`;
      return;
    }

    resultsCount.textContent = `${count} saved ${count === 1 ? "article" : "articles"}`;
  }

  function clearSearch() {
    if (searchInput) searchInput.value = "";
    filterAndSort();
  }

  function toggleClearButton(term: string) {
    if (!clearSearchBtn) return;
    clearSearchBtn.classList.toggle("hidden", !term);
  }

  function getTime(value: string) {
    const time = new Date(value).getTime();
    return Number.isNaN(time) ? 0 : time;
  }

  function formatDate(value: string) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "Recently";

    return date.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  }

  function showElement(element: Element | null) {
    element?.classList.remove("hidden");
  }

  function hideElement(element: Element | null) {
    element?.classList.add("hidden");
  }

  function escapeHTML(value: string) {
    return String(value).replace(/[&<>"']/g, (char) => {
      const entities = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entities[char];
    });
  }

  function escapeAttr(value: string) {
    return escapeHTML(value).replace(/`/g, "&#96;");
  }

  searchInput?.addEventListener("input", filterAndSort);
  sortSelect?.addEventListener("change", filterAndSort);
  clearSearchBtn?.addEventListener("click", clearSearch);
  clearEmptyBtn?.addEventListener("click", clearSearch);

  init();
  document.addEventListener("astro:after-swap", init);
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
