                attrs: { level: 1 },
                content: [
                    { type: "text", text: "Start writing your story..." },
                ],
            },
            {
                type: "quizComponent",
                attrs: {
                    question: "What is your question?",
                    options: ["Option 1", "Option 2"],
                    correctIndex: 0,
                },
            },
            {
                type: "image",
                attrs: {
                    src: "https://ik.imagekit.io/bhu1voux5/Template%20Injection?updatedAt=1763188980710",
                    alt: null,
                    title: null,
                    caption: "Testing",
                },
            },
            {
                type: "table",
                content: [
                    {
                        type: "tableRow",
                        content: [
                            {
                                type: "tableHeader",
                                attrs: {
                                    colspan: 1,
                                    rowspan: 1,
                                    colwidth: null,
                                },
                                content: [
                                    {
                                        type: "paragraph",
                                        content: [{ type: "text", text: "A" }],
                                    },
                                ],
                            },
                            {
                                type: "tableHeader",
                                attrs: {
                                    colspan: 1,
                                    rowspan: 1,
                                    colwidth: null,
                                },
                                content: [
                                    {
                                        type: "paragraph",
                                        content: [{ type: "text", text: "B" }],
                                    },
                                ],
                            },
                            {
                                type: "tableHeader",
                                attrs: {
                                    colspan: 1,
