---
import Layout from "../layouts/Layout.astro";
import TurnstileWidget from "../components/TurnstileWidget.astro";
---

<Layout title="Welcome to TakoVibe" description="Sign in or create an account" no_footer={true}>
    <div class="relative min-h-screen overflow-x-hidden bg-stone-50 dark:bg-neutral-950">
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div class="absolute left-0 right-0 top-0 h-[520px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"></div>
        </div>

        <main class="relative z-10 mx-auto grid min-h-[calc(100svh-3.5rem)] max-w-6xl items-center gap-8 px-4 py-6 sm:px-6 sm:py-10 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-12 lg:py-12">
            <section class="hidden lg:flex min-h-[620px]">
                <div class="relative flex min-h-[620px] w-full overflow-hidden rounded-lg border border-neutral-200 bg-neutral-950 dark:border-neutral-800">
                    <img
                        src="https://ik.imagekit.io/takovibe/auth%20image"
                        alt="TakoVibe learning workspace"
                        class="absolute inset-0 h-full w-full object-cover object-center opacity-90"
                        loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-black/10"></div>
                    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/70 to-transparent"></div>

                    <div class="relative z-10 flex max-w-xl flex-col justify-end p-10 xl:p-12">
                        <div class="mb-4 inline-flex w-fit items-center rounded-md bg-white/10 px-2.5 py-1 text-xs font-semibold text-orange-200 backdrop-blur">
                            TakoVibe account
                        </div>
                        <h1 class="font-display text-5xl font-bold leading-tight text-white xl:text-6xl">
                            Pick up where your learning left off.
                        </h1>
                        <p class="mt-4 max-w-lg text-lg leading-relaxed text-neutral-200">
                            Sign in to continue with your articles, notes, saved posts, and writing workspace.
                        </p>
                    </div>
                </div>
            </section>

            <section class="w-full max-w-md justify-self-center lg:max-w-none">
                <div class="relative overflow-hidden rounded-lg border border-neutral-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900 sm:p-8">
                    <img
                        src="https://ik.imagekit.io/takovibe/auth%20image"
                        alt=""
                        aria-hidden="true"
                        class="pointer-events-none absolute -right-12 top-2 h-32 w-40 object-contain opacity-[0.07] dark:opacity-[0.09] lg:hidden"
                        loading="lazy"
                    />
                    <div class="relative mb-6 sm:mb-8">
                        <a href="/" class="mb-5 inline-flex items-center gap-3">
                            <img
                                src="/images/logo.svg"
                                alt="TakoVibe"
                                class="h-10 w-10 rounded-full"
                            />
                            <span class="font-display text-xl font-bold text-neutral-900 dark:text-neutral-50">TakoVibe</span>
                        </a>
                        <h2 id="auth-title" class="font-display text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">
                            Welcome back
                        </h2>
                        <p id="auth-subtitle" class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
                            Please enter your details to sign in.
                        </p>
                    </div>

                    <div class="relative mb-5 grid grid-cols-2 gap-1 rounded-lg bg-neutral-100 p-1 dark:bg-neutral-800 sm:mb-6">
                        <button id="tab-login" class="auth-tab-active rounded-md px-4 py-2.5 text-sm font-semibold transition-colors">
                            Sign In
                        </button>
                        <button id="tab-signup" class="auth-tab-inactive rounded-md px-4 py-2.5 text-sm font-semibold transition-colors">
                            Sign Up
                        </button>
                    </div>

                    <div id="google-btn-container" class="relative flex w-full justify-center"></div>

                    <div class="relative my-5 sm:my-6">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-neutral-200 dark:border-neutral-800"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="bg-white px-4 text-neutral-400 dark:bg-neutral-900 dark:text-neutral-500">
                                Or continue with email
                            </span>
                        </div>
                    </div>

                    <div id="auth-error" class="mb-6 hidden rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-900/60 dark:bg-red-950/30">
                        <div class="flex gap-3">
                            <svg class="h-5 w-5 shrink-0 text-red-500 dark:text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                            </svg>
                            <h3 id="error-message" class="text-sm font-medium text-red-800 dark:text-red-200">
                                Authentication failed
                            </h3>
                        </div>
                    </div>

                    <form id="login-form" class="space-y-4 sm:space-y-5">
                        <div>
                            <label for="login-email" class="mb-1 block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                                Email address
                            </label>
                            <input
                                id="login-email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                required
                                class="block w-full rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-neutral-900 shadow-sm outline-none transition-colors placeholder:text-neutral-400 focus:border-orange-400 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white dark:placeholder:text-neutral-500 dark:focus:border-orange-700 sm:py-3"
                                placeholder="you@example.com"
                            />
                        </div>

                        <div>
                            <div class="mb-1 flex items-center justify-between">
                                <label for="login-password" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                                    Password
                                </label>
                                <a href="/forgot-password" class="text-sm font-medium text-orange-600 hover:text-orange-700 dark:text-orange-400 dark:hover:text-orange-300">
                                    Forgot password?
                                </a>
                            </div>
                            <input
                                id="login-password"
                                name="password"
                                type="password"
                                autocomplete="current-password"
                                required
                                class="block w-full rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-neutral-900 shadow-sm outline-none transition-colors placeholder:text-neutral-400 focus:border-orange-400 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white dark:placeholder:text-neutral-500 dark:focus:border-orange-700 sm:py-3"
                                placeholder="••••••••"
                            />
                        </div>

                        <div class="flex justify-center">
                            <TurnstileWidget />
                        </div>

                        <button type="submit" class="flex w-full justify-center rounded-lg bg-orange-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-neutral-900 sm:py-3">
                            Sign In
                        </button>
                    </form>

                    <form id="signup-form" class="hidden space-y-4 sm:space-y-5">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="signup-firstname" class="mb-1 block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                                    First Name
                                </label>
                                <input id="signup-firstname" name="first_name" type="text" required class="block w-full rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-neutral-900 shadow-sm outline-none transition-colors focus:border-orange-400 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white dark:focus:border-orange-700 sm:py-3" />
                            </div>
                            <div>
                                <label for="signup-lastname" class="mb-1 block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                                    Last Name
                                </label>
                                <input id="signup-lastname" name="last_name" type="text" required class="block w-full rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-neutral-900 shadow-sm outline-none transition-colors focus:border-orange-400 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white dark:focus:border-orange-700 sm:py-3" />
                            </div>
                        </div>

                        <div>
                            <label for="signup-email" class="mb-1 block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                                Email address
                            </label>
                            <input id="signup-email" name="email" type="email" autocomplete="email" required class="block w-full rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-neutral-900 shadow-sm outline-none transition-colors focus:border-orange-400 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white dark:focus:border-orange-700 sm:py-3" />
                        </div>

                        <div>
                            <label for="signup-password" class="mb-1 block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                                Password
                            </label>
                            <input id="signup-password" name="password" type="password" autocomplete="new-password" required class="block w-full rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-neutral-900 shadow-sm outline-none transition-colors focus:border-orange-400 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white dark:focus:border-orange-700 sm:py-3" />
                        </div>

                        <div class="flex justify-center">
                            <TurnstileWidget />
                        </div>

                        <button type="submit" class="flex w-full justify-center rounded-lg bg-orange-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 dark:focus:ring-offset-neutral-900 sm:py-3">
                            Create Account
                        </button>
                    </form>
                </div>
            </section>
        </main>
    </div>
</Layout>

<script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

    interface ApiResponse {
        ok: boolean;
        status: number;
        json: () => Promise<any>;
    }

    declare global {
        interface Window {
            turnstile?: {
                reset: () => void;
            };
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);
        const mode = urlParams.get("mode");

        const loginForm = document.getElementById(
            "login-form",
        ) as HTMLFormElement;
        const signupForm = document.getElementById(
            "signup-form",
        ) as HTMLFormElement;
        const tabLogin = document.getElementById("tab-login");
        const tabSignup = document.getElementById("tab-signup");
        const authTitle = document.getElementById("auth-title");
        const authSubtitle = document.getElementById("auth-subtitle");
        const errorDiv = document.getElementById("auth-error");
        const errorMessage = document.getElementById("error-message");

        function switchMode(newMode: "login" | "signup") {
            if (newMode === "signup") {
                loginForm.classList.add("hidden");
                signupForm.classList.remove("hidden");
                tabLogin?.classList.remove("auth-tab-active");
                tabLogin?.classList.add("auth-tab-inactive");
                tabSignup?.classList.add("auth-tab-active");
                tabSignup?.classList.remove("auth-tab-inactive");
                if (authTitle) authTitle.textContent = "Create an account";
                if (authSubtitle)
                    authSubtitle.textContent =
                        "Join our community and start your journey.";

                // Update URL without reload
                const url = new URL(window.location.href);
                url.searchParams.set("mode", "signup");
                window.history.pushState({}, "", url);
            } else {
                signupForm.classList.add("hidden");
                loginForm.classList.remove("hidden");
                tabSignup?.classList.remove("auth-tab-active");
                tabSignup?.classList.add("auth-tab-inactive");
                tabLogin?.classList.add("auth-tab-active");
                tabLogin?.classList.remove("auth-tab-inactive");
                if (authTitle) authTitle.textContent = "Welcome back";
                if (authSubtitle)
                    authSubtitle.textContent =
                        "Please enter your details to sign in.";

                // Update URL without reload
                const url = new URL(window.location.href);
                url.searchParams.delete("mode");
                window.history.pushState({}, "", url);
            }
            errorDiv?.classList.add("hidden");
        }

        tabLogin?.addEventListener("click", () => switchMode("login"));
        tabSignup?.addEventListener("click", () => switchMode("signup"));

        if (mode === "signup") {
            switchMode("signup");
        }

        // Handle Form Submissions
        async function handleAuth(
            e: Event,
            endpoint: string,
            form: HTMLFormElement,
        ) {
            e.preventDefault();
            errorDiv?.classList.add("hidden");

            const submitBtn = form.querySelector("button[type='submit']");
            if (submitBtn) {
                const originalText = submitBtn.textContent;
                submitBtn.textContent = "Processing...";
                (submitBtn as HTMLButtonElement).disabled = true;

                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(`${API_URL}${endpoint}`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data),
                    });

                    const resData = await response.json();

                    if (response.ok && resData.code === 0) {
                        // Try to find token in various places, prioritizing auth_token
                        const data = resData.data || {};
                        const token =
                            data.auth_token ||
                            data.access ||
                            data.token ||
                            resData.auth_token ||
                            resData.access ||
                            resData.token;

                        if (token) {
                            localStorage.setItem("access_token", token);

                            // Set 7-day expiration
                            const expiryDate = new Date();
                            expiryDate.setDate(expiryDate.getDate() + 7);
                            localStorage.setItem(
                                "token_expiry",
                                expiryDate.toISOString(),
                            );

                            // Initialize userObj from response data if available
                            let userObj = data.user;

                            // Normalize user object from response if needed
                            if (userObj) {
                                userObj = {
                                    name: `${userObj.first_name || ""} ${userObj.last_name || ""}`.trim(),
                                    email: userObj.email,
                                    image:
                                        userObj.profile_image ||
                                        userObj.image ||
                                        userObj.avatar ||
                                        "",
                                    is_author: userObj.is_author || false,
                                    is_superuser: userObj.is_superuser || false,
                                    client_type:
                                        userObj.client_type || "Reader",
                                };
                            }

                            if (endpoint.includes("login")) {
                                // Fetch user profile to get complete details
                                try {
                                    const profileResp = await fetch(
                                        `${API_URL}/api/users/me/`,
                                        {
                                            headers: {
                                                Authorization: `Token ${token}`,
                                            },
                                        },
                                    );

                                    if (profileResp.ok) {
                                        const profileData =
                                            await profileResp.json();
                                        const userData =
                                            profileData.data || profileData;

                                        // Handle response format: { name: "...", ... } vs { first_name: "...", last_name: "...", ... }
                                        const name =
                                            userData.name ||
                                            `${userData.first_name || ""} ${userData.last_name || ""}`.trim();

                                        userObj = {
                                            name: name,
                                            email: userData.email,
                                            image:
                                                userData.profile_image ||
                                                userData.image ||
                                                userData.avatar ||
                                                "",
                                            username: userData.username,
                                            is_author:
                                                userData.is_author || false,
                                            is_superuser:
                                                userData.is_superuser || false,
                                            client_type:
                                                userData.client_type ||
                                                "Reader",
                                        };
                                    } else {
                                        console.warn(
                                            "Profile fetch failed:",
                                            profileResp.status,
                                        );
                                    }
                                } catch (err) {
                                    console.warn(
                                        "Failed to fetch user profile",
                                        err,
                                    );
                                }
                            } else {
                                // Signup logic (usually returns user object)
                                if (!userObj) {
                                    if (data.first_name) {
                                        userObj = {
                                            name: `${data.first_name} ${data.last_name}`.trim(),
                                            email: data.email,
                                            image: "",
                                            username: data.username,
                                            is_author: false,
                                            is_superuser: false,
                                            client_type: "Reader",
                                        };
                                    }
                                }
                            }

                            if (userObj) {
                                localStorage.setItem(
                                    "user",
                                    JSON.stringify(userObj),
                                );
                            } else {
                                console.warn("No user object created");
                            }

                            window.location.href = getRedirectUrl();
                        } else {
                            console.warn("No token in response data");
                            if (endpoint.includes("signup")) {
                                // Fallback only if absolutely no token found
                                switchMode("login");
                                alert(
                                    "Account created successfully! Please sign in.",
                                );
                            } else {
                                window.location.href = getRedirectUrl();
                            }
                        }
                    } else {
                        console.error("API Error:", resData);
                        errorDiv?.classList.remove("hidden");

                        let msg = resData.message || resData.detail;
                        if (
                            !msg &&
                            resData.non_field_errors &&
                            Array.isArray(resData.non_field_errors)
                        ) {
                            msg = resData.non_field_errors[0];
                        }
                        if (!msg && typeof resData === "object") {
                            // Try to find first error message in object values
                            const values = Object.values(resData);
                            if (values.length > 0) {
                                const firstVal = values[0];
                                if (typeof firstVal === "string")
                                    msg = firstVal;
                                else if (
                                    Array.isArray(firstVal) &&
                                    firstVal.length > 0
                                )
                                    msg = firstVal[0];
                            }
                        }

                        if (response.status === 429) {
                            msg = "Too many requests. Please try again later.";
                        }

                        if (errorMessage)
                            errorMessage.textContent =
                                msg || "Authentication failed";

                        // Reset Turnstile
                        if (window.turnstile) {
                            window.turnstile.reset();
                        }
                    }
                } catch (error) {
                    console.error("Auth error:", error);
                    errorDiv?.classList.remove("hidden");
                    if (errorMessage)
                        errorMessage.textContent =
                            "An unexpected error occurred. Please try again.";

                    // Reset Turnstile
                    if (window.turnstile) {
                        window.turnstile.reset();
                    }
                } finally {
                    submitBtn.textContent = originalText;
                    (submitBtn as HTMLButtonElement).disabled = false;
                }
            }
        }

        loginForm?.addEventListener("submit", (e) =>
            handleAuth(e, "/api/users/login/", loginForm),
        );
        signupForm?.addEventListener("submit", (e) =>
            handleAuth(e, "/api/users/signup/", signupForm),
        );

        const GOOGLE_CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

        // Redirect helper
        const getRedirectUrl = () => {
            const params = new URLSearchParams(window.location.search);
            return params.get("next") || params.get("redirect") || "/";
        };

        function handleGoogleCredentialResponse(response: any) {
            if (response.credential) {
                handleGoogleLogin(response.credential);
            }
        }

        // @ts-ignore
        window.onGoogleLibraryLoad = () => {
            // @ts-ignore
            google.accounts.id.initialize({
                client_id: GOOGLE_CLIENT_ID,
                callback: handleGoogleCredentialResponse,
                auto_select: false,
                cancel_on_tap_outside: true,
            });

            // Render the Google Sign-In button
            // @ts-ignore
            google.accounts.id.renderButton(
                document.getElementById("google-btn-container"),
                {
                    theme: "outline",
                    size: "large",
                    width:
                        document.getElementById("google-btn-container")
                            ?.clientWidth || 350,
                    logo_alignment: "left",
                },
            );
        };

        // Check if Google script is already loaded
        // @ts-ignore
        if (typeof google !== "undefined" && google.accounts) {
            // @ts-ignore
            window.onGoogleLibraryLoad();
        }

        async function handleGoogleLogin(idToken: string) {
            try {
                // Backend expects the token in the 'code' field based on the error log
                const response = await fetch(`${API_URL}/api/users/google/`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ code: idToken }),
                });

                const resData = await response.json();
                const data = resData.data || {};
                const token =
                    data.auth_token ||
                    data.access ||
                    data.token ||
                    resData.auth_token ||
                    resData.access ||
                    resData.token;

                if (response.ok && token) {
                    localStorage.setItem("access_token", token);

                    // Set 7-day expiration
                    const expiryDate = new Date();
                    expiryDate.setDate(expiryDate.getDate() + 7);
                    localStorage.setItem(
                        "token_expiry",
                        expiryDate.toISOString(),
                    );

                    let userObj = resData.user || data.user;

                    if (!userObj) {
                        // Fetch user profile if not provided
                        try {
                            const profileResp = await fetch(
                                `${API_URL}/api/users/me/`,
                                {
                                    headers: {
                                        Authorization: `Token ${token}`,
                                    },
                                },
                            );
                            if (profileResp.ok) {
                                const profileData = await profileResp.json();
                                const userData =
                                    profileData.data || profileData;

                                // Handle response format: { name: "...", ... } vs { first_name: "...", last_name: "...", ... }
                                const name =
                                    userData.name ||
                                    `${userData.first_name || ""} ${userData.last_name || ""}`.trim();

                                userObj = {
                                    name: name,
                                    email: userData.email,
                                    image:
                                        userData.profile_image ||
                                        userData.image ||
                                        userData.avatar ||
                                        "",
                                    username: userData.username,
                                    is_author: userData.is_author || false,
                                    is_superuser:
                                        userData.is_superuser || false,
                                    client_type:
                                        userData.client_type || "Reader",
                                };
                            }
                        } catch (err) {
                            console.warn("Failed to fetch user profile", err);
                        }
                    }

                    if (userObj) {
                        // Normalize boolean flags from existing object if present, or default to false
                        userObj = {
                            ...userObj,
                            is_author: !!userObj.is_author,
                            is_superuser: !!userObj.is_superuser,
                            client_type: userObj.client_type || "Reader",
                        };
                        localStorage.setItem("user", JSON.stringify(userObj));
                    }

                    window.location.href = getRedirectUrl();
                } else {
                    console.error("Google login failed:", resData);
                    const errorDiv = document.getElementById("auth-error");
                    const errorMessage =
                        document.getElementById("error-message");
                    if (errorDiv) errorDiv.classList.remove("hidden");
                    if (errorMessage)
                        errorMessage.textContent =
                            resData.message || "Google login failed";
                }
            } catch (error) {
                console.error("Google login error:", error);
                const errorDiv = document.getElementById("auth-error");
                const errorMessage = document.getElementById("error-message");
                if (errorDiv) errorDiv.classList.remove("hidden");
                if (errorMessage)
                    errorMessage.textContent =
                        "An unexpected error occurred. Please try again.";
            }
        }
    });
</script>
<script src="https://accounts.google.com/gsi/client" async defer></script>

<style>
    .auth-tab-active {
        background: #171717;
        color: #ffffff;
    }

    .auth-tab-inactive {
        color: #737373;
    }

    .auth-tab-inactive:hover {
        color: #ea580c;
    }

    .dark .auth-tab-active {
        background: #f5f5f5;
        color: #0a0a0a;
    }

    .dark .auth-tab-inactive {
        color: #a3a3a3;
    }

    .dark .auth-tab-inactive:hover {
        color: #fb923c;
    }
</style>
