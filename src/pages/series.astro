---
import Layout from "../layouts/Layout.astro";
import SeriesCard from "../components/SeriesCard.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

let liveSeries = [];
let completedSeries = [];
let plannedSeries = [];
let error = null;

try {
    const [liveResponse, completedResponse] = await Promise.all([
        fetch(`${API_URL}/api/blogs/series/live-series/`),
        fetch(`${API_URL}/api/blogs/series/completed-series/`),
    ]);

    if (liveResponse.ok) {
        const liveData = await liveResponse.json();
        liveSeries = liveData.data || [];
    } else {
        console.warn(`Live series API returned ${liveResponse.status}`);
    }

    if (completedResponse.ok) {
        const completedData = await completedResponse.json();
        completedSeries = completedData.data || [];
    } else {
        console.warn(`Completed series API returned ${completedResponse.status}`);
    }
} catch (e) {
    console.error("Failed to fetch series data:", e);
    error = e instanceof Error ? e.message : String(e);
}

const seriesData = [...liveSeries, ...completedSeries, ...plannedSeries];
---

<Layout
    title="Series | TakoVibe"
    author="TakoVibe Team"
    description="Explore structured TakoVibe learning paths for developers, from foundations to practical engineering depth."
    tags={["series", "tutorials", "learning paths", "programming"]}
>
    <div class="relative min-h-screen w-full overflow-x-hidden bg-stone-50 dark:bg-neutral-950">
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div class="absolute left-0 right-0 top-0 h-[520px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"></div>
        </div>

        <div class="relative z-10 w-full">
            <header class="border-b border-neutral-200 dark:border-neutral-800">
                <div class="mx-auto max-w-5xl px-6 pb-10 pt-16">
                    <div class="mb-4 inline-flex items-center rounded-md bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-700 dark:bg-orange-950/30 dark:text-orange-300">
                        Learning paths
                    </div>
                    <h1 class="mb-3 font-display text-4xl font-bold text-neutral-900 dark:text-neutral-50 md:text-5xl">
                        Series
                    </h1>
                    <p class="max-w-xl text-lg leading-relaxed text-neutral-500 dark:text-neutral-400">
                        Structured article collections for learning a topic in order, without the noise.
                    </p>

                    <div class="mt-8 grid max-w-md grid-cols-2 gap-4">
                        <div>
                            <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-50">
                                {liveSeries.length}
                            </div>
                            <div class="text-xs font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                                Live
                            </div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-50">
                                {completedSeries.length}
                            </div>
                            <div class="text-xs font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                                Completed
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            {
                error && (
                    <section class="mx-auto max-w-5xl px-6 pt-8">
                        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
                            Unable to load live series data right now.
                        </div>
                    </section>
                )
            }

            <main class="mx-auto max-w-5xl px-6 py-10">
                {
                    liveSeries.length > 0 && (
                        <section class="mb-14">
                            <div class="mb-6 flex items-end justify-between gap-4">
                                <div>
                                    <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">
                                        Live Series
                                    </h2>
                                    <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                                        Ongoing paths with new parts added over time.
                                    </p>
                                </div>
                            </div>
                            <div class="grid gap-5 md:grid-cols-2">
                                {liveSeries.map((series) => (
                                    <SeriesCard series={series} status="live" badgeText="Live" />
                                ))}
                            </div>
                        </section>
                    )
                }

                {
                    completedSeries.length > 0 && (
                        <section class="mb-14 border-t border-neutral-200 pt-10 dark:border-neutral-800">
                            <div class="mb-6">
                                <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">
                                    Completed Series
                                </h2>
                                <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                                    Finished learning paths ready to read end to end.
                                </p>
                            </div>
                            <div class="grid gap-5 md:grid-cols-2">
                                {completedSeries.map((series) => (
                                    <SeriesCard
                                        series={series}
                                        status="completed"
                                        badgeText="Completed"
                                    />
                                ))}
                            </div>
                        </section>
                    )
                }

                {
                    plannedSeries.length > 0 && (
                        <section class="mb-14 border-t border-neutral-200 pt-10 dark:border-neutral-800">
                            <div class="mb-6">
                                <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">
                                    Coming Soon
                                </h2>
                                <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                                    Upcoming paths currently being shaped.
                                </p>
                            </div>
                            <div class="grid gap-5 md:grid-cols-2">
                                {plannedSeries.map((series) => (
                                    <SeriesCard series={series} status="planned" badgeText="Planned" />
                                ))}
                            </div>
                        </section>
                    )
                }

                {
                    seriesData.length === 0 && !error && (
                        <section class="py-20 text-center">
                            <h2 class="mb-2 text-2xl font-bold text-neutral-900 dark:text-neutral-50">
                                No series available yet
                            </h2>
                            <p class="mx-auto mb-6 max-w-md text-neutral-500 dark:text-neutral-400">
                                The structured paths are being prepared. Browse the latest articles while they land.
                            </p>
                            <a
                                href="/blog"
                                class="inline-flex rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 dark:bg-neutral-100 dark:text-neutral-950 dark:hover:bg-orange-400"
                            >
                                Browse Articles
                            </a>
                        </section>
                    )
                }

                <section class="border-t border-neutral-200 py-10 dark:border-neutral-800">
                    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">
                                Suggest a topic
                            </h2>
                            <p class="mt-1 max-w-xl text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                                Have a learning path you want TakoVibe to cover next? Send the idea over.
                            </p>
                        </div>
                        <div class="flex gap-3">
                            <a
                                href="/contact"
                                class="rounded-lg bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-700"
                            >
                                Contact Us
                            </a>
                            <a
                                href="/blog"
                                class="rounded-lg border border-neutral-200 px-5 py-2.5 text-sm font-semibold text-neutral-700 transition-colors hover:border-orange-300 hover:text-orange-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-orange-800 dark:hover:text-orange-400"
                            >
                                Browse Articles
                            </a>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>
</Layout>
