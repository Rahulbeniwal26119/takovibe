</Layout>

<script>
    // Series data and pagination configuration
    let activeSeries = [];
    let plannedSeries = [];
    
    // Safely parse JSON data
    try {
        const activeDataElement = document.querySelector('#active-series-data');
        if (activeDataElement && activeDataElement.textContent) {
            activeSeries = JSON.parse(activeDataElement.textContent);
        }
    } catch (error) {
        console.error('Failed to parse active series data:', error);
        activeSeries = [];
    }
    
    try {
        const plannedDataElement = document.querySelector('#planned-series-data');
        if (plannedDataElement && plannedDataElement.textContent) {
            plannedSeries = JSON.parse(plannedDataElement.textContent);
        }
    } catch (error) {
        console.error('Failed to parse planned series data:', error);
        plannedSeries = [];
    }
    
    const CARDS_PER_PAGE = 8;
    
    // State management
    let activeCurrentPage = 1;
    let plannedCurrentPage = 1;
    
    const activeTotalPages = Math.ceil(activeSeries.length / CARDS_PER_PAGE);
    const plannedTotalPages = Math.ceil(plannedSeries.length / CARDS_PER_PAGE);

    // Utility functions for client-side rendering
    function getDifficultyColorScheme(startLevel, endLevel) {
        const colorSchemes = {
            'beginner': 'from-amber-400 via-orange-500 to-red-500',
            'intermediate': 'from-rose-400 via-pink-500 to-purple-600', 
            'advanced': 'from-orange-500 via-red-500 to-pink-600',
            'expert': 'from-red-500 via-rose-500 to-pink-600'
        };
        
        if (startLevel === endLevel) {
            return colorSchemes[startLevel] || 'from-slate-400 to-slate-500';
        }
        
        const levels = ['beginner', 'intermediate', 'advanced', 'expert'];
        const startIndex = levels.indexOf(startLevel);
        const endIndex = levels.indexOf(endLevel);
        
        if (startIndex !== -1 && endIndex !== -1 && endIndex > startIndex) {
            if (startIndex === 0 && endIndex === levels.length - 1) {
                return 'from-blue-500 via-purple-500 via-pink-500 to-red-600';
            } else if (endIndex - startIndex === 2) {
                return colorSchemes[levels[Math.floor((startIndex + endIndex) / 2)]] || 'from-slate-400 to-slate-500';
            } else {
                return `${colorSchemes[startLevel]?.split(' ')[0]} ${colorSchemes[endLevel]?.split(' ')[2]}` || 'from-slate-400 to-slate-500';
            }
        }
        
        return 'from-slate-400 to-slate-500';
    }

    function getSeriesColorScheme(topicsCovered) {
        const topicColorMap = {
            'ai': 'from-rose-400 via-pink-500 to-purple-600',
            'machine learning': 'from-rose-400 via-pink-500 to-purple-600',
            'deep learning': 'from-rose-400 via-pink-500 to-purple-600',
            'react': 'from-amber-400 via-orange-500 to-red-500',
            'javascript': 'from-amber-400 via-orange-500 to-red-600',
            'python': 'from-orange-400 via-red-500 to-rose-500',
            'django': 'from-red-400 via-rose-500 to-pink-500',
            'system design': 'from-orange-500 via-red-500 to-pink-600',
            'algorithms': 'from-rose-400 via-pink-500 to-purple-600',
            'data structures': 'from-purple-500 via-pink-500 to-rose-500'
        };
        
        if (!topicsCovered || topicsCovered.length === 0) {
            return 'from-slate-400 to-slate-500';
        }
        
        const mainTopic = topicsCovered[0].toLowerCase();
        for (const [key, gradient] of Object.entries(topicColorMap)) {
            if (mainTopic.includes(key)) {
                return gradient;
            }
        }
        
        return 'from-orange-400 via-red-500 to-pink-500';
    }

    function getSeriesIcon(topicsCovered) {
        if (!topicsCovered || topicsCovered.length === 0) return '📚';
        
        const iconMap = {
            'ai': '🤖',
            'machine learning': '🧠', 
            'deep learning': '🔮',
            'react': '⚛️',
            'javascript': '⚡',
            'python': '🐍',
            'django': '🌿',
            'system design': '🏗️',
            'algorithms': '🧮',
            'data structures': '📊',
            'backend': '⚙️',
            'frontend': '🎨',
            'database': '🗄️'
        };
        
        const mainTopic = topicsCovered[0].toLowerCase();
        for (const [key, icon] of Object.entries(iconMap)) {
            if (mainTopic.includes(key)) return icon;
        }
        
        return '📚';
    }

    function capitalize(str) {
        return str ? str.charAt(0).toUpperCase() + str.slice(1) : '';
    }

    function formatDate(dateString) {
        if (!dateString) return 'TBD';
        
        const date = new Date(dateString);
        const now = new Date();
        const diffTime = date.getTime() - now.getTime();
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        
        if (diffDays < 0) {
            return date.toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric' 
            });
        } else if (diffDays === 0) {
            return 'Today';
        } else if (diffDays === 1) {
            return 'Tomorrow';
        } else if (diffDays <= 7) {
            return `In ${diffDays} days`;
        } else if (diffDays <= 30) {
            return `In ${Math.ceil(diffDays / 7)} weeks`;
        } else if (diffDays <= 365) {
            return `In ${Math.ceil(diffDays / 30)} months`;
        } else {
            return date.toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'short'
            });
        }
    }

