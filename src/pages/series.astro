---
import Layout from "../layouts/Layout.astro";

// Get API URL from environment
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

// Fetch series data from API
let seriesData = [];
let error = null;

try {
    const response = await fetch(`${API_URL}/api/blogs/series/`);
    if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
    }
    const data = await response.json();
    seriesData = data.results || [];
} catch (e) {
    console.error('Failed to fetch series data:', e);
    error = e.message;
    // Fallback to empty array if API fails
    seriesData = [];
}


// Separate active and planned series
const activeSeries = seriesData.filter(series => series.is_live);
const plannedSeries = seriesData.filter(series => !series.is_live);
console.log(`active ${seriesData}`)
// Calculate stats for the template
const totalActiveSeries = activeSeries.length;
const totalPlannedSeries = plannedSeries.length;

// Pagination constants
const CARDS_PER_PAGE = 8;
const activePages = Math.ceil(activeSeries.length / CARDS_PER_PAGE);
const plannedPages = Math.ceil(plannedSeries.length / CARDS_PER_PAGE);

// Helper function to get difficulty color schemes for 3D cubes
const getDifficultyColorScheme = (startLevel, endLevel) => {
    const levels = { beginner: 1, intermediate: 2, advanced: 3 };
    const start = levels[startLevel] || 1;
    const end = levels[endLevel] || 1;
    const avg = (start + end) / 2;
    
    if (avg <= 1.5) {
        return {
            gradient: 'from-amber-400 via-orange-500 to-red-500',
            bg: 'from-amber-50 to-orange-50 dark:from-amber-950/30 dark:to-orange-950/30',
            shadow: 'shadow-amber-500/25',
            glow: 'shadow-amber-500/40',
            accent: 'bg-amber-500',
            text: 'text-amber-700 dark:text-amber-300'
        };
    }
    if (avg <= 2.5) {
        return {
            gradient: 'from-rose-400 via-pink-500 to-purple-600',
            bg: 'from-rose-50 to-pink-50 dark:from-rose-950/30 dark:to-pink-950/30',
            shadow: 'shadow-rose-500/25',
            glow: 'shadow-rose-500/40',
            accent: 'bg-rose-500',
            text: 'text-rose-700 dark:text-rose-300'
        };
    }
    return {
        gradient: 'from-orange-500 via-red-500 to-pink-600',
        bg: 'from-orange-50 to-red-50 dark:from-orange-950/30 dark:to-red-950/30',
        shadow: 'shadow-orange-500/25',
        glow: 'shadow-orange-500/40',
        accent: 'bg-orange-500',
        text: 'text-orange-700 dark:text-orange-300'
    };
};

// Enhanced series icons based on topics
const getSeriesIcon = (topics = []) => {
    const topicLower = topics.join(' ').toLowerCase();
    if (topicLower.includes('ai') || topicLower.includes('machine learning') || topicLower.includes('rag')) return "🤖";
    if (topicLower.includes('django') || topicLower.includes('web')) return "🌐";
    if (topicLower.includes('system') || topicLower.includes('design')) return "🏗️";
    if (topicLower.includes('algorithm') || topicLower.includes('dsa')) return "🧠";
    if (topicLower.includes('python')) return "🐍";
    if (topicLower.includes('javascript') || topicLower.includes('react')) return "⚛️";
    if (topicLower.includes('devops') || topicLower.includes('docker')) return "⚙️";
    if (topicLower.includes('database') || topicLower.includes('sql')) return "🗄️";
    if (topicLower.includes('security')) return "🔒";
    if (topicLower.includes('performance')) return "⚡";
    return "📚";
};

// Additional vibrant color schemes for variety
const additionalColorSchemes = [
    {
        gradient: 'from-amber-400 via-orange-500 to-red-600',
        bg: 'from-amber-50 to-orange-50 dark:from-amber-950/30 dark:to-orange-950/30',
        shadow: 'shadow-amber-500/25',
        glow: 'shadow-amber-500/40',
        accent: 'bg-amber-500',
        text: 'text-amber-700 dark:text-amber-300'
    },
    {
        gradient: 'from-rose-400 via-pink-500 to-purple-600',
        bg: 'from-rose-50 to-pink-50 dark:from-rose-950/30 dark:to-pink-950/30',
        shadow: 'shadow-rose-500/25',
        glow: 'shadow-rose-500/40',
        accent: 'bg-rose-500',
        text: 'text-rose-700 dark:text-rose-300'
    },
    {
        gradient: 'from-orange-400 via-red-500 to-rose-500',
        bg: 'from-orange-50 to-red-50 dark:from-orange-950/30 dark:to-red-950/30',
        shadow: 'shadow-orange-500/25',
        glow: 'shadow-orange-500/40',
        accent: 'bg-orange-500',
        text: 'text-orange-700 dark:text-orange-300'
    },
    {
        gradient: 'from-red-400 via-rose-500 to-pink-600',
        bg: 'from-red-50 to-rose-50 dark:from-red-950/30 dark:to-rose-950/30',
        shadow: 'shadow-red-500/25',
        glow: 'shadow-red-500/40',
        accent: 'bg-red-500',
        text: 'text-red-700 dark:text-red-300'
    },
    {
        gradient: 'from-pink-400 via-rose-500 to-purple-600',
        bg: 'from-pink-50 to-rose-50 dark:from-pink-950/30 dark:to-rose-950/30',
        shadow: 'shadow-pink-500/25',
        glow: 'shadow-pink-500/40',
        accent: 'bg-pink-500',
        text: 'text-pink-700 dark:text-pink-300'
    },
    {
        gradient: 'from-yellow-400 via-orange-500 to-red-600',
        bg: 'from-yellow-50 to-orange-50 dark:from-yellow-950/30 dark:to-orange-950/30',
        shadow: 'shadow-yellow-500/25',
        glow: 'shadow-yellow-500/40',
        accent: 'bg-yellow-500',
        text: 'text-yellow-700 dark:text-yellow-300'
    }
];

// Function to get color scheme (difficulty-based or cycling through additional ones)
const getSeriesColorScheme = (series, index) => {
    const difficultyScheme = getDifficultyColorScheme(series.start_level, series.end_level);
    // For variety, sometimes use additional color schemes
    if (series.topic_covered?.length > 3 || index % 3 === 0) {
        return additionalColorSchemes[index % additionalColorSchemes.length];
    }
    return difficultyScheme;
};

// Helper function to format date
const formatDate = (dateString) => {
    return new Date(dateString).toLocaleDateString('en-US', { 
        month: 'long', 
        day: 'numeric', 
        year: 'numeric' 
    });
};

// Helper function to capitalize text
const capitalize = (text) => {
    return text.charAt(0).toUpperCase() + text.slice(1);
};
