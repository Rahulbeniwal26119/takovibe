    // Render series cubes for a specific page
    function renderSeriesCubes(seriesArray, containerId, page) {
        const container = document.getElementById(containerId);
        if (!container) return;
        
        const startIndex = (page - 1) * CARDS_PER_PAGE;
        const endIndex = startIndex + CARDS_PER_PAGE;
        const pageData = seriesArray.slice(startIndex, endIndex);
        
        if (pageData.length === 0) {
            container.innerHTML = '<div class="col-span-full text-center py-20 text-slate-500 dark:text-slate-400">No series found for this page.</div>';
            return;
        }
        
        container.innerHTML = pageData
            .map(series => createSeriesCube(series, containerId.includes('active')))
            .join('');
    }

    // Update pagination controls
    function updatePaginationControls(type, currentPage, totalPages) {
        const prevBtn = document.getElementById(`${type}-prev-btn`) as HTMLButtonElement;
        const nextBtn = document.getElementById(`${type}-next-btn`) as HTMLButtonElement;
        const currentPageEl = document.getElementById(`${type}-current-page`);
        const totalPagesEl = document.getElementById(`${type}-total-pages`);
        const controlsContainer = document.getElementById(`${type}-pagination-controls`);
        
        if (!controlsContainer) return;
        
        // Show/hide controls based on whether pagination is needed
        if (totalPages <= 1) {
            controlsContainer.style.display = 'none';
            return;
        } else {
            controlsContainer.style.display = 'flex';
        }
        
        // Update button states
        if (prevBtn) {
            prevBtn.disabled = currentPage <= 1;
            prevBtn.classList.toggle('opacity-50', currentPage <= 1);
            prevBtn.classList.toggle('cursor-not-allowed', currentPage <= 1);
        }
        
        if (nextBtn) {
            nextBtn.disabled = currentPage >= totalPages;
            nextBtn.classList.toggle('opacity-50', currentPage >= totalPages);
            nextBtn.classList.toggle('cursor-not-allowed', currentPage >= totalPages);
        }
        
        // Update page numbers
        if (currentPageEl) currentPageEl.textContent = currentPage;
        if (totalPagesEl) totalPagesEl.textContent = totalPages;
    }

    // Initialize pagination event listeners
    function initializePagination() {
        // Active series pagination
        const activePrevBtn = document.getElementById('active-prev-btn');
        const activeNextBtn = document.getElementById('active-next-btn');
        
        if (activePrevBtn) {
            activePrevBtn.addEventListener('click', () => {
                if (activeCurrentPage > 1) {
                    activeCurrentPage--;
                    renderSeriesCubes(activeSeries, 'active-series-container', activeCurrentPage);
                    updatePaginationControls('active', activeCurrentPage, activeTotalPages);
                }
            });
        }
        
        if (activeNextBtn) {
            activeNextBtn.addEventListener('click', () => {
                if (activeCurrentPage < activeTotalPages) {
                    activeCurrentPage++;
                    renderSeriesCubes(activeSeries, 'active-series-container', activeCurrentPage);
                    updatePaginationControls('active', activeCurrentPage, activeTotalPages);
                }
            });
        }
        
        // Planned series pagination
        const plannedPrevBtn = document.getElementById('planned-prev-btn');
        const plannedNextBtn = document.getElementById('planned-next-btn');
        
        if (plannedPrevBtn) {
            plannedPrevBtn.addEventListener('click', () => {
                if (plannedCurrentPage > 1) {
                    plannedCurrentPage--;
                    renderSeriesCubes(plannedSeries, 'planned-series-container', plannedCurrentPage);
                    updatePaginationControls('planned', plannedCurrentPage, plannedTotalPages);
                }
            });
        }
        
        if (plannedNextBtn) {
            plannedNextBtn.addEventListener('click', () => {
                if (plannedCurrentPage < plannedTotalPages) {
                    plannedCurrentPage++;
                    renderSeriesCubes(plannedSeries, 'planned-series-container', plannedCurrentPage);
                    updatePaginationControls('planned', plannedCurrentPage, plannedTotalPages);
                }
            });
        }
    }

    // Initialize the page
    function initializePage() {
        // Render initial content
        if (activeSeries.length > 0) {
            renderSeriesCubes(activeSeries, 'active-series-container', activeCurrentPage);
            updatePaginationControls('active', activeCurrentPage, activeTotalPages);
        }
        
        if (plannedSeries.length > 0) {
            renderSeriesCubes(plannedSeries, 'planned-series-container', plannedCurrentPage);
            updatePaginationControls('planned', plannedCurrentPage, plannedTotalPages);
        }
        
        // Initialize pagination
        initializePagination();
        
        // Add keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
                // Previous page for currently visible section
                if (activeSeries.length > 0 && activeCurrentPage > 1) {
                    document.getElementById('active-prev-btn')?.click();
                } else if (plannedSeries.length > 0 && plannedCurrentPage > 1) {
                    document.getElementById('planned-prev-btn')?.click();
                }
            } else if (e.key === 'ArrowRight') {
                // Next page for currently visible section
                if (activeSeries.length > 0 && activeCurrentPage < activeTotalPages) {
                    document.getElementById('active-next-btn')?.click();
                } else if (plannedSeries.length > 0 && plannedCurrentPage < plannedTotalPages) {
                    document.getElementById('planned-next-btn')?.click();
                }
            }
        });
    }

    // Start when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializePage);
    } else {
        initializePage();
    }
</script>

<!-- Hidden data for JavaScript -->
<script type="application/json" id="active-series-data" set:html={JSON.stringify(activeSeries)}></script>
<script type="application/json" id="planned-series-data" set:html={JSON.stringify(plannedSeries)}></script>

