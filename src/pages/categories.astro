---
import Layout from "../layouts/Layout.astro";

// API configuration
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

// Interface for API response
interface TagsStatsResponse {
  message: string;
  code: number;
  data: Record<string, number>;
}

// Fetch tags statistics from API
let tagsData: Record<string, number> = {};
let totalCategories = 0;
let totalArticles = 0;

try {
  const response = await fetch(`${API_URL}/api/blogs/tags/`);
  if (response.ok) {
    const result: TagsStatsResponse = await response.json();
    if (result.code === 0 && result.data) {
      tagsData = result.data;
      totalCategories = Object.keys(tagsData).length;
      totalArticles = Object.values(tagsData).reduce((sum, count) => sum + count, 0);
    }
  }
} catch (error) {
  console.error("Error fetching tags data:", error);
  // Keep empty object as fallback
}

// Convert tags data to sorted array for easier processing
const categoriesData = Object.entries(tagsData)
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => {
    if (b.count !== a.count) {
      return b.count - a.count;
    }
    return a.tag.localeCompare(b.tag);
  });

// Enhanced category icons with more mappings
const categoryIcons = {
  'sample': '📝',
  'blog': '✍️',
  'python': '🐍',
  'javascript': '⚡',
  'typescript': '🔷',
  'react': '⚛️',
  'django': '🎸',
  'database': '🗄️',
  'devops': '⚙️',
  'nginx': '🌐',
  'docker': '🐳',
  'tutorial': '📚',
  'programming': '💻',
  'web development': '🌍',
  'backend': '🔧',
  'frontend': '🎨',
  'performance': '⚡',
  'security': '🔒',
  'testing': '🧪',
  'api': '🔌',
  'microservices': '🏗️',
  'machine learning': '🤖',
  'data science': '📊',
  'algorithms': '🧮',
  'system design': '🏛️',
  'tips': '💡',
  'guide': '📖',
  'best practices': '✨'
};

const getCategoryIcon = (tag: string) => categoryIcons[tag.toLowerCase()] || '📝';

// Enhanced color schemes for 3D cubes with more playful colors
const categoryColorSchemes = [
  {
    gradient: 'from-blue-500 to-cyan-400',
    bg: 'from-blue-50 to-cyan-50 dark:from-blue-950/30 dark:to-cyan-950/30',
    shadow: 'shadow-blue-500/25',
    glow: 'shadow-blue-500/40',
    accent: 'bg-blue-500',
    text: 'text-blue-700 dark:text-blue-300'
  },
  {
    gradient: 'from-purple-500 to-pink-400',
    bg: 'from-purple-50 to-pink-50 dark:from-purple-950/30 dark:to-pink-950/30',
    shadow: 'shadow-purple-500/25',
    glow: 'shadow-purple-500/40',
    accent: 'bg-purple-500',
    text: 'text-purple-700 dark:text-purple-300'
  },
  {
    gradient: 'from-emerald-500 to-teal-400',
    bg: 'from-emerald-50 to-teal-50 dark:from-emerald-950/30 dark:to-teal-950/30',
    shadow: 'shadow-emerald-500/25',
    glow: 'shadow-emerald-500/40',
    accent: 'bg-emerald-500',
    text: 'text-emerald-700 dark:text-emerald-300'
  },
  {
    gradient: 'from-orange-500 to-red-400',
    bg: 'from-orange-50 to-red-50 dark:from-orange-950/30 dark:to-red-950/30',
    shadow: 'shadow-orange-500/25',
    glow: 'shadow-orange-500/40',
    accent: 'bg-orange-500',
    text: 'text-orange-700 dark:text-orange-300'
  },
  {
    gradient: 'from-indigo-500 to-purple-400',
    bg: 'from-indigo-50 to-purple-50 dark:from-indigo-950/30 dark:to-purple-950/30',
    shadow: 'shadow-indigo-500/25',
    glow: 'shadow-indigo-500/40',
    accent: 'bg-indigo-500',
    text: 'text-indigo-700 dark:text-indigo-300'
  },
  {
    gradient: 'from-pink-500 to-rose-400',
    bg: 'from-pink-50 to-rose-50 dark:from-pink-950/30 dark:to-rose-950/30',
    shadow: 'shadow-pink-500/25',
    glow: 'shadow-pink-500/40',
    accent: 'bg-pink-500',
    text: 'text-pink-700 dark:text-pink-300'
  },
  {
    gradient: 'from-yellow-500 to-amber-400',
    bg: 'from-yellow-50 to-amber-50 dark:from-yellow-950/30 dark:to-amber-950/30',
    shadow: 'shadow-yellow-500/25',
    glow: 'shadow-yellow-500/40',
    accent: 'bg-yellow-500',
    text: 'text-yellow-700 dark:text-yellow-300'
  },
  {
    gradient: 'from-lime-500 to-green-400',
    bg: 'from-lime-50 to-green-50 dark:from-lime-950/30 dark:to-green-950/30',
    shadow: 'shadow-lime-500/25',
    glow: 'shadow-lime-500/40',
    accent: 'bg-lime-500',
    text: 'text-lime-700 dark:text-lime-300'
  }
];

const getCategoryColorScheme = (index: number) => categoryColorSchemes[index % categoryColorSchemes.length];

// Pagination constants
const CATEGORIES_PER_PAGE = 12; // Show more cubes per page
const totalPages = Math.ceil(categoriesData.length / CATEGORIES_PER_PAGE);
---

<Layout
    title="Categories | TakoVibe - Explore Topic Collections"
    author="TakoVibe Team"
    description="Discover our comprehensive collection of technical articles organized by topic. Each category contains curated guides, tutorials, and insights designed to help you master modern software development."
    tags={["categories", "blog topics", "programming", "technology", "software engineering", "tutorials"]}
>
    <div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50/30 to-purple-50/30 dark:from-slate-900 dark:via-blue-950/30 dark:to-purple-950/30">
        
        <!-- Enhanced Hero Section -->
        <section class="relative overflow-hidden pt-24 pb-16 px-4 sm:px-6">
            <!-- Background effects -->
            <div class="absolute inset-0">
                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-gradient-to-r from-blue-400/8 to-purple-400/8 rounded-full blur-3xl animate-pulse"></div>
                <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-gradient-to-r from-purple-400/8 to-pink-400/8 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s"></div>
            </div>
            
            <div class="max-w-6xl mx-auto text-center relative z-10">
                <!-- Header badge -->
                <div class="inline-flex items-center gap-3 px-6 py-3 bg-white/90 dark:bg-slate-800/90 backdrop-blur-sm text-slate-700 dark:text-slate-300 rounded-full text-sm font-medium mb-8 border border-slate-200/80 dark:border-slate-700/80 shadow-sm">
                    <div class="relative">
                        <span class="text-lg">📚</span>
                        <div class="absolute -inset-1 bg-gradient-to-r from-blue-500/20 to-purple-500/20 rounded-full blur-sm"></div>
                    </div>
                    <span class="font-semibold">Topic Collections</span>
                </div>
                
                <!-- Main heading -->
                <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-slate-900 dark:text-slate-100 mb-6 leading-tight">
                    <span class="bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">
                        Topic
                    </span>
                    <br class="hidden sm:block" />
                    <span class="text-slate-800 dark:text-slate-200 font-light">Collections</span>
                </h1>
                
                <!-- Description -->
                <p class="text-xl sm:text-2xl text-slate-600 dark:text-slate-400 max-w-4xl mx-auto leading-relaxed font-light mb-8">
                    Explore our curated collection of technical articles organized by topic. Each 
                    category contains comprehensive guides, tutorials, and insights designed to 
                    help you master modern software development.
                </p>
                
                <!-- Stats -->
                <!-- <div class="flex flex-wrap items-center justify-center gap-6 text-slate-500 dark:text-slate-400">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                        <span class="font-medium">{totalCategories}</span>
                        <span>categories</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 bg-purple-500 rounded-full"></div>
                        <span class="font-medium">{totalArticles}</span>
                        <span>total articles</span>
                    </div>
                </div> -->
            </div>
        </section>

        <!-- Categories Container -->
        <section class="relative px-4 sm:px-6 pb-20">
            <div class="max-w-7xl mx-auto">
                
                <!-- Playful intro text -->
                <div class="text-center mb-12">
                    <div class="inline-flex items-center gap-3 px-6 py-3 bg-gradient-to-r from-purple-100 to-pink-100 dark:from-purple-900/30 dark:to-pink-900/30 rounded-full mb-6">
                        <span class="text-2xl animate-bounce">🎯</span>
                        <span class="font-semibold text-purple-700 dark:text-purple-300">Discover Topics</span>
                    </div>
                    <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                        Click on any cube to explore articles in that category. Each cube shows how many awesome articles await you!
                    </p>
                </div>
                
                <!-- 3D Categories Grid -->
                <div id="categories-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
                    <!-- Categories cubes will be populated here -->
                </div>
                
                <!-- Pagination Controls -->
                <div id="pagination-controls" class="flex items-center justify-center gap-4 mt-16" style="display: none;">
                    <button id="prev-btn" class="group relative inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-500 text-white font-semibold rounded-xl hover:from-blue-600 hover:to-purple-600 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-105 shadow-lg hover:shadow-xl">
                        <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        Previous
                    </button>
                    
                    <div class="flex items-center gap-3 px-6 py-3 bg-white/90 dark:bg-slate-800/90 backdrop-blur-sm rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg">
                        <span class="text-slate-600 dark:text-slate-400">Page</span>
                        <span id="current-page" class="px-3 py-2 bg-gradient-to-r from-blue-500 to-purple-500 text-white rounded-lg font-bold min-w-[2rem] text-center">1</span>
                        <span class="text-slate-600 dark:text-slate-400">of</span>
                        <span id="total-pages" class="font-bold text-slate-900 dark:text-slate-100">{totalPages}</span>
                    </div>
                    
                    <button id="next-btn" class="group relative inline-flex items-center px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-semibold rounded-xl hover:from-purple-600 hover:to-pink-600 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-105 shadow-lg hover:shadow-xl">
                        Next
                        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                </div>

                <!-- Fun CTA Section -->
                <div class="mt-20 text-center">
                    <div class="relative inline-block">
                        <!-- Animated background -->
                        <div class="absolute -inset-4 bg-gradient-to-r from-pink-400 via-purple-400 to-blue-400 opacity-20 blur-xl rounded-3xl animate-pulse"></div>
                        
                        <div class="relative p-10 bg-gradient-to-br from-white/95 to-slate-50/95 dark:from-slate-800/95 dark:to-slate-900/95 backdrop-blur-sm rounded-3xl border border-slate-200/50 dark:border-slate-700/50 shadow-2xl">
                            <div class="flex items-center justify-center gap-3 mb-6">
                                <!-- <span class="text-4xl animate-bounce" style="animation-delay: 0s">�</span> -->
                                <span class="text-4xl animate-bounce" style="animation-delay: 0.2s">📖</span>
                                <span class="text-4xl animate-bounce" style="animation-delay: 0.4s">✨</span>
                            </div>
                            
                            <h3 class="text-3xl font-bold mb-4 bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                                Ready to Dive Deeper?
                            </h3>
                            <p class="text-slate-600 dark:text-slate-400 mb-8 max-w-lg mx-auto text-lg">
                                Explore all our articles with advanced search and filtering. Find exactly what you're looking for!
                            </p>
                            
                            <a href="/blog" class="group relative inline-flex items-center gap-4 px-8 py-4 bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 hover:from-purple-700 hover:via-pink-700 hover:to-blue-700 text-white font-bold text-lg rounded-2xl shadow-2xl hover:shadow-purple-500/25 transition-all duration-300 transform hover:scale-105 hover:-translate-y-1">
                                <span>Explore All Articles</span>
                                <div class="relative">
                                    <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                    </svg>
                                    <div class="absolute -inset-2 bg-white/20 rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-ping"></div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</Layout>

<script define:vars={{ categoriesData, totalPages, CATEGORIES_PER_PAGE }}>
    // State management
    let currentPage = 1;
    
    // DOM elements
    const categoriesContainer = document.getElementById('categories-container');
    const paginationControls = document.getElementById('pagination-controls');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const currentPageSpan = document.getElementById('current-page');
    
    // Enhanced category icons with more fun options
    function getCategoryIcon(tag) {
        const icons = {
            'sample': '📝',
            'blog': '✍️',
            'python': '🐍',
            'javascript': '⚡',
            'typescript': '🔷',
            'react': '⚛️',
            'django': '🎸',
            'database': '🗄️',
            'devops': '⚙️',
            'nginx': '🌐',
            'docker': '🐳',
            'tutorial': '📚',
            'programming': '💻',
            'web development': '🌍',
            'backend': '🔧',
            'frontend': '🎨',
            'performance': '⚡',
            'security': '🔒',
            'testing': '🧪',
            'api': '🔌',
            'microservices': '🏗️',
            'machine learning': '🤖',
            'data science': '📊',
            'algorithms': '🧮',
            'system design': '🏛️',
            'tips': '💡',
            'guide': '📖',
            'best practices': '✨'
        };
        return icons[tag.toLowerCase()] || '🎯';
    }
    
    // Playful 3D color schemes
    function getCategoryColorScheme(index) {
        const schemes = [
            {
                gradient: 'from-blue-500 to-cyan-400',
                bg: 'from-blue-50 to-cyan-50 dark:from-blue-950/30 dark:to-cyan-950/30',
                shadow: 'shadow-blue-500/25',
                glow: 'shadow-blue-500/40',
                accent: 'bg-blue-500',
                text: 'text-blue-700 dark:text-blue-300'
            },
            {
                gradient: 'from-purple-500 to-pink-400',
                bg: 'from-purple-50 to-pink-50 dark:from-purple-950/30 dark:to-pink-950/30',
                shadow: 'shadow-purple-500/25',
                glow: 'shadow-purple-500/40',
                accent: 'bg-purple-500',
                text: 'text-purple-700 dark:text-purple-300'
            },
            {
                gradient: 'from-emerald-500 to-teal-400',
                bg: 'from-emerald-50 to-teal-50 dark:from-emerald-950/30 dark:to-teal-950/30',
                shadow: 'shadow-emerald-500/25',
                glow: 'shadow-emerald-500/40',
                accent: 'bg-emerald-500',
                text: 'text-emerald-700 dark:text-emerald-300'
            },
            {
                gradient: 'from-orange-500 to-red-400',
                bg: 'from-orange-50 to-red-50 dark:from-orange-950/30 dark:to-red-950/30',
                shadow: 'shadow-orange-500/25',
                glow: 'shadow-orange-500/40',
                accent: 'bg-orange-500',
                text: 'text-orange-700 dark:text-orange-300'
            },
            {
                gradient: 'from-indigo-500 to-purple-400',
                bg: 'from-indigo-50 to-purple-50 dark:from-indigo-950/30 dark:to-purple-950/30',
                shadow: 'shadow-indigo-500/25',
                glow: 'shadow-indigo-500/40',
                accent: 'bg-indigo-500',
                text: 'text-indigo-700 dark:text-indigo-300'
            },
            {
                gradient: 'from-pink-500 to-rose-400',
                bg: 'from-pink-50 to-rose-50 dark:from-pink-950/30 dark:to-rose-950/30',
                shadow: 'shadow-pink-500/25',
                glow: 'shadow-pink-500/40',
                accent: 'bg-pink-500',
                text: 'text-pink-700 dark:text-pink-300'
            },
            {
                gradient: 'from-yellow-500 to-amber-400',
                bg: 'from-yellow-50 to-amber-50 dark:from-yellow-950/30 dark:to-amber-950/30',
                shadow: 'shadow-yellow-500/25',
                glow: 'shadow-yellow-500/40',
                accent: 'bg-yellow-500',
                text: 'text-yellow-700 dark:text-yellow-300'
            },
            {
                gradient: 'from-lime-500 to-green-400',
                bg: 'from-lime-50 to-green-50 dark:from-lime-950/30 dark:to-green-950/30',
                shadow: 'shadow-lime-500/25',
                glow: 'shadow-lime-500/40',
                accent: 'bg-lime-500',
                text: 'text-lime-700 dark:text-lime-300'
            }
        ];
        return schemes[index % schemes.length];
    }
    
    // Create magical 3D cube for each category
    function createCategoryCube(category, index) {
        const scheme = getCategoryColorScheme(index);
        const icon = getCategoryIcon(category.tag);
        const categoryName = category.tag.replace(/[-_]/g, ' ');
        
        return `
            <a href="/blog?category=${encodeURIComponent(category.tag)}" 
               class="category-cube group relative block transform-gpu transition-all duration-500 hover:scale-110 hover:-rotate-y-12 animate-fade-up"
               style="animation-delay: ${index * 0.1}s; perspective: 1000px;">
                
                <!-- 3D Cube Container -->
                <div class="relative w-full h-32 sm:h-36 preserve-3d transition-all duration-700 group-hover:rotate-y-12">
                    
                    <!-- Cube Face - Front -->
                    <div class="absolute inset-0 bg-gradient-to-br ${scheme.bg} backdrop-blur-sm rounded-2xl border border-white/20 dark:border-white/10 ${scheme.shadow} group-hover:${scheme.glow} transition-all duration-500 transform-gpu">
                        
                        <!-- Hover glow effect -->
                        <div class="absolute -inset-2 bg-gradient-to-r ${scheme.gradient} opacity-0 group-hover:opacity-30 rounded-3xl blur-xl transition-all duration-500"></div>
                        
                        <!-- Content -->
                        <div class="relative h-full flex flex-col items-center justify-center p-4 text-center">
                            
                            <!-- Icon with bounce animation -->
                            <div class="text-3xl sm:text-4xl mb-2 group-hover:animate-bounce transition-all duration-300 filter drop-shadow-lg">
                                ${icon}
                            </div>
                            
                            <!-- Category name -->
                            <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 capitalize mb-1 leading-tight">
                                ${categoryName}
                            </h3>
                            
                            <!-- Article count with pulsing badge -->
                            <div class="relative">
                                <div class="px-3 py-1 bg-gradient-to-r ${scheme.gradient} text-white text-xs font-bold rounded-full ${scheme.shadow} group-hover:animate-pulse">
                                    ${category.count} article${category.count !== 1 ? 's' : ''}
                                </div>
                                
                                <!-- Sparkle effect on hover -->
                                <div class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-ping transition-all duration-300"></div>
                                <div class="absolute -bottom-1 -left-1 w-1.5 h-1.5 bg-white rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-ping transition-all duration-300" style="animation-delay: 0.2s"></div>
                            </div>
                        </div>
                        
                        <!-- Corner decoration -->
                        <div class="absolute top-2 right-2 w-2 h-2 bg-gradient-to-br ${scheme.gradient} rounded-full opacity-60 group-hover:opacity-100 transition-opacity"></div>
                        <div class="absolute bottom-2 left-2 w-1.5 h-1.5 bg-gradient-to-br ${scheme.gradient} rounded-full opacity-40 group-hover:opacity-80 transition-opacity"></div>
                    </div>
                    
                    <!-- Cube Face - Right (3D effect) -->
                    <div class="absolute inset-0 bg-gradient-to-br ${scheme.gradient} opacity-20 rounded-2xl transform-gpu translate-x-1 translate-y-1 -z-10 transition-all duration-500 group-hover:translate-x-2 group-hover:translate-y-2"></div>
                </div>
                
                <!-- Floating particles effect -->
                <div class="absolute inset-0 pointer-events-none">
                    <div class="absolute top-1/4 left-1/4 w-1 h-1 bg-white rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-float transition-all duration-500"></div>
                    <div class="absolute top-3/4 right-1/4 w-0.5 h-0.5 bg-white rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-float transition-all duration-500" style="animation-delay: 0.3s"></div>
                    <div class="absolute top-1/2 right-1/3 w-1.5 h-1.5 bg-white rounded-full opacity-0 group-hover:opacity-100 group-hover:animate-float transition-all duration-500" style="animation-delay: 0.6s"></div>
                </div>
            </a>
        `;
    }
    
    // Render categories page with 3D cubes
    function renderCategoriesPage(page) {
        const startIndex = (page - 1) * CATEGORIES_PER_PAGE;
        const endIndex = startIndex + CATEGORIES_PER_PAGE;
        const pageCategories = categoriesData.slice(startIndex, endIndex);
        
        if (pageCategories.length === 0) {
            categoriesContainer.innerHTML = `
                <div class="col-span-full text-center py-20">
                    <div class="inline-block">
                        <div class="text-8xl mb-6 animate-bounce">🎲</div>
                        <h3 class="text-3xl font-bold text-slate-900 dark:text-slate-100 mb-4">No Categories Yet!</h3>
                        <p class="text-xl text-slate-600 dark:text-slate-400 max-w-md mx-auto">
                            The cubes will appear here once we publish some awesome articles. Stay tuned!
                        </p>
                    </div>
                </div>
            `;
            return;
        }
        
        categoriesContainer.innerHTML = pageCategories.map((category, index) => {
            const globalIndex = startIndex + index;
            return createCategoryCube(category, globalIndex);
        }).join('');
    }
    
    // Update pagination controls with fun styling
    function updatePaginationControls() {
        if (totalPages <= 1) {
            paginationControls.style.display = 'none';
            return;
        }
        
        paginationControls.style.display = 'flex';
        currentPageSpan.textContent = currentPage;
        
        prevBtn.disabled = currentPage === 1;
        nextBtn.disabled = currentPage === totalPages;
    }
    
    // Navigate to page with smooth animations
    function goToPage(page) {
        if (page < 1 || page > totalPages) return;
        
        // Add exit animation
        document.querySelectorAll('.category-cube').forEach((cube, index) => {
            cube.style.animationDelay = `${index * 0.05}s`;
            cube.classList.add('animate-fade-out');
        });
        
        // Update page after animation
        setTimeout(() => {
            currentPage = page;
            renderCategoriesPage(currentPage);
            updatePaginationControls();
            
            // Scroll to top smoothly
            categoriesContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 300);
    }
    
    // Add some fun interactions
    function addInteractivity() {
        // Add hover sound effect (visual feedback)
        document.addEventListener('mouseover', (e) => {
            if (e.target.closest('.category-cube')) {
                const cube = e.target.closest('.category-cube');
                cube.style.transform = `scale(1.05) rotateY(5deg) rotateX(2deg)`;
            }
        });
        
        document.addEventListener('mouseout', (e) => {
            if (e.target.closest('.category-cube')) {
                const cube = e.target.closest('.category-cube');
                cube.style.transform = '';
            }
        });
    }
    
    // Initialize the awesome cube interface
    function init() {
        renderCategoriesPage(currentPage);
        updatePaginationControls();
        addInteractivity();
        
        // Event listeners for pagination
        prevBtn.addEventListener('click', () => goToPage(currentPage - 1));
        nextBtn.addEventListener('click', () => goToPage(currentPage + 1));
    }
    
    // Start the magic when DOM is ready
    document.addEventListener('DOMContentLoaded', init);
</script>

