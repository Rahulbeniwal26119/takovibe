<script define:vars={{ allTags, topicRelationships, colorPalette }}>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('network-graph');
        if (!container || allTags.length === 0) return;

        const width = container.clientWidth;
        const height = 800;

        // Calculate node sizes based on article count (oval shapes)
        const maxCount = Math.max(...allTags.map(t => t.count));
        const minCount = Math.min(...allTags.map(t => t.count));
        
        const getNodeSize = (count) => {
            const normalized = (count - minCount) / (maxCount - minCount || 1);
            return {
                rx: 50 + (normalized * 60), // 50-110px horizontal radius
                ry: 30 + (normalized * 25)  // 30-55px vertical radius
            };
        };

        // Create nodes
        const nodes = allTags.map((item, i) => {
            const size = getNodeSize(item.count);
            return {
                id: item.tag,
                count: item.count,
                x: 0,
                y: 0,
                vx: 0,
                vy: 0,
                rx: size.rx,
                ry: size.ry,
                color: colorPalette[i % colorPalette.length]
            };
        });

        // Create edges
        const edges = [];
        allTags.forEach(item => {
            const related = topicRelationships[item.tag.toLowerCase()] || [];
            related.forEach(relatedTag => {
                if (allTags.some(t => t.tag.toLowerCase() === relatedTag)) {
                    edges.push({
                        source: item.tag,
                        target: relatedTag
                    });
                }
            });
        });

        // Force simulation
        function runSimulation() {
            const centerX = width / 2;
            const centerY = height / 2;
            
            // Initialize in circle
            nodes.forEach((node, i) => {
                const angle = (i / nodes.length) * 2 * Math.PI;
                const radius = Math.min(width, height) * 0.35;
                node.x = centerX + radius * Math.cos(angle);
                node.y = centerY + radius * Math.sin(angle);
            });

            // Run simulation
            for (let iter = 0; iter < 200; iter++) {
                // Repulsion
                for (let i = 0; i < nodes.length; i++) {
                    for (let j = i + 1; j < nodes.length; j++) {
                        const dx = nodes[j].x - nodes[i].x;
                        const dy = nodes[j].y - nodes[i].y;
                        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
                        const minDist = nodes[i].rx + nodes[j].rx + 40;
                        
                        if (dist < minDist * 1.5) {
                            const force = (minDist - dist) * 0.6;
                            nodes[i].vx -= (dx / dist) * force;
                            nodes[i].vy -= (dy / dist) * force;
                            nodes[j].vx += (dx / dist) * force;
                            nodes[j].vy += (dy / dist) * force;
                        }
                    }
                }

                // Attraction along edges
                edges.forEach(edge => {
                    const source = nodes.find(n => n.id === edge.source);
                    const target = nodes.find(n => n.id.toLowerCase() === edge.target);
                    if (source && target) {
                        const dx = target.x - source.x;
                        const dy = target.y - source.y;
                        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
                        const force = dist * 0.001;
                        source.vx += (dx / dist) * force;
                        source.vy += (dy / dist) * force;
                        target.vx -= (dx / dist) * force;
                        target.vy -= (dy / dist) * force;
                    }
                });

                // Center gravity
                nodes.forEach(node => {
                    node.vx += (centerX - node.x) * 0.002;
                    node.vy += (centerY - node.y) * 0.002;
                });

                // Update positions
                nodes.forEach(node => {
                    node.x += node.vx;
                    node.y += node.vy;
                    node.vx *= 0.85;
                    node.vy *= 0.85;

                    // Boundaries
                    node.x = Math.max(node.rx + 20, Math.min(width - node.rx - 20, node.x));
                    node.y = Math.max(node.ry + 20, Math.min(height - node.ry - 20, node.y));
                });
            }
        }

        runSimulation();

        // Create SVG
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('width', width);
        svg.setAttribute('height', height);
        svg.style.width = '100%';
        svg.style.height = '100%';

        // Define arrow marker
        const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
        const marker = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
        marker.setAttribute('id', 'arrowhead');
        marker.setAttribute('markerWidth', '10');
        marker.setAttribute('markerHeight', '10');
        marker.setAttribute('refX', '9');
        marker.setAttribute('refY', '3');
        marker.setAttribute('orient', 'auto');
        const arrowPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        arrowPath.setAttribute('d', 'M0,0 L0,6 L9,3 z');
        arrowPath.setAttribute('fill', '#94a3b8');
        marker.appendChild(arrowPath);
        defs.appendChild(marker);
        svg.appendChild(defs);

        // Draw curved edges with arrows
        edges.forEach(edge => {
            const source = nodes.find(n => n.id === edge.source);
            const target = nodes.find(n => n.id.toLowerCase() === edge.target);
            if (source && target) {
                // Calculate curve control point
                const midX = (source.x + target.x) / 2;
                const midY = (source.y + target.y) / 2;
                const dx = target.x - source.x;
                const dy = target.y - source.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                const curve = dist * 0.2;
                const controlX = midX - dy / dist * curve;
                const controlY = midY + dx / dist * curve;

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', `M${source.x},${source.y} Q${controlX},${controlY} ${target.x},${target.y}`);
                path.setAttribute('stroke', '#CBD5E1');
                path.setAttribute('stroke-width', '2');
                path.setAttribute('fill', 'none');
                path.setAttribute('opacity', '0.4');
                path.setAttribute('marker-end', 'url(#arrowhead)');
                path.setAttribute('class', `edge edge-${source.id.replace(/\s+/g, '-')} edge-${target.id.replace(/\s+/g, '-')}`);
                path.style.transition = 'all 0.3s';
                svg.appendChild(path);
            }
        });

        // Draw nodes (ovals)
        nodes.forEach(node => {
            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            g.setAttribute('class', `node node-${node.id.replace(/\s+/g, '-')}`);
            g.setAttribute('transform', `translate(${node.x}, ${node.y})`);
            g.style.cursor = 'pointer';
            g.style.transition = 'all 0.3s';

            // Detect dark mode
            const isDark = document.documentElement.classList.contains('dark');

            // Oval shape
            const ellipse = document.createElementNS('http://www.w3.org/2000/svg', 'ellipse');
            ellipse.setAttribute('rx', node.rx);
            ellipse.setAttribute('ry', node.ry);
            ellipse.setAttribute('fill', isDark ? '#1F2937' : node.color.fill);
            ellipse.setAttribute('stroke', node.color.stroke);
            ellipse.setAttribute('stroke-width', '2.5');
            g.appendChild(ellipse);

            // Topic name
            const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('dy', '0.35em');
            text.setAttribute('font-size', '15');
            text.setAttribute('font-weight', '600');
            text.setAttribute('fill', isDark ? '#FFFFFF' : node.color.text);
            text.textContent = node.id.replace(/[-_]/g, ' ');
            text.style.textTransform = 'capitalize';
            text.style.pointerEvents = 'none';
            g.appendChild(text);

            // Hover effects
            g.addEventListener('mouseenter', () => {
                g.style.transform = `translate(${node.x}px, ${node.y}px) scale(1.15)`;
                g.style.zIndex = '100';
                ellipse.setAttribute('stroke-width', '3.5');
                ellipse.style.filter = 'drop-shadow(0 10px 25px rgba(0,0,0,0.2))';

                // Highlight edges
                const related = topicRelationships[node.id.toLowerCase()] || [];
                related.forEach(tag => {
                    const edgeClass = `edge-${node.id.replace(/\s+/g, '-')}`;
                    const edges = svg.querySelectorAll(`.${edgeClass}`);
                    edges.forEach(edge => {
                        edge.setAttribute('stroke', node.color.stroke);
                        edge.setAttribute('stroke-width', '3');
                        edge.setAttribute('opacity', '0.8');
                    });
                });
            });

            g.addEventListener('mouseleave', () => {
                g.style.transform = `translate(${node.x}px, ${node.y}px) scale(1)`;
                g.style.zIndex = '1';
                ellipse.setAttribute('stroke-width', '2.5');
                ellipse.style.filter = '';

                // Reset edges
                svg.querySelectorAll('.edge').forEach(edge => {
                    edge.setAttribute('stroke', '#CBD5E1');
                    edge.setAttribute('stroke-width', '2');
                    edge.setAttribute('opacity', '0.4');
                });
            });

            g.addEventListener('click', () => {
                window.location.href = `/blog?category=${encodeURIComponent(node.id)}`;
            });

            svg.appendChild(g);
        });

        container.appendChild(svg);
    });
</script>

<style>
    @keyframes blob {
        0%, 100% { transform: translate(0px, 0px) scale(1); }
        33% { transform: translate(30px, -50px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
    }
    .animate-blob { animation: blob 7s infinite; }
    .animation-delay-2000 { animation-delay: 2s; }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
    }
    .animation-delay-200 { animation-delay: 0.2s; }
    .animation-delay-400 { animation-delay: 0.4s; }
    .animation-delay-600 { animation-delay: 0.6s; }

    @keyframes gradient {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }
    .animate-gradient {
        background-size: 200% auto;
        animation: gradient 4s linear infinite;
    }

    /* Ensure hover nodes appear on top */
    .node {
        position: relative;
        z-index: 1;
    }
</style>