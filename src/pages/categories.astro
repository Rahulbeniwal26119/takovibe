---
import Layout from "../layouts/Layout.astro";

// API configuration
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

// Fetch tags statistics from API
let tagsData: Record<string, number> = {};

try {
  const response = await fetch(`${API_URL}/api/blogs/tags/`);
  if (response.ok) {
    const result = await response.json();
    if (result.code === 0 && result.data) {
      tagsData = result.data;
    }
  }
} catch (error) {
  console.error("Error fetching tags data:", error);
}

// Convert to array, sort, and limit to top 25 for clarity
const allTags = Object.entries(tagsData)
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 25);

// Fetch articles to detect tag relationships automatically
let topicRelationships: Record<string, string[]> = {};

try {
  const articlesResponse = await fetch(`${API_URL}/api/blogs/blogs/?page_size=100`);
  if (articlesResponse.ok) {
    const articlesData = await articlesResponse.json();
    const articles = articlesData.results || [];
    
    // Build co-occurrence map
    const coOccurrence: Record<string, Record<string, number>> = {};
    
    articles.forEach((article: any) => {
      const tags = article.tags || [];
      // For each pair of tags in the article
      for (let i = 0; i < tags.length; i++) {
        const tag1 = tags[i].toLowerCase();
        if (!allTags.some(t => t.tag.toLowerCase() === tag1)) continue;
        
        if (!coOccurrence[tag1]) coOccurrence[tag1] = {};
        
        for (let j = 0; j < tags.length; j++) {
          if (i === j) continue;
          const tag2 = tags[j].toLowerCase();
          if (!allTags.some(t => t.tag.toLowerCase() === tag2)) continue;
          
          coOccurrence[tag1][tag2] = (coOccurrence[tag1][tag2] || 0) + 1;
        }
      }
    });
    
    // Convert to relationships (keep top 5 most related tags for each)
    Object.keys(coOccurrence).forEach(tag => {
      const related = Object.entries(coOccurrence[tag])
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5)
        .map(([relatedTag]) => relatedTag);
      topicRelationships[tag] = related;
    });
  }
} catch (error) {
  console.error("Failed to fetch articles for relationships:", error);
}

// Soft pastel color palette (inspired by the image)
const colorPalette = [
  { fill: '#FFE5D9', stroke: '#D4A59A', text: '#5D4037' }, // Peachy
  { fill: '#FFF9C4', stroke: '#D4C157', text: '#5D4037' }, // Light yellow
  { fill: '#E1F5DD', stroke: '#A5D6A7', text: '#2E7D32' }, // Mint green
  { fill: '#E3F2FD', stroke: '#90CAF9', text: '#1565C0' }, // Light blue
  { fill: '#F3E5F5', stroke: '#CE93D8', text: '#6A1B9A' }, // Lavender
  { fill: '#FFF3E0', stroke: '#FFCC80', text: '#E65100' }, // Light orange
  { fill: '#FCE4EC', stroke: '#F48FB1', text: '#C2185B' }, // Light pink
  { fill: '#E8F5E9', stroke: '#A5D6A7', text: '#2E7D32' }, // Pale green
];
---

