---
import Layout from "../layouts/Layout.astro";
import StandalonePlaygroundHydrator from "../components/StandalonePlaygroundHydrator";
---

<Layout
    title="TakoVibe Playground – Run & Share Code Instantly"
    description="Write, run, and share code snippets in Python, JavaScript, Go, Rust and more. Embed interactive playgrounds in your blog or share a direct link."
    no_footer={true}
>
    <div class="relative min-h-screen overflow-x-hidden bg-stone-50 dark:bg-neutral-950">
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div class="absolute left-0 right-0 top-0 h-[520px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"></div>
        </div>

        <div class="relative z-10 flex min-h-screen flex-col">
            <div class="border-b border-neutral-200 dark:border-neutral-800">
                <div class="mx-auto max-w-6xl px-6 pt-16 pb-10">
                    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                        <div>
                            <h1 class="text-4xl md:text-5xl font-bold font-display text-neutral-900 dark:text-neutral-50 mb-3">
                                Playground
                            </h1>
                            <p class="text-neutral-500 dark:text-neutral-400 text-lg max-w-xl">
                                Write snippets, run them instantly, and share a link or embed when it is ready.
                            </p>
                        </div>

                        <div class="grid grid-cols-3 gap-6 text-left md:min-w-72 border-l border-neutral-200 dark:border-neutral-800 pl-6">
                            <div>
                                <div class="text-xl font-bold text-neutral-900 dark:text-neutral-50">5+</div>
                                <div class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-widest mt-1">Languages</div>
                            </div>
                            <div>
                                <div class="text-xl font-bold text-neutral-900 dark:text-neutral-50">Run</div>
                                <div class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-widest mt-1">Backend</div>
                            </div>
                            <div>
                                <div class="text-xl font-bold text-neutral-900 dark:text-neutral-50">Share</div>
                                <div class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-widest mt-1">Embed</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mx-auto w-full max-w-6xl flex-1 px-4 py-5 sm:px-6">
                <div class="h-[calc(100svh-220px)] min-h-[560px] md:h-[calc(100vh-210px)]">
                    <div id="standalone-playground-root" class="h-full w-full overflow-hidden rounded-lg border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
                        <StandalonePlaygroundHydrator client:only="react" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
