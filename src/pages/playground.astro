---
import Layout from "../layouts/Layout.astro";
import StandalonePlaygroundHydrator from "../components/StandalonePlaygroundHydrator";
---

<Layout
    title="TakoVibe Playground – Run & Share Code Instantly"
    description="Write, run, and share code snippets in Python, JavaScript, Go, Rust and more. Embed interactive playgrounds in your blog or share a direct link."
    no_footer={false}
>
    <div class="min-h-screen bg-gray-50 dark:bg-slate-950 flex flex-col">
        <!-- Hero -->
        <div class="pt-16 pb-6 px-4 text-center">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 text-xs font-bold uppercase tracking-wider mb-4">
                ⚡ Live Playground
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mb-3">
                Code. Run. Share.
            </h1>
            <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto text-sm sm:text-base">
                Write code in any language and share it, embed an interactive playground in your blog or send a shareable link.
            </p>
        </div>

        <!-- Playground container — fixed height so the inner resize works correctly -->
        <div class="w-full max-w-6xl mx-auto px-4 pb-8" style="height: calc(100vh - 220px); min-height: 600px;">
            <div id="standalone-playground-root" class="w-full h-full rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800">
                <StandalonePlaygroundHydrator client:only="react" />
            </div>
        </div>
    </div>
</Layout>
