---
// Document ids are user-uploaded and live client-side, so this route can't be
// prerendered — render on demand and let the reader open the document by id.
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import EbookReaderHydrator from "../../components/EbookReaderHydrator";

const { id } = Astro.params;
---

<Layout
    title="Vellora"
    description="Read with Kumi beside you for explanations, translations, highlights, and memory."
    no_footer={true}
    no_header={true}
>
    <!-- Fully immersive: no site header or promo banner on the reader -->
    <style is:global>
        #top-banner { display: none !important; }
        :root { --top-banner-height: 0px !important; }
    </style>
    <div class="relative min-h-screen bg-[#f8f1e5] dark:bg-[#181510]">
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div
                class="absolute left-0 right-0 top-0 h-[420px] bg-gradient-to-b from-[#f2e6d2] via-[#f8f1e5]/70 to-transparent dark:from-[#2b2118]/75 dark:via-[#181510]/50 dark:to-transparent"
            >
            </div>
        </div>
        <div class="relative z-10">
            <EbookReaderHydrator client:only="react" initialBookId={id} />
        </div>
    </div>
</Layout>
