---
import Layout from "../../layouts/Layout.astro";
import { NoteEditor } from "../../components/notes/NoteEditor";
---

<Layout title="New Note | TakoVibe" no_header={true} no_footer={true}>
    <div class="fixed inset-0 z-50 bg-neutral-100 dark:bg-neutral-950">
        <NoteEditor client:only="react" />
    </div>
</Layout>

<script>
    if (!localStorage.getItem("access_token")) {
        window.location.href = "/login?next=/notes/new";
    }
</script>
