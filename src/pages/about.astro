                                    </div>
                                    <div>
                                        <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                                            <a
                                                href={author.profileUrl}
                                                class="before:absolute before:inset-0 focus:outline-none"
                                            >
                                                {author.name}
                                            </a>
                                        </h3>
                                        <p class="text-sm font-semibold text-gray-500 dark:text-gray-400 mb-3">
                                            {author.role}
                                        </p>
                                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                                            {author.bio}
                                        </p>
                                        <div class="flex gap-3 relative z-10">
                                            {author.linkedin !== "#" && (
                                                <a
                                                    href={author.linkedin}
                                                    target="_blank"
                                                    class="text-gray-400 hover:text-blue-600 transition-colors"
                                                >
                                                    <span class="sr-only">
                                                        LinkedIn
                                                    </span>
                                                    <svg
                                                        class="w-5 h-5"
                                                        fill="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.27c-.966 0-1.75-.79-1.75-1.75s.784-1.75 1.75-1.75 1.75.79 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.27h-3v-5.6c0-3.37-4-3.12-4 0v5.6h-3v-11h3v1.76c1.4-2.59 7-2.78 7 2.47v6.77z" />
                                                    </svg>
                                                </a>
                                            )}
                                            {author.website !== "#" && (
                                                <a
                                                    href={author.website}
                                                    target="_blank"
                                                    class="text-gray-400 hover:text-purple-600 transition-colors"
                                                >
                                                    <span class="sr-only">
                                                        Website
                                                    </span>
                                                    <svg
                                                        class="w-5 h-5"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                                                        />
                                                    </svg>
                                                </a>
                                            )}
                                            {author.github !== "#" && (
                                                <a
                                                    href={author.github}
                                                    target="_blank"
                                                    class="text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                                >
                                                    <span class="sr-only">
                                                        GitHub
                                                    </span>
                                                    <svg
                                                        class="w-5 h-5"
                                                        fill="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                                    </svg>
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>
