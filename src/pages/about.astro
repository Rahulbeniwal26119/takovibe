                    <div class="order-2 lg:order-1">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            {[
                                { title: "Implementation Experience", desc: "Articles are written from real implementation experience, not just theory." },
                                { title: "System Behavior", desc: "Topics go beyond basics into system behavior and design reasoning." },
                                { title: "No Trend-Chasing", desc: "We avoid shallow explainers or chasing temporary hype." },
                                { title: "By Engineers, For Engineers", desc: "Content written by practitioners who build and scale systems." }
                            ].map((item, i) => (
                                <div class={`p-6 rounded-2xl bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-md transition-shadow`}>
