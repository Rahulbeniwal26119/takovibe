---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me | Tech Insights">
  <div class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800">
    <!-- Hero Section with Animated Background -->
    <div class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-purple-600/10 to-blue-600/10 animate-gradient"></div>
      <div class="relative max-w-4xl mx-auto px-4">
        <h1 class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400 mb-6 animate-fade-in">
          Hi, I'm Rahul Beniwal
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-12 animate-slide-up">
          Full Stack Developer specializing in Python and modern web technologies.
          Currently focused on building scalable applications and sharing knowledge
          through technical writing and open-source contributions.
        </p>
      </div>
    </div>

    <!-- Tech Stack Section -->
    <div class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400 mb-8">
        Tech Stack
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {[
          { name: 'Python', icon: '🐍' },
          { name: 'Django', icon: '🎯' },
          { name: 'FastAPI', icon: '⚡' },
          { name: 'React', icon: '⚛️' },
          { name: 'Docker', icon: '🐳' },
          { name: 'PostgreSQL', icon: '🐘' }
        ].map(tech => (
          <div class="group relative bg-slate-800/50 p-6 rounded-xl backdrop-blur-sm hover:bg-slate-700/50 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg">
            <div class="text-3xl mb-2">{tech.icon}</div>
            <h3 class="text-lg font-medium text-gray-200 group-hover:text-purple-400 transition-colors">
              {tech.name}
            </h3>
          </div>
        ))}
      </div>

      <!-- Current Focus Section -->
      <div class="mt-16">
        <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400 mb-8">
          Current Focus
        </h2>
        <div class="space-y-4">
          {[
            'Writing technical articles about Python and web development',
            'Contributing to open-source projects',
            'Building scalable web applications'
          ].map(focus => (
            <div class="flex items-center space-x-4 bg-slate-800/30 p-4 rounded-lg hover:bg-slate-700/30 transition-all">
              <div class="text-purple-400">→</div>
              <p class="text-gray-300">{focus}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .animate-gradient {
    animation: gradient 15s ease infinite;
    background-size: 200% 200%;
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }

  .animate-slide-up {
    animation: slideUp 0.8s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style> 