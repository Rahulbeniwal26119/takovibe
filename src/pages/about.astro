---
import Layout from "../layouts/Layout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
let stats = null;

try {
    const response = await fetch(`${API_URL}/api/blogs/home/our-stats/`);
    const result = await response.json();
    if (result.code === 0 && result.data) {
        stats = result.data;
    }
} catch (e) {
    console.warn("Failed to fetch stats for about page");
}

let authors = [];

try {
    const response = await fetch(`${API_URL}/api/users/authors/`);
    const result = await response.json();
    if (result.code === 0 && result.data) {
        authors = result.data.map((author: any) => ({
            name: author.name,
            role: author.role || "Core Contributor",
            img:
                author.profile_image ||
                `https://ui-avatars.com/api/?name=${encodeURIComponent(author.name)}&background=f97316&color=fff`,
            bio: author.bio || "Practical engineering notes, lessons, and field-tested ideas.",
            linkedin: author.linkedin_url || "#",
            github: author.github_url || "#",
            website: author.website_url || "#",
            profileUrl: `/profile/${author.username}/`,
        }));
    }
} catch (e) {
    console.warn("Failed to fetch authors");
}

const principles = [
    {
        title: "Production context",
        text: "We care about how systems behave after the happy path ends: latency, failure, scale, debugging, and trade-offs.",
    },
    {
        title: "Clear reasoning",
        text: "Good engineering writing should make decisions easier to explain, revisit, and improve.",
    },
    {
        title: "Practical depth",
        text: "Articles are shaped around implementation experience, not recycled summaries or surface-level walkthroughs.",
    },
];

const values = [
    {
        title: "Quality over quantity",
        text: "Fewer articles, written with more care.",
    },
    {
        title: "Technical honesty",
        text: "We include the constraints, failures, and compromises.",
    },
    {
        title: "Useful artifacts",
        text: "Code, diagrams, playgrounds, and notes should stay close to the explanation.",
    },
    {
        title: "Open learning",
        text: "Engineering insight should be practical, accessible, and grounded.",
    },
];

const topics = [
    "Backend engineering",
    "APIs and architecture",
    "Containers and DevOps",
    "Python internals",
    "System design",
    "Performance and reliability",
    "Debugging stories",
    "Engineering tools",
];
---

<Layout
    title="About | TakoVibe"
    author="TakoVibe Team"
    description="Learn about TakoVibe, an engineering publication focused on practical depth, production context, and useful technical learning."
    tags={["software engineering", "team", "mission", "technical writing"]}
>
    <main class="min-h-screen bg-stone-50 text-neutral-950 dark:bg-neutral-950 dark:text-neutral-50">
        <section class="relative overflow-hidden border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950">
            <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-[0.035] dark:opacity-[0.055]"></div>
            <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center lg:px-8 lg:py-28">
                <div class="max-w-3xl">
                    <div class="mb-6 flex items-center gap-3">
                        <div class="h-px w-10 bg-orange-500"></div>
                        <span class="text-xs font-black uppercase tracking-[0.22em] text-orange-600 dark:text-orange-400">About TakoVibe</span>
                    </div>

                    <h1 class="font-display text-5xl font-black leading-[1.02] tracking-tight text-neutral-950 dark:text-white md:text-7xl">
                        Engineering knowledge for people building real systems.
                    </h1>

                    <p class="mt-7 max-w-2xl text-lg leading-8 text-neutral-600 dark:text-neutral-300">
                        TakoVibe publishes practical software engineering writing with context: how things work, why decisions were made, and what actually matters when ideas meet production.
                    </p>

                    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                        <a
                            href="/blog"
                            class="inline-flex items-center justify-center rounded-lg bg-orange-600 px-5 py-3 text-sm font-black text-white transition hover:bg-orange-700"
                        >
                            Read the blog
                        </a>
                        <a
                            href="/contact"
                            class="inline-flex items-center justify-center rounded-lg border border-neutral-200 bg-white px-5 py-3 text-sm font-bold text-neutral-800 transition hover:border-orange-300 hover:text-orange-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-orange-500/40 dark:hover:text-orange-300"
                        >
                            Write with us
                        </a>
                    </div>
                </div>

                <aside class="rounded-lg border border-neutral-200 bg-stone-50 p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/70">
                    <div class="flex items-center gap-4 border-b border-neutral-200 pb-5 dark:border-neutral-800">
                        <img src="/images/logo.svg" alt="TakoVibe" class="h-14 w-14 rounded-full bg-white shadow-sm" />
                        <div>
                            <p class="font-display text-2xl font-black text-neutral-950 dark:text-white">TakoVibe</p>
                            <p class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">Deep technical notes, tools, and articles.</p>
                        </div>
                    </div>

                    <div class="mt-5 grid gap-3">
                        {principles.map((item) => (
                            <div class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-950">
                                <h2 class="text-sm font-black text-neutral-950 dark:text-white">{item.title}</h2>
                                <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{item.text}</p>
                            </div>
                        ))}
                    </div>
                </aside>
            </div>
        </section>

        {stats && (
            <section class="border-b border-neutral-200 bg-stone-50 dark:border-neutral-800 dark:bg-neutral-950">
                <div class="mx-auto grid max-w-7xl gap-4 px-4 py-8 sm:grid-cols-2 sm:px-6 lg:px-8">
                    <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900/60">
                        <p class="text-xs font-black uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-400">Articles</p>
                        <p class="mt-2 font-display text-4xl font-black text-neutral-950 dark:text-white">{stats.total_blogs}+</p>
                    </div>
                    <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900/60">
                        <p class="text-xs font-black uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-400">Authors</p>
                        <p class="mt-2 font-display text-4xl font-black text-neutral-950 dark:text-white">{stats.total_authors}</p>
                    </div>
                </div>
            </section>
        )}

        <section class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8 lg:py-24">
            <div>
                <p class="text-sm font-black uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400">Why we started</p>
                <h2 class="mt-4 font-display text-4xl font-black tracking-tight text-neutral-950 dark:text-white">
                    The gap between tutorials and real engineering work is too wide.
                </h2>
            </div>

            <div class="space-y-6 text-base leading-8 text-neutral-600 dark:text-neutral-300">
                <p>
                    The internet has plenty of quick starts. But once systems have users, incidents, migrations, deadlines, and long-term maintenance, the useful questions change.
                </p>
                <p>
                    TakoVibe exists for those questions. We write about the reasoning behind systems, not just the commands to run. We care about the mistakes, the constraints, and the small decisions that make software easier to operate.
                </p>
                <p>
                    Our goal is simple: publish fewer pieces with more signal, and keep the learning close to real code, diagrams, notes, and tools.
                </p>
            </div>
        </section>

        <section class="border-y border-neutral-200 bg-white px-4 py-16 dark:border-neutral-800 dark:bg-neutral-900/40 sm:px-6 lg:py-24">
            <div class="mx-auto max-w-7xl">
                <div class="mb-10 max-w-2xl">
                    <p class="text-sm font-black uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400">How we work</p>
                    <h2 class="mt-4 font-display text-4xl font-black tracking-tight text-neutral-950 dark:text-white">Values that keep the writing useful.</h2>
                </div>

                <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                    {values.map((value) => (
                        <article class="rounded-lg border border-neutral-200 bg-stone-50 p-6 dark:border-neutral-800 dark:bg-neutral-950">
                            <div class="mb-5 h-1.5 w-10 rounded-full bg-orange-500"></div>
                            <h3 class="text-lg font-black text-neutral-950 dark:text-white">{value.title}</h3>
                            <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{value.text}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:py-24">
            <div>
                <p class="text-sm font-black uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400">What we cover</p>
                <h2 class="mt-4 font-display text-4xl font-black tracking-tight text-neutral-950 dark:text-white">
                    Topics with production weight.
                </h2>
                <p class="mt-5 text-base leading-7 text-neutral-600 dark:text-neutral-300">
                    We focus on subjects that help engineers understand systems more clearly and build with better judgment.
                </p>
            </div>

            <div class="flex flex-wrap gap-3">
                {topics.map((topic) => (
                    <span class="rounded-lg border border-neutral-200 bg-white px-4 py-3 text-sm font-bold text-neutral-700 transition hover:border-orange-300 hover:text-orange-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:border-orange-500/40 dark:hover:text-orange-300">
                        {topic}
                    </span>
                ))}
            </div>
        </section>

        {authors.length > 0 && (
            <section class="border-y border-neutral-200 bg-white px-4 py-16 dark:border-neutral-800 dark:bg-neutral-900/40 sm:px-6 lg:py-24">
                <div class="mx-auto max-w-7xl">
                    <div class="mb-10 max-w-2xl">
                        <p class="text-sm font-black uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400">Authors</p>
                        <h2 class="mt-4 font-display text-4xl font-black tracking-tight text-neutral-950 dark:text-white">Written by practitioners.</h2>
                        <p class="mt-5 text-base leading-7 text-neutral-600 dark:text-neutral-300">
                            TakoVibe is shaped by people who build, debug, scale, and explain real systems.
                        </p>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                        {authors.map((author) => (
                            <article class="group relative rounded-lg border border-neutral-200 bg-stone-50 p-5 transition hover:border-orange-300 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:border-orange-500/40">
                                <div class="flex gap-5">
                                    <img src={author.img} alt={author.name} class="h-20 w-20 shrink-0 rounded-lg object-cover" />
                                    <div class="min-w-0">
                                        <h3 class="text-xl font-black text-neutral-950 transition group-hover:text-orange-600 dark:text-white dark:group-hover:text-orange-300">
                                            <a href={author.profileUrl} class="before:absolute before:inset-0">
                                                {author.name}
                                            </a>
                                        </h3>
                                        <p class="mt-1 text-sm font-bold text-neutral-500 dark:text-neutral-400">{author.role}</p>
                                        <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">{author.bio}</p>
                                        <div class="relative z-10 mt-4 flex gap-3">
                                            {author.linkedin !== "#" && (
                                                <a href={author.linkedin} target="_blank" class="text-sm font-bold text-neutral-500 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-300">LinkedIn</a>
                                            )}
                                            {author.github !== "#" && (
                                                <a href={author.github} target="_blank" class="text-sm font-bold text-neutral-500 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-300">GitHub</a>
                                            )}
                                            {author.website !== "#" && (
                                                <a href={author.website} target="_blank" class="text-sm font-bold text-neutral-500 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-300">Website</a>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                </div>
            </section>
        )}

        <section class="px-4 py-16 sm:px-6 lg:py-24">
            <div class="mx-auto grid max-w-7xl gap-8 rounded-lg border border-neutral-200 bg-neutral-950 p-8 text-white dark:border-neutral-800 dark:bg-black sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
                <div class="max-w-2xl">
                    <p class="text-sm font-black uppercase tracking-[0.2em] text-orange-400">Contribute</p>
                    <h2 class="mt-4 font-display text-4xl font-black tracking-tight">Have a hard-earned lesson to share?</h2>
                    <p class="mt-4 text-base leading-7 text-neutral-300">
                        We are always interested in practical engineering stories, deep technical notes, and clear explanations from builders.
                    </p>
                </div>
                <a
                    href="/contact"
                    class="inline-flex items-center justify-center rounded-lg bg-orange-600 px-6 py-3 text-sm font-black text-white transition hover:bg-orange-500"
                >
                    Get in touch
                </a>
            </div>
        </section>
    </main>
</Layout>
