---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | TakoVibe" author="Rahul Beniwal" tags={["software engineering", "system design", "technology innovations"]}>
  <div class="min-h-screen bg-[#1B1E2B]">
    <!-- Hero Section -->
    <div class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-purple-600/10 to-blue-600/10 animate-gradient"></div>
      <div class="relative max-w-4xl mx-auto px-4">
        <h1 class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#FFB4B4] to-[#B4D4FF] mb-6 animate-fade-in">
          Hi, I'm Rahul Beniwal
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 animate-slide-up">
          A Software Developer II at LiveEasy, specializing in building scalable backend systems and optimizing performance. I write about software engineering concepts with practical implementations.
        </p>
      </div>
    </div>

    <!-- Topics Section -->
    <div class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#FFB4B4] to-[#B4D4FF] mb-12">
        What I Write About
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-slate-800/30 p-6 rounded-lg hover:bg-slate-700/30 transition-all duration-300">
          <h3 class="text-xl font-semibold text-[#FFB4B4] text-center">System Design</h3>
        </div>

        <div class="bg-slate-800/30 p-6 rounded-lg hover:bg-slate-700/30 transition-all duration-300">
          <h3 class="text-xl font-semibold text-[#B4D4FF] text-center">Backend Development</h3>
        </div>

        <div class="bg-slate-800/30 p-6 rounded-lg hover:bg-slate-700/30 transition-all duration-300">
          <h3 class="text-xl font-semibold text-[#FFB4B4] text-center">Cloud & DevOps</h3>
        </div>

        <div class="bg-slate-800/30 p-6 rounded-lg hover:bg-slate-700/30 transition-all duration-300">
          <h3 class="text-xl font-semibold text-[#B4D4FF] text-center">Web Development</h3>
        </div>

        <div class="bg-slate-800/30 p-6 rounded-lg hover:bg-slate-700/30 transition-all duration-300">
          <h3 class="text-xl font-semibold text-[#FFB4B4] text-center">Software Engineering</h3>
        </div>
      </div>
    </div>

    <!-- Connect Section -->
    <div class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#FFB4B4] to-[#B4D4FF] mb-8">
        Let's Connect
      </h2>
      <!-- <a href="https://rahulbeniwal.takovibe.com" class="text-[#B4D4FF] hover:text-[#FFB4B4] transition-colors">portfolio</a> or -->
      <div class="prose prose-invert max-w-none">
        <p class="text-lg text-gray-300 leading-relaxed">
          Want to learn more about my work? Connect with me on <a href="https://www.linkedin.com/in/rahulbeniwal26119/" class="text-[#B4D4FF] hover:text-[#FFB4B4] transition-colors">LinkedIn</a>. Feel free to reach out if you want to discuss technology, collaboration opportunities, or just want to say hi!
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .animate-gradient {
    animation: gradient 15s ease infinite;
    background-size: 200% 200%;
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }

  .animate-slide-up {
    animation: slideUp 0.8s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style> 