---
import Layout from "../layouts/Layout.astro";
import ParticlesBackground from "../components/ParticlesBackground.astro";

// Stats Data Fetching
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
let stats = null;

try {
    const response = await fetch(`${API_URL}/api/blogs/home/our-stats/`);
    const result = await response.json();
    if (result.code === 0 && result.data) {
        stats = result.data;
    }
} catch (e) {
    console.warn("Failed to fetch stats for about page");
}

const formatNumber = (num: number) => {
    if (num >= 1000) return (num / 1000).toFixed(1) + "k";
    return num;
};

let authors = [];

try {
    const response = await fetch(`${API_URL}/api/users/authors/`);
    const result = await response.json();
    if (result.code === 0 && result.data) {
        authors = result.data.map((author: any) => ({
            name: author.name,
            role: author.role || "Core Contributor",
            img:
                author.profile_image ||
                `https://ui-avatars.com/api/?name=${encodeURIComponent(author.name)}&background=random&color=fff`,
            bio: author.bio || "No bio available.",
            linkedin: author.linkedin_url || "#",
            github: author.github_url || "#",
            website: author.website_url || "#",
            profileUrl: `/profile/${author.username}/`,
        }));
    }
} catch (e) {
    console.warn("Failed to fetch authors");
}
---

<Layout
    title="About | TakoVibe"
    author="TakoVibe Team"
    tags={["software engineering", "team", "mission"]}
>
    <div
        class="relative w-full overflow-x-hidden min-h-screen bg-gray-50 dark:bg-[#0B1120]"
    >
        <!-- Immersive Background (Shared with Home for consistency) -->
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div
                class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-purple-100 via-gray-50 to-white dark:from-[#1a103c] dark:via-[#0B1120] dark:to-[#0B1120]"
            >
            </div>
            <!-- Floating Orbs -->
            <div
                class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-purple-400/20 dark:bg-purple-600/10 blur-[100px] animate-blob mix-blend-multiply dark:mix-blend-screen"
            >
            </div>
            <div
                class="absolute top-[20%] right-[-10%] w-[400px] h-[400px] rounded-full bg-blue-400/20 dark:bg-blue-600/10 blur-[100px] animate-blob animation-delay-2000 mix-blend-multiply dark:mix-blend-screen"
            >
            </div>
            <ParticlesBackground />
        </div>

        <!-- Hero Section -->
        <section class="relative z-10 py-24 lg:py-32">
            <div class="max-w-7xl mx-auto px-6 text-center">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 dark:bg-white/5 backdrop-blur-md text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium mb-8 border border-purple-200/50 dark:border-white/10 shadow-sm animate-fade-in-up"
                >
                    <span class="text-base">💎</span>
                    <span>Engineering Excellence</span>
                </div>

                <h1
                    class="text-4xl md:text-6xl lg:text-7xl font-bold mb-8 animate-fade-in-up animation-delay-200 tracking-tight"
                >
                    <span class="block text-gray-900 dark:text-white mb-2"
                        >Built by Engineers.</span
                    >
                    <span
                        class="bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 bg-clip-text text-transparent animate-gradient"
                        >For Engineers.</span
                    >
                </h1>

                <p
                    class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-12 leading-relaxed animate-fade-in-up animation-delay-400"
                >
                    Production-first engineering knowledge covering lessons, fundamentals, and tools, built from real production experience.
                    <br class="hidden md:block" />
                    <span class="font-semibold text-purple-600 dark:text-purple-400">No fluff. No surface-level tutorials.</span>
                    Only technical depth that matters.
                </p>

                <!-- Stats Grid (Home Page Style) -->
                {stats && (
                <div
                    class="flex flex-wrap justify-center gap-8 md:gap-16 mt-16 animate-fade-in-up animation-delay-600"
                >
                    <div class="text-center group">
                        <div
                            class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-2xl bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 shadow-lg group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-8 h-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                                ></path></svg
                            >
                        </div>
                        <div
                            class="text-3xl font-bold text-gray-900 dark:text-white mb-1"
                        >
                            {stats.total_blogs}+
                        </div>
                        <div
                            class="text-sm text-gray-500 uppercase tracking-wider font-semibold"
                        >
                            Articles
                        </div>
                    </div>

                    <div class="text-center group">
                        <div
                            class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-2xl bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 shadow-lg group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-8 h-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                ></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                ></path></svg
                            >
                        </div>
                        <!-- Simple client-side re-animation can be done, but server render is enough -->
                        <div
                            class="text-3xl font-bold text-gray-900 dark:text-white mb-1"
                        >
                            {formatNumber(stats.total_views)}+
                        </div>
                        <div
                            class="text-sm text-gray-500 uppercase tracking-wider font-semibold"
                        >
                            Views
                        </div>
                    </div>

                    <div class="text-center group">
                        <div
                            class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-2xl bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-400 shadow-lg group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-8 h-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                                ></path></svg
