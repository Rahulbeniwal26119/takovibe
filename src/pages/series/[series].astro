---
import Layout from "../../layouts/Layout.astro";

// Temporarily disable prerendering to debug API issues
// Enable prerendering for static generation and sitemap inclusion
export const prerender = true;

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

export async function getStaticPaths() {
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
  try {
    // Fetch all series (live + completed)
    const [liveRes, completedRes] = await Promise.all([
      fetch(`${API_URL}/api/blogs/series/live-series/`),
      fetch(`${API_URL}/api/blogs/series/completed-series/`),
    ]);

    let allSeries = [];

    if (liveRes.ok) {
      const liveData = await liveRes.json();
      allSeries = [...allSeries, ...(liveData.data || [])];
    }

    if (completedRes.ok) {
      const completedData = await completedRes.json();
      allSeries = [...allSeries, ...(completedData.data || [])];
    }

    // Generate paths for each series
    return allSeries.map((series) => ({
      params: { series: series.slug },
      props: { seriesSlug: series.slug },
    }));
  } catch (e) {
    console.error("Failed to fetch series for static paths:", e);
    return [];
  }
}

// Get slug from URL params (works in both SSR and SSG)
const seriesSlug = Astro.params.series;

// Fetch series details from API
let seriesData = null;
let articles = [];
let error = null;

try {
  const response = await fetch(`${API_URL}/api/blogs/series/${seriesSlug}/`);

  if (response.ok) {
    const rawData = await response.json();

    // The API returns: { message, code, data: { ...series, articles: [...] } }
    if (rawData.data) {
      seriesData = rawData.data;
      articles = seriesData.articles || [];
    } else {
      // Fallback if structure is different
      seriesData = rawData;
      articles = seriesData.articles || [];
    }
  } else {
    error = `Failed to load series: ${response.status}`;
    console.error(error);
  }
} catch (e) {
  error = `Error fetching series: ${e.message}`;
  console.error(error);
}

// Redirect to 404 if series not found
if (!seriesData && !error) {
  return Astro.redirect("/404");
}

const seriesName = seriesData?.title || "Series";
const seriesDescription =
  seriesData?.description || seriesData?.short_description || "";
const startLevel = seriesData?.start_level || "beginner";
const endLevel = seriesData?.end_level || "intermediate";
const isSeriesComplete = seriesData?.is_completed || false;
const isLive = seriesData?.is_live || false;

// Calculate progress
const publishedArticlesCount =
  seriesData?.total_published_articles || articles.length;
const plannedArticlesCount = seriesData?.planned_articles || 0;
const totalArticles =
  plannedArticlesCount > 0 ? plannedArticlesCount : publishedArticlesCount;
const isInfiniteSeries = plannedArticlesCount === 0;
const progressPercentage =
  !isInfiniteSeries && totalArticles > 0
    ? (publishedArticlesCount / totalArticles) * 100
    : 0;

// Get current article slug from URL if present
const currentSlug = Astro.url.pathname.split("/").filter(Boolean).pop();

// Prepare article data - articles are nested under 'article' property
const articlesData = articles.map((item, index) => {
  // Extract the actual article from the nested structure
  const article = item.article || item;
  const isCurrent = currentSlug === article.slug;
  // If is_published field exists, use it; otherwise assume true (API only returns published articles)
  const isPublished =
    article.is_published !== undefined ? article.is_published : true;

  return {
    ...article,
    order: item.order || index + 1,
    index,
    isPublished,
    isCurrent,
  };
});
---

<Layout
  title={`${seriesName} Series - All Articles`}
  description={`Complete ${seriesName} series with ${articles.length} articles covering everything from basics to advanced concepts.`}
>
  <div class="relative w-full overflow-x-hidden min-h-screen bg-gray-50 dark:bg-[#0B1120]">
    <!-- Immersive Background -->
    <div class="fixed inset-0 z-0">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-purple-100 via-gray-50 to-white dark:from-[#1a103c] dark:via-[#0B1120] dark:to-[#0B1120]"></div>
      <!-- Floating Orbs -->
      <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-purple-400/20 dark:bg-purple-600/10 blur-[100px] animate-blob mix-blend-multiply dark:mix-blend-screen"></div>
      <div class="absolute top-[20%] right-[-10%] w-[400px] h-[400px] rounded-full bg-blue-400/20 dark:bg-blue-600/10 blur-[100px] animate-blob animation-delay-2000 mix-blend-multiply dark:mix-blend-screen"></div>
      <div class="absolute bottom-[-20%] left-[20%] w-[600px] h-[600px] rounded-full bg-pink-400/20 dark:bg-pink-600/10 blur-[100px] animate-blob animation-delay-4000 mix-blend-multiply dark:mix-blend-screen"></div>
      <div class="absolute inset-0 bg-[url('/noise.png')] opacity-20 brightness-100 contrast-150"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 px-4 sm:px-6 z-10 overflow-hidden">
      <!-- Breadcrumb -->
      <nav class="flex justify-center text-sm text-slate-500 dark:text-slate-400 mb-8 animate-fade-in-up" aria-label="Breadcrumb">
        <ol class="inline-flex items-center gap-2 px-4 py-2 bg-white/50 dark:bg-slate-800/50 backdrop-blur-md rounded-full border border-slate-200/50 dark:border-slate-700/50 shadow-sm">
           <li class="inline-flex items-center">
             <a href="/" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Home</a>
           </li>
           <li class="text-slate-300 dark:text-slate-600">/</li>
           <li class="inline-flex items-center">
             <a href="/series" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Series</a>
           </li>
           <li class="text-slate-300 dark:text-slate-600">/</li>
           <li class="font-medium text-slate-900 dark:text-white truncate max-w-[150px] sm:max-w-xs">{seriesName}</li>
        </ol>
      </nav>

      <div class="max-w-5xl mx-auto text-center">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 mb-8 animate-fade-in-up animation-delay-100">
           {isSeriesComplete ? (
             <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50 shadow-sm">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                COMPLETED
             </span>
           ) : (
             <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50 shadow-sm">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                </span>
                IN PROGRESS
             </span>
           )}
        </div>

        <!-- Title -->
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-slate-900 dark:text-white mb-8 animate-fade-in-up animation-delay-200">
           <span class="bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 bg-clip-text text-transparent">{seriesName}</span>
        </h1>

        <!-- Description -->
        <p class="text-xl md:text-2xl text-slate-700 dark:text-slate-200 max-w-3xl mx-auto leading-relaxed mb-4 animate-fade-in-up animation-delay-300 font-medium">
           {seriesDescription || "Deep dive into this topic with our structured learning path."}
        </p>

        <p class="text-lg text-slate-500 dark:text-slate-400 mb-8 animate-fade-in-up animation-delay-300">
          Start anywhere, or follow the journey from top to bottom.
        </p>

        <!-- Top CTAs -->
        <div class="flex flex-wrap justify-center gap-4 mb-10 animate-fade-in-up animation-delay-400">
             <a href={`/blog/${articles[0]?.slug || "#"}`} class="px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-xl shadow-lg hover:shadow-purple-500/25 hover:-translate-y-0.5 transition-all">
                Start from Beginning
             </a>
             {articles.length > 1 && (
                <a href={`/blog/${articles[articles.length - 1].article?.slug || articles[articles.length - 1].slug || "#"}`} class="px-6 py-3 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-bold rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700 transition-all">
                   Jump to Latest
                </a>
             )}
        </div>

        <!-- Stats Bar -->
        <div class="inline-flex flex-wrap justify-center gap-4 sm:gap-8 bg-white/60 dark:bg-slate-800/60 backdrop-blur-xl p-2 pr-6 rounded-2xl border border-white/20 dark:border-slate-700 shadow-xl animate-fade-in-up animation-delay-400">
           <div class="flex items-center gap-3 bg-white/50 dark:bg-slate-900/50 px-5 py-2.5 rounded-xl border border-white/40 dark:border-slate-700">
              <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400">
                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
              </div>
              <div class="text-left">
                 <div class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Content</div>
                 <div class="font-bold text-slate-900 dark:text-white">{publishedArticlesCount} / {isInfiniteSeries ? "∞" : totalArticles} Articles</div>
              </div>
           </div>

           <div class="flex items-center gap-3 px-2">
              <div class="w-8 h-8 rounded-lg bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center text-pink-600 dark:text-pink-400">
                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div class="text-left">
                 <div class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Duration</div>
                 <div class="font-bold text-slate-900 dark:text-white">~{articles.length * 8} mins</div>
              </div>
           </div>
           
           <div class="flex items-center gap-3 px-2">
              <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400">
                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div class="text-left">
                 <div class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Level</div>
                 <div class="font-bold text-slate-900 dark:text-white capitalize">{startLevel} - {endLevel}</div>
              </div>
           </div>
        </div>

        <!-- Progress Bar (Large) -->
        {plannedArticlesCount > 0 && (
          <div class="mt-12 max-w-xl mx-auto animate-fade-in-up animation-delay-500">
             <div class="flex justify-between text-sm font-bold mb-3 text-slate-600 dark:text-slate-400">
                <span>Progress</span>
                <span>{Math.round(progressPercentage)}%</span>
             </div>
             <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden border border-slate-300 dark:border-slate-600 shadow-inner">
                <div class="h-full bg-gradient-to-r from-purple-500 via-pink-500 to-blue-500 animate-pulse" style={`width: ${progressPercentage}%`}></div>
             </div>
          </div>
        )}
      </div>
    </section>

    <!-- Learning Path Section -->
    <section class="relative z-10 pb-32 px-4 sm:px-6">
       <div class="max-w-4xl mx-auto">
          <!-- Connector Line Background -->
          <div class="absolute left-[33px] sm:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-purple-500/50 via-blue-500/50 to-transparent dark:from-purple-500/30 dark:via-blue-500/30 hidden sm:block"></div>
          
          <div class="space-y-12 relative">
             {articlesData.map((article, idx) => {
               // Timeline Alignment Logic
               const isLeft = idx % 2 === 0;
               const isPublished = article.isPublished;
               const isCurrent = article.isCurrent;
               
               return (
                 <div class={`relative flex items-center sm:justify-between ${!isLeft ? 'flex-row-reverse' : ''} group`}>
                    <!-- Center Node -->
                    <div class={`absolute left-4 sm:left-1/2 -translate-x-1/2 w-10 h-10 rounded-full border-4 border-gray-50 dark:border-[#0B1120] z-20 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 shadow-lg
                        ${isCurrent ? 'bg-blue-500 ring-4 ring-blue-500/20' : 
                          isPublished ? 'bg-purple-600' : 'bg-slate-300 dark:bg-slate-700'}`}>
                       <span class="text-white font-bold text-xs">{idx + 1}</span>
                    </div>

                    <!-- Content CardWrapper -->
                    <div class={`w-full sm:w-[45%] pl-16 sm:pl-0 ${!isLeft ? 'sm:pr-0 sm:pl-0' : ''}`}>
                       <a href={article.isPublished ? `/blog/${article.slug}` : '#'} 
                          class={`block relative overflow-hidden rounded-2xl p-6 sm:p-8 transition-all duration-300 border backdrop-blur-md
                            ${isCurrent 
                               ? 'bg-blue-500/5 dark:bg-blue-500/10 border-blue-500/50 shadow-[0_0_30px_rgba(59,130,246,0.15)] ring-1 ring-blue-500/20 scale-[1.02]' 
                               : isPublished 
                                  ? 'bg-white/80 dark:bg-slate-800/80 border-white/50 dark:border-slate-700/50 hover:border-purple-500/50 dark:hover:border-purple-500/50 hover:shadow-2xl hover:shadow-purple-500/10 hover:-translate-y-1' 
                                  : 'bg-white/40 dark:bg-slate-900/40 border-slate-200 dark:border-slate-800 opacity-70 cursor-not-allowed grayscale'}
                          `}
                       >
                          {/* Floating Top Metadata (Improved) */}
                          <div class="mb-4 flex flex-wrap items-center gap-3">
                             {/* Part Badge */}
                             <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                Part {idx + 1}
                             </span>

                             {/* Read Time */}
                             <span class="flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                {article.reading_time || 8} min
                             </span>

                             {isCurrent && <span class="px-2 py-0.5 rounded text-[10px] bg-blue-500 text-white font-bold uppercase tracking-wide shadow-sm">Current</span>}
                             {!isPublished && <span class="px-2 py-0.5 rounded text-[10px] bg-amber-500/20 text-amber-600 dark:text-amber-400 font-bold uppercase tracking-wide border border-amber-500/20">Upcoming</span>}
                          </div>

                          <h3 class={`text-2xl font-bold mb-3 leading-snug ${isPublished ? 'text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400' : 'text-slate-500 dark:text-slate-500'}`}>
                             {article.title}
                          </h3>
                          
                          <p class="text-base text-slate-700 dark:text-slate-300 line-clamp-2 mb-6 leading-relaxed">
                             {article.description}
                          </p>

                          <!-- Footer -->
                          <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-700/50">
                             <div class="flex items-center gap-2">
                               {article.tags && article.tags.length > 0 && (
                                 <span class="text-xs text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/20 px-2 py-1 rounded font-medium">#{article.tags[0]}</span>
                               )}
                             </div>

                             {isPublished && (
                               <span class="inline-flex items-center gap-1.5 text-sm font-bold text-purple-600 dark:text-purple-400 group-hover:underline">
                                  Read Article
                                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                               </span>
                             )}
                          </div>
                       </a>
                    </div>
                 </div>
               );
             })}
          </div>

          <!-- SEO List (Visually separated but accessible) -->
           <div class="mt-20 mb-12">
             <div class="text-center mb-8">
               <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center justify-center gap-2">
                 <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                 Article Index
               </h2>
               <p class="text-sm text-slate-500 dark:text-slate-400">Complete list of articles in this series</p>
             </div>
             
             <nav aria-label="Article Index">
               <ol class="grid grid-cols-1 md:grid-cols-2 gap-4 list-decimal list-inside bg-white/50 dark:bg-slate-800/50 p-6 rounded-2xl border border-slate-200 dark:border-slate-700">
                  {articlesData.map(article => (
                     <li class="text-sm text-slate-500 dark:text-slate-400">
                       <a href={article.isPublished ? `/blog/${article.slug}` : '#'} class={`text-base font-medium transition-colors ${article.isPublished ? 'text-slate-700 dark:text-slate-300 hover:text-purple-600 dark:hover:text-purple-400 hover:underline' : 'text-slate-400 dark:text-slate-600 cursor-not-allowed'}`}>
                         {article.title}
                       </a>
                     </li>
                  ))}
               </ol>
             </nav>
           </div>

          <!-- Bottom CTA -->
          <div class="text-center animate-fade-in-up">
             <div class="inline-block p-[2px] rounded-2xl bg-gradient-to-br from-purple-500 via-pink-500 to-blue-500">
                <div class="bg-white dark:bg-[#0B1120] rounded-2xl p-8 sm:p-12 max-w-2xl relative overflow-hidden">
                   <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10"></div>
                   <div class="relative z-10">
                      <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Start Your Journey</h3>
                      <p class="text-slate-600 dark:text-slate-400 mb-8">Ready to master {seriesName}? Begin with the first article and level up your skills.</p>
                      
                      <div class="flex flex-col sm:flex-row gap-4 justify-center">
                         <a href={`/blog/${articles[0]?.slug || "#"}`} class="px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
                            Start Reading
                         </a>
                         <a href="/series" class="px-8 py-4 bg-transparent border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 font-bold rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-all duration-300">
                            Back to Series
                         </a>
                      </div>
                   </div>
                </div>
             </div>
          </div>

       </div>
    </section>
  </div>
</Layout>
