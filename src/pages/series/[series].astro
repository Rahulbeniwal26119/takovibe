---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

export async function getStaticPaths() {
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
  try {
    const [liveRes, completedRes] = await Promise.all([
      fetch(`${API_URL}/api/blogs/series/live-series/`),
      fetch(`${API_URL}/api/blogs/series/completed-series/`),
    ]);

    let allSeries = [];

    if (liveRes.ok) {
      const liveData = await liveRes.json();
      allSeries = [...allSeries, ...(liveData.data || [])];
    }

    if (completedRes.ok) {
      const completedData = await completedRes.json();
      allSeries = [...allSeries, ...(completedData.data || [])];
    }

    return allSeries.map((series) => ({
      params: { series: series.slug },
      props: { seriesSlug: series.slug },
    }));
  } catch (e) {
    console.error("Failed to fetch series for static paths:", e);
    return [];
  }
}

const seriesSlug = Astro.params.series;

let seriesData = null;
let articles = [];
let error = null;

try {
  const response = await fetch(`${API_URL}/api/blogs/series/${seriesSlug}/`);

  if (response.ok) {
    const rawData = await response.json();
    if (rawData.data) {
      seriesData = rawData.data;
      articles = seriesData.articles || [];
    } else {
      seriesData = rawData;
      articles = seriesData.articles || [];
    }
  } else {
    error = `Failed to load series: ${response.status}`;
    console.error(error);
  }
} catch (e) {
  error = `Error fetching series: ${e instanceof Error ? e.message : String(e)}`;
  console.error(error);
}

if (!seriesData && !error) {
  return Astro.redirect("/404");
}

const seriesName = seriesData?.title || "Series";
const seriesDescription =
  seriesData?.short_description || seriesData?.description || "";
const startLevel = seriesData?.start_level || "beginner";
const endLevel = seriesData?.end_level || "intermediate";
const isSeriesComplete = seriesData?.is_completed || false;

const publishedArticlesCount =
  seriesData?.total_published_articles || articles.length;
const plannedArticlesCount = seriesData?.planned_articles || 0;
const totalArticles =
  plannedArticlesCount > 0 ? plannedArticlesCount : publishedArticlesCount;
const isInfiniteSeries = plannedArticlesCount === 0;
const progressPercentage =
  !isInfiniteSeries && totalArticles > 0
    ? Math.min((publishedArticlesCount / totalArticles) * 100, 100)
    : 0;

const currentSlug = Astro.url.pathname.split("/").filter(Boolean).pop();

const articlesData = articles.map((item, index) => {
  const article = item.article || item;
  const isPublished =
    article.is_published !== undefined ? article.is_published : true;

  return {
    ...article,
    order: item.order || index + 1,
    index,
    isPublished,
    isCurrent: currentSlug === article.slug,
    coverImage: article.image || article.image_url,
  };
});

const firstArticle = articlesData.find((article) => article.isPublished);
const latestArticle = [...articlesData].reverse().find((article) => article.isPublished);
const levelText = `${startLevel} to ${endLevel}`;
const readingMinutes = Math.max(articlesData.length * 8, 8);
---

<Layout
  title={`${seriesName} Series | TakoVibe`}
  description={
    seriesDescription ||
    `Complete ${seriesName} series with structured articles from basics to practical depth.`
  }
>
  <div class="relative min-h-screen w-full overflow-x-hidden bg-stone-50 dark:bg-neutral-950">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute left-0 right-0 top-0 h-[520px] bg-gradient-to-b from-orange-50/80 via-stone-50/40 to-transparent dark:from-orange-950/20 dark:via-neutral-950/40 dark:to-transparent"></div>
    </div>

    <div class="relative z-10 w-full">
      <header class="border-b border-neutral-200 dark:border-neutral-800">
        <div class="mx-auto max-w-5xl px-6 pb-10 pt-12">
          <nav class="mb-8 flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="transition-colors hover:text-orange-600 dark:hover:text-orange-400">Home</a>
            <span class="text-neutral-300 dark:text-neutral-700">/</span>
            <a href="/series" class="transition-colors hover:text-orange-600 dark:hover:text-orange-400">Series</a>
            <span class="text-neutral-300 dark:text-neutral-700">/</span>
            <span class="truncate font-medium text-neutral-900 dark:text-neutral-50">{seriesName}</span>
          </nav>

          <div
            class={`mb-4 inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold ${
              isSeriesComplete
                ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-300"
                : "bg-orange-50 text-orange-700 dark:bg-orange-950/30 dark:text-orange-300"
            }`}
          >
            {isSeriesComplete ? "Completed" : "In progress"}
          </div>

          <h1 class="mb-4 max-w-3xl font-display text-4xl font-bold leading-tight text-neutral-900 dark:text-neutral-50 md:text-5xl">
            {seriesName}
          </h1>
          <p class="line-clamp-3 max-w-2xl text-base leading-relaxed text-neutral-500 dark:text-neutral-400 md:text-lg">
            {
              seriesDescription ||
                "A structured path you can read in order, with each article building on the last."
            }
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {
              firstArticle && (
                <a
                  href={`/blog/${firstArticle.slug}`}
                  class="rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 dark:bg-neutral-100 dark:text-neutral-950 dark:hover:bg-orange-400"
                >
                  Start from Beginning
                </a>
              )
            }
            {
              latestArticle && latestArticle.slug !== firstArticle?.slug && (
                <a
                  href={`/blog/${latestArticle.slug}`}
                  class="rounded-lg border border-neutral-200 px-5 py-2.5 text-sm font-semibold text-neutral-700 transition-colors hover:border-orange-300 hover:text-orange-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-orange-800 dark:hover:text-orange-400"
                >
                  Jump to Latest
                </a>
              )
            }
          </div>

          <div class="mt-8 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
            <div>
              <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-50">
                {publishedArticlesCount}
              </div>
              <div class="text-xs font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                Articles
              </div>
            </div>
            <div>
              <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-50">
                {isInfiniteSeries ? "Open" : totalArticles}
              </div>
              <div class="text-xs font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                Total
              </div>
            </div>
            <div>
              <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-50">
                ~{readingMinutes}m
              </div>
              <div class="text-xs font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                Reading
              </div>
            </div>
            <div>
              <div class="truncate text-2xl font-bold capitalize text-neutral-900 dark:text-neutral-50">
                {levelText}
              </div>
              <div class="text-xs font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                Level
              </div>
            </div>
          </div>

          {
            plannedArticlesCount > 0 && (
              <div class="mt-8 max-w-xl">
                <div class="mb-2 flex items-center justify-between text-xs font-medium text-neutral-400 dark:text-neutral-500">
                  <span>Progress</span>
                  <span>{Math.round(progressPercentage)}%</span>
                </div>
                <div class="h-1.5 overflow-hidden rounded-full bg-neutral-200 dark:bg-neutral-800">
                  <div class="h-full rounded-full bg-orange-500" style={`width: ${progressPercentage}%`} />
                </div>
              </div>
            )
          }
        </div>
      </header>

      <main class="mx-auto max-w-5xl px-6 py-10">
        {
          error && (
            <div class="mb-8 rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300">
              Unable to load this series right now.
            </div>
          )
        }

        <section>
          <div class="mb-6">
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">
              Learning Path
            </h2>
            <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
              Read in order, or jump to the part you need.
            </p>
          </div>

          {
            articlesData.length > 0 ? (
              <div class="divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800">
                {articlesData.map((article, idx) => (
                  <a
                    href={article.isPublished ? `/blog/${article.slug}` : "#"}
                    class={`group flex gap-4 py-5 transition-colors ${
                      article.isPublished
                        ? "hover:bg-white/60 dark:hover:bg-neutral-900/60"
                        : "cursor-not-allowed opacity-60"
                    }`}
                    aria-disabled={!article.isPublished}
                  >
                    {article.coverImage ? (
                      <div class="h-24 w-24 shrink-0 overflow-hidden rounded-lg bg-neutral-100 dark:bg-neutral-800 sm:h-24 sm:w-36">
                        <img
                          src={article.coverImage}
                          alt={article.title}
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="flex h-24 w-16 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-lg font-bold text-neutral-400 dark:bg-neutral-800 dark:text-neutral-500">
                        {String(idx + 1).padStart(2, "0")}
                      </div>
                    )}

                    <div class="min-w-0 flex-1">
                      <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500">
                        <span class="font-semibold text-orange-600 dark:text-orange-400">
                          Part {idx + 1}
                        </span>
                        {article.tags && article.tags[0] && (
                          <>
                            <span>·</span>
                            <span>{article.tags[0]}</span>
                          </>
                        )}
                        {!article.isPublished && (
                          <>
                            <span>·</span>
                            <span>Coming soon</span>
                          </>
                        )}
                      </div>
                      <h3 class="mb-1 line-clamp-2 text-base font-semibold leading-snug text-neutral-900 transition-colors group-hover:text-orange-600 dark:text-neutral-50 dark:group-hover:text-orange-400">
                        {article.title}
                      </h3>
                      <p class="line-clamp-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                        {article.description}
                      </p>
                    </div>

                    {article.isPublished && (
                      <div class="hidden self-center text-neutral-300 transition-colors group-hover:text-orange-500 sm:block">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                          />
                        </svg>
                      </div>
                    )}
                  </a>
                ))}
              </div>
            ) : (
              <div class="rounded-lg border border-neutral-200 bg-white p-8 text-center dark:border-neutral-800 dark:bg-neutral-900">
                <h3 class="mb-2 text-lg font-semibold text-neutral-900 dark:text-neutral-50">
                  No articles published yet
                </h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  This path is being prepared. Check back soon.
                </p>
              </div>
            )
          }
        </section>

        <section class="mt-12 border-t border-neutral-200 py-10 dark:border-neutral-800">
          <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
            <div>
              <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-50">
                Keep exploring
              </h2>
              <p class="mt-1 max-w-xl text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                Find another path, or browse the full article library.
              </p>
            </div>
            <div class="flex gap-3">
              <a
                href="/series"
                class="rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 dark:bg-neutral-100 dark:text-neutral-950 dark:hover:bg-orange-400"
              >
                All Series
              </a>
              <a
                href="/blog"
                class="rounded-lg border border-neutral-200 px-5 py-2.5 text-sm font-semibold text-neutral-700 transition-colors hover:border-orange-300 hover:text-orange-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-orange-800 dark:hover:text-orange-400"
              >
                Articles
              </a>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
