---
import Layout from '../../../layouts/Layout.astro';

const { category } = Astro.params;

if (!category) {
  return Astro.redirect('/glossary');
}

const categoryName = category.charAt(0).toUpperCase() + category.slice(1);
---

<Layout 
  title={`${categoryName} Terms - Tech Glossary`}
  description={`Browse all ${categoryName.toLowerCase()} terms in our tech glossary. Learn about ${categoryName.toLowerCase()} concepts with clear definitions and examples.`}
  type="website"
>
  <main class="min-h-screen bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-[#1a1325] dark:via-[#0f172a] dark:to-[#111827]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 mb-8">
        <a href="/glossary" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Glossary</a>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-gray-900 dark:text-white font-medium">{categoryName}</span>
      </nav>

      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          <span class="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">{categoryName}</span> Terms
        </h1>
        <p id="category-description" class="text-xl text-gray-600 dark:text-gray-300 mb-6">
          Loading...
        </p>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="text-center py-12">
        <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-purple-600 mx-auto mb-4"></div>
        <p class="text-gray-600 dark:text-gray-400">Loading {categoryName.toLowerCase()} terms...</p>
      </div>

      <!-- Error State -->
      <div id="error-state" class="text-center py-12 hidden">
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-2xl p-8 max-w-md mx-auto">
          <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h2 class="text-2xl font-bold text-red-800 dark:text-red-200 mb-2">Failed to load category</h2>
          <p class="text-red-600 dark:text-red-300 mb-4">Please try refreshing the page or check back later.</p>
          <button onclick="window.location.reload()" class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition-colors mr-4">
            Retry
          </button>
          <a href="/glossary" class="inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-xl transition-colors">
            Back to Glossary
          </a>
        </div>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="text-center py-24 hidden">
        <svg class="w-24 h-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.47.901-6.067 2.379C7.477 15.8 9.64 14 12 14s4.523 1.8 6.067 3.379z"></path>
        </svg>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">No terms found</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8">
          We haven't added any {categoryName.toLowerCase()} terms yet. Check back soon!
        </p>
        <a href="/glossary" class="inline-flex items-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-2xl transition-colors">
          Browse All Terms
        </a>
      </div>

      <!-- Main Content -->
      <div id="main-content" class="hidden">
        <!-- Terms Grid -->
        <div id="terms-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          <!-- Terms will be loaded here -->
        </div>

        <!-- Load More Button -->
        <div id="load-more-container" class="text-center hidden">
          <button 
            id="load-more"
            class="px-8 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-2xl transition-colors duration-300"
          >
            Load More Terms
          </button>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ category, categoryName }}>
    // Client-side category terms loading
    document.addEventListener('DOMContentLoaded', () => {
      const BASE_URL = 'https://backend.takovibe.com/api';
      
      // DOM elements
      const loadingState = document.getElementById('loading-state');
      const errorState = document.getElementById('error-state');
      const emptyState = document.getElementById('empty-state');
      const mainContent = document.getElementById('main-content');
      const categoryDescription = document.getElementById('category-description');
      const termsGrid = document.getElementById('terms-grid');
      const loadMoreContainer = document.getElementById('load-more-container');
      const loadMoreBtn = document.getElementById('load-more');
      
      let currentPage = 1;
      let totalCount = 0;
      let isLoading = false;
      
      // Initialize the page
      initializePage();

      async function initializePage() {
        try {
          showLoading();
          await loadCategoryTerms();
        } catch (error) {
          console.error('Failed to load category terms:', error);
          showError();
        }
      }

      async function loadCategoryTerms(page = 1) {
        const response = await fetch(`${BASE_URL}/glossary/terms/?category=${encodeURIComponent(category)}&page=${page}&page_size=20`);
        if (!response.ok) throw new Error('Failed to load category terms');
        
        const data = await response.json();
        const terms = data.results || [];
        totalCount = data.count || 0;
        
        if (page === 1) {
          // Update description
          if (categoryDescription) {
            categoryDescription.textContent = `${totalCount} terms found in ${categoryName.toLowerCase()}`;
          }
          
          if (terms.length === 0) {
            showEmpty();
            return;
          }
          
          renderTerms(terms);
          showMainContent();
        } else {
          // Append more terms
          appendTerms(terms);
        }
        
        // Show/hide load more button
        if (loadMoreContainer && loadMoreBtn) {
          if (totalCount > page * 20) {
            loadMoreContainer.classList.remove('hidden');
            const remaining = totalCount - (page * 20);
            loadMoreBtn.textContent = `Load More Terms (${remaining} remaining)`;
          } else {
            loadMoreContainer.classList.add('hidden');
          }
        }
      }

      function renderTerms(terms) {
        if (termsGrid) {
          termsGrid.innerHTML = terms.map(term => createTermCard(term)).join('');
        }
      }

      function appendTerms(terms) {
        if (termsGrid) {
          termsGrid.innerHTML += terms.map(term => createTermCard(term)).join('');
        }
      }

      function createTermCard(term) {
        const difficultyColors = {
          beginner: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
          intermediate: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300',
          advanced: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300'
        };

        const difficultyColor = term.difficulty_level ? difficultyColors[term.difficulty_level] || 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-300' : '';
        const truncatedDescription = term.description.replace(/[#*`]/g, '').substring(0, 120) + (term.description.length > 120 ? '...' : '');

        return `
          <article class="group relative bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 hover:border-purple-300/50 dark:hover:border-purple-400/30 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/10 overflow-hidden">
            <div class="p-6 pb-4">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  <a href="/glossary/${term.slug}" class="hover:underline">${term.term}</a>
                </h3>
                ${term.difficulty_level ? `
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${difficultyColor}">
                    ${term.difficulty_level}
                  </span>
                ` : ''}
              </div>
              <div class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                ${truncatedDescription}
              </div>
            </div>
            
            <div class="px-6 pb-4 pt-0">
              <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                <div class="flex items-center gap-4">
                  <span class="inline-flex items-center gap-1 text-purple-600 dark:text-purple-400">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
                    </svg>
                    ${categoryName}
                  </span>
                </div>
                
                <div class="flex items-center gap-3">
                  ${term.likes > 0 ? `
                    <span class="inline-flex items-center gap-1">
                      <svg class="w-3 h-3 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                      </svg>
                      ${term.likes}
                    </span>
                  ` : ''}
                </div>
              </div>
            </div>
            
            <div class="absolute inset-0 bg-gradient-to-r from-purple-500/5 to-blue-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-2xl"></div>
          </article>
        `;
      }

      // Load more functionality
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', async () => {
          if (isLoading) return;
          
          isLoading = true;
          loadMoreBtn.textContent = 'Loading...';
          loadMoreBtn.disabled = true;
          
          try {
            currentPage++;
            await loadCategoryTerms(currentPage);
          } catch (error) {
            console.error('Failed to load more terms:', error);
            currentPage--; // Revert page increment on error
          } finally {
            isLoading = false;
            loadMoreBtn.disabled = false;
          }
        });
      }

      function showLoading() {
        loadingState?.classList.remove('hidden');
        errorState?.classList.add('hidden');
        emptyState?.classList.add('hidden');
        mainContent?.classList.add('hidden');
      }

      function showError() {
        loadingState?.classList.add('hidden');
        errorState?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
        mainContent?.classList.add('hidden');
      }

      function showEmpty() {
        loadingState?.classList.add('hidden');
        errorState?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        mainContent?.classList.add('hidden');
      }

      function showMainContent() {
        loadingState?.classList.add('hidden');
        errorState?.classList.add('hidden');
        emptyState?.classList.add('hidden');
        mainContent?.classList.remove('hidden');
      }
    });
  </script>
</Layout>