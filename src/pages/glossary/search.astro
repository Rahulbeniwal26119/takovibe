---
import Layout from '../../layouts/Layout.astro';

const searchQuery = Astro.url.searchParams.get('q') || '';
---

<Layout 
  title={`Search Results for "${searchQuery}" - Tech Glossary`}
  description={`Search results for "${searchQuery}" in our tech glossary. Find definitions and explanations for programming terms.`}
  type="website"
>
  <main class="min-h-screen bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-[#1a1325] dark:via-[#0f172a] dark:to-[#111827]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 mb-8">
        <a href="/glossary" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Glossary</a>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-gray-900 dark:text-white font-medium">Search</span>
      </nav>

      <!-- Header with Search -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Search <span class="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">Glossary</span>
        </h1>
        
        <!-- Search Bar -->
        <div class="max-w-2xl mx-auto mb-8">
          <form action="/glossary/search" method="GET" class="relative">
            <input 
              type="text" 
              name="q"
              value={searchQuery}
              placeholder="Search for terms, concepts, or technologies..." 
              class="w-full pl-12 pr-16 py-4 text-lg border border-gray-300 dark:border-gray-600 rounded-2xl bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
            />
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 h-6 w-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
            </svg>
            <button 
              type="submit"
              class="absolute right-2 top-1/2 transform -translate-y-1/2 px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-xl transition-colors"
            >
              Search
            </button>
          </form>
        </div>

        <p id="search-results-text" class="text-lg text-gray-600 dark:text-gray-300 mb-8 hidden">
          <!-- Search results text will be inserted here -->
        </p>
      </div>

      <!-- Loading State (only show when search query exists) -->
      <div id="loading-state" class="text-center py-12 ${searchQuery ? '' : 'hidden'}">
        <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-purple-600 mx-auto mb-4"></div>
        <p class="text-gray-600 dark:text-gray-400">Searching...</p>
      </div>

      <!-- Error State -->
      <div id="error-state" class="text-center py-12 hidden">
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-2xl p-8 max-w-md mx-auto">
          <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h2 class="text-2xl font-bold text-red-800 dark:text-red-200 mb-2">Search failed</h2>
          <p class="text-red-600 dark:text-red-300 mb-4">Please try again or check back later.</p>
          <button onclick="performSearch()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition-colors">
            Retry
          </button>
        </div>
      </div>

      <!-- No Results State -->
      <div id="no-results-state" class="text-center py-24 hidden">
        <svg class="w-24 h-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">No results found</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8">
          Try searching for different terms or browse our categories below.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/glossary" class="px-4 py-2 bg-purple-100 hover:bg-purple-200 dark:bg-purple-900/30 dark:hover:bg-purple-900/50 text-purple-700 dark:text-purple-300 font-medium rounded-xl transition-colors">
            Browse All Terms
          </a>
          <a href="/glossary/category/programming" class="px-4 py-2 bg-blue-100 hover:bg-blue-200 dark:bg-blue-900/30 dark:hover:bg-blue-900/50 text-blue-700 dark:text-blue-300 font-medium rounded-xl transition-colors">
            Programming
          </a>
          <a href="/glossary/category/javascript" class="px-4 py-2 bg-green-100 hover:bg-green-200 dark:bg-green-900/30 dark:hover:bg-green-900/50 text-green-700 dark:text-green-300 font-medium rounded-xl transition-colors">
            JavaScript
          </a>
        </div>
      </div>

      <!-- Search Results -->
      <div id="search-results" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 hidden">
        <!-- Search results will be loaded here -->
      </div>

      <!-- Default State (no search query) -->
      <div id="default-state" class="text-center py-24 ${searchQuery ? 'hidden' : ''}">
        <svg class="w-24 h-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Search the Glossary</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8">
          Enter a term above to search through our comprehensive tech glossary.
        </p>
        <a href="/glossary" class="inline-flex items-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-2xl transition-colors">
          Browse All Terms
        </a>
      </div>
    </div>
  </main>

  <script define:vars={{ searchQuery }}>
    // Client-side search functionality
    document.addEventListener('DOMContentLoaded', () => {
      const BASE_URL = 'https://backend.takovibe.com/api';
      
      // DOM elements
      const loadingState = document.getElementById('loading-state');
      const errorState = document.getElementById('error-state');
      const noResultsState = document.getElementById('no-results-state');
      const searchResults = document.getElementById('search-results');
      const defaultState = document.getElementById('default-state');
      const searchResultsText = document.getElementById('search-results-text');
      
      // Perform search if we have a query
      if (searchQuery && searchQuery.trim()) {
        performSearch();
      }

      async function performSearch() {
        if (!searchQuery || !searchQuery.trim()) return;
        
        try {
          showLoading();
          
          const response = await fetch(`${BASE_URL}/glossary/terms/search/?q=${encodeURIComponent(searchQuery.trim())}&limit=50`);
          if (!response.ok) throw new Error('Search failed');
          
          const data = await response.json();
          const terms = data.results || data || [];
          
          if (terms.length === 0) {
            showNoResults();
          } else {
            renderSearchResults(terms);
            showResults();
          }
        } catch (error) {
          console.error('Search failed:', error);
          showError();
        }
      }

      function renderSearchResults(terms) {
        // Update search results text
        if (searchResultsText) {
          searchResultsText.textContent = `Found ${terms.length} result${terms.length === 1 ? '' : 's'} for "${searchQuery}"`;
          searchResultsText.classList.remove('hidden');
        }
        
        // Render search results
        if (searchResults) {
          searchResults.innerHTML = terms.map(term => createTermCard(term)).join('');
        }
      }

      function createTermCard(term) {
        const difficultyColors = {
          beginner: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
          intermediate: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300',
          advanced: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300'
        };

        const difficultyColor = term.difficulty_level ? difficultyColors[term.difficulty_level] || 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-300' : '';
        const truncatedDescription = term.description.replace(/[#*`]/g, '').substring(0, 120) + (term.description.length > 120 ? '...' : '');

        return `
          <article class="group relative bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 hover:border-purple-300/50 dark:hover:border-purple-400/30 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/10 overflow-hidden">
            <div class="p-6 pb-4">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  <a href="/glossary/${term.slug}" class="hover:underline">${term.term}</a>
                </h3>
                ${term.difficulty_level ? `
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${difficultyColor}">
                    ${term.difficulty_level}
                  </span>
                ` : ''}
              </div>
              <div class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                ${highlightSearchTerm(truncatedDescription, searchQuery)}
              </div>
            </div>
            
            <div class="px-6 pb-4 pt-0">
              <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                <div class="flex items-center gap-4">
                  ${term.category ? `
                    <span class="inline-flex items-center gap-1">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
                      </svg>
                      ${term.category}
                    </span>
                  ` : ''}
                </div>
                
                <div class="flex items-center gap-3">
                  ${term.likes > 0 ? `
                    <span class="inline-flex items-center gap-1">
                      <svg class="w-3 h-3 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                      </svg>
                      ${term.likes}
                    </span>
                  ` : ''}
                </div>
              </div>
            </div>
            
            <div class="absolute inset-0 bg-gradient-to-r from-purple-500/5 to-blue-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-2xl"></div>
          </article>
        `;
      }

      function highlightSearchTerm(text, searchTerm) {
        if (!searchTerm) return text;
        
        const regex = new RegExp(`(${searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        return text.replace(regex, '<mark class="bg-yellow-200 dark:bg-yellow-900/50 text-yellow-900 dark:text-yellow-200 px-1 rounded">$1</mark>');
      }

      function showLoading() {
        loadingState?.classList.remove('hidden');
        errorState?.classList.add('hidden');
        noResultsState?.classList.add('hidden');
        searchResults?.classList.add('hidden');
        defaultState?.classList.add('hidden');
      }

      function showError() {
        loadingState?.classList.add('hidden');
        errorState?.classList.remove('hidden');
        noResultsState?.classList.add('hidden');
        searchResults?.classList.add('hidden');
        defaultState?.classList.add('hidden');
      }

      function showNoResults() {
        loadingState?.classList.add('hidden');
        errorState?.classList.add('hidden');
        noResultsState?.classList.remove('hidden');
        searchResults?.classList.add('hidden');
        defaultState?.classList.add('hidden');
        
        // Update results text
        if (searchResultsText) {
          searchResultsText.textContent = `No results found for "${searchQuery}"`;
          searchResultsText.classList.remove('hidden');
        }
      }

      function showResults() {
        loadingState?.classList.add('hidden');
        errorState?.classList.add('hidden');
        noResultsState?.classList.add('hidden');
        searchResults?.classList.remove('hidden');
        defaultState?.classList.add('hidden');
      }

      // Make performSearch globally accessible for retry button
      window.performSearch = performSearch;
    });
  </script>
    </div>
  </main>
</Layout>