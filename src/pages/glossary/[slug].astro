---
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/glossary');
}
---

<Layout 
  title="Loading Term - Tech Glossary"
  description="Loading glossary term definition and examples."
  type="article"
  author="TakoVibe"
>
  <main class="min-h-screen bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-[#1a1325] dark:via-[#0f172a] dark:to-[#111827]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      
      <!-- Loading State -->
      <div id="loading-state" class="text-center py-24">
        <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-purple-600 mx-auto mb-4"></div>
        <p class="text-gray-600 dark:text-gray-400">Loading term...</p>
      </div>

      <!-- Error State -->
      <div id="error-state" class="text-center py-24 hidden">
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-2xl p-8 max-w-md mx-auto">
          <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h1 class="text-2xl font-bold text-red-800 dark:text-red-200 mb-2">Term not found</h1>
          <p class="text-red-600 dark:text-red-300 mb-4">The requested glossary term could not be loaded.</p>
          <a href="/glossary" class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition-colors">
            Back to Glossary
          </a>
        </div>
      </div>

      <!-- Main Content -->
      <div id="main-content" class="hidden">
      </div>
    </div>
  </main>

  <script define:vars={{ slug }}>
    // Client-side term loading
    document.addEventListener('DOMContentLoaded', () => {
      const BASE_URL = 'https://backend.takovibe.com/api';
      
      // DOM elements
      const loadingState = document.getElementById('loading-state');
      const errorState = document.getElementById('error-state');
      const mainContent = document.getElementById('main-content');
      
      let currentTerm = null;

      // Initialize the page
      initializePage();

      async function initializePage() {
        try {
          showLoading();
          await loadTerm();
          showMainContent();
        } catch (error) {
          console.error('Failed to load term:', error);
          showError();
        }
      }

      async function loadTerm() {
        const response = await fetch(`${BASE_URL}/glossary/terms/${slug}/`);
        if (!response.ok) throw new Error('Failed to load term');
        
        currentTerm = await response.json();
        
        // Update page title
        document.title = `${currentTerm.term} - Tech Glossary`;
        
        // Update meta description
        const metaDesc = document.querySelector('meta[name="description"]');
        if (metaDesc) {
          metaDesc.content = `Learn about ${currentTerm.term}: ${currentTerm.description.substring(0, 150).replace(/[#*`]/g, '')}...`;
        }
        
        // Render the term
        renderTerm(currentTerm);
        
        // Load related terms
        loadRelatedTerms();
      }

      async function loadRelatedTerms() {
        try {
          const response = await fetch(`${BASE_URL}/glossary/terms/${slug}/related/`);
          if (response.ok) {
            const data = await response.json();
            const relatedTerms = data.results || data || [];
            renderRelatedTerms(relatedTerms);
          }
        } catch (error) {
          console.error('Failed to load related terms:', error);
        }
      }

      function renderTerm(term) {
        const difficultyColors = {
          beginner: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
          intermediate: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300',
          advanced: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300'
        };

        const difficultyColor = term.difficulty_level ? difficultyColors[term.difficulty_level] || 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-300' : '';
        
        const formatDate = (dateString) => {
          const date = new Date(dateString);
          return date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
        };

        const html = `
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 mb-8">
            <a href="/glossary" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Glossary</a>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            ${term.category ? `
              <a href="/glossary/category/${term.category.toLowerCase()}" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                ${term.category}
              </a>
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
            ` : ''}
            <span class="text-gray-900 dark:text-white font-medium">${term.term}</span>
          </nav>

          <!-- Term Header -->
          <header class="mb-12">
            <div class="bg-white dark:bg-gray-900/50 rounded-3xl border border-gray-200/70 dark:border-gray-700/50 p-8">
              <div class="flex items-start justify-between gap-6 mb-6">
                <div class="flex-1">
                  <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
                    ${term.term}
                  </h1>
                  
                  <div class="flex flex-wrap items-center gap-4 mb-6">
                    ${term.difficulty_level ? `
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${difficultyColor}">
                        ${term.difficulty_level}
                      </span>
                    ` : ''}
                    
                    ${term.category ? `
                      <span class="inline-flex items-center gap-1 px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-sm font-medium">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
                        </svg>
                        ${term.category}
                      </span>
                    ` : ''}
                    
                    ${term.tags && term.tags.length > 0 ? term.tags.map(tag => `
                      <span class="inline-flex items-center px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-lg text-xs font-medium">
                        #${tag}
                      </span>
                    `).join('') : ''}
                  </div>
                </div>
                
                <!-- Like Button -->
                <div class="flex flex-col items-center gap-2">
                  <button 
                    id="like-btn"
                    data-slug="${term.slug}"
                    class="group p-3 bg-gray-100 hover:bg-red-100 dark:bg-gray-800 dark:hover:bg-red-900/30 rounded-2xl transition-all duration-300"
                  >
                    <svg class="w-6 h-6 text-gray-600 group-hover:text-red-500 dark:text-gray-400 dark:group-hover:text-red-400" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                    </svg>
                  </button>
                  <span id="like-count" class="text-sm font-medium text-gray-600 dark:text-gray-400">
                    ${term.likes}
                  </span>
                </div>
              </div>
              
              <!-- Meta Info -->
              <div class="flex items-center gap-6 text-sm text-gray-600 dark:text-gray-400">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                  </svg>
                  <span>Updated: ${formatDate(term.updated_at)}</span>
                </div>
                
                ${term.external_references && term.external_references.length > 0 ? `
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
                      <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
                    </svg>
                    <span>${term.external_references.length} references</span>
                  </div>
                ` : ''}
              </div>
            </div>
          </header>

          <!-- Term Content -->
          <div class="grid lg:grid-cols-3 gap-8">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-8">
              <!-- Description -->
              <section class="bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 p-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Definition</h2>
                <div class="prose prose-lg dark:prose-invert max-w-none">${term.description}</div>
              </section>

              ${term.code_snippets && term.code_snippets.length > 0 ? `
                <!-- Code Examples -->
                <section class="bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 p-8">
                  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Code Examples</h2>
                  <div class="space-y-6">
                    ${term.code_snippets.map((snippet, index) => `
                      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4">
                        ${snippet}
                      </div>
                    `).join('')}
                  </div>
                </section>
              ` : ''}

              ${term.external_references && term.external_references.length > 0 ? `
                <!-- External References -->
                <section class="bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 p-8">
                  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">References</h2>
                  <div class="space-y-4">
                    ${term.external_references.map(ref => `
                      <a 
                        href="${ref.url}" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="group block p-4 bg-gray-50 dark:bg-gray-800/50 rounded-xl hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-all duration-300"
                      >
                        <div class="flex items-start gap-4">
                          <div class="flex-shrink-0 mt-1">
                            <svg class="w-5 h-5 text-gray-400 group-hover:text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
                              <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
                            </svg>
                          </div>
                          <div class="flex-1">
                            <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400">
                              ${ref.title}
                            </h3>
                            ${ref.description ? `<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">${ref.description}</p>` : ''}
                            ${ref.type ? `
                              <span class="inline-flex items-center px-2 py-1 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded text-xs font-medium mt-2">
                                ${ref.type}
                              </span>
                            ` : ''}
                          </div>
                        </div>
                      </a>
                    `).join('')}
                  </div>
                </section>
              ` : ''}
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
              <!-- Related Terms -->
              <section id="related-terms" class="bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 p-6 hidden">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Related Terms</h3>
                <div id="related-terms-content" class="space-y-4">
                  <!-- Related terms will be loaded here -->
                </div>
              </section>
              
              <!-- Quick Actions -->
              <div class="bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 p-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Quick Actions</h3>
                <div class="space-y-3">
                  <a href="/glossary" class="flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-colors group">
                    <svg class="w-5 h-5 text-gray-600 group-hover:text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0L3 11.414A2 2 0 013 8.586L6.586 5a2 2 0 012.828 0l3 3a2 2 0 010 2.828L9.172 14.172a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="font-medium text-gray-900 dark:text-white group-hover:text-purple-600">Browse All Terms</span>
                  </a>
                  
                  ${term.category ? `
                    <a href="/glossary/category/${term.category.toLowerCase()}" class="flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-colors group">
                      <svg class="w-5 h-5 text-gray-600 group-hover:text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
                      </svg>
                      <span class="font-medium text-gray-900 dark:text-white group-hover:text-purple-600">More in ${term.category}</span>
                    </a>
                  ` : ''}
                </div>
              </div>
            </div>
          </div>
        `;
        
        if (mainContent) {
          mainContent.innerHTML = html;
        }
        
        // Setup like button functionality
        setupLikeButton();
      }

      function renderRelatedTerms(relatedTerms) {
        if (relatedTerms.length === 0) return;
        
        const relatedSection = document.getElementById('related-terms');
        const relatedContent = document.getElementById('related-terms-content');
        
        if (relatedSection && relatedContent) {
          relatedContent.innerHTML = relatedTerms.map(term => createTermCard(term, false)).join('');
          relatedSection.classList.remove('hidden');
        }
      }

      function createTermCard(term, showDescription = true) {
        const difficultyColors = {
          beginner: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
          intermediate: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300',
          advanced: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300'
        };

        const difficultyColor = term.difficulty_level ? difficultyColors[term.difficulty_level] || 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-300' : '';
        
        return `
          <article class="group relative bg-white dark:bg-gray-900/50 rounded-2xl border border-gray-200/70 dark:border-gray-700/50 hover:border-purple-300/50 dark:hover:border-purple-400/30 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/10 overflow-hidden">
            <div class="p-4">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h4 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  <a href="/glossary/${term.slug}" class="hover:underline">${term.term}</a>
                </h4>
                ${term.difficulty_level ? `
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${difficultyColor}">
                    ${term.difficulty_level}
                  </span>
                ` : ''}
              </div>
            </div>
          </article>
        `;
      }

      function setupLikeButton() {
        const likeBtn = document.getElementById('like-btn');
        const likeCount = document.getElementById('like-count');
        
        if (likeBtn && likeCount) {
          likeBtn.addEventListener('click', async () => {
            const slug = likeBtn.dataset.slug;
            if (!slug) return;
            
            try {
              const response = await fetch(`${BASE_URL}/glossary/terms/${slug}/like/`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                }
              });
              
              if (response.ok) {
                const data = await response.json();
                likeCount.textContent = data.likes.toString();
                
                // Add animation
                likeBtn.classList.add('animate-pulse');
                setTimeout(() => likeBtn.classList.remove('animate-pulse'), 500);
              }
            } catch (error) {
              console.error('Failed to like term:', error);
            }
          });
        }
      }

      function showLoading() {
        loadingState?.classList.remove('hidden');
        errorState?.classList.add('hidden');
        mainContent?.classList.add('hidden');
      }

      function showError() {
        loadingState?.classList.add('hidden');
        errorState?.classList.remove('hidden');
        mainContent?.classList.add('hidden');
      }

      function showMainContent() {
        loadingState?.classList.add('hidden');
        errorState?.classList.add('hidden');
        mainContent?.classList.remove('hidden');
      }
    });
  </script>
</Layout>