---
import Layout from './Layout.astro';
import BlogHeader from '../components/BlogHeader.astro';

interface Props {
  title: string;
  date: string;
  author: string;
  image?: string;
  description?: string;
}

const { title, date, author, image, description } = Astro.props.frontmatter || Astro.props;
---

<Layout title={title}>
  <BlogHeader title={title} />
  <article class="max-w-4xl mx-auto px-4 py-8">
    {image && (
      <img src={image} alt={title} class="w-full h-96 object-cover rounded-lg mb-8" />
    )}
    <div class="prose prose-invert lg:prose-lg max-w-none">
      <div class="mb-8 text-gray-400">
        <time>{new Date(date).toLocaleDateString('en-US', { 
          year: 'numeric', 
          month: 'long', 
          day: 'numeric' 
        })}</time>
        <span> · By {author}</span>
      </div>
      {description && (
        <p class="text-xl text-gray-300 mb-8">{description}</p>
      )}
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  .prose {
    @apply mx-auto;
  }
  .prose img {
    @apply rounded-lg shadow-md my-8;
  }
  .prose video {
    @apply rounded-lg shadow-md my-8 w-full;
  }
  .prose iframe {
    @apply rounded-lg shadow-md my-8 w-full aspect-video;
  }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    @apply text-gray-100 font-bold;
  }
  .prose p {
    @apply text-gray-300;
  }
  .prose a {
    @apply text-purple-400 hover:text-purple-300 transition-colors;
  }
  .prose pre {
    @apply rounded-lg shadow-md bg-gray-800;
  }
  .prose blockquote {
    @apply border-l-4 border-purple-500 bg-gray-800/50;
  }
  .prose table {
    @apply border-collapse border border-gray-700;
  }
  .prose th, .prose td {
    @apply border border-gray-700 px-4 py-2;
  }
  .prose thead {
    @apply bg-gray-800;
  }
  .prose tbody tr:nth-child(even) {
    @apply bg-gray-800/30;
  }
</style>