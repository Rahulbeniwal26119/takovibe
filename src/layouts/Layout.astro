<style is:global>
  :root {
    --background: #ffffff;
    --text: #1a1a1a;
  }

  :root.dark {
    --background: #1a1a1a;
    --text: #ffffff;
  }

  html {
    background-color: var(--background);
    color: var(--text);
  }

  body {
    margin: 0;
    padding: 0;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  html, body {
    overflow-x: hidden;
    width: 100%;
    position: relative;
  }
</style>
