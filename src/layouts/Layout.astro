<style is:global>
    :root {
        --cherry-light: #ffffff;
        --cherry-medium: #f8fafc;
        --cherry-accent: #9f7aea;
        --cherry-dark: #6b46c1;
        --zen-text: #1a1a1a;
        --zen-light: #ffffff;
        --zen-shadow: rgba(111, 63, 231, 0.08);
    }

    :root.dark {
        --cherry-light: #171923;
        --cherry-medium: #1a202c;
        --cherry-accent: #9f7aea;
        --cherry-dark: #b794f4;
        --zen-text: #f8fafc;
        --zen-light: #171923;
        --zen-shadow: rgba(159, 122, 234, 0.15);
    }

    /* Fix PageSpeed font-display issue for Assistant font (Excalidraw) */
    @font-face {
        font-family: "Assistant";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/Assistant-Regular.woff2") format("woff2");
    }

    @font-face {
        font-family: "Assistant";
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url("/fonts/Assistant-Medium.woff2") format("woff2");
    }

    html {
        background: linear-gradient(
            135deg,
            var(--cherry-light) 0%,
            var(--cherry-medium) 100%
        );
        color: var(--zen-text);
        font-family: "Space Grotesk", sans-serif;
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        transition:
            background-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
            color 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        background: transparent;
    }

    .zen-body {
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 1) 0%,
            rgba(248, 250, 252, 0.95) 100%
        );
    }

    .dark .zen-body {
        background: linear-gradient(
            135deg,
            rgba(17, 17, 17, 1) 0%,
            rgba(26, 26, 26, 0.98) 100%
        );
    }

    /* Invisible Scrollbar (User Preference) */
    html {
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
    }

    ::-webkit-scrollbar {
        display: none; /* Chrome, Safari and Opera */
    }

    /* Smooth transitions */
    * {
        transition-property:
            background-color, border-color, color, fill, stroke, opacity,
            box-shadow, transform;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 200ms;
    }

    /* Purple glow effect on hover */
    .hover-glow:hover {
        box-shadow: 0 0 20px rgba(159, 122, 234, 0.2);
    }

    .dark .hover-glow:hover {
        box-shadow: 0 0 20px rgba(183, 148, 244, 0.2);
    }

    /* Zen text selection */
    ::selection {
        background: var(--cherry-accent);
        color: white;
    }

    html,
    body {
        width: 100%;
        position: relative;
    }

    /* Additional zen elements */
    .zen-gradient {
        background: linear-gradient(
            135deg,
            var(--cherry-light),
            var(--cherry-medium)
        );
    }

    .zen-shadow {
        box-shadow: 0 4px 20px var(--zen-shadow);
    }

    /* Shiki Code Block Theme Handling */
    :root {
        --shiki-light-bg: #ffffff;
        --shiki-dark-bg: #0d1117;
        --shiki-light: #24292e;
        --shiki-dark: #e1e4e8;
    }

    /* 
     * Shiki generates code like:
     * <pre class="shiki" style="--shiki-light: #...; --shiki-dark: #...; color: var(--shiki-light); ...">
     * Reference: https://shiki.style/guide/dual-themes#variable-based-approach
     */

    html.dark .shiki {
        background-color: var(--shiki-dark-bg) !important;
        color: var(--shiki-dark) !important;
    }

    html.dark .shiki span {
        color: var(--shiki-dark) !important;
        font-style: var(--shiki-dark-font-style) !important;
        font-weight: var(--shiki-dark-font-weight) !important;
        text-decoration: var(--shiki-dark-text-decoration) !important;
    }

    /* Remove manual prose overrides that might conflict */
    .prose pre {
        background-color: transparent !important; /* Let shiki vars handle it */
    }

    .zen-border {
        border: 1px solid rgba(59, 130, 246, 0.2);
    }

    /* Global Image placeholder styles */
    .image-placeholder {
        background: linear-gradient(135deg, #1e1b4b, #3730a3, #1e40af);
        background-size: 400% 400%;
        animation: gradientShift 4s ease infinite;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(79, 70, 229, 0.3);
        border-radius: 0.75rem;
        position: relative;
        overflow: hidden;
        min-height: 200px;
    }

    .dark .image-placeholder {
        background: linear-gradient(135deg, #0f0f23, #1e1b4b, #312e81);
        border-color: rgba(99, 102, 241, 0.4);
    }

    @keyframes gradientShift {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    .image-placeholder::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.1),
            transparent
        );
        animation: shimmer 3s infinite;
    }

    @keyframes shimmer {
        0% {
            left: -100%;
        }
        100% {
            left: 100%;
        }
    }

    .image-placeholder-content {
        color: #e0e7ff;
        text-align: center;
        padding: 2rem;
        z-index: 2;
        position: relative;
    }

    .dark .image-placeholder-content {
        color: #c7d2fe;
    }

    .tech-icon-container {
        width: 4rem;
        height: 4rem;
        margin: 0 auto 1rem;
        position: relative;
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    .tech-icon {
        width: 100%;
        height: 100%;
        opacity: 0.9;
        filter: drop-shadow(0 0 10px rgba(139, 92, 246, 0.5));
    }

    .placeholder-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #a78bfa, #c084fc, #f472b6);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: titleGlow 2s ease-in-out infinite alternate;
    }

    @keyframes titleGlow {
        from {
            filter: brightness(1);
        }
        to {
            filter: brightness(1.2);
        }
    }

    .placeholder-subtitle {
        font-size: 0.875rem;
        opacity: 0.8;
        font-weight: 400;
    }

    .tech-particles {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        pointer-events: none;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(139, 92, 246, 0.6);
        border-radius: 50%;
        animation: particleFloat 4s linear infinite;
    }

    @keyframes particleFloat {
        0% {
            transform: translateY(100vh) rotate(0deg);
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        90% {
            opacity: 1;
        }
        100% {
            transform: translateY(-10px) rotate(360deg);
            opacity: 0;
        }
    }

    /* Enhanced image loading states */
    img[data-loading="true"] {
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    img[data-loaded="true"] {
        opacity: 1;
    }

    img[data-error="true"] {
        display: none;
    }
    /* Orbit Animations */
    @keyframes orbit {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes orbit-reverse {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(-360deg);
        }
    }

    .animate-orbit-slow {
        animation: orbit 40s linear infinite;
    }

    .animate-orbit-reverse-slow {
        animation: orbit-reverse 40s linear infinite;
    }

    /* Pause orbit on hover for better interaction */
    .hover-pause:hover .animate-orbit-slow,
    .hover-pause:hover .animate-orbit-reverse-slow {
        animation-play-state: paused;
    }
</style>
