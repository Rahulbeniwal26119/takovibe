---
import Header from "../components/Header.astro";
import AnimatedBackground from "../components/AnimatedBackground.astro";
import CursorEffect from "../components/CursorEffect.astro";
import FloatingElements from "../components/FloatingElements.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import Newsletter from "../components/Newsletter.astro";
import Footer from "../components/Footer.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import EnhancedNotes from '../components/EnhancedNotes.astro';
import PomodoroTimer from '../components/PomodoroTimer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Professional Tech Blog" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="text-gray-100 min-h-screen overflow-x-hidden">
    <Header />
    <main
      class="min-h-screen pt-14 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100"
    >
      <ReadingProgress />
      <AnimatedBackground />
      <FloatingElements />
      <CursorEffect />
      <!-- <MusicPlayer /> -->
      <!-- <EnhancedNotes /> -->
      <!-- <PomodoroTimer /> -->
      <div class="relative z-10 mx-auto">
        <slot />
      </div>
    </main>
    <!-- <Footer /> -->
  </body>
</html>

<script is:inline>
  // Handle initial theme
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  if (theme === "light") {
    document.documentElement.classList.remove("dark");
  } else {
    document.documentElement.classList.add("dark");
  }

  window.localStorage.setItem("theme", theme);
</script>

<style is:global>
  :root {
    --background: #ffffff;
    --text: #1a1a1a;
  }

  :root.dark {
    --background: #1a1a1a;
    --text: #ffffff;
  }

  html {
    background-color: var(--background);
    color: var(--text);
  }

  body {
    margin: 0;
    padding: 0;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  html, body {
    overflow-x: hidden;
    width: 100%;
    position: relative;
  }
</style>
