---
import ErrorBoundary from "../components/ErrorBoundary.astro";
import Header from "../components/Header.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import Footer from "../components/Footer.astro";
import LoginPromptModal from "../components/LoginPromptModal";
import ScrollIndicator from "../components/ScrollIndicator";

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: "website" | "article" | "profile";
    tags?: string[];
    author?: string;
    noAds?: boolean;
    published_date?: string;
    modified_date?: string;
    no_footer?: boolean;
    no_header?: boolean;
    minimal?: boolean;
}

const {
    title,
    description,
    image,
    type = "website",
    noAds = false,
    author = "TakoVibe",
    tags = [],
    published_date = new Date().toISOString(),
    modified_date,
    no_footer = false,
    no_header = false,
    minimal = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Prepare structured data
const structuredData = {
    "@context": "https://schema.org",
    "@type": type === "article" ? "BlogPosting" : "WebPage",
    headline: title,
    description: description,
    image: image
        ? image.startsWith("http")
            ? image
            : new URL(image, Astro.site).toString()
        : "https://takovibe.com/images/default-og.png",
    author: {
        "@type": "Person",
        name: author,
    },
    publisher: {
        "@type": "Organization",
        name: "TakoVibe",
        logo: {
            "@type": "ImageObject",
            url: "https://takovibe.com/images/logo.png",
        },
    },
    datePublished: published_date,
    ...(modified_date && { dateModified: modified_date }),
    url: canonicalURL.toString(),
};
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="author" content={author} />
        <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content={type} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content={image
                ? image.startsWith("http")
                    ? image
                    : new URL(image, Astro.site).toString()
                : "https://takovibe.com/images/default-og.png"}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="TakoVibe" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={image
                ? image.startsWith("http")
                    ? image
                    : new URL(image, Astro.site).toString()
                : "https://takovibe.com/images/default-og.png"}
        />
        <meta name="twitter:image:alt" content={`Cover image for ${title}`} />

        <!-- Article specific meta tags (for blog posts) -->
        {
            type === "article" && (
                <>
                    {published_date && (
                        <meta
                            property="article:published_time"
                            content={published_date}
                        />
                    )}
                    {modified_date && (
                        <meta
                            property="article:modified_time"
                            content={modified_date}
                        />
                    )}
                    <meta
                        property="article:author"
                        content="https://takovibe.com/about/"
                    />
                    <meta property="article:section" content={tags?.[0]} />
                    {tags.map((tag) => (
                        <meta property="article:tag" content={tag} />
                    ))}
                    <meta
                        property="og:image:alt"
                        content={`Cover image for ${title}`}
                    />
                </>
            )
        }

        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
            />
        </noscript>

        <!-- Font preconnect for performance -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
                rel="stylesheet"
            />
        </noscript>
        <meta name="generator" content={Astro.generator} />
        <meta name="generator" content={Astro.generator} />
        <title>
            {
                type === "article" || type === "profile"
                    ? `${title} | ${author} | TakoVibe`
                    : title
            }
        </title>

        <slot name="head" />

        <!-- Schema.org markup for Google -->
        {
            type !== "article" && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(structuredData)}
                />
            )
        }

        {/* Add AdSense script only if noAds is false */}
        <!-- {!noAds && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4238071991829602"
        crossorigin="anonymous"
      ></script>
    )} -->

        <script is:inline>
            // Immediate theme application to prevent flash
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);
        </script>

        <style is:global>
            ::view-transition-old(root),
            ::view-transition-new(root) {
                animation: none;
                mix-blend-mode: normal;
            }
            ::view-transition-old(root) {
                z-index: 1;
            }
            ::view-transition-new(root) {
                z-index: 9999;
            }
            .dark::view-transition-old(root) {
                z-index: 9999;
            }
            .dark::view-transition-new(root) {
                z-index: 1;
            }

            /* Zen Mode Styles - Enhanced */
            body.zen-mode #site-header,
            body.zen-mode footer,
            body.zen-mode .reading-progress,
            body.zen-mode .announcement-banner {
                display: none !important;
            }

            body.zen-mode main {
                padding-top: 0 !important;
                z-index: 50;
            }

            /* Editor Container: Keep background full screen, minimize top padding */
            body.zen-mode #editor-container {
                padding-top: 1.5rem !important;
                max-width: none !important;
                width: 100% !important;
            }

            /* Inner Content: Expand significantly */
            body.zen-mode #editor-container > div {
                max-width: 95vw !important; /* Almost full width */
                transition: max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
        </style>
    </head>
    <body
        class="text-gray-900 dark:text-gray-100 min-h-screen zen-body notranslate"
    >
        {!no_header && !minimal && <Header />}
        <ReadingProgress />

        <main
            class="bg-white dark:bg-[#171923] text-black dark:text-white relative z-10"
        >
            <!-- Gradient Overlay -->
            <div
                class="fixed inset-0 pointer-events-none opacity-50 dark:opacity-30"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_0%_0%,rgba(159,122,234,0.15),transparent_50%)]"
                >
                </div>
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_100%_100%,rgba(183,148,244,0.15),transparent_50%)]"
                >
                </div>
            </div>
            <div class="relative z-20 mx-auto">
                <ErrorBoundary>
                    <slot />
                </ErrorBoundary>
            </div>
        </main>
        {!no_footer && <Footer />}
        <ScrollIndicator client:idle />
        <LoginPromptModal client:idle />
    </body>
</html>

