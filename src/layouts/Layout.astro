---
import Header from "../components/Header.astro";
import CursorEffect from "../components/CursorEffect.astro";
import FloatingElements from "../components/FloatingElements.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import Footer from "../components/Footer.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import PomodoroTimer from "../components/PomodoroTimer.astro";
import AnimatedBackground from "../components/AnimatedBackground.astro";
import ErrorBoundary from "../components/ErrorBoundary.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  tags?: string[];
  author?: string;
  noAds?: boolean;
  published_date?: string;
  modified_date?: string;
  no_footer?: boolean;
  no_header?: boolean;
}

const {
  title, 
  description,
  image = "https://takovibe.com/images/logo.svg",
  type,
  noAds = false,
  author = "Rahul Beniwal",
  tags = [],
  published_date = new Date().toISOString(),
  modified_date,
  no_footer = false,
  no_header = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Prepare structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? "BlogPosting" : "WebPage",
  "headline": title,
  "description": description,
  "image": image.startsWith('http') ? image : new URL(image, Astro.site).toString(),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "TakoVibe",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/images/logo.svg", Astro.site).toString()
    }
  },
  "datePublished": published_date,
  ...(modified_date && { "dateModified": modified_date }),
  "url": canonicalURL.toString()
};
---

<!doctype html>
<html lang="en" class="dark overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : new URL(image, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="TakoVibe" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith('http') ? image : new URL(image, Astro.site).toString()} />
    <meta name="twitter:image:alt" content={`Cover image for ${title}`} />
    <!-- <meta name="twitter:site" content="@takovibe" /> -->
    
    <!-- Article specific meta tags (for blog posts) -->
    {type === 'article' && (
      <>
        { published_date && (
          <meta property="article:published_time" content={published_date} />
        )}
        { modified_date && (
          <meta property="article:modified_time" content={modified_date} />
        )}
        <meta property="article:author" content={author} />
        {tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
        <meta property="og:image:alt" content={`Cover image for ${title}`} />
      </>
    )}
    
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    />
    
    <!-- Font preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <slot name="head" />

    <!-- Schema.org markup for Google -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    {/* Add AdSense script only if noAds is false */}
    {!noAds && (
      <script 
        async 
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4238071991829602"
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="text-gray-900 dark:text-gray-100 min-h-screen overflow-x-hidden zen-body">
    {!no_header && <Header />}
    <ReadingProgress />

    <main
      class="bg-white dark:bg-[#171923] text-black dark:text-white pt-[104px] md:pt-[112px] relative z-10"
    >
      <!-- Gradient Overlay -->
      <div class="fixed inset-0 pointer-events-none opacity-50 dark:opacity-30">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_0%_0%,rgba(159,122,234,0.15),transparent_50%)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_100%_100%,rgba(183,148,244,0.15),transparent_50%)]"></div>
      </div>
      <div class="relative z-20 mx-auto">
        <ErrorBoundary>
          <slot />
        </ErrorBoundary>
      </div>
    </main>
    {!no_footer && <Footer />}
  </body>
</html>

