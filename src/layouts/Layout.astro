<style is:global>
  :root {
    --cherry-light: #ffffff;
    --cherry-medium: #f8fafc;
    --cherry-accent: #9F7AEA;
    --cherry-dark: #6B46C1;
    --zen-text: #1a1a1a;
    --zen-light: #ffffff;
    --zen-shadow: rgba(111, 63, 231, 0.08);
  }

  :root.dark {
    --cherry-light: #171923;
    --cherry-medium: #1A202C;
    --cherry-accent: #9F7AEA;
    --cherry-dark: #B794F4;
    --zen-text: #f8fafc;
    --zen-light: #171923;
    --zen-shadow: rgba(159, 122, 234, 0.15);
  }

  html {
    background: linear-gradient(135deg, var(--cherry-light) 0%, var(--cherry-medium) 100%);
    color: var(--zen-text);
    font-family: 'Space Grotesk', sans-serif;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    background: transparent;
  }

  .zen-body {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 1) 0%,
      rgba(248, 250, 252, 0.95) 100%
    );
  }

  .dark .zen-body {
    background: linear-gradient(
      135deg,
      rgba(17, 17, 17, 1) 0%,
      rgba(26, 26, 26, 0.98) 100%
    );
  }

  /* Minimal scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
  }

  .dark ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.3);
  }

  .dark ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* Smooth transitions */
  * {
    transition-property: background-color, border-color, color, fill, stroke, opacity, box-shadow, transform;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 200ms;
  }

  /* Purple glow effect on hover */
  .hover-glow:hover {
    box-shadow: 0 0 20px rgba(159, 122, 234, 0.2);
  }
  
  .dark .hover-glow:hover {
    box-shadow: 0 0 20px rgba(183, 148, 244, 0.2);
  }

  /* Zen text selection */
  ::selection {
    background: var(--cherry-accent);
    color: white;
  }

  html, body {
    overflow-x: hidden;
    width: 100%;
    position: relative;
  }

  /* Additional zen elements */
  .zen-gradient {
    background: linear-gradient(135deg, var(--cherry-light), var(--cherry-medium));
  }

  .zen-shadow {
    box-shadow: 0 4px 20px var(--zen-shadow);
  }

  .zen-border {
    border: 1px solid rgba(59, 130, 246, 0.2);
  }
</style>
