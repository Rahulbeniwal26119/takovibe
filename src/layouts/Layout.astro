---
import Header from "../components/Header.astro";
import CursorEffect from "../components/CursorEffect.astro";
import FloatingElements from "../components/FloatingElements.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import Footer from "../components/Footer.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import PomodoroTimer from "../components/PomodoroTimer.astro";
import AnimatedBackground from "../components/AnimatedBackground.astro";
import ErrorBoundary from "../components/ErrorBoundary.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  tags?: string[];
  author?: string;
  noAds?: boolean;
  published_date?: string;
  modified_date?: string;
  no_footer?: boolean;
  no_header?: boolean;
}

const {
  title, 
  description,
  image = "https://takovibe.com/images/logo.svg",
  type,
  noAds = false,
  author = "Rahul Beniwal",
  tags = [],
  published_date = new Date().toISOString(),
  modified_date,
  no_footer = false,
  no_header = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Prepare structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? "BlogPosting" : "WebPage",
  "headline": title,
  "description": description,
  "image": image.startsWith('http') ? image : new URL(image, Astro.site).toString(),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "TakoVibe",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/images/logo.svg", Astro.site).toString()
    }
  },
  "datePublished": published_date,
  ...(modified_date && { "dateModified": modified_date }),
  "url": canonicalURL.toString()
};
---

<!doctype html>
<html lang="en" class="dark overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : new URL(image, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="TakoVibe" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith('http') ? image : new URL(image, Astro.site).toString()} />
    <meta name="twitter:image:alt" content={`Cover image for ${title}`} />
    <!-- <meta name="twitter:site" content="@takovibe" /> -->
    
    <!-- Article specific meta tags (for blog posts) -->
    {type === 'article' && (
      <>
        { published_date && (
          <meta property="article:published_time" content={published_date} />
        )}
        { modified_date && (
          <meta property="article:modified_time" content={modified_date} />
        )}
        <meta property="article:author" content={author} />
        {tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
        <meta property="og:image:alt" content={`Cover image for ${title}`} />
      </>
    )}
    
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    />
    
    <!-- Font preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <slot name="head" />

    <!-- Schema.org markup for Google -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    {/* Add AdSense script only if noAds is false */}
    <!-- {!noAds && (
      <script 
        async 
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4238071991829602"
        crossorigin="anonymous"
      ></script>
    )} -->
  </head>
  <body class="text-gray-900 dark:text-gray-100 min-h-screen overflow-x-hidden zen-body">
    {!no_header && <Header />}
    <ReadingProgress />

    <main
      class="bg-white dark:bg-[#171923] text-black dark:text-white pt-[104px] md:pt-[112px] relative z-10"
    >
      <!-- Gradient Overlay -->
      <div class="fixed inset-0 pointer-events-none opacity-50 dark:opacity-30">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_0%_0%,rgba(159,122,234,0.15),transparent_50%)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_100%_100%,rgba(183,148,244,0.15),transparent_50%)]"></div>
      </div>
      <div class="relative z-20 mx-auto">
        <ErrorBoundary>
          <slot />
        </ErrorBoundary>
      </div>
    </main>
    {!no_footer && <Footer />}
    
    <!-- Global Image Placeholder Script -->
    <script is:inline>
      // Setup image placeholders globally
      document.addEventListener('DOMContentLoaded', function() {
        setupGlobalImagePlaceholders();
      });

      function setupGlobalImagePlaceholders() {
        // Handle existing images
        document.querySelectorAll('img').forEach(setupImageErrorHandling);
        
        // Setup mutation observer for dynamically added images
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              if (node.nodeType === Node.ELEMENT_NODE) {
                const element = node;
                if (element.querySelectorAll) {
                  const images = element.querySelectorAll('img');
                  images.forEach(setupImageErrorHandling);
                }
                if (element.tagName === 'IMG') {
                  setupImageErrorHandling(element);
                }
              }
            });
          });
        });
        
        observer.observe(document.body, { childList: true, subtree: true });
      }

      function setupImageErrorHandling(img) {
        if (img.dataset.placeholderSetup) return; // Already setup
        
        img.dataset.placeholderSetup = 'true';
        img.dataset.loading = 'true';
        
        const handleLoad = () => {
          img.dataset.loading = 'false';
          img.dataset.loaded = 'true';
        };
        
        const handleError = () => {
          img.dataset.loading = 'false';
          img.dataset.error = 'true';
          
          // Create placeholder
          const placeholder = createImagePlaceholder(img);
          if (img.parentNode) {
            img.parentNode.insertBefore(placeholder, img);
          }
        };
        
        // Remove existing listeners to avoid duplicates
        img.removeEventListener('load', handleLoad);
        img.removeEventListener('error', handleError);
        
        // Add new listeners
        img.addEventListener('load', handleLoad);
        img.addEventListener('error', handleError);
        
        // Check if image is already loaded
        if (img.complete) {
          if (img.naturalWidth === 0) {
            handleError();
          } else {
            handleLoad();
          }
        }
      }

      function createImagePlaceholder(originalImg) {
        const placeholder = document.createElement('div');
        placeholder.className = 'image-placeholder ' + (originalImg.className || '');
        
        // Copy dimensions and styles
        const computedStyle = window.getComputedStyle(originalImg);
        placeholder.style.width = originalImg.offsetWidth ? originalImg.offsetWidth + 'px' : computedStyle.width;
        placeholder.style.height = originalImg.offsetHeight ? originalImg.offsetHeight + 'px' : computedStyle.height;
        placeholder.style.aspectRatio = computedStyle.aspectRatio || 'auto';
        
        // Get random tech theme
        const theme = getTechTheme();
        
        // Create placeholder content with particles
        placeholder.innerHTML = `
          <div class="tech-particles">
            ${generateParticles()}
          </div>
          <div class="image-placeholder-content">
            <div class="tech-icon-container">
              ${theme.icon}
            </div>
            <div class="placeholder-title">${theme.title}</div>
            <div class="placeholder-subtitle">${theme.subtitle}</div>
          </div>
        `;
        
        return placeholder;
      }

      function getTechTheme() {
        const themes = [
          {
            title: "Code Loading...",
            subtitle: "Compiling awesome content",
            icon: `<svg class="tech-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>`
          },
          {
            title: "Data Streaming...",
            subtitle: "Processing visual content",
            icon: `<svg class="tech-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
                  </svg>`
          },
          {
            title: "AI Generating...",
            subtitle: "Creating visual magic",
            icon: `<svg class="tech-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>`
          },
          {
            title: "Cloud Syncing...",
            subtitle: "Fetching from the matrix",
            icon: `<svg class="tech-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"/>
                  </svg>`
          },
          {
            title: "Neural Network...",
            subtitle: "Computing visual insights",
            icon: `<svg class="tech-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                  </svg>`
          },
          {
            title: "Quantum Loading...",
            subtitle: "Superposition of pixels",
            icon: `<svg class="tech-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>`
          }
        ];
        
        return themes[Math.floor(Math.random() * themes.length)];
      }

      function generateParticles() {
        let particles = '';
        for (let i = 0; i < 8; i++) {
          const delay = Math.random() * 4;
          const left = Math.random() * 100;
          particles += `<div class="particle" style="left: ${left}%; animation-delay: ${delay}s;"></div>`;
        }
        return particles;
      }
    </script>
  </body>
</html>

