---
interface Props {
  post: {
    uri?: string;
    url?: string;
    slug: string;
    data: {
      title: string;
      date: string;
      author: string;
      description?: string;
      image?: string;
      tags?: string[];
      readingTime?: string;
    };
  };
}

const { post } = Astro.props;
const { title, date, author, description, image, tags, readingTime } =
  post.data;
const postUrl = post.uri || `/blog/${post.slug}`;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<a
  href={postUrl}
  class="group relative flex flex-col h-full bg-white dark:bg-[#131B2E] border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-purple-500/10 hover:-translate-y-2 hover:border-purple-500/20 dark:hover:border-purple-500/20"
>
  <!-- Image Container -->
  <div
    class="relative aspect-[16/9] overflow-hidden bg-gray-100 dark:bg-gray-800"
  >
    {
      image ? (
        <>
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#131B2E]/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
        </>
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-500/5 to-blue-500/5">
          <span class="text-4xl filter grayscale group-hover:grayscale-0 transition-all duration-500">
            📝
          </span>
        </div>
      )
    }

    <!-- Category Badge -->
    {
      tags && tags[0] && (
        <div class="absolute top-4 left-4 z-10">
          <span class="px-3 py-1.5 bg-white/90 dark:bg-[#0B1120]/90 backdrop-blur-md text-xs font-bold text-purple-600 dark:text-purple-400 rounded-lg shadow-lg border border-white/20 dark:border-white/10 tracking-wide uppercase">
            {tags[0]}
          </span>
        </div>
      )
    }
    <!-- Save Button -->
    <button
      class="save-btn absolute top-4 right-4 z-20 p-2 rounded-full bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm shadow-sm border border-gray-200 dark:border-gray-700 text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 transition-all duration-300 hover:scale-110"
      data-blog-id={post.slug}
      aria-label="Save for later"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
      </svg>
    </button>
  </div>

  <!-- Content -->
  <div class="flex-1 p-6 flex flex-col">
    <div
      class="flex items-center gap-3 text-xs font-medium text-gray-500 dark:text-gray-400 mb-4"
    >
      <span
        class="flex items-center gap-1.5 bg-gray-50 dark:bg-white/5 px-2.5 py-1 rounded-md"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        {formattedDate}
      </span>
      <span
        class="flex items-center gap-1.5 bg-gray-50 dark:bg-white/5 px-2.5 py-1 rounded-md"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {readingTime || "5 min read"}
      </span>
    </div>

    <h3
      class="text-xl font-bold text-gray-900 dark:text-white mb-3 line-clamp-2 leading-tight group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors"
    >
      {title}
    </h3>

    {
      description && (
        <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2 mb-6 flex-1 leading-relaxed">
          {description}
        </p>
      )
    }

    <div
      class="flex items-center justify-between pt-5 border-t border-gray-100 dark:border-gray-800 mt-auto"
    >
      <div class="flex items-center gap-2.5">
        <div
          class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-xs text-white font-bold shadow-md"
        >
          {author?.charAt(0) || "T"}
        </div>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
          {author || "TakoVibe Team"}
        </span>
      </div>
      <span
        class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-purple-50 dark:bg-purple-500/10 text-purple-600 dark:text-purple-400 group-hover:bg-purple-600 group-hover:text-white dark:group-hover:bg-purple-500 dark:group-hover:text-white transition-all duration-300"
      >
        <svg
          class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </span>
    </div>
  </div>
</a>

<script>
  import {
    saveBookmark,
    removeBookmark,
    checkBookmarkStatus,
    fetchBookmarks,
  } from "../utils/bookmarks";
  import { showToast } from "../utils/toast";

  async function setupSaveButtons() {
    const saveBtns = document.querySelectorAll(".save-btn");
    // Filter out buttons that are already bound to avoid double processing
    const unboundBtns = Array.from(saveBtns).filter(
      (btn) => !btn.hasAttribute("data-bound"),
    );

    if (unboundBtns.length === 0) return;

    // Fetch all bookmarks once
    const bookmarks = await fetchBookmarks();
    const savedSlugs = new Set(bookmarks.map((b) => b.slug));
    const savedIds = new Map(bookmarks.map((b) => [b.slug, b.id]));

    unboundBtns.forEach((btn) => {
      btn.setAttribute("data-bound", "true");

      const blogId = btn.getAttribute("data-blog-id");
      if (!blogId) return;

      // Check initial status from batch
      const isBookmarked = savedSlugs.has(blogId);
      updateSaveButtonState(btn, isBookmarked);

      if (isBookmarked) {
        const id = savedIds.get(blogId);
        if (id) btn.setAttribute("data-bookmark-id", id.toString());
      }

      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const token = localStorage.getItem("access_token");
        if (!token) {
          showToast("Please login to save articles for later.", "info");
          return;
        }

        const currentIsBookmarked = btn.classList.contains("text-purple-600");
        const currentBookmarkId = btn.getAttribute("data-bookmark-id");

        // Optimistic UI update
        updateSaveButtonState(btn, !currentIsBookmarked);

        let success = false;
        if (currentIsBookmarked && currentBookmarkId) {
          success = await removeBookmark(parseInt(currentBookmarkId));
          if (success) {
            btn.removeAttribute("data-bookmark-id");
            showToast("Article removed from saved list", "success");
          }
        } else {
          success = await saveBookmark(blogId);
          if (success) showToast("Article saved for later", "success");
        }

        if (!success) {
          // Revert UI if failed
          updateSaveButtonState(btn, currentIsBookmarked);
          showToast("Failed to update bookmark. Please try again.", "error");
        } else {
          // Re-fetch to get ID
          const { isBookmarked: newStatus, bookmarkId: newId } =
            await checkBookmarkStatus(blogId);
          if (newId) btn.setAttribute("data-bookmark-id", newId.toString());
        }
      });
    });
  }

  function updateSaveButtonState(btn: Element, isSaved: boolean) {
    if (isSaved) {
      btn.classList.add("text-purple-600", "dark:text-purple-400");
      btn.classList.remove("text-gray-400");
      btn.innerHTML = `
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
        </svg>
      `;
    } else {
      btn.classList.remove("text-purple-600", "dark:text-purple-400");
      btn.classList.add("text-gray-400");
      btn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
        </svg>
      `;
    }
  }

  // Initialize
  // Debounce/Delay slightly to allow other scripts to run first or DOM to settle,
  // preventing race conditions where we might check elements before they are fully ready or bound by others.
  setTimeout(setupSaveButtons, 100);
  document.addEventListener("astro:after-swap", () =>
    setTimeout(setupSaveButtons, 100),
  );
</script>
