---
interface Props {
  post: {
    url: string;
    slug: string;
    data: {
      title: string;
      date: string;
      author: string;
      description?: string;
      image?: string;
    };
  };
}

const { post } = Astro.props;
const { title, date, author, description, image } = post.data;
const postUrl = `/blog/${post.slug}`;
---

<a href={postUrl} class="block group cursor-pointer no-underline h-full">
  <article class="relative bg-gray-800/30 rounded-xl overflow-hidden hover:shadow-2xl transition-all duration-500 hover:scale-[1.02] backdrop-blur-sm border border-gray-700/50 animate-fade-in h-full flex flex-col">
    <div class="absolute inset-0 bg-gradient-to-r from-purple-800/10 to-pink-800/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
    {image && (
      <div class="relative h-48 overflow-hidden">
        <img 
          src={image} 
          alt={title} 
          class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
      </div>
    )}
    <div class="p-6 relative z-10 flex-1 flex flex-col">
      <h2 class="text-2xl font-bold mb-2 bg-clip-text hover:text-transparent hover:bg-gradient-to-r hover:from-purple-400 hover:to-pink-400 transition-all duration-300 line-clamp-2">
        <span class="relative z-10">{title}</span>
        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-gradient-to-r from-purple-400 to-pink-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"></span>
      </h2>
      <div class="text-sm text-gray-400 mb-4 flex items-center gap-4">
        <time class="animate-slide-in">{new Date(date).toLocaleDateString('en-US', { 
          year: 'numeric', 
          month: 'long', 
          day: 'numeric' 
        })}</time>
        <span class="w-1 h-1 rounded-full bg-gray-500"></span>
        <span class="animate-slide-in" style="animation-delay: 100ms">{author}</span>
      </div>
      {description && (
        <p class="text-gray-300 line-clamp-3 animate-slide-in mb-auto" style="animation-delay: 200ms">{description}</p>
      )}
    </div>
  </article>
</a>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slide-in {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }

  .animate-slide-in {
    opacity: 0;
    animation: slide-in 0.6s ease-out forwards;
  }
  
  /* Add line-clamp utility if not already in your CSS */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Add event listeners to ensure clicks work
  document.addEventListener('DOMContentLoaded', () => {
    const articleLinks = document.querySelectorAll('.block.group');
    articleLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href) {
          window.location.href = href;
        }
      });
    });
  });
</script>