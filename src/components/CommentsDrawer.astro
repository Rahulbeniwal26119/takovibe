---
const { slug } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<div
    id="comments-drawer"
    class="fixed z-[10000] bg-white/80 dark:bg-gray-900/80 backdrop-blur-2xl shadow-2xl transition-all duration-300 ease-out flex flex-col border border-white/20 dark:border-gray-700
    
    /* Mobile: Bottom Sheet */
    inset-x-0 bottom-0 h-[85dvh] w-full rounded-t-[2rem] translate-y-full
    /* Desktop: Floating Glass Panel */
    md:top-20 md:right-6 md:bottom-auto md:left-auto md:h-[calc(100vh-7rem)] md:w-[420px] md:rounded-[2rem] md:translate-y-4 md:opacity-0 md:pointer-events-none md:translate-x-0"
>
    <!-- Handle for Mobile Drag -->
    <div
        class="md:hidden w-full flex justify-center pt-3 pb-1 cursor-grab active:cursor-grabbing"
    >
        <div class="w-12 h-1.5 bg-gray-300 dark:bg-gray-700 rounded-full"></div>
    </div>

    <!-- Header -->
    <div
        class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-800/50 shrink-0"
    >
        <div>
            <h3
                class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2"
            >
                Comments
                <span
                    id="comment-count-badge"
                    class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-full hidden"
                    >0</span
                >
            </h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                Join the conversation
            </p>
        </div>
        <button
            id="close-comments"
            class="p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            aria-label="Close comments"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Comments List -->
    <div
        class="flex-1 overflow-y-auto p-4 md:p-6 custom-scrollbar scroll-smooth"
        id="comments-container"
    >
        <div id="comments-list" class="space-y-6 pb-24">
            <!-- Loading State -->
            <div
                class="flex flex-col items-center justify-center h-48 text-gray-400 animate-pulse"
            >
                <div
                    class="w-12 h-12 bg-gray-200 dark:bg-gray-800 rounded-full mb-3"
                >
                </div>
                <div class="h-4 w-32 bg-gray-200 dark:bg-gray-800 rounded mb-2">
                </div>
                <div class="h-3 w-24 bg-gray-200 dark:bg-gray-800 rounded">
                </div>
            </div>
        </div>

        <div id="load-more-container" class="mt-8 text-center hidden pb-8">
            <button
                id="load-more-btn"
                class="px-6 py-2.5 text-sm font-medium text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-900/20 hover:bg-purple-100 dark:hover:bg-purple-900/40 rounded-full transition-all"
            >
                Load more comments
            </button>
        </div>
    </div>

    <!-- Input Area (Fixed Bottom) -->
    <div
        class="absolute bottom-0 inset-x-0 p-4 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-t border-gray-100 dark:border-gray-800"
    >
        <div
            class="relative flex items-end gap-2 bg-gray-50 dark:bg-gray-800 rounded-[1.5rem] p-1.5 border border-gray-200 dark:border-gray-700 focus-within:ring-2 focus-within:ring-purple-500/50 focus-within:border-purple-500 transition-all shadow-sm"
        >
            <textarea
                id="comment-input"
                rows="1"
                class="w-full px-4 py-3 bg-transparent border-none focus:ring-0 resize-none text-sm placeholder-gray-400 dark:placeholder-gray-500 max-h-32 text-gray-900 dark:text-white"
                placeholder="Write a comment..."
                style="min-height: 48px;"></textarea>

            <button
                id="post-comment-btn"
                class="p-3 bg-purple-600 hover:bg-purple-700 text-white rounded-full transition-all shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed shrink-0 mb-0.5 mr-0.5 group"
                aria-label="Send"
            >
                <svg
                    class="w-5 h-5 translate-x-0.5 group-hover:translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
            </button>
        </div>
        <p
            class="text-[10px] text-gray-400 text-center mt-2 px-4 hidden md:block"
        >
            Press <kbd
                class="font-sans px-1 py-0.5 bg-gray-100 dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-700"
                >Ctrl</kbd
            > + <kbd
                class="font-sans px-1 py-0.5 bg-gray-100 dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-700"
                >Enter</kbd
            > to post
        </p>
    </div>
</div>

<div
    id="comments-backdrop"
    class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[55] hidden opacity-0 transition-opacity duration-500"
>
</div>

<script define:vars={{ slug, apiUrl }}>
    const drawer = document.getElementById("comments-drawer");
    const backdrop = document.getElementById("comments-backdrop");
    const closeBtn = document.getElementById("close-comments");
    const commentsList = document.getElementById("comments-list");
    const loadMoreBtn = document.getElementById("load-more-btn");
    const loadMoreContainer = document.getElementById("load-more-container");
    const commentInput = document.getElementById("comment-input");
    const postBtn = document.getElementById("post-comment-btn");

    let nextUrl = null;
    let isLoading = false;
    let allComments = [];
    let replyingToId = null;
    let replyingToUser = null;

    // Auto-resize textarea
    commentInput?.addEventListener("input", function () {
        this.style.height = "auto";
        this.style.height = this.scrollHeight + "px";
        if (this.value === "") this.style.height = "auto";
    });

    // Ctrl+Enter to post
    commentInput?.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
            postComment();
        }
    });

    // Drawer Control
    window.toggleComments = () => {
        const isClosed = drawer.classList.contains("translate-y-full");
        if (isClosed) {
            openDrawer();
        } else {
            closeDrawer();
        }
    };

    function openDrawer() {
        drawer.classList.remove("translate-y-full");
        drawer.classList.remove(
            "md:translate-y-4",
            "md:opacity-0",
            "md:pointer-events-none",
        );
        backdrop.classList.remove("hidden");
        requestAnimationFrame(() => {
            backdrop.classList.remove("opacity-0");
        });
        document.body.classList.add("comments-open");

        // Only fetch if empty
        if (allComments.length === 0) {
            fetchComments();
        }

        setTimeout(() => commentInput?.focus(), 500);
    }

    function closeDrawer() {
        drawer.classList.add("translate-y-full");
        drawer.classList.add(
            "md:translate-y-4",
            "md:opacity-0",
            "md:pointer-events-none",
        );
        backdrop.classList.add("opacity-0");
        document.body.classList.remove("comments-open");
        setTimeout(() => {
            backdrop.classList.add("hidden");
        }, 300);
    }

    closeBtn?.addEventListener("click", closeDrawer);
    backdrop?.addEventListener("click", closeDrawer);

    // API Logic
    async function fetchComments(url = null) {
        if (isLoading) return;
        isLoading = true;

        try {
            const fetchUrl =
                url || `${apiUrl}/api/blogs/comments/?blog_slug=${slug}`;
            const res = await fetch(fetchUrl, {
                headers: getHeader(),
            });
            const data = await res.json();

            if (!url) {
                allComments = []; // Reset on fresh load
            }

            if (data.results && data.results.length > 0) {
                // Update badge
                const badge = document.getElementById("comment-count-badge");
                if (badge) {
                    badge.innerText =
                        data.count || allComments.length + data.results.length;
                    badge.classList.remove("hidden");
                }

                // Add new comments
                allComments = [...allComments, ...data.results];
                renderCommentsTree();

                nextUrl = data.next;
                if (nextUrl) {
                    loadMoreContainer.classList.remove("hidden");
                } else {
                    loadMoreContainer.classList.add("hidden");
                }
            } else if (!url && allComments.length === 0) {
                renderEmptyState();
            }
        } catch (err) {
            console.error("Error fetching comments:", err);
            if (!url && allComments.length === 0) {
                commentsList.innerHTML = `
                    <div class="text-center py-12 text-red-500 text-sm bg-red-50 dark:bg-red-900/10 rounded-xl m-4">
                        Failed to load comments. Please try again.
                    </div>
                `;
            }
        } finally {
            isLoading = false;
        }
    }

    function renderEmptyState() {
        commentsList.innerHTML = `
          <div class="flex flex-col items-center justify-center py-16 text-center opacity-60">
            <div class="w-16 h-16 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            </div>
            <p class="text-gray-500 dark:text-gray-400 font-medium">No comments yet</p>
            <p class="text-xs text-gray-400 mt-1">Be the first to start the conversation!</p>
          </div>
        `;
    }

    function renderCommentsTree() {
        if (!allComments || !commentsList) return;

        const commentMap = new Map();
        allComments.forEach((c) => commentMap.set(c.id, c));

        const roots = [];
        const childrenMap = new Map();

        allComments.forEach((c) => {
            if (c.parent && commentMap.has(c.parent)) {
                if (!childrenMap.has(c.parent)) childrenMap.set(c.parent, []);
                childrenMap.get(c.parent).push(c);
            } else {
                roots.push(c);
            }
        });

        // Render roots
        if (roots.length === 0 && allComments.length === 0) {
            renderEmptyState();
            return;
        }

        // Sort roots: Newest first
        roots.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

        const html = roots
            .map((c) => renderCommentNode(c, childrenMap))
            .join("");
        commentsList.innerHTML = html;

        // Attach event listeners to Reply buttons
        document.querySelectorAll(".reply-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const commentId = e.currentTarget.dataset.id;
                const username = e.currentTarget.dataset.user;
                startReply(commentId, username);
            });
        });

        // Attach event listeners to Like buttons
        document.querySelectorAll(".like-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const commentId = e.currentTarget.dataset.id;
                toggleLike(commentId, btn);
            });
        });
    }

    async function toggleLike(commentId, btnElement) {
        console.log("Toggle like clicked for:", commentId);
        if (!localStorage.getItem("access_token")) {
            console.log("No token found, dispatching login modal");
            window.dispatchEvent(
                new CustomEvent("show-login-prompt", {
                    detail: { feature: "like comments" },
                }),
            );
            return;
        }

        const isLiked = btnElement.dataset.liked === "true";
        let count = parseInt(btnElement.dataset.count) || 0;

        const newLiked = !isLiked;
        const newCount = newLiked ? count + 1 : Math.max(0, count - 1);

        console.log(
            `Optimistic update: ${isLiked} -> ${newLiked}, Count: ${count} -> ${newCount}`,
        );

        btnElement.dataset.liked = newLiked.toString();
        btnElement.dataset.count = newCount.toString();

        if (newLiked) {
            btnElement.classList.add("text-rose-600", "dark:text-rose-400");
            btnElement.classList.remove("text-gray-500");
        } else {
            btnElement.classList.remove("text-rose-600", "dark:text-rose-400");
            btnElement.classList.add("text-gray-500");
        }

        // Update Text
        const textSpan = btnElement.querySelector(".like-text");
        if (textSpan)
            textSpan.innerText = newCount > 0 ? `Like (${newCount})` : "Like";

        try {
            const url = `${apiUrl}/api/blogs/comments/${commentId}/like/`;
            console.log(`Sending POST to ${url}`);

            const res = await fetch(url, {
                method: "POST",
                headers: getHeader(),
            });

            if (!res.ok) {
                const txt = await res.text();
                console.error("Like request failed:", txt);
                throw new Error("Failed to like");
            }

            const data = await res.json();
            console.log("Like successful, server data:", data);

            // Update local store
            const comment = allComments.find((c) => c.id == commentId);
            if (comment) {
                comment.like_count = data.like_count;
                comment.is_liked = data.liked;
            }
        } catch (err) {
            console.error("Like error caught:", err);
            // Revert on error
            btnElement.dataset.liked = isLiked.toString();
            btnElement.dataset.count = count.toString();
            if (textSpan)
                textSpan.innerText = count > 0 ? `Like (${count})` : "Like";

            if (isLiked) {
                btnElement.classList.add("text-rose-600", "dark:text-rose-400");
                btnElement.classList.remove("text-gray-500");
            } else {
                btnElement.classList.remove(
                    "text-rose-600",
                    "dark:text-rose-400",
                );
                btnElement.classList.add("text-gray-500");
            }
        }
    }

    function renderCommentNode(comment, childrenMap) {
        const children = childrenMap.get(comment.id) || [];
        children.sort(
            (a, b) => new Date(a.created_at) - new Date(b.created_at),
        );
        const hasChildren = children.length > 0;

        const username =
            comment.user && comment.user.username
                ? comment.user.username
                : typeof comment.user === "string"
                  ? comment.user
                  : "Anonymous";
        const avatarLetter = (username[0] || "A").toUpperCase();

        // Random pastel color based on username char
        const colors = [
            "bg-rose-500",
            "bg-purple-500",
            "bg-blue-500",
            "bg-teal-500",
            "bg-amber-500",
            "bg-indigo-500",
        ];
        const colorIndex = username.charCodeAt(0) % colors.length;
        const avatarBg = colors[colorIndex];

        const isLiked = comment.is_liked || false;
        const likeCount = comment.like_count || 0;
        const likeColorClass = isLiked
            ? "text-rose-600 dark:text-rose-400"
            : "text-gray-500 hover:text-gray-800 dark:hover:text-gray-300";

        return `
            <div class="relative group" id="comment-${comment.id}">
                
                <div class="flex gap-3 py-3 px-2 hover:bg-gray-50 dark:hover:bg-white/5 rounded-lg transition-colors border-b border-gray-100 dark:border-gray-800/50 last:border-0">
                    <!-- Avatar -->
                    <div class="flex-shrink-0 pt-1 relative">
                        <div class="w-8 h-8 rounded-full ${avatarBg} flex items-center justify-center text-white text-xs font-bold shadow-sm ring-2 ring-white dark:ring-[#0f172a]">
                            ${avatarLetter}
                        </div>
                        ${hasChildren ? `<div class="absolute top-9 left-1/2 -translate-x-1/2 w-px h-[calc(100%+12px)] bg-gray-200 dark:bg-gray-800"></div>` : ""}
                    </div>

                    <!-- Content Body -->
                    <div class="flex-1 min-w-0">
                        <!-- Header -->
                        <div class="flex items-center gap-2 mb-0.5">
                            <span class="text-[13px] font-bold text-gray-900 dark:text-gray-100 leading-none hover:underline cursor-pointer">
                                ${username}
                            </span>
                            <span class="text-[11px] text-gray-400 dark:text-gray-500 leading-none">
                                • ${formatDate(comment.created_at)}
                            </span>
                        </div>

                        <!-- Text -->
                        <div class="text-[13px] leading-snug text-gray-800 dark:text-gray-200 whitespace-pre-wrap break-words">
                            ${comment.comment}
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center gap-4 mt-2 select-none">
                             <button 
                                class="like-btn text-[11px] font-semibold ${likeColorClass} transition-colors cursor-pointer flex items-center gap-1"
                                data-id="${comment.id}"
                                data-liked="${isLiked}"
                                data-count="${likeCount}"
                             >
                                <span class="like-text">${likeCount > 0 ? `Like (${likeCount})` : "Like"}</span>
                             </button>
                             <button 
                                class="reply-btn text-[11px] font-semibold text-gray-500 hover:text-gray-800 dark:hover:text-gray-300 transition-colors cursor-pointer"
                                data-id="${comment.id}"
                                data-user="${username}"
                            >
                                Reply
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Nested Replies -->
                ${
                    hasChildren
                        ? `
                    <div class="pl-11 pr-2 pb-2 space-y-0">
                        ${children.map((child) => renderCommentNode(child, childrenMap)).join("")}
                    </div>
                `
                        : ""
                }
            </div>
        `;
    }

    function formatDate(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diff = (now - date) / 1000;

        if (diff < 60) return "Just now";
        if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
        if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;

        return date.toLocaleDateString(undefined, {
            month: "short",
            day: "numeric",
        });
    }

    // Reply Logic
    function startReply(commentId, username) {
        replyingToId = commentId;
        replyingToUser = username;

        // Show indicator logic
        const inputArea = document.querySelector(
            "#comments-drawer .absolute.bottom-0",
        );
        let indicator = document.getElementById("reply-indicator");

        if (!indicator) {
            indicator = document.createElement("div");
            indicator.id = "reply-indicator";
            indicator.className =
                "flex items-center justify-between px-4 py-2 bg-purple-50 dark:bg-purple-900/20 text-xs text-purple-700 dark:text-purple-300 border-t border-purple-100 dark:border-purple-800/30 w-full animate-in slide-in-from-bottom-2";
            inputArea.insertBefore(indicator, inputArea.firstChild);
        }

        indicator.innerHTML = `
            <span>Replying to <b>@${username}</b></span>
            <button id="cancel-reply" class="p-1 hover:bg-black/5 dark:hover:bg-white/10 rounded-full transition-colors">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        `;

        document
            .getElementById("cancel-reply")
            .addEventListener("click", cancelReply);

        inputArea.classList.toggle("pt-0", true); // Remove top padding if needed or adjust styling

        commentInput.focus();
        commentInput.placeholder = `Reply to ${username}...`;
    }

    function cancelReply() {
        replyingToId = null;
        replyingToUser = null;
        const indicator = document.getElementById("reply-indicator");
        if (indicator) indicator.remove();
        commentInput.placeholder = "Write a comment...";
    }

    async function postComment() {
        const text = commentInput.value.trim();
        if (!text) return;

        postBtn.disabled = true;
        const width = postBtn.offsetWidth;
        postBtn.style.width = width + "px";
        const originalContent = postBtn.innerHTML;
        postBtn.innerHTML =
            '<svg class="w-5 h-5 animate-spin mx-auto" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

        try {
            const body = { comment: text, blog: slug };
            if (replyingToId) body.parent = replyingToId;

            const res = await fetch(`${apiUrl}/api/blogs/comments/`, {
                method: "POST",
                headers: { "Content-Type": "application/json", ...getHeader() },
                body: JSON.stringify(body),
            });

            // Check for auth error
            if (res.status === 401 || res.status === 403) {
                // Trigger login modal logic if available, or alert
                window.dispatchEvent(new CustomEvent("open-login-modal"));
                // alert("Please login to comment"); - Optional fallback
                return;
            }

            if (res.ok) {
                const newComment = await res.json();
                commentInput.value = "";
                commentInput.style.height = "auto";

                // Add new comment to local state immediately
                allComments.push(newComment);
                renderCommentsTree();

                // Clear reply state
                cancelReply();
            }
        } catch (err) {
            console.error("Error posting comment:", err);
            alert("Failed to post comment");
        } finally {
            postBtn.disabled = false;
            postBtn.style.width = "";
            postBtn.innerHTML = originalContent;
        }
    }

    function getHeader() {
        const token = localStorage.getItem("access_token");
        const headers = {
            "Content-Type": "application/json",
        };
        if (token) {
            headers["Authorization"] = `Token ${token}`;
        }
        return headers;
    }

    postBtn?.addEventListener("click", postComment);
    loadMoreBtn?.addEventListener("click", () => {
        if (nextUrl) fetchComments(nextUrl);
    });
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(156, 163, 175, 0.5);
        border-radius: 2px;
    }
</style>
