---
const { slug } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<div
    id="comments-drawer"
    class="fixed z-[10000] flex flex-col border border-neutral-200/90 bg-stone-50/95 shadow-2xl shadow-neutral-950/15 backdrop-blur-xl transition-all duration-300 ease-out dark:border-neutral-800 dark:bg-neutral-950/95 dark:shadow-black/35
    
    /* Mobile: Bottom Sheet */
    inset-x-0 bottom-0 h-[85dvh] w-full translate-y-full rounded-t-3xl
    /* Desktop: Floating Reader Panel */
    md:right-6 md:bottom-auto md:left-auto md:w-[420px] md:translate-x-0 md:translate-y-4 md:rounded-2xl md:opacity-0 md:pointer-events-none"
>
    <!-- Handle for Mobile Drag -->
    <div
        class="md:hidden w-full flex justify-center pt-3 pb-1 cursor-grab active:cursor-grabbing"
    >
        <div class="h-1 w-12 rounded-full bg-neutral-300 dark:bg-neutral-700"></div>
    </div>

    <!-- Header -->
    <div
        class="flex shrink-0 items-center justify-between border-b border-neutral-200 px-5 py-4 dark:border-neutral-800"
    >
        <div>
            <h3
                class="flex items-center gap-2 text-lg font-bold text-neutral-950 dark:text-white"
            >
                Comments
                <span
                    id="comment-count-badge"
                    class="hidden rounded-full bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700 dark:bg-orange-500/15 dark:text-orange-300"
                    >0</span
                >
            </h3>
            <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                Discuss this article
            </p>
        </div>
        <button
            id="close-comments"
            class="rounded-lg p-2 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white"
            aria-label="Close comments"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Comments List -->
    <div
        class="custom-scrollbar flex-1 overflow-y-auto p-4 scroll-smooth md:p-5"
        id="comments-container"
    >
        <div id="comments-list" class="space-y-6 pb-24">
            <!-- Loading State -->
            <div
                class="flex h-48 animate-pulse flex-col items-center justify-center text-neutral-400"
            >
                <div
                    class="mb-3 h-12 w-12 rounded-xl bg-neutral-200 dark:bg-neutral-800"
                >
                </div>
                <div class="mb-2 h-4 w-32 rounded bg-neutral-200 dark:bg-neutral-800">
                </div>
                <div class="h-3 w-24 rounded bg-neutral-200 dark:bg-neutral-800">
                </div>
            </div>
        </div>

        <div id="load-more-container" class="mt-8 text-center hidden pb-8">
            <button
                id="load-more-btn"
                class="rounded-lg border border-orange-200 bg-orange-50 px-4 py-2 text-sm font-bold text-orange-700 transition-colors hover:bg-orange-100 dark:border-orange-900/70 dark:bg-orange-950/30 dark:text-orange-300 dark:hover:bg-orange-950/50"
            >
                Load more comments
            </button>
        </div>
    </div>

    <!-- Input Area (Fixed Bottom) -->
    <div
        class="absolute inset-x-0 bottom-0 border-t border-neutral-200 bg-stone-50/95 p-3 backdrop-blur-md dark:border-neutral-800 dark:bg-neutral-950/95"
    >
        <div
            class="comment-composer relative flex items-end gap-2 rounded-lg border border-neutral-200 bg-white p-1 transition-colors focus-within:border-orange-400 dark:border-neutral-800 dark:bg-neutral-900 dark:focus-within:border-orange-700"
        >
            <textarea
                id="comment-input"
                rows="1"
                class="max-h-32 w-full resize-none border-0 bg-transparent px-3 py-2 text-sm leading-6 text-neutral-950 placeholder-neutral-400 outline-none focus:border-transparent focus:outline-none focus:ring-0 dark:text-white dark:placeholder-neutral-500"
                placeholder="Write a comment..."
                style="min-height: 40px;"></textarea>

            <button
                id="post-comment-btn"
                class="h-10 shrink-0 rounded-md bg-orange-600 px-3 text-xs font-bold text-white transition-colors hover:bg-orange-500 disabled:cursor-not-allowed disabled:opacity-50"
                aria-label="Post comment"
            >
                Post
            </button>
        </div>
        <p
            class="mt-2 hidden px-4 text-center text-[10px] text-neutral-400 md:block"
        >
            Press <kbd
                class="rounded border border-neutral-200 bg-neutral-100 px-1 py-0.5 font-sans dark:border-neutral-800 dark:bg-neutral-900"
                >Ctrl</kbd
            > + <kbd
                class="rounded border border-neutral-200 bg-neutral-100 px-1 py-0.5 font-sans dark:border-neutral-800 dark:bg-neutral-900"
                >Enter</kbd
            > to post
        </p>
    </div>
</div>

<div
    id="comments-backdrop"
    class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[55] hidden opacity-0 transition-opacity duration-500"
>
</div>

<script define:vars={{ slug, apiUrl }}>
    const drawer = document.getElementById("comments-drawer");
    const backdrop = document.getElementById("comments-backdrop");
    const closeBtn = document.getElementById("close-comments");
    const commentsList = document.getElementById("comments-list");
    const loadMoreBtn = document.getElementById("load-more-btn");
    const loadMoreContainer = document.getElementById("load-more-container");
    const commentInput = document.getElementById("comment-input");
    const postBtn = document.getElementById("post-comment-btn");

    let nextUrl = null;
    let isLoading = false;
    let allComments = [];
    let replyingToId = null;
    let replyingToUser = null;

    // Auto-resize textarea
    commentInput?.addEventListener("input", function () {
        this.style.height = "auto";
        this.style.height = this.scrollHeight + "px";
        if (this.value === "") this.style.height = "auto";
    });

    // Ctrl+Enter to post
    commentInput?.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
            postComment();
        }
    });

    // Drawer Control
    window.toggleComments = () => {
        const isClosed = drawer.classList.contains("translate-y-full");
        if (isClosed) {
            openDrawer();
        } else {
            closeDrawer();
        }
    };

    function openDrawer() {
        drawer.classList.remove("translate-y-full");
        drawer.classList.remove(
            "md:translate-y-4",
            "md:opacity-0",
            "md:pointer-events-none",
        );
        backdrop.classList.remove("hidden");
        requestAnimationFrame(() => {
            backdrop.classList.remove("opacity-0");
        });
        document.body.classList.add("comments-open");

        // Only fetch if empty
        if (allComments.length === 0) {
            fetchComments();
        }

        setTimeout(() => commentInput?.focus(), 500);
    }

    function closeDrawer() {
        drawer.classList.add("translate-y-full");
        drawer.classList.add(
            "md:translate-y-4",
            "md:opacity-0",
            "md:pointer-events-none",
        );
        backdrop.classList.add("opacity-0");
        document.body.classList.remove("comments-open");
        setTimeout(() => {
            backdrop.classList.add("hidden");
        }, 300);
    }

    closeBtn?.addEventListener("click", closeDrawer);
    backdrop?.addEventListener("click", closeDrawer);

    // API Logic
    async function fetchComments(url = null) {
        if (isLoading) return;
        isLoading = true;

        try {
            const fetchUrl =
                url || `${apiUrl}/api/blogs/comments/?blog_slug=${slug}`;
            const res = await fetch(fetchUrl, {
                headers: getHeader(),
            });
            const data = await res.json();

            if (!url) {
                allComments = []; // Reset on fresh load
            }

            if (data.results && data.results.length > 0) {
                // Update badge
                const badge = document.getElementById("comment-count-badge");
                if (badge) {
                    badge.innerText =
                        data.count || allComments.length + data.results.length;
                    badge.classList.remove("hidden");
                }

                // Add new comments
                allComments = [...allComments, ...data.results];
                renderCommentsTree();

                nextUrl = data.next;
                if (nextUrl) {
                    loadMoreContainer.classList.remove("hidden");
                } else {
                    loadMoreContainer.classList.add("hidden");
                }
            } else if (!url && allComments.length === 0) {
                renderEmptyState();
            }
        } catch (err) {
            console.error("Error fetching comments:", err);
            if (!url && allComments.length === 0) {
                commentsList.innerHTML = `
                    <div class="text-center py-12 text-red-500 text-sm bg-red-50 dark:bg-red-900/10 rounded-xl m-4">
                        Failed to load comments. Please try again.
                    </div>
                `;
            }
        } finally {
            isLoading = false;
        }
    }

    function renderEmptyState() {
        commentsList.innerHTML = `
          <div class="flex flex-col items-center justify-center py-16 text-center">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl border border-orange-200 bg-orange-50 dark:border-orange-900/70 dark:bg-orange-950/30">
                <svg class="h-7 w-7 text-orange-600 dark:text-orange-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            </div>
            <p class="font-bold text-neutral-700 dark:text-neutral-200">No comments yet</p>
            <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Start the discussion with a useful thought.</p>
          </div>
        `;
    }

    function renderCommentsTree() {
        if (!allComments || !commentsList) return;

        const commentMap = new Map();
        allComments.forEach((c) => commentMap.set(c.id, c));

        const roots = [];
        const childrenMap = new Map();

        allComments.forEach((c) => {
            if (c.parent && commentMap.has(c.parent)) {
                if (!childrenMap.has(c.parent)) childrenMap.set(c.parent, []);
                childrenMap.get(c.parent).push(c);
            } else {
                roots.push(c);
            }
        });

        // Render roots
        if (roots.length === 0 && allComments.length === 0) {
            renderEmptyState();
            return;
        }

        // Sort roots: Newest first
        roots.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

        const html = roots
            .map((c) => renderCommentNode(c, childrenMap))
            .join("");
        commentsList.innerHTML = html;

        // Attach event listeners to Reply buttons
        document.querySelectorAll(".reply-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const commentId = e.currentTarget.dataset.id;
                const username = e.currentTarget.dataset.user;
                startReply(commentId, username);
            });
        });

        // Attach event listeners to Like buttons
        document.querySelectorAll(".like-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const commentId = e.currentTarget.dataset.id;
                toggleLike(commentId, btn);
            });
        });
    }

    async function toggleLike(commentId, btnElement) {
        console.log("Toggle like clicked for:", commentId);
        if (!localStorage.getItem("access_token")) {
            console.log("No token found, dispatching login modal");
            window.dispatchEvent(
                new CustomEvent("show-login-prompt", {
                    detail: { feature: "like comments" },
                }),
            );
            return;
        }

        const isLiked = btnElement.dataset.liked === "true";
        let count = parseInt(btnElement.dataset.count) || 0;

        const newLiked = !isLiked;
        const newCount = newLiked ? count + 1 : Math.max(0, count - 1);

        console.log(
            `Optimistic update: ${isLiked} -> ${newLiked}, Count: ${count} -> ${newCount}`,
        );

        btnElement.dataset.liked = newLiked.toString();
        btnElement.dataset.count = newCount.toString();

        if (newLiked) {
            btnElement.classList.add("text-orange-600", "dark:text-orange-300");
            btnElement.classList.remove("text-neutral-500");
        } else {
            btnElement.classList.remove("text-orange-600", "dark:text-orange-300");
            btnElement.classList.add("text-neutral-500");
        }

        // Update Text
        const textSpan = btnElement.querySelector(".like-text");
        if (textSpan)
            textSpan.innerText = newCount > 0 ? `Like (${newCount})` : "Like";

        try {
            const url = `${apiUrl}/api/blogs/comments/${commentId}/like/`;
            console.log(`Sending POST to ${url}`);

            const res = await fetch(url, {
                method: "POST",
                headers: getHeader(),
            });

            if (!res.ok) {
                const txt = await res.text();
                console.error("Like request failed:", txt);
                throw new Error("Failed to like");
            }

            const data = await res.json();
            console.log("Like successful, server data:", data);

            // Update local store
            const comment = allComments.find((c) => c.id == commentId);
            if (comment) {
                comment.like_count = data.like_count;
                comment.is_liked = data.liked;
            }
        } catch (err) {
            console.error("Like error caught:", err);
            // Revert on error
            btnElement.dataset.liked = isLiked.toString();
            btnElement.dataset.count = count.toString();
            if (textSpan)
                textSpan.innerText = count > 0 ? `Like (${count})` : "Like";

            if (isLiked) {
                btnElement.classList.add("text-orange-600", "dark:text-orange-300");
                btnElement.classList.remove("text-neutral-500");
            } else {
                btnElement.classList.remove(
                    "text-orange-600",
                    "dark:text-orange-300",
                );
                btnElement.classList.add("text-neutral-500");
            }
        }
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function renderCommentNode(comment, childrenMap) {
        const children = childrenMap.get(comment.id) || [];
        children.sort(
            (a, b) => new Date(a.created_at) - new Date(b.created_at),
        );
        const hasChildren = children.length > 0;

        const username =
            comment.user && comment.user.username
                ? comment.user.username
                : typeof comment.user === "string"
                  ? comment.user
                  : "Anonymous";
        const avatarLetter = (username[0] || "A").toUpperCase();

        const safeUsername = escapeHtml(username);
        const safeComment = escapeHtml(comment.comment);
        const safeAvatarLetter = escapeHtml(avatarLetter);

        const colors = [
            "bg-orange-600",
            "bg-amber-500",
            "bg-neutral-700",
            "bg-stone-600",
        ];
        const colorIndex = username.charCodeAt(0) % colors.length;
        const avatarBg = colors[colorIndex];

        const isLiked = comment.is_liked || false;
        const likeCount = comment.like_count || 0;
        const likeColorClass = isLiked
            ? "text-orange-600 dark:text-orange-300"
            : "text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200";

        return `
            <div class="relative group" id="comment-${comment.id}">
                
                <div class="flex gap-3 rounded-xl border border-transparent px-2 py-3 transition-colors hover:border-neutral-200 hover:bg-white dark:hover:border-neutral-800 dark:hover:bg-neutral-900/70">
                    <!-- Avatar -->
                    <div class="flex-shrink-0 pt-1 relative">
                        <div class="flex h-8 w-8 items-center justify-center rounded-lg ${avatarBg} text-xs font-bold text-white shadow-sm ring-2 ring-white dark:ring-neutral-950">
                            ${safeAvatarLetter}
                        </div>
                        ${hasChildren ? `<div class="absolute left-1/2 top-9 h-[calc(100%+12px)] w-px -translate-x-1/2 bg-orange-200 dark:bg-orange-900/70"></div>` : ""}
                    </div>

                    <!-- Content Body -->
                    <div class="flex-1 min-w-0">
                        <!-- Header -->
                        <div class="flex items-center gap-2 mb-0.5">
                            <span class="cursor-pointer text-[13px] font-bold leading-none text-neutral-950 hover:text-orange-600 dark:text-neutral-100 dark:hover:text-orange-300">
                                ${safeUsername}
                            </span>
                            <span class="text-[11px] leading-none text-neutral-400 dark:text-neutral-500">
                                • ${formatDate(comment.created_at)}
                            </span>
                        </div>

                        <!-- Text -->
                        <div class="whitespace-pre-wrap break-words text-[13px] leading-relaxed text-neutral-700 dark:text-neutral-200">
                            ${safeComment}
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center gap-4 mt-2 select-none">
                             <button 
                                class="like-btn text-[11px] font-semibold ${likeColorClass} transition-colors cursor-pointer flex items-center gap-1"
                                data-id="${comment.id}"
                                data-liked="${isLiked}"
                                data-count="${likeCount}"
                             >
                                <span class="like-text">${likeCount > 0 ? `Like (${likeCount})` : "Like"}</span>
                             </button>
                             <button 
                                class="reply-btn cursor-pointer text-[11px] font-semibold text-neutral-500 transition-colors hover:text-orange-600 dark:hover:text-orange-300"
                                data-id="${comment.id}"
                                data-user="${safeUsername}"
                            >
                                Reply
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Nested Replies -->
                ${
                    hasChildren
                        ? `
                    <div class="pl-11 pr-2 pb-2 space-y-0">
                        ${children.map((child) => renderCommentNode(child, childrenMap)).join("")}
                    </div>
                `
                        : ""
                }
            </div>
        `;
    }

    function formatDate(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diff = (now - date) / 1000;

        if (diff < 60) return "Just now";
        if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
        if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;

        return date.toLocaleDateString(undefined, {
            month: "short",
            day: "numeric",
        });
    }

    // Reply Logic
    function startReply(commentId, username) {
        replyingToId = commentId;
        replyingToUser = username;

        // Show indicator logic
        const inputArea = document.querySelector(
            "#comments-drawer .absolute.bottom-0",
        );
        let indicator = document.getElementById("reply-indicator");

        if (!indicator) {
            indicator = document.createElement("div");
            indicator.id = "reply-indicator";
            indicator.className =
                "flex w-full animate-in items-center justify-between border-b border-orange-200 bg-orange-50 px-4 py-2 text-xs text-orange-700 slide-in-from-bottom-2 dark:border-orange-900/70 dark:bg-orange-950/30 dark:text-orange-300";
            inputArea.insertBefore(indicator, inputArea.firstChild);
        }

        indicator.innerHTML = `
            <span>Replying to <b>@${escapeHtml(username)}</b></span>
            <button id="cancel-reply" class="p-1 hover:bg-black/5 dark:hover:bg-white/10 rounded-full transition-colors">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        `;

        document
            .getElementById("cancel-reply")
            .addEventListener("click", cancelReply);

        inputArea.classList.toggle("pt-0", true); // Remove top padding if needed or adjust styling

        commentInput.focus();
        commentInput.placeholder = `Reply to ${username}...`;
    }

    function cancelReply() {
        replyingToId = null;
        replyingToUser = null;
        const indicator = document.getElementById("reply-indicator");
        if (indicator) indicator.remove();
        commentInput.placeholder = "Write a comment...";
    }

    async function postComment() {
        const text = commentInput.value.trim();
        if (!text) return;

        postBtn.disabled = true;
        const width = postBtn.offsetWidth;
        postBtn.style.width = width + "px";
        const originalContent = postBtn.innerHTML;
        postBtn.innerHTML =
            '<svg class="w-5 h-5 animate-spin mx-auto" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

        try {
            const body = { comment: text, blog: slug };
            if (replyingToId) body.parent = replyingToId;

            const res = await fetch(`${apiUrl}/api/blogs/comments/`, {
                method: "POST",
                headers: { "Content-Type": "application/json", ...getHeader() },
                body: JSON.stringify(body),
            });

            // Check for auth error
            if (res.status === 401 || res.status === 403) {
                // Trigger login modal logic if available, or alert
                window.dispatchEvent(new CustomEvent("open-login-modal"));
                // alert("Please login to comment"); - Optional fallback
                return;
            }

            if (res.ok) {
                const newComment = await res.json();
                commentInput.value = "";
                commentInput.style.height = "auto";

                // Add new comment to local state immediately
                allComments.push(newComment);
                renderCommentsTree();

                // Clear reply state
                cancelReply();
            }
        } catch (err) {
            console.error("Error posting comment:", err);
            alert("Failed to post comment");
        } finally {
            postBtn.disabled = false;
            postBtn.style.width = "";
            postBtn.innerHTML = originalContent;
        }
    }

    function getHeader() {
        const token = localStorage.getItem("access_token");
        const headers = {
            "Content-Type": "application/json",
        };
        if (token) {
            headers["Authorization"] = `Token ${token}`;
        }
        return headers;
    }

    postBtn?.addEventListener("click", postComment);
    loadMoreBtn?.addEventListener("click", () => {
        if (nextUrl) fetchComments(nextUrl);
    });
</script>

<style>
    #comment-input:focus,
    #comment-input:focus-visible {
        border-color: transparent !important;
        outline: none !important;
        box-shadow: none !important;
    }

    @media (min-width: 768px) {
        #comments-drawer {
            top: calc(var(--top-banner-height, 0px) + 5.5rem);
            height: calc(100vh - var(--top-banner-height, 0px) - 7rem);
        }
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(249, 115, 22, 0.35);
        border-radius: 2px;
    }
</style>
