---
const { slug } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<div
    id="comments-drawer"
    class="fixed inset-y-0 right-0 w-full max-w-md bg-white dark:bg-gray-900 shadow-2xl transform translate-x-full transition-transform duration-300 z-[60] flex flex-col"
>
    <!-- Header -->
    <div
        class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md z-10"
    >
        <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                Discussion
            </h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                Share your thoughts
            </p>
        </div>
        <button
            id="close-comments"
            class="p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Comments List -->
    <div
        class="flex-1 overflow-y-auto p-6 custom-scrollbar"
        id="comments-container"
    >
        <div id="comments-list" class="space-y-6">
            <!-- Comments will be injected here -->
            <div
                class="flex flex-col items-center justify-center h-32 text-gray-500"
            >
                <svg
                    class="w-8 h-8 mb-2 opacity-50"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                    ></path>
                </svg>
                <p class="text-sm">Loading comments...</p>
            </div>
        </div>

        <div id="load-more-container" class="mt-6 text-center hidden">
            <button
                id="load-more-btn"
                class="px-4 py-2 text-sm font-medium text-purple-600 dark:text-purple-400 hover:bg-purple-50 dark:hover:bg-purple-900/20 rounded-lg transition-colors"
            >
                Load more comments
            </button>
        </div>
    </div>

    <!-- Input Area -->
    <div
        class="p-4 border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50"
    >
        <div class="relative">
            <textarea
                id="comment-input"
                rows="3"
                class="w-full px-4 py-3 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none text-sm transition-shadow placeholder-gray-400 dark:placeholder-gray-500"
                placeholder="What are your thoughts?"></textarea>
            <div class="absolute bottom-2 right-2 flex items-center gap-2">
                <button
                    id="post-comment-btn"
                    class="px-4 py-1.5 bg-purple-600 hover:bg-purple-700 text-white text-xs font-medium rounded-lg transition-colors shadow-sm flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    <span>Post</span>
                    <svg
                        class="w-3 h-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<div
    id="comments-backdrop"
    class="fixed inset-0 bg-black/20 backdrop-blur-sm z-[55] hidden opacity-0 transition-opacity duration-300"
>
</div>

<script define:vars={{ slug, apiUrl }}>
    const drawer = document.getElementById("comments-drawer");
    const backdrop = document.getElementById("comments-backdrop");
    const closeBtn = document.getElementById("close-comments");
    const commentsList = document.getElementById("comments-list");
    const loadMoreBtn = document.getElementById("load-more-btn");
    const loadMoreContainer = document.getElementById("load-more-container");
    const commentInput = document.getElementById("comment-input");
    const postBtn = document.getElementById("post-comment-btn");

    let nextUrl = null;
    let isLoading = false;

    // Drawer Control
    window.toggleComments = () => {
        const isClosed = drawer.classList.contains("translate-x-full");
        if (isClosed) {
            drawer.classList.remove("translate-x-full");
            backdrop.classList.remove("hidden");
            // Small delay to allow display:block to apply before opacity transition
            requestAnimationFrame(() => {
                backdrop.classList.remove("opacity-0");
            });
            fetchComments();
        } else {
            closeDrawer();
        }
    };

    function closeDrawer() {
        drawer.classList.add("translate-x-full");
        backdrop.classList.add("opacity-0");
        setTimeout(() => {
            backdrop.classList.add("hidden");
        }, 300);
    }

    closeBtn?.addEventListener("click", closeDrawer);
    backdrop?.addEventListener("click", closeDrawer);

    // API Logic
    async function fetchComments(url = null) {
        if (isLoading) return;
        isLoading = true;

        try {
            const fetchUrl =
                url || `${apiUrl}/api/blogs/comments/?blog_slug=${slug}`;
            const res = await fetch(fetchUrl);
            const data = await res.json();

            if (!url) commentsList.innerHTML = ""; // Clear loading state on first load

            if (data.results && data.results.length > 0) {
                const html = data.results
                    .map(
                        (comment) => `
          <div class="group">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-white text-xs font-bold shadow-sm">
                ${comment.user ? comment.user[0].toUpperCase() : "A"}
              </div>
              <div class="flex-1 min-w-0">
                <div class="bg-gray-50 dark:bg-gray-800/50 rounded-2xl rounded-tl-none px-4 py-3">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-semibold text-gray-900 dark:text-white">
                      ${comment.user || "Anonymous"}
                    </span>
                    <span class="text-[10px] text-gray-500">
                      ${new Date(comment.created_at).toLocaleDateString(undefined, { month: "short", day: "numeric" })}
                    </span>
                  </div>
                  <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-wrap">${comment.comment}</p>
                </div>
              </div>
            </div>
          </div>
        `,
                    )
                    .join("");

                if (url) {
                    commentsList.insertAdjacentHTML("beforeend", html);
                } else {
                    commentsList.innerHTML = html;
                }

                nextUrl = data.next;
                if (nextUrl) {
                    loadMoreContainer.classList.remove("hidden");
                } else {
                    loadMoreContainer.classList.add("hidden");
                }
            } else if (!url) {
                commentsList.innerHTML = `
          <div class="text-center py-12">
            <p class="text-gray-500 dark:text-gray-400 text-sm">No comments yet. Be the first to share your thoughts!</p>
          </div>
        `;
            }
        } catch (err) {
            console.error("Error fetching comments:", err);
            if (!url) {
                commentsList.innerHTML = `
          <div class="text-center py-12 text-red-500 text-sm">
            Failed to load comments. Please try again.
          </div>
        `;
            }
        } finally {
            isLoading = false;
        }
    }

    async function postComment() {
        const text = commentInput.value.trim();
        if (!text) return;

        postBtn.disabled = true;
        postBtn.innerHTML = '<span class="animate-spin">↻</span> Posting...';

        try {
            const res = await fetch(`${apiUrl}/api/blogs/comments/`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ comment: text, blog: slug }),
            });

            if (res.ok) {
                commentInput.value = "";
                fetchComments(); // Reload comments
            }
        } catch (err) {
            console.error("Error posting comment:", err);
        } finally {
            postBtn.disabled = false;
            postBtn.innerHTML = `
        <span>Post</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      `;
        }
    }

    postBtn?.addEventListener("click", postComment);
    loadMoreBtn?.addEventListener("click", () => {
        if (nextUrl) fetchComments(nextUrl);
    });
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(156, 163, 175, 0.5);
        border-radius: 2px;
    }
</style>
