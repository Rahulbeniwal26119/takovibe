---
interface Props {
  variant?: 'default' | 'compact' | 'featured';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;
---

<div class={`newsletter-wrapper ${variant} ${className}`}>
  <form class="newsletter" onsubmit="handleSubmit(event)">
    <div class="newsletter-content">
      {variant === 'featured' && (
        <div class="featured-icon mb-6">
          <svg class="w-12 h-12 mx-auto text-purple-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 5.25l-7.5 7.5-7.5-7.5m0 0l7.5 7.5 7.5-7.5M4.5 12.75l7.5 7.5 7.5-7.5" />
          </svg>
        </div>
      )}
      <h3 class:list={[
        "font-bold mb-2 dark:text-white",
        {
          'text-2xl text-center': variant === 'featured',
          'text-xl': variant === 'default',
          'text-lg': variant === 'compact'
        }
      ]}>
        {variant === 'compact' ? 'Subscribe for future Updates' : 'Join the Upcoming Newsletter'}
      </h3>
      <p class:list={[
        "text-gray-600 dark:text-gray-400",
        {
          'mb-6 text-center text-lg': variant === 'featured',
          'mb-4': variant === 'default',
          'mb-3 text-sm': variant === 'compact'
        }
      ]}>
        Get the latest posts and exclusive content delivered directly to your inbox.
      </p>
      <div class:list={[
        "input-group",
        {
          'flex-col sm:flex-row': variant === 'featured',
          'flex-row': variant !== 'featured'
        }
      ]}>
        <input 
          type="email" 
          required 
          placeholder="Enter your email"
          class:list={[
            "w-full px-4 rounded-lg dark:bg-gray-800/50 border focus:ring-2 focus:ring-purple-500/50 dark:focus:ring-purple-400/50 focus:border-transparent transition-all duration-300",
            {
              'py-3 text-lg border-gray-200/50 dark:border-gray-700/50': variant === 'featured',
              'py-2 border-gray-200 dark:border-gray-700': variant !== 'featured'
            }
          ]}
        />
        <button 
          type="submit"
          class:list={[
            "whitespace-nowrap font-medium transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900",
            {
              'px-8 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg w-full sm:w-auto': variant === 'featured',
              'px-6 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg': variant === 'default',
              'px-4 py-2 text-purple-600 hover:text-purple-700 dark:text-purple-400 dark:hover:text-purple-300 underline-offset-4 hover:underline': variant === 'compact'
            }
          ]}
        >
          {variant === 'compact' ? 'Subscribe →' : 'Subscribe'}
        </button>
      </div>
    </div>
  </form>
</div>

<style>
  .newsletter-wrapper {
    position: relative;
    transition: all 0.3s ease;
  }

  .newsletter-wrapper.default {
    padding: 2rem;
    background: linear-gradient(to bottom right, rgba(255, 255, 255, 0.05), rgba(139, 92, 246, 0.05));
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    margin: 2rem 0;
  }

  .newsletter-wrapper.featured {
    padding: 3rem;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(99, 102, 241, 0.1) 100%);
    border-radius: 1.5rem;
    border: 1px solid rgba(139, 92, 246, 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    margin: 3rem 0;
  }

  .newsletter-wrapper.compact {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    margin: 1.5rem 0;
  }

  .newsletter-wrapper:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }

  .input-group {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 640px) {
    .input-group {
      gap: 0.75rem;
    }
  }

  .featured-icon {
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
</style>

<script>
  function handleSubmit(event) {
    event.preventDefault();
    const form = event.target;
    const email = form.querySelector('input[type="email"]').value;
    
    // TODO: Add your newsletter signup logic here
    console.log('Newsletter signup:', email);
    
    // Show success message
    const button = form.querySelector('button');
    const originalText = button.textContent;
    button.textContent = 'Subscribed!';
    button.classList.add('bg-green-600');
    
    setTimeout(() => {
      button.textContent = originalText;
      button.classList.remove('bg-green-600');
      form.reset();
    }, 2000);
  }
</script> 