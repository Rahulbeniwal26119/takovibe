---
import { Image } from 'astro:assets';
const SITE_URL = import.meta.env.SITE_URL;

interface Props {
  title: string;
  date: string;
  author: string;
  image: string;
  slug: string;
}

const { title, date, author, image, slug } = Astro.props;
const optimizedImage = `${image}?&auto=format&fit=crop&w=800&h=400&q=80`;
---

<article class="floating-card bg-gray-50 dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform perspective-1000">
    {image && (
      <img
        src={optimizedImage}
        alt={title}
        width={800}
        height={400}
        class="w-full h-48 object-cover"
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="p-6">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
        <a href={`${SITE_URL}/blog/${slug}`} class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
          {title}
        </a>
      </h2>
      <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
        <span>{date}</span>
        <span class="mx-2">•</span>
        <span>{author}</span>
      </div>
    </div>
  </article>

<style>
  .floating-card {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .floating-card:hover {
    transform: translateY(-10px) rotateX(4deg) rotateY(4deg);
  }

  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  .perspective-1000 {
    perspective: 1000px;
  }
</style>

<script>
  const cards = document.querySelectorAll('.floating-card');

  cards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = (y - centerY) / 20;
      const rotateY = (centerX - x) / 20;

      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(10px)`;
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
    });
  });
</script> 