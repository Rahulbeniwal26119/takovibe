---
export interface Props {
  seriesName?: string;
  message?: string;
  href?: string;
}

const { 
  seriesName = "ML Fundamentals", 
  message = "Series is LIVE! New posts every day",
  href = "/series/machine-learning-fundamentals/"
} = Astro.props;
---

<div class="live-indicator-container">
  <a 
    href={href} 
    class="live-indicator group flex items-center gap-1.5 sm:gap-2 px-2 sm:px-3 py-1.5 bg-gradient-to-r from-red-500 to-orange-500 hover:from-red-600 hover:to-orange-600 text-white text-xs font-medium rounded-full shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-xl whitespace-nowrap"
    aria-label={`${seriesName} - ${message}`}
    title=`Click to view ${seriesName}`
  >
    <!-- Live Dot Animation -->
    <div class="relative flex items-center">
      <div class="live-dot w-2 h-2 bg-white rounded-full animate-pulse"></div>
      <div class="live-ping absolute w-2 h-2 bg-white rounded-full animate-ping opacity-75"></div>
    </div>
    
    <!-- Text Content for different screen sizes -->
    <span class="text-content-xl">
      <span class="font-bold">LIVE</span>
      <span class="mx-1">•</span>
      <span>{seriesName}</span>
    </span>
    
    <span class="text-content-lg">
      <span class="font-bold">LIVE</span>
    </span>
    
    <span class="text-content-md">
      <span class="font-bold">LIVE</span>
    </span>
    
    <span class="text-content-sm font-bold">LIVE</span>
    
    <!-- Fire Icon -->
    <svg 
      class="w-3 h-3 text-yellow-300 group-hover:text-yellow-200 transition-colors animate-bounce" 
      fill="currentColor" 
      viewBox="0 0 20 20"
    >
      <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
    </svg>
  </a>
</div>

<style>
  .live-indicator {
    position: relative;
    overflow: hidden;
  }

  .live-indicator::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: shimmer 2s infinite;
  }

  .live-dot {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .live-ping {
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes shimmer {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: .5;
    }
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  /* Custom responsive text display */
  .text-content-xl {
    display: none;
  }
  
  .text-content-lg {
    display: none;
  }
  
  .text-content-md {
    display: none;
  }
  
  .text-content-sm {
    display: inline-block;
  }
  
  /* Show appropriate text for each breakpoint */
  @media (min-width: 640px) {
    .text-content-sm {
      display: none;
    }
    .text-content-md {
      display: inline-block;
    }
  }
  
  @media (min-width: 768px) {
    .text-content-md {
      display: none;
    }
    .text-content-lg {
      display: inline-block;
    }
  }
  
  @media (min-width: 1024px) {
    .text-content-lg {
      display: none;
    }
    .text-content-xl {
      display: inline-block;
    }
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .live-indicator-container {
      font-size: 0.75rem;
    }
    
    .live-indicator {
      min-width: auto;
      padding: 0.375rem 0.5rem;
    }
  }
  
  @media (min-width: 641px) and (max-width: 768px) {
    .live-indicator {
      font-size: 0.75rem;
    }
  }

  /* Dark mode adjustments */
  @media (prefers-color-scheme: dark) {
    .live-indicator {
      box-shadow: 0 4px 14px 0 rgba(239, 68, 68, 0.4);
    }
    
    .live-indicator:hover {
      box-shadow: 0 6px 20px 0 rgba(239, 68, 68, 0.6);
    }
  }
</style>
