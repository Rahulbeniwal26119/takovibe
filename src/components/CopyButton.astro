---

<button aria-label="Copy code" data-copied="false" class="hidden">
    <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 copy-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="m4 16c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2h8c1.1 0 2 .9 2 2"/>
    </svg>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 check-icon hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M20 6 9 17l-5-5"/>
    </svg>
</button>

<script>
    function updateCopyButtons() {
        document.querySelectorAll("pre").forEach((block) => {
            if (!block.querySelector(".copy-button")) {
                const button = document.createElement("button");
                button.className =
                    "copy-button absolute right-3 top-3 group flex items-center justify-center transition-all duration-200 ease-in-out";
                button.style.height = "36px";
                button.style.width = "36px";
                button.setAttribute("aria-label", "Copy code to clipboard");
                button.innerHTML = `
          <div class="absolute inset-0 bg-gradient-to-br from-gray-600/80 to-gray-800/80 dark:from-gray-700/80 dark:to-gray-900/80 rounded-lg backdrop-blur-sm border border-gray-300/20 dark:border-gray-600/20 transition-all duration-200 group-hover:from-blue-500/80 group-hover:to-purple-600/80 group-hover:border-blue-400/30"></div>
          <svg xmlns="http://www.w3.org/2000/svg" class="relative h-4 w-4 copy-icon text-gray-100 dark:text-gray-200 transition-all duration-200 group-hover:text-white group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="m4 16c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2h8c1.1 0 2 .9 2 2"/>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="relative h-4 w-4 check-icon text-green-300 hidden transition-all duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        `;

                block.style.position = "relative";

                button.addEventListener("click", async () => {
                    const code = block.querySelector("code");
                    const text = code?.textContent || "";

                    try {
                        await navigator.clipboard.writeText(text);
                        
                        const copyIcon = button.querySelector(".copy-icon");
                        const checkIcon = button.querySelector(".check-icon");
                        const bgDiv = button.querySelector("div");

                        // Success animation
                        copyIcon?.classList.add("hidden");
                        checkIcon?.classList.remove("hidden");
                        bgDiv?.classList.add("copied-bg");
                        button.classList.add("copied");

                        // Add success pulse animation
                        button.style.transform = "scale(1.1)";
                        setTimeout(() => {
                            button.style.transform = "scale(1)";
                        }, 150);

                        setTimeout(() => {
                            copyIcon?.classList.remove("hidden");
                            checkIcon?.classList.add("hidden");
                            bgDiv?.classList.remove("copied-bg");
                            button.classList.remove("copied");
                        }, 2000);
                    } catch (err) {
                        console.error("Failed to copy:", err);
                        // Show error state briefly
                        button.style.transform = "scale(0.95)";
                        setTimeout(() => {
                            button.style.transform = "scale(1)";
                        }, 150);
                    }
                });

                block.appendChild(button);
            }
        });
    }

    // Initial setup
    updateCopyButtons();

    // Update on dynamic content changes
    document.addEventListener("astro:after-swap", updateCopyButtons);
</script>

<style>
    .copy-button {
        opacity: 0;
        transform: translateY(-2px) scale(0.95);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 8px;
        backdrop-filter: blur(8px);
    }

    pre:hover .copy-button {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .copy-button:hover {
        transform: translateY(-1px) scale(1.05);
        filter: brightness(1.1);
    }

    .copy-button:active {
        transform: translateY(0) scale(0.98);
        transition: all 0.1s ease;
    }

    .copy-button:focus {
        opacity: 1;
        outline: none;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5);
    }

    .copy-button.copied {
        transform: translateY(0) scale(1);
    }

    .copied-bg {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.8), rgba(21, 128, 61, 0.8)) !important;
        border-color: rgba(34, 197, 94, 0.4) !important;
    }

    /* Enhanced animations */
    @keyframes success-pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    .copy-button.copied {
        animation: success-pulse 0.3s ease;
    }

    /* Improved mobile styles */
    @media (max-width: 768px) {
        .copy-button {
            opacity: 0.8;
            right: 12px;
            top: 12px;
            height: 34px;
            width: 34px;
            transform: translateY(0) scale(0.95);
        }
        
        pre:hover .copy-button,
        .copy-button:focus {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .copy-button:hover {
            transform: translateY(0) scale(1.02);
        }
    }

    @media (max-width: 480px) {
        .copy-button {
            opacity: 0.9;
            right: 8px;
            top: 8px;
            height: 32px;
            width: 32px;
        }
    }

    /* Dark mode enhancements */
    @media (prefers-color-scheme: dark) {
        .copy-button:focus {
            box-shadow: 0 0 0 2px rgba(147, 197, 253, 0.5);
        }
    }

    /* Smooth icon transitions */
    .copy-icon, .check-icon {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Backdrop blur support check */
    @supports not (backdrop-filter: blur(8px)) {
        .copy-button div {
            background: rgba(75, 85, 99, 0.9) !important;
        }
        
        @media (prefers-color-scheme: dark) {
            .copy-button div {
                background: rgba(31, 41, 55, 0.9) !important;
            }
        }
    }
</style>

