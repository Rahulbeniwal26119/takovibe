---
import SocialShare from "./SocialShare.astro";

const currentPath = Astro.url.pathname;
const slug = currentPath.split('/').filter(Boolean).pop();
const apiUrl = import.meta.env.PUBLIC_API_URL;
const { post, position = "sidebar" } = Astro.props;
---

<!-- Desktop Sidebar Version (Fixed positioning for large screens ≥1407px) -->
<div class="desktop-interactions hidden lg:block">
  <!-- Floating Interaction Panel -->
  <div 
    id="interactionButtons" 
    class="fixed left-6 top-1/2 -translate-y-1/2 flex flex-col gap-3 z-[60] transition-all duration-300"
  >
    <!-- Like Button -->
    <div class="group relative">
      <button
        id="likeButton"
        class="flex flex-col items-center p-4 rounded-2xl bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm shadow-lg hover:shadow-xl border border-gray-200/50 dark:border-gray-700/50 hover:scale-105 transition-all duration-300"
      >
        <svg
          class="w-6 h-6 text-red-500 group-hover:scale-110 transition-transform duration-200"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span id="likeCount" class="text-sm font-semibold text-gray-700 dark:text-gray-300 mt-1">0</span>
      </button>
      <!-- Tooltip -->
      <div class="absolute left-full ml-3 top-1/2 -translate-y-1/2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 whitespace-nowrap z-10">
        Hold to like multiple times
      </div>
    </div>

    <!-- Comment Button -->
    <div class="group relative">
      <button
        id="commentToggle"
        class="p-4 rounded-2xl bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm shadow-lg hover:shadow-xl border border-gray-200/50 dark:border-gray-700/50 hover:scale-105 transition-all duration-300"
      >
        <svg 
          class="w-6 h-6 text-blue-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </button>
      <!-- Tooltip -->
      <div class="absolute left-full ml-3 top-1/2 -translate-y-1/2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 whitespace-nowrap z-10">
        Read & write comments
      </div>
    </div>

    <!-- Share Button -->
    <div class="group relative">
      <div class="p-4 rounded-2xl bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm shadow-lg hover:shadow-xl border border-gray-200/50 dark:border-gray-700/50 hover:scale-105 transition-all duration-300">
        <SocialShare 
          title={post.data.title} 
          url={Astro.url.href} 
        />
      </div>
      <!-- Tooltip -->
      <div class="absolute left-full ml-3 top-1/2 -translate-y-1/2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 whitespace-nowrap z-10">
        Share this article
      </div>
    </div>
  </div>

  <!-- Comment Panel -->
  <div 
    id="commentSection" 
    class="fixed left-0 top-1/2 -translate-y-1/2 h-[75vh] w-96 bg-white/95 dark:bg-gray-900/95 backdrop-blur-sm transform -translate-x-full transition-transform duration-500 z-50 overflow-hidden rounded-r-2xl shadow-2xl border-r border-gray-200/50 dark:border-gray-700/50"
  >
    <div class="h-full flex flex-col">
      <!-- Header -->
      <div class="px-6 py-4 border-b border-gray-200/50 dark:border-gray-700/50 bg-gradient-to-r from-purple-500/10 to-blue-500/10">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Discussion</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Share your thoughts on this article</p>
      </div>
      
      <!-- Input Area -->
      <div class="p-6 border-b border-gray-200/50 dark:border-gray-700/50">
        <div class="space-y-3">
          <textarea
            id="commentInput"
            class="w-full px-4 py-3 border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none transition-all duration-200 placeholder-gray-500"
            rows="3"
            placeholder="What are your thoughts on this article?"
          ></textarea>
          <button 
            id="postCommentBtn"
            class="px-6 py-2.5 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-medium rounded-xl hover:from-purple-700 hover:to-blue-700 transition-all duration-200 flex items-center gap-2 ml-auto"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            Post Comment
          </button>
        </div>
      </div>

      <!-- Comments List -->
      <div class="flex-1 overflow-y-auto p-6">
        <div id="commentsList" class="space-y-4 custom-scrollbar">
          <!-- Comments will be dynamically inserted here -->
        </div>
        
        <!-- Load More Button -->
        <div id="loadMoreContainer" class="mt-6 text-center hidden">
          <button 
            id="loadMoreBtn"
            class="px-6 py-2.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-200 inline-flex items-center gap-2"
          >
            <span>Load More Comments</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Inline Version (Shows at top/bottom of articles for screens <1407px) -->
<div class="mobile-interactions block lg:hidden">
  <!-- Main Interactions Card -->
  <div class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border border-gray-200/80 dark:border-gray-700/80 rounded-2xl shadow-lg overflow-hidden">
    <!-- Primary Actions Bar -->
    <div class="p-6">
      <div class="flex items-center justify-between">
        <!-- Like Section -->
        <button
          id="mobileLikeButton"
          class="group flex items-center space-x-3 px-5 py-3 bg-gradient-to-r from-red-50 to-pink-50 dark:from-red-900/20 dark:to-pink-900/20 hover:from-red-100 hover:to-pink-100 dark:hover:from-red-900/30 dark:hover:to-pink-900/30 rounded-xl transition-all duration-300 border border-red-100 dark:border-red-800/50"
        >
          <svg
            class="w-6 h-6 text-red-500 group-hover:scale-110 transition-transform duration-200"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
          </svg>
          <div class="flex items-center space-x-2">
            <span id="mobileLikeCount" class="text-lg font-semibold text-gray-900 dark:text-white">0</span>
            <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Likes</span>
          </div>
        </button>

        <!-- Comments Toggle -->
        <button
          id="mobileCommentToggle"
          class="group flex items-center space-x-3 px-5 py-3 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 hover:from-blue-100 hover:to-indigo-100 dark:hover:from-blue-900/30 dark:hover:to-indigo-900/30 rounded-xl transition-all duration-300 border border-blue-100 dark:border-blue-800/50"
        >
          <svg 
            class="w-6 h-6 text-blue-500 group-hover:scale-110 transition-transform duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Discuss</span>
        </button>

        <!-- Share Section -->
        <div class="px-5 py-3 bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-xl border border-green-100 dark:border-green-800/50">
          <SocialShare 
            title={post.data.title} 
            url={Astro.url.href} 
            compact={true}
          />
        </div>
      </div>
    </div>

    <!-- Mobile Comments Section (Expandable) -->
    <div 
      id="mobileCommentSection" 
      class="border-t border-gray-200/80 dark:border-gray-700/80 bg-gray-50/50 dark:bg-gray-800/50 hidden"
    >
      <div class="p-6">
        <!-- Comment Input Area -->
        <div class="space-y-4 mb-6">
          <div class="flex items-center space-x-3 mb-3">
            <div class="w-8 h-8 bg-gradient-to-br from-purple-500 to-blue-500 rounded-full flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Join the discussion</span>
          </div>
          
          <textarea
            id="mobileCommentInput"
            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none transition-all duration-200 placeholder-gray-500"
            rows="3"
            placeholder="Share your thoughts on this article..."
          ></textarea>
          
          <div class="flex justify-end">
            <button 
              id="mobilePostCommentBtn"
              class="px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-medium rounded-xl hover:from-purple-700 hover:to-blue-700 transition-all duration-200 flex items-center gap-2 shadow-lg"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
              Post Comment
            </button>
          </div>
        </div>

        <!-- Comments Display -->
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-gray-200 dark:border-gray-700 pb-3">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-white">Comments</h4>
            <span class="text-sm text-gray-500 dark:text-gray-400">Latest first</span>
          </div>
          
          <div id="mobileCommentsList" class="space-y-4 max-h-96 overflow-y-auto custom-scrollbar">
            <!-- Comments will be dynamically inserted here -->
          </div>
          
          <!-- Load More Button -->
          <div id="mobileLoadMoreContainer" class="pt-4 text-center hidden">
            <button 
              id="mobileLoadMoreBtn"
              class="px-6 py-3 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-200 inline-flex items-center gap-2 border border-gray-200 dark:border-gray-600 shadow-sm"
            >
              <span>Load More Comments</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ slug, apiUrl }}>
  // Desktop elements
  const commentToggle = document.getElementById('commentToggle');
  const commentSection = document.getElementById('commentSection');
  const interactionButtons = document.getElementById('interactionButtons');
  const likeButton = document.getElementById('likeButton');
  const likeCountElement = document.getElementById('likeCount');
  const commentsList = document.getElementById('commentsList');
  const commentInput = document.getElementById('commentInput');
  const postCommentBtn = document.getElementById('postCommentBtn');
  const loadMoreBtn = document.getElementById('loadMoreBtn');
  const loadMoreContainer = document.getElementById('loadMoreContainer');

  // Mobile elements
  const mobileLikeButton = document.getElementById('mobileLikeButton');
  const mobileLikeCountElement = document.getElementById('mobileLikeCount');
  const mobileCommentToggle = document.getElementById('mobileCommentToggle');
  const mobileCommentSection = document.getElementById('mobileCommentSection');
  const mobileCommentsList = document.getElementById('mobileCommentsList');
  const mobileCommentInput = document.getElementById('mobileCommentInput');
  const mobilePostCommentBtn = document.getElementById('mobilePostCommentBtn');
  const mobileLoadMoreBtn = document.getElementById('mobileLoadMoreBtn');
  const mobileLoadMoreContainer = document.getElementById('mobileLoadMoreContainer');
  
  let likeCount = 0;
  let likeTimeout = null;
  let pendingLikes = 0;
  let likeUpdateTimeout = null;
  let nextCommentsUrl = null;
  let isLoadingComments = false;

  // Fetch blog stats
  async function fetchBlogStats() {
    try {
      const response = await fetch(`${apiUrl}/api/blogs/meta/?blog_slug=${slug}`);
      const data = await response.json();
      
      if (data.code === 0) {
        likeCount = data.data.like_count || 0;
        // Update both desktop and mobile like counts
        if (likeCountElement) likeCountElement.textContent = likeCount.toString();
        if (mobileLikeCountElement) mobileLikeCountElement.textContent = likeCount.toString();
      }
    } catch (error) {
      console.error('Error fetching blog stats:', error);
    }
  }

  // Fetch comments for both desktop and mobile
  async function fetchComments(url = null, isMobile = false) {
    if (isLoadingComments) return;
    
    isLoadingComments = true;
    try {
      const fetchUrl = url || `${apiUrl}/api/blogs/comments/?blog_slug=${slug}`;
      const response = await fetch(fetchUrl);
      const data = await response.json();
      
      nextCommentsUrl = data.next;
      
      // Show or hide load more button based on whether there's a next page
      const loadMoreContainer = isMobile ? mobileLoadMoreContainer : document.getElementById('loadMoreContainer');
      if (loadMoreContainer) {
        if (nextCommentsUrl) {
          loadMoreContainer.classList.remove('hidden');
        } else {
          loadMoreContainer.classList.add('hidden');
        }
      }
      
      const targetCommentsList = isMobile ? mobileCommentsList : commentsList;
      if (targetCommentsList && data.results) {
        const commentsHtml = data.results.map(comment => {
          if (isMobile) {
            return `
              <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-3 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-gray-600 dark:text-gray-400 text-xs font-medium">Anonymous User</span>
                  <span class="text-gray-500 dark:text-gray-500 text-xs">${new Date(comment.created_at).toLocaleDateString()}</span>
                </div>
                <p class="text-gray-900 dark:text-gray-100 text-sm leading-relaxed">${comment.comment}</p>
              </div>
            `;
          } else {
            return `
              <div class="bg-gray-800/50 rounded-xl p-3 space-y-2">
                <span class="text-gray-400 text-xs">User • ${new Date(comment.created_at).toLocaleString()}</span>
                <p class="text-white text-sm">${comment.comment}</p>
              </div>
            `;
          }
        }).join('');
        
        if (url) {
          targetCommentsList.innerHTML += commentsHtml;
        } else {
          targetCommentsList.innerHTML = commentsHtml;
        }
      }
    } catch (error) {
      console.error('Error fetching comments:', error);
    } finally {
      isLoadingComments = false;
    }
  }

  // Post comment (works for both desktop and mobile)
  async function postComment(comment, isMobile = false) {
    try {
      const response = await fetch(`${apiUrl}/api/blogs/comments/`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          comment,
          blog: slug
        })
      });

      if (response.ok) {
        // Refresh comments for both versions
        await fetchComments(null, false); // Desktop
        await fetchComments(null, true);  // Mobile
        await fetchBlogStats(); // Refresh stats
        
        // Clear input
        if (isMobile && mobileCommentInput) {
          mobileCommentInput.value = '';
        } else if (commentInput) {
          commentInput.value = '';
        }
      }
    } catch (error) {
      console.error('Error posting comment:', error);
    }
  }

  // Update likes
  async function updateLikes() {
    if (pendingLikes > 0) {
      try {
        const response = await fetch(`${apiUrl}/api/blogs/likes/`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            likes: pendingLikes,
            blog: slug
          })
        });

        if (response.ok) {
          pendingLikes = 0;
          await fetchBlogStats();
        }
      } catch (error) {
        console.error('Error updating likes:', error);
      }
    }
  }

  // Like functionality for both desktop and mobile
  function setupLikeButton(button, isHolding = false) {
    if (!button) return;

    const incrementLike = () => {
      likeCount++;
      pendingLikes++;
      
      // Update both counters
      if (likeCountElement) likeCountElement.textContent = likeCount.toString();
      if (mobileLikeCountElement) mobileLikeCountElement.textContent = likeCount.toString();
      
      const heartIcon = button.querySelector('svg');
      if (heartIcon) {
        heartIcon.classList.add('scale-125', 'text-red-600');
        setTimeout(() => {
          heartIcon.classList.remove('scale-125');
          heartIcon.classList.add('text-red-500');
        }, 200);
      }
      
      if (likeUpdateTimeout) clearTimeout(likeUpdateTimeout);
      likeUpdateTimeout = setTimeout(() => updateLikes(), 1000);
      
      if (isHolding) {
        likeTimeout = setTimeout(incrementLike, 150);
      }
    };

    let isHoldingState = false;

    button.addEventListener('mousedown', () => {
      isHoldingState = true;
      incrementLike();
    });

    button.addEventListener('mouseup', () => {
      isHoldingState = false;
      if (likeTimeout) clearTimeout(likeTimeout);
    });

    button.addEventListener('mouseleave', () => {
      isHoldingState = false;
      if (likeTimeout) clearTimeout(likeTimeout);
    });

    // For mobile, also add touch events
    button.addEventListener('touchstart', () => {
      incrementLike();
    });
  }

  // Setup desktop like button
  if (likeButton) setupLikeButton(likeButton);
  
  // Setup mobile like button
  if (mobileLikeButton) setupLikeButton(mobileLikeButton);

  // Desktop comment toggle
  if (commentToggle && commentSection && interactionButtons) {
    commentToggle.addEventListener('click', () => {
      const isHidden = commentSection.classList.contains('-translate-x-full');
      commentSection.classList.toggle('-translate-x-full');
      
      if (isHidden) {
        interactionButtons.classList.add('opacity-0', '-translate-x-full');
        fetchComments(null, false); // Load desktop comments
      } else {
        interactionButtons.classList.remove('opacity-0', '-translate-x-full');
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!commentSection.contains(e.target) && !commentToggle.contains(e.target)) {
        commentSection.classList.add('-translate-x-full');
        interactionButtons.classList.remove('opacity-0', '-translate-x-full');
      }
    });
  }

  // Mobile comment toggle
  if (mobileCommentToggle && mobileCommentSection) {
    mobileCommentToggle.addEventListener('click', () => {
      const isHidden = mobileCommentSection.classList.contains('hidden');
      mobileCommentSection.classList.toggle('hidden');
      
      if (isHidden) {
        fetchComments(null, true); // Load mobile comments
      }
    });
  }

  // Handle comment submission for desktop
  if (postCommentBtn && commentInput) {
    postCommentBtn.addEventListener('click', () => {
      const comment = commentInput.value.trim();
      if (comment) postComment(comment, false);
    });

    commentInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const comment = commentInput.value.trim();
        if (comment) postComment(comment, false);
      }
    });
  }

  // Handle comment submission for mobile
  if (mobilePostCommentBtn && mobileCommentInput) {
    mobilePostCommentBtn.addEventListener('click', () => {
      const comment = mobileCommentInput.value.trim();
      if (comment) postComment(comment, true);
    });

    mobileCommentInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const comment = mobileCommentInput.value.trim();
        if (comment) postComment(comment, true);
      }
    });
  }
  
  // Load more comments for desktop
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      if (nextCommentsUrl && !isLoadingComments) {
        fetchComments(nextCommentsUrl, false);
      }
    });
  }

  // Load more comments for mobile
  if (mobileLoadMoreBtn) {
    mobileLoadMoreBtn.addEventListener('click', () => {
      if (nextCommentsUrl && !isLoadingComments) {
        fetchComments(nextCommentsUrl, true);
      }
    });
  }

  // Initial load
  fetchBlogStats();
</script>

<style>
  /* Smooth transitions for all interactions */
  .desktop-interactions, .mobile-interactions {
    transition: all 0.3s ease-out;
  }

  /* Custom scrollbar styling */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #9CA3AF transparent;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #9CA3AF;
    border-radius: 20px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: #6B7280;
  }

  /* Desktop: Show sidebar interactions, hide mobile */
  @media (min-width: 1407px) {
    .desktop-interactions {
      display: block !important;
    }
    
    .mobile-interactions {
      display: none !important;
    }
  }
  
  /* Mobile/Tablet: Hide sidebar interactions, show mobile */
  @media (max-width: 1406px) {
    .desktop-interactions {
      display: none !important;
    }
    
    .mobile-interactions {
      display: block !important;
    }
  }

  /* Enhanced hover effects for desktop */
  @media (min-width: 1407px) {
    .desktop-interactions button:hover {
      transform: translateY(-2px);
    }
    
    .desktop-interactions .group:hover .absolute {
      opacity: 1;
      pointer-events: none;
    }
  }

  /* Mobile-specific enhancements */
  @media (max-width: 1406px) {
    .mobile-interactions {
      margin: 0 auto;
      max-width: 100%;
    }
    
    .mobile-interactions button {
      min-height: 44px; /* iOS touch target minimum */
    }
  }

  /* Tablet optimizations */
  @media (min-width: 768px) and (max-width: 1406px) {
    .mobile-interactions {
      max-width: 768px;
      margin: 0 auto;
    }
  }

  /* Small mobile optimizations */
  @media (max-width: 480px) {
    .mobile-interactions .flex {
      flex-direction: column;
      gap: 1rem;
    }
    
    .mobile-interactions button {
      width: 100%;
      justify-content: center;
    }
  }

