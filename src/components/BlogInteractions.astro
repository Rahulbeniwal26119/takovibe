---
// No props needed for now, but you can add them later if needed
---

<div class="relative">
  <!-- Interaction Buttons -->
  <div 
    id="interactionButtons" 
    class="fixed left-4 top-1/2 -translate-y-1/2 flex flex-col gap-4 z-[60] transition-all duration-300"
  >
    <button
      id="likeButton"
      class="group flex flex-col items-center p-3 rounded-full bg-gray-900 hover:bg-gray-800 transition-all duration-300"
    >
      <svg
        class="w-6 h-6 text-white group-hover:scale-110 transition-transform duration-200"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
      </svg>
      <span id="likeCount" class="text-sm font-medium text-white">0</span>
    </button>

    <button
      id="commentToggle"
      class="p-3 rounded-full bg-gray-900 hover:bg-gray-800 transition-all duration-300"
    >
      <svg 
        class="w-6 h-6 text-white"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
    </button>
  </div>

  <!-- Comment Section -->
  <div 
    id="commentSection" 
    class="fixed left-0 top-1/2 -translate-y-1/2 h-[70vh] w-80 bg-gray-900/95 backdrop-blur-sm transform -translate-x-full transition-transform duration-300 z-50 overflow-hidden rounded-r-xl"
  >
    <div class="h-full flex flex-col p-4">
      <h3 class="text-xl font-medium text-white mb-4">Comments</h3>
      
      <!-- Input area -->
      <div class="space-y-3 mb-4">
        <textarea
          id="commentInput"
          class="w-full px-3 py-2 border-2 border-gray-800 bg-gray-800/50 text-white rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none transition-all duration-200"
          rows="2"
          placeholder="Share your thoughts..."
        ></textarea>
        <button 
          id="postCommentBtn"
          class="w-full px-4 py-1.5 bg-gradient-to-r from-gray-900 to-gray-800 text-white text-sm font-medium rounded-full hover:from-gray-800 hover:to-gray-700 transition-all duration-200"
        >
          Post Comment
        </button>
      </div>

      <!-- Comments list -->
      <div id="commentsList" class="flex-1 overflow-y-auto space-y-4 pr-2 custom-scrollbar">
        <!-- Comments will be dynamically inserted here -->
      </div>
    </div>
  </div>
</div>

<script>
  const commentToggle = document.getElementById('commentToggle');
  const commentSection = document.getElementById('commentSection');
  const interactionButtons = document.getElementById('interactionButtons');
  let likeCount = 0;
  let likeTimeout = null;

  // Like button functionality
  const likeButton = document.getElementById('likeButton');
  const likeCountElement = document.getElementById('likeCount');

  if (likeButton && likeCountElement) {
    let isHolding = false;

    const incrementLike = () => {
      likeCount++;
      likeCountElement.textContent = likeCount.toString();
      
      const heartIcon = likeButton.querySelector('svg');
      if (heartIcon) {
        heartIcon.classList.add('scale-125');
        setTimeout(() => heartIcon.classList.remove('scale-125'), 100);
      }
      
      if (isHolding) {
        likeTimeout = setTimeout(incrementLike, 150);
      }
    };

    likeButton.addEventListener('mousedown', () => {
      isHolding = true;
      incrementLike();
    });

    likeButton.addEventListener('mouseup', () => {
      isHolding = false;
      if (likeTimeout) {
        clearTimeout(likeTimeout);
      }
    });

    likeButton.addEventListener('mouseleave', () => {
      isHolding = false;
      if (likeTimeout) {
        clearTimeout(likeTimeout);
      }
    });
  }

  // Comment section toggle
  if (commentToggle && commentSection && interactionButtons) {
    commentToggle.addEventListener('click', () => {
      const isHidden = commentSection.classList.contains('-translate-x-full');
      commentSection.classList.toggle('-translate-x-full');
      
      // Animate the buttons
      if (isHidden) {
        // Panel is opening, hide buttons
        interactionButtons.classList.add('opacity-0', '-translate-x-full');
      } else {
        // Panel is closing, show buttons
        interactionButtons.classList.remove('opacity-0', '-translate-x-full');
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!commentSection.contains(e.target) && !commentToggle.contains(e.target)) {
        commentSection.classList.add('-translate-x-full');
        interactionButtons.classList.remove('opacity-0', '-translate-x-full');
      }
    });
  }

  // Add dummy comments on load
  document.addEventListener('DOMContentLoaded', () => {
    const dummyComments = [
      "This is absolutely brilliant! The way you've explained complex concepts makes it so easy to understand.",
      "I've been following your blog for a while, and this is one of your best posts yet! 🎉",
      "Interesting perspective! Have you considered exploring the relationship between these concepts further?",
      "The examples you provided really helped clarify things. Thanks for sharing! 👍",
      "This reminds me of a similar concept I learned about recently. Great explanation!",
      "Your writing style makes technical topics so approachable. Keep it up! 💯",
      "I had a different view on this, but your arguments are very convincing.",
      "The diagrams and illustrations really help visualize the concepts. Well done! 🎨",
      "This is exactly what I needed to read today. Perfect timing!",
      "Quick question - how does this apply to [specific scenario]? Would love your thoughts!",
      "The practical applications you've outlined are super helpful. Going to try these out.",
      "Been struggling with this topic for a while, but your explanation finally made it click! 🌟",
      "Love how you've broken down such a complex topic into digestible pieces.",
      "This post deserves more attention! Sharing it with my network. 🚀",
      "Looking forward to more content like this. Your blog is becoming my go-to resource!"
    ];

    const commentsList = document.getElementById('commentsList');
    if (commentsList) {
      dummyComments.forEach((text, index) => {
        const commentHtml = `
          <div class="bg-gray-800/50 rounded-xl p-3 space-y-2">
            <span class="text-gray-400 text-xs">User ${index + 1} • ${new Date(Date.now() - index * 3600000).toLocaleString()}</span>
            <p class="text-white text-sm">${text}</p>
          </div>
        `;
        commentsList.insertAdjacentHTML('beforeend', commentHtml);
      });
    }
  });
</script> 

<style>
  #interactionButtons {
    transition: all 0.3s ease-out;
  }

  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #4B5563 transparent;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #4B5563;
    border-radius: 20px;
  }
</style> 