---
import SocialShare from "./SocialShare.astro";

const currentPath = Astro.url.pathname;
const slug = currentPath.split('/').filter(Boolean).pop();
const apiUrl = import.meta.env.PUBLIC_API_URL;
const { post } = Astro.props;
---

<div class="relative">
  <!-- Interaction Buttons -->
  <div 
    id="interactionButtons" 
    class="fixed left-4 top-1/2 -translate-y-1/2 flex flex-col gap-4 z-[60] transition-all duration-300"
  >
    <button
      id="likeButton"
      class="group flex flex-col items-center p-3 rounded-full bg-gray-900 hover:bg-gray-800 transition-all duration-300"
    >
      <svg
        class="w-6 h-6 text-white group-hover:scale-110 transition-transform duration-200"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
      </svg>
      <span id="likeCount" class="text-sm font-medium text-white">0</span>
    </button>

    <button
      id="commentToggle"
      class="p-3 rounded-full bg-gray-900 hover:bg-gray-800 transition-all duration-300"
    >
      <svg 
        class="w-6 h-6 text-white"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
    </button>

    <button>
      <SocialShare 
        title={post.data.title} 
        url={Astro.url.href} 
      />
    </button>
  </div>

  <!-- Comment Section -->
  <div 
    id="commentSection" 
    class="fixed left-0 top-1/2 -translate-y-1/2 h-[70vh] w-80 bg-gray-900/95 backdrop-blur-sm transform -translate-x-full transition-transform duration-300 z-50 overflow-hidden rounded-r-xl"
  >
    <div class="h-full flex flex-col p-4">
      <h3 class="text-xl font-medium text-white mb-4">Comments</h3>
      
      <!-- Input area -->
      <div class="space-y-3 mb-4">
        <textarea
          id="commentInput"
          class="w-full px-3 py-2 border-2 border-gray-800 bg-gray-800/50 text-white rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none transition-all duration-200"
          rows="2"
          placeholder="Share your thoughts..."
        ></textarea>
        <button 
          id="postCommentBtn"
          class="px-4 py-1.5 bg-gradient-to-r from-purple-600 to-purple-700 text-white text-sm font-medium rounded-full hover:from-purple-700 hover:to-purple-800 transition-all duration-200 ml-auto flex items-center gap-1"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Post
        </button>
      </div>

      <!-- Comments list -->
      <div id="commentsList" class="flex-1 overflow-y-auto space-y-4 pr-2 custom-scrollbar">
        <!-- Comments will be dynamically inserted here -->
      </div>
      
      <!-- Load More Button -->
      <div id="loadMoreContainer" class="mt-3 text-center hidden">
        <button 
          id="loadMoreBtn"
          class="px-4 py-1.5 bg-gray-800 text-white text-sm font-medium rounded-full hover:bg-gray-700 transition-all duration-200 inline-flex items-center gap-1"
        >
          <span>Show More</span>
          <svg class="w-3.5 h-3.5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ slug, apiUrl }}>
  const commentToggle = document.getElementById('commentToggle');
  const commentSection = document.getElementById('commentSection');
  const interactionButtons = document.getElementById('interactionButtons');
  const likeButton = document.getElementById('likeButton');
  const likeCountElement = document.getElementById('likeCount');
  const commentsList = document.getElementById('commentsList');
  const commentInput = document.getElementById('commentInput');
  const postCommentBtn = document.getElementById('postCommentBtn');
  const loadMoreBtn = document.getElementById('loadMoreBtn');
  const loadMoreContainer = document.getElementById('loadMoreContainer');
  
  let likeCount = 0;
  let likeTimeout = null;
  let pendingLikes = 0;
  let likeUpdateTimeout = null;
  let nextCommentsUrl = null;
  let isLoadingComments = false;

  // Fetch blog stats
  async function fetchBlogStats() {
    try {
      const response = await fetch(`${apiUrl}/api/blogs/meta/?blog_slug=${slug}`);
      const data = await response.json();
      
      if (data.code === 0) {
        likeCount = data.data.like_count || 0;
        likeCountElement.textContent = likeCount.toString();
      }
    } catch (error) {
      console.error('Error fetching blog stats:', error);
    }
  }

  // Fetch comments
  async function fetchComments(url = null) {
    if (isLoadingComments) return;
    
    isLoadingComments = true;
    try {
      const fetchUrl = url || `${apiUrl}/api/blogs/comments/?blog_slug=${slug}`;
      const response = await fetch(fetchUrl);
      const data = await response.json();
      
      // Store next page URL if it exists
      nextCommentsUrl = data.next;
      
      // Show or hide load more button based on whether there's a next page
      if (nextCommentsUrl) {
        loadMoreContainer.classList.remove('hidden');
      } else {
        loadMoreContainer.classList.add('hidden');
      }
      
      if (commentsList && data.results) {
        // If loading more comments, append them; otherwise, replace the content
        const commentsHtml = data.results.map(comment => `
          <div class="bg-gray-800/50 rounded-xl p-3 space-y-2">
            <span class="text-gray-400 text-xs">User • ${new Date(comment.created_at).toLocaleString()}</span>
            <p class="text-white text-sm">${comment.comment}</p>
          </div>
        `).join('');
        
        if (url) {
          // Append comments if loading more
          commentsList.innerHTML += commentsHtml;
        } else {
          // Replace comments if initial load
          commentsList.innerHTML = commentsHtml;
        }
      }
    } catch (error) {
      console.error('Error fetching comments:', error);
    } finally {
      isLoadingComments = false;
    }
  }

  // Post comment
  async function postComment(comment) {
    try {
      const response = await fetch(`${apiUrl}/api/blogs/comments/`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          comment,
          blog: slug
        })
      });

      if (response.ok) {
        await fetchComments(); // Refresh comments
        await fetchBlogStats(); // Refresh stats
        commentInput.value = ''; // Clear input
      }
    } catch (error) {
      console.error('Error posting comment:', error);
    }
  }

  // Add function to update likes
  async function updateLikes() {
    if (pendingLikes > 0) {
      try {
        const response = await fetch(`${apiUrl}/api/blogs/likes/`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            likes: pendingLikes,
            blog: slug
          })
        });

        if (response.ok) {
          pendingLikes = 0; // Reset pending likes after successful update
          await fetchBlogStats(); // Refresh the stats
        }
      } catch (error) {
        console.error('Error updating likes:', error);
      }
    }
  }

  // Like button functionality
  if (likeButton && likeCountElement) {
    let isHolding = false;

    const incrementLike = () => {
      likeCount++;
      pendingLikes++;
      likeCountElement.textContent = likeCount.toString();
      
      const heartIcon = likeButton.querySelector('svg');
      if (heartIcon) {
        heartIcon.classList.add('scale-125');
        setTimeout(() => heartIcon.classList.remove('scale-125'), 100);
      }
      
      // Clear existing timeout
      if (likeUpdateTimeout) {
        clearTimeout(likeUpdateTimeout);
      }
      
      // Set new timeout to update likes
      likeUpdateTimeout = setTimeout(() => {
        updateLikes();
      }, 1000);
      
      if (isHolding) {
        likeTimeout = setTimeout(incrementLike, 150);
      }
    };

    likeButton.addEventListener('mousedown', () => {
      isHolding = true;
      incrementLike();
    });

    likeButton.addEventListener('mouseup', () => {
      isHolding = false;
      if (likeTimeout) {
        clearTimeout(likeTimeout);
      }
    });

    likeButton.addEventListener('mouseleave', () => {
      isHolding = false;
      if (likeTimeout) {
        clearTimeout(likeTimeout);
      }
    });
  }

  // Comment section toggle functionality
  if (commentToggle && commentSection && interactionButtons) {
    commentToggle.addEventListener('click', () => {
      const isHidden = commentSection.classList.contains('-translate-x-full');
      commentSection.classList.toggle('-translate-x-full');
      
      if (isHidden) {
        interactionButtons.classList.add('opacity-0', '-translate-x-full');
      } else {
        interactionButtons.classList.remove('opacity-0', '-translate-x-full');
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!commentSection.contains(e.target) && !commentToggle.contains(e.target)) {
        commentSection.classList.add('-translate-x-full');
        interactionButtons.classList.remove('opacity-0', '-translate-x-full');
      }
    });
  }

  // Handle comment submission
  if (postCommentBtn && commentInput) {
    postCommentBtn.addEventListener('click', () => {
      const comment = commentInput.value.trim();
      if (comment) {
        postComment(comment);
      }
    });

    // Allow Enter key to submit
    commentInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const comment = commentInput.value.trim();
        if (comment) {
          postComment(comment);
        }
      }
    });
  }
  
  // Load more comments
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      if (nextCommentsUrl && !isLoadingComments) {
        fetchComments(nextCommentsUrl);
      }
    });
  }

  // Initial load
  fetchBlogStats();
  fetchComments();
</script>

<style>
  #interactionButtons {
    transition: all 0.3s ease-out;
  }

  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #4B5563 transparent;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #4B5563;
    border-radius: 20px;
  }
</style> 