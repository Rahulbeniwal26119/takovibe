---
// Parked: not rendered anywhere. A sitewide promo banner earns nothing at the
// current traffic level while costing the publication's positioning, so it was
// removed from Layout.astro. The mechanism is kept because it is generic - the
// `promos` array below drives the copy - so it can be re-pointed at an
// audience-appropriate product (Runo is the closest fit) if traffic justifies it.
---

<div
    id="top-banner"
    class="sticky top-0 z-[10001] w-full -translate-y-full border-b border-neutral-200 bg-white text-neutral-900 shadow-sm transition-transform duration-500 ease-out dark:border-orange-500/20 dark:bg-neutral-950 dark:text-neutral-50"
    style="display: none;"
>
    <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2 sm:px-6"
    >
        <!-- Message -->
        <div class="flex min-w-0 items-center gap-3">
            <span
                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-orange-500/30 bg-orange-500/10 text-orange-600 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-300"
                aria-hidden="true"
            >
                <svg
                    class="h-3.5 w-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"
                    ></path>
                </svg>
            </span>
            <p class="truncate text-sm font-medium">
                <span id="banner-title-desktop" class="hidden sm:inline"
                    >ResumeVibe is open for early builders</span
                >
                <span id="banner-title-mobile" class="sm:hidden">ResumeVibe is live</span>
                <span class="mx-2 hidden text-neutral-400 md:inline dark:text-neutral-500">/</span>
                <span id="banner-subtitle" class="hidden text-neutral-600 md:inline dark:text-neutral-300"
                    >Run AI diagnostics on your resume</span
                >
            </p>
        </div>

        <!-- Actions -->
        <div class="flex shrink-0 items-center gap-2">
            <a
                id="banner-link"
                href="https://resumevibe.takovibe.com/"
                class="inline-flex items-center gap-1.5 rounded-full bg-orange-500 px-3 py-1.5 text-xs font-bold text-white transition-colors hover:bg-orange-600"
            >
                <span id="banner-cta">Try ResumeVibe</span>
                <svg
                    class="h-3.5 w-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                    ></path>
                </svg>
            </a>

            <!-- Close -->
            <button
                id="close-banner"
                class="rounded-full p-1 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-700 dark:text-neutral-400 dark:hover:bg-white/10 dark:hover:text-white"
                aria-label="Dismiss"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>
</div>

<script>
    const BANNER_KEY = "takovibe_top_banner_closed_ts";
    const TWENTY_FOUR_HOURS = 24 * 60 * 60 * 1000;

    function syncBannerOffset(banner) {
        const isVisible = banner && banner.style.display !== "none";
        document.documentElement.style.setProperty(
            "--top-banner-height",
            isVisible ? `${banner.offsetHeight}px` : "0px",
        );
    }

    function initBanner() {
        const banner = document.getElementById("top-banner");
        const closeBtn = document.getElementById("close-banner");

        if (!banner) return;

        const promos = [
            {
                desktop: "ResumeVibe is open for early builders",
                mobile: "ResumeVibe is live",
                subtitle: "Run AI diagnostics on your resume",
                cta: "Try ResumeVibe",
                href: "https://resumevibe.takovibe.com/",
            },
        ];

        const promo = promos[Math.floor(Date.now() / TWENTY_FOUR_HOURS) % promos.length];
        const titleDesktop = document.getElementById("banner-title-desktop");
        const titleMobile = document.getElementById("banner-title-mobile");
        const subtitle = document.getElementById("banner-subtitle");
        const cta = document.getElementById("banner-cta");
        const link = document.getElementById("banner-link");

        if (titleDesktop) titleDesktop.textContent = promo.desktop;
        if (titleMobile) titleMobile.textContent = promo.mobile;
        if (subtitle) subtitle.textContent = promo.subtitle;
        if (cta) cta.textContent = promo.cta;
        if (link) link.setAttribute("href", promo.href);

        // Check Local Storage
        const lastClosed = localStorage.getItem(BANNER_KEY);
        if (lastClosed) {
            const timePassed = Date.now() - parseInt(lastClosed, 10);
            if (timePassed < TWENTY_FOUR_HOURS) {
                // Still within 24 hours, keeping hidden
                syncBannerOffset(banner);
                return;
            }
        }

        // Show Banner
        banner.style.display = "block";
        syncBannerOffset(banner);
        // Small delay for slide-down animation
        requestAnimationFrame(() => {
            banner.classList.remove("-translate-y-full");
        });

        // Handle Close
        if (closeBtn && closeBtn.dataset.bound !== "true") {
            closeBtn.dataset.bound = "true";
            closeBtn.addEventListener("click", () => {
                banner.classList.add("-translate-y-full");

                // Record timestamp
                localStorage.setItem(BANNER_KEY, Date.now().toString());

                // Remove from DOM after transition
                setTimeout(() => {
                    banner.style.display = "none";
                    syncBannerOffset(banner);
                }, 500); // Match duration-500
            });
        }

        if (banner.dataset.resizeBound !== "true") {
            banner.dataset.resizeBound = "true";
            new ResizeObserver(() => syncBannerOffset(banner)).observe(banner);
        }
    }

    // Run on every page load (View Transitions compatible)
    document.addEventListener("astro:page-load", initBanner);
    document.addEventListener("DOMContentLoaded", initBanner);
</script>
