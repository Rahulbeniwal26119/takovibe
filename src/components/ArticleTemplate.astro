                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                                                />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        )
                    }

                    <!-- Footer (Moved outside for full width) -->
                </main>

                <!-- Right Sidebar: Interactive Toolkit (Promotional) -->
                <aside class="hidden xl:block w-72 flex-shrink-0 sticky top-24">
                    <div
                        class="pl-6 border-l border-gray-100 dark:border-gray-800 space-y-8"
                    >
                        <!-- Header -->
                        <h5
                            class="text-xs font-bold text-gray-500 uppercase tracking-widest"
