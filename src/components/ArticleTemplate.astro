    );
    */

    // Zen Menu Toggle Logic
    const zenTrigger = document.getElementById("zen-menu-trigger");
    const zenMenu = document.getElementById("zen-menu-dropdown");

    if (zenTrigger && zenMenu) {
        zenTrigger.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const isOpen = zenMenu.classList.contains("opacity-100");

            if (isOpen) {
                // Close
                zenMenu.classList.add(
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                zenMenu.classList.remove(
                    "opacity-100",
                    "scale-100",
                    "pointer-events-auto",
                );
                zenTrigger.classList.remove(
                    "bg-white/90",
                    "dark:bg-gray-800",
                    "ring-2",
                    "ring-purple-500/50",
                );
            } else {
                // Open
                zenMenu.classList.remove(
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                zenMenu.classList.add(
                    "opacity-100",
                    "scale-100",
                    "pointer-events-auto",
                );
                zenTrigger.classList.add(
                    "bg-white/90",
                    "dark:bg-gray-800",
                    "ring-2",
                    "ring-purple-500/50",
                );
            }
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (
                !zenMenu.contains(e.target as Node) &&
                !zenTrigger.contains(e.target as Node)
            ) {
                zenMenu.classList.add(
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                zenMenu.classList.remove(
                    "opacity-100",
                    "scale-100",
                    "pointer-events-auto",
                );
                zenTrigger.classList.remove(
                    "bg-white/90",
                    "dark:bg-gray-800",
                    "ring-2",
                    "ring-purple-500/50",
                );
            }
        });
    }
</script>
<!-- Structured Data -->
<script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(articleStructuredData)}
/>
<script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(breadcrumbStructuredData)}
/>
{
    post.contentJson && (
        <script
            type="application/ld+json"
            slot="head"
            set:html={generateFAQSchema(post.contentJson)}
        />
    )
}
<ReadingProgress />
<SelectionPopover />

<div class="min-h-screen">
    <!-- Main Content Layout -->
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 pb-0">
        <!-- Main Content Layout (Flexbox for robust sidebar positioning) -->
        <div
            id="immersive-article-container"
            class="max-w-[1600px] mx-auto px-4 sm:px-6 pb-12 transition-all duration-300"
        >
            <div
                class="flex flex-col lg:flex-row gap-8 xl:gap-12 relative items-start justify-center"
            >
                <!-- Left Sidebar: Moved per user request -->
                <aside class="hidden lg:block w-64 flex-shrink-0 sticky top-24">
                    <div
                        class="pr-6 border-r border-gray-100 dark:border-gray-800"
                    >
                        <h5
                            class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4"
                        >
                            Contents
                        </h5>
                        <TableOfContents headings={headings} />
                    </div>

                    <div class="mt-8 pr-6">
                        <a
                            href="/write"
                            class="text-sm font-medium text-purple-600 hover:text-purple-700 flex items-center gap-1"
                        >
                            Write on TakoVibe &rarr;
                        </a>
                    </div>
                </aside>

                <!-- Main Article Content -->
                <main class="flex-1 min-w-0 max-w-5xl">
                    <!-- min-w-0 prevents flex overflow -->

                    <!-- Native Clean Header (No gradients) -->
                    <header class="mb-12 text-center pt-16">
                        <div class="space-y-6">
                            <!-- Series / Tags -->
                            <div
                                class="flex flex-wrap items-center justify-center gap-3 text-sm"
                            >
                                {
                                    post.data.series && (
                                        <a
                                            href={`/series/${post.data.series.toLowerCase().replace(/\s+/g, "-")}`}
                                            class="px-3 py-1 rounded-full bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300 font-medium hover:bg-purple-200 dark:hover:bg-purple-900/60 transition-colors"
                                        >
                                            {post.data.series}
                                        </a>
                                    )
                                }

                                <span
                                    class="text-gray-500 dark:text-gray-400 font-mono text-xs uppercase tracking-wider"
                                >
                                    {
                                        new Date(
                                            post.data.date,
                                        ).toLocaleDateString("en-US", {
                                            month: "long",
                                            day: "numeric",
                                            year: "numeric",
                                        })
                                    }
                                </span>
                                <span class="text-gray-300 dark:text-gray-600"
                                    >•</span
                                >
                                <span
                                    class="text-gray-500 dark:text-gray-400 font-medium"
                                >
                                    {post.data.readingTime || "5 min read"}
                                </span>
                            </div>

                            <!-- Title (Native Font: Space Grotesk) -->
                            <h1
                                class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-gray-50 leading-[1.1]"
                            >
                                {post.data.title}
                            </h1>

                            <!-- Tags (Under Title) -->
                            <div
                                class="flex flex-wrap items-center justify-center gap-2"
                            >
                                {
                                    post.data.tags?.map((tag: string) => (
                                        <a
                                            href={`/blog?tag=${encodeURIComponent(tag.toLowerCase())}`}
                                            class="px-3 py-1 rounded-full text-sm font-medium bg-gray-100/50 text-gray-600 hover:bg-purple-50 hover:text-purple-700 dark:bg-gray-800/50 dark:text-gray-400 dark:hover:bg-purple-900/20 dark:hover:text-purple-300 transition-colors border border-gray-100 dark:border-white/5"
                                        >
                                            #{tag}
                                        </a>
                                    ))
                                }
                            </div>

                            <!-- Author Info -->
                            <div
                                class="flex items-center justify-center gap-4 pt-4"
                            >
                                <a
                                    href={`/profile/${post.authorUsername || post.data.author.toLowerCase().replace(/\s+/g, "-")}`}
                                    class="flex items-center gap-3 group/author"
                                >
                                    <div
                                        class="w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-600 dark:text-gray-300 font-bold text-sm ring-2 ring-white dark:ring-gray-800"
                                    >
                                        {post.data.author.charAt(0)}
                                    </div>
                                    <div class="flex flex-col text-left">
                                        <span
                                            class="text-sm font-semibold text-gray-900 dark:text-white group-hover/author:text-purple-500 transition-colors"
                                        >
                                            {post.data.author}
                                        </span>
                                        <span
                                            class="text-xs text-gray-500 dark:text-gray-400"
                                        >
                                            @{
                                                post.authorUsername ||
                                                    post.data.author
                                                        .toLowerCase()
                                                        .replace(/\s+/g, "")
                                            }
                                        </span>
                                    </div>
                                </a>

                                <!-- Actions -->
                                <div
                                    class="ml-4 pl-4 border-l border-gray-200 dark:border-gray-800 flex items-center gap-2"
                                >
                                    <button
                                        class="save-btn p-2 text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-all"
                                        data-blog-id={post.slug}
                                        aria-label="Save for later"
                                        title="Save for Later"
                                    >
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                                            ></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </header>

                    <!-- Feature Image (Native Clean style) -->
                    {
                        post.data.image && (
                            <div class="relative mb-12 rounded-xl overflow-hidden shadow-sm ring-1 ring-gray-900/5 dark:ring-white/10">
                                <img
                                    src={
                                        post.data.image.startsWith("http")
                                            ? post.data.image
                                            : `https://takovibe.com${post.data.image}`
                                    }
                                    alt={post.data.title}
                                    class="w-full h-auto object-cover max-h-[600px]"
                                />
                            </div>
                        )
                    }

                    <!-- Article Body (Native Font) -->
                    <article
                        class="prose prose-lg md:prose-xl dark:prose-invert max-w-none
            prose-headings:font-bold prose-headings:tracking-tight
            prose-p:text-gray-800 dark:prose-p:text-gray-300 prose-p:leading-relaxed
            prose-code:text-purple-600 dark:prose-code:text-purple-400
            prose-img:rounded-xl prose-img:shadow-sm"
                        id="Article"
                    >
                        <div class="mdx-content">
                            {
                                isStatic && Content ? (
                                    <Content />
                                ) : post.contentJson ? (
                                    <TiptapRenderer
                                        client:only="react"
                                        content={post.contentJson}
                                    >
                                        <div
                                            slot="fallback"
                                            class="animate-pulse space-y-6 py-6 font-sans"
                                        >
                                            {/* Paragraph Skeleton */}
                                            <div class="space-y-3">
                                                <div class="h-4 bg-gray-200 dark:bg-gray-800 rounded w-full" />
                                                <div class="h-4 bg-gray-200 dark:bg-gray-800 rounded w-5/6" />
                                                <div class="h-4 bg-gray-200 dark:bg-gray-800 rounded w-4/6" />
                                            </div>

                                            {/* Block/Image Skeleton */}
                                            <div class="h-48 sm:h-64 bg-gray-100 dark:bg-gray-900 rounded-xl w-full border border-gray-200 dark:border-gray-800" />

                                            {/* Paragraph Skeleton */}
                                            <div class="space-y-3">
                                                <div class="h-4 bg-gray-200 dark:bg-gray-800 rounded w-11/12" />
                                                <div class="h-4 bg-gray-200 dark:bg-gray-800 rounded w-full" />
                                                <div class="h-4 bg-gray-200 dark:bg-gray-800 rounded w-3/4" />
                                            </div>
                                        </div>
                                    </TiptapRenderer>
                                ) : (
                                    <div set:html={htmlContent} />
                                )
                            }
                        </div>
                    </article>

                    <!-- Series Callout -->
                    {
                        post.data.series && (
                            <div class="mt-12 p-6 sm:p-8 bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 border-2 border-yellow-400/50 dark:border-yellow-600/50 rounded-2xl">
                                <div class="flex items-start gap-4">
                                    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-xl flex items-center justify-center text-2xl shadow-lg">
                                        📚
                                    </div>
                                    <div class="flex-1">
                                        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                                            Part of the {post.data.series}{" "}
                                            Series
                                        </h2>
                                        <p class="text-gray-700 dark:text-gray-300 mb-4">
                                            This article is part of a
                                            comprehensive learning series. Check
                                            out all articles in this series to
                                            master the topic!
