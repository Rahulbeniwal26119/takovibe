    // Zen Menu Toggle Logic
    const zenTrigger = document.getElementById("zen-menu-trigger");
    const zenMenu = document.getElementById("zen-menu-dropdown");

    if (zenTrigger && zenMenu) {
        zenTrigger.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const isOpen = zenMenu.classList.contains("opacity-100");

            if (isOpen) {
                // Close
                zenMenu.classList.add(
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                zenMenu.classList.remove(
                    "opacity-100",
                    "scale-100",
                    "pointer-events-auto",
                );
                zenTrigger.classList.remove(
                    "bg-white/90",
                    "dark:bg-gray-800",
                    "ring-2",
                    "ring-purple-500/50",
                );
            } else {
                // Open
                zenMenu.classList.remove(
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                zenMenu.classList.add(
                    "opacity-100",
                    "scale-100",
                    "pointer-events-auto",
                );
                zenTrigger.classList.add(
                    "bg-white/90",
                    "dark:bg-gray-800",
                    "ring-2",
                    "ring-purple-500/50",
                );
            }
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (
                !zenMenu.contains(e.target as Node) &&
                !zenTrigger.contains(e.target as Node)
            ) {
                zenMenu.classList.add(
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                zenMenu.classList.remove(
                    "opacity-100",
                    "scale-100",
                    "pointer-events-auto",
                );
                zenTrigger.classList.remove(
                    "bg-white/90",
                    "dark:bg-gray-800",
                    "ring-2",
                    "ring-purple-500/50",
                );
            }
        });
    }
</script>
<!-- Structured Data -->
