<style>
    /* Force dark text in light mode for article content */
    :root:not(.dark) .prose p,
    :root:not(.dark) .prose li {
        color: #111827 !important; /* gray-900 */
    }

    /* Smooth scrolling */
    html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
    }

    /* Typography enhancements */
    .prose p {
        margin-bottom: 1.5em;
        font-size: 1rem; /* 16px base size on mobile */
    }

    @media (min-width: 640px) {
        .prose p {
            font-size: 1.125rem; /* 18px on desktop */
