<script>
    function setupArticleNav() {
        const nav = document.getElementById("zen-nav");
        const trigger = document.getElementById("zen-menu-trigger");
        const menu = document.getElementById("zen-menu-dropdown");

        if (!nav || !trigger || !menu || trigger.dataset.bound === "true") return;

        let lastScroll = window.scrollY;
        trigger.dataset.bound = "true";

        const setMenuOpen = (isOpen: boolean) => {
            menu.classList.toggle("opacity-100", isOpen);
            menu.classList.toggle("scale-100", isOpen);
            menu.classList.toggle("pointer-events-auto", isOpen);
            menu.classList.toggle("opacity-0", !isOpen);
            menu.classList.toggle("scale-95", !isOpen);
            menu.classList.toggle("pointer-events-none", !isOpen);

            trigger.classList.toggle("border-orange-300", isOpen);
            trigger.classList.toggle("text-orange-600", isOpen);
            trigger.classList.toggle("dark:border-orange-700", isOpen);
            trigger.classList.toggle("dark:text-orange-300", isOpen);
            trigger.classList.toggle("ring-2", isOpen);
            trigger.classList.toggle("ring-orange-500/40", isOpen);
            trigger.setAttribute("aria-expanded", String(isOpen));
        };

        // The shell stays pointer-events-none so the gap between islands never
        // blocks the article; only the islands themselves are interactive.
        const showNav = () => {
            nav.classList.remove("-translate-y-24", "opacity-0");
        };

        const hideNav = () => {
            setMenuOpen(false);
            nav.classList.add("-translate-y-24", "opacity-0");
        };

        trigger.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();
            showNav();
            setMenuOpen(!menu.classList.contains("opacity-100"));
        });

        document.addEventListener("click", (event) => {
            if (!menu.contains(event.target as Node) && !trigger.contains(event.target as Node)) {
                setMenuOpen(false);
            }
        });

        window.addEventListener(
            "scroll",
            () => {
                const currentScroll = window.scrollY;
                const scrollingDown = currentScroll > lastScroll + 6;
                const scrollingUp = currentScroll < lastScroll - 6;

                if (currentScroll > 120 && scrollingDown) {
                    hideNav();
                } else if (scrollingUp || currentScroll < 80) {
                    showNav();
                }

                lastScroll = currentScroll;
            },
            { passive: true },
        );
    }

    setupArticleNav();
    document.addEventListener("astro:page-load", setupArticleNav);
</script>
