---
import Layout from "../layouts/Layout.astro";
import Footer from "./Footer.astro";
import RelatedPosts from "./RelatedPosts.astro";
import ReaderToolbar from "./ReaderToolbar.astro";
import ReadingProgress from "./ReadingProgress.astro";
import TableOfContents from "./TableOfContents.astro";
import SelectionPopover from "./SelectionPopover.astro";
import LoginPromptModal from "./LoginPromptModal";
import DangerConfirmationModal from "./DangerConfirmationModal";
import QuizHydrator from "./QuizHydrator";
import CodePlaygroundHydrator from "./CodePlaygroundHydrator";
import ExcalidrawHydrator from "./ExcalidrawHydrator";
import ChatBot from "./ChatBot";
import { TiptapRenderer } from "./TiptapRenderer";
import { generateFAQSchema } from "../utils/seo-utils";
import fs from "node:fs";
import path from "node:path";

interface Props {
    post: any;
    headings: any[];
    htmlContent?: string;
    Content?: any;
    isStatic?: boolean;
}

const { post, headings, htmlContent, Content, isStatic = false } = Astro.props;

const getLastModified = () => {
    try {
        if (isStatic) {
            const filePath = path.join(
                process.cwd(),
                "src/content/blog",
                post.id,
            );
            const stats = fs.statSync(filePath);
            return stats.mtime.toISOString();
        } else {
            return new Date(post.data.date).toISOString();
        }
    } catch (e) {
        return new Date(post.data.date).toISOString();
    }
};

const lastModified = getLastModified();
const publishDate = new Date(post.data.date).toISOString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const articleStructuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    datePublished: publishDate,
    dateModified: lastModified,
    author: {
        "@type": "Person",
        name: post.data.author,
        url: "https://takovibe.com/about/",
    },
    description: post.data.description,
    image: {
        "@type": "ImageObject",
        url: post.data.image?.startsWith("http")
            ? post.data.image
            : `https://takovibe.com${post.data.image}`,
        height: "630",
        width: "1200",
    },
    url: canonicalUrl,
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
    },
    keywords: post.data.tags?.join(", "),
    publisher: {
        "@type": "Organization",
        name: "TakoVibe",
        logo: {
            "@type": "ImageObject",
            url: "https://takovibe.com/images/logo.svg",
            width: "192",
            height: "192",
        },
    },
};

const breadcrumbStructuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://takovibe.com",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Blog",
            item: "https://takovibe.com/blog",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: post.data.title,
            item: canonicalUrl,
        },
    ],
};
---

<Layout
    title={post.data.title}
    description={post.data.description}
    type="article"
    author={post.data.author}
    tags={post.data.tags}
    published_date={publishDate}
    modified_date={lastModified}
    no_footer={true}
    no_header={true}
>
    <!-- Smart Zen Navigation (Scroll-aware) -->
    <nav
        id="zen-nav"
        class="fixed top-6 left-6 z-50 transition-all duration-500 ease-in-out transform translate-y-0 opacity-100"
    >
        <div class="relative group">
            <!-- Trigger Button -->
            <button
                id="zen-menu-trigger"
                class="p-3 rounded-full bg-white/10 dark:bg-black/20 backdrop-blur-md border border-gray-200/20 dark:border-white/10 shadow-lg hover:shadow-xl hover:bg-white/90 dark:hover:bg-gray-800 transition-all duration-300 group-hover:scale-105"
                aria-label="Menu"
            >
                <svg
                    class="w-6 h-6 text-gray-900 dark:text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>

            <!-- Dropdown Menu -->
            <div
                id="zen-menu-dropdown"
                class="absolute top-full left-0 mt-3 w-48 bg-white/90 dark:bg-gray-900/90 backdrop-blur-xl border border-gray-200/50 dark:border-gray-700/50 rounded-2xl shadow-2xl overflow-hidden transform origin-top-left transition-all duration-200 opacity-0 scale-95 pointer-events-none"
            >
                <div class="p-1.5 space-y-1">
                    <a
                        href="/"
                        class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 text-gray-700 dark:text-gray-200 font-medium transition-colors"
                    >
                        <svg
                            class="w-5 h-5 opacity-70"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                            ></path>
                        </svg>
                        Home
                    </a>
                    <a
                        href="/blog"
                        class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 text-gray-700 dark:text-gray-200 font-medium transition-colors"
                    >
                        <svg
                            class="w-5 h-5 opacity-70"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                            ></path>
                        </svg>
                        Blog
                    </a>
                    <a
                        href="/notes"
                        class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 text-gray-700 dark:text-gray-200 font-medium transition-colors"
                    >
                        <svg
                            class="w-5 h-5 opacity-70"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                            ></path>
                        </svg>
                        Notes
                    </a>
                    <a
                        href="/series"
                        class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 text-gray-700 dark:text-gray-200 font-medium transition-colors"
                    >
                        <svg
                            class="w-5 h-5 opacity-70"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
                            ></path>
                        </svg>
                        Series
                    </a>
                </div>
                <a
                    href="/saved"
                    class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 text-gray-700 dark:text-gray-200 font-medium transition-colors"
                >
                    <svg
                        class="w-5 h-5 opacity-70"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                        ></path>
                    </svg>
                    Saved
                </a>
            </div>
        </div>
    </nav>
</Layout>

<script>
    // Smart Scroll Logic for Zen Nav - DISABLED to keep it always visible
    // Zen Nav now stays sticky at all times
    /*
    let lastScroll = 0;
    const nav = document.getElementById("zen-nav");

    window.addEventListener(
        "scroll",
        () => {
            const currentScroll = window.scrollY;

            if (!nav) return;

