import RelatedPosts from "./RelatedPosts.astro";
import ReaderToolbar from "./ReaderToolbar.astro";
import MobileActionDock from "./MobileActionDock.astro";
import ReadingProgress from "./ReadingProgress.astro";
import TableOfContents from "./TableOfContents.astro";
import SelectionPopover from "./SelectionPopover.astro";
import LoginPromptModal from "./LoginPromptModal";
import DangerConfirmationModal from "./DangerConfirmationModal";
import QuizHydrator from "./QuizHydrator";
import CodePlaygroundHydrator from "./CodePlaygroundHydrator";
import ExcalidrawHydrator from "./ExcalidrawHydrator";
import CodeEditorDrawer from "./CodeEditorDrawer";
import ChatBot from "./ChatBot";
import { TiptapRenderer } from "./TiptapRenderer";
import { generateFAQSchema } from "../utils/seo-utils";
import fs from "node:fs";
import path from "node:path";

interface Props {
    post: any;
    headings: any[];
    htmlContent?: string;
    Content?: any;
    isStatic?: boolean;
}

// Feature Flag: Mobile UX Improvements
const enableMobileDock = import.meta.env.PUBLIC_ENABLE_MOBILE_DOCK === 'true' || true; // Enabled by default for widespread testing

const { post, headings, htmlContent, Content, isStatic = false } = Astro.props;

const getLastModified = () => {
    try {
        if (isStatic) {
            const filePath = path.join(
                process.cwd(),
                "src/content/blog",
                post.id,
            );
            const stats = fs.statSync(filePath);
            return stats.mtime.toISOString();
        } else {
            return new Date(post.data.date).toISOString();
        }
    } catch (e) {
        return new Date(post.data.date).toISOString();
    }
};

const lastModified = getLastModified();
const publishDate = new Date(post.data.date).toISOString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const serverHtml = htmlContent || (post.contentJson ? generateServerHtml(post.contentJson): '');

const articleStructuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": canonicalUrl,
    headline: post.data.title,
    datePublished: publishDate,
    dateModified: lastModified,
    author: {
        "@type": "Person",
        name: post.data.author,
        url: `https://takovibe.com/profile/${post.authorUsername || post.data.author.toLowerCase().replace(/\s+/g, "-")}`,
    },
    description: post.data.description,
    image: [
        {
            "@type": "ImageObject",
            url: (post.data.image?.startsWith("http")
                ? post.data.image
                : `https://takovibe.com${post.data.image}`) + (post.data.image?.match(/\.[a-zA-Z0-9]+$/) ? "" : ".png"),
            width: 1200,
            height: 630,
        },
    ],
    url: canonicalUrl,
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
    },
    keywords: post.data.tags?.join(", "),
    publisher: {
        "@type": "Organization",
        name: "TakoVibe",
        logo: {
            "@type": "ImageObject",
            url: "https://takovibe.com/images/logo.png",
            width: "192",
            height: "192",
        },
    },
};

const breadcrumbStructuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://takovibe.com",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Blog",
            item: "https://takovibe.com/blog",
        },
        {
            "@type": "ListItem",
            position: 3,
            name: post.data.title,
            item: canonicalUrl,
        },
    ],
};

const currentPath = Astro.url.pathname;
const articleMainNav = [
    { href: "/", label: "Home" },
    { href: "/blog", label: "Blog" },
    { href: "/series", label: "Series" },
    { href: "/notes", label: "Notes" },
    { href: "/playground", label: "Playground" },
    { href: "https://codediff.takovibe.com/", label: "CodeDiff" },
    { href: "https://resumevibe.takovibe.com/", label: "ResumeVibe" },
];
