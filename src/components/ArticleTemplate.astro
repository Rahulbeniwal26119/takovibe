                        <script>
                        async function loadSupportInfo() {
                            // Find username from profile link
                            const profileLink = document.querySelector('a[href^="/profile/"]');
                            let username = '';
                            if (profileLink) {
                                const parts = profileLink.getAttribute('href').split('/');
                                username = parts[parts.length - 1] || parts[parts.length - 2];
                            }

                            if (!username) return;

                            const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
                            
                            try {
                                const res = await fetch(`${API_BASE}/api/users/profile/${username}/`);
                                if (!res.ok) return;
                                
                                const data = await res.json();
                                const supportUrl = data.profile?.support_url;
                                
                                if (supportUrl) {
                                    // Render Sidebar Card
                                    const sidebarContainers = document.querySelectorAll('#support-sidebar-container, #support-sidebar-b-container');
                                    sidebarContainers.forEach(container => {
                                        if (container) {
                                            container.innerHTML = `
                                                <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-900/10 border border-amber-100 dark:border-amber-800/20 group/support transition-all hover:shadow-md">
                                                    <div class="flex items-center gap-3 mb-2.5">
                                                        <div class="text-xl">☕</div>
                                                        <h5 class="text-[10px] font-black text-amber-800 dark:text-amber-200 uppercase tracking-widest">Support</h5>
                                                    </div>
                                                    <p class="text-[10px] text-amber-900/70 dark:text-amber-200/50 leading-tight mb-4">
                                                        Enjoying the read? Help keep the tutorials coming!
                                                    </p>
                                                    <a
                                                        href="${supportUrl}"
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="block w-full py-2 bg-amber-400 hover:bg-amber-500 text-amber-950 text-[11px] font-bold rounded-lg text-center shadow-sm transition-all active:scale-95"
                                                    >
                                                        Buy Author a Coffee
                                                    </a>
                                                </div>
                                            `;
                                            container.classList.remove('hidden');
                                        }
                                    });

                                }
                            } catch (e) {
                                console.error('Failed to load support info', e);
                            }
                        }

                        // Run on load and after Astro swaps
                        loadSupportInfo();
                        document.addEventListener("astro:after-swap", loadSupportInfo);
                        </script>
