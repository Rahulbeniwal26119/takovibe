                        <script>
                        async function loadSupportInfo() {
                            // Find username from profile link
                            const profileLink = document.querySelector('a[href^="/profile/"]');
                            let username = '';
                            if (profileLink) {
                                const parts = profileLink.getAttribute('href').split('/');
                                username = parts[parts.length - 1] || parts[parts.length - 2];
                            }

                            if (!username) return;

                            const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
                            
                            try {
                                const res = await fetch(`${API_BASE}/api/users/profile/${username}/`);
                                if (!res.ok) return;
                                
                                const data = await res.json();
                                const supportUrl = data.profile?.support_url;
                                
                                if (supportUrl) {
                                    // Render Sidebar Card
                                    const sidebarContainers = document.querySelectorAll('#support-sidebar-b-container');
                                    sidebarContainers.forEach(container => {
                                        if (container) {
                                            container.innerHTML = `
                                                <div class="rounded-lg border border-neutral-200 bg-white/60 p-3 transition-colors hover:border-orange-300 dark:border-neutral-800 dark:bg-neutral-900/40 dark:hover:border-orange-800">
                                                    <div class="mb-2 flex items-center gap-2">
                                                        <div class="text-sm">☕</div>
                                                        <h5 class="text-[9px] font-black uppercase tracking-widest text-neutral-500 dark:text-neutral-400">Support</h5>
                                                    </div>
                                                    <a
                                                        href="${supportUrl}"
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="block w-full rounded-md bg-neutral-100 py-2 text-center text-[10px] font-bold text-neutral-700 transition-colors hover:bg-orange-50 hover:text-orange-700 active:scale-95 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-orange-950/30 dark:hover:text-orange-300"
                                                    >
                                                        Buy Author a Coffee
                                                    </a>
                                                </div>
                                            `;
                                            container.classList.remove('hidden');
                                        }
                                    });

                                }
                            } catch (e) {
                                console.error('Failed to load support info', e);
                            }
                        }

                        // Run on load and after Astro swaps
                        loadSupportInfo();
                        document.addEventListener("astro:after-swap", loadSupportInfo);
                        </script>
                    </article>
