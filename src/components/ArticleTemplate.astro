                        <!-- Kumi AI Card -->
                        <div
                            id="kumi-promo-card"
                            class="group relative rounded-2xl p-5 bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-purple-900/10 dark:to-indigo-900/10 border border-purple-100 dark:border-purple-800/30 transition-all hover:shadow-lg hover:shadow-purple-500/5 hover:-translate-y-1 cursor-pointer"
                        >
                            <div
                                class="absolute top-3 right-3 text-purple-200 dark:text-purple-800/30"
                            >
                                <svg
                                    class="w-12 h-12"
                                    fill="currentColor"
