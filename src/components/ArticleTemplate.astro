<script>
    // Remove tabindex from elements after the page loads
    document.addEventListener("DOMContentLoaded", () => {
        const elements = document.querySelectorAll('[tabindex="-1"]');
        elements.forEach((element) => {
            element.removeAttribute("tabindex");
        });
    });

    // Add interactive features to code blocks (Copy & Explain)
    function enhanceCodeBlocks() {
        // 2. Handle Text/Raw Blocks (Legacy/Fallback)
        // This handles any <pre> tags that were NOT rendered by the backend-renderer (e.g. from other markdown sources)
        // It provides a basic wrapper + floating buttons, but DOES NOT interfere with the rich SSR blocks.
        const codeBlocks = document.querySelectorAll("pre");

        codeBlocks.forEach((pre) => {
            // CRITICAL: Skip if this pre tag is already part of a rich Server-Rendered "Mac Window" block
            // This prevents double buttons and double wrapping.
            if (pre.closest(".code-block")) return;

            // Create wrapper if needed (Idempotent check)
            if (!pre.parentElement.classList.contains("code-block-wrapper")) {
                const wrapper = document.createElement("div");
                wrapper.className = "code-block-wrapper relative group";
                pre.parentNode.insertBefore(wrapper, pre);
                wrapper.appendChild(pre);
            }

            const wrapper = pre.parentElement;

            // Create Actions Container if needed
            let actionsContainer = wrapper.querySelector(".code-actions");
            if (!actionsContainer) {
                actionsContainer = document.createElement("div");
                actionsContainer.className =
                    "code-actions absolute top-2 right-2 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10";
                wrapper.appendChild(actionsContainer);
            }

            // 1. Add "Deep Dive" Explain Button
            let explainBtn = actionsContainer.querySelector(
                ".explain-code-btn",
            ) as HTMLButtonElement;
            if (!explainBtn) {
                explainBtn = document.createElement("button");
                explainBtn.className =
                    "explain-code-btn p-1.5 sm:p-2 bg-orange-600 hover:bg-orange-500 text-white rounded-lg transition-colors shadow-lg flex items-center gap-2 text-xs sm:text-sm font-medium";
                explainBtn.innerHTML = `
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    <span class="hidden sm:inline">Explain</span>
                `;
                explainBtn.title = "Explain with AI";
                actionsContainer.appendChild(explainBtn);
            }

            // 2. Add Copy Button
            let copyBtn = actionsContainer.querySelector(
                ".copy-code-btn",
            ) as HTMLButtonElement;
            if (!copyBtn) {
                copyBtn = document.createElement("button");
                copyBtn.className =
                    "copy-code-btn p-1.5 sm:p-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition-colors shadow-lg flex items-center gap-2 text-xs sm:text-sm font-medium";
                copyBtn.innerHTML = `
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                    <span class="hidden sm:inline">Copy</span>
                `;
                actionsContainer.appendChild(copyBtn);
            }

            // Event listeners for Explain and Copy buttons
            // These are attached to the buttons themselves, not the pre tag.
            // The code to copy/explain is dynamically determined based on active tab.
            if (!explainBtn.hasAttribute("data-bound-event")) {
                explainBtn.setAttribute("data-bound-event", "true");
                explainBtn.addEventListener("click", () => {
                    const code =
                        explainBtn.getAttribute("data-code") ||
                        pre.querySelector("code")?.textContent ||
                        pre.textContent;
                    const event = new CustomEvent("trigger-ai-chat", {
                        detail: {
                            text: code,
                            mode: "explain",
                        },
                    });
                    window.dispatchEvent(event);
                });
            }

            if (!copyBtn.hasAttribute("data-bound-event")) {
                copyBtn.setAttribute("data-bound-event", "true");
                copyBtn.addEventListener("click", async () => {
                    const code =
                        copyBtn.getAttribute("data-code") ||
                        pre.querySelector("code")?.textContent ||
                        pre.textContent;

                    try {
                        await navigator.clipboard.writeText(code);

                        // Visual feedback
                        const originalHTML = copyBtn.innerHTML;
                        copyBtn.innerHTML = `
                           <svg class="w-3.5 h-3.5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                           </svg>
                           <span class="hidden sm:inline text-green-400">Copied!</span>
                       `;
                        copyBtn.classList.add("bg-gray-800"); // slight darken

                        setTimeout(() => {
                            copyBtn.innerHTML = originalHTML;
                            copyBtn.classList.remove("bg-gray-800");
                        }, 2000);
                    } catch (err) {
                        console.error("Failed to copy:", err);
                    }
                });
            }

            // Tab Switching Logic (SSR)
            // This logic applies to the parent wrapper, not directly to the 'pre' tag.
            // We need to find the actual block that contains the tabs.
            // The 'pre' tag is inside a 'code-content-tab' which is inside a 'code-block-wrapper'
            // The 'code-block-wrapper' might also contain the tab buttons.
            const block = pre.closest(".code-block-wrapper"); // Find the closest wrapper that might contain tabs
            if (block && block.getAttribute("data-has-tabs") === "true") {
                const tabs = block.querySelectorAll(".tab-btn");
                const contents = block.querySelectorAll(".code-content-tab");

                tabs.forEach((tab) => {
                    if (tab.hasAttribute("data-bound-tab-event")) return; // Prevent re-binding
                    tab.setAttribute("data-bound-tab-event", "true");

                    tab.addEventListener("click", () => {
                        const index = tab.getAttribute("data-index");

                        // Update Tab Styles
                        tabs.forEach((t) => {
                            if (t.getAttribute("data-index") === index) {
                                t.className =
                                    "tab-btn flex items-center gap-1.5 px-2 py-1.5 sm:px-3 sm:py-1.5 rounded-md text-xs font-medium transition-all whitespace-nowrap bg-orange-900/30 text-orange-400 border border-orange-700";
                            } else {
                                t.className =
                                    "tab-btn flex items-center gap-1.5 px-2 py-1.5 sm:px-3 sm:py-1.5 rounded-md text-xs font-medium transition-all whitespace-nowrap text-gray-400 bg-gray-800/50 border border-gray-700 hover:bg-gray-700";
                            }
                        });

                        // Show/Hide Content
                        contents.forEach((content) => {
                            if (
                                content.getAttribute("data-tab-index") === index
                            ) {
                                content.classList.remove("hidden");
                                content.classList.add("block");

                                // Update Copy/Explain buttons to use THIS tab's code
                                const rawCode =
                                    content.querySelector("code")
                                        ?.textContent ||
                                    content.textContent ||
                                    "";
                                if (copyBtn)
                                    copyBtn.setAttribute("data-code", rawCode);
                                if (explainBtn)
                                    explainBtn.setAttribute(
                                        "data-code",
                                        rawCode,
                                    );
                            } else {
                                content.classList.add("hidden");
                                content.classList.remove("block");
                            }
                        });
                    });
                });
            }
        });
    }

    // Initialize on page load
    document.addEventListener("DOMContentLoaded", enhanceCodeBlocks);
    // Re-initialize after view transitions
    document.addEventListener("astro:after-swap", enhanceCodeBlocks);

    // Save Button Logic
    import {
        saveBookmark,
        removeBookmark,
        checkBookmarkStatus,
    } from "../utils/bookmarks";
    import { showToast } from "../utils/toast";

    function setupSaveButtons() {
        const saveBtns = document.querySelectorAll(".save-btn");

        saveBtns.forEach(async (btn) => {
            if (btn.hasAttribute("data-bound")) return;
            btn.setAttribute("data-bound", "true");

            const blogId = btn.getAttribute("data-blog-id");
            if (!blogId) return;

            // Check initial status
            const { isBookmarked, bookmarkId } =
                await checkBookmarkStatus(blogId);
            updateSaveButtonState(btn, isBookmarked);
            if (bookmarkId)
                btn.setAttribute("data-bookmark-id", bookmarkId.toString());

            btn.addEventListener("click", async (e) => {
                e.preventDefault();
                e.stopPropagation();

                const token = localStorage.getItem("access_token");
                if (!token) {
                    showToast(
                        "Please login to save articles for later.",
                        "info",
                    );
                    return;
                }

                const currentIsBookmarked =
                    btn.classList.contains("bg-orange-600");
                const currentBookmarkId = btn.getAttribute("data-bookmark-id");

                // Optimistic UI update
                updateSaveButtonState(btn, !currentIsBookmarked);

                let success = false;
                if (currentIsBookmarked && currentBookmarkId) {
                    success = await removeBookmark(parseInt(currentBookmarkId));
                    if (success) {
                        btn.removeAttribute("data-bookmark-id");
                        showToast("Article removed from saved list", "success");
                    }
                } else {
                    success = await saveBookmark(blogId);
                    if (success)
                        showToast("Article saved for later", "success");
                }

                if (!success) {
                    // Revert UI if failed
                    updateSaveButtonState(btn, currentIsBookmarked);
                    showToast(
                        "Failed to update bookmark. Please try again.",
                        "error",
                    );
                } else {
                    // Re-fetch to get ID
                    const { isBookmarked: newStatus, bookmarkId: newId } =
                        await checkBookmarkStatus(blogId);
                    if (newId)
                        btn.setAttribute("data-bookmark-id", newId.toString());
                }
            });
        });
    }

    function updateSaveButtonState(btn: Element, isSaved: boolean) {
        const icon = btn.querySelector("svg");
        const text = btn.querySelector("span");

        if (isSaved) {
            btn.classList.add("bg-orange-600", "border-orange-500", "text-white");
            btn.classList.remove("bg-white/20", "border-white/30", "text-neutral-400");
            if (icon) icon.setAttribute("fill", "currentColor");
            if (text) text.textContent = "Saved";
        } else {
            btn.classList.remove("bg-orange-600", "border-orange-500", "text-white");
            btn.classList.add("bg-white/20", "border-white/30", "text-neutral-400");
            if (icon) icon.setAttribute("fill", "none");
            if (text) text.textContent = "Save";
        }
    }

    // Initialize
    setupSaveButtons();
    document.addEventListener("astro:after-swap", setupSaveButtons);

    function setupPromoCards() {
        // Handle all Kumi AI buttons
        const kumiCards = document.querySelectorAll('[id*="kumi-promo-card"], .kumi-promo-trigger');
        kumiCards.forEach(kumiCard => {
            if (kumiCard.hasAttribute('data-bound')) return;
            kumiCard.setAttribute('data-bound', 'true');
            kumiCard.addEventListener("click", () => {
                const token = localStorage.getItem("access_token");
                if (!token) {
                    const event = new CustomEvent("show-login-prompt", {
                        detail: {
                            feature: "Kumi AI",
                            next: window.location.pathname + window.location.search,
                        },
                    });
                    window.dispatchEvent(event);
                    return;
                }
                window.dispatchEvent(new CustomEvent("toggle-ai-chat"));
            });
        });


        // Handle all Visual Notes buttons
        const notesCards = document.querySelectorAll('[id*="notes-promo-card"], .notes-promo-trigger');
        notesCards.forEach(notesCard => {
            if (notesCard.hasAttribute('data-bound')) return;
            notesCard.setAttribute('data-bound', 'true');
            notesCard.addEventListener("click", () => {
                const token = localStorage.getItem("access_token");
                if (!token) {
                    const event = new CustomEvent("show-login-prompt", {
                        detail: {
                            feature: "sketch notes",
                            next: window.location.pathname + window.location.search,
                        },
                    });
                    window.dispatchEvent(event);
                    return;
                }
                window.dispatchEvent(new CustomEvent("toggle-excalidraw"));
            });
        });

        // Handle Code Studio Promo Cards
        const codeCards = document.querySelectorAll("#code-promo-card");
        codeCards.forEach(codeCard => {
            codeCard.addEventListener("click", () => {
                const token = localStorage.getItem("access_token");
                if (!token) {
                    const event = new CustomEvent("show-login-prompt", {
                        detail: {
                            feature: "Code Studio",
                            next: window.location.pathname + window.location.search,
                        },
                    });
                    window.dispatchEvent(event);
                    return;
                }

                window.dispatchEvent(
                    new CustomEvent("open-code-studio", {
                        detail: {
                            code: "",
                            language: "python",
                        },
                    }),
                );
            });
        });
    }
    setupPromoCards();
    document.addEventListener("astro:after-swap", setupPromoCards);

    // Series Navigation Loader
    async function loadSeriesArticles() {
        const seriesSidebar = document.getElementById('series-sidebar');
        if (!seriesSidebar) return; // Not on a series article

        const seriesTitle = seriesSidebar.querySelector('h3')?.textContent?.trim();
        if (!seriesTitle) return;

        const currentSlug = window.location.pathname.split('/').filter(Boolean).pop();
        const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

        try {
            // Fetch series details using the dedicated endpoint (User requested)
            const response = await fetch(`${API_BASE}/api/blogs/series/get-series-by-article/?slug=${currentSlug}`);
            
            if (!response.ok) {
                throw new Error('Failed to fetch series');
            }

            const rawData = await response.json();
            
            // API returns: { message, data: { articles: [...], ... } }
            const seriesData = rawData.data || rawData;
            const articlesRaw = seriesData.articles || [];
            
            // Extract articles from nested structure: { article: {...}, order: 1 }
            // The SeriesArticleSerializer returns flattened structure? Let's check backend.
            // SeriesArticleSerializer has: article (SeriesBlogSerializer), order.
            // So structure is: [ { article: {title, slug}, order: 1 }, ... ]
            const articles = articlesRaw.map(item => ({
                ...(item.article || item),
                order: item.order
            }));
            
            // Find current article index
            const currentIndex = articles.findIndex(a => a.slug === currentSlug);
            // Progress tracking - Coming in future release
            // const completedCount = currentIndex >= 0 ? currentIndex + 1 : 0;
            // const totalCount = articles.length;
            // const progressPercent = totalCount > 0 ? (completedCount / totalCount) * 100 : 0;

            // Update progress bar - Coming in future release
            /* const progressContainer = document.getElementById('series-progress-container');
            if (progressContainer) {
                progressContainer.innerHTML = `...`;
            } */

            // Populate articles list
            const articlesList = document.getElementById('series-articles-list');
            if (articlesList && articles.length > 0) {
                articlesList.innerHTML = articles.map((article, index) => {
                    const isCurrent = article.slug === currentSlug;
                    const isCompleted = index < currentIndex;
                    const isLast = index === articles.length - 1;
                    
                    return `
                        <a 
                            href="/blog/${article.slug}"
                            class="relative flex items-start gap-3 group py-3"
                        >
                            <!-- Connection Line -->
                            ${!isLast ? `<div class="absolute left-[13px] top-[36px] bottom-[-12px] w-[1px] ${isCompleted ? 'bg-green-500/40' : 'bg-gray-100 dark:bg-gray-800'}"></div>` : ''}
                            
                            <!-- Timeline Indicator -->
                            <div class="relative z-10 flex-shrink-0 w-[26px] h-[26px] rounded-full flex items-center justify-center transition-all ${
                                isCurrent 
                                    ? 'bg-orange-600 text-white shadow-sm shadow-orange-500/20'
                                    : isCompleted 
                                        ? 'bg-green-100 dark:bg-green-900/30 text-green-600' 
                                        : 'bg-gray-50 dark:bg-gray-800 text-gray-400 group-hover:bg-gray-100 dark:group-hover:bg-gray-700'
                            }">
                                ${isCompleted 
                                    ? '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>'
                                    : `<span class="text-[9px] font-bold">${article.order || (index + 1)}</span>`
                                }
                            </div>
                            
                            <!-- Content -->
                            <div class="flex-1 min-w-0">
                                <h4 class="text-[11px] font-bold leading-tight transition-colors mb-1 ${
                                    isCurrent 
                                        ? 'text-orange-600 dark:text-orange-400'
                                        : 'text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white'
                                }">
                                    ${article.title}
                                </h4>
                                <div class="flex items-center gap-1.5 h-3">
                                    <span class="text-[9px] text-gray-400 uppercase tracking-tight">${article.reading_time || '5'} min read</span>
                                    ${isCurrent ? '<span class="flex h-1.5 w-1.5 relative"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-orange-500"></span></span>' : ''}
                                </div>
                            </div>
                        </a>
                    `;
                }).join('');
            } else if (articlesList) {
                articlesList.innerHTML = `
                    <div class="text-center py-8 text-gray-500 dark:text-gray-400 text-sm">
                        No articles found in this series.
                    </div>
                `;
            }

        } catch (error) {
            console.error('Failed to load series articles:', error);
            const articlesList = document.getElementById('series-articles-list');
            if (articlesList) {
                articlesList.innerHTML = `
                    <div class="text-center py-8">
                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Failed to load series articles</p>
                        <button 
                            onclick="loadSeriesArticles()" 
                            class="text-xs text-orange-600 dark:text-orange-400 hover:underline"
                        >
                            Try Again
                        </button>
                    </div>
                `;
            }
        }
    }

    // Load series articles on page load
    loadSeriesArticles();
    document.addEventListener("astro:after-swap", loadSeriesArticles);
</script>
</Layout>
