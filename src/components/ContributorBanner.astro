---

---

<div
    id="contributor-float"
    class="fixed right-6 z-[90] hidden -translate-y-10 items-center gap-3 rounded-xl border border-neutral-200 bg-stone-50/95 p-2 pr-3 opacity-0 shadow-xl shadow-black/10 backdrop-blur-xl transition-all duration-700 ease-out hover:border-orange-300 dark:border-neutral-800 dark:bg-neutral-950/95 dark:hover:border-orange-800 sm:flex"
    style="top: calc(var(--top-banner-height, 0px) + 5.5rem);"
>
    <!-- Badge -->
    <div class="relative flex h-10 w-10 shrink-0">
        <div
            class="relative inline-flex h-10 w-10 items-center justify-center rounded-lg border border-orange-200 bg-orange-50 text-orange-700 dark:border-orange-900/70 dark:bg-orange-950/40 dark:text-orange-300"
        >
            <span class="text-sm">👋</span>
        </div>
    </div>

    <!-- Content -->
    <div class="flex flex-col">
        <span
            class="text-xs font-bold leading-tight text-neutral-950 dark:text-white"
            >We are looking for!</span
        >
        <span class="text-[10px] text-neutral-500 dark:text-neutral-400"
            >contributors</span
        >
    </div>

    <!-- Divider -->
    <div class="mx-1 h-6 w-px bg-neutral-200 dark:bg-neutral-800"></div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
        <a
            href="/contact?subject=contribution-writing"
            class="flex items-center gap-1.5 rounded-lg bg-orange-50 px-3 py-1.5 text-xs font-semibold text-orange-700 transition-colors hover:bg-orange-100 dark:bg-orange-950/40 dark:text-orange-300 dark:hover:bg-orange-950/60"
            title="Write for us"
        >
            <span>✍️</span>
            <span>Writer</span>
        </a>
        <a
            href="/contact?subject=contribution-development"
            class="flex items-center gap-1.5 rounded-lg bg-neutral-100 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition-colors hover:bg-neutral-200 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
            title="Contribute Code"
        >
            <span>💻</span>
            <span>Dev</span>
        </a>
    </div>

    <!-- Close Button -->
    <button
        id="close-contributor-float"
        class="ml-1 rounded-lg p-1 text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-700 dark:hover:bg-neutral-900 dark:hover:text-neutral-200"
        aria-label="Close"
    >
        <svg
            class="w-3 h-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>
</div>

<script>
    const STORAGE_KEY = "contributor-banner-closed-v2";
    const banner = document.getElementById("contributor-float");
    const closeBtn = document.getElementById("close-contributor-float");

    function initBanner() {
        if (!banner) return;

        // Check storage
        if (sessionStorage.getItem(STORAGE_KEY) === "true") {
            banner.remove();
            return;
        }

        // Show after delay
        setTimeout(() => {
            banner.classList.remove("-translate-y-10", "opacity-0");
        }, 1500);

        // Close handler
        closeBtn?.addEventListener("click", () => {
            banner.classList.add("-translate-y-10", "opacity-0");
            setTimeout(() => banner.remove(), 500);
            sessionStorage.setItem(STORAGE_KEY, "true");
        });
    }

    // Initialize (handle Astro view transitions)
    document.addEventListener("DOMContentLoaded", initBanner);
    document.addEventListener("astro:page-load", initBanner);
</script>
