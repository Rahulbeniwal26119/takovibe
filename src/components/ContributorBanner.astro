---

---

<div
    id="contributor-float"
    class="fixed top-24 right-6 z-[90] -translate-y-10 opacity-0 transition-all duration-700 ease-out hidden sm:flex items-center gap-3 p-2 pr-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-purple-500/30 rounded-full shadow-2xl hover:scale-105"
>
    <!-- Badge -->
    <div class="relative flex h-10 w-10 shrink-0">
        <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"
        ></span>
        <div
            class="relative inline-flex items-center justify-center rounded-full h-10 w-10 bg-gradient-to-br from-purple-600 to-indigo-600 text-white shadow-lg"
        >
            <span class="text-sm">👋</span>
        </div>
    </div>

    <!-- Content -->
    <div class="flex flex-col">
        <span
            class="text-xs font-bold text-gray-900 dark:text-white leading-tight"
            >We are looking for!</span
        >
        <span class="text-[10px] text-gray-500 dark:text-gray-400"
            >contributors</span
        >
    </div>

    <!-- Divider -->
    <div class="h-6 w-px bg-gray-200 dark:bg-gray-700 mx-1"></div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
        <a
            href="/contact?subject=contribution-writing"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-purple-50 dark:bg-purple-900/20 text-purple-600 dark:text-purple-300 hover:bg-purple-100 dark:hover:bg-purple-900/40 text-xs font-semibold transition-colors"
            title="Write for us"
        >
            <span>✍️</span>
            <span>Writer</span>
        </a>
        <a
            href="/contact?subject=contribution-development"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/40 text-xs font-semibold transition-colors"
            title="Contribute Code"
        >
            <span>💻</span>
            <span>Dev</span>
        </a>
    </div>

    <!-- Close Button -->
    <button
        id="close-contributor-float"
        class="ml-2 p-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors"
        aria-label="Close"
    >
        <svg
            class="w-3 h-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>
</div>

<script>
    const STORAGE_KEY = "contributor-banner-closed-v2";
    const banner = document.getElementById("contributor-float");
    const closeBtn = document.getElementById("close-contributor-float");

    function initBanner() {
        if (!banner) return;

        // Check storage
        if (sessionStorage.getItem(STORAGE_KEY) === "true") {
            banner.remove();
            return;
        }

        // Show after delay
        setTimeout(() => {
            banner.classList.remove("-translate-y-10", "opacity-0");
        }, 1500);

        // Close handler
        closeBtn?.addEventListener("click", () => {
            banner.classList.add("-translate-y-10", "opacity-0");
            setTimeout(() => banner.remove(), 500);
            sessionStorage.setItem(STORAGE_KEY, "true");
        });
    }

    // Initialize (handle Astro view transitions)
    document.addEventListener("DOMContentLoaded", initBanner);
    document.addEventListener("astro:page-load", initBanner);
</script>
