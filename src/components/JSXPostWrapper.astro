---
// JSXPostWrapper.astro - Wrapper for JSX blog posts
import InteractiveJSXDemo from './blog-posts/InteractiveJSXDemo.jsx';

export interface Props {
  postData: {
    title: string;
    date: string;
    author: string;
    description: string;
    image: string;
    tags: string[];
    canonical?: string;
    type?: string;
    format: 'jsx';
    interactive?: boolean;
  };
  content: string;
  slug: string;
}

const { postData, content, slug } = Astro.props;

// Create a mapping of slug to component for proper imports
const componentMap: Record<string, any> = {
  'interactive-jsx-demo': InteractiveJSXDemo,
  // Add more mappings as you create more JSX posts
};

const JSXComponent = componentMap[slug];
---

<div class="jsx-post-content" data-post-slug={slug}>
  <div class="prose prose-lg dark:prose-invert max-w-none">
    {JSXComponent ? (
      <JSXComponent client:load />
    ) : (
      <div class="jsx-fallback bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-amber-800 dark:text-amber-200 mb-2">
          📝 JSX Blog Post
        </h3>
        <p class="text-amber-600 dark:text-amber-300 mb-4">
          This post uses JSX format but the interactive component couldn't be loaded.
        </p>
        <div class="space-y-3 text-gray-700 dark:text-gray-300">
          <p><strong>Title:</strong> {postData.title}</p>
          <p><strong>Author:</strong> {postData.author}</p>
          <p><strong>Date:</strong> {postData.date}</p>
          <p><strong>Tags:</strong> {postData.tags.join(', ')}</p>
          <p><strong>Slug:</strong> {slug}</p>
          <p><strong>Component:</strong> {JSXComponent ? 'Found' : 'Not found in mapping'}</p>
        </div>
        {!JSXComponent && (
          <div class="mt-4 p-3 bg-blue-50 dark:bg-blue-900/20 rounded">
            <p class="text-sm text-blue-600 dark:text-blue-300">
              <strong>Note:</strong> To enable full interactivity, add '{slug}' to the component mapping in JSXPostWrapper.astro
            </p>
          </div>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .jsx-post-content {
    line-height: 1.7;
  }
  
  .jsx-post-content :global(.interactive-component) {
    margin: 2rem 0;
    padding: 1rem;
    border-radius: 0.5rem;
  }
  
  .jsx-post-content :global(.jsx-blog-post) {
    max-width: none;
  }
  
  .jsx-post-content :global(.jsx-blog-post h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .jsx-post-content :global(.jsx-blog-post h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .jsx-post-content :global(.jsx-blog-post p) {
    margin-bottom: 1rem;
  }
  
  .jsx-post-content :global(.jsx-blog-post ul) {
    margin-bottom: 1rem;
  }
</style>
