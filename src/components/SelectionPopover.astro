---

---

<div
    id="selection-popover"
    class="fixed z-[9999] transition-all duration-300 ease-out transform -translate-x-1/2 scale-95 opacity-0 pointer-events-none"
    style="display: none;"
    role="tooltip"
>
    <!-- Menu Toolbar -->
    <div
        id="popover-menu"
        class="bg-white/90 dark:bg-neutral-900/90 backdrop-blur-xl border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-200 rounded-full shadow-2xl px-1.5 py-1.5 flex items-center gap-0.5"
    >
        <!-- Highlight Button -->
        <button
            id="btn-highlight"
            class="p-2 text-neutral-500 hover:bg-orange-50 hover:text-orange-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/40 dark:text-neutral-400 dark:hover:bg-orange-950/30 dark:hover:text-orange-400 rounded-full transition-all duration-200 group relative active:scale-90"
            aria-label="Highlight"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                ></path>
            </svg>
            <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-medium bg-neutral-900 text-white rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap shadow-xl"
                >Highlight</span
            >
        </button>

        <!-- Add Note Button -->
        <button
            id="btn-note"
            class="p-2 text-neutral-500 hover:bg-orange-50 hover:text-orange-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/40 dark:text-neutral-400 dark:hover:bg-orange-950/30 dark:hover:text-orange-400 rounded-full transition-all duration-200 group relative active:scale-90"
            aria-label="Add Note"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                ></path>
            </svg>
            <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-medium bg-neutral-900 text-white rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap shadow-xl"
                >Add Note</span
            >
        </button>

        <div class="w-px h-4 bg-neutral-200 dark:bg-neutral-700 mx-1"></div>

        <!-- Ask Kumi Button -->
        <button
            id="btn-ai-chat"
            class="p-2 text-neutral-500 hover:bg-orange-50 hover:text-orange-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/40 dark:text-neutral-400 dark:hover:bg-orange-950/30 dark:hover:text-orange-400 rounded-full transition-all duration-200 group relative active:scale-90"
            aria-label="Ask Kumi"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-medium bg-neutral-900 text-white rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap shadow-xl"
                >Ask Kumi</span
            >
        </button>

        <!-- Add to Sketch Button -->
        <button
            id="btn-add-to-sketch"
            class="p-2 text-neutral-500 hover:bg-orange-50 hover:text-orange-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/40 dark:text-neutral-400 dark:hover:bg-orange-950/30 dark:hover:text-orange-400 rounded-full transition-all duration-200 group relative active:scale-90"
            aria-label="Add to Sketch"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                ></path>
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 21l3-3"></path>
            </svg>
            <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-medium bg-neutral-900 text-white rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap shadow-xl"
                >Add to Sketch</span
            >
        </button>

        <!-- More Options (Copy/Share) -->
        <div class="relative group/more">
            <button
                class="p-2 text-neutral-500 hover:bg-neutral-100 hover:text-neutral-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/40 dark:text-neutral-400 dark:hover:bg-white/10 dark:hover:text-neutral-200 rounded-full transition-all duration-200 active:scale-90"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"
                    ></path>
                </svg>
            </button>
            <!-- Dropdown -->
            <div
                class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-32 bg-white dark:bg-neutral-900 rounded-xl shadow-xl border border-neutral-200 dark:border-neutral-800 opacity-0 invisible group-hover/more:opacity-100 group-hover/more:visible transition-all duration-200 overflow-hidden"
            >
                <button
                    id="btn-copy"
                    class="w-full px-4 py-2 text-left text-sm text-neutral-700 hover:bg-neutral-100 hover:text-orange-600 dark:text-neutral-200 dark:hover:bg-neutral-800 dark:hover:text-orange-400 flex items-center gap-2 transition-colors"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                        ></path></svg
                    >
                    Copy
                </button>
                <button
                    id="btn-share"
                    class="w-full px-4 py-2 text-left text-sm text-neutral-700 hover:bg-neutral-100 hover:text-orange-600 dark:text-neutral-200 dark:hover:bg-neutral-800 dark:hover:text-orange-400 flex items-center gap-2 transition-colors"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                        ></path></svg
                    >
                    Share
                </button>
            </div>
        </div>
    </div>

    <!-- Note Input (Hidden by default) -->
    <div
        id="popover-note-input"
        class="hidden bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl shadow-2xl p-3 w-72 flex flex-col gap-2"
    >
        <textarea
            id="note-textarea"
            class="w-full h-24 p-2 text-sm bg-neutral-50 dark:bg-neutral-950 rounded-lg border-0 focus:ring-2 focus:ring-orange-500 resize-none text-neutral-800 dark:text-neutral-200"
            placeholder="Add a note..."></textarea>
        <div class="flex justify-end gap-2">
            <button
                id="btn-cancel-note"
                class="px-3 py-1.5 text-xs font-medium text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
                >Cancel</button
            >
            <button
                id="btn-save-note"
                class="px-3 py-1.5 text-xs font-medium bg-orange-600 hover:bg-orange-500 text-white rounded-lg transition-colors"
                >Save Note</button
            >
        </div>
    </div>
</div>

<!-- Note Display Tooltip (For Hover) -->
<div
    id="note-display-tooltip"
    class="fixed z-[10000] max-w-xs w-72 p-3 bg-white dark:bg-neutral-900 rounded-xl shadow-2xl border border-neutral-200 dark:border-neutral-800 opacity-0 transition-opacity duration-200 translate-y-2 pointer-events-auto"
    style="display: none;"
>
    <!-- Header with Actions -->
    <div class="flex items-start justify-between gap-2 mb-1">
        <div
            class="flex items-center gap-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400"
        >
            <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                ></path></svg
            >
            <span>Note</span>
        </div>
        <div class="flex items-center gap-1">
            <button
                id="btn-edit-note-tooltip"
                class="p-1 text-neutral-400 hover:text-orange-600 dark:hover:text-orange-400 rounded transition-colors"
                title="Edit Note"
            >
                <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                    ></path></svg
                >
            </button>
            <button
                id="btn-delete-note-tooltip"
                class="p-1 text-neutral-400 hover:text-red-500 rounded transition-colors"
                title="Delete Note"
            >
                <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                    ></path></svg
                >
            </button>
        </div>
    </div>

    <!-- Content -->
    <p
        id="note-tooltip-content"
        class="text-sm text-neutral-700 dark:text-neutral-300 break-words leading-snug pl-5"
    >
    </p>

    <!-- Tiny arrow -->
    <div
        class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-white dark:bg-neutral-900 border-b border-r border-neutral-200 dark:border-neutral-800 transform rotate-45"
    >
    </div>
</div>

<style is:global>
    /* Inline subtle highlight style */
    .highlight-yellow {
        background-color: rgba(253, 224, 71, 0.4); /* yellow-300 with opacity */
        border-bottom: 2px solid rgba(234, 179, 8, 0.6); /* yellow-500 */
        cursor: pointer;
        transition: background-color 0.2s;
        border-radius: 2px;

        /* STRICT inheritance to preserve heading styles */
        font-family: inherit !important;
        font-size: inherit !important;
        font-weight: inherit !important;
        line-height: inherit !important;
        color: inherit !important;
        text-decoration: inherit !important;
        text-transform: inherit !important;
        letter-spacing: inherit !important;

        display: inline !important;
        margin: 0 !important;
        padding: 0 !important;
        float: none !important;
    }
    .dark .highlight-yellow {
        background-color: rgba(234, 179, 8, 0.3);
        border-bottom-color: rgba(250, 204, 21, 0.6);
    }
    .highlight-yellow:hover {
        background-color: rgba(253, 224, 71, 0.6);
    }
    .dark .highlight-yellow:hover {
        background-color: rgba(234, 179, 8, 0.5);
    }

    /* Note Highlight Style */
    .highlight-blue {
        background-color: rgba(96, 165, 250, 0.3); /* blue-400 with opacity */
        border-bottom: 2px dashed rgba(59, 130, 246, 0.6); /* blue-500 */
        cursor: pointer;
        border-radius: 2px;

        /* STRICT inheritance */
        font-family: inherit !important;
        font-size: inherit !important;
        font-weight: inherit !important;
        line-height: inherit !important;
        color: inherit !important;
        text-decoration: inherit !important;
        text-transform: inherit !important;
        letter-spacing: inherit !important;

        display: inline !important;
        margin: 0 !important;
        padding: 0 !important;
        float: none !important;
    }
    .dark .highlight-blue {
        background-color: rgba(59, 130, 246, 0.2);
        border-bottom-color: rgba(96, 165, 250, 0.6);
    }
</style>

<script>
    const popover = document.getElementById("selection-popover");
    const highlightBtn = document.getElementById("btn-highlight");
    const noteBtn = document.getElementById("btn-note");
    const copyBtn = document.getElementById("btn-copy");
    const shareBtn = document.getElementById("btn-share");
    const aiChatBtn = document.getElementById("btn-ai-chat");

    // Note Elements
    const popoverMenu = document.getElementById("popover-menu");
    const popoverNoteInput = document.getElementById("popover-note-input");
    const noteTextarea = document.getElementById("note-textarea");
    const saveNoteBtn = document.getElementById("btn-save-note");
    const cancelNoteBtn = document.getElementById("btn-cancel-note");

    // Note Tooltip Elements
    const noteTooltip = document.getElementById("note-display-tooltip");
    const noteTooltipContent = document.getElementById("note-tooltip-content");
    const btnEditNoteTooltip = document.getElementById("btn-edit-note-tooltip");
    const btnDeleteNoteTooltip = document.getElementById(
        "btn-delete-note-tooltip",
    );

    let currentSelection = "";
    let activeRange = null;
    let debounceTimer;
    let isEditingNote = false;
    let activeNoteElement = null;

    // --- ACTIONS ---

    function resetNoteUI() {
        isEditingNote = false;
        popoverMenu.classList.remove("hidden");
        popoverNoteInput.classList.add("hidden");
        if (noteTextarea) noteTextarea.value = "";
        activeRange = null;
        activeNoteElement = null;
    }

    // Hide popover helper with animation
    const hidePopover = () => {
        if (!popover || isEditingNote) return; // Don't hide if editing note
        popover.classList.add(
            "opacity-0",
            "scale-95",
            "pointer-events-none",
            "translate-y-2",
        );
        popover.classList.remove("opacity-100", "scale-100", "translate-y-0");
        setTimeout(() => {
            if (popover.classList.contains("opacity-0")) {
                popover.style.display = "none";
                resetNoteUI();
            }
        }, 300);
    };

    // Show popover helper with animation
    const showPopover = (rect) => {
        if (!popover) return;
        popover.style.display = "block";
        popover.style.left = `${rect.left + rect.width / 2}px`;
        popover.style.top = isEditingNote
            ? `${rect.bottom + 10}px`
            : `${rect.top - 50}px`;

        // Force reflow
        popover.offsetHeight;

        popover.classList.remove(
            "opacity-0",
            "scale-95",
            "pointer-events-none",
            "translate-y-2",
        );
        popover.classList.add("opacity-100", "scale-100", "translate-y-0");
    };

    document.addEventListener("selectionchange", () => {
        if (isEditingNote) return;

        // Clear existing timer
        clearTimeout(debounceTimer);

        const selection = window.getSelection();
        if (!selection || selection.isCollapsed) {
            hidePopover();
            return;
        }

        // Set new timer
        debounceTimer = setTimeout(() => {
            const range = selection.getRangeAt(0);

            // Ignore if inside contenteditable (prevents conflict with editors)
            const container = range.commonAncestorContainer;
            const element =
                container.nodeType === Node.TEXT_NODE
                    ? container.parentElement
                    : container;
            if (element.closest('[contenteditable="true"]')) return;

            const rect = range.getBoundingClientRect();
            const article = document.querySelector("article");

            if (article?.contains(container)) {
                currentSelection = selection.toString().trim();
                showPopover(rect);
            }
        }, 300); // 300ms delay for responsiveness
    });

    document.addEventListener(
        "scroll",
        () => {
            if (!isEditingNote) hidePopover();
            // hideNoteTooltip(); // Keep shown for interaction if mouse over
            // Actually, hide it unless mouse is over it to prevent stale tooltips
            if (!noteTooltip.matches(":hover")) {
                hideNoteTooltip();
            }
        },
        { passive: true },
    );

    // --- ACTIONS ---

    // Check if selection is already highlighted
    function isHighlighted(range) {
        const commonAncestor = range.commonAncestorContainer;
        if (
            commonAncestor.nodeType === Node.ELEMENT_NODE &&
            commonAncestor.classList.contains("highlight-yellow")
        ) {
            return true;
        }
        if (
            commonAncestor.parentNode &&
            commonAncestor.parentNode.nodeType === Node.ELEMENT_NODE &&
            commonAncestor.parentNode.classList.contains("highlight-yellow")
        ) {
            return true;
        }
        if (commonAncestor.nodeType === Node.ELEMENT_NODE) {
            return commonAncestor.querySelector(".highlight-yellow") !== null;
        }
        return false;
    }

    // Remove highlighting from the range or element
    function removeHighlight(target) {
        let spans = [];

        if (target instanceof Range) {
            const commonAncestor = target.commonAncestorContainer;
            if (
                commonAncestor.nodeType === Node.ELEMENT_NODE &&
                commonAncestor.classList.contains("highlight-yellow")
            ) {
                spans.push(commonAncestor);
            } else if (
                commonAncestor.parentNode &&
                commonAncestor.parentNode.classList?.contains(
                    "highlight-yellow",
                )
            ) {
                spans.push(commonAncestor.parentNode);
            } else {
                const allSpans = document.querySelectorAll(".highlight-yellow");
                allSpans.forEach((span) => {
                    if (target.intersectsNode(span)) {
                        spans.push(span);
                    }
                });
            }
        } else if (target instanceof HTMLElement) {
            spans.push(target);
        }

        spans.forEach((span) => {
            const parent = span.parentNode;
            while (span.firstChild) {
                parent.insertBefore(span.firstChild, span);
            }
            parent.removeChild(span);
            parent.normalize();
        });
    }

    // --- PERSISTENCE HELPERS ---

    const getArticleSlug = () => {
        const path = window.location.pathname;
        const match = path.match(/\/blog\/([^\/]+)/);
        return match ? match[1] : null;
    };

    // Generate a robust path to a node within the article
    function getDomPath(el) {
        if (!el || el.tagName === "ARTICLE") return "article";
        const parent = el.parentNode;
        const index = Array.from(parent.children).indexOf(el);
        // Compact path: Tag:Index
        return `${getDomPath(parent)}/${el.tagName}:${index}`;
    }

    // Serialize Range to JSON
    function serializeRange(range) {
        const startContainer = range.startContainer;
        const endContainer = range.endContainer;

        const startNode =
            startContainer.nodeType === Node.TEXT_NODE
                ? startContainer.parentNode
                : startContainer;
        const endNode =
            endContainer.nodeType === Node.TEXT_NODE
                ? endContainer.parentNode
                : endContainer;

        // Calculate text node index if multiple text nodes exist
        const getChildTextIndex = (parent, textNode) => {
            let index = 0;
            for (let i = 0; i < parent.childNodes.length; i++) {
                if (parent.childNodes[i] === textNode) return index;
                if (parent.childNodes[i].nodeType === Node.TEXT_NODE) index++;
            }
            return 0;
        };

        return {
            startPath: getDomPath(startNode),
            startTextIndex:
                startContainer.nodeType === Node.TEXT_NODE
                    ? getChildTextIndex(startNode, startContainer)
                    : 0,
            startOffset: range.startOffset,
            endPath: getDomPath(endNode),
            endTextIndex:
                endContainer.nodeType === Node.TEXT_NODE
                    ? getChildTextIndex(endNode, endContainer)
                    : 0,
            endOffset: range.endOffset,
            text: range.toString(),
        };
    }

    // Restore Range from JSON
    function deserializeRange(data) {
        try {
            const findNode = (path) => {
                const parts = path.split("/").slice(1); // Remove 'article'
                let el = document.querySelector("article");
                for (const part of parts) {
                    const [tag, indexStr] = part.split(":");
                    const index = parseInt(indexStr);
                    if (el && el.children[index]) {
                        el = el.children[index];
                    } else {
                        return null;
                    }
                }
                return el;
            };

            const getTextNode = (element, index) => {
                let current = 0;
                for (let i = 0; i < element.childNodes.length; i++) {
                    const node = element.childNodes[i];
                    if (node.nodeType === Node.TEXT_NODE) {
                        if (current === index) return node;
                        current++;
                    }
                }
                return element.firstChild || element; // Fallback
            };

            const startNode = findNode(data.startPath);
            const endNode = findNode(data.endPath);

            if (!startNode || !endNode) return null;

            const startTextNode = getTextNode(startNode, data.startTextIndex);
            const endTextNode = getTextNode(endNode, data.endTextIndex);

            const range = document.createRange();
            range.setStart(startTextNode, data.startOffset);
            range.setEnd(endTextNode, data.endOffset);
            return range;
        } catch (e) {
            console.error("Failed to deserialize range", e);
            return null;
        }
    }

    // --- DATA SAVING (localStorage Fallback) ---
    // const apiUrl = import.meta.env.PUBLIC_API_URL; // Disabled until APIs are ready

    function getLocalHighlights(slug) {
        try {
            const data = localStorage.getItem(`highlights_${slug}`);
            return data ? JSON.parse(data) : [];
        } catch (e) {
            console.error("Failed to parse local highlights", e);
            return [];
        }
    }

    function saveLocalHighlights(slug, items) {
        try {
            localStorage.setItem(`highlights_${slug}`, JSON.stringify(items));
        } catch (e) {
            console.error("Failed to save local highlights", e);
        }
    }

    async function saveHighlightToBackend(
        range,
        type = "highlight",
        note = "",
        color = "yellow",
    ) {
        const slug = getArticleSlug();
        // const token = localStorage.getItem("access_token");
        // Allow strictly local saving even without token for now, or enforce token if desired.
        // But user asked to save to local storage.
        if (!slug) return null;

        const serialized = serializeRange(range);
        const id = Date.now().toString(); // Simple ID generation

        const newItem = {
            id: id,
            article_slug: slug,
            type: type,
            range_data: JSON.stringify(serialized),
            text: serialized.text,
            note: note,
            color: color,
            created_at: new Date().toISOString(),
        };

        const items = getLocalHighlights(slug);
        items.push(newItem);
        saveLocalHighlights(slug, items);

        return { id: id };
    }

    async function deleteHighlightFromBackend(id) {
        const slug = getArticleSlug();
        if (!slug || !id) return;

        let items = getLocalHighlights(slug);
        items = items.filter((item) => item.id !== id);
        saveLocalHighlights(slug, items);
    }

    async function fetchHighlights() {
        const slug = getArticleSlug();
        if (!slug) return;

        // Guard against double-application (e.g. both DOMContentLoaded and
        // astro:page-load firing on the same DOM) — the flag lives on the
        // article element, which is replaced on client-side navigation.
        const article = document.querySelector("article");
        if (!article || article.dataset.highlightsRestored === "true") return;
        article.dataset.highlightsRestored = "true";

        // Fetch from Local Storage instead of API
        const data = getLocalHighlights(slug);

        data.forEach((item) => {
            try {
                const range = deserializeRange(JSON.parse(item.range_data));
                if (range) {
                    const className =
                        item.type === "note"
                            ? "highlight-blue"
                            : "highlight-yellow";
                    highlightRange(range, className, item.note, item.id);
                }
            } catch (e) {
                console.warn("Failed to restore highlight", item, e);
            }
        });
    }

    // Initialize on load. Astro <script> modules are deferred and often run
    // AFTER DOMContentLoaded has already fired, so call directly when the DOM
    // is ready, and also re-run on View Transition navigations.
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", fetchHighlights);
    } else {
        fetchHighlights();
    }
    document.addEventListener("astro:page-load", fetchHighlights);

    // NOTE: Updated highlightRange signature to accept ID
    function highlightRange(
        range,
        className = "highlight-yellow",
        noteContent = null,
        dbId = null, // Database ID
    ) {
        const startNode = range.startContainer;
        const endNode = range.endContainer;
        const startOffset = range.startOffset;
        const endOffset = range.endOffset;

        function wrapTextNode(node, start, end) {
            const span = document.createElement("span");
            span.className = className;
            if (noteContent) span.setAttribute("data-note", noteContent);
            if (dbId) span.setAttribute("data-id", dbId); // Store ID

            const middle = node.splitText(start);
            middle.splitText(end - start);
            const clone = middle.cloneNode(true);
            span.appendChild(clone);
            middle.parentNode.replaceChild(span, middle);
        }

        if (startNode === endNode && startNode.nodeType === Node.TEXT_NODE) {
            wrapTextNode(startNode, startOffset, endOffset);
            return;
        }

        const commonAncestor = range.commonAncestorContainer;
        const walker = document.createTreeWalker(
            commonAncestor,
            NodeFilter.SHOW_TEXT,
            {
                acceptNode: (node) => {
                    if (!range.intersectsNode(node))
                        return NodeFilter.FILTER_REJECT;
                    return NodeFilter.FILTER_ACCEPT;
                },
            },
        );

        const nodesToWrap = [];
        let currentNode = walker.nextNode();
        while (currentNode) {
            nodesToWrap.push(currentNode);
            currentNode = walker.nextNode();
        }

        nodesToWrap.forEach((node) => {
            let start = 0;
            let end = node.length;
            if (node === startNode) start = startOffset;
            if (node === endNode) end = endOffset;
            if (start < end) wrapTextNode(node, start, end);
        });
    }

    // Updated toggleHighlight to handle persistence
    async function toggleHighlight(range) {
        if (isHighlighted(range)) {
            // Find ID to delete
            let id = null;
            const commonAncestor = range.commonAncestorContainer;
            // Try to find an existing highlight element to get ID
            const parent =
                commonAncestor.nodeType === Node.ELEMENT_NODE
                    ? commonAncestor
                    : commonAncestor.parentNode;

            // Simple check: look for highlight class in parent or children
            const existing =
                parent.closest(".highlight-yellow") ||
                parent.querySelector(".highlight-yellow");
            if (existing && existing.hasAttribute("data-id")) {
                id = existing.getAttribute("data-id");
            }

            removeHighlight(range);
            if (id) await deleteHighlightFromBackend(id);
        } else {
            // Save first, then highlight with ID
            const saved = await saveHighlightToBackend(range, "highlight");
            const id = saved ? saved.id : null;
            highlightRange(range, "highlight-yellow", null, id);
        }
    }

    // Highlight Action
    highlightBtn?.addEventListener("click", () => {
        // Auth check removed/simplified for local testing as per request
        // const token = localStorage.getItem("access_token");
        // if (!token) { ... }

        const selection = window.getSelection();
        if (!selection || selection.isCollapsed) return;
        const range = selection.getRangeAt(0);

        try {
            toggleHighlight(range);
            selection.removeAllRanges();
            hidePopover();
            console.log("Highlight toggled");
        } catch (e) {
            console.warn("Highlight failed:", e);
        }
    });

    // Note Action
    noteBtn?.addEventListener("click", () => {
        // Auth check removed/simplified

        // Prepare UI
        const selection = window.getSelection();
        if (!selection || selection.isCollapsed) return;

        activeRange = selection.getRangeAt(0).cloneRange();
        isEditingNote = true;

        popoverMenu.classList.add("hidden");
        popoverNoteInput.classList.remove("hidden");
        noteTextarea?.focus();
    });

    // Updated Note Actions
    saveNoteBtn?.addEventListener("click", async () => {
        const noteContent = noteTextarea?.value.trim();
        if (!noteContent && !activeNoteElement) return;

        if (activeNoteElement) {
            // Update existing note
            activeNoteElement.setAttribute("data-note", noteContent);
            // TODO: Add Update API call here if needed
            // For now, assume notes are immutable or update via same ID?
            // Ideally: PUT /api/highlights/:id/
            const id = activeNoteElement.getAttribute("data-id");
            if (id) {
                // Minimally implemented update via new save? Or proper PUT.
                // Let's defer full update logic, just UI update for now.
            }
            alert("Note updated!");
        } else if (activeRange) {
            // Create new note
            try {
                const saved = await saveHighlightToBackend(
                    activeRange,
                    "note",
                    noteContent,
                    "blue",
                );
                const id = saved ? saved.id : Date.now(); // Fallback ID
                highlightRange(activeRange, "highlight-blue", noteContent, id);
                // alert("Note saved!");
            } catch (e) {
                console.warn("Failed to save note selection", e);
            }
        }

        resetNoteUI();
        window.getSelection()?.removeAllRanges();
        hidePopover();
    });

    // Updated Delete Note
    btnDeleteNoteTooltip?.addEventListener("click", async () => {
        if (activeNoteElement) {
            if (confirm("Delete this note?")) {
                const id = activeNoteElement.getAttribute("data-id");
                removeHighlight(activeNoteElement);
                if (id) await deleteHighlightFromBackend(id);

                // Hide wrapper manually
                noteTooltip.style.display = "none";
                activeNoteElement = null;
            }
        }
    });

    cancelNoteBtn?.addEventListener("click", () => {
        resetNoteUI();
        hidePopover();
    });

    // Tooltip Logic
    function showNoteTooltip(element, content) {
        if (!noteTooltip || !noteTooltipContent) return;

        activeNoteElement = element;
        noteTooltipContent.textContent = content;
        noteTooltip.style.display = "block";

        const rect = element.getBoundingClientRect();

        // Position above the element, centered
        const left = rect.left + rect.width / 2 - noteTooltip.offsetWidth / 2;
        const top = rect.top - noteTooltip.offsetHeight - 10;

        noteTooltip.style.left = `${Math.max(10, left)}px`;
        noteTooltip.style.top = `${top}px`;

        // Animate in
        requestAnimationFrame(() => {
            noteTooltip.classList.remove("opacity-0", "translate-y-2");
        });
    }

    function hideNoteTooltip() {
        if (!noteTooltip) return;
        // Don't hide if hovering the tooltip itself (allows clicking buttons)
        if (noteTooltip.matches(":hover")) return;

        noteTooltip.classList.add("opacity-0", "translate-y-2");
        setTimeout(() => {
            if (
                noteTooltip.classList.contains("opacity-0") &&
                !noteTooltip.matches(":hover")
            ) {
                noteTooltip.style.display = "none";
                activeNoteElement = null;
            }
        }, 200);
    }

    // Note Tooltip Actions

    btnEditNoteTooltip?.addEventListener("click", () => {
        if (activeNoteElement) {
            const currentNote = activeNoteElement.getAttribute("data-note");

            // Hide tooltip
            noteTooltip.style.display = "none";

            // Show Edit UI (reuse Popover UI)
            isEditingNote = true;
            noteTextarea.value = currentNote;

            const rect = activeNoteElement.getBoundingClientRect();
            // Show popover near it
            showPopover(rect);

            popoverMenu.classList.add("hidden");
            popoverNoteInput.classList.remove("hidden");
            noteTextarea?.focus();
        }
    });

    // Event Delegation for Tooltip Hover - on wrapper
    noteTooltip.addEventListener("mouseleave", hideNoteTooltip);

    document.addEventListener("mouseover", (e) => {
        const target = e.target;
        if (
            target.classList.contains("highlight-blue") &&
            target.hasAttribute("data-note")
        ) {
            const content = target.getAttribute("data-note");
            showNoteTooltip(target, content);
        }
    });

    document.addEventListener("mouseout", (e) => {
        const target = e.target;
        if (target.classList.contains("highlight-blue")) {
            setTimeout(() => {
                if (!noteTooltip.matches(":hover")) {
                    hideNoteTooltip();
                }
            }, 100);
        }
    });

    // Copy Action
    copyBtn?.addEventListener("click", async () => {
        if (currentSelection) {
            try {
                await navigator.clipboard.writeText(currentSelection);
                hidePopover();
            } catch (err) {
                console.error("Failed to copy:", err);
            }
        }
    });

    // Share Action
    shareBtn?.addEventListener("click", () => {
        if (currentSelection) {
            const text = encodeURIComponent(`"${currentSelection}"`);
            const url = encodeURIComponent(window.location.href);
            window.open(
                `https://twitter.com/intent/tweet?text=${text}&url=${url}`,
                "_blank",
            );
            hidePopover();
        }
    });

    aiChatBtn?.addEventListener("click", () => {
        const token = localStorage.getItem("access_token");
        if (!token) {
            const event = new CustomEvent("show-login-prompt", {
                detail: {
                    feature: "AI Explanation",
                    next: window.location.pathname + window.location.search,
                },
            });
            window.dispatchEvent(event);
            hidePopover();
            return;
        }

        if (currentSelection) {
            const event = new CustomEvent("trigger-ai-chat", {
                detail: {
                    text: currentSelection,
                    mode: "explain",
                },
            });
            window.dispatchEvent(event);
            hidePopover();
            window.getSelection()?.removeAllRanges();
        }
    });

    const addToSketchBtn = document.getElementById("btn-add-to-sketch");
    addToSketchBtn?.addEventListener("click", () => {
        const token = localStorage.getItem("access_token");
        if (!token) {
            const event = new CustomEvent("show-login-prompt", {
                detail: {
                    feature: "Sketch Note",
                    next: window.location.pathname + window.location.search,
                },
            });
            window.dispatchEvent(event);
            hidePopover();
            return;
        }

        if (currentSelection) {
            const event = new CustomEvent("request-add-to-sketch", {
                detail: {
                    text: currentSelection,
                },
            });
            window.dispatchEvent(event);
            hidePopover();
            window.getSelection()?.removeAllRanges();
        }
    });

</script>
