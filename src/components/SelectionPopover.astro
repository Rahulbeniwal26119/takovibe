---

---

<div
    id="selection-popover"
    class="fixed z-[9999] transition-all duration-300 ease-out transform -translate-x-1/2 scale-95 opacity-0 pointer-events-none"
    style="display: none;"
    role="tooltip"
>
    <div
        class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-200 rounded-full shadow-2xl px-2 py-1.5 flex items-center gap-1"
    >
        <button
            id="btn-copy"
            class="p-2 hover:bg-gray-100 dark:hover:bg-white/10 rounded-full transition-all duration-200 group relative active:scale-90"
            aria-label="Copy text"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path>
            </svg>
            <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-medium bg-gray-900 text-white rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap shadow-xl"
                >Copy</span
            >
        </button>

        <div class="w-px h-4 bg-gray-200 dark:bg-white/10 mx-1"></div>

        <button
            id="btn-ai-chat"
            class="p-2 hover:bg-purple-100 dark:hover:bg-purple-500/20 text-purple-600 dark:text-purple-400 rounded-full transition-all duration-200 group relative active:scale-90"
            aria-label="Ask AI"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-medium bg-gray-900 text-white rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap shadow-xl"
                >Ask Kumi</span
            >
        </button>

        <div class="w-px h-4 bg-gray-200 dark:bg-white/10 mx-1"></div>

        <button
            id="btn-share"
            class="p-2 hover:bg-gray-100 dark:hover:bg-white/10 rounded-full transition-all duration-200 group relative active:scale-90"
            aria-label="Share on Twitter"
        >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
            </svg>
            <span
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-medium bg-gray-900 text-white rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap shadow-xl"
                >Share</span
            >
        </button>
    </div>
</div>

<script>
    const popover = document.getElementById("selection-popover");
    const copyBtn = document.getElementById("btn-copy");
    const shareBtn = document.getElementById("btn-share");
    const aiChatBtn = document.getElementById("btn-ai-chat");
    let currentSelection = "";
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;

    // Hide popover helper with animation
    const hidePopover = () => {
        if (!popover) return;
        popover.classList.add(
            "opacity-0",
            "scale-95",
            "pointer-events-none",
            "translate-y-2",
        );
        popover.classList.remove("opacity-100", "scale-100", "translate-y-0");
        setTimeout(() => {
            if (popover.classList.contains("opacity-0")) {
                popover.style.display = "none";
            }
        }, 300);
    };

    // Show popover helper with animation
    const showPopover = (rect) => {
        if (!popover) return;
        popover.style.display = "block";
        popover.style.left = `${rect.left + rect.width / 2}px`;
        // Position slightly above selection
        popover.style.top = `${rect.top + window.scrollY - 45}px`;

        // Force reflow
        popover.offsetHeight;

        popover.classList.remove(
            "opacity-0",
            "scale-95",
            "pointer-events-none",
            "translate-y-2",
        );
        popover.classList.add("opacity-100", "scale-100", "translate-y-0");
    };

    aiChatBtn?.addEventListener("click", () => {
        if (currentSelection) {
            const event = new CustomEvent("trigger-ai-chat", {
                detail: { text: currentSelection },
            });
            window.dispatchEvent(event);
            hidePopover();
            window.getSelection()?.removeAllRanges();
        }
    });

    function updatePopoverPosition() {
        const selection = window.getSelection();

        if (
            !selection ||
            selection.isCollapsed ||
            !selection.toString().trim()
        ) {
            hidePopover();
            return;
        }

        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();

        // Only show if selection is within the article
        const article = document.querySelector("article");

        if (!article?.contains(range.commonAncestorContainer)) {
            hidePopover();
            return;
        }

        // Just update state, let the debounce timer handle showing it
        currentSelection = selection.toString().trim();
    }

    document.addEventListener("selectionchange", () => {
        // Clear existing timer
        clearTimeout(debounceTimer);

        // Hide immediately on change to prevent jumping
        hidePopover();

        // Set new timer for 1 second delay
        debounceTimer = setTimeout(() => {
            const selection = window.getSelection();
            if (
                selection &&
                !selection.isCollapsed &&
                selection.toString().trim()
            ) {
                const range = selection.getRangeAt(0);
                const rect = range.getBoundingClientRect();
                const article = document.querySelector("article");

                if (article?.contains(range.commonAncestorContainer)) {
                    currentSelection = selection.toString().trim();
                    showPopover(rect);
                }
            }
        }, 500); // 500ms delay
    });

    document.addEventListener(
        "scroll",
        () => {
            hidePopover();
        },
        { passive: true },
    );

    copyBtn?.addEventListener("click", async () => {
        if (currentSelection) {
            try {
                await navigator.clipboard.writeText(currentSelection);

                // Visual feedback
                const icon = copyBtn.querySelector("svg");
                const originalPath = icon?.innerHTML;
                if (icon) {
                    icon.innerHTML =
                        '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>';
                    setTimeout(() => {
                        icon.innerHTML = originalPath || "";
                    }, 1500);
                }
            } catch (err) {
                console.error("Failed to copy:", err);
            }
        }
    });

    shareBtn?.addEventListener("click", () => {
        if (currentSelection) {
            const text = encodeURIComponent(`"${currentSelection}"`);
            const url = encodeURIComponent(window.location.href);
            window.open(
                `https://twitter.com/intent/tweet?text=${text}&url=${url}`,
                "_blank",
            );
        }
    });

    aiChatBtn?.addEventListener("click", () => {
        if (currentSelection) {
            const event = new CustomEvent("trigger-ai-chat", {
                detail: {
                    text: currentSelection,
                    mode: "explain", // Treat selection explanation same as code explanation
                },
            });
            window.dispatchEvent(event);
            hidePopover();

            // Unselect text for better UX
            window.getSelection()?.removeAllRanges();
        }
    });
</script>
