---
interface Props {
  variant?: "header" | "blog" | "mobile" | "modal" | "full-header";
}

const { variant = "header" } = Astro.props;

// Make searchArticles available to client-side script
const searchEndpoint = import.meta.env.PUBLIC_API_URL + "/api/blogs/blogs/";
---

<div class="pace-y-1">
  <!-- Pro tip (only show for header variant) -->

  <!-- Search Input -->
  <div class="search-container relative">
    <div class="relative">
      <div
        class={`absolute inset-y-0 left-3 flex items-center pointer-events-none ${variant === "modal" ? "pl-2" : ""}`}
      >
        {
          variant === "modal" ? (
            <svg
              class="w-6 h-6 text-purple-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          ) : (
            <svg
              class={`w-4 h-4 ${variant === "full-header" ? "text-purple-500 w-5 h-5" : "text-gray-400 dark:text-gray-500"}`}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          )
        }
      </div>
      <input
        type="text"
        id={`${variant}-search-input`}
        placeholder={variant === "blog"
          ? "Press Ctrl + / anytime to search blogs"
          : variant === "modal"
            ? "What are you looking for?"
            : "Press Ctrl + / to search blogs"}
        class={`w-full rounded-lg transition-all ${
          variant === "header"
            ? "pl-9 pr-4 py-2 bg-gray-100 dark:bg-slate-900 border border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:bg-white dark:focus:bg-slate-950 focus:border-purple-500 dark:focus:border-purple-500"
            : variant === "modal"
              ? "pl-14 pr-4 py-4 bg-transparent border-none outline-none ring-0 focus:ring-0 shadow-none text-xl text-gray-900 dark:text-white placeholder-gray-400 font-medium"
              : variant === "full-header"
                ? "pl-12 pr-4 py-3 bg-transparent border-none outline-none ring-0 focus:ring-0 shadow-none text-lg text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 font-medium w-full"
                : variant === "blog"
                  ? "pl-9 pr-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 hover:border-purple-500/50 focus:border-purple-500"
                  : "pl-9 pr-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 hover:border-purple-500/50 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20"
        }`}
        data-variant={variant}
      />
    </div>
  </div>
</div>

<script>
  interface Author {
    name: string;
    username: string;
  }

  interface SearchResult {
    title: string;
    description: string;
    uri: string;
    slug: string;
    tags: string[];
    image_url: string | null;
    created_at: string;
    author: Author;
  }

  const searchEndpoint =
    (import.meta.env.PUBLIC_API_URL || "https://backend.takovibe.com") +
    "/api/blogs/blogs/";

  async function searchArticles(query: string): Promise<SearchResult[]> {
    if (!query.trim()) return [];

    try {
      const response = await fetch(
        `${searchEndpoint}?q=${encodeURIComponent(query)}`,
      );

      if (!response.ok) {
        throw new Error(`Search request failed: ${response.statusText}`);
      }

      const data = await response.json();

      // Handle different response formats
      if (Array.isArray(data)) {
        return data; // Direct array response
      } else if (data.results && Array.isArray(data.results)) {
        return data.results; // Paginated response
      } else {
        console.warn("Unexpected API response format:", data);
        return [];
      }
    } catch (error) {
      console.error("Search error:", error);
      throw error;
    }
  }

  let searchTimeout: number | null = null;
  let searchResultsContainer: HTMLElement | null = null;

  function createSearchResults(variant: string) {
    // For modal, try to find the external results container first
    if (variant === "modal") {
      const modalResults = document.getElementById("modal-search-results");
      if (modalResults) {
        searchResultsContainer = modalResults;
        return;
      }
    }

    // Get the specific search container for this variant
    const searchContainer = document
      .querySelector(`#${variant}-search-input`)
      ?.closest(".search-container");
    if (!searchContainer) {
      console.error(`Search container not found for variant: ${variant}`);
      return;
    }

    // Check if results container already exists for this variant
    let existingContainer = searchContainer.querySelector(
      ".search-results-container",
    );
    if (existingContainer) {
      searchResultsContainer = existingContainer as HTMLElement;
      return;
    }

    // Create search results container
    searchResultsContainer = document.createElement("div");
    // Default classes, specific styling handled in showSearchResults
    searchResultsContainer.className =
      "search-results-container absolute left-0 right-0 top-full mt-1 rounded-lg shadow-lg max-h-[80vh] overflow-y-auto z-50 hidden";
    searchContainer.appendChild(searchResultsContainer);
  }

  function showSearchResults(results: any[], variant: string) {
    let currentSearchResultsContainer: HTMLElement | null = null;

    if (variant === "modal") {
      currentSearchResultsContainer = document.getElementById(
        "modal-search-results",
      );
    } else {
      // Ensure we have the right search results container for this variant
      const searchContainer = document
        .querySelector(`#${variant}-search-input`)
        ?.closest(".search-container");
      currentSearchResultsContainer = searchContainer?.querySelector(
        ".search-results-container",
      ) as HTMLElement;
    }

    if (!currentSearchResultsContainer) {
      console.error(
        `Search results container not found for variant: ${variant}`,
      );
      return;
    }

    // Style based on variant but respect dark mode
    const bgClass = "bg-white dark:bg-slate-900";
    const borderClass = "border-gray-200 dark:border-gray-700";

    if (variant === "modal") {
      currentSearchResultsContainer.className = `search-results-container w-full mt-4 static bg-transparent max-h-[60vh] overflow-y-auto z-50`;
    } else {
      currentSearchResultsContainer.className = `search-results-container absolute left-0 right-0 top-full mt-1 ${bgClass} border ${borderClass} rounded-lg shadow-lg max-h-[80vh] overflow-y-auto z-50`;
    }

    // Get current search query for "Search All" option
    const searchInput = document.querySelector(
      `#${variant}-search-input`,
    ) as HTMLInputElement;
    const currentQuery = searchInput?.value?.trim() || "";

    if (results.length === 0) {
      currentSearchResultsContainer.innerHTML = `
        <div class="p-4 text-center text-gray-500 dark:text-gray-400">
          No results found
          ${
            currentQuery
              ? `
            <div class="mt-2">
              <a href="/blog?q=${encodeURIComponent(currentQuery)}" 
                 class="inline-flex items-center gap-2 px-3 py-1.5 text-sm bg-purple-500 hover:bg-purple-600 text-white rounded-lg transition-colors">
                <span class="w-3.5 h-3.5 text-white">🔍</span>
                Search all posts for "${currentQuery}"
              </a>
            </div>
          `
              : ""
          }
        </div>
      `;
    } else {
      const textClass = "text-gray-900 dark:text-white";
      const mutedTextClass = "text-gray-600 dark:text-gray-400";
      const hoverClass = "hover:bg-gray-50 dark:hover:bg-gray-800";
      const borderBottomClass = "border-gray-100 dark:border-gray-800";

      // Add "Search All" option at the top
      let searchAllOption = "";
      if (currentQuery) {
        searchAllOption = `
          <a href="/blog?q=${encodeURIComponent(currentQuery)}" 
             class="block p-4 ${hoverClass} border-b ${borderBottomClass} bg-purple-50 dark:bg-purple-900/10 hover:bg-purple-100 dark:hover:bg-purple-900/20 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-purple-500/20 flex items-center justify-center">
                 <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div class="flex-1">
              <h3 class="${textClass} font-medium">Search all posts for "${currentQuery}"</h3>
                <p class="text-sm ${mutedTextClass}">View all ${results.length}+ results on blog page</p>
              </div>
              <div class="text-xs ${mutedTextClass}">
                Press Enter ↵
              </div>
            </div>
          </a>
        `;
      }

      currentSearchResultsContainer.innerHTML =
        searchAllOption +
        results
          .slice(0, 5)
          .map(
            (result) => `
        <a href="${result.uri}" class="block p-4 ${hoverClass} border-b ${borderBottomClass} last:border-0">
          <div class="flex items-center gap-4 mb-2">
            <div class="flex-1">
              <div class="flex gap-2 mb-1">
                ${result.tags
                  .slice(0, 2)
                  .map(
                    (tag) => `
                  <span class="text-xs px-2 py-0.5 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded">${tag.replace(/"/g, "")}</span>
                `,
                  )
                  .join("")}
              </div>
              <h3 class="${textClass} font-medium mb-1">${result.title}</h3>
              <p class="text-sm ${mutedTextClass} line-clamp-2">${result.description}</p>
            </div>
            </div>
            ${
              result.image_url
                ? `
              <div class="w-16 h-16 flex-shrink-0 hidden md:block">
                <img src="${result.image_url}" alt="${result.title}" class="w-full h-full object-cover rounded-lg"/>
              </div>
            `
                : `
              <div class="w-16 h-16 flex-shrink-0 hidden md:block rounded-lg bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
                 <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              </div>
                `
            }
          </div>
          <div class="flex items-center gap-3 text-xs ${mutedTextClass}">
            <span>${new Date(result.created_at).toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })}</span>
            <span>by ${result.author.name || result.author.username || "Author"}</span>
          </div>
        </a>
      `,
          )
          .join("");
    }

    currentSearchResultsContainer.classList.remove("hidden");
  }

  function hideSearchResults() {
    // Hide all search results containers
    document
      .querySelectorAll(".search-results-container")
      .forEach((container) => {
        container.classList.add("hidden");
      });
  }

  async function handleSearch(query: string, variant: string) {
    if (!query.trim()) {
      hideSearchResults();
      return;
    }

    try {
      const results = await searchArticles(query);
      showSearchResults(results, variant);
    } catch (error) {
      console.error("Search failed:", error);
    }
  }

  function initSearch() {
    const headerSearchInput = document.getElementById(
      "header-search-input",
    ) as HTMLInputElement | null;
    const blogSearchInput = document.getElementById(
      "blog-search-input",
    ) as HTMLInputElement | null;
    const mobileSearchInput = document.getElementById(
      "mobile-search-input",
    ) as HTMLInputElement | null;
    const modalSearchInput = document.getElementById(
      "modal-search-input",
    ) as HTMLInputElement | null;

    const fullHeaderSearchInput = document.getElementById(
      "full-header-search-input",
    ) as HTMLInputElement | null;

    if (
      !headerSearchInput &&
      !blogSearchInput &&
      !mobileSearchInput &&
      !modalSearchInput &&
      !fullHeaderSearchInput
    )
      return;

    const setupSearchInput = (
      searchInput: HTMLInputElement,
      variant: string,
    ) => {
      // Create search results container for this variant
      createSearchResults(variant);

      // Handle input with debounce
      searchInput.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value;

        if (searchTimeout) {
          clearTimeout(searchTimeout);
        }

        searchTimeout = setTimeout(() => {
          handleSearch(query, variant);
        }, 300) as unknown as number;
      });

      // Handle keyboard navigation
      searchInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          searchInput.blur();
          hideSearchResults();
        } else if (e.key === "Enter") {
          const query = searchInput.value.trim();
          if (query) {
            // Navigate to blog page with search query
            window.location.href = `/blog?q=${encodeURIComponent(query)}`;
          }
        }
      });
    };

    // Set up all search inputs
    if (headerSearchInput) {
      setupSearchInput(headerSearchInput, "header");
      // Only add '/' shortcut for header search
      document.addEventListener("keydown", (e) => {
        if (
          (e.metaKey || e.ctrlKey) &&
          e.key === "/" &&
          document.activeElement !== headerSearchInput &&
          !document.activeElement?.closest(".blog-search")
        ) {
          e.preventDefault();
          headerSearchInput.focus();
        }
      });
    }

    if (blogSearchInput) {
      setupSearchInput(blogSearchInput, "blog");
      blogSearchInput.classList.add("blog-search");
    }

    if (mobileSearchInput) {
      setupSearchInput(mobileSearchInput, "mobile");
    }

    if (modalSearchInput) {
      setupSearchInput(modalSearchInput, "modal");
    }

    if (fullHeaderSearchInput) {
      setupSearchInput(fullHeaderSearchInput, "full-header");
      // Add keyboard shortcut support for this main search too
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "/") {
          e.preventDefault();
          // The openSearch function in Header.astro handles visibility/focus,
          // but we ensure consistent behavior here if needed.
          // Actually, Header.astro handles the keydown to OPEN it.
          // Once open, this input has focus.
        }
      });
    }

    // Close search results when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest(".search-container")) {
        hideSearchResults();
      }
    });
  }

  // Initialize search functionality
  document.addEventListener("DOMContentLoaded", initSearch);
</script>

<style>
  .search-wrapper {
    perspective: 1000px;
  }

  #search-input::placeholder {
    transition: color 0.2s ease;
  }

  #search-input:focus::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Custom styles for blog search */
  .blog-search input {
    @apply bg-white dark:bg-gray-800 text-gray-900 dark:text-white;
  }

  .blog-search .search-results {
    @apply bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700;
  }

  /* Custom styles for header search */
  .header-search input {
    @apply bg-gray-100 dark:bg-slate-900 text-gray-900 dark:text-white;
  }

  .header-search .search-results {
    @apply bg-white dark:bg-slate-900 border-gray-200 dark:border-gray-700;
  }

  /* Custom autofill styles */
  .header-search input:-webkit-autofill,
  .header-search input:-webkit-autofill:hover,
  .header-search input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--tw-text-opacity);
    -webkit-box-shadow: 0 0 0px 1000px var(--tw-bg-opacity) inset;
    transition: background-color 5000s ease-in-out 0s;
  }

  .blog-search input:-webkit-autofill,
  .blog-search input:-webkit-autofill:hover,
  .blog-search input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--tw-text-opacity);
    -webkit-box-shadow: 0 0 0px 1000px var(--tw-bg-opacity) inset;
    transition: background-color 5000s ease-in-out 0s;
  }
</style>
