---
import { searchArticles, type SearchResult } from '../utils/search';

interface Props {
  variant?: 'header' | 'blog';
}

const { variant = 'header' } = Astro.props;

// Make searchArticles available to client-side script
const searchEndpoint = 'https://backend.takovibe.com/api/blogs/blogs/';
---

<div class="space-y-1">
  <!-- Pro tip -->
  <div class="px-1 text-xs text-white/60 flex items-center gap-1">
    <span class="inline-flex items-center">
      <span class="w-4 h-4 mr-0.5 inline-flex items-center justify-center">💡</span>
      Pro tip:
    </span>
    Press
    <span class="font-mono">/</span>
    anytime to open search quickly
  </div>

  <!-- Search Input -->
  <div class="search-container relative">
    <div class="relative">
      <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
        <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id={variant === 'blog' ? 'blog-search-input' : 'header-search-input'}
        placeholder={variant === 'blog' ? 'Search blog articles...' : 'Search posts, topics, or keywords...'}
        class={`w-full pl-9 pr-4 py-2 rounded-lg border transition-all ${
          variant === 'blog' 
            ? 'bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 hover:border-purple-500/50 focus:border-purple-500' 
            : 'bg-[#171923] hover:bg-[#1A202C] focus:bg-[#1A202C] text-white/90 placeholder-white/40 border-purple-500/30 focus:border-purple-500/50'
        }`}
        data-variant={variant}
      />
    </div>
  </div>
</div>

<script>
  interface Author {
    name: string;
    username: string;
  }

  interface SearchResult {
    title: string;
    description: string;
    uri: string;
    tags: string[];
    image_url: string | null;
    created_at: string;
    author: Author;
  }

  const searchEndpoint = 'https://backend.takovibe.com/api/blogs/blogs/';

  async function searchArticles(query: string): Promise<SearchResult[]> {
    if (!query.trim()) return [];
    
    try {
      const response = await fetch(`${searchEndpoint}?search=${encodeURIComponent(query)}`);
      
      if (!response.ok) {
        throw new Error(`Search request failed: ${response.statusText}`);
      }
      
      const data = await response.json();
      return data.results || [];
    } catch (error) {
      console.error('Search error:', error);
      throw error;
    }
  }

  let searchTimeout: number | null = null;
  let searchResultsContainer: HTMLElement | null = null;
  
  function createSearchResults() {
    // Create search results container if it doesn't exist
    if (!searchResultsContainer) {
      searchResultsContainer = document.createElement('div');
      searchResultsContainer.className = 'absolute left-0 right-0 top-full mt-1 bg-[#1A202C] border border-purple-500/30 rounded-lg shadow-lg max-h-[80vh] overflow-y-auto z-50 hidden';
      document.querySelector('.search-container')?.appendChild(searchResultsContainer);
    }
  }

  function showSearchResults(results: any[]) {
    if (!searchResultsContainer) return;

    if (results.length === 0) {
      searchResultsContainer.innerHTML = `
        <div class="p-4 text-center text-white/60">
          No results found
        </div>
      `;
    } else {
      searchResultsContainer.innerHTML = results.map(result => `
        <a href="${result.uri}" class="block p-4 hover:bg-white/5 border-b border-purple-500/10 last:border-0">
          <div class="flex items-center gap-4 mb-2">
            <div class="flex-1">
              <div class="flex gap-2 mb-1">
                ${result.tags.slice(0, 2).map(tag => `
                  <span class="text-xs px-2 py-0.5 bg-purple-500/10 text-purple-300 rounded">${tag.replace(/"/g, '')}</span>
                `).join('')}
              </div>
              <h3 class="text-white font-medium mb-1">${result.title}</h3>
              <p class="text-sm text-white/60 line-clamp-2">${result.description}</p>
            </div>
            ${result.image_url ? `
              <div class="w-16 h-16 flex-shrink-0">
                <img src="${result.image_url}" alt="${result.title}" class="w-full h-full object-cover rounded-lg"/>
              </div>
            ` : ''}
          </div>
          <div class="flex items-center gap-3 text-xs text-white/40">
            <span>${new Date(result.created_at).toLocaleDateString('en-US', { 
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })}</span>
            <span>by ${result.author.name || result.author.username}</span>
          </div>
        </a>
      `).join('');
    }

    searchResultsContainer.classList.remove('hidden');
  }

  function hideSearchResults() {
    searchResultsContainer?.classList.add('hidden');
  }

  async function handleSearch(query: string) {
    if (!query.trim()) {
      hideSearchResults();
      return;
    }

    try {
      const results = await searchArticles(query);
      showSearchResults(results);
    } catch (error) {
      console.error('Search failed:', error);
    }
  }

  function initSearch() {
    const headerSearchInput = document.getElementById('header-search-input') as HTMLInputElement | null;
    const blogSearchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    
    if (!headerSearchInput && !blogSearchInput) return;

    createSearchResults();
    
    const setupSearchInput = (searchInput: HTMLInputElement) => {
      // Handle input with debounce
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value;
        
        if (searchTimeout) {
          clearTimeout(searchTimeout);
        }

        searchTimeout = setTimeout(() => {
          handleSearch(query);
        }, 300) as unknown as number;
      });

      // Close search on Escape key press
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          searchInput.blur();
          hideSearchResults();
        }
      });
    };

    // Set up header search
    if (headerSearchInput) {
      setupSearchInput(headerSearchInput);
      // Only add '/' shortcut for header search
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== headerSearchInput && !document.activeElement?.closest('.blog-search')) {
          e.preventDefault();
          headerSearchInput.focus();
        }
      });
    }

    // Set up blog search
    if (blogSearchInput) {
      setupSearchInput(blogSearchInput);
      // Blog search specific handling if needed
      blogSearchInput.classList.add('blog-search');
    }

    // Close search results when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.search-container')) {
        hideSearchResults();
      }
    });
  }

  // Initialize search functionality
  document.addEventListener('DOMContentLoaded', initSearch);
</script>

<style>
  .search-wrapper {
    perspective: 1000px;
  }

  #search-input::placeholder {
    transition: color 0.2s ease;
  }

  #search-input:focus::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Custom styles for blog search */
  .blog-search input {
    @apply bg-white dark:bg-gray-800 text-gray-900 dark:text-white;
  }

  .blog-search .search-results {
    @apply bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700;
  }

  /* Custom styles for header search */
  .header-search input {
    @apply bg-[#171923] text-white/90;
  }

  .header-search .search-results {
    @apply bg-[#1A202C] border-purple-500/30;
  }

  /* Custom autofill styles */
  .header-search input:-webkit-autofill,
  .header-search input:-webkit-autofill:hover,
  .header-search input:-webkit-autofill:focus {
    -webkit-text-fill-color: white;
    -webkit-box-shadow: 0 0 0px 1000px rgba(255, 255, 255, 0.05) inset;
    transition: background-color 5000s ease-in-out 0s;
  }

  .blog-search input:-webkit-autofill,
  .blog-search input:-webkit-autofill:hover,
  .blog-search input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--tw-text-opacity);
    -webkit-box-shadow: 0 0 0px 1000px var(--tw-bg-opacity) inset;
    transition: background-color 5000s ease-in-out 0s;
  }
</style>