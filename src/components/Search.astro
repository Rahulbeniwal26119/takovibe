---
const hostUrl = import.meta.env.PUBLIC_API_URL;
const siteUrl = import.meta.env.SITE_URL;
---

<script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Mobile Search Button -->
<button
  id="simple-search-btn"
  data-search-trigger
  class="relative p-2 text-slate-400 hover:text-blue-400 transition-colors duration-200 rounded-lg hover:bg-slate-800/50 focus:outline-none focus:ring-2 focus:ring-blue-400/20"
  type="button"
  aria-label="Open search"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
</button>

<!-- Styled Search Modal -->
<div
  id="simple-search-modal"
  class="search-modal"
  style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); z-index: 9999; animation: fadeIn 0.2s ease-out;"
>
  <div
    id="search-container"
    style="position: absolute; top: 8%; left: 50%; transform: translateX(-50%); width: 90%; max-width: 700px; background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(51, 65, 85, 0.95)); border-radius: 16px; padding: 0; box-shadow: 0 25px 80px rgba(0,0,0,0.4); border: 1px solid rgba(148, 163, 184, 0.2); overflow: hidden;"
  >
    <!-- Header Section -->
    <div
      style="padding: 24px 24px 0 24px; border-bottom: 1px solid rgba(148, 163, 184, 0.1);"
    >
      <!-- Quick Tip -->
      <div
        class="search-pro-tip"
        style="margin-bottom: 16px; padding: 8px 12px; background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.2); border-radius: 8px; display: flex; items-center; gap: 8px;"
      >
        <div style="color: #a78bfa; font-size: 14px;">💡</div>
        <span style="color: #c4b5fd; font-size: 13px;">
          <strong>Pro tip:</strong> Press <kbd
            style="background: rgba(30, 41, 59, 0.8); color: #a78bfa; padding: 2px 6px; border-radius: 3px; font-size: 11px; border: 1px solid rgba(139, 92, 246, 0.3);"
            >/</kbd
          > anytime to open search quickly
        </span>
      </div>

      <!-- Search Input with Icon -->
      <div style="position: relative; margin-bottom: 20px;">
        <div
          style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8; z-index: 1;"
        >
          <svg
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          id="simple-search-input"
          type="text"
          placeholder="Search posts, topics, or keywords..."
          style="width: 100%; padding: 16px 20px 16px 50px; font-size: 16px; background: rgba(30, 41, 59, 0.6); border: 2px solid rgba(148, 163, 184, 0.2); border-radius: 12px; outline: none; color: #f1f5f9; placeholder-color: #94a3b8; transition: all 0.3s ease; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;"
        />
        <div
          style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #64748b; font-size: 12px; display: flex; align-items: center; gap: 8px;"
        >
          <kbd
            style="background: rgba(30, 41, 59, 0.8); color: #94a3b8; padding: 4px 8px; border-radius: 4px; font-size: 11px; border: 1px solid rgba(148, 163, 184, 0.2);"
            >ESC</kbd
          >
          <span style="color: #64748b;">to close</span>
        </div>
      </div>
    </div>

    <!-- Results Container -->
    <div
      id="simple-search-results"
      style="max-height: 420px; overflow-y: auto; padding: 20px 24px 24px 24px;"
    >
      <div
        style="text-align: center; color: #94a3b8; padding: 60px 20px; display: flex; flex-direction: column; align-items: center; gap: 12px;"
      >
        <svg
          width="48"
          height="48"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          style="opacity: 0.5;"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <p style="margin: 0; font-size: 16px; font-weight: 500;">
          Start typing to search
        </p>
        <p style="margin: 0; font-size: 14px; opacity: 0.7;">
          Find posts, topics, and more
        </p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ hostUrl, siteUrl }}>
  $(document).ready(function () {
    // Function to close the search modal with debugging
    function closeSearchModal(reason) {
      if ($("#simple-search-modal").is(":visible")) {
        console.log(`Closing search modal: ${reason}`);
        $("#simple-search-modal").hide();
        return true;
      } else {
        console.log(
          `Modal close attempt ignored - modal not visible: ${reason}`,
        );
        return false;
      }
    }

    // Open modal on button click
    $("#simple-search-btn")
      .off("click.search")
      .on("click.search", function (e) {
        e.preventDefault();
        e.stopPropagation();
        console.log("Search button clicked - opening modal");
        $("#simple-search-modal").show();
        $("#simple-search-input").focus();
      });

    // Close on escape and open on forward slash
    $(document)
      .off("keydown.search")
      .on("keydown.search", function (e) {
        // Close modal on Escape key - always work regardless of focus
        if (e.key === "Escape" || e.keyCode === 27) {
          closeSearchModal("ESC key pressed");
          e.preventDefault();
          return false;
        }

        // Don't trigger / shortcut if user is typing in an input, textarea, or contenteditable element
        if ($(e.target).is("input, textarea, [contenteditable]")) {
          return;
        }

        // Open search with forward slash
        if (e.key === "/" && !e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          console.log("Opening search with / key");
          $("#simple-search-modal").show();
          $("#simple-search-input").focus();
        }
      });

    // Handle ESC key when modal is open (additional handler for reliability)
    $("#simple-search-input")
      .off("keydown.search")
      .on("keydown.search", function (e) {
        if (e.key === "Escape" || e.keyCode === 27) {
          closeSearchModal("ESC key in search input");
          e.preventDefault();
          return false;
        }
      });

    // Close on backdrop click - Clean and reliable handling
    $("#simple-search-modal")
      .off("click.search")
      .on("click.search", function (e) {
        console.log(
          "Modal clicked, target:",
          e.target,
          "currentTarget:",
          e.currentTarget,
        );

        // Close if clicked directly on modal backdrop
        if (e.target === e.currentTarget) {
          closeSearchModal("clicked on modal backdrop");
        }
      });

    // Prevent clicks inside the search container from bubbling up
    $("#search-container")
      .off("click.search")
      .on("click.search", function (e) {
        console.log("Search container clicked - preventing modal close");
        e.stopPropagation();
      });

    // Global click handler to close modal when clicking outside
    $(document)
      .off("click.search")
      .on("click.search", function (e) {
        if ($("#simple-search-modal").is(":visible")) {
          const $target = $(e.target);

          // Check if click is outside both the search container and the search button
          if (
            !$target.closest("#search-container").length &&
            !$target.closest("#simple-search-btn").length &&
            !$target.closest("[data-search-trigger]").length
          ) {
            closeSearchModal("clicked outside search elements");
          }
        }
      });

    // Search functionality
    let searchTimeout;
    $("#simple-search-input").on("input", function () {
      const query = $(this).val().trim();

      clearTimeout(searchTimeout);

      if (!query) {
        $("#simple-search-results").html(`
        <div style="text-align: center; color: #94a3b8; padding: 60px 20px; display: flex; flex-direction: column; align-items: center; gap: 12px;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity: 0.5;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <p style="margin: 0; font-size: 16px; font-weight: 500;">Start typing to search</p>
          <p style="margin: 0; font-size: 14px; opacity: 0.7;">Find posts, topics, and more</p>
          <div style="margin-top: 8px; padding: 6px 12px; background: rgba(139, 92, 246, 0.1); border-radius: 6px; border: 1px solid rgba(139, 92, 246, 0.2);">
            <span style="color: #a78bfa; font-size: 12px;">💡 Tip: Press <kbd style="background: rgba(30, 41, 59, 0.8); color: #a78bfa; padding: 2px 5px; border-radius: 3px; font-size: 10px; margin: 0 2px; border: 1px solid rgba(139, 92, 246, 0.3);">/</kbd> anytime to open search</span>
          </div>
        </div>
      `);
        return;
      }

      // Show loading with better styling
      $("#simple-search-results").html(`
      <div style="text-align: center; color: #94a3b8; padding: 60px 20px; display: flex; flex-direction: column; align-items: center; gap: 16px;">
        <div style="width: 40px; height: 40px; border: 3px solid rgba(148, 163, 184, 0.2); border-top: 3px solid #8b5cf6; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        <p style="margin: 0; font-size: 16px; font-weight: 500;">Searching...</p>
        <p style="margin: 0; font-size: 14px; opacity: 0.7;">Looking for "${query}"</p>
      </div>
    `);

      searchTimeout = setTimeout(async () => {
        try {
          console.log("Fetching posts...");
          const response = await fetch(`${hostUrl}/api/blogs/blogs/`);
          const data = await response.json();

          console.log("API Response:", data);

          // Extract posts array from different response structures
          let posts = [];
          if (Array.isArray(data)) {
            posts = data;
          } else if (data.results) {
            posts = data.results;
          } else if (data.data) {
            posts = data.data;
          }

          console.log("Posts found:", posts.length);

          // Filter posts
          const filtered = posts.filter((post) => {
            const title = (post.title || "").toLowerCase();
            const description = (post.description || "").toLowerCase();
            const content = (post.content || "").toLowerCase();
            const searchTerm = query.toLowerCase();

            return (
              title.includes(searchTerm) ||
              description.includes(searchTerm) ||
              content.includes(searchTerm)
            );
          });

          console.log("Filtered posts:", filtered.length);

          // Display results
          if (filtered.length === 0) {
            $("#simple-search-results").html(`
            <div style="text-align: center; color: #94a3b8; padding: 60px 20px; display: flex; flex-direction: column; align-items: center; gap: 16px;">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity: 0.5;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <p style="margin: 0 0 8px 0; font-size: 16px; font-weight: 500;">No results found</p>
                <p style="margin: 0; font-size: 14px; opacity: 0.7;">Try searching with different keywords</p>
              </div>
              <div style="background: rgba(139, 92, 246, 0.1); color: #a78bfa; padding: 8px 16px; border-radius: 20px; font-size: 13px; border: 1px solid rgba(139, 92, 246, 0.2);">
                "${query}"
              </div>
            </div>
          `);
          } else {
            console.log(filtered);
            const resultsHtml =
              `
            <div style="margin-bottom: 16px; padding: 0 4px;">
              <p style="margin: 0; color: #94a3b8; font-size: 14px; font-weight: 500;">
                Found ${filtered.length} result${filtered.length === 1 ? "" : "s"} for "${query}"
              </p>
            </div>
          ` +
              filtered
                .map((post) => {
                  console.log(post.uri);
                  const url = `${siteUrl}/blog/${post.slug}`;
                  const title = post.title || "Untitled";
                  const description =
                    post.description ||
                    post.content ||
                    "No description available";

                  return `
              <div style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(148, 163, 184, 0.15); border-radius: 12px; padding: 20px; margin-bottom: 12px; transition: all 0.3s ease; cursor: pointer; backdrop-filter: blur(10px);" 
                   onmouseover="this.style.background='rgba(30, 41, 59, 0.6)'; this.style.borderColor='rgba(139, 92, 246, 0.4)'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 32px rgba(0,0,0,0.3)';" 
                   onmouseout="this.style.background='rgba(30, 41, 59, 0.4)'; this.style.borderColor='rgba(148, 163, 184, 0.15)'; this.style.transform='translateY(0px)'; this.style.boxShadow='none';">
                <a href="${url}" style="text-decoration: none; color: inherit; display: block;" onclick="$('#simple-search-modal').hide();">
                  <div style="display: flex; align-items: flex-start; gap: 16px;">
                    <div style="flex: 1;">
                      <h3 style="margin: 0 0 8px 0; color: #f1f5f9; font-size: 18px; font-weight: 600; line-height: 1.4; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                        ${title}
                      </h3>
                      <p style="margin: 0 0 12px 0; color: #cbd5e1; font-size: 14px; line-height: 1.5; opacity: 0.9;">
                        ${description.substring(0, 150)}${description.length > 150 ? "..." : ""}
                      </p>
                      <div style="display: flex; align-items: center; gap: 8px; margin-top: 12px;">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #8b5cf6;">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span style="color: #8b5cf6; font-size: 12px; font-weight: 500;">Read article</span>
                      </div>
                    </div>
                    <div style="color: #64748b; font-size: 20px; opacity: 0.5; transition: all 0.2s ease;">→</div>
                  </div>
                </a>
              </div>
            `;
                })
                .join("");

            $("#simple-search-results").html(resultsHtml);
          }
        } catch (error) {
          console.error("Search error:", error);
          $("#simple-search-results").html(`
          <div style="text-align: center; color: #f87171; padding: 60px 20px; display: flex; flex-direction: column; align-items: center; gap: 16px;">
            <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity: 0.8;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 19c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
            <div>
              <p style="margin: 0 0 8px 0; font-size: 16px; font-weight: 500;">Search unavailable</p>
              <p style="margin: 0; font-size: 14px; opacity: 0.8;">Please try again later</p>
            </div>
            <div style="background: rgba(248, 113, 113, 0.1); color: #fca5a5; padding: 8px 16px; border-radius: 8px; font-size: 12px; border: 1px solid rgba(248, 113, 113, 0.2); font-family: monospace;">
              ${error.message}
            </div>
          </div>
        `);
        }
      }, 300);
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .search-modal {
    animation: fadeIn 0.2s ease-out;
  }

  #search-container {
    animation: fadeIn 0.3s ease-out;
  }

  #simple-search-input:focus {
    border-color: #8b5cf6 !important;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1) !important;
  }

  #simple-search-results::-webkit-scrollbar {
    width: 8px;
  }

  #simple-search-results::-webkit-scrollbar-track {
    background: rgba(30, 41, 59, 0.3);
    border-radius: 4px;
  }

  #simple-search-results::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 4px;
  }

  #simple-search-results::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.5);
  }

  /* Mobile responsiveness */
  @media (max-width: 640px) {
    #search-container {
      top: 5% !important;
      width: 95% !important;
      max-height: 85vh;
    }

    .search-pro-tip {
      display: none; /* Hide the pro tip on mobile to save space */
    }
  }

  /* Improved hover effects for search button */
  .search-trigger:hover kbd {
    background-color: #6366f1 !important;
    color: white !important;
    border-color: #6366f1 !important;
  }
</style>
