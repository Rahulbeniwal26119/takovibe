---
const hostUrl = import.meta.env.PUBLIC_API_URL;
---

<script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<div class="search-container">
  <div class="search-wrapper">
    <svg
      class="search-icon"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <input
      type="text"
      id="search"
      placeholder="Search posts..."
      class="search-input"
      autocomplete="off"
    />
  </div>
  <div id="search-results" class="search-results"></div>
</div>

<script define:vars={{ hostUrl }}>
  if (!window.searchInitialized) {
    window.searchInitialized = true;
    $(document).ready(function () {
      const $searchInput = $("#search");
      const $searchResults = $("#search-results");
      let timeoutId;

      $searchInput.on("input", function () {
        const searchTerm = $(this).val();
        clearTimeout(timeoutId);

        if (!searchTerm.trim()) {
          $searchResults.hide().empty();
          return;
        }

        timeoutId = setTimeout(async () => {
          try {
            const response = await fetch(`${hostUrl}/api/blogs/blogs/`);
            const data = await response.json();
            const posts = Array.isArray(data) ? data : data.data || [];

            const filteredPosts = posts.filter((post) =>
              post.title.toLowerCase().includes(searchTerm.toLowerCase())
            );

            if (filteredPosts.length) {
              const resultsHtml = filteredPosts
                .map(
                  (post) => `
                  <div class="search-result-item">
                    <a href="${post.uri}" style="
                      text-decoration: none;
                      display: block;
                    ">
                      <h3 style="
                        color: #e2e8f0;
                        font-size: 0.95rem;
                        font-weight: 500;
                        margin-bottom: 0.25rem;
                      ">${highlightMatch(post.title, searchTerm)}</h3>
                      <p style="
                        color: #94a3b8;
                        font-size: 0.875rem;
                      ">${truncateText(post.description, 100)}</p>
                    </a>
                  </div>
              `
                )
                .join("");

              $searchResults
                .html(resultsHtml)
                .css({
                  position: "absolute",
                  top: "100%",
                  left: 0,
                  right: 0,
                  marginTop: "0.5rem",
                  maxHeight: "400px",
                  overflowY: "auto",
                  background: "rgba(15, 23, 42, 0.95)",
                  backdropFilter: "blur(8px)",
                  borderRadius: "8px",
                  zIndex: 1000,
                  padding: "0.5rem"
                })
                .slideDown(200);

            } else {
              $searchResults
                .html('<p class="no-results">No posts found</p>')
                .css({
                  position: 'absolute',
                  top: '100%',
                  left: 0,
                  background: 'transparent',
                  padding: '0.5rem',
                  width: 'auto',
                  textAlign: 'left',
                  color: '#94a3b8',
                  fontSize: '0.875rem'
                })
                .slideDown(200);
            }
          } catch (error) {
            console.error('Error fetching posts:', error);
            $searchResults
              .html('<p class="no-results">Error fetching results</p>')
              .slideDown(200);
          }
        }, 300);
      });

      // Helper functions
      function highlightMatch(text, term) {
        const regex = new RegExp(`(${term})`, "gi");
        return text.replace(regex, '<mark style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, rgba(59, 130, 246, 0.2) 100%); color: #ffffff; padding: 0 0.2em; border-radius: 2px; font-weight: 500;">$1</mark>');
      }

      function truncateText(text, length) {
        return text.length > length ? text.substring(0, length) + "..." : text;
      }

      // Hide results when clicking outside
      $(document).on("click", function (event) {
        if (!$(event.target).closest(".search-container").length) {
          $searchResults.slideUp(200);
        }
      });
    });
  }
</script>

<style>
  .search-container {
    position: relative;
    display: inline-block;
  }

  .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 8px;
    width: 16px;
    height: 16px;
    color: #94a3b8;
    pointer-events: none;
  }

  .search-input {
    background: rgba(30, 41, 59, 0.5);
    border: none;
    border-radius: 6px;
    color: #e2e8f0;
    font-size: 0.875rem;
    padding: 0.5rem 0.75rem 0.5rem 2rem;
    width: 200px;
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    background: rgba(30, 41, 59, 0.7);
    width: 300px;
  }

  .no-results {
    color: #94a3b8;
    font-size: 0.875rem;
    padding: 0.5rem;
    margin: 0;
    white-space: nowrap;
  }

  .search-results {
    width: auto;
    margin: 0;
  }
</style>
