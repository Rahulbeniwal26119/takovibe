---

---

<section
    class="py-24 sm:py-32 relative overflow-hidden bg-white dark:bg-[#0B1120]"
>
    <!-- Background Gradients -->
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
        <div
            class="absolute top-[10%] -left-[10%] w-[700px] h-[700px] bg-pink-200/30 dark:bg-pink-900/10 blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
        >
        </div>
        <div
            class="absolute bottom-[10%] -right-[10%] w-[600px] h-[600px] bg-purple-200/30 dark:bg-purple-900/10 blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-20">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-50 dark:bg-pink-900/20 text-pink-600 dark:text-pink-300 text-sm font-bold mb-6 border border-pink-100 dark:border-pink-800"
            >
                <span class="animate-pulse">🎨</span>
                <span>Visual Thinking</span>
            </div>

            <h2
                class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6 leading-tight"
            >
                Think in <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-pink-600 via-purple-500 to-indigo-400"
                    >Diagrams.</span
                >
            </h2>

            <p
                class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed"
            >
                Connect your thoughts with Sketch Notes. Draw architecture,
                flowcharts, and mental models directly alongside your articles.
            </p>
        </div>

        <!-- The Sketch Notes Demo UI -->
        <div class="relative max-w-5xl mx-auto px-2 sm:px-0">
            <!-- Decorator Blur -->
            <div
                class="absolute -inset-4 bg-gradient-to-tr from-pink-500/20 to-purple-500/20 rounded-[2.5rem] blur-2xl opacity-50"
            >
            </div>

            <!-- Window Frame -->
            <div
                class="relative bg-white dark:bg-[#0D1117] rounded-2xl sm:rounded-3xl shadow-2xl overflow-hidden border border-gray-200 dark:border-gray-800 flex flex-col min-h-[450px] sm:min-h-[600px] group transition-all duration-700 hover:shadow-pink-500/10"
            >
                <!-- Header -->
                <div
                    class="px-4 sm:px-6 py-3 sm:py-4 bg-gray-50 dark:bg-[#161B22] border-b border-gray-200 dark:border-gray-800 flex items-center justify-between shrink-0"
                >
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="flex items-center gap-1.5">
                            <div
                                class="w-2.5 h-2.5 sm:w-3 h-3 rounded-full bg-red-400"
                            >
                            </div>
                            <div
                                class="w-2.5 h-2.5 sm:w-3 h-3 rounded-full bg-yellow-400"
                            >
                            </div>
                            <div
                                class="w-2.5 h-2.5 sm:w-3 h-3 rounded-full bg-green-400"
                            >
                            </div>
                        </div>
                        <div
                            class="h-4 w-px bg-gray-300 dark:bg-gray-700 mx-1 sm:mx-2"
                        >
                        </div>
                        <div class="flex items-center gap-2">
                            <span
                                class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white truncate max-w-[150px] sm:max-w-none"
                                >Kafka Architecture</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Canvas Area -->
                <div
                    class="flex-1 relative bg-[#121212] overflow-hidden min-h-[400px] sm:min-h-[600px]"
                >
                    <!-- The Provided Image - Cropped to hide internal UI -->
                    <div
                        class="absolute inset-0 scale-[1.15] origin-top -translate-y-[8%]"
                    >
                        <img
                            src="https://ik.imagekit.io/bhu1voux5/image.png"
                            alt="Kafka Diagram Sketch"
                            class="w-full h-full object-contain"
                        />
                    </div>

                    <!-- Grid Overlay -->
                    <div
                        class="absolute inset-0 bg-[url('/grid.svg')] opacity-10 pointer-events-none"
                    >
                    </div>
                </div>
            </div>

            <!-- Contextual Note - Fixed 3-column level alignment -->
            <div
                class="mt-12 sm:mt-20 grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-12 group max-w-6xl mx-auto px-6"
            >
                <!-- Card 1 -->
                <div
                    class="flex flex-col items-center text-center gap-4 animate-fade-in-up"
                >
                    <div
                        class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-pink-100 dark:bg-pink-900/20 text-pink-600 flex items-center justify-center shadow-lg shadow-pink-500/5 shrink-0"
                    >
                        <svg
                            class="w-6 h-6 sm:w-7 sm:h-7"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <h4
                            class="font-bold text-lg text-gray-900 dark:text-white mb-2 leading-tight"
                        >
                            Standalone Notes
                        </h4>
                        <p
                            class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-[280px]"
                        >
                            Create infinite canvases for brainstorming, system
                            design, and architecture from scratch.
                        </p>
                    </div>
                </div>

                <!-- Card 2 -->
                <div
                    class="flex flex-col items-center text-center gap-4 animate-fade-in-up animation-delay-200"
                >
                    <div
                        class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-purple-100 dark:bg-purple-900/20 text-purple-600 flex items-center justify-center shadow-lg shadow-purple-500/5 shrink-0"
                    >
                        <svg
                            class="w-6 h-6 sm:w-7 sm:h-7"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <h4
                            class="font-bold text-lg text-gray-900 dark:text-white mb-2 leading-tight"
                        >
                            Article Notes
                        </h4>
                        <p
                            class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-[280px]"
                        >
                            Attached contextually to your articles. Perfect for
                            flowcharts that explain technical concepts.
                        </p>
                    </div>
                </div>

                <!-- Card 3 -->
                <div
                    class="flex flex-col items-center text-center gap-4 animate-fade-in-up animation-delay-400"
                >
                    <div
                        class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-blue-100 dark:bg-blue-900/20 text-blue-600 flex items-center justify-center shadow-lg shadow-blue-500/5 shrink-0"
                    >
                        <svg
                            class="w-6 h-6 sm:w-7 sm:h-7"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <h4
                            class="font-bold text-lg text-gray-900 dark:text-white mb-2 leading-tight"
                        >
                            Smart Selection
                        </h4>
                        <p
                            class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-[280px]"
                        >
                            Instantly transform text snippets or code blocks
                            into visual nodes on your canvas.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
