---

---

<section
    class="py-24 sm:py-32 relative overflow-hidden bg-stone-50 dark:bg-neutral-950"
>
    <!-- Background Gradients -->
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
        <div
            class="absolute top-[10%] -left-[10%] w-[700px] h-[700px] bg-orange-200/30 dark:bg-orange-900/10 blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
        >
        </div>
        <div
            class="absolute bottom-[10%] -right-[10%] w-[600px] h-[600px] bg-amber-200/30 dark:bg-amber-900/10 blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-20">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 dark:bg-orange-900/20 text-orange-600 dark:text-orange-300 text-sm font-bold mb-6 border border-orange-100 dark:border-orange-800"
            >
                <span class="animate-pulse">🎨</span>
                <span>Visual Thinking</span>
            </div>

            <h2
                class="text-4xl md:text-5xl lg:text-6xl font-bold text-neutral-900 dark:text-neutral-50 mb-6 leading-tight"
            >
                Master your <span
                    class="text-brand-600 dark:text-brand-400"
                    >LLD Interviews.</span
                >
            </h2>

            <p
                class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto leading-relaxed"
            >
                Stop switching windows. Focus on design and code seamlessly in a
                single unified workspace. The ultimate canvas for building,
                testing, and perfecting Low-Level Designs.
            </p>
        </div>

        <!-- The Sketch Notes Demo UI -->
        <div class="relative max-w-6xl mx-auto px-2 sm:px-0">
            <!-- Decorator Blur -->
            <div
                class="absolute -inset-4 bg-gradient-to-tr from-orange-500/20 to-amber-500/20 rounded-[2.5rem] blur-2xl opacity-50"
            >
            </div>

            <!-- Window Frame -->
            <div
                class="relative bg-white dark:bg-neutral-900 rounded-2xl sm:rounded-3xl shadow-2xl overflow-hidden border border-neutral-200 dark:border-neutral-700 flex flex-col min-h-[500px] sm:min-h-[650px] group transition-all duration-700 hover:shadow-orange-500/10"
            >
                <!-- Header -->
                <div
                    class="px-4 sm:px-6 py-3 sm:py-4 bg-neutral-50 dark:bg-neutral-800 border-b border-neutral-200 dark:border-neutral-700 flex items-center justify-between shrink-0"
                >
                    <div class="flex items-center gap-3 sm:gap-4">
                        <div class="flex items-center gap-1.5">
                            <div
                                class="w-2.5 h-2.5 sm:w-3 h-3 rounded-full bg-red-400"
                            >
                            </div>
                            <div
                                class="w-2.5 h-2.5 sm:w-3 h-3 rounded-full bg-yellow-400"
                            >
                            </div>
                            <div
                                class="w-2.5 h-2.5 sm:w-3 h-3 rounded-full bg-green-400"
                            >
                            </div>
                        </div>
                        <div
                            class="h-4 w-px bg-neutral-300 dark:bg-neutral-600 mx-1 sm:mx-2"
                        >
                        </div>
                        <div class="flex items-center gap-2">
                            <span
                                class="text-xs sm:text-sm font-bold text-neutral-900 dark:text-neutral-50 truncate max-w-[150px] sm:max-w-none"
                                >System Analysis - Unified Workspace</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Canvas Area -->
                <div
                    class="flex-1 relative bg-neutral-900 overflow-hidden min-h-[450px] sm:min-h-[600px]"
                >
                    <!-- The Provided Image -->
                    <div class="absolute inset-0">
                        <img
                            src="https://ik.imagekit.io/bhu1voux5/notes_ai_feature_with_code_editor_and_kumi"
                            alt="AI Notes and Code Studio"
                            class="w-full h-full object-cover sm:object-contain object-top"
                        />
                    </div>

                    <!-- HUD Overlay -->
                    <div class="absolute bottom-6 left-6 pointer-events-none">
                        <div
                            class="px-4 py-2 bg-gradient-to-r from-orange-500 to-amber-500 backdrop-blur-md text-white rounded-xl text-[10px] font-black uppercase tracking-widest shadow-2xl"
                        >
                            AI Partner Active
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contextual Note - Fixed 3-column level alignment -->
            <div
                class="mt-12 sm:mt-20 grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-12 group max-w-6xl mx-auto px-6"
            >
                <!-- Card 1 -->
                <div
                    class="flex flex-col items-center text-center gap-4 animate-fade-in-up"
                >
                    <div
                        class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-orange-100 dark:bg-orange-900/20 text-orange-600 flex items-center justify-center shadow-lg shadow-orange-500/5 shrink-0 hover:scale-110 transition-transform"
                    >
                        <svg
                            class="w-6 h-6 sm:w-7 sm:h-7"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                        >
                    </div>
                    <div>
                        <h4
                            class="font-bold text-lg text-neutral-900 dark:text-neutral-50 mb-2 leading-tight"
                        >
                            AI Analysis
                        </h4>
                        <p
                            class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-[280px]"
                        >
                            Ask Kumi to analyze your diagrams, identify logic
                            flaws, or suggest architectural optimizations in
                            real-time.
                        </p>
                    </div>
                </div>

                <!-- Card 2 -->
                <div
                    class="flex flex-col items-center text-center gap-4 animate-fade-in-up animation-delay-200"
                >
                    <div
                        class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-amber-100 dark:bg-amber-900/20 text-amber-600 flex items-center justify-center shadow-lg shadow-amber-500/5 shrink-0 hover:scale-110 transition-transform"
                    >
                        <svg
                            class="w-6 h-6 sm:w-7 sm:h-7"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <h4
                            class="font-bold text-lg text-neutral-900 dark:text-neutral-50 mb-2 leading-tight"
                        >
                            Code Studio
                        </h4>
                        <p
                            class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-[280px]"
                        >
                            A built-in code editor that lets you run and test
                            implementation directly alongside your architecture
                            diagrams.
                        </p>
                    </div>
                </div>

                <!-- Card 3 -->
                <div
                    class="flex flex-col items-center text-center gap-4 animate-fade-in-up animation-delay-400"
                >
                    <div
                        class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-yellow-100 dark:bg-yellow-900/20 text-yellow-600 flex items-center justify-center shadow-lg shadow-yellow-500/5 shrink-0 hover:scale-110 transition-transform"
                    >
                        <svg
                            class="w-6 h-6 sm:w-7 sm:h-7"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <h4
                            class="font-bold text-lg text-neutral-900 dark:text-neutral-50 mb-2 leading-tight"
                        >
                            Meet Kumi
                        </h4>
                        <p
                            class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-[280px]"
                        >
                            Your dedicated technical assistant that understands
                            your visuals and code to help you bridge the gap
                            between idea and execution.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>