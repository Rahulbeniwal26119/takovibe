---

---

<section class="dark relative overflow-hidden border-y border-neutral-900 bg-neutral-950 py-24 text-white sm:py-28">
  <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-[0.025] dark:opacity-[0.05]"></div>
  <div class="absolute -left-40 top-0 h-[420px] w-[420px] rounded-full bg-orange-300/20 blur-[120px] dark:bg-orange-900/15"></div>
  <div class="absolute -right-40 bottom-0 h-[440px] w-[440px] rounded-full bg-amber-200/30 blur-[130px] dark:bg-amber-900/10"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-sm font-bold text-orange-700 dark:border-orange-500/25 dark:bg-orange-500/10 dark:text-orange-300">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"></path>
          </svg>
          TakoVibe Reader
        </div>

        <h2 class="text-4xl font-black leading-tight tracking-tight text-neutral-950 md:text-5xl lg:text-6xl dark:text-white">
          Bring your EPUBs.
          <span class="bg-gradient-to-r from-orange-600 via-amber-500 to-orange-400 bg-clip-text text-transparent">Keep your place.</span>
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
          Upload your books to a private synced library and read without distractions. Switch themes, navigate chapters, and continue exactly where you stopped.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/reader"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-orange-950/20 transition hover:bg-orange-500"
          >
            Open Reader
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="/reader"
            class="inline-flex items-center justify-center rounded-xl border border-neutral-200 bg-white px-5 py-3 text-sm font-bold text-neutral-700 transition hover:border-orange-300 hover:bg-orange-50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-orange-700 dark:hover:bg-orange-950/30"
          >
            Upload an EPUB
          </a>
        </div>

        <div class="mt-10 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-neutral-200 bg-white/70 p-4 dark:border-neutral-800 dark:bg-neutral-900/70">
            <div class="text-xs font-black uppercase tracking-[0.16em] text-orange-600 dark:text-orange-300">Private</div>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Your EPUB library is stored securely for your account.</p>
          </div>
          <div class="rounded-xl border border-neutral-200 bg-white/70 p-4 dark:border-neutral-800 dark:bg-neutral-900/70">
            <div class="text-xs font-black uppercase tracking-[0.16em] text-orange-600 dark:text-orange-300">Synced</div>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Continue from your last chapter and reading position.</p>
          </div>
          <div class="rounded-xl border border-neutral-200 bg-white/70 p-4 dark:border-neutral-800 dark:bg-neutral-900/70">
            <div class="text-xs font-black uppercase tracking-[0.16em] text-orange-600 dark:text-orange-300">Focused</div>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Read in light, sepia, or dark mode with page turns.</p>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-orange-500/15 to-amber-300/10 blur-2xl"></div>
        <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-stone-50 shadow-2xl shadow-orange-950/10 dark:border-neutral-800 dark:bg-neutral-900">
          <div class="flex items-center justify-between border-b border-neutral-200 bg-white px-4 py-3 dark:border-neutral-800 dark:bg-neutral-950">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-orange-500"></span>
              <span class="text-xs font-black uppercase tracking-[0.18em] text-neutral-700 dark:text-neutral-300">My Library</span>
            </div>
            <span class="rounded-lg bg-orange-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-orange-700 dark:bg-orange-950/50 dark:text-orange-300">Synced</span>
          </div>

          <div class="grid gap-4 p-5 sm:grid-cols-[0.72fr_1.28fr] sm:p-6">
            <div class="rounded-xl border border-neutral-200 bg-white p-3 shadow-sm dark:border-neutral-800 dark:bg-neutral-950">
              <div class="aspect-[2/3] rounded-lg bg-gradient-to-br from-neutral-950 via-neutral-800 to-orange-950 p-4 text-white">
                <div class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-300">Viktor E. Frankl</div>
                <div class="mt-8 text-lg font-black leading-tight">Man's Search for Meaning</div>
                <div class="mt-3 h-px w-10 bg-orange-400"></div>
              </div>
              <div class="mt-3 text-sm font-black text-neutral-900 dark:text-neutral-100">Man's Search for Meaning</div>
              <div class="mt-1 text-xs text-neutral-500">Viktor E. Frankl</div>
              <div class="mt-3 h-1 overflow-hidden rounded-full bg-neutral-100 dark:bg-neutral-800">
                <div class="h-full w-[44%] rounded-full bg-orange-500"></div>
              </div>
              <div class="mt-2 text-[11px] font-bold text-orange-600 dark:text-orange-400">44% · Continue</div>
              <div class="mt-1 text-[11px] text-neutral-500">22:44 · Foreword</div>
            </div>

            <div class="flex min-h-[360px] flex-col overflow-hidden rounded-xl border border-neutral-800 bg-[#12110f] text-neutral-200 shadow-lg">
              <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
                <span class="text-[10px] font-black uppercase tracking-[0.18em] text-orange-300">Reading now</span>
                <div class="flex gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-neutral-600"></span>
                  <span class="h-2 w-2 rounded-full bg-orange-400"></span>
                  <span class="h-2 w-2 rounded-full bg-neutral-600"></span>
                </div>
              </div>
              <div class="flex-1 px-6 py-7 font-serif">
                <div class="text-[11px] font-sans font-black uppercase tracking-[0.2em] text-orange-300">Foreword</div>
                <h3 class="mt-4 text-2xl font-bold leading-tight text-stone-100">A book for finding meaning in every season of life.</h3>
                <p class="mt-5 text-sm leading-7 text-stone-400">
                  Settle into a focused reading space, return to the chapter you left, and let the interface fade into the background.
                </p>
              </div>
              <div class="flex items-center gap-3 border-t border-white/10 px-4 py-3">
                <span class="font-mono text-[11px] text-neutral-500">22:44</span>
                <span class="min-w-0 flex-1 truncate text-xs text-neutral-400">Foreword</span>
                <div class="h-1 w-20 overflow-hidden rounded-full bg-white/10">
                  <div class="h-full w-[44%] rounded-full bg-orange-500"></div>
                </div>
                <span class="text-xs font-black text-neutral-300">44%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
