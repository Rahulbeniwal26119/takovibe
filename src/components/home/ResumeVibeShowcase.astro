---

---

<section
    class="py-24 sm:py-32 relative overflow-hidden bg-stone-50 dark:bg-neutral-950"
>
    <!-- Background Gradients -->
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
        <div
            class="absolute -top-[10%] -left-[10%] w-[600px] h-[600px] bg-orange-200/20 dark:bg-orange-900/10 blur-[130px] rounded-full"
        >
        </div>
        <div
            class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-amber-200/20 dark:bg-amber-900/10 blur-[150px] rounded-full"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Visual Side: Interactive Product Showcase -->
            <div class="relative group perspective-1000 order-2 lg:order-1">
                <div
                    class="absolute -inset-4 bg-gradient-to-r from-orange-500/20 to-amber-500/20 rounded-[2.5rem] blur-3xl opacity-50"
                >
                </div>

                <div
                    class="relative bg-white dark:bg-neutral-900 rounded-3xl shadow-2xl border border-neutral-200 dark:border-neutral-700 overflow-hidden transform transition-all duration-700"
                >
                    <!-- Window Header -->
                    <div
                        class="flex items-center justify-between px-6 py-4 bg-neutral-50/50 dark:bg-neutral-800 border-b border-neutral-100 dark:border-neutral-700"
                    >
                        <div class="flex gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-400">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-green-400">
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div
                                class="px-3 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 rounded-full text-[10px] font-bold uppercase tracking-wider"
                            >
                                Live Product Preview
                            </div>
                        </div>
                    </div>

                    <!-- Image Display Area -->
                    <div
                        class="relative aspect-[16/10] overflow-hidden bg-neutral-100 dark:bg-black group/img"
                    >
                        <div
                            id="resume-image-container"
                            class="w-full h-full relative"
                        >
                            {
                                [
                                    {
                                        id: "gaps",
                                        url: "https://ik.imagekit.io/bhu1voux5/resumevibe_gaps",
                                    },
                                    {
                                        id: "suggestions",
                                        url: "https://ik.imagekit.io/bhu1voux5/resume_vibe_suggestion",
                                    },
                                    {
                                        id: "versions",
                                        url: "https://ik.imagekit.io/bhu1voux5/resumevibe_versions",
                                    },
                                    {
                                        id: "dashboard",
                                        url: "https://ik.imagekit.io/bhu1voux5/resumevibe_my_resume_page",
                                    },
                                ].map((img, idx) => (
                                    <img
                                        id={`promo-img-${img.id}`}
                                        src={img.url}
                                        alt={`ResumeVibe ${img.id}`}
                                        class={`absolute inset-0 w-full h-full object-cover transition-all duration-700 ${idx === 0 ? "opacity-100 scale-100" : "opacity-0 scale-105 pointer-events-none"}`}
                                        loading={idx === 0 ? "eager" : "lazy"}
                                    />
                                ))
                            }
                        </div>

                        <!-- HUD Overlay -->
                        <div
                            class="absolute bottom-6 left-6 right-6 flex items-center justify-between pointer-events-none"
                        >
                            <div
                                class="bg-neutral-900/90 backdrop-blur-md text-white px-4 py-2 rounded-xl border border-white/10 text-[10px] font-black uppercase tracking-[0.2em] shadow-2xl"
                            >
                                Intelligent System
                            </div>
                        </div>
                    </div>

                    <!-- Feature Tabs -->
                    <div
                        class="grid grid-cols-4 border-t border-neutral-100 dark:border-neutral-700 bg-white dark:bg-neutral-900"
                    >
                        {
                            [
                                { id: "gaps", label: "Gaps", icon: "🔍" },
                                {
                                    id: "suggestions",
                                    label: "Fixes",
                                    icon: "🤖",
                                },
                                {
                                    id: "versions",
                                    label: "History",
                                    icon: "⏳",
                                },
                                {
                                    id: "dashboard",
                                    label: "Manage",
                                    icon: "🗂️",
                                },
                            ].map((tab, idx) => (
                                <button
                                    data-tab-id={tab.id}
                                    class={`flex flex-col items-center gap-1.5 py-4 transition-all hover:bg-neutral-50 dark:hover:bg-white/5 ${idx === 0 ? "border-b-2 border-orange-500 bg-orange-50/30 dark:bg-orange-900/10" : ""} resume-tab-btn`}
                                >
                                    <span class="text-sm">{tab.icon}</span>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
                                        {tab.label}
                                    </span>
                                </button>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Text Content -->
            <div class="order-1 lg:order-2">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-300 text-sm font-bold mb-6 border border-orange-200/50 dark:border-orange-800"
                >
                    <span class="animate-pulse">💎</span>
                    <span>Professional Advantage</span>
                </div>

                <h2
                    class="text-4xl md:text-5xl lg:text-6xl font-black text-neutral-900 dark:text-neutral-50 mb-8 leading-tight tracking-tighter"
                >
                    Build a resume that skips the <span
                        class="block text-brand-600 dark:text-brand-400"
                        >Waitlist.</span
                    >
                </h2>

                <p
                    class="text-xl text-neutral-600 dark:text-neutral-300 mb-10 leading-relaxed font-medium"
                >
                    Experience the first autonomous career presentation engine.
                    View deep-audit diagnostics, AI-powered rewrites, and 10
                    version control, all in one place.
                </p>

                <div class="grid sm:grid-cols-2 gap-8 mb-12">
                    <div class="space-y-3">
                        <div
                            class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-600"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                                ></path></svg
                            >
                        </div>
                        <h3 class="font-bold text-neutral-900 dark:text-neutral-50">
                            Personalized Public Links
                        </h3>
                        <p
                            class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed"
                        >
                            The new style of sharing. Send a polished, live URL
                            instead of tracking PDFs. Professional, and always
                            up-to-date.
                        </p>
                    </div>
                    <div class="space-y-3">
                        <div
                            class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-600"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                            >
                        </div>
                        <h3 class="font-bold text-neutral-900 dark:text-neutral-50">
                            AI Power Autopilot
                        </h3>
                        <p
                            class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed"
                        >
                            Deep-audit your experience bullets and rewrite them
                            for maximum impact and ATS density.
                        </p>
                    </div>
                    <!-- New Item 3 -->
                    <div class="space-y-3">
                        <div
                            class="w-10 h-10 rounded-xl bg-yellow-500/10 flex items-center justify-center text-yellow-600"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                ></path></svg
                            >
                        </div>
                        <h3 class="font-bold text-neutral-900 dark:text-neutral-50">
                            100% ATS-Friendly
                        </h3>
                        <p
                            class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed"
                        >
                            Tested against Greenhouse, Workday, and Lever.
                            Standard layout guarantees a perfect read every
                            time.
                        </p>
                    </div>
                    <!-- New Item 4 -->
                    <div class="space-y-3">
                        <div
                            class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-600"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                ></path></svg
                            >
                        </div>
                        <h3 class="font-bold text-neutral-900 dark:text-neutral-50">
                            Deep Audit Diagnostics
                        </h3>
                        <p
                            class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed"
                        >
                            Identify content gaps and formatting issues before a
                            recruiter ever sees them. Get a real score.
                        </p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        href="https://resumevibe.takovibe.com/"
                        class="group px-8 py-4 bg-gradient-to-r from-orange-500 to-amber-600 text-white font-bold rounded-2xl flex items-center justify-center gap-2 hover:from-orange-600 hover:to-amber-700 transition-all shadow-xl hover:shadow-orange-500/20 hover:scale-105"
                    >
                        <span>Get Started for Free</span>
                        <svg
                            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                        >
                    </a>
                    <a
                        href="https://resumevibe.takovibe.com/why-resumevibe"
                        class="px-8 py-4 text-neutral-600 dark:text-neutral-400 font-bold hover:text-orange-600 dark:hover:text-orange-400 transition-colors flex items-center justify-center"
                    >
                        Why ResumeVibe?
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function initResumeVibeTabs() {
        const tabBtns = document.querySelectorAll(".resume-tab-btn");
        const images = document.querySelectorAll("#resume-image-container img");

        tabBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const tabId = btn.getAttribute("data-tab-id");

                // Update Buttons
                tabBtns.forEach((b) => {
                    b.classList.remove(
                        "border-b-2",
                        "border-orange-500",
                        "bg-orange-50/30",
                        "dark:bg-orange-900/10",
                    );
                });
                btn.classList.add(
                    "border-b-2",
                    "border-orange-500",
                    "bg-orange-50/30",
                    "dark:bg-orange-900/10",
                );

                // Update Images
                images.forEach((img) => {
                    if (img.id === `promo-img-${tabId}`) {
                        img.classList.remove(
                            "opacity-0",
                            "scale-105",
                            "pointer-events-none",
                        );
                        img.classList.add("opacity-100", "scale-100");
                    } else {
                        img.classList.add(
                            "opacity-0",
                            "scale-105",
                            "pointer-events-none",
                        );
                        img.classList.remove("opacity-100", "scale-100");
                    }
                });
            });
        });
    }

    // Run on initial load and view transitions
    document.addEventListener("astro:page-load", initResumeVibeTabs);
    // Fallback for non-View Transition navigations if any
    document.addEventListener("DOMContentLoaded", initResumeVibeTabs);
</script>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }
</style>