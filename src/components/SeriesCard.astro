---
const { series, status = "live", badgeText } = Astro.props;

const capitalize = (text) => {
    return text ? text.charAt(0).toUpperCase() + text.slice(1) : "";
};

const totalArticles = series.planned_articles || 0;
const publishedArticles =
    series.total_published_articles ||
    series.articles_count ||
    (series.latest_article ? 1 : 0);
const progress =
    totalArticles > 0 ? Math.min((publishedArticles / totalArticles) * 100, 100) : 0;

const isOngoing = status === "live";
const isComplete = status === "completed";
const isPlanned = status === "planned";
const label = badgeText || (isComplete ? "Completed" : isPlanned ? "Planned" : "Live");
const levelText = [series.start_level, series.end_level]
    .filter(Boolean)
    .map(capitalize)
    .join(" to ");
const coverImage = series.cover_image || series.image_url || series.image;
---

<article
    class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white transition-colors duration-200 hover:border-orange-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-orange-800"
>
    {
        coverImage && (
            <a
                href={isPlanned ? "#" : `/series/${series.slug}`}
                class={`block aspect-[16/9] overflow-hidden bg-neutral-100 dark:bg-neutral-800 ${isPlanned ? "cursor-not-allowed" : ""}`}
                aria-label={series.title}
            >
                <img
                    src={coverImage}
                    alt={series.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                    loading="lazy"
                />
            </a>
        )
    }

    <div class="flex flex-1 flex-col p-5">
        <div class="mb-4 flex items-center justify-between gap-3">
            <span
                class={`inline-flex items-center gap-2 rounded-md px-2.5 py-1 text-xs font-semibold ${
                    isComplete
                        ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-300"
                        : isPlanned
                          ? "bg-amber-50 text-amber-700 dark:bg-amber-950/30 dark:text-amber-300"
                          : "bg-orange-50 text-orange-700 dark:bg-orange-950/30 dark:text-orange-300"
                }`}
            >
                {
                    isOngoing && (
                        <span class="h-1.5 w-1.5 rounded-full bg-orange-500" />
                    )
                }
                {label}
            </span>
            {
                levelText && (
                    <span class="truncate text-xs font-medium text-neutral-400 dark:text-neutral-500">
                        {levelText}
                    </span>
                )
            }
        </div>

        <a href={isPlanned ? "#" : `/series/${series.slug}`} class={isPlanned ? "pointer-events-none" : ""}>
            <h3 class="mb-2 text-xl font-bold leading-tight text-neutral-900 transition-colors group-hover:text-orange-600 dark:text-neutral-50 dark:group-hover:text-orange-400">
                {series.title}
            </h3>
        </a>

        <p class="mb-5 line-clamp-2 flex-1 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
            {
                series.description ||
                    "A structured learning path with articles arranged from foundations to practical depth."
            }
        </p>

        <div class="mb-5 grid grid-cols-2 gap-3 border-y border-neutral-100 py-4 dark:border-neutral-800">
            <div>
                <div class="text-lg font-bold text-neutral-900 dark:text-neutral-50">
                    {publishedArticles}
                </div>
                <div class="text-xs font-medium text-neutral-400 dark:text-neutral-500">
                    Published
                </div>
            </div>
            <div>
                <div class="text-lg font-bold text-neutral-900 dark:text-neutral-50">
                    {totalArticles > 0 ? totalArticles : "Open"}
                </div>
                <div class="text-xs font-medium text-neutral-400 dark:text-neutral-500">
                    Total
                </div>
            </div>
        </div>

        {
            !isPlanned && totalArticles > 0 && (
                <div class="mb-5">
                    <div class="mb-2 flex items-center justify-between text-xs font-medium text-neutral-400 dark:text-neutral-500">
                        <span>Progress</span>
                        <span>{Math.round(progress)}%</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-full bg-neutral-100 dark:bg-neutral-800">
                        <div
                            class={`h-full rounded-full ${isComplete ? "bg-emerald-500" : "bg-orange-500"}`}
                            style={`width: ${progress}%`}
                        />
                    </div>
                </div>
            )
        }

        {
            series.topic_covered && series.topic_covered.length > 0 && (
                <div class="mb-5 flex flex-wrap gap-2">
                    {series.topic_covered.slice(0, 3).map((topic) => (
                        <span class="rounded-md bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                            {topic}
                        </span>
                    ))}
                </div>
            )
        }

        <div class="mt-auto flex gap-2">
            <a
                href={isPlanned ? "#" : `/series/${series.slug}`}
                class={`flex-1 rounded-lg px-4 py-2.5 text-center text-sm font-semibold transition-colors ${
                    isPlanned
                        ? "cursor-not-allowed bg-neutral-100 text-neutral-400 dark:bg-neutral-800 dark:text-neutral-500"
                        : "bg-neutral-900 text-white hover:bg-orange-600 dark:bg-neutral-100 dark:text-neutral-950 dark:hover:bg-orange-400"
                }`}
                onclick={isPlanned ? "event.preventDefault()" : ""}
            >
                {isPlanned ? "Coming Soon" : "View Series"}
            </a>
            {
                !isPlanned && series.latest_article && (
                    <a
                        href={`/blog/${series.latest_article.slug}`}
                        class="rounded-lg border border-neutral-200 px-4 py-2.5 text-sm font-semibold text-neutral-600 transition-colors hover:border-orange-300 hover:text-orange-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-orange-800 dark:hover:text-orange-400"
                        title={series.latest_article.title}
                    >
                        Latest
                    </a>
                )
            }
        </div>
    </div>
</article>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
