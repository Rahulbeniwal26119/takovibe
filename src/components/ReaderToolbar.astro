---
import TableOfContents from "./TableOfContents.astro";
import SocialShare from "./SocialShare.astro";
import CommentsDrawer from "./CommentsDrawer.astro";

interface Props {
    headings: { depth: number; slug: string; text: string }[];
    title: string;
    description: string;
    url: string;
    slug: string;
}

const { headings, title, description, url, slug } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL;
// Feature Flag: Mobile UX Improvements
const enableMobileDock =
    import.meta.env.PUBLIC_ENABLE_MOBILE_DOCK === "true" || true; // Enabled by default
---

<div
    id="reader-toolbar-container"
    class="fixed bottom-6 z-50 w-full max-w-2xl px-4 pointer-events-none transition-all duration-300 ease-in-out"
>
    <style>
        /* Default centered position */
        #reader-toolbar-container {
            left: 50%;
            transform: translateX(-50%);
        }

        /* When Split View is Active (Code Studio or Excalidraw): Collapse to compact pill on Left */
        :global(body.split-view-active) #reader-toolbar-container {
            left: 1rem !important;
            bottom: 1rem !important;
            transform: none !important;
            max-width: auto !important;
            width: auto !important;
            z-index: 30001 !important; /* Above Zen Nav */
            padding: 0 !important; /* Remove container padding to let inner div handle it */
        }

        :global(body.split-view-active) #reader-toolbar-container > div {
            width: auto !important;
            padding: 0.5rem !important;
            gap: 0 !important;
        }

        /* Hide most buttons in split view, show only toggle */
        :global(body.split-view-active)
            #reader-toolbar-container
            button:not(#reader-toolbar-toggle) {
            display: none !important;
        }

        :global(body.split-view-active) #reader-toolbar-container .w-px {
            display: none !important;
        }

        /* Show toggle button */
        #reader-toolbar-toggle {
            display: none;
        }

        :global(body.split-view-active) #reader-toolbar-toggle {
            display: flex !important;
        }

        /* Show all buttons when toolbar is expanded */
        :global(body.split-view-active)
            #reader-toolbar-container.toolbar-expanded
            button:not(#reader-toolbar-toggle) {
            display: flex !important;
        }

        :global(body.split-view-active)
            #reader-toolbar-container.toolbar-expanded
            .w-px {
            display: block !important;
        }

        :global(body.split-view-active)
            #reader-toolbar-container.toolbar-expanded
            > div
            > div {
            display: flex !important;
        }

        :global(body.split-view-active)
            #reader-toolbar-container.toolbar-expanded {
            max-width: calc(50vw - 2rem) !important;
        }

        /* Mobile/Tablet: Minimize toolbar to pill (under 1024px) */
        @media (max-width: 1023px) {
            #reader-toolbar-container {
                left: 1rem !important;
                bottom: 1rem !important;
                transform: none !important;
                max-width: auto !important;
                width: auto !important;
            }

            #reader-toolbar-container > div {
                width: auto !important;
                padding: 0.5rem !important;
            }

            /* Hide buttons on mobile by default */
            #reader-toolbar-container button:not(#reader-toolbar-toggle),
            #reader-toolbar-container > div > div {
                display: none !important;
            }

            #reader-toolbar-container .w-px {
                display: none !important;
            }

            /* Show toggle button on mobile */
            #reader-toolbar-toggle {
                display: flex !important;
            }

            /* Show all when expanded on mobile */
            #reader-toolbar-container.toolbar-expanded
                button:not(#reader-toolbar-toggle),
            #reader-toolbar-container.toolbar-expanded > div > div {
                display: flex !important;
            }

            #reader-toolbar-container.toolbar-expanded .w-px {
                display: block !important;
            }

            #reader-toolbar-container.toolbar-expanded {
                max-width: calc(100vw - 2rem) !important;
            }

            #reader-toolbar-container.toolbar-expanded > div {
                width: auto !important;
                max-width: calc(100vw - 3rem) !important;
            }
        }

        /* Show AI Chat Button in Toolbar on Desktop when Split View is Active */
        :global(body.excalidraw-split-active) #ai-chat-toggle {
            display: block !important;
        }
    </style>
    <div
        class={`bg-gray-100/95 dark:bg-gray-900/80 backdrop-blur-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-200 rounded-2xl shadow-2xl p-2 pointer-events-auto items-center justify-between w-full gap-1 overflow-x-auto custom-scrollbar ${enableMobileDock ? "hidden lg:flex" : "flex"}`}
    >
        <!-- Toggle Button (Only visible in split view) -->
        <button
            id="reader-toolbar-toggle"
            class="p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all"
            aria-label="Reader Tools"
            title="Reader Tools"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                ></path>
            </svg>
        </button>

        <!-- Section 1: Reader Controls -->
        <div class="flex items-center gap-1 shrink-0">
            <!-- Copy Link Button (Hidden on Mobile) -->
            <button
                id="copy-link-btn"
                class="hidden md:block p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all relative group"
                aria-label="Copy article link"
                title="Copy Link"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                    ></path>
                </svg>
            </button>

            <!-- TOC Toggle (Mobile Only) -->
            <button
                id="toc-toggle"
                class="lg:hidden p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all"
                aria-label="Table of Contents"
                title="Table of Contents"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h7"></path>
                </svg>
            </button>

            <!-- Font Settings Toggle -->
            <button
                id="font-toggle"
                class="p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all"
                aria-label="Text Settings"
                title="Text Settings"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"
                    ></path>
                </svg>
            </button>

            <!-- Focus Mode Toggle -->
            <button
                id="focus-mode-toggle"
                class="p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all duration-200 hover:scale-105"
                aria-label="Focus Mode"
                title="Focus Mode (F)"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                </svg>
            </button>
        </div>

        <!-- Divider -->
        <div class="w-px h-8 bg-gray-200 dark:bg-gray-700 mx-1 shrink-0"></div>

        <!-- Section 2: Smart Tools (Extensible) -->
        <div
            class="flex items-center gap-1 shrink-0"
            id="smart-tools-container"
        >
            <!-- Draw Toggle (Excalidraw) -->
            <button
                id="draw-toggle"
                class="p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all relative group"
                aria-label="Sketch Notes"
                title="Sketch Notes"
            >
                <div class="relative">
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                        ></path>
                    </svg>
                </div>
                <span
                    id="draw-indicator"
                    class="hidden absolute top-2 right-2 w-2 h-2 bg-purple-500 rounded-full ring-2 ring-white dark:ring-gray-900"
                ></span>
            </button>

            <!-- AI Chat Toggle -->
            <button
                id="ai-chat-toggle"
                class="p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all relative group"
                aria-label="Ask AI"
                title="Ask AI"
            >
                <div class="relative">
                    <span
                        class="absolute -top-2.5 -right-2.5 px-1 py-0.5 bg-gradient-to-r from-purple-600 to-pink-600 text-[9px] font-bold text-white rounded-full shadow-lg border border-white/20 animate-pulse leading-none"
                    >
                        Preview
                    </span>
                    <svg
                        class="w-5 h-5 text-purple-600 dark:text-purple-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
            </button>

            <!-- Code Studio Toggle -->
            <button
                id="code-editor-toggle"
                class="p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all relative group"
                aria-label="Code Studio"
                title="Open Code Studio"
            >
                <div class="relative">
                    <svg
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                </div>
            </button>

            <!-- Placeholder for future tools (will be populated by JS or simple manual add) -->
        </div>

        <!-- Divider -->
        <div class="w-px h-8 bg-gray-200 dark:bg-gray-700 mx-1 shrink-0"></div>

        <!-- Section 3: Engagement -->
        <div class="flex items-center gap-1 shrink-0">
            <!-- Like Button -->
            <button
                id="like-btn"
                class="group p-2 flex items-center gap-1.5 text-gray-600 dark:text-gray-400 hover:text-red-500 dark:hover:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all"
                aria-label="Like"
                title="Like"
            >
                <svg
                    class="w-5 h-5 transition-transform group-hover:scale-110"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    ></path>
                </svg>
                <span id="like-count" class="text-xs font-semibold">0</span>
            </button>

            <!-- Comments Toggle -->
            <button
                id="comments-toggle"
                class="p-2 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all"
                aria-label="Comments"
                title="Comments"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                    ></path>
                </svg>
            </button>

            <!-- Share Toggle -->
            <button
                id="share-toggle"
                class="p-2 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all"
                aria-label="Share"
                title="Share"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                    ></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Drawers/Popups -->

    <!-- TOC Drawer -->
    <div
        id="toc-drawer"
        class="absolute bottom-full left-4 mb-4 w-64 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-2xl p-4 transform scale-95 opacity-0 pointer-events-none transition-all duration-200 origin-bottom-left"
    >
        <div class="flex items-center justify-between mb-4">
            <h3
                class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider"
            >
                Contents
            </h3>
            <button
                class="close-drawer text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
                aria-label="Close drawer"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path></svg
                >
            </button>
        </div>
        <div class="max-h-64 overflow-y-auto custom-scrollbar">
            <TableOfContents headings={headings} />
        </div>
    </div>

    <!-- Font Settings Drawer -->
    <div
        id="font-drawer"
        class="absolute bottom-full left-4 right-4 sm:left-16 sm:right-auto mb-4 sm:w-80 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-2xl p-5 transform scale-95 opacity-0 pointer-events-none transition-all duration-200 origin-bottom-left"
    >
        <div class="flex items-center justify-between mb-4">
            <h3
                class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider"
            >
                Appearance
            </h3>
            <button
                class="close-drawer text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
                aria-label="Close drawer"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path></svg
                >
            </button>
        </div>

        <!-- Font Size Controls -->
        <div class="flex flex-col items-center space-y-4">
            <div class="flex items-center justify-between w-full px-2">
                <span class="text-xs text-gray-500 font-medium">Small</span>
                <span
                    id="currentSize"
                    class="text-sm font-bold text-purple-600 dark:text-purple-400"
                    >18px</span
                >
                <span class="text-xs text-gray-500 font-medium">Large</span>
            </div>

            <div class="flex items-center justify-between w-full gap-3">
                <button
                    id="decreaseBtn"
                    class="p-2.5 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                    aria-label="Decrease font size"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M20 12H4"></path>
                    </svg>
                </button>

                <div
                    class="flex-1 h-2 bg-gray-200 dark:bg-gray-700 rounded-full relative cursor-pointer"
                    id="sliderContainer"
                >
                    <div
                        id="sliderTrack"
                        class="absolute left-0 top-0 h-full bg-purple-500 rounded-full"
                        style="width: 50%"
                    >
                    </div>
                    <div
                        id="sliderHandle"
                        class="absolute top-1/2 -translate-y-1/2 w-5 h-5 bg-white border-2 border-purple-500 rounded-full shadow-md cursor-pointer hover:scale-110 transition-transform"
                        style="left: 50%"
                    >
                    </div>
                </div>

                <button
                    id="increaseBtn"
                    class="p-2.5 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                    aria-label="Increase font size"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 4v16m8-8H4"></path>
                    </svg>
                </button>
            </div>

            <button
                id="resetBtn"
                class="text-xs text-gray-500 hover:text-purple-600 dark:hover:text-purple-400 transition-colors flex items-center gap-1"
            >
                <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    ></path></svg
                >
                Reset to default
            </button>
        </div>
    </div>

    <!-- Share Drawer -->
    <div
        id="share-drawer"
        class="absolute bottom-full right-4 mb-4 w-64 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-2xl p-4 transform scale-95 opacity-0 pointer-events-none transition-all duration-200 origin-bottom-right"
    >
        <div class="flex items-center justify-between mb-4">
            <h3
                class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider"
            >
                Share
            </h3>
            <button
                class="close-drawer text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
                aria-label="Close drawer"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path></svg
                >
            </button>
        </div>

        <!-- Copy Link Button (Moved here) -->
        <button
            id="copy-link-btn"
            class="w-full flex items-center justify-center gap-2 p-2 mb-3 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors group"
        >
            <svg
                class="w-4 h-4 text-gray-600 dark:text-gray-400 copy-icon"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                ></path>
            </svg>
            <svg
                class="w-4 h-4 text-green-500 check-icon hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300"
                >Copy Link</span
            >
        </button>

        <SocialShare title={title} description={description} url={url} />
    </div>
</div>

<!-- Comments Drawer Component -->
<CommentsDrawer slug={slug} />

<script define:vars={{ slug, apiUrl }}>
    // Reader Toolbar Toggle (for split view)
    const readerToolbarToggle = document.getElementById(
        "reader-toolbar-toggle",
    );
    const readerToolbarContainer = document.getElementById(
        "reader-toolbar-container",
    );
    let toolbarExpanded = false;

    if (readerToolbarToggle && readerToolbarContainer) {
        readerToolbarToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            toolbarExpanded = !toolbarExpanded;

            if (toolbarExpanded) {
                readerToolbarContainer.classList.add("toolbar-expanded");
            } else {
                readerToolbarContainer.classList.remove("toolbar-expanded");
            }
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (toolbarExpanded && !readerToolbarContainer.contains(e.target)) {
                toolbarExpanded = false;
                readerToolbarContainer.classList.remove("toolbar-expanded");
            }
        });
    }

    // Drawer Logic
    function setupDrawer(toggleId, drawerId) {
        const toggle = document.getElementById(toggleId);
        const drawer = document.getElementById(drawerId);
        const closeBtns = drawer?.querySelectorAll(".close-drawer");

        if (!toggle || !drawer) return;

        function open() {
            // Close all other drawers first
            document.querySelectorAll('[id$="-drawer"]').forEach((el) => {
                if (el.id !== drawerId && el.id !== "comments-drawer")
                    close(el);
            });

            drawer?.classList.remove(
                "opacity-0",
                "scale-95",
                "pointer-events-none",
            );
            drawer?.classList.add(
                "opacity-100",
                "scale-100",
                "pointer-events-auto",
            );
            toggle?.classList.add(
                "text-purple-600",
                "bg-purple-50",
                "dark:bg-purple-900/20",
            );
        }

        function close(el = drawer) {
            el.classList.add("opacity-0", "scale-95", "pointer-events-none");
            el.classList.remove(
                "opacity-100",
                "scale-100",
                "pointer-events-auto",
            );

            // Find associated toggle and reset style
            const id = el.id.replace("-drawer", "-toggle");
            const t = document.getElementById(id);
            t?.classList.remove(
                "text-purple-600",
                "bg-purple-50",
                "dark:bg-purple-900/20",
            );
        }

        function toggleDrawer() {
            const isOpen = !drawer?.classList.contains("opacity-0");
            if (isOpen) close();
            else open();
        }

        toggle.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleDrawer();
        });

        closeBtns?.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                close();
            });
        });

        // Close on click outside
        document.addEventListener("click", (e) => {
            const target = e.target;
            if (!drawer.contains(target) && !toggle.contains(target)) {
                close();
            }
        });
    }

    setupDrawer("toc-toggle", "toc-drawer");
    setupDrawer("font-toggle", "font-drawer");
    setupDrawer("share-toggle", "share-drawer");

    // Comments Toggle
    document
        .getElementById("comments-toggle")
        ?.addEventListener("click", () => {
            if (window.toggleComments) window.toggleComments();
        });

    // Like Logic
    const likeBtn = document.getElementById("like-btn");
    const likeCountEl = document.getElementById("like-count");
    let likeCount = 0;
    let pendingLikes = 0;
    let likeTimeout = null;

    async function fetchLikes() {
        try {
            const res = await fetch(
                `${apiUrl}/api/blogs/meta/?blog_slug=${slug}`,
            );
            const data = await res.json();
            if (data.code === 0) {
                likeCount = data.data.like_count || 0;
                if (likeCountEl) likeCountEl.textContent = likeCount;
            }
        } catch (err) {
            console.error("Error fetching likes:", err);
        }
    }

    async function updateLikes() {
        if (pendingLikes > 0) {
            try {
                await fetch(`${apiUrl}/api/blogs/likes/`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ likes: pendingLikes, blog: slug }),
                });
                pendingLikes = 0;
                fetchLikes();
            } catch (err) {
                console.error("Error updating likes:", err);
            }
        }
    }

    if (likeBtn) {
        likeBtn.addEventListener("click", () => {
            likeCount++;
            pendingLikes++;
            if (likeCountEl) likeCountEl.textContent = likeCount;

            // Visual feedback
            const icon = likeBtn.querySelector("svg");
            icon.classList.add("text-red-500", "scale-125");
            setTimeout(() => icon.classList.remove("scale-125"), 200);

            // Debounce API call
            if (likeTimeout) clearTimeout(likeTimeout);
            likeTimeout = setTimeout(updateLikes, 1000);
        });
    }

    // Check for existing user drawings to show indicator
    async function checkUserDrawing() {
        const token = localStorage.getItem("access_token");
        if (!token) return;

        try {
            const res = await fetch(
                `${apiUrl}/api/blogs/user-drawings/?my_drawings=true&blog_slug=${slug}`,
                {
                    headers: { Authorization: `Token ${token}` },
                },
            );
            if (res.ok) {
                const data = await res.json();
                const results =
                    data.results || (Array.isArray(data) ? data : []);
                // Filter specifically for this slug if backend doesn't filter perfectly
                const myDrawing = results.find((d) => d.blog_slug === slug);

                if (myDrawing) {
                    const indicator = document.getElementById("draw-indicator");
                    if (indicator) {
                        indicator.classList.remove("hidden");
                        // Optional: Add tooltip or glow
                        indicator.title = "You have a saved drawing";
                    }
                }
            }
        } catch (e) {
            // silent fail
        }
    }

    checkUserDrawing();

    fetchLikes();

    // Font Size Logic (Robust)
    function initFontSize() {
        console.log("Initializing Font Size Logic");
        const MIN_SIZE = 16;
        const MAX_SIZE = 24;
        const DEFAULT_SIZE = 18;

        let currentSize = parseInt(
            localStorage.getItem("blog-font-size") || DEFAULT_SIZE.toString(),
        );

        const display = document.getElementById("currentSize");
        const track = document.getElementById("sliderTrack");
        const handle = document.getElementById("sliderHandle");

        function updateUI(size) {
            if (display) display.textContent = `${size}px`;

            const percentage =
                ((size - MIN_SIZE) / (MAX_SIZE - MIN_SIZE)) * 100;
            if (track) track.style.width = `${percentage}%`;
            if (handle) handle.style.left = `${percentage}%`;
        }

        function applySize(size) {
            console.log("Applying font size:", size);
            // Create or update style tag
            let style = document.getElementById("dynamic-font-size");
            if (!style) {
                style = document.createElement("style");
                style.id = "dynamic-font-size";
                document.head.appendChild(style);
            }

            style.textContent = `
        #article .prose p, 
        #article .prose li, 
        #article .prose ul, 
        #article .prose ol,
        .mdx-content p,
        .mdx-content li {
          font-size: ${size}px !important;
          line-height: 1.7 !important;
        }
        #article .prose h1, .mdx-content h1 { font-size: ${size * 2.2}px !important; }
        #article .prose h2, .mdx-content h2 { font-size: ${size * 1.8}px !important; }
        #article .prose h3, .mdx-content h3 { font-size: ${size * 1.5}px !important; }
        #article .prose h4, .mdx-content h4 { font-size: ${size * 1.25}px !important; }
      `;

            localStorage.setItem("blog-font-size", size.toString());
        }

        function setSize(size) {
            size = Math.min(Math.max(size, MIN_SIZE), MAX_SIZE);
            currentSize = size;
            updateUI(size);
            applySize(size);
        }

        // Initialize
        setSize(currentSize);

        document
            .getElementById("increaseBtn")
            ?.addEventListener("click", () => setSize(currentSize + 1));
        document
            .getElementById("decreaseBtn")
            ?.addEventListener("click", () => setSize(currentSize - 1));
        document
            .getElementById("resetBtn")
            ?.addEventListener("click", () => setSize(DEFAULT_SIZE));
    }

    document.addEventListener("DOMContentLoaded", initFontSize);
    document.addEventListener("astro:after-swap", initFontSize);

    // AI Chat Toggle Logic - Fixed Syntax
    const aiChatToggleBtn = document.getElementById("ai-chat-toggle");
    if (aiChatToggleBtn) {
        aiChatToggleBtn.addEventListener("click", () => {
            const token = localStorage.getItem("access_token");
            if (!token) {
                const event = new CustomEvent("show-login-prompt", {
                    detail: {
                        feature: "Kumi AI",
                        next: window.location.pathname + window.location.search,
                    },
                });
                window.dispatchEvent(event);
                return;
            }
            // Ensure 'new' keyword is used
            const event = new CustomEvent("toggle-ai-chat");
            window.dispatchEvent(event);
        });
    }

    // Draw Toggle Logic
    const drawToggleBtn = document.getElementById("draw-toggle");
    if (drawToggleBtn) {
        drawToggleBtn.addEventListener("click", () => {
            // Check auth
            const token = localStorage.getItem("access_token");
            if (!token) {
                const event = new CustomEvent("show-login-prompt", {
                    detail: {
                        feature: "sketch notes",
                        next: window.location.pathname + window.location.search,
                    },
                });
                window.dispatchEvent(event);
                return;
            }
            const event = new CustomEvent("toggle-excalidraw");
            window.dispatchEvent(event);
        });

        // Check for existing drawings to show indicator
        async function checkDrawingStatus() {
            const token = localStorage.getItem("access_token");
            if (!token) return;

            try {
                const res = await fetch(
                    `${apiUrl}/api/blogs/user-drawings/?my_drawings=true&blog_slug=${slug}`,
                    {
                        headers: { Authorization: `Token ${token}` },
                    },
                );
                if (res.ok) {
                    const data = await res.json();
                    // Assuming list response
                    if (Array.isArray(data) && data.length > 0) {
                        const indicator =
                            document.getElementById("draw-indicator");
                        if (indicator) indicator.classList.remove("hidden");

                        // User requirement: "if they have any notes then show an option to open the note"
                        // We strictly show the button always, but maybe we pulse it or something?
                        // Or trigger the drawer automatically?
                        // "show an option to open" -> The button is the option.
                        // I'll add a visual cue (indicator).
                    }
                }
            } catch (e) {
                console.error("Failed to check drawing status", e);
            }
        }

        // Run check
        checkDrawingStatus();
    }

    // Copy Link Functionality
    const copyArticleLinkBtn = document.getElementById("copy-link-btn");
    if (copyArticleLinkBtn) {
        copyArticleLinkBtn.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(window.location.href);

                // Visual feedback
                const originalHTML = copyArticleLinkBtn.innerHTML;
                copyArticleLinkBtn.innerHTML = `
                    <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span class="absolute -top-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-green-600 text-white text-xs rounded whitespace-nowrap pointer-events-none">
                        Copied!
                    </span>
                `;

                // Reset after 2 seconds
                setTimeout(() => {
                    copyArticleLinkBtn.innerHTML = originalHTML;
                }, 2000);
            } catch (err) {
                console.error("Failed to copy link:", err);
            }
        });
    }

    // Auto-open notes if requested in URL
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("open_notes") === "true") {
        // Set flag for late hydration
        window.__OPEN_NOTES_REQUESTED = true;

        // Try multiple times to catch hydration
        setTimeout(
            () => window.dispatchEvent(new CustomEvent("open-excalidraw")),
            100,
        );
        setTimeout(
            () => window.dispatchEvent(new CustomEvent("open-excalidraw")),
            1000,
        );
    }

    // Auto-Hide Toolbar when AI Chat is Open
    const toolbarContainer = document.getElementById(
        "reader-toolbar-container",
    );

    if (toolbarContainer) {
        window.addEventListener("ai-chat-state-change", (e) => {
            // Only hide toolbar on mobile where space is limited and they overlap
            const isMobile = window.innerWidth < 768;

            if (e.detail && e.detail.isOpen && isMobile) {
                // Hide toolbar (slide down)
                toolbarContainer.classList.add(
                    "translate-y-[200%]",
                    "opacity-0",
                );
            } else {
                // Show toolbar (slide up) - Always allow showing, or strictly revert
                toolbarContainer.classList.remove(
                    "translate-y-[200%]",
                    "opacity-0",
                );
            }
        });
    }

    // Focus Mode Toggle
    const focusModeToggle = document.getElementById("focus-mode-toggle");
    let focusModeActive = false;

    function toggleFocusMode() {
        focusModeActive = !focusModeActive;
        if (focusModeActive) {
            document.body.classList.add("focus-mode");
            focusModeToggle?.classList.add(
                "text-purple-600",
                "bg-purple-50",
                "dark:bg-purple-900/20",
            );
        } else {
            document.body.classList.remove("focus-mode");
            focusModeToggle?.classList.remove(
                "text-purple-600",
                "bg-purple-50",
                "dark:bg-purple-900/20",
            );
        }
    }

    focusModeToggle?.addEventListener("click", toggleFocusMode);
    document.addEventListener("keydown", (e) => {
        if (
            e.key === "f" &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.shiftKey && 
            document.activeElement.tagName !== "INPUT" &&
            document.activeElement.tagName !== "TEXTAREA" &&
            !document.activeElement.isContentEditable 
        ) {
            e.preventDefault();
            toggleFocusMode();
        }
        if (e.key === "Escape" && focusModeActive) toggleFocusMode();
    });

    // Code Studio Toggle
    const codeEditorToggle = document.getElementById("code-editor-toggle");
    if (codeEditorToggle) {
        codeEditorToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            window.dispatchEvent(
                new CustomEvent("open-code-studio", {
                    detail: {
                        code: "",
                        language: "python", // Default for blank editor
                    },
                }),
            );
        });
    }

    // --- Mobile Dock Event Bridge ---
    window.addEventListener("toggle-toc", () =>
        document.getElementById("toc-toggle")?.click(),
    );
    window.addEventListener("toggle-font-settings", () =>
        document.getElementById("font-toggle")?.click(),
    );
    window.addEventListener("toggle-share", () =>
        document.getElementById("share-toggle")?.click(),
    );
    window.addEventListener("toggle-focus-mode", () =>
        document.getElementById("focus-mode-toggle")?.click(),
    );

    // Like Bridge & Sync
    window.addEventListener("trigger-like", () => {
        const btn = document.getElementById("like-btn");
        if (btn) btn.click();

        // Update Mobile Heart immediately
        const mobileIcon = document.querySelector("#mobile-like-btn svg");
        if (mobileIcon)
            mobileIcon.classList.add("text-red-500", "fill-current");
    });

    // Sync Like Count
    const likeCountSource = document.getElementById("like-count");
    if (likeCountSource) {
        const observer = new MutationObserver(() => {
            const mobileCount = document.getElementById("mobile-like-count");
            if (mobileCount)
                mobileCount.textContent = likeCountSource.textContent;
        });
        observer.observe(likeCountSource, {
            childList: true,
            characterData: true,
            subtree: true,
        });
    }
</script>

