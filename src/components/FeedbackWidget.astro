---

<div
    class="feedback-widget bg-gray-50 dark:bg-gray-800/50 rounded-xl p-6 border border-gray-200 dark:border-gray-700 my-12"
>
    <div class="text-center" id="feedback-initial">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
            Was this article helpful?
        </h3>
        <div class="flex items-center justify-center gap-4">
            <button
                class="feedback-btn flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg hover:border-green-500 hover:text-green-600 dark:hover:text-green-400 transition-all"
                data-value="yes"
            >
                <span class="text-xl">👍</span>
                <span class="font-medium">Yes</span>
            </button>
            <button
                class="feedback-btn flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg hover:border-red-500 hover:text-red-600 dark:hover:text-red-400 transition-all"
                data-value="no"
            >
                <span class="text-xl">👎</span>
                <span class="font-medium">No</span>
            </button>
        </div>
    </div>

    <div class="text-center hidden" id="feedback-success">
        <div class="text-green-500 text-4xl mb-2">🎉</div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
            Thanks for your feedback!
        </h3>
        <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
            We'll use it to improve our content.
        </p>
    </div>
</div>

<script>
    const buttons = document.querySelectorAll(".feedback-btn");
    const initialView = document.getElementById("feedback-initial");
    const successView = document.getElementById("feedback-success");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            // Here you would typically send the feedback to your analytics or backend
            // const value = btn.getAttribute('data-value');
            // sendFeedback(value);

            initialView?.classList.add("hidden");
            successView?.classList.remove("hidden");

            // Reset after a delay (optional)
            // setTimeout(() => {
            //   successView?.classList.add('hidden');
            //   initialView?.classList.remove('hidden');
            // }, 3000);
        });
    });
</script>
