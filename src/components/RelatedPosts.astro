---
import { getCollection } from 'astro:content';
import PostPreview from './PostPreview.astro';

const { currentSlug, tags = [], limit = 3, currentTitle = '' } = Astro.props;

// Get all blog posts
const allPosts = await getCollection('blog');

// Enhanced similarity algorithm for better related posts
function calculateSimilarity(post1Tags: string[], post2Tags: string[], title1: string, title2: string): number {
  // Tag similarity (70% weight)
  const tagIntersection = post1Tags.filter(tag => post2Tags.includes(tag));
  const tagUnion = [...new Set([...post1Tags, ...post2Tags])];
  const tagSimilarity = tagUnion.length > 0 ? tagIntersection.length / tagUnion.length : 0;
  
  // Title similarity (30% weight) - simple word matching
  const words1 = title1.toLowerCase().split(/\s+/);
  const words2 = title2.toLowerCase().split(/\s+/);
  const wordIntersection = words1.filter(word => words2.includes(word));
  const titleSimilarity = Math.max(words1.length, words2.length) > 0 ? 
    wordIntersection.length / Math.max(words1.length, words2.length) : 0;
  
  return (tagSimilarity * 0.7) + (titleSimilarity * 0.3);
}

// Smart related posts selection
const relatedPosts = allPosts
  .filter(post => post.slug !== currentSlug && post.data.published !== false)
  .map(post => ({
    ...post,
    similarity: calculateSimilarity(
      tags, 
      post.data.tags || [], 
      currentTitle,
      post.data.title
    )
  }))
  .sort((a, b) => b.similarity - a.similarity)
  .slice(0, limit);

// Generate structured data for related posts
const relatedPostsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "numberOfItems": relatedPosts.length,
  "itemListElement": relatedPosts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "url": `/blog/${post.slug}`,
      "datePublished": post.data.date,
      "author": {
        "@type": "Person",
        "name": post.data.author || "Rahul Beniwal"
      }
    }
  }))
};
---

<!-- SEO: Related posts structured data -->
{relatedPosts.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(relatedPostsSchema, null, 2)}></script>
)}

{relatedPosts.length > 0 && (
  <section class="mt-16" aria-labelledby="related-posts-heading">
    <h2 id="related-posts-heading" class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400">
      Related Articles
    </h2>
    
    <!-- SEO: Semantic navigation for related content -->
    <nav aria-label="Related articles">
      <div class="grid md:grid-cols-3 gap-8" role="list">
        {relatedPosts.map((post, index) => (
          <article role="listitem" class="group">
            <PostPreview post={post} />
            
            <!-- SEO: Internal linking hints -->
            <div class="mt-4 hidden">
              <p class="text-sm text-gray-500">
                Similarity score: {Math.round(post.similarity * 100)}%
                {post.similarity > 0.5 && ' (Highly relevant)'}
              </p>
            </div>
          </article>
        ))}
      </div>
    </nav>
    
    <!-- SEO: Contextual internal linking -->
    <div class="mt-8 p-4 bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-lg">
      <h3 class="text-lg font-semibold mb-2">Explore More</h3>
      <p class="text-gray-700 dark:text-gray-300 text-sm mb-3">
        Dive deeper into these topics or discover our full collection of articles.
      </p>
      <div class="flex flex-wrap gap-2">
        {[...new Set(tags)].slice(0, 5).map((tag: string) => (
          <a 
            href={`/blog?tag=${encodeURIComponent(tag)}`}
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/50 transition-colors"
            rel="tag"
          >
            #{tag}
          </a>
        ))}
        <a 
          href="/blog"
          class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-600 text-white hover:bg-blue-700 transition-colors"
        >
          View All Posts →
        </a>
      </div>
    </div>
  </section>
)} 