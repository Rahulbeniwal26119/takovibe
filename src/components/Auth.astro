---
import { Image } from "astro:assets";
const apiUrl = import.meta.env.PUBLIC_API_URL;

---

<div class="auth-container">
  <div id="g_id_onload"
    data-client_id={import.meta.env.PUBLIC_GOOGLE_CLIENT_ID}
    data-context="signin"
    data-auto_select="false"
    data-callback="handleGoogleSignIn">
  </div>
  <!-- Option 1: Dark filled circle -->
  <div class="g_id_signin"
    data-type="icon"
    data-shape="circle"
    data-theme="filled_black"
    data-size="large">
  </div>
  
  <!-- Option 2: Outline circle -->
  <!-- <div class="g_id_signin"
    data-type="icon"
    data-shape="circle"
    data-theme="outline"
    data-size="large">
  </div> -->
  
  <!-- Option 3: Dark filled square -->
  <!-- <div class="g_id_signin"
    data-type="icon"
    data-shape="square"
    data-theme="filled_black"
    data-size="large">
  </div> -->

  <!-- User info display when logged in -->
  <div id="userInfo" class="hidden flex items-center space-x-2">
    <img id="userAvatar" src="" alt="Profile" class="w-8 h-8 rounded-full">
    <span id="userName" class="text-sm text-gray-200"></span>
    <button 
      onclick="handleLogout()"
      class="text-sm text-red-500 hover:text-red-600"
    >
      Logout
    </button>
  </div>
</div>

<script define:vars={{ apiUrl }}>
  // Check authentication status on page load
  document.addEventListener('DOMContentLoaded', checkAuthStatus);

  function checkAuthStatus() {
    const token = localStorage.getItem('access_token');
    const user = JSON.parse(localStorage.getItem('user') || 'null');
    
    if (token && user) {
      showUserInfo(user);
    } else {
      showLoginButton();
    }
  }

  function showUserInfo(user) {
    document.querySelector('.g_id_signin').style.display = 'none';
    const userInfo = document.getElementById('userInfo');
    userInfo.classList.remove('hidden');
    document.getElementById('userAvatar').src = user.image;
    document.getElementById('userName').textContent = user.name;
  }

  function showLoginButton() {
    document.querySelector('.g_id_signin').style.display = 'block';
    document.getElementById('userInfo').classList.add('hidden');
  }

  window.handleGoogleSignIn = async (response) => {
    try {
      if (!response.credential) {
        console.error('No credential received');
        return;
      }

      const backendResponse = await fetch(`${apiUrl}/api/users/google-login/`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        credentials: 'include',
        body: JSON.stringify({ 
          token: response.credential 
        })
      });

      if (!backendResponse.ok) {
        throw new Error(`Authentication failed: ${backendResponse.status}`);
      }

      var data = await backendResponse.json();
      data = data.data;

      // Store auth data
      localStorage.setItem('access_token', data.access || data.token);
      localStorage.setItem('refresh_token', data.refresh || data.refresh);
      localStorage.setItem('user', JSON.stringify(data.user || data));

      // Update UI
      showUserInfo(data.user || data);

      // Remove Google Sign-In script to prevent auto-prompt
      const gisScript = document.querySelector('script[src*="gsi/client"]');
      if (gisScript) {
        gisScript.remove();
      }

    } catch (error) {
      console.error('Authentication error:', error);
      showLoginButton();
    }
  };

  window.handleLogout = async () => {
    try {
      // Call backend logout endpoint if you have one
      // await fetch(`${apiUrl}/api/users/logout/`, ...);

      // Clear local storage
      localStorage.removeItem('access_token');
      localStorage.removeItem('refresh_token');
      localStorage.removeItem('user');

      // Update UI
      showLoginButton();

      // Reload to reset Google Sign-In state
      window.location.reload();
    } catch (error) {
      console.error('Logout error:', error);
    }
  };
</script>

<script src="https://accounts.google.com/gsi/client" async defer></script>

<style>
  .auth-container {
    position: relative;
    z-index: 50;
  }

  .hidden {
    display: none !important;
  }
</style> 