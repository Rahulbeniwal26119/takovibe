---
const currentYear = new Date().getFullYear();
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<footer
  class="relative z-20 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/30 dark:to-indigo-900/30 border-t border-blue-200/50 dark:border-blue-700/30"
>
  <!-- Brand Section -->
  <div class="bg-blue-600 dark:bg-blue-800 text-white">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="text-center">
        <h2 class="text-2xl sm:text-3xl font-light mb-3">
          Stay Connected with <span class="font-medium text-white"
            >TakoVibe</span
          >
        </h2>
        <p class="text-blue-50 text-sm sm:text-base max-w-2xl mx-auto">
          Join our community of developers, designers, and tech enthusiasts. Get
          the latest insights, tutorials, and updates delivered to your inbox.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Brand Section -->
      <div class="col-span-1 md:col-span-4">
        <div
          class="bg-white/80 dark:bg-blue-900/50 backdrop-blur-sm rounded-xl p-6 border border-blue-200/50 dark:border-blue-700/30"
        >
          <div class="flex items-center gap-3 mb-4">
            <div
              class="p-2 bg-gradient-to-br from-blue-600/10 to-indigo-600/10 dark:from-blue-500/20 dark:to-indigo-500/20 rounded-lg"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-blue-600 dark:text-blue-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                ></path>
              </svg>
            </div>
            <h2
              class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400"
            >
              TakoVibe
            </h2>
          </div>
          <p
            class="text-blue-800 dark:text-blue-200 mb-6 text-sm leading-relaxed"
          >
            Exploring the depths of software engineering, system design, and
            technology innovations. Join me on this journey of continuous
            learning and discovery.
          </p>
          <div class="flex items-center gap-4">
            <a
              href="https://www.linkedin.com/company/takovibe/"
              class="group flex items-center gap-2 text-blue-700 hover:text-blue-800 dark:text-blue-300 dark:hover:text-blue-200 transition-colors duration-200"
              aria-label="LinkedIn"
            >
              <svg
                class="h-5 w-5 transition-transform group-hover:scale-110"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.27c-.966 0-1.75-.79-1.75-1.75s.784-1.75 1.75-1.75 1.75.79 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.27h-3v-5.6c0-3.37-4-3.12-4 0v5.6h-3v-11h3v1.76c1.4-2.59 7-2.78 7 2.47v6.77z"
                ></path>
              </svg>
              <span class="text-sm font-medium">LinkedIn</span>
            </a>
            <a
              href="https://github.com/orgs/TakoVibe"
              class="group flex items-center gap-2 text-blue-700 hover:text-blue-800 dark:text-blue-300 dark:hover:text-blue-200 transition-colors duration-200"
              aria-label="GitHub"
            >
              <svg
                class="h-5 w-5 transition-transform group-hover:scale-110"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              <span class="text-sm font-medium">GitHub</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Newsletter Section -->
      <div class="col-span-1 md:col-span-8">
        <div
          id="newsletter-wrapper"
          class="bg-gradient-to-br from-blue-100/50 to-indigo-100/50 dark:from-blue-800/20 dark:to-indigo-800/20 backdrop-blur-sm rounded-xl p-8 border border-blue-200/50 dark:border-blue-700/30 shadow-xl"
        >
          <div id="subscribe-form">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2 bg-blue-600/10 dark:bg-blue-500/20 rounded-lg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-blue-600 dark:text-blue-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400"
                >
                  Join the Upcoming Newsletter
                </h3>
                <p class="text-sm text-blue-800 dark:text-blue-200">
                  Get weekly insights and tutorials
                </p>
              </div>
            </div>

            <form class="space-y-4">
              <label for="email-address" class="sr-only">Email address</label>
              <div class="flex flex-col sm:flex-row gap-3">
                <input
                  id="email-address"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  class="flex-1 px-4 py-2.5 bg-white dark:bg-blue-900/50 border border-blue-200/50 dark:border-blue-700/50 rounded-lg shadow-sm placeholder-blue-600 dark:placeholder-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500/50 transition-all duration-200"
                  placeholder="Enter your email address"
                />
                <button
                  type="submit"
                  onclick="toggle_newsletter_subscription(event)"
                  class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 font-medium shadow-lg shadow-blue-500/25 hover:shadow-blue-500/50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-blue-900"
                >
                  Subscribe
                </button>
              </div>
            </form>
          </div>
          <div
            id="unsubscribed-message"
            style="display: none;"
            class="text-center py-2"
          >
            <div
              class="flex items-center justify-center gap-2 text-green-600 dark:text-green-400 mb-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <p class="font-medium">You're subscribed to the newsletter!</p>
            </div>
            <button
              id="unsubscribe-button"
              class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium hover:underline transition-colors duration-200"
            >
              Unsubscribe
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-blue-200/50 dark:border-blue-800/50">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-2">
          <div
            class="h-8 w-8 rounded-full bg-gradient-to-br from-blue-600/20 to-indigo-600/20 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-blue-600 dark:text-blue-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
              ></path>
            </svg>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            © {currentYear}
            <span class="font-bold text-gray-900 dark:text-white">TakoVibe</span
            >
          </p>
        </div>
        <div class="flex items-center gap-6">
          <a
            href="/why-takovibe"
            class="text-sm text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
            >Why Takovibe?</a
          >
          <span class="text-sm text-blue-600 dark:text-blue-400"
            >Made with ❤️ in India</span
          >
        </div>
      </div>
    </div>
  </div>
</footer>
<script define:vars={{ apiUrl }}>
  async function checkSubscription() {
    const emailInput = document.getElementById("email-address");
    const subscribeForm = document.getElementById("subscribe-form");
    const unsubscribeMsg = document.getElementById("unsubscribed-message");

    if (!emailInput || !subscribeForm || !unsubscribeMsg) return;

    let email = null;
    const user_details = localStorage.getItem("user");

    if (user_details) {
      try {
        const user_json = JSON.parse(user_details);
        email = user_json.email;
        if (email && !emailInput.value) {
          emailInput.value = email;
        }
      } catch (e) {
        console.warn("Failed to parse user details", e);
      }
    }

    // Only check server if we have an email
    if (email || emailInput.value) {
      const checkEmail = email || emailInput.value;
      try {
        const url = `${apiUrl}/api/users/newsletter/?email=${encodeURIComponent(checkEmail)}`;
        const response = await fetch(url);
        if (response.ok) {
          const data = await response.json();
          if (data.data && data.data.opt_out === false) {
            // User IS subscribed (opt_out = false)
            // Show 'subscribed' message
            subscribeForm.style.display = "none";
            unsubscribeMsg.style.display = "block";
            return;
          }
        }
      } catch (err) {
        // Silently fail on network error affecting UI only
      }
    }

    // Default: Show form
    subscribeForm.style.display = "block";
    unsubscribeMsg.style.display = "none";
  }

  // Optimize load performance
  const onIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1000));

  document.addEventListener("DOMContentLoaded", () => {
    // Initial UI Setup locally if possible before network
    onIdle(checkSubscription);

    // Attach event listeners efficiently
    const form = document.getElementById("subscribe-form");
    if (form) {
      // Find the specific button or form submit
      const subBtn = form.querySelector('button[type="submit"]');
      if (subBtn) {
        subBtn.onclick = toggle_newsletter_subscription;
      }

      // Prevent default form submission if it happens via enter key
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        toggle_newsletter_subscription(e);
      });
    }

    const unsubBtn = document.getElementById("unsubscribe-button");
    if (unsubBtn) {
      unsubBtn.onclick = async (e) => {
        e.preventDefault();
        await toggle_newsletter_subscription(e);
        // Optionally refresh or just update UI without reload
        checkSubscription();
      };
    }
  });

  // Global function as required by current implementation
  window.toggle_newsletter_subscription = async function (event) {
    if (event) event.preventDefault();

    const emailInput = document.getElementById("email-address");
    if (!emailInput || !emailInput.value) return;

    const email = emailInput.value;
    const url = `${apiUrl}/api/users/newsletter/`;
    const subscribeForm = document.getElementById("subscribe-form");
    const unsubscribeMsg = document.getElementById("unsubscribed-message");

    // Optimistic UI update could go here, but waiting for server is safer for truth
    const btn = event.target;
    const originalText = btn.innerText;
    btn.innerText = "...";
    btn.disabled = true;

    try {
      const response = await fetch(url, {
        method: "POST",
        body: JSON.stringify({ email }),
        headers: { "Content-Type": "application/json" },
      });

      if (response.ok) {
        const data = await response.json();
        const isOptedOut = data.data.opt_out; // True if just UNSUBSCRIBED

        if (isOptedOut) {
          // User just opted out -> Show form to subscribe again
          subscribeForm.style.display = "block";
          unsubscribeMsg.style.display = "none";
        } else {
          // User just subscribed -> Show success message
          subscribeForm.style.display = "none";
          unsubscribeMsg.style.display = "block";
        }
      }
    } catch (e) {
      console.error("Subscription toggle failed", e);
      alert("Something went wrong. Please try again.");
    } finally {
      btn.innerText = originalText;
      btn.disabled = false;
    }
  };
</script>
