---
import { getCollection } from 'astro:content';
const currentYear = new Date().getFullYear();
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand Section -->
      <div class="col-span-1 md:col-span-2">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">TakoVibe</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-md">
          Exploring the depths of software engineering, system design, and technology innovations.
        </p>
        <div class="flex space-x-4">
          <a href="https://linkedin.com/in/rahulbeniwal26119" class="text-gray-400 hover:text-purple-500 dark:hover:text-purple-400">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 
              5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.27c-.966 
              0-1.75-.786-1.75-1.75s.784-1.75 
              1.75-1.75 1.75.786 
              1.75 1.75-.784 1.75-1.75 
              1.75zm13.5 11.27h-3v-5.604c0-1.337-.024-3.064-1.868-3.064-1.869 
              0-2.155 1.46-2.155 2.964v5.703h-3v-10h2.882v1.367h.041c.402-.76 
              1.385-1.56 2.848-1.56 3.046 0 3.614 
              2.005 3.614 4.617v5.595z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="https://github.com/Rahulbeniwal26119" class="text-gray-400 hover:text-purple-500 dark:hover:text-purple-400">
            <span class="sr-only">GitHub</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <!-- <div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-3">
          <li>
            <a href="/about" class="text-gray-600 dark:text-gray-400 hover:text-purple-500 dark:hover:text-purple-400">
              About
            </a>
          </li>
        </ul>
      </div> -->

      <!-- Newsletter Section -->
      <div>
        <div id="subscribe-form">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">Join the upcoming newsletter</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">Subscribe to our upcoming newsletter to stay updated.</p>
          <form class="space-y-3">
            <label for="email-address" class="sr-only">Email address</label>
            <input
              id="email-address"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 dark:bg-gray-800"
              placeholder="Enter your email"
            />
          <button
            type="submit" onclick="toggle_newsletter_subscription(event)"
            class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500"
          >
            Subscribe
            </button>
          </form>
        </div>
        <div id="unsubscribed-message" style="display: none;">
          <p>You are already subscribed to the newsletter.</p>
          <button id="unsubscribe-button" class="text-gray-600 dark:text-gray-400 hover:text-purple-500 dark:hover:text-purple-400">Unsubscribe</button>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
      <p class="text-center text-gray-400 text-sm">
        © {currentYear} TakoVibe. All rights reserved.
      </p>
    </div>
  </div>
</footer>
<script define:vars={{apiUrl}}>

  document.addEventListener("DOMContentLoaded", async () => {
      const email = await get_email();
      document.getElementById('email-address').value = email;
      const opt_out = await get_subscription_status();
      console.log("opt_out", opt_out);
      const form = document.getElementById('subscribe-form');
      form.value = email;
      // stop page be be reload on submit
      document.getElementById('subscribe-form').addEventListener('submit', async function(event) {
        console.log("event", event);
        event.preventDefault();
       });
      if (!opt_out) {
        document.getElementById('subscribe-form').style.display = 'none';
        document.getElementById('unsubscribed-message').style.display = 'block';
      } else {
        const user_details = localStorage.getItem('user') || null;
        if (user_details) {
          const user_details_json = JSON.parse(user_details);
          const email = user_details_json.email;
          const form_email = document.getElementById('email-address').value;
          if (!form_email) {
            // set login email to the form email 
            document.getElementById('email-address').value = email;
          }
        }
      }
    });

   async function get_email() {
    const user_details = localStorage.getItem('user') || null;
    if (user_details) {
      const user_details_json = JSON.parse(user_details);
      return user_details_json.email;
    }
    else {
      return document.getElementById('email-address').value;
    }
   }

  async function get_subscription_status() {
    const email = document.getElementById('email-address').value;
    const url = `${apiUrl}/api/users/newsletter-subscription/` + `?email=${email}`;
    const response = await fetch(url, {
      method: 'GET',
    });
    if (response.ok) {
      const data = await response.json();
      var data_json = data.data;
      return data_json.opt_out;
    }
    return false;
  }

  window.toggle_newsletter_subscription = async function toggle_newsletter_subscription(event) {
    console.log("toggle_newsletter_subscription", event);
    event.preventDefault();
    console.log("event", event);

    const url = `${apiUrl}/api/users/newsletter-subscription/`;
    const email = document.getElementById('email-address').value;

    const response = await fetch(url, {
      method: 'POST',
      body: JSON.stringify({ email: email }),
      headers: {
        'Content-Type': 'application/json',
      },
    });
    if (response.ok) {
      const data = await response.json();
      var data_json = data.data;
      const opt_out = data_json.opt_out;
      if (opt_out) {
        document.getElementById('subscribe-form').style.display = 'block';
        document.getElementById('unsubscribed-message').style.display = 'none';
      } else {
        document.getElementById('subscribe-form').style.display = 'none';
        document.getElementById('unsubscribed-message').style.display = 'block';
      }
      console.log('Newsletter subscription successful');
    } else {
      console.error('Newsletter subscription failed');
    }
  }

  const unsubscribe_button = document.getElementById('unsubscribe-button');
  unsubscribe_button.addEventListener('click', async (event) => {
    event.preventDefault();
    await toggle_newsletter_subscription(event);
    window.location.reload();
  });
</script>


