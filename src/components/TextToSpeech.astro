---

<div
    class="tts-controls flex items-center gap-2 bg-gray-100 dark:bg-gray-800 rounded-full px-3 py-1.5 border border-gray-200 dark:border-gray-700"
>
    <button
        id="tts-play"
        class="p-1.5 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors rounded-full hover:bg-gray-200 dark:hover:bg-gray-700"
        aria-label="Listen to article"
    >
        <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
            ></path>
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
    </button>

    <button
        id="tts-pause"
        class="hidden p-1.5 text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors rounded-full hover:bg-gray-200 dark:hover:bg-gray-700"
        aria-label="Pause"
    >
        <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
    </button>

    <button
        id="tts-stop"
        class="hidden p-1.5 text-gray-600 dark:text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors rounded-full hover:bg-gray-200 dark:hover:bg-gray-700"
        aria-label="Stop"
    >
        <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"
            ></path>
        </svg>
    </button>

    <span
        id="tts-status"
        class="text-xs font-medium text-gray-500 dark:text-gray-400 select-none"
        >Listen</span
    >
</div>

<script>
    let speech = null;
    let isPlaying = false;
    let isPaused = false;

    const playBtn = document.getElementById("tts-play");
    const pauseBtn = document.getElementById("tts-pause");
    const stopBtn = document.getElementById("tts-stop");
    const statusEl = document.getElementById("tts-status");

    function initSpeech() {
        if (!speech) {
            // Get article content - try both lowercase and ID
            const article =
                document.querySelector("article") ||
                document.getElementById("Article");
            if (!article) {
                console.error("TTS: Article element not found");
                return;
            }

            // Clone to avoid modifying the actual DOM
            const clone = article.cloneNode(true);

            // Remove code blocks and other non-readable elements
            clone
                .querySelectorAll("pre, code, .no-tts")
                .forEach((el) => el.remove());

            const text = clone.textContent || "";
            if (!text.trim()) {
                console.error("TTS: No readable text found");
                return;
            }

            speech = new SpeechSynthesisUtterance(text);
            speech.rate = 1.0;
            speech.pitch = 1.0;
            speech.volume = 1.0;

            // Try to select a good voice
            const voices = window.speechSynthesis.getVoices();
            const preferredVoice = voices.find(
                (voice) =>
                    voice.name.includes("Google US English") ||
                    voice.name.includes("Samantha") ||
                    voice.lang === "en-US",
            );

            if (preferredVoice) {
                speech.voice = preferredVoice;
            }

            speech.onend = () => {
                stop();
            };

            speech.onerror = (e) => {
                console.error("TTS Error:", e);
                stop();
            };
        }
    }

    function play() {
        if (!speech) initSpeech();
        if (!speech) return; // Failed to init

        if (isPaused) {
            window.speechSynthesis.resume();
        } else {
            window.speechSynthesis.cancel(); // Stop any previous
            window.speechSynthesis.speak(speech);
        }

        isPlaying = true;
        isPaused = false;
        updateUI();
    }

    function pause() {
        window.speechSynthesis.pause();
        isPlaying = false;
        isPaused = true;
        updateUI();
    }

    function stop() {
        window.speechSynthesis.cancel();
        isPlaying = false;
        isPaused = false;
        updateUI();
    }

    function updateUI() {
        if (isPlaying) {
            playBtn?.classList.add("hidden");
            pauseBtn?.classList.remove("hidden");
            stopBtn?.classList.remove("hidden");
            if (statusEl) statusEl.textContent = "Playing...";
            statusEl?.classList.add("text-purple-600", "dark:text-purple-400");
        } else if (isPaused) {
            playBtn?.classList.remove("hidden");
            pauseBtn?.classList.add("hidden");
            stopBtn?.classList.remove("hidden");
            if (statusEl) statusEl.textContent = "Paused";
            statusEl?.classList.remove(
                "text-purple-600",
                "dark:text-purple-400",
            );
        } else {
            playBtn?.classList.remove("hidden");
            pauseBtn?.classList.add("hidden");
            stopBtn?.classList.add("hidden");
            if (statusEl) statusEl.textContent = "Listen";
            statusEl?.classList.remove(
                "text-purple-600",
                "dark:text-purple-400",
            );
        }
    }

    playBtn?.addEventListener("click", play);
    pauseBtn?.addEventListener("click", pause);
    stopBtn?.addEventListener("click", stop);

    // Initialize voices
    if (window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = () => {
            if (speech) {
                const voices = window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(
                    (voice) =>
                        voice.name.includes("Google US English") ||
                        voice.name.includes("Samantha") ||
                        voice.lang === "en-US",
                );
                if (preferredVoice) speech.voice = preferredVoice;
            }
        };
    }
</script>
