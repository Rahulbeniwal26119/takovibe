---
import Search from "./Search.astro";
import Auth from "./Auth.astro";
import LiveIndicator from "./LiveIndicator.astro";
---

<header
  class="fixed top-0 w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur z-50 border-b border-gray-200 dark:border-gray-800"
>
  <nav
    class="h-14 max-w-6xl mx-auto px-4 flex justify-between items-center"
  >
    <div class="flex items-center gap-3 min-w-0 flex-1">
      <a
        href="/"
        class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors flex-shrink-0"
      >
        <img 
          src="/images/logo.svg" 
          alt="Tako Vibe Logo" 
          class="w-10 h-10 rounded-full"
        />
      </a>
      
      <!-- Live Indicator for RAG Series -->
      <div class="flex-shrink-0">
        <LiveIndicator 
          seriesName="30-Days-to-RAG"
          message="Series is LIVE! New posts every day"
          href="/series/30-days-to-rag"
        />
      </div>
    </div>
    <div class="flex items-center space-x-4">
      <Auth />
      <a
        href="/about"
        class="text-gray-600 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
        aria-label="About Rahul Beniwal - Software Developer and Blog Author"
      >
        <span class="hidden md:inline">About</span>
        <svg class="w-6 h-6 md:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </a>
      <div class="w-px h-5 bg-gray-200 dark:bg-gray-700"></div>
      <Search />
    </div>
  </nav>
</header> 