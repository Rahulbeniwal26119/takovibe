---
import Search from "./SearchBar.astro";
import UserAuth from "./UserAuth.tsx";

// Get current path for active navigation
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/categories", label: "Categories" },
  { href: "/series", label: "Series" },
  { href: "/saved", label: "Saved" },
  { href: "/contact", label: "Contact" },
];
---

<header
  id="site-header"
  class="sticky top-0 z-[70] w-full transition-all duration-300"
>
  <div
    class="backdrop-blur-2xl border-b border-gray-200/30 dark:border-gray-800/30 bg-white/80 dark:bg-slate-900/80 supports-[backdrop-filter]:bg-white/60 dark:supports-[backdrop-filter]:bg-slate-900/60"
  >
    <div
      class="max-w-[1400px] mx-auto h-16 lg:h-20 px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4"
    >
      <!-- Left: Logo & Mobile Toggle -->
      <div class="flex items-center gap-4 shrink-0">
        <!-- Mobile drawer button -->
        <button
          id="openDrawerBtn"
          aria-label="Open menu"
          class="lg:hidden w-10 h-10 grid place-items-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <a
          href="/"
          class="flex items-center gap-3 group"
          aria-label="TakoVibe home"
        >
          <div class="relative">
            <div
              class="absolute inset-0 bg-purple-500/20 rounded-full blur-md group-hover:bg-purple-500/30 transition-colors"
            >
            </div>
            <img
              src="/images/logo.svg"
              alt="TakoVibe logo"
              class="relative w-9 h-9 lg:w-10 lg:h-10 rounded-full shadow-sm group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <span
            class="hidden sm:block font-bold text-xl tracking-tight text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors"
          >
            TakoVibe
          </span>
        </a>
      </div>

      <!-- Center: Navigation (Desktop) -->
      <nav class="hidden lg:flex flex-1 items-center justify-center gap-2 px-4">
        <a
          href="/"
          class={`px-5 py-2.5 rounded-full text-base font-medium transition-all duration-200 whitespace-nowrap ${
            currentPath === "/"
              ? "bg-purple-50 dark:bg-purple-900/10 text-purple-600 dark:text-purple-400"
              : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50"
          }`}
        >
          Home
        </a>
        <a
          href="/blog"
          class={`px-5 py-2.5 rounded-full text-base font-medium transition-all duration-200 whitespace-nowrap ${
            currentPath.startsWith("/blog")
              ? "bg-purple-50 dark:bg-purple-900/10 text-purple-600 dark:text-purple-400"
              : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50"
          }`}
        >
          Blog
        </a>

        <!-- Write for Us CTA -->
        <a
          href="/post/new"
          class="flex items-center gap-2 px-5 py-2.5 rounded-full text-base font-medium transition-all duration-200 whitespace-nowrap text-gray-600 dark:text-gray-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-purple-50 dark:hover:bg-purple-900/10 group"
        >
          <svg
            class="w-4 h-4 text-purple-500 group-hover:scale-110 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
            ></path></svg
          >
          Write with Us
        </a>

        <!-- More Dropdown -->
        <div class="relative group">
          <button
            class="flex items-center gap-1 px-5 py-2.5 rounded-full text-base font-medium transition-all duration-200 whitespace-nowrap text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50"
          >
            More
            <svg
              class="w-4 h-4 transition-transform group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </button>

          <!-- Dropdown Menu -->
          <div
            class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 w-48"
          >
            <div
              class="bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-800 overflow-hidden p-1"
            >
              <a
                href="/about"
                class="block px-4 py-2 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
              >
                About
              </a>
              <a
                href="/categories"
                class="block px-4 py-2 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
              >
                Categories
              </a>
              <a
                href="/series"
                class="block px-4 py-2 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
              >
                Series
              </a>
              <a
                href="/saved"
                class="block px-4 py-2 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
              >
                Saved
              </a>
              <div class="h-px bg-gray-100 dark:bg-gray-800 my-1"></div>
              <a
                href="/contact"
                class="block px-4 py-2 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
              >
                Contact
              </a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Right: Search & Auth -->
      <div class="flex items-center gap-1 sm:gap-2 shrink-0">
        <!-- Write Button (Mobile) -->
        <a
          href="/post/new"
          class="lg:hidden w-10 h-10 grid place-items-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors"
          aria-label="Write with us"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
            ></path>
          </svg>
        </a>

        <!-- Desktop Search -->
        <div class="hidden xl:block w-64">
          <Search variant="header" />
        </div>

        <!-- Mobile Search Toggle (Visible only on Large screens where drawer is hidden but desktop search is also hidden) -->
        <button
          id="mobileSearchBtn"
          class="hidden lg:block xl:hidden w-10 h-10 grid place-items-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors"
          aria-label="Open search"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Theme Toggle -->
        <button
          id="global-theme-toggle"
          class="w-10 h-10 grid place-items-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors"
          aria-label="Toggle theme"
        >
          <!-- Sun Icon -->
          <svg
            class="w-5 h-5 hidden dark:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <!-- Moon Icon -->
          <svg
            class="w-5 h-5 block dark:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <div class="h-6 w-px bg-gray-200 dark:bg-gray-800 hidden sm:block">
        </div>

        <div class="auth-wrapper" onclick="event.stopPropagation();">
          <UserAuth client:only="react" />
        </div>
      </div>
    </div>
  </div>

  <!-- MOBILE DRAWER -->
  <div
    id="drawerBackdrop"
    class="fixed inset-0 z-[65] bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  >
  </div>

  <aside
    id="drawer"
    class="fixed left-0 top-0 z-[66] w-[85vw] max-w-[320px] h-full -translate-x-full transition-transform duration-300 cubic-bezier(0.4, 0, 0.2, 1)
           bg-white dark:bg-[#0f1117] border-r border-gray-200 dark:border-gray-800 flex flex-col shadow-2xl"
    aria-label="Mobile menu"
  >
    <!-- Drawer Header -->
    <div
      class="h-20 px-6 flex items-center justify-between border-b border-gray-100 dark:border-gray-800/50"
    >
      <div class="flex items-center gap-3">
        <img src="/images/logo.svg" alt="Logo" class="w-8 h-8 rounded-full" />
        <span class="font-bold text-lg text-gray-900 dark:text-white">Menu</span
        >
      </div>
      <button
        id="closeDrawerBtn"
        aria-label="Close menu"
        class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 dark:text-gray-400 transition-colors"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile Search (if not on blog page) -->
    <div class="p-4" id="mobile-search-section">
      {
        Astro.url.pathname !== "/blog" && (
          <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-1">
            <Search variant="mobile" />
          </div>
        )
      }
    </div>

    <!-- Drawer Nav -->
    <nav class="flex-1 overflow-y-auto px-4 py-2 space-y-1">
      {
        navItems.map((item) => {
          const isActive =
            item.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-colors ${
                isActive
                  ? "bg-purple-50 dark:bg-purple-900/10 text-purple-600 dark:text-purple-400"
                  : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800/50 hover:text-gray-900 dark:hover:text-white"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }

      <!-- Mobile Auth Links -->
      <div
        id="mobile-auth-links"
        class="pt-4 mt-4 border-t border-gray-100 dark:border-gray-800/50 space-y-2 hidden"
      >
        <a
          href="/login"
          class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800/50 hover:text-gray-900 dark:hover:text-white transition-colors"
        >
          Log in
        </a>
        <a
          href="/signup"
          class="flex items-center justify-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-white bg-purple-600 hover:bg-purple-700 transition-colors shadow-sm shadow-purple-500/20"
        >
          Sign up
        </a>
      </div>

      <!-- Mobile User Profile (Hidden by default) -->
      <div
        id="mobile-user-profile"
        class="pt-4 mt-4 border-t border-gray-100 dark:border-gray-800/50 hidden"
      >
        <div class="flex items-center gap-3 px-4 mb-4">
          <img
            id="mobile-user-avatar"
            src=""
            alt="User"
            class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700"
          />
          <div>
            <div
              id="mobile-user-name"
              class="font-medium text-gray-900 dark:text-white"
            >
            </div>
            <div
              id="mobile-user-email"
              class="text-xs text-gray-500 dark:text-gray-400"
            >
            </div>
          </div>
        </div>
        <button
          id="mobile-logout-btn"
          class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          Log out
        </button>
      </div>

      <!-- Drawer Footer -->
      <div class="p-4 border-t border-gray-100 dark:border-gray-800/50">
        <div class="flex items-center justify-center gap-4 text-gray-400">
          <a
            href="#"
            class="hover:text-purple-500 transition-colors"
            aria-label="Twitter"
            ><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"
              ></path></svg
            ></a
          >
          <a
            href="#"
            class="hover:text-purple-500 transition-colors"
            aria-label="GitHub"
            ><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 0c-6.626 0-12 5.373-12 12 0 3.368 1.376 6.391 3.6 8.613 2.222 2.222 5.245 3.6 8.613 3.6 3.362 0 6.38-1.372 8.6-3.594 2.22-2.22 3.594-5.238 3.594-8.6 0-6.627-5.373-12-12-12zm0 21.6c-5.298 0-9.6-4.302-9.6-9.6s4.302-9.6 9.6-9.6 9.6 4.302 9.6 9.6-4.302 9.6-9.6 9.6z"
              ></path></svg
            ></a
          >
        </div>
      </div>
    </nav>

    <!-- MOBILE SEARCH OVERLAY -->
    <div
      id="mobileSearchOverlay"
      class="fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 lg:hidden"
    >
      <div class="flex items-start justify-center pt-24 px-4">
        <div
          id="mobileSearchModal"
          class="w-full max-w-lg bg-white dark:bg-[#1a1d26] rounded-2xl shadow-2xl transform scale-95 transition-all duration-300 border border-gray-200 dark:border-gray-800"
        >
          <div
            class="p-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between"
          >
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              Search
            </h3>
            <button
              id="closeMobileSearchBtn"
              class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 transition-colors"
              aria-label="Close search"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="p-4">
            {Astro.url.pathname !== "/blog" && <Search variant="modal" />}
          </div>
        </div>
      </div>
    </div>
  </aside>

  <script is:inline>
    (function () {
      function initThemeToggle() {
        const themeToggleBtn = document.getElementById("global-theme-toggle");

        if (themeToggleBtn) {
          // Remove existing listeners to prevent duplicates if any
          const newBtn = themeToggleBtn.cloneNode(true);
          themeToggleBtn.parentNode.replaceChild(newBtn, themeToggleBtn);

          newBtn.addEventListener("click", async (e) => {
            // Fallback for browsers that don't support View Transitions
            if (!document.startViewTransition) {
              document.documentElement.classList.toggle("dark");
              localStorage.theme = document.documentElement.classList.contains(
                "dark",
              )
                ? "dark"
                : "light";
              return;
            }

            // Get click coordinates
            const x = e.clientX;
            const y = e.clientY;

            // Calculate radius to cover the screen
            const endRadius = Math.hypot(
              Math.max(x, innerWidth - x),
              Math.max(y, innerHeight - y),
            );

            // Start the transition
            const transition = document.startViewTransition(() => {
              document.documentElement.classList.toggle("dark");
              localStorage.theme = document.documentElement.classList.contains(
                "dark",
              )
                ? "dark"
                : "light";
            });

            // Wait for the pseudo-elements to be created
            await transition.ready;

            // Animate the clip-path
            const clipPath = [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`,
            ];

            document.documentElement.animate(
              {
                clipPath: document.documentElement.classList.contains("dark")
                  ? [...clipPath].reverse()
                  : clipPath,
              },
              {
                duration: 500,
                easing: "ease-in",
                pseudoElement: document.documentElement.classList.contains(
                  "dark",
                )
                  ? "::view-transition-old(root)"
                  : "::view-transition-new(root)",
              },
            );
          });
        }
      }

      // Run on initial load
      initThemeToggle();

      // Re-run on view transitions if applicable
      document.addEventListener("astro:page-load", initThemeToggle);
      document.addEventListener("DOMContentLoaded", initThemeToggle);
    })();
  </script>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const drawer = document.querySelector("#drawer");
      const backdrop = document.querySelector("#drawerBackdrop");
      const openBtn = document.querySelector("#openDrawerBtn");
      const closeBtn = document.querySelector("#closeDrawerBtn");
      const header = document.getElementById("site-header");

      // Mobile search elements
      const mobileSearchBtn = document.querySelector("#mobileSearchBtn");
      const mobileSearchOverlay = document.querySelector(
        "#mobileSearchOverlay",
      );
      const mobileSearchModal = document.querySelector("#mobileSearchModal");
      const closeMobileSearchBtn = document.querySelector(
        "#closeMobileSearchBtn",
      );

      function openDrawer() {
        drawer?.classList.remove("-translate-x-full");
        backdrop?.classList.remove("pointer-events-none", "opacity-0");
        backdrop?.classList.add("opacity-100");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        drawer?.classList.add("-translate-x-full");
        backdrop?.classList.add("pointer-events-none", "opacity-0");
        backdrop?.classList.remove("opacity-100");
        document.body.style.overflow = "";
      }

      function openMobileSearch() {
        mobileSearchOverlay?.classList.remove(
          "pointer-events-none",
          "opacity-0",
        );
        mobileSearchModal?.classList.remove("scale-95");
        mobileSearchModal?.classList.add("scale-100");
        document.body.style.overflow = "hidden";

        setTimeout(() => {
          const searchInput = document.querySelector("#modal-search-input");
          if (searchInput) searchInput.focus();
        }, 300);
      }

      function closeMobileSearch() {
        mobileSearchOverlay?.classList.add("pointer-events-none", "opacity-0");
        mobileSearchModal?.classList.remove("scale-100");
        mobileSearchModal?.classList.add("scale-95");
        document.body.style.overflow = "";
      }

      // Event Listeners
      openBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        openDrawer();
      });

      closeBtn?.addEventListener("click", closeDrawer);
      backdrop?.addEventListener("click", closeDrawer);

      mobileSearchBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        openMobileSearch();
      });

      closeMobileSearchBtn?.addEventListener("click", closeMobileSearch);
      mobileSearchOverlay?.addEventListener("click", (e) => {
        if (e.target === mobileSearchOverlay) closeMobileSearch();
      });

      // Close on Escape
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeDrawer();
          closeMobileSearch();
        }
      });

      // Scroll Behavior
      let lastScrollY = window.scrollY;
      let isScrollingDown = false;

      window.addEventListener(
        "scroll",
        () => {
          if (window.innerWidth < 1024) return; // Only on desktop

          const currentScrollY = window.scrollY;

          if (currentScrollY > lastScrollY && currentScrollY > 100) {
            if (!isScrollingDown) {
              header.style.transform = "translateY(-100%)";
              isScrollingDown = true;
            }
          } else {
            if (isScrollingDown) {
              header.style.transform = "translateY(0)";
              isScrollingDown = false;
            }
          }
          lastScrollY = currentScrollY;
        },
        { passive: true },
      );

      // Check auth status for mobile menu
      const checkMobileAuth = () => {
        const userStr = localStorage.getItem("user");
        const mobileAuthLinks = document.getElementById("mobile-auth-links");

        const mobileUserProfile = document.getElementById(
          "mobile-user-profile",
        );
        const mobileUserName = document.getElementById("mobile-user-name");
        const mobileUserEmail = document.getElementById("mobile-user-email");
        const mobileUserAvatar = document.getElementById("mobile-user-avatar");

        if (userStr) {
          // User is logged in
          try {
            const user = JSON.parse(userStr);
            if (mobileAuthLinks) mobileAuthLinks.classList.add("hidden");

            if (mobileUserProfile) mobileUserProfile.classList.remove("hidden");

            if (mobileUserName) mobileUserName.textContent = user.name;
            if (mobileUserEmail) mobileUserEmail.textContent = user.email;
            if (mobileUserAvatar) {
              if (!user.image) {
                const safeName = user.name || "User";
                const initial = safeName.charAt(0).toUpperCase();
                // Simple random color generator based on name
                const colors = [
                  "#EF5350",
                  "#EC407A",
                  "#AB47BC",
                  "#7E57C2",
                  "#5C6BC0",
                  "#42A5F5",
                ];
                const color = colors[safeName.charCodeAt(0) % colors.length];
                const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="${color}"/><text x="50" y="50" dy=".35em" fill="white" font-family="Arial" font-size="40" text-anchor="middle">${initial}</text></svg>`;
                const base64 = btoa(unescape(encodeURIComponent(svg)));
                mobileUserAvatar.src = `data:image/svg+xml;base64,${base64}`;
              } else {
                mobileUserAvatar.src = user.image;
              }
            }
          } catch (e) {
            console.error("Error parsing user data", e);
            localStorage.removeItem("user");
          }
        } else {
          // User is logged out
          if (mobileAuthLinks) mobileAuthLinks.classList.remove("hidden");

          if (mobileUserProfile) mobileUserProfile.classList.add("hidden");
        }
      };

      // Logout handler
      const mobileLogoutBtn = document.getElementById("mobile-logout-btn");
      mobileLogoutBtn?.addEventListener("click", () => {
        localStorage.removeItem("access_token");
        localStorage.removeItem("refresh_token");
        localStorage.removeItem("user");
        window.location.href = "/";
      });

      checkMobileAuth();
      // Re-check when drawer opens
      openBtn?.addEventListener("click", checkMobileAuth);
    });
  </script>

  <style>
    /* Ensure content isn't hidden behind fixed header */
    :global(body) {
      padding-top: 0; /* Reset */
    }

    /* Add padding to main content wrapper instead if needed, 
     but sticky header usually sits on top. 
     If using fixed, we need padding. 
     Here we use sticky, so it takes space in flow. */
  </style>
</header>
