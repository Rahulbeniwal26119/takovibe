---
import Search from "./SearchBar.astro";
import Auth from "./Auth.astro";
import LiveIndicator from "./LiveIndicator.astro";

// Get current path for active navigation
const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 z-[70] bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-[#1a1325] dark:via-[#0f172a] dark:to-[#111827] backdrop-blur-md"
>
  <!-- ROW 1: chrome bar -->
  <div
    class="bg-white/80 dark:bg-gray-900/80 backdrop-blur border-b border-gray-200/70 dark:border-gray-800/70"
  >
    <div
      class="max-w-screen-2xl mx-auto h-12 md:h-14 grid grid-cols-[auto_1fr_auto] items-center gap-2 px-3 md:px-6"
    >
      <!-- Left cluster: menu + logo -->
      <div class="flex items-center gap-3">
        <!-- Mobile drawer button -->
        <button
          id="openDrawerBtn"
          aria-label="Open menu"
          class="md:hidden w-10 h-10 grid place-items-center rounded-xl border border-black/10 dark:border-white/10 text-gray-800 dark:text-gray-200"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 6h18M3 12h18M3 18h18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </button>

        <a
          href="/"
          class="shrink-0 hover:opacity-90 transition"
          aria-label="TakoVibe home"
        >
          <img
            src="/images/logo.svg"
            alt="TakoVibe logo"
            class="w-10 h-10 rounded-full"
          />
        </a>
        <div class="block shrink-0">
          <LiveIndicator
            seriesName="Rag Mastery"
            message="Series is LIVE! New posts every day"
            href="/series/rag-mastery"
          />
        </div>
      </div>

      <!-- Center cell (kept empty so grid guarantees space distribution) -->
      <div class="min-w-0"></div>

      <!-- Right cluster: search + auth (never shrinks on desktop) -->
      <div class="flex items-center gap-3">
        <!-- Desktop search bar - visible when mobile menu is hidden -->
        <div class="w-[280px]" id="header-search-container">
          <Search variant="header" />
        </div>

        <!-- Mobile search icon - visible on mobile -->
        <button
          id="mobileSearchBtn"
          class="w-10 h-10 grid place-items-center"
          aria-label="Open search"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
        </button>
        <div class="auth-wrapper" onclick="event.stopPropagation();">
          <Auth />
        </div>
      </div>
    </div>
  </div>

  <!-- ROW 2: primary navigation - hidden on mobile, visible on large screens -->
  <div
    class="lg:block bg-transparent border-b border-gray-200/20 dark:border-gray-800/20"
    id='header-nav-container'
  >
      <div class="max-w-screen-2xl mx-auto px-3 lg:px-6 flex">
        <!-- Primary links (simple & transparent) -->
        <nav class="flex items-center justify-around w-full" aria-label="Primary" role="navigation">
          <a
            href="/"
            class={`nav-link relative px-4 py-2 rounded-xl text-sm font-semibold ${
              currentPath === "/"
                ? "text-purple-700 dark:text-purple-300 bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-purple-900/40 dark:via-blue-900/40 dark:to-indigo-900/40 border border-purple-300/60 dark:border-purple-400/50 shadow-md"
                : "text-gray-700 dark:text-gray-300 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-gradient-to-br hover:from-purple-50/60 hover:via-blue-50/60 hover:to-indigo-50/60 dark:hover:from-purple-900/20 dark:hover:via-blue-900/20 dark:hover:to-indigo-900/20 hover:border hover:border-purple-300/30 dark:hover:border-purple-400/20"
            }`}
          >
            Home
          </a>
      
          <a
            href="/blog"
            class={`nav-link relative px-4 py-2 rounded-xl text-sm font-semibold ${
              currentPath.startsWith("/blog")
                ? "text-purple-700 dark:text-purple-300 bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-purple-900/40 dark:via-blue-900/40 dark:to-indigo-900/40 border border-purple-300/60 dark:border-purple-400/50 shadow-md"
                : "text-gray-700 dark:text-gray-300 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-gradient-to-br hover:from-purple-50/60 hover:via-blue-50/60 hover:to-indigo-50/60 dark:hover:from-purple-900/20 dark:hover:via-blue-900/20 dark:hover:to-indigo-900/20 hover:border hover:border-purple-300/30 dark:hover:border-purple-400/20"
            }`}
          >
          </div>
        </a>
        <a
          href="/ai"
          class={`nav-link group relative px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-300 ease-out ${
            currentPath.startsWith("/ai")
              ? "text-emerald-700 dark:text-emerald-300 bg-gradient-to-br from-emerald-50 via-cyan-50 to-blue-50 dark:from-emerald-900/40 dark:via-cyan-900/40 dark:to-blue-900/40 border-2 border-emerald-300/60 dark:border-emerald-400/50 shadow-lg shadow-emerald-100 dark:shadow-emerald-900/20 scale-105"
              : "text-gray-700 dark:text-gray-300 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-gradient-to-br hover:from-emerald-50/80 hover:via-cyan-50/80 hover:to-blue-50/80 dark:hover:from-emerald-900/30 dark:hover:via-cyan-900/30 dark:hover:to-blue-900/30 hover:border-2 hover:border-emerald-300/40 dark:hover:border-emerald-400/30 hover:shadow-lg hover:shadow-emerald-100/50 dark:hover:shadow-emerald-900/10 hover:scale-105"
          }`}
        >
          <span class="flex items-center gap-1">
            🤖 AI Insights
          </span>
          <div
            class="absolute inset-x-0 -bottom-1 h-1 bg-gradient-to-r from-emerald-600 via-cyan-600 to-blue-600 rounded-full transform origin-center scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"
          >
          </div>
        </a>
        <a
          href="/about"
          class={`nav-link group relative px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-300 ease-out ${
            currentPath === "/about"
              ? "text-purple-700 dark:text-purple-300 bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-purple-900/40 dark:via-blue-900/40 dark:to-indigo-900/40 border-2 border-purple-300/60 dark:border-purple-400/50 shadow-lg shadow-purple-100 dark:shadow-purple-900/20 scale-105"
              : "text-gray-700 dark:text-gray-300 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-gradient-to-br hover:from-purple-50/80 hover:via-blue-50/80 hover:to-indigo-50/80 dark:hover:from-purple-900/30 dark:hover:via-blue-900/30 dark:hover:to-indigo-900/30 hover:border-2 hover:border-purple-300/40 dark:hover:border-purple-400/30 hover:shadow-lg hover:shadow-purple-100/50 dark:hover:shadow-purple-900/10 hover:scale-105"
          }`}
        >
          About
          <div
            class="absolute inset-x-0 -bottom-1 h-1 bg-gradient-to-r from-purple-600 via-blue-600 to-indigo-600 rounded-full transform origin-center scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"
          >
            About
          </a>
      
          <a
            href="/categories"
            class={`nav-link relative px-4 py-2 rounded-xl text-sm font-semibold ${
              currentPath === "/categories"
                ? "text-purple-700 dark:text-purple-300 bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-purple-900/40 dark:via-blue-900/40 dark:to-indigo-900/40 border border-purple-300/60 dark:border-purple-400/50 shadow-md"
                : "text-gray-700 dark:text-gray-300 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-gradient-to-br hover:from-purple-50/60 hover:via-blue-50/60 hover:to-indigo-50/60 dark:hover:from-purple-900/20 dark:hover:via-blue-900/20 dark:hover:to-indigo-900/20 hover:border hover:border-purple-300/30 dark:hover:border-purple-400/20"
            }`}
          >
            Categories
          </a>
      
          <a
            href="/series"
            class={`nav-link relative px-4 py-2 rounded-xl text-sm font-semibold ${
              currentPath.startsWith("/series")
                ? "text-purple-700 dark:text-purple-300 bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-purple-900/40 dark:via-blue-900/40 dark:to-indigo-900/40 border border-purple-300/60 dark:border-purple-400/50 shadow-md"
                : "text-gray-700 dark:text-gray-300 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-gradient-to-br hover:from-purple-50/60 hover:via-blue-50/60 hover:to-indigo-50/60 dark:hover:from-purple-900/20 dark:hover:via-blue-900/20 dark:hover:to-indigo-900/20 hover:border hover:border-purple-300/30 dark:hover:border-purple-400/20"
            }`}
          >
            Series
          </a>
      
          <a
            href="/contact"
            class={`nav-link relative px-4 py-2 rounded-xl text-sm font-semibold ${
              currentPath === "/contact"
                ? "text-purple-700 dark:text-purple-300 bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-50 dark:from-purple-900/40 dark:via-blue-900/40 dark:to-indigo-900/40 border border-purple-300/60 dark:border-purple-400/50 shadow-md"
                : "text-gray-700 dark:text-gray-300 hover:text-purple-700 dark:hover:text-purple-300 hover:bg-gradient-to-br hover:from-purple-50/60 hover:via-blue-50/60 hover:to-indigo-50/60 dark:hover:from-purple-900/20 dark:hover:via-blue-900/20 dark:hover:to-indigo-900/20 hover:border hover:border-purple-300/30 dark:hover:border-purple-400/20"
            }`}
          >
            Contact
          </a>
        </nav>
      </div>

  </div>

  <!-- MOBILE DRAWER -->
  <div
    id="drawerBackdrop"
    class="fixed inset-0 z-[65] bg-black/40 opacity-0 pointer-events-none transition-opacity duration-200"
  >
  </div>

  <aside
    id="drawer"
    class="fixed left-0 top-0 z-[66] w-[86vw] max-w-[360px] -translate-x-full transition-transform duration-200
                bg-white dark:bg-gray-900 border-r border-gray-200 dark:border-gray-800 p-3 md:hidden"
    aria-label="Mobile menu"
    aria-hidden="true"
  >
    <div class="h-12 flex items-center">
      <button
        id="closeDrawerBtn"
        aria-label="Close menu"
        class="w-10 h-10 grid place-items-center rounded-xl border border-black/10 dark:border-white/10 text-gray-800 dark:text-gray-200"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <strong class="ml-2">Menu</strong>
    </div>

    <!-- Mobile Search Section -->
    <div class="mt-4 mb-4" id="mobile-search-section">
      {
        Astro.url.pathname !== "/blog" && (
          <div class="p-3 bg-gray-50 dark:bg-gray-800 rounded-xl">
            <Search variant="mobile" />
          </div>
        )
      }
    </div>

    <nav class="mt-2 space-y-1 text-gray-800 dark:text-gray-200">
      <a
        href="/"
        class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5"
        >Home</a
      >
      <a
        href="/blog"
        class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5"
        >Blog</a
      >
      <a
        href="/ai"
        class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5"
        ><span>🤖</span> AI Insights</a
      >
      <a
        href="/about"
        class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5"
        >About</a
      >
      <a
        href="/categories"
        class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5"
        >Categories</a
      >
      <a
        href="/series"
        class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5"
        >Series</a
      >
      <a
        href="/contact"
        class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5"
        >Contact</a
      >
    </nav>
  </aside>

  <!-- MOBILE SEARCH OVERLAY -->
  <div
    id="mobileSearchOverlay"
    class="fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 lg:hidden"
  >
    <div class="flex items-start justify-center pt-20 px-4">
      <div
        id="mobileSearchModal"
        class="w-full max-w-lg bg-white dark:bg-gray-900 rounded-2xl shadow-2xl transform scale-95 transition-transform duration-300"
      >
        <div class="p-4 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              Search
            </h3>
            <button
              id="closeMobileSearchBtn"
              class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
              aria-label="Close search"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M18 6L6 18M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="p-4">
          {Astro.url.pathname !== "/blog" && <Search variant="modal" />}
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Drawer toggling and mobile search -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const drawer = document.querySelector("#drawer");
    const backdrop = document.querySelector("#drawerBackdrop");
    const openBtn = document.querySelector("#openDrawerBtn");
    const closeBtn = document.querySelector("#closeDrawerBtn");

    // Mobile search elements
    const mobileSearchBtn = document.querySelector("#mobileSearchBtn");
    const mobileSearchOverlay = document.querySelector("#mobileSearchOverlay");
    const mobileSearchModal = document.querySelector("#mobileSearchModal");
    const closeMobileSearchBtn = document.querySelector(
      "#closeMobileSearchBtn",
    );

    function openDrawer() {
      drawer?.classList.remove("-translate-x-full");
      backdrop?.classList.remove("pointer-events-none", "opacity-0");
      backdrop?.classList.add("opacity-100"); // Add this line to make backdrop visible
    }

    function closeDrawer() {
      drawer?.classList.add("-translate-x-full");
      backdrop?.classList.add("pointer-events-none", "opacity-0");
      backdrop?.classList.remove("opacity-100"); // Add this line to hide backdrop
    }

    function openMobileSearch() {
      mobileSearchOverlay?.classList.remove("pointer-events-none", "opacity-0");
      mobileSearchModal?.classList.remove("scale-95");
      mobileSearchModal?.classList.add("scale-100");

      // Focus the search input after animation
      setTimeout(() => {
        const searchInput = document.querySelector("#modal-search-input");
        if (searchInput) {
          searchInput.focus();
        }
      }, 300);
    }

    function closeMobileSearch() {
      mobileSearchOverlay?.classList.add("pointer-events-none", "opacity-0");
      mobileSearchModal?.classList.remove("scale-100");
      mobileSearchModal?.classList.add("scale-95");
    }

    // Drawer functionality
    openBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      openDrawer();
    });

    closeBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeDrawer();
    });

    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) {
        closeDrawer();
      }
    });

    // Mobile search functionality
    mobileSearchBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      openMobileSearch();
    });

    closeMobileSearchBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeMobileSearch();
    });

    mobileSearchOverlay?.addEventListener("click", (e) => {
      if (e.target === mobileSearchOverlay) {
        closeMobileSearch();
      }
    });

    // Close on Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeDrawer();
        closeMobileSearch();
      }
    });

    // Prevent header clicks from opening drawer
    const header = document.querySelector("#site-header");
    header?.addEventListener("click", (e) => {
      if (!e.target?.closest("#openDrawerBtn")) {
        e.stopPropagation();
      }
    });

    // Enhanced navigation interactions
    const navLinks = document.querySelectorAll(".nav-link");
    navLinks.forEach((link) => {
      // Add keyboard support
      link.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          link.click();
        }
      });

      // Add focus styles
      link.addEventListener("focus", () => {
        link.classList.add(
          "ring-2",
          "ring-purple-500/50",
          "ring-offset-2",
          "dark:ring-offset-gray-900",
        );
      });

      link.addEventListener("blur", () => {
        link.classList.remove(
          "ring-2",
          "ring-purple-500/50",
          "ring-offset-2",
          "dark:ring-offset-gray-900",
        );
      });
    });
  });

  // Handle mobile navigation visibility
  document.addEventListener("DOMContentLoaded", () => {
    const openDrawerBtn = document.getElementById("openDrawerBtn");
    const navSection = document.querySelector(
      'nav[aria-label="Primary"]',
    ).parentElement;

    let isNavVisible = window.innerWidth >= 768;

    function updateNavVisibility() {
      if (window.innerWidth >= 768) {
        navSection.style.display = "block";
        isNavVisible = true;
      } else {
        navSection.style.display = isNavVisible ? "block" : "none";
      }
    }

    // Initial visibility
    updateNavVisibility();

    // Toggle nav on mobile
    openDrawerBtn?.addEventListener("click", () => {
      isNavVisible = !isNavVisible;
      updateNavVisibility();
    });

    // Update on resize
    window.addEventListener("resize", () => {
      updateNavVisibility();
    });
  });
</script>

<style>
  /* Enhanced navigation styles */
  .nav-link {
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(12px);
    transform-origin: center;
    will-change: transform;
  }

  .nav-link::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(139, 92, 246, 0.15),
      rgba(59, 130, 246, 0.1),
      transparent
    );
    transition: left 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::before {
    left: 100%;
  }

  .nav-link:active {
    transform: scale(0.95);
  }

  /* Enhanced active state styling */
  .nav-link.scale-105 {
    transform: scale(1.05);
    box-shadow: 0 8px 25px -8px rgba(139, 92, 246, 0.3);
  }

  /* Improved hover animations */
  .nav-link:hover {
    transform: translateY(-2px) scale(1.05);
  }

  /* Smooth scrolling for navigation overflow */
  nav[aria-label="Primary"] {
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  nav[aria-label="Primary"]::-webkit-scrollbar {
    display: none;
  }

  /* Enhance backdrop blur */
  .backdrop-blur-xl {
    backdrop-filter: blur(24px);
  }

  /* Enhanced shadow for active nav items */
  .nav-link.bg-gradient-to-br {
    box-shadow:
      0 4px 20px -4px rgba(139, 92, 246, 0.3),
      0 2px 8px -2px rgba(59, 130, 246, 0.2);
  }

  /* Mobile drawer enhanced animations */
  @media (max-width: 767px) {
    .nav-link {
      margin-bottom: 0.125rem;
    }
  }

  /* Smooth color transitions for theme switching */
  * {
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }
</style>

<style>
  /* Add body padding to account for fixed header */
  :global(body) {
    padding-top: calc(
      48px + 36px
    ); /* Mobile: 48px (h-12) + 36px (navigation row) */
  }

  @media (min-width: 768px) {
    :global(body) {
      padding-top: calc(
        56px + 40px
      ); /* Desktop: 56px (h-14) + 40px (navigation row) */
    }
  }

  /* Ensure header has consistent height */
  @media (min-width: 768px) {
    #site-header {
      height: calc(56px + 40px); /* Desktop total height */
    }
  }

  /* Smooth header transition */
  #site-header {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Header hide/show animation - only for desktop */
  @media (min-width: 768px) {
    #site-header.header-hidden {
      transform: translateY(-100%);
    }

    #site-header.header-visible {
      transform: translateY(0);
    }
  }

  /* Hide on small screens (<768px), show on medium and up */
  #header-search-container {
    display: none;
  }

  @media (min-width: 768px) {
    #header-search-container {
      display: block !important;
    }
  }

  @media (min-width: 768px) {
    #header-nav-container {
      display: block !important;
    }
  }

  @media (max-width: 767px) {
    #header-nav-container {
      display: none !important;
    }
  }

  /* Show on small screens, hide on medium and up */
  #mobileSearchBtn {
    display: block;
  }

  @media (min-width: 768px) {
    #mobileSearchBtn {
      display: none !important;
    }
  }
</style>

<!-- Scroll Direction Detection Script -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    let lastScrollY = window.scrollY;
    let isScrollingDown = false;
    let scrollTimeout;
    const header = document.getElementById("site-header");

    // Only apply scroll behavior on desktop
    function handleScroll() {
      // Only apply this behavior on desktop (md breakpoint and above)
      if (window.innerWidth < 768) {
        header?.classList.remove("header-hidden", "header-visible");
        return;
      }

      const currentScrollY = window.scrollY;
      const scrollDifference = currentScrollY - lastScrollY;

      // Only trigger if scrolled more than 5px to avoid small scroll jitters
      if (Math.abs(scrollDifference) > 5) {
        if (scrollDifference > 0) {
          // Scrolling down - hide header
          if (!isScrollingDown) {
            isScrollingDown = true;
            header?.classList.add("header-hidden");
            header?.classList.remove("header-visible");
          }
        } else {
          // Scrolling up - show header
          if (isScrollingDown) {
            isScrollingDown = false;
            header?.classList.add("header-visible");
            header?.classList.remove("header-hidden");
          }
        }

        lastScrollY = currentScrollY;
      }

      // Clear timeout and set a new one
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        // If at the top of the page, always show header
        if (currentScrollY <= 10) {
          isScrollingDown = false;
          header?.classList.add("header-visible");
          header?.classList.remove("header-hidden");
        }
      }, 150);
    }

    // Add scroll event listener with throttling
    let ticking = false;

    function requestTick() {
      if (!ticking) {
        requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", requestTick, { passive: true });

    // Handle window resize to reset header state
    window.addEventListener("resize", () => {
      if (window.innerWidth < 768) {
        // Reset header state on mobile
        header?.classList.remove("header-hidden", "header-visible");
        isScrollingDown = false;
      } else {
        // Initialize proper state on desktop
        if (window.scrollY <= 10) {
          header?.classList.add("header-visible");
          header?.classList.remove("header-hidden");
        }
      }
    });

    // Initialize header state
    if (window.innerWidth >= 768) {
      header?.classList.add("header-visible");
    }
  });
</script>
