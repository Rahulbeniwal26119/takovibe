---
import Search from "./SearchBar.astro";
import UserAuth from "./UserAuth.tsx";

// Get current path for active navigation
const currentPath = Astro.url.pathname;

const mainNav = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/series", label: "Series" },
  { href: "/notes", label: "Notes" },
];

const toolsNav = [
  { href: "/playground", label: "Playground", description: "Run and share code snippets" },
  { href: "https://codediff.takovibe.com/", label: "CodeDiff", description: "Compare code and review patches" },
  { href: "https://resumevibe.takovibe.com/", label: "ResumeVibe", description: "Audit and optimize your resume" },
  { href: "/notes", label: "Sketch Notes", description: "Capture visual thinking while reading" },
];

const moreNav = [
  { href: "/about", label: "About" },
  { href: "/saved", label: "Saved" },
  { href: "/why-takovibe", label: "Why TakoVibe?" },
  { href: "/changelog", label: "Changelog" },
  { href: "/contact", label: "Contact" },
];

const mobileNav = [...mainNav, ...toolsNav, ...moreNav];

const isActivePath = (href: string) =>
  href === "/" ? currentPath === "/" : href.startsWith("/") && currentPath.startsWith(href);

const hasActiveMoreItem = moreNav.some((item) => isActivePath(item.href));
const hasActiveToolItem = toolsNav.some((item) => isActivePath(item.href));
---

<header
  id="site-header"
  class="sticky top-0 z-[70] w-full transition-all duration-300 backdrop-blur-lg bg-neutral-50/80 dark:bg-neutral-950/80 border-b border-neutral-200/50 dark:border-neutral-800/50"
>
  <div class="max-w-[1400px] mx-auto h-14 lg:h-16 px-4 sm:px-6 lg:px-8 relative">
    <div class="flex items-center justify-between h-full gap-4">
      <!-- Left: Logo & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <button
          id="openDrawerBtn"
          aria-label="Open menu"
          class="lg:hidden w-10 h-10 flex items-center justify-center rounded-xl hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-300"
        >
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <a href="/" class="flex items-center gap-3 group">
          <img src="/images/logo.svg" alt="TakoVibe" class="w-8 h-8 lg:w-9 lg:h-9 rounded-full hover:rotate-12 transition-transform duration-500" />
          <span class="font-bold text-xl tracking-tight text-neutral-900 dark:text-neutral-50 hidden sm:block">
            TakoVibe
          </span>
        </a>
      </div>

      <!-- Center: Desktop Navigation -->
      <nav class="hidden lg:flex flex-1 items-center justify-center gap-2">
        {mainNav.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-2 text-sm font-semibold rounded-full transition-all duration-300 whitespace-nowrap ${
              isActivePath(item.href)
                ? "text-orange-600 dark:text-orange-400 bg-neutral-50 dark:bg-neutral-800/20"
                : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-50 hover:bg-neutral-100/50 dark:hover:bg-neutral-800/[0.03]"
            }`}
          >
            {item.label}
          </a>
        ))}

        <div class="relative">
          <button
            id="desktop-tools-btn"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            class={`px-4 py-2 text-sm font-semibold rounded-full transition-all duration-300 whitespace-nowrap inline-flex items-center gap-1.5 ${
              hasActiveToolItem
                ? "text-orange-600 dark:text-orange-400 bg-neutral-50 dark:bg-neutral-800/20"
                : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-50 hover:bg-neutral-100/50 dark:hover:bg-neutral-800/[0.03]"
            }`}
          >
            Tools
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <div
            id="desktop-tools-menu"
            role="menu"
            class="absolute left-1/2 top-full mt-3 hidden w-72 -translate-x-1/2 overflow-hidden rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/95 dark:bg-neutral-950/95 shadow-xl shadow-neutral-900/10 dark:shadow-black/30 backdrop-blur-xl p-2"
          >
            {toolsNav.map((item) => (
              <a
                href={item.href}
                role="menuitem"
                class="block rounded-xl px-4 py-3 transition-colors text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800/50 hover:text-neutral-900 dark:hover:text-neutral-50"
              >
                <span class="block text-sm font-bold">{item.label}</span>
                <span class="mt-0.5 block text-xs text-neutral-500 dark:text-neutral-500">{item.description}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="relative">
          <button
            id="desktop-more-btn"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            class={`px-4 py-2 text-sm font-semibold rounded-full transition-all duration-300 whitespace-nowrap inline-flex items-center gap-1.5 ${
              hasActiveMoreItem
                ? "text-orange-600 dark:text-orange-400 bg-neutral-50 dark:bg-neutral-800/20"
                : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-50 hover:bg-neutral-100/50 dark:hover:bg-neutral-800/[0.03]"
            }`}
          >
            More
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <div
            id="desktop-more-menu"
            role="menu"
            class="absolute left-1/2 top-full mt-3 hidden w-56 -translate-x-1/2 overflow-hidden rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/95 dark:bg-neutral-950/95 shadow-xl shadow-neutral-900/10 dark:shadow-black/30 backdrop-blur-xl p-2"
          >
            {moreNav.map((item) => (
              <a
                href={item.href}
                role="menuitem"
                class={`block rounded-xl px-4 py-3 text-sm font-medium transition-colors ${
                  isActivePath(item.href)
                    ? "bg-orange-50 dark:bg-orange-900/10 text-orange-600 dark:text-orange-400"
                    : "text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800/50 hover:text-neutral-900 dark:hover:text-neutral-50"
                }`}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- Right: Actions -->
      <div class="flex items-center gap-3">
        <button
          id="searchTriggerBtn"
          class="hidden xl:flex items-center gap-2 w-44 px-4 py-2 bg-neutral-100/50 dark:bg-neutral-800/50 hover:bg-neutral-200 dark:hover:bg-neutral-700/50 text-neutral-500 dark:text-neutral-400 rounded-xl transition-all text-sm"
          aria-label="Search"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Search...</span>
          <kbd class="ml-auto text-xs bg-neutral-200 dark:bg-neutral-700 px-1.5 py-0.5 rounded font-mono">⌘K</kbd>
        </button>

        <button
          id="mobileSearchBtn"
          class="xl:hidden w-10 h-10 flex items-center justify-center rounded-xl hover:bg-neutral-100/50 dark:hover:bg-neutral-800/50 text-neutral-600 dark:text-neutral-400 transition-colors"
          aria-label="Search"
        >
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <div class="h-6 w-px bg-neutral-300/50 dark:bg-neutral-600/50 hidden sm:block"></div>

        <a
          href="/post/new"
          class="hidden xl:flex items-center gap-2 px-5 py-2 rounded-full text-sm font-bold text-white bg-orange-500 hover:bg-orange-600 transition-all duration-300 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Write
        </a>

        <button
          id="global-theme-toggle"
          class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-neutral-100/50 dark:hover:bg-neutral-800/50 text-neutral-600 dark:text-neutral-400 transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>

        <UserAuth client:only="react">
          <div slot="fallback" class="w-9 h-9 rounded-full bg-neutral-200 dark:bg-neutral-700 animate-pulse"></div>
        </UserAuth>
      </div>
    </div>

    <!-- Full Header Search Bar -->
    <div
      id="full-header-search"
      class="absolute inset-0 flex items-center px-4 sm:px-6 lg:px-8 bg-neutral-50 dark:bg-neutral-950 opacity-0 pointer-events-none transition-all duration-300 scale-95"
    >
      <div class="w-full max-w-4xl mx-auto flex items-center gap-4">
        <div class="flex-1">
          <Search variant="full-header" />
        </div>
        <button
          id="closeFullSearchBtn"
          class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-500 transition-colors"
          aria-label="Close search"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- MOBILE DRAWER -->
<div
  id="drawerBackdrop"
  class="fixed inset-0 z-[65] bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<aside
  id="drawer"
  class="fixed left-0 top-0 z-[66] w-[85vw] max-w-[320px] h-full -translate-x-full transition-transform duration-300 cubic-bezier(0.4, 0, 0.2, 1)
           bg-neutral-50 dark:bg-neutral-950 border-r border-neutral-200 dark:border-neutral-800 flex flex-col shadow-2xl"
  aria-label="Mobile menu"
>
  <!-- Drawer Header -->
  <div
    class="h-20 px-6 flex items-center justify-between border-b border-neutral-100 dark:border-neutral-800/50"
  >
    <div class="flex items-center gap-3">
      <img src="/images/logo.svg" alt="Logo" class="w-8 h-8 rounded-full" />
      <span class="font-bold text-lg text-neutral-900 dark:text-neutral-50">Menu</span>
    </div>
    <button
      id="closeDrawerBtn"
      aria-label="Close menu"
      class="p-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-500 dark:text-neutral-400 transition-colors"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!--
    <a href="/community" class="block px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800/50 hover:text-gray-900 dark:hover:text-white transition-colors">
      Community
    </a>
    -->

<!-- Drawer Nav -->
<nav class="flex-1 overflow-y-auto px-4 py-2 space-y-1">
  {mobileNav.map((item) => (
    <a
      href={item.href}
      class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-colors ${
        (item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href))
          ? "bg-orange-50 dark:bg-orange-900/10 text-orange-600 dark:text-orange-400"
          : "text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800/50 hover:text-neutral-900 dark:hover:text-neutral-50"
      }`}
    >
      {item.label}
    </a>
  ))}

    <!-- Mobile Auth Links -->
    <div
      id="mobile-auth-links"
      class="pt-4 mt-4 border-t border-neutral-100 dark:border-neutral-800/50 space-y-2 hidden"
    >
      <a
        href="/login"
        class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800/50 hover:text-neutral-900 dark:hover:text-neutral-50 transition-colors"
      >
        Log in
      </a>
      <a
        href="/signup"
        class="flex items-center justify-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-neutral-50 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 transition-colors shadow-sm shadow-orange-500/20"
      >
        Sign up
      </a>
    </div>

    <!-- Mobile User Profile (Hidden by default) -->
    <div
      id="mobile-user-profile"
      class="pt-4 mt-4 border-t border-neutral-100 dark:border-neutral-800/50 hidden"
    >
      <div class="flex items-center gap-3 px-4 mb-4">
        <img
          id="mobile-user-avatar"
          src=""
          alt="User"
          class="w-10 h-10 rounded-full border border-neutral-200 dark:border-neutral-700"
        />
        <div>
          <div
            id="mobile-user-name"
            class="font-medium text-neutral-900 dark:text-neutral-50"
          >
          </div>
          <div
            id="mobile-user-email"
            class="text-xs text-neutral-500 dark:text-neutral-400"
          >
          </div>
        </div>
      </div>
      <button
        id="mobile-logout-btn"
        class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Log out
      </button>
    </div>
  </nav>
</aside>

<script is:inline>
  (function () {
    function initThemeToggle() {
      const themeToggleBtn = document.getElementById("global-theme-toggle");

      if (themeToggleBtn) {
        // Remove existing listeners to prevent duplicates if any
        const newBtn = themeToggleBtn.cloneNode(true);
        themeToggleBtn.parentNode.replaceChild(newBtn, themeToggleBtn);

        const toggleTheme = () => {
          document.documentElement.classList.toggle("dark");
          localStorage.theme = document.documentElement.classList.contains(
            "dark",
          )
            ? "dark"
            : "light";
        };

        newBtn.addEventListener("click", async (e) => {
          const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          const isCompactScreen = window.matchMedia("(max-width: 767px)").matches;

          if (newBtn.dataset.transitioning === "true") return;

          // The full-page view transition is expensive on small screens and can flicker.
          if (
            !document.startViewTransition ||
            prefersReducedMotion ||
            isCompactScreen
          ) {
            toggleTheme();
            return;
          }

          newBtn.dataset.transitioning = "true";

          // Get click coordinates
          const x = e.clientX;
          const y = e.clientY;

          // Calculate radius to cover the screen
          const endRadius = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y),
          );

          // Start the transition
          const transition = document.startViewTransition(toggleTheme);

          // Wait for the pseudo-elements to be created
          try {
            await transition.ready;
          } catch (error) {
            newBtn.dataset.transitioning = "false";
            return;
          }

          // Animate the clip-path
          const clipPath = [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ];

          document.documentElement.animate(
            {
              clipPath: document.documentElement.classList.contains("dark")
                ? [...clipPath].reverse()
                : clipPath,
            },
            {
              duration: 280,
              easing: "ease-out",
              pseudoElement: document.documentElement.classList.contains("dark")
                ? "::view-transition-old(root)"
                : "::view-transition-new(root)",
            },
          );

          transition.finished.finally(() => {
            newBtn.dataset.transitioning = "false";
          });
        });
      }
    }

    // Run on initial load
    initThemeToggle();

    // Re-run on view transitions if applicable
    document.addEventListener("astro:page-load", initThemeToggle);
    document.addEventListener("DOMContentLoaded", initThemeToggle);
  })();
</script>

<script is:inline>
  function initHeaderScripts() {
    // Elements
    const header = document.getElementById("site-header");
    const drawer = document.querySelector("#drawer");
    const backdrop = document.querySelector("#drawerBackdrop");
    const openBtn = document.querySelector("#openDrawerBtn");
    const closeBtn = document.querySelector("#closeDrawerBtn");
    const desktopToolsBtn = document.getElementById("desktop-tools-btn");
    const desktopToolsMenu = document.getElementById("desktop-tools-menu");
    const desktopMoreBtn = document.getElementById("desktop-more-btn");
    const desktopMoreMenu = document.getElementById("desktop-more-menu");

    // Search elements
    const searchTriggerBtn = document.getElementById("searchTriggerBtn");
    const mobileSearchBtn = document.getElementById("mobileSearchBtn"); // Navbar icon
    const mobileMenuSearchBtn = document.getElementById("mobileMenuSearchBtn"); // Drawer button
    const searchOverlay = document.getElementById("searchOverlay");
    const searchModal = document.getElementById("searchModal");
    const closeSearchBtn = document.getElementById("closeSearchBtn");
    const modalInput = document.getElementById("modal-search-input");

    // Move overlay to body to avoid clipping by header transform
    if (searchOverlay && searchOverlay.parentNode !== document.body) {
      document.body.appendChild(searchOverlay);
    }

    function openDrawer() {
      drawer?.classList.remove("-translate-x-full");
      backdrop?.classList.remove("pointer-events-none", "opacity-0");
      backdrop?.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      drawer?.classList.add("-translate-x-full");
      backdrop?.classList.add("pointer-events-none", "opacity-0");
      backdrop?.classList.remove("opacity-100");
      document.body.style.overflow = "";
    }

    function closeDesktopMore() {
      desktopMoreMenu?.classList.add("hidden");
      desktopMoreBtn?.setAttribute("aria-expanded", "false");
      desktopMoreBtn?.querySelector("svg")?.classList.remove("rotate-180");
    }

    function closeDesktopTools() {
      desktopToolsMenu?.classList.add("hidden");
      desktopToolsBtn?.setAttribute("aria-expanded", "false");
      desktopToolsBtn?.querySelector("svg")?.classList.remove("rotate-180");
    }

    function toggleDesktopTools() {
      if (!desktopToolsMenu || !desktopToolsBtn) return;

      const isOpen = !desktopToolsMenu.classList.contains("hidden");
      desktopToolsMenu.classList.toggle("hidden", isOpen);
      desktopToolsBtn.setAttribute("aria-expanded", String(!isOpen));
      desktopToolsBtn.querySelector("svg")?.classList.toggle("rotate-180", !isOpen);
      if (!isOpen) closeDesktopMore();
    }

    function toggleDesktopMore() {
      if (!desktopMoreMenu || !desktopMoreBtn) return;

      const isOpen = !desktopMoreMenu.classList.contains("hidden");
      desktopMoreMenu.classList.toggle("hidden", isOpen);
      desktopMoreBtn.setAttribute("aria-expanded", String(!isOpen));
      desktopMoreBtn.querySelector("svg")?.classList.toggle("rotate-180", !isOpen);
      if (!isOpen) closeDesktopTools();
    }

    function openSearch() {
      const searchInput = document.getElementById("full-header-search-input");
      const searchTriggerBtn = document.getElementById("searchTriggerBtn");
      const header = document.getElementById("site-header");

      if (!header) return;

      searchTriggerBtn.style.visibility = "hidden";
      header.querySelector("nav")?.classList.add("hidden");
      header.querySelector(".flex.items-center.gap-3:last-child")?.classList.add("hidden");

      const fullSearch = document.getElementById("full-header-search");
      if (fullSearch) {
        fullSearch.classList.remove("opacity-0", "pointer-events-none", "scale-95");
        fullSearch.classList.add("opacity-100", "scale-100");
      }

      closeDrawer();

      setTimeout(() => {
        if (searchInput) searchInput.focus();
      }, 100);
    }

    function closeSearch() {
      const searchTriggerBtn = document.getElementById("searchTriggerBtn");
      const header = document.getElementById("site-header");

      if (searchTriggerBtn) searchTriggerBtn.style.visibility = "";
      header?.querySelector("nav")?.classList.remove("hidden");
      header?.querySelector(".flex.items-center.gap-3:last-child")?.classList.remove("hidden");

      const fullSearch = document.getElementById("full-header-search");
      if (fullSearch) {
        fullSearch.classList.remove("opacity-100", "scale-100");
        fullSearch.classList.add("opacity-0", "pointer-events-none", "scale-95");
      }
    }

    // Event Listeners (remove old ones to prevent duplicates if any)
    // Note: In Astro, it's safer to just add them as the elements are fresh on page logic

    openBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openDrawer();
    });

    closeBtn?.addEventListener("click", closeDrawer);
    backdrop?.addEventListener("click", closeDrawer);

    desktopMoreBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDesktopMore();
    });

    desktopToolsBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDesktopTools();
    });

    // Search Triggers
    searchTriggerBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openSearch();
    });

    mobileSearchBtn?.addEventListener("click", (e) => {
      openSearch();
    });

    mobileMenuSearchBtn?.addEventListener("click", (e) => {
      openSearch();
    });

    document.addEventListener("click", (e) => {
      const target = e.target;
      // Close on X button click
      if (target.closest("#closeFullSearchBtn")) {
        e.preventDefault();
        e.stopPropagation();
        closeSearch();
      }

      if (
        desktopMoreMenu &&
        desktopMoreBtn &&
        !desktopMoreMenu.contains(target) &&
        !desktopMoreBtn.contains(target)
      ) {
        closeDesktopMore();
      }

      if (
        desktopToolsMenu &&
        desktopToolsBtn &&
        !desktopToolsMenu.contains(target) &&
        !desktopToolsBtn.contains(target)
      ) {
        closeDesktopTools();
      }

      // Close if clicking outside header when search is open
      const header = document.getElementById("site-header");
      const fullSearch = document.getElementById("full-header-search");
      if (
        fullSearch &&
        !fullSearch.classList.contains("opacity-0") &&
        !header.contains(target)
      ) {
        closeSearch();
      }
    });

    // Close on Escape
    const handleKeydown = (e) => {
      if (e.key === "Escape") {
        closeDrawer();
        closeSearch();
        closeDesktopMore();
        closeDesktopTools();
      }

      if ((e.metaKey || e.ctrlKey) && e.key === "/") {
        e.preventDefault();
        openSearch();
      }
    };

    // Remove previous listener to avoid duplicates if re-running
    window.removeEventListener("keydown", handleKeydown);
    // But passing the same function reference is hard with inline closure.
    // Better to just add it. If page reloads, window is fresh-ish or we rely on Astro cleaning.
    // Actually, relying on cleaner cleanup is better.
    window.addEventListener("keydown", handleKeydown);

     // Scroll Behavior for Floating Header
     let ticking = false;
     const onScroll = () => {
       if (!ticking) {
         window.requestAnimationFrame(() => {
           const header = document.getElementById("site-header");
           const headerContent = header?.querySelector("div"); // The inner background div
           if (!header || !headerContent) {
             ticking = false;
             return;
           }

           const currentScrollY = window.scrollY;

           if (currentScrollY > 20) {
             // Scrolled State: Floating Island
             // Only add classes if not already present to minimize DOM touches
             if (!header.classList.contains("py-2")) {
               header.classList.add("py-2");
               headerContent.classList.remove("w-full");
               headerContent.classList.add(
                 "max-w-[1400px]",
                 "mx-auto",
                 "rounded-2xl",
                 "shadow-lg",
                 "border",
                 "border-neutral-200",
                 "dark:border-neutral-800",
                 "bg-neutral-50/90",
                 "dark:bg-neutral-950/90",
                 "backdrop-blur-xl"
               );
               headerContent.classList.remove(
                 "bg-neutral-50/80",
                 "dark:bg-neutral-950/80",
                 "border-b",
                 "border-neutral-200/10",
                 "dark:border-neutral-800/10"
               );
             }
           } else {
             // Top State: Full Width
             if (header.classList.contains("py-2")) {
               header.classList.remove("py-2");
               headerContent.classList.add("w-full");
               headerContent.classList.remove(
                 "max-w-[1400px]",
                 "mx-auto",
                 "rounded-2xl",
                 "shadow-lg",
                 "border",
                 "border-neutral-200",
                 "dark:border-neutral-800",
                 "bg-neutral-50/90",
                 "dark:bg-neutral-950/90",
                 "backdrop-blur-xl"
               );
               headerContent.classList.add(
                 "bg-neutral-50/80",
                 "dark:bg-neutral-950/80",
                 "border-b",
                 "border-neutral-200/10",
                 "dark:border-neutral-800/10"
               );
             }
           }
           ticking = false;
         });
         ticking = true;
       }
     };

    window.addEventListener("scroll", onScroll, { passive: true });
    // Trigger once on load
    onScroll();

    // Check auth status for mobile menu
    const checkMobileAuth = () => {
      const userStr = localStorage.getItem("user");
      const mobileAuthLinks = document.getElementById("mobile-auth-links");

      const mobileUserProfile = document.getElementById("mobile-user-profile");
      const mobileUserName = document.getElementById("mobile-user-name");
      const mobileUserEmail = document.getElementById("mobile-user-email");
      const mobileUserAvatar = document.getElementById("mobile-user-avatar");

      if (userStr) {
        // User is logged in
        try {
          const user = JSON.parse(userStr);
          if (mobileAuthLinks) mobileAuthLinks.classList.add("hidden");

          if (mobileUserProfile) mobileUserProfile.classList.remove("hidden");

          if (mobileUserName) mobileUserName.textContent = user.name;
          if (mobileUserEmail) mobileUserEmail.textContent = user.email;
          if (mobileUserAvatar) {
            if (!user.image) {
              const safeName = user.name || "User";
              const initial = safeName.charAt(0).toUpperCase();
              // Simple random color generator based on name
              const colors = [
                "#f97316",
                "#f59e0b",
                "#eab308",
                "#84cc16",
                "#22c55e",
                "#14b8a6",
                "#06b6d4",
                "#0ea5e9",
                "#6366f1",
                "#8b5cf6",
              ];
              const color = colors[safeName.charCodeAt(0) % colors.length];
              const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="${color}"/><text x="50" y="50" dy=".35em" fill="white" font-family="Arial" font-size="40" text-anchor="middle">${initial}</text></svg>`;
              const base64 = btoa(unescape(encodeURIComponent(svg)));
              mobileUserAvatar.src = `data:image/svg+xml;base64,${base64}`;
            } else {
              mobileUserAvatar.src = user.image;
            }
          }
        } catch (e) {
          console.error("Error parsing user data", e);
          localStorage.removeItem("user");
        }
      } else {
        // User is logged out
        if (mobileAuthLinks) mobileAuthLinks.classList.remove("hidden");

        if (mobileUserProfile) mobileUserProfile.classList.add("hidden");
      }
    };

    // Logout handler
    const mobileLogoutBtn = document.getElementById("mobile-logout-btn");
    mobileLogoutBtn?.addEventListener("click", () => {
      localStorage.removeItem("access_token");
      localStorage.removeItem("refresh_token");
      localStorage.removeItem("user");
      window.location.href = "/";
    });

    checkMobileAuth();
    // Re-check when drawer opens
    openBtn?.addEventListener("click", checkMobileAuth);
  }

  // Run on initial load and view transitions
  document.addEventListener("DOMContentLoaded", initHeaderScripts);
  document.addEventListener("astro:page-load", initHeaderScripts);
</script>

<style>
  /* Ensure content isn't hidden behind fixed header */
  :global(body) {
    padding-top: 0; /* Reset */
  }

  /* Add padding to main content wrapper instead if needed, 
     but sticky header usually sits on top. 
     If using fixed, we need padding. 
     Here we use sticky, so it takes space in flow. */
</style>
