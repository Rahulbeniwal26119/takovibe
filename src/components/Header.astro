---
import Search from "./SearchBar.astro";
import Auth from "./Auth.astro";
import LiveIndicator from "./LiveIndicator.astro";

// Get current path for active navigation
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/categories", label: "Categories" },
  { href: "/series", label: "Series" },
  { href: "/contact", label: "Contact" },
];
---

<header
  id="site-header"
  class="sticky top-0 z-[70] w-full transition-all duration-300"
>
  <div
    class="backdrop-blur-2xl border-b border-gray-200/30 dark:border-gray-800/30 bg-white/80 dark:bg-slate-900/80 supports-[backdrop-filter]:bg-white/60 dark:supports-[backdrop-filter]:bg-slate-900/60"
  >
    <div
      class="max-w-[1400px] mx-auto h-16 lg:h-20 px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4"
    >
      <!-- Left: Logo & Mobile Toggle -->
      <div class="flex items-center gap-4 shrink-0">
        <!-- Mobile drawer button -->
        <button
          id="openDrawerBtn"
          aria-label="Open menu"
          class="lg:hidden w-10 h-10 grid place-items-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <a
          href="/"
          class="flex items-center gap-3 group"
          aria-label="TakoVibe home"
        >
          <div class="relative">
            <div
              class="absolute inset-0 bg-purple-500/20 rounded-full blur-md group-hover:bg-purple-500/30 transition-colors"
            >
            </div>
            <img
              src="/images/logo.svg"
              alt="TakoVibe logo"
              class="relative w-9 h-9 lg:w-10 lg:h-10 rounded-full shadow-sm group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <span
            class="hidden sm:block font-bold text-xl tracking-tight text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors"
          >
            TakoVibe
          </span>
        </a>

        <div class="hidden xl:block ml-2">
          <LiveIndicator
            seriesName="ML Fundamentals"
            message="Live"
            href="/series/machine-learning-fundamentals/"
          />
        </div>
      </div>

      <!-- Center: Navigation (Desktop) -->
      <nav
        class="hidden lg:flex items-center justify-center gap-1 absolute left-1/2 -translate-x-1/2"
      >
        {
          navItems.map((item) => {
            const isActive =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class={`px-5 py-2.5 rounded-full text-base font-medium transition-all duration-200 ${
                  isActive
                    ? "bg-purple-50 dark:bg-purple-900/10 text-purple-600 dark:text-purple-400"
                    : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50"
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Right: Search & Auth -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Desktop Search -->
        <div class="hidden md:block w-64 xl:w-72">
          <Search variant="header" />
        </div>

        <!-- Mobile Search Toggle -->
        <button
          id="mobileSearchBtn"
          class="md:hidden w-10 h-10 grid place-items-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors"
          aria-label="Open search"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <div class="h-6 w-px bg-gray-200 dark:bg-gray-800 hidden sm:block">
        </div>

        <div class="auth-wrapper" onclick="event.stopPropagation();">
          <Auth />
        </div>
      </div>
    </div>
  </div>

  <!-- MOBILE DRAWER -->
  <div
    id="drawerBackdrop"
    class="fixed inset-0 z-[65] bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  >
  </div>

  <aside
    id="drawer"
    class="fixed left-0 top-0 z-[66] w-[85vw] max-w-[320px] h-full -translate-x-full transition-transform duration-300 cubic-bezier(0.4, 0, 0.2, 1)
           bg-white dark:bg-[#0f1117] border-r border-gray-200 dark:border-gray-800 flex flex-col shadow-2xl"
    aria-label="Mobile menu"
  >
    <!-- Drawer Header -->
    <div
      class="h-20 px-6 flex items-center justify-between border-b border-gray-100 dark:border-gray-800/50"
    >
      <div class="flex items-center gap-3">
        <img src="/images/logo.svg" alt="Logo" class="w-8 h-8 rounded-full" />
        <span class="font-bold text-lg text-gray-900 dark:text-white">Menu</span
        >
      </div>
      <button
        id="closeDrawerBtn"
        aria-label="Close menu"
        class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 dark:text-gray-400 transition-colors"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile Search (if not on blog page) -->
    <div class="p-4" id="mobile-search-section">
      {
        Astro.url.pathname !== "/blog" && (
          <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-1">
            <Search variant="mobile" />
          </div>
        )
      }
    </div>

    <!-- Drawer Nav -->
    <nav class="flex-1 overflow-y-auto px-4 py-2 space-y-1">
      {
        navItems.map((item) => {
          const isActive =
            item.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-colors ${
                isActive
                  ? "bg-purple-50 dark:bg-purple-900/10 text-purple-600 dark:text-purple-400"
                  : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800/50 hover:text-gray-900 dark:hover:text-white"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Drawer Footer -->
    <div class="p-4 border-t border-gray-100 dark:border-gray-800/50">
      <div class="flex items-center justify-center gap-4 text-gray-400">
        <a href="#" class="hover:text-purple-500 transition-colors"
          ><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"
            ></path></svg
          ></a
        >
        <a href="#" class="hover:text-purple-500 transition-colors"
          ><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 3.368 1.376 6.391 3.6 8.613 2.222 2.222 5.245 3.6 8.613 3.6 3.362 0 6.38-1.372 8.6-3.594 2.22-2.22 3.594-5.238 3.594-8.6 0-6.627-5.373-12-12-12zm0 21.6c-5.298 0-9.6-4.302-9.6-9.6s4.302-9.6 9.6-9.6 9.6 4.302 9.6 9.6-4.302 9.6-9.6 9.6z"
            ></path></svg
          ></a
        >
      </div>
    </div>
  </aside>

  <!-- MOBILE SEARCH OVERLAY -->
  <div
    id="mobileSearchOverlay"
    class="fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 lg:hidden"
  >
    <div class="flex items-start justify-center pt-24 px-4">
      <div
        id="mobileSearchModal"
        class="w-full max-w-lg bg-white dark:bg-[#1a1d26] rounded-2xl shadow-2xl transform scale-95 transition-all duration-300 border border-gray-200 dark:border-gray-800"
      >
        <div
          class="p-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between"
        >
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            Search
          </h3>
          <button
            id="closeMobileSearchBtn"
            class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 transition-colors"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="p-4">
          {Astro.url.pathname !== "/blog" && <Search variant="modal" />}
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const drawer = document.querySelector("#drawer");
    const backdrop = document.querySelector("#drawerBackdrop");
    const openBtn = document.querySelector("#openDrawerBtn");
    const closeBtn = document.querySelector("#closeDrawerBtn");
    const header = document.getElementById("site-header");

    // Mobile search elements
    const mobileSearchBtn = document.querySelector("#mobileSearchBtn");
    const mobileSearchOverlay = document.querySelector("#mobileSearchOverlay");
    const mobileSearchModal = document.querySelector("#mobileSearchModal");
    const closeMobileSearchBtn = document.querySelector(
      "#closeMobileSearchBtn",
    );

    function openDrawer() {
      drawer?.classList.remove("-translate-x-full");
      backdrop?.classList.remove("pointer-events-none", "opacity-0");
      backdrop?.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      drawer?.classList.add("-translate-x-full");
      backdrop?.classList.add("pointer-events-none", "opacity-0");
      backdrop?.classList.remove("opacity-100");
      document.body.style.overflow = "";
    }

    function openMobileSearch() {
      mobileSearchOverlay?.classList.remove("pointer-events-none", "opacity-0");
      mobileSearchModal?.classList.remove("scale-95");
      mobileSearchModal?.classList.add("scale-100");
      document.body.style.overflow = "hidden";

      setTimeout(() => {
        const searchInput = document.querySelector("#modal-search-input");
        if (searchInput) searchInput.focus();
      }, 300);
    }

    function closeMobileSearch() {
      mobileSearchOverlay?.classList.add("pointer-events-none", "opacity-0");
      mobileSearchModal?.classList.remove("scale-100");
      mobileSearchModal?.classList.add("scale-95");
      document.body.style.overflow = "";
    }

    // Event Listeners
    openBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openDrawer();
    });

    closeBtn?.addEventListener("click", closeDrawer);
    backdrop?.addEventListener("click", closeDrawer);

    mobileSearchBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openMobileSearch();
    });

    closeMobileSearchBtn?.addEventListener("click", closeMobileSearch);
    mobileSearchOverlay?.addEventListener("click", (e) => {
      if (e.target === mobileSearchOverlay) closeMobileSearch();
    });

    // Close on Escape
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeDrawer();
        closeMobileSearch();
      }
    });

    // Scroll Behavior
    let lastScrollY = window.scrollY;
    let isScrollingDown = false;

    window.addEventListener(
      "scroll",
      () => {
        if (window.innerWidth < 1024) return; // Only on desktop

        const currentScrollY = window.scrollY;

        if (currentScrollY > lastScrollY && currentScrollY > 100) {
          if (!isScrollingDown) {
            header.style.transform = "translateY(-100%)";
            isScrollingDown = true;
          }
        } else {
          if (isScrollingDown) {
            header.style.transform = "translateY(0)";
            isScrollingDown = false;
          }
        }
        lastScrollY = currentScrollY;
      },
      { passive: true },
    );
  });
</script>

<style>
  /* Ensure content isn't hidden behind fixed header */
  :global(body) {
    padding-top: 0; /* Reset */
  }

  /* Add padding to main content wrapper instead if needed, 
     but sticky header usually sits on top. 
     If using fixed, we need padding. 
     Here we use sticky, so it takes space in flow. */
</style>
