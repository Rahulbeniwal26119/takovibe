---
import Search from "./SearchBar.astro";
import Auth from "./Auth.astro";
import LiveIndicator from "./LiveIndicator.astro";
---

<header id="site-header" class="fixed top-0 inset-x-0 z-[70] overflow-visible isolate">
  <!-- ROW 1: chrome bar -->
  <div class="bg-white/80 dark:bg-gray-900/80 backdrop-blur border-b border-gray-200/70 dark:border-gray-800/70">
    <div
      class="max-w-screen-2xl mx-auto h-14 md:h-16 grid grid-cols-[auto_1fr_auto] items-center gap-2 px-3 md:px-6"
    >
      <!-- Left cluster: menu + logo -->
      <div class="flex items-center gap-3">
        <!-- Mobile drawer button -->
        <button id="openDrawerBtn" aria-label="Open menu"
          class="md:hidden w-10 h-10 grid place-items-center rounded-xl border border-black/10 dark:border-white/10 text-gray-800 dark:text-gray-200">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <a href="/" class="shrink-0 hover:opacity-90 transition" aria-label="TakoVibe home">
          <img src="/images/logo.svg" alt="TakoVibe logo" class="w-10 h-10 rounded-full" />
        </a>
      <div class="block shrink-0">
        <LiveIndicator
          seriesName="Rag Mastery"
          message="Series is LIVE! New posts every day"
          href="/series/rag-mastery"
        />
      </div>
      </div>

      <!-- Center cell (kept empty so grid guarantees space distribution) -->
      <div class="min-w-0"></div>

      <!-- Right cluster: search + auth (never shrinks on desktop) -->
      <div class="flex items-center gap-3">
        <!-- Desktop search bar -->
        <div class="w-[340px] xs:hidden lg:block" id="header-search-container">
          <Search variant="header" />
        </div>
        
        <!-- Mobile search icon -->
        <button id="mobileSearchBtn" 
                class="lg:hidden w-10 h-10 grid place-items-center rounded-xl border border-black/10 dark:border-white/10 text-gray-800 dark:text-gray-200 hover:bg-black/[.04] dark:hover:bg-white/5 transition"
                aria-label="Open search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="21 21l-4.35-4.35"/>
          </svg>
        </button>
        
        <div class="auth-wrapper" onclick="event.stopPropagation();">
          <Auth />
        </div>
      </div>
    </div>
  </div>

  <!-- ROW 2: primary navigation -->
  <div class="block bg-white/75 dark:bg-gray-900/75 backdrop-blur border-b border-gray-200/60 dark:border-gray-800/60">
    <div class="max-w-screen-2xl mx-auto px-3 md:px-6 flex items-center justify-between gap-3">
      <!-- Primary links (scroll if ever needed; never clipped) -->
      <nav class="flex items-center gap-1 overflow-x-auto overflow-y-visible" aria-label="Primary">
        <a href="/"
           class="px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-black/[.04] dark:hover:bg-white/5">Home</a>
        <a href="/blog"
           class="px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-black/[.04] dark:hover:bg-white/5">Blog</a>
        <a href="/about"
           class="px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-black/[.04] dark:hover:bg-white/5">About</a>
        <a href="/categories"
           class="px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-black/[.04] dark:hover:bg-white/5">Categories</a>
        <a href="/series"
           class="px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-black/[.04] dark:hover:bg-white/5">Series</a>
        <a href="/contact"
           class="px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-black/[.04] dark:hover:bg-white/5">Contact</a>

        <!-- Library dropdown -->
        <!-- <details class="relative">
          <summary
            class="list-none cursor-pointer px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-black/[.04] dark:hover:bg-white/5">
            Library
          </summary>
          <div
            class="absolute left-0 top-full mt-1 w-56 rounded-2xl border border-black/10 dark:border-white/10 bg-white/95 dark:bg-gray-900/95 backdrop-blur p-2 shadow-xl z-[80]"
          >
            <a href="/me/recent" class="block px-3 py-2 rounded-xl text-sm text-gray-700 dark:text-gray-300 hover:bg-black/[.04] dark:hover:bg-white/5">Recently read</a>
            <a href="/me/likes" class="block px-3 py-2 rounded-xl text-sm text-gray-700 dark:text-gray-300 hover:bg-black/[.04] dark:hover:bg-white/5">Liked</a>
            <a href="/me/comments" class="block px-3 py-2 rounded-xl text-sm text-gray-700 dark:text-gray-300 hover:bg-black/[.04] dark:hover:bg-white/5">Commented</a>
            <a href="/bookmarks" class="block px-3 py-2 rounded-xl text-sm text-gray-700 dark:text-gray-300 hover:bg-black/[.04] dark:hover:bg-white/5">Bookmarks</a>
          </div>
        </details> -->
      </nav>

      <!-- <div class="lg:block shrink-0">
        <LiveIndicator
          seriesName="30-Days-to-RAG"
          message="Series is LIVE! New posts every day"
          href="/series/30-days-to-rag"
        />
      </div> -->
    </div>
  </div>

  <!-- MOBILE DRAWER -->
  <div id="drawerBackdrop"
       class="fixed inset-0 z-[65] bg-black/40 opacity-0 pointer-events-none transition"></div>

  <aside id="drawer"
         class="fixed left-0 top-0 z-[66] h-full w-[86vw] max-w-[360px] -translate-x-full transition-transform duration-200
                bg-white dark:bg-gray-900 border-r border-gray-200 dark:border-gray-800 p-3 md:hidden"
         aria-label="Mobile menu" aria-hidden="true">
    <div class="h-12 flex items-center">
      <button id="closeDrawerBtn" aria-label="Close menu"
        class="w-10 h-10 grid place-items-center rounded-xl border border-black/10 dark:border-white/10 text-gray-800 dark:text-gray-200">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <strong class="ml-2">Menu</strong>
    </div>

    <!-- Mobile Search Section -->
    <div class="mt-4 mb-4" id="mobile-search-section">
      {Astro.url.pathname !== '/blog' && (
        <div class="p-3 bg-gray-50 dark:bg-gray-800 rounded-xl">
          <Search variant="mobile" />
        </div>
      )}
    </div>

    <nav class="mt-2 space-y-1 text-gray-800 dark:text-gray-200">
      <a href="/" class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5">Home</a>
      <a href="/blog" class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5">Blog</a>
      <a href="/about" class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5">About</a>
      <a href="/categories" class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5">Categories</a>
      <a href="/series" class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5">Series</a>
      <a href="/contact" class="block px-3 py-2 rounded-xl hover:bg-black/[.04] dark:hover:bg-white/5">Contact</a>
    </nav>
  </aside>

  <!-- MOBILE SEARCH OVERLAY -->
  <div id="mobileSearchOverlay"
       class="fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 lg:hidden">
    <div class="flex items-start justify-center pt-20 px-4">
      <div id="mobileSearchModal" 
           class="w-full max-w-lg bg-white dark:bg-gray-900 rounded-2xl shadow-2xl transform scale-95 transition-transform duration-300">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Search</h3>
            <button id="closeMobileSearchBtn" 
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
                    aria-label="Close search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="p-4">
          {Astro.url.pathname !== '/blog' && <Search variant="modal" />}
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Drawer toggling and mobile search -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const drawer = document.querySelector('#drawer');
    const backdrop = document.querySelector('#drawerBackdrop');
    const openBtn = document.querySelector('#openDrawerBtn');
    const closeBtn = document.querySelector('#closeDrawerBtn');
    
    // Mobile search elements
    const mobileSearchBtn = document.querySelector('#mobileSearchBtn');
    const mobileSearchOverlay = document.querySelector('#mobileSearchOverlay');
    const mobileSearchModal = document.querySelector('#mobileSearchModal');
    const closeMobileSearchBtn = document.querySelector('#closeMobileSearchBtn');

    function openDrawer() {
      drawer?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('pointer-events-none','opacity-0');
    }
    
    function closeDrawer() {
      drawer?.classList.add('-translate-x-full');
      backdrop?.classList.add('pointer-events-none','opacity-0');
    }

    function openMobileSearch() {
      mobileSearchOverlay?.classList.remove('pointer-events-none', 'opacity-0');
      mobileSearchModal?.classList.remove('scale-95');
      mobileSearchModal?.classList.add('scale-100');
      
      // Focus the search input after animation
      setTimeout(() => {
        const searchInput = document.querySelector('#modal-search-input');
        if (searchInput) {
          searchInput.focus();
        }
      }, 300);
    }

    function closeMobileSearch() {
      mobileSearchOverlay?.classList.add('pointer-events-none', 'opacity-0');
      mobileSearchModal?.classList.remove('scale-100');
      mobileSearchModal?.classList.add('scale-95');
    }

    // Drawer functionality
    openBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      openDrawer();
    });
    
    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeDrawer();
    });
    
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeDrawer();
      }
    });

    // Mobile search functionality
    mobileSearchBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      openMobileSearch();
    });

    closeMobileSearchBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeMobileSearch();
    });

    mobileSearchOverlay?.addEventListener('click', (e) => {
      if (e.target === mobileSearchOverlay) {
        closeMobileSearch();
      }
    });
    
    // Close on Escape key
    window.addEventListener('keydown', (e) => { 
      if (e.key === 'Escape') {
        closeDrawer();
        closeMobileSearch();
      }
    });

    // Prevent header clicks from opening drawer
    const header = document.querySelector('#site-header');
    header?.addEventListener('click', (e) => {
      if (!e.target?.closest('#openDrawerBtn')) {
        e.stopPropagation();
      }
    });
  });

  // Handle mobile navigation visibility
  document.addEventListener('DOMContentLoaded', () => {
    const openDrawerBtn = document.getElementById('openDrawerBtn');
    const navSection = document.querySelector('nav[aria-label="Primary"]').parentElement;
    
    let isNavVisible = window.innerWidth >= 768;
    
    function updateNavVisibility() {
      if (window.innerWidth >= 768) {
        navSection.style.display = 'block';
        isNavVisible = true;
      } else {
        navSection.style.display = isNavVisible ? 'block' : 'none';
      }
    }

    // Initial visibility
    updateNavVisibility();

    // Toggle nav on mobile
    openDrawerBtn?.addEventListener('click', () => {
      isNavVisible = !isNavVisible;
      updateNavVisibility();
    });

    // Update on resize
    window.addEventListener('resize', () => {
      updateNavVisibility();
    });
  });
</script>

<style>
  /* Add body padding to account for fixed header */
  :global(body) {
    padding-top: calc(56px + 48px); /* Mobile: 56px (h-14) + 48px (navigation row) */
  }
  
  @media (min-width: 768px) {
    :global(body) {
      padding-top: calc(64px + 48px); /* Desktop: 64px (h-16) + 48px (navigation row) */
    }
  }
  
  /* Ensure header has consistent height */
  #site-header {
    height: calc(56px + 48px); /* Mobile total height */
  }
  
  @media (min-width: 768px) {
    #site-header {
      height: calc(64px + 48px); /* Desktop total height */
    }
  }
</style>