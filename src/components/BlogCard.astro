---
interface Props {
  post: {
    data?: {
      title: string;
      description: string;
      date: string;
      tags?: string[];
      image?: string;
      readingTime?: string;
      author?: string;
    };
    slug: string;
    // API structure properties
    title?: string;
    description?: string;
    created_at?: string;
    tags?: string[];
    image_url?: string;
    readingTime?: string;
    author?: {
      id: number;
      name: string;
      email: string;
      username: string;
    };
  };
  index?: number;
}

const { post, index } = Astro.props;

// Handle both API and content collection structures
const isApiPost = !post.data && post.title;
const postData = isApiPost 
  ? {
      title: post.title!,
      description: post.description!,
      date: post.created_at!,
      tags: post.tags || [],
      image: post.image_url,
      readingTime: post.readingTime || "5 min read",
      author: post.author?.name || post.author?.email || "TakoVibe Team"
    }
  : post.data!;

const {
  title,
  description,
  date,
  tags = [],
  image,
  readingTime = "5 min read",
  author = "TakoVibe Team"
} = postData;

const formattedDate = new Date(date);
---

<article class="group relative">
  <!-- Gradient border effect -->
  <div class="absolute inset-0 bg-gradient-to-r from-purple-500/20 via-blue-500/20 to-purple-500/20 rounded-xl opacity-0 group-hover:opacity-100 blur-sm transition-opacity duration-500"></div>
  
  <a href={`/blog/${post.slug}`} class="relative block p-6 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm rounded-xl border border-black/5 dark:border-white/10 hover:border-purple-200 dark:hover:border-purple-400/30 hover:shadow-lg hover:shadow-purple-500/10 dark:hover:shadow-purple-500/20 transition-all duration-300 group-hover:transform group-hover:-translate-y-1">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
      <!-- Left side: Date and Index with enhanced styling -->
      <div class="flex items-center sm:flex-col sm:items-center gap-3 sm:gap-2">
        <!-- Article number with gradient -->
        <div class="relative">
          <span class="text-2xl sm:text-xl font-bold bg-gradient-to-r from-purple-500 to-blue-500 bg-clip-text text-transparent">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="absolute -inset-1 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full opacity-20 group-hover:opacity-40 transition-opacity duration-300 blur-sm"></div>
        </div>
        
        <!-- Date with modern styling -->
        <div class="flex flex-col items-center">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
            {formattedDate.toLocaleString('en-US', { month: 'short' })}
          </span>
          <span class="text-2xl font-bold text-gray-900 dark:text-gray-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            {formattedDate.getDate()}
          </span>
        </div>
      </div>

      <!-- Middle: Content with enhanced typography -->
      <div class="flex-1 min-w-0">
        <!-- Tags with gradient backgrounds -->
        <div class="flex gap-2 mb-4">
          {tags.slice(0, 2).map((tag, tagIndex) => {
            const gradients = [
              'from-purple-100 to-blue-100 border-purple-300 dark:from-purple-900/30 dark:to-blue-900/30 dark:border-purple-400/50 text-purple-800 dark:text-purple-300',
              'from-blue-100 to-indigo-100 border-blue-300 dark:from-blue-900/30 dark:to-indigo-900/30 dark:border-blue-400/50 text-blue-800 dark:text-blue-300',
              'from-indigo-100 to-purple-100 border-indigo-300 dark:from-indigo-900/30 dark:to-purple-900/30 dark:border-indigo-400/50 text-indigo-800 dark:text-indigo-300'
            ];
            return (
              <span class={`px-3 py-1.5 bg-gradient-to-r ${gradients[tagIndex % gradients.length]} border rounded-full text-xs font-semibold hover:scale-105 transition-transform duration-200`}>
                {tag}
              </span>
            );
          })}
        </div>
        
        <!-- Title with enhanced hover effect -->
        <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors duration-300 leading-tight">
          {title}
        </h3>
        
        <!-- Description with better spacing -->
        <p class="text-gray-600 dark:text-gray-400 text-base line-clamp-2 mb-4 leading-relaxed">
          {description}
        </p>

        <!-- Metadata with improved styling -->
        <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-500">
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium">{readingTime}</span>
          </div>
          <span class="text-purple-400 dark:text-purple-500">•</span>
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span class="font-medium">by {author}</span>
          </div>
        </div>
      </div>

      <!-- Right side: Image with smart background and loading states -->
      {image && (
        <div class="md:block relative sm:w-48 sm:h-32 rounded-xl overflow-hidden group-hover:shadow-lg transition-shadow duration-300 bg-gradient-to-br from-gray-200 via-gray-100 to-gray-200 dark:from-gray-700 dark:via-gray-800 dark:to-gray-700" data-image-container>
          <!-- Loading placeholder -->
          <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-purple-100 to-blue-100 dark:from-purple-900/30 dark:to-blue-900/30 animate-pulse" data-image-placeholder>
            <div class="text-center">
              <div class="w-8 h-8 mx-auto mb-2 rounded-lg bg-gradient-to-br from-purple-200 to-blue-200 dark:from-purple-800 dark:to-blue-800 flex items-center justify-center">
                <svg class="w-4 h-4 text-purple-600 dark:text-purple-400 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="text-xs text-gray-600 dark:text-gray-400 font-medium">Loading...</div>
            </div>
          </div>
          
          <!-- Image overlay gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
          
          <img 
            src={image.includes('imagekit.io') ? `${image}?tr=w-600` : image} 
            alt={title}
            class="w-full h-full object-contain opacity-0 transition-all duration-500 group-hover:scale-105"
            loading="lazy"
            data-smart-image
            crossorigin="anonymous"
          />
          
          <!-- Decorative corner accent -->
          <div class="absolute top-2 right-2 w-6 h-6 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full opacity-0 group-hover:opacity-80 transition-opacity duration-300 z-20"></div>
        </div>
      )}
    </div>
    
    <!-- Read more indicator -->
    <div class="flex items-center justify-end mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <span class="text-sm font-semibold text-purple-600 dark:text-purple-400 flex items-center gap-2">
        Read more
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </span>
    </div>
  </a>
</article>

<script>
  // Handle smart image loading for BlogCard component
  function setupSmartImages() {
    const images = document.querySelectorAll('[data-smart-image]');
    
    images.forEach((img: HTMLImageElement) => {
      if (img.complete && img.naturalHeight !== 0) {
        // Image already loaded
        handleImageLoad(img);
      } else {
        // Add event listeners
        img.addEventListener('load', () => handleImageLoad(img));
        img.addEventListener('error', () => handleImageError(img));
      }
    });
  }

  function handleImageLoad(img: HTMLImageElement) {
    try {
      // Extract dominant colors from image
      extractImageColors(img, (colors) => {
        const container = img.closest('[data-image-container]') as HTMLElement;
        const placeholder = container?.querySelector('[data-image-placeholder]') as HTMLElement;
        
        if (container && colors.length > 0) {
          // Create gradient background from extracted colors
          const gradient = createSmartGradient(colors);
          container.style.background = gradient;
        }
        
        // Hide placeholder and show image
        if (placeholder) {
          placeholder.style.opacity = '0';
          setTimeout(() => {
            placeholder.style.display = 'none';
          }, 300);
        }
        
        // Show image with fade-in effect
        img.style.opacity = '1';
      });
    } catch (error) {
      console.log('Color extraction failed, using default background');
      // Fallback: just show the image
      const container = img.closest('[data-image-container]') as HTMLElement;
      const placeholder = container?.querySelector('[data-image-placeholder]') as HTMLElement;
      
      if (placeholder) {
        placeholder.style.display = 'none';
      }
      img.style.opacity = '1';
    }
  }

  function handleImageError(img: HTMLImageElement) {
    const container = img.closest('[data-image-container]') as HTMLElement;
    const placeholder = container?.querySelector('[data-image-placeholder]') as HTMLElement;
    
    if (placeholder) {
      // Update placeholder to show error state
      placeholder.innerHTML = `
        <div class="text-center">
          <div class="w-8 h-8 mx-auto mb-2 rounded-lg bg-gradient-to-br from-red-200 to-orange-200 dark:from-red-800 dark:to-orange-800 flex items-center justify-center">
            <svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
          </div>
          <div class="text-xs text-gray-600 dark:text-gray-400 font-medium">Failed</div>
        </div>
      `;
      placeholder.classList.remove('animate-pulse');
    }
    
    // Hide the failed image
    img.style.display = 'none';
  }

  // Extract dominant colors from image
  function extractImageColors(img: HTMLImageElement, callback: (colors: string[]) => void) {
    try {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      
      if (!ctx) {
        callback([]);
        return;
      }
      
      // Set small canvas size for performance
      canvas.width = 50;
      canvas.height = 50;
      
      // Draw image to canvas
      ctx.drawImage(img, 0, 0, 50, 50);
      
      // Get image data
      const imageData = ctx.getImageData(0, 0, 50, 50);
      const data = imageData.data;
      
      // Extract colors (sample every 8th pixel for performance)
      const colorCounts: { [key: string]: number } = {};
      
      for (let i = 0; i < data.length; i += 32) { // Sample every 8th pixel
        const r = data[i];
        const g = data[i + 1];
        const b = data[i + 2];
        const alpha = data[i + 3];
        
        // Skip transparent or very light/dark pixels
        if (alpha < 128 || (r + g + b) < 50 || (r + g + b) > 650) continue;
        
        // Group similar colors
        const colorKey = `${Math.floor(r/40)*40},${Math.floor(g/40)*40},${Math.floor(b/40)*40}`;
        colorCounts[colorKey] = (colorCounts[colorKey] || 0) + 1;
      }
      
      // Get top 2 most frequent colors
      const sortedColors = Object.entries(colorCounts)
        .sort(([,a], [,b]) => b - a)
        .slice(0, 2)
        .map(([color]) => `rgb(${color})`);
      
      callback(sortedColors);
    } catch (error) {
      console.log('Color extraction error:', error);
      callback([]);
    }
  }

  // Create smart gradient from extracted colors
  function createSmartGradient(colors: string[]): string {
    if (colors.length === 0) {
      return 'linear-gradient(135deg, #f3f4f6, #e5e7eb)';
    }
    
    if (colors.length === 1) {
      // Single color - create tonal variations
      const baseColor = colors[0];
      return `linear-gradient(135deg, ${baseColor}, ${adjustColorBrightness(baseColor, -15)}, ${adjustColorBrightness(baseColor, 15)})`;
    }
    
    // Multiple colors
    return `linear-gradient(135deg, ${colors[0]}, ${colors[1]})`;
  }

  // Adjust color brightness
  function adjustColorBrightness(color: string, percent: number): string {
    const rgb = color.match(/\d+/g);
    if (!rgb) return color;
    
    const r = Math.max(0, Math.min(255, parseInt(rgb[0]) + percent));
    const g = Math.max(0, Math.min(255, parseInt(rgb[1]) + percent));
    const b = Math.max(0, Math.min(255, parseInt(rgb[2]) + percent));
    
    return `rgb(${r}, ${g}, ${b})`;
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', setupSmartImages);
</script>