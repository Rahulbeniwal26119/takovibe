---
const { title, date, author, image, url } = Astro.props;
---

<article class="bg-gray-50 dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
  {image && (
    <img 
      src={image} 
      alt={title}
      class="w-full h-48 object-cover"
    />
  )}
  <div class="p-6">
    <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
      <a href={url} class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
        {title}
      </a>
    </h2>
    <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
      <span>{date}</span>
      <span class="mx-2">•</span>
      <span>{author}</span>
    </div>
  </div>
</article>