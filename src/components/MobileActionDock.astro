---
import TableOfContents from "./TableOfContents.astro";
import SocialShare from "./SocialShare.astro";

const { headings, title, description, url } = Astro.props;
---

<!-- Mobile Action Dock -->
<div
    id="mobile-action-dock"
    class="fixed bottom-0 left-0 right-0 z-40 lg:hidden transform transition-transform duration-300 ease-in-out"
>
    <!-- Dock Container -->
    <div
        class="bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 shadow-lg"
        style="padding-bottom: env(safe-area-inset-bottom);"
    >
        <div class="flex items-center justify-around px-4 h-16">
            <!-- Ask AI -->
            <button
                id="mobile-ai-btn"
                class="flex flex-col items-center justify-center gap-1 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors active:scale-95"
                aria-label="Ask Kumi AI"
            >
                <svg
                    class="w-6 h-6 text-purple-600 dark:text-purple-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <span
                    class="text-[10px] font-medium text-gray-600 dark:text-gray-400"
                    >AI</span
                >
            </button>

            <!-- Comments -->
            <button
                id="mobile-comments-btn"
                class="flex flex-col items-center justify-center gap-1 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors active:scale-95"
                aria-label="Comments"
            >
                <svg
                    class="w-6 h-6 text-blue-600 dark:text-blue-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                    ></path>
                </svg>
                <span
                    class="text-[10px] font-medium text-gray-600 dark:text-gray-400"
                    >Chat</span
                >
            </button>

            <!-- Notes -->
            <button
                id="mobile-notes-btn"
                class="flex flex-col items-center justify-center gap-1 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors active:scale-95"
                aria-label="Visual Notes"
            >
                <svg
                    class="w-6 h-6 text-green-600 dark:text-green-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                    ></path>
                </svg>
                <span
                    class="text-[10px] font-medium text-gray-600 dark:text-gray-400"
                    >Notes</span
                >
            </button>

            <!-- Like -->
            <button
                id="mobile-like-btn"
                class="flex flex-col items-center justify-center gap-1 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors active:scale-95 group"
                aria-label="Like Article"
            >
                <svg
                    class="w-6 h-6 text-gray-400 dark:text-gray-500 transition-colors group-hover:text-red-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    ></path>
                </svg>
                <span
                    class="text-[10px] font-medium text-gray-600 dark:text-gray-400"
                    >Like</span
                >
            </button>

            <!-- More -->
            <button
                id="mobile-more-btn"
                class="flex flex-col items-center justify-center gap-1 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors active:scale-95"
                aria-label="More options"
            >
                <svg
                    class="w-6 h-6 text-gray-600 dark:text-gray-400 transition-transform duration-200"
                    id="more-btn-icon"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"
                    ></path>
                </svg>
                <span
                    class="text-[10px] font-medium text-gray-600 dark:text-gray-400"
                    >More</span
                >
            </button>
        </div>
    </div>
</div>

<!-- BACKDROP (Shared) -->
<div
    id="mobile-sheet-backdrop"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300"
>
</div>

<!-- MORE MENU SHEET -->
<div
    id="mobile-more-menu"
    class="fixed bottom-0 left-0 right-0 z-[60] bg-white dark:bg-gray-900 rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-300 mobile-sheet"
>
    <div class="p-6 pb-8">
        <div
            class="w-12 h-1 bg-gray-300 dark:bg-gray-700 rounded-full mx-auto mb-6"
        >
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">
            More Options
        </h3>
        <div class="space-y-2">
            <!-- Bookmark -->
            <button
                class="w-full flex items-center gap-4 p-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                id="mobile-bookmark-btn"
            >
                <svg
                    class="w-5 h-5 text-yellow-600 dark:text-yellow-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                    ></path></svg
                >
                <span class="text-sm font-medium text-gray-900 dark:text-white"
                    >Save Article</span
                >
            </button>

            <!-- Share -->
            <button
                class="w-full flex items-center gap-4 p-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                onclick="openSheet('mobile-share-sheet')"
            >
                <svg
                    class="w-5 h-5 text-gray-600 dark:text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                    ></path></svg
                >
                <span class="text-sm font-medium text-gray-900 dark:text-white"
                    >Share Article</span
                >
            </button>

            <!-- Text Settings -->
            <button
                class="w-full flex items-center gap-4 p-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                onclick="openSheet('mobile-font-sheet')"
            >
                <svg
                    class="w-5 h-5 text-gray-600 dark:text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"
                    ></path></svg
                >
                <span class="text-sm font-medium text-gray-900 dark:text-white"
                    >Text Settings</span
                >
            </button>

            <!-- TOC -->
            <button
                class="w-full flex items-center gap-4 p-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                onclick="openSheet('mobile-toc-sheet')"
            >
                <svg
                    class="w-5 h-5 text-gray-600 dark:text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h7"></path></svg
                >
                <span class="text-sm font-medium text-gray-900 dark:text-white"
                    >Table of Contents</span
                >
            </button>

            <!-- Focus Mode -->
            <button
                class="w-full flex items-center gap-4 p-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                id="mobile-focus-btn"
            >
                <svg
                    class="w-5 h-5 text-gray-600 dark:text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path></svg
                >
                <span class="text-sm font-medium text-gray-900 dark:text-white"
                    >Focus Mode</span
                >
            </button>
        </div>

        <!-- Code Studio -->
        <button
            class="w-full flex items-center gap-4 p-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            id="mobile-code-studio-btn"
        >
            <div class="relative">
                <svg
                    class="w-5 h-5 text-gray-600 dark:text-gray-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                <span class="absolute -top-1 -right-1 flex h-2 w-2">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"
                    ></span>
                </span>
            </div>
            <div class="flex flex-col items-start">
                <span class="text-sm font-medium text-gray-900 dark:text-white"
                    >Code Studio</span
                >
                <span
                    class="text-[10px] text-blue-500 font-bold uppercase tracking-wider"
                    >Preview Feature</span
                >
            </div>
        </button>
    </div>
</div>

<!-- TEXT SETTINGS SHEET -->
<div
    id="mobile-font-sheet"
    class="fixed bottom-0 left-0 right-0 z-[60] bg-white dark:bg-gray-900 rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-300 mobile-sheet"
>
    <div class="p-6 pb-8">
        <div
            class="w-12 h-1 bg-gray-300 dark:bg-gray-700 rounded-full mx-auto mb-6"
        >
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-6">
            Text Settings
        </h3>

        <div class="space-y-6">
            <!-- Size -->
            <div
                class="flex items-center justify-between bg-gray-100 dark:bg-gray-800 p-2 rounded-xl"
            >
                <button
                    id="mobile-decrease-font"
                    class="p-3 bg-white dark:bg-gray-700 rounded-lg shadow-sm hover:scale-105 transition-transform text-gray-700 dark:text-gray-200"
                >
                    <span class="text-xs font-bold">A-</span>
                </button>
                <span
                    id="mobile-font-size-display"
                    class="font-mono font-bold text-gray-700 dark:text-gray-300"
                    >18px</span
                >
                <button
                    id="mobile-increase-font"
                    class="p-3 bg-white dark:bg-gray-700 rounded-lg shadow-sm hover:scale-105 transition-transform text-gray-700 dark:text-gray-200"
                >
                    <span class="text-lg font-bold">A+</span>
                </button>
            </div>

            <button
                id="mobile-reset-font"
                class="w-full py-2 text-sm text-purple-600 dark:text-purple-400 font-medium hover:bg-purple-50 dark:hover:bg-purple-900/20 rounded-lg transition-colors"
            >
                Reset to Default
            </button>
        </div>
    </div>
</div>

<!-- SHARE SHEET -->
<div
    id="mobile-share-sheet"
    class="fixed bottom-0 left-0 right-0 z-[60] bg-white dark:bg-gray-900 rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-300 mobile-sheet"
>
    <div class="p-6 pb-8">
        <div
            class="w-12 h-1 bg-gray-300 dark:bg-gray-700 rounded-full mx-auto mb-6"
        >
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-6">
            Share Article
        </h3>
        <SocialShare title={title} description={description} url={url} />
    </div>
</div>

<!-- TOC SHEET -->
<div
    id="mobile-toc-sheet"
    class="fixed bottom-0 left-0 right-0 z-[60] bg-white dark:bg-gray-900 rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-300 mobile-sheet max-h-[80vh] flex flex-col"
>
    <div class="p-4 border-b border-gray-100 dark:border-gray-800 shrink-0">
        <div class="w-12 h-1 bg-gray-300 dark:bg-gray-700 rounded-full mx-auto">
        </div>
    </div>
    <div class="flex-1 overflow-y-auto p-6 custom-scrollbar">
        <TableOfContents headings={headings || []} />
    </div>
</div>

<script define:vars={{ slug: Astro.props.slug || "" }}>
    // --- Mobile Dock Core Logic ---
    const dock = document.getElementById("mobile-action-dock");
    const backdrop = document.getElementById("mobile-sheet-backdrop");
    const sheets = document.querySelectorAll(".mobile-sheet");
    let activeSheet = null;

    // Scroll Logic
    let lastScroll = 0;
    let scrollTimeout;
    window.addEventListener("scroll", () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            const currentScroll = window.scrollY;
            if (currentScroll <= 0) {
                dock?.classList.remove("translate-y-full");
                return;
            }
            if (currentScroll > lastScroll && currentScroll > 50) {
                // Hide dock only if no sheet is open
                if (!activeSheet) dock?.classList.add("translate-y-full");
            } else {
                dock?.classList.remove("translate-y-full");
            }
            lastScroll = currentScroll;
        }, 10);
    });

    // Sheet Management
    window.openSheet = (id) => {
        const sheet = document.getElementById(id);
        if (!sheet) return;

        // Close current if exists
        if (activeSheet && activeSheet !== sheet) {
            activeSheet.classList.add("translate-y-full");
        }

        // Hide More Menu if not target (special case)
        if (id !== "mobile-more-menu") {
            document
                .getElementById("mobile-more-menu")
                ?.classList.add("translate-y-full");
        }

        sheet.classList.remove("translate-y-full");
        backdrop?.classList.remove("hidden");
        // Fade in backdrop
        setTimeout(() => backdrop?.classList.remove("opacity-0"), 10);

        activeSheet = sheet;
    };

    window.closeAllSheets = () => {
        sheets.forEach((s) => s.classList.add("translate-y-full"));
        backdrop?.classList.add("opacity-0");
        setTimeout(() => backdrop?.classList.add("hidden"), 300);
        activeSheet = null;
        dock?.classList.remove("translate-y-full"); // Ensure dock returns
    };

    backdrop?.addEventListener("click", window.closeAllSheets);

    // Initial Button Bindings
    document
        .getElementById("mobile-more-btn")
        ?.addEventListener("click", () => window.openSheet("mobile-more-menu"));

    document
        .getElementById("mobile-ai-btn")
        ?.addEventListener("click", () =>
            window.dispatchEvent(new CustomEvent("toggle-ai-chat")),
        );
    document
        .getElementById("mobile-comments-btn")
        ?.addEventListener("click", () => {
            if (window.toggleComments) window.toggleComments();
        });
    document
        .getElementById("mobile-notes-btn")
        ?.addEventListener("click", () =>
            window.dispatchEvent(new CustomEvent("toggle-excalidraw")),
        );

    // Like Bridge
    document
        .getElementById("mobile-like-btn")
        ?.addEventListener("click", () => {
            window.dispatchEvent(new CustomEvent("trigger-like"));
        });

    // Bookmark
    document
        .getElementById("mobile-bookmark-btn")
        ?.addEventListener("click", () => {
            window.closeAllSheets();
            const saveBtn = document.querySelector(".save-btn");
            if (saveBtn) saveBtn.click();
        });

    // Code Studio
    document
        .getElementById("mobile-code-studio-btn")
        ?.addEventListener("click", () => {
            window.closeAllSheets();
            window.dispatchEvent(
                new CustomEvent("open-code-studio", {
                    detail: {
                        code: "",
                        language: "python",
                    },
                }),
            );
        });

    // --- Font Logic (Standalone) ---
    const MIN_SIZE = 16;
    const MAX_SIZE = 24;
    const DEFAULT_SIZE = 18;
    const sizeDisplay = document.getElementById("mobile-font-size-display");

    function updateMobileFontUI(size) {
        if (sizeDisplay) sizeDisplay.innerText = size + "px";
    }

    function applyMobileFont(size) {
        // Sync with Desktop logic via style tag
        let style = document.getElementById("dynamic-font-size");
        if (!style) {
            style = document.createElement("style");
            style.id = "dynamic-font-size";
            document.head.appendChild(style);
        }
        // Logic: Clamp headers on mobile to prevent overflow
        const isMobile = window.innerWidth < 768;
        const h1Scale = isMobile ? 1.5 : 2.2;
        const h2Scale = isMobile ? 1.3 : 1.8;
        const h3Scale = isMobile ? 1.2 : 1.5;

        style.textContent = `
        article.prose p, 
        article.prose li, 
        article.prose blockquote {
          font-size: ${size}px !important;
          line-height: 1.7 !important;
        }
        article.prose h1 { 
            font-size: ${size * h1Scale}px !important; 
            overflow-wrap: break-word !important;
            word-break: break-word !important;
            line-height: 1.2 !important;
        }
        article.prose h2 { 
            font-size: ${size * h2Scale}px !important; 
            overflow-wrap: break-word !important;
            word-break: break-word !important;
            line-height: 1.3 !important;
        }
        article.prose h3 { font-size: ${size * h3Scale}px !important; }
        article.prose h4 { font-size: ${size * 1.15}px !important; }
        
        /* Force code blocks to scroll, not wrap, and have padding */
        article.prose pre {
            overflow-x: auto !important;
            white-space: pre !important;
            word-wrap: normal !important;
            max-width: 100% !important;
            padding: 1rem !important;
            border-radius: 0.5rem !important;
        }
      `;
        localStorage.setItem("blog-font-size", size);
        updateMobileFontUI(size);
    }

    // Init Font
    const savedSize = parseInt(
        localStorage.getItem("blog-font-size") || DEFAULT_SIZE,
    );
    updateMobileFontUI(savedSize); // Sync UI initially without reapplying style if ReaderToolbar did it

    document
        .getElementById("mobile-increase-font")
        ?.addEventListener("click", () => {
            let current = parseInt(
                localStorage.getItem("blog-font-size") || DEFAULT_SIZE,
            );
            if (current < MAX_SIZE) applyMobileFont(current + 1);
        });
    document
        .getElementById("mobile-decrease-font")
        ?.addEventListener("click", () => {
            let current = parseInt(
                localStorage.getItem("blog-font-size") || DEFAULT_SIZE,
            );
            if (current > MIN_SIZE) applyMobileFont(current - 1);
        });
    document
        .getElementById("mobile-reset-font")
        ?.addEventListener("click", () => applyMobileFont(DEFAULT_SIZE));

    // --- Focus Mode Logic ---
    document
        .getElementById("mobile-focus-btn")
        ?.addEventListener("click", () => {
            window.closeAllSheets();
            // Use ReaderToolbar logic via bridge to ensure state consistency
            window.dispatchEvent(new CustomEvent("toggle-focus-mode"));
        });

    // Close TOC on link click
    const tocSheet = document.getElementById("mobile-toc-sheet");
    if (tocSheet) {
        tocSheet.addEventListener("click", (e) => {
            if (e.target.tagName === "A" || e.target.closest("a")) {
                window.closeAllSheets();
            }
        });
    }
</script>

<style>
    @supports (padding: env(safe-area-inset-bottom)) {
        #mobile-action-dock,
        .mobile-sheet {
            padding-bottom: env(safe-area-inset-bottom);
        }
    }
</style>
