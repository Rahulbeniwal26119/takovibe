<!-- Not in used but kept in repo for future usage when we will plan to integrate chatbot in each article -->
---
interface Props {
  articleTitle: string;
  articleContent?: string;
}

const { articleTitle, articleContent } = Astro.props;
---

<!-- Chatbot Container -->
<div id="article-chatbot" class="fixed bottom-6 right-6 z-50">
  <!-- Floating Action Button -->
  <button 
    id="chatbot-toggle"
    class="group relative w-14 h-14 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-4 focus:ring-purple-500/30"
    aria-label="Open chatbot"
  >
    <!-- Chat Icon -->
    <div class="absolute inset-0 flex items-center justify-center transition-transform duration-300 group-hover:rotate-12">
      <svg id="chat-icon" class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
      </svg>
      <!-- Close Icon (hidden by default) -->
      <svg id="close-icon" class="w-6 h-6 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </div>
    
    <!-- Pulse Animation -->
    <div class="absolute inset-0 rounded-full bg-purple-600 animate-ping opacity-30"></div>
    
    <!-- Notification Dot (optional) -->
    <div class="absolute -top-1 -right-1 w-4 h-4 bg-green-400 rounded-full border-2 border-white animate-pulse"></div>
  </button>

  <!-- Chat Interface -->
  <div 
    id="chat-interface" 
    class="absolute bottom-16 right-0 w-80 sm:w-96 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 hidden opacity-0 transform translate-y-4 transition-all duration-300"
    style="z-index: 1000;"
  >
    <!-- Chat Header -->
    <div class="flex items-center justify-between p-4 bg-gradient-to-r from-purple-600 to-pink-600 rounded-t-2xl">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
          <span class="text-white text-sm font-bold">🤖</span>
        </div>
        <div>
          <h3 class="text-white font-semibold text-sm">Article Assistant</h3>
          <p class="text-purple-100 text-xs">Ask me about this article</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button 
          id="expand-chat"
          class="text-white hover:text-purple-200 transition-colors p-1 rounded"
          aria-label="Expand chat"
          title="Expand chat"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>
        <button 
          id="minimize-chat"
          class="text-white hover:text-purple-200 transition-colors p-1 rounded"
          aria-label="Minimize chat"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Chat Messages -->
    <div 
      id="chat-messages" 
      class="h-80 overflow-y-auto p-4 space-y-3 bg-gradient-to-b from-slate-50 to-white dark:from-slate-800 dark:to-slate-900"
    >
      <!-- Welcome Message -->
      <div class="flex items-start gap-3">
        <div class="w-7 h-7 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs">🤖</span>
        </div>
        <div class="bg-white dark:bg-slate-700 rounded-lg px-3 py-2 shadow-sm border border-slate-200 dark:border-slate-600 max-w-xs">
          <p class="text-sm text-slate-700 dark:text-slate-300">
            Hi! I'm here to help you understand this article: "<strong>{articleTitle}</strong>". 
            <br><br>
            Ask me anything about the content, concepts, or get clarifications! I support **formatting** like `code`, *italics*, and math expressions!
          </p>
        </div>
      </div>
    </div>

    <!-- Chat Input -->
    <div class="p-4 border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 rounded-b-2xl">
      <div class="flex gap-2">
        <input 
          id="chat-input"
          type="text" 
          placeholder="Ask about this article..."
          class="flex-1 px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 dark:bg-slate-700 dark:text-slate-300 dark:placeholder-slate-400"
          maxlength="500"
        />
        <button 
          id="send-message"
          class="px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg hover:from-purple-700 hover:to-pink-700 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-500 disabled:opacity-50 disabled:cursor-not-allowed"
          aria-label="Send message"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
        </button>
      </div>
      <!-- Character count -->
      <div class="flex justify-between items-center mt-2">
        <div class="flex gap-2">
          <!-- Quick action buttons -->
          <button class="quick-question text-xs px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 rounded hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors" data-question="Summarize this article">
            📝 Summary
          </button>
          <button class="quick-question text-xs px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 rounded hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors" data-question="What are the key takeaways?">
            🎯 Key Points
          </button>
        </div>
        <span id="char-count" class="text-xs text-slate-400">0/500</span>
      </div>
    </div>

    <!-- Typing Indicator -->
    <div id="typing-indicator" class="hidden px-4 pb-2">
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex gap-1">
          <div class="w-1 h-1 bg-purple-500 rounded-full animate-bounce"></div>
          <div class="w-1 h-1 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
          <div class="w-1 h-1 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
        </div>
        <span>Assistant is typing...</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Type declarations for window
  declare global {
    interface Window {
      chatbotInstance?: ArticleChatbot;
      katex?: any;
      renderMathInElement?: any;
    }
  }

  // Chatbot functionality
  class ArticleChatbot {
    private isOpen = false;
    private isExpanded = false;
    private isTyping = false;
    private articleTitle: string;
    private lastKnownFontSize: number = 18;
    private fontSizeCheckInterval: ReturnType<typeof setInterval> | null = null;

    private toggle: HTMLElement | null = null;
    private interface: HTMLElement | null = null;
    private messages: HTMLElement | null = null;
    private input: HTMLInputElement | null = null;
    private sendBtn: HTMLElement | null = null;
    private minimize: HTMLElement | null = null;
    private expand: HTMLElement | null = null;
    private charCount: HTMLElement | null = null;
    private typingIndicator: HTMLElement | null = null;
    private chatIcon: HTMLElement | null = null;
    private closeIcon: HTMLElement | null = null;

    constructor() {
      const element = document.querySelector('#article-chatbot') as HTMLElement;
      this.articleTitle = element?.dataset.title || 'Article';
      this.init();
    }

    private init() {
      // Get elements
      this.toggle = document.getElementById('chatbot-toggle');
      this.interface = document.getElementById('chat-interface');
      this.messages = document.getElementById('chat-messages');
      this.input = document.getElementById('chat-input') as HTMLInputElement;
      this.sendBtn = document.getElementById('send-message');
      this.minimize = document.getElementById('minimize-chat');
      this.expand = document.getElementById('expand-chat');
      this.charCount = document.getElementById('char-count');
      this.typingIndicator = document.getElementById('typing-indicator');
      this.chatIcon = document.getElementById('chat-icon');
      this.closeIcon = document.getElementById('close-icon');

      // Bind events
      this.bindEvents();
      
      // Load KaTeX for math rendering
      this.loadKaTeX();
      
      // Hook into font size system
      this.setupFontSizeIntegration();
    }

    private setupFontSizeIntegration() {
      // Listen for font size changes - watch for style element changes
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'childList') {
            // Check for added nodes with the dynamic font style ID
            mutation.addedNodes.forEach((node) => {
              if (node.nodeType === Node.ELEMENT_NODE && (node as Element).id === 'dynamic-font-style') {
                setTimeout(() => this.updateChatbotFontSizes(), 50);
              }
            });
          }
        });
      });

      // Observe changes to the head element where font styles are added
      observer.observe(document.head, { childList: true, subtree: true });
      
      // Use a safer approach for localStorage monitoring without global override
      // Create a custom event-based system instead
      const checkFontSizeChanges = () => {
        const currentSize = parseInt(localStorage.getItem('blog-font-size') || '18');
        if (this.lastKnownFontSize !== currentSize) {
          this.lastKnownFontSize = currentSize;
          this.updateChatbotFontSizes();
        }
      };
      
      // Initialize font size tracking
      this.lastKnownFontSize = parseInt(localStorage.getItem('blog-font-size') || '18');
      
      // Check for font size changes periodically (safer than global override)
      this.fontSizeCheckInterval = setInterval(checkFontSizeChanges, 1000);
      
      // Also check for existing font size on initialization
      setTimeout(() => this.updateChatbotFontSizes(), 500);
    }

    // Cleanup method for font size monitoring
    private cleanup() {
      if (this.fontSizeCheckInterval) {
        clearInterval(this.fontSizeCheckInterval);
        this.fontSizeCheckInterval = null;
      }
    }

    updateChatbotFontSizes() {
      // Get current font size from localStorage or default
      const savedSize = parseInt(localStorage.getItem('blog-font-size') || '18');
      
      // Create or update chatbot-specific font styles
      let chatbotStyle = document.getElementById('chatbot-font-style');
      if (chatbotStyle) {
        chatbotStyle.remove();
      }

      const style = document.createElement('style');
      style.id = 'chatbot-font-style';
      style.textContent = `
        /* Chatbot message text */
        #chat-messages .prose-chatbot,
        #chat-messages .text-sm,
        #chat-messages p,
        #chat-messages div,
        #chat-messages span:not(.text-xs):not([class*="w-"]):not([class*="h-"]) {
          font-size: ${savedSize}px !important;
          line-height: 1.6 !important;
        }

        /* Chatbot welcome message */
        #chat-messages .text-sm.text-slate-700,
        #chat-messages .text-sm.dark\\:text-slate-300 {
          font-size: ${savedSize}px !important;
        }

        /* Chatbot input */
        #chat-input {
          font-size: ${savedSize}px !important;
        }

        /* Chatbot headers in messages */
        #chat-messages h1 {
          font-size: ${savedSize * 1.5}px !important;
        }
        
        #chat-messages h2 {
          font-size: ${savedSize * 1.375}px !important;
        }
        
        #chat-messages h3 {
          font-size: ${savedSize * 1.25}px !important;
        }

        /* Chatbot code blocks */
        #chat-messages code,
        #chat-messages pre {
          font-size: ${savedSize * 0.875}px !important;
        }

        /* Chatbot math expressions */
        #chat-messages .math-inline,
        #chat-messages .math-display,
        #chat-messages .katex {
          font-size: ${savedSize}px !important;
        }

        /* Quick question buttons - keep smaller */
        .quick-question {
          font-size: ${Math.min(savedSize * 0.75, 12)}px !important;
        }

        /* Character count and small UI elements */
        #char-count,
        .text-xs {
          font-size: ${Math.min(savedSize * 0.7, 11)}px !important;
        }

        /* Typing indicator */
        #typing-indicator span {
          font-size: ${Math.min(savedSize * 0.75, 12)}px !important;
        }
      `;
      
      document.head.appendChild(style);
    }

    private bindEvents() {
      // Toggle chat
      this.toggle?.addEventListener('click', () => this.toggleChat());
      this.minimize?.addEventListener('click', () => this.closeChat());
      this.expand?.addEventListener('click', () => this.toggleExpand());

      // Send message
      this.sendBtn?.addEventListener('click', () => this.sendMessage());
      this.input?.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          this.sendMessage();
        }
      });

      // Character count
      this.input?.addEventListener('input', () => this.updateCharCount());

      // Quick questions
      document.querySelectorAll('.quick-question').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const question = (e.target as HTMLElement).dataset.question;
          if (question && this.input) {
            this.input.value = question;
            this.sendMessage();
          }
        });
      });

      // Close on outside click (only when not expanded)
      document.addEventListener('click', (e) => {
        if (!document.getElementById('article-chatbot')?.contains(e.target as Node) && this.isOpen && !this.isExpanded) {
          this.closeChat();
        }
      });
    }

    private loadKaTeX() {
      // Load KaTeX CSS and JS for math rendering
      if (!document.querySelector('link[href*="katex"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css';
        document.head.appendChild(link);
      }

      if (!window.katex) {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js';
        script.onload = () => {
          // Load auto-render extension
          const autoRenderScript = document.createElement('script');
          autoRenderScript.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js';
          document.head.appendChild(autoRenderScript);
        };
        document.head.appendChild(script);
      }
    }

    private toggleExpand() {
      this.isExpanded = !this.isExpanded;
      
      if (this.isExpanded) {
        // Create backdrop
        const backdrop = document.createElement('div');
        backdrop.id = 'chat-backdrop';
        backdrop.style.cssText = `
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: rgba(0, 0, 0, 0.3);
          z-index: 9998;
          pointer-events: none;
        `;
        document.body.appendChild(backdrop);
        
        // Expand to medium size, centered
        if (this.interface) {
          this.interface.style.position = 'fixed';
          this.interface.style.top = '50%';
          this.interface.style.left = '50%';
          this.interface.style.transform = 'translate(-50%, -50%)';
          this.interface.style.width = '600px';
          this.interface.style.height = '500px';
          this.interface.style.maxWidth = '90vw';
          this.interface.style.maxHeight = '80vh';
          this.interface.style.zIndex = '9999';
          this.interface.style.right = 'auto';
          this.interface.style.bottom = 'auto';
          this.interface.style.pointerEvents = 'auto';
        }
        
        // Expand messages area
        if (this.messages) {
          this.messages.style.height = 'calc(100% - 160px)'; // Account for header and input
        }
        
        // Update expand button icon
        if (this.expand) {
          this.expand.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9V4.5M9 9H4.5M9 9L3.5 3.5M15 9h4.5M15 9V4.5M15 9l5.5-5.5M9 15v4.5M9 15H4.5M9 15l-5.5 5.5M15 15h4.5M15 15v4.5m0-4.5l5.5 5.5"></path>
            </svg>
          `;
          this.expand.title = 'Collapse chat';
        }
      } else {
        // Remove backdrop
        const backdrop = document.getElementById('chat-backdrop');
        if (backdrop) {
          backdrop.remove();
        }
        
        // Collapse back to normal size
        if (this.interface) {
          this.interface.style.position = 'absolute';
          this.interface.style.top = '';
          this.interface.style.left = '';
          this.interface.style.transform = '';
          this.interface.style.right = '0';
          this.interface.style.bottom = '64px'; // 4rem = 64px
          this.interface.style.width = '';
          this.interface.style.height = '';
          this.interface.style.maxWidth = '';
          this.interface.style.maxHeight = '';
          this.interface.style.zIndex = '';
          this.interface.style.pointerEvents = '';
        }
        
        // Reset messages area
        if (this.messages) {
          this.messages.style.height = '320px'; // 20rem = 320px
        }
        
        // Update expand button icon
        if (this.expand) {
          this.expand.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
            </svg>
          `;
          this.expand.title = 'Expand chat';
        }
      }
    }

    private toggleChat() {
      if (this.isOpen) {
        this.closeChat();
      } else {
        this.openChat();
      }
    }

    private openChat() {
      this.isOpen = true;
      this.interface?.classList.remove('hidden');
      
      // Animate opening
      setTimeout(() => {
        this.interface?.classList.remove('opacity-0', 'translate-y-4');
        this.interface?.classList.add('opacity-100', 'translate-y-0');
      }, 10);

      // Switch icons
      this.chatIcon?.classList.add('hidden');
      this.closeIcon?.classList.remove('hidden');

      // Focus input
      setTimeout(() => this.input?.focus(), 300);
    }

    private closeChat() {
      this.isOpen = false;
      
      // If chat was expanded, clean up backdrop and reset state
      if (this.isExpanded) {
        this.isExpanded = false;
        
        // Remove backdrop
        const backdrop = document.getElementById('chat-backdrop');
        if (backdrop) {
          backdrop.remove();
        }
        
        // Reset expand button icon
        if (this.expand) {
          this.expand.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
            </svg>
          `;
          this.expand.title = 'Expand chat';
        }
        
        // Reset interface styles
        if (this.interface) {
          this.interface.style.position = 'absolute';
          this.interface.style.top = '';
          this.interface.style.left = '';
          this.interface.style.transform = '';
          this.interface.style.right = '0';
          this.interface.style.bottom = '64px';
          this.interface.style.width = '';
          this.interface.style.height = '';
          this.interface.style.maxWidth = '';
          this.interface.style.maxHeight = '';
          this.interface.style.zIndex = '';
          this.interface.style.pointerEvents = '';
        }
        
        // Reset messages area
        if (this.messages) {
          this.messages.style.height = '320px';
        }
      }
      
      // Animate closing
      this.interface?.classList.remove('opacity-100', 'translate-y-0');
      this.interface?.classList.add('opacity-0', 'translate-y-4');
      
      setTimeout(() => {
        this.interface?.classList.add('hidden');
      }, 300);

      // Switch icons
      this.closeIcon?.classList.add('hidden');
      this.chatIcon?.classList.remove('hidden');
    }

    private async sendMessage() {
      const message = this.input?.value.trim();
      if (!message || this.isTyping) return;

      if (message.length > 500) {
        this.addMessage('Message too long. Please keep it under 500 characters.', 'bot');
        return;
      }

      const sanitizedMessage = message.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '');
      
      this.addMessage(sanitizedMessage, 'user');
      if (this.input) {
        this.input.value = '';
      }
      this.updateCharCount();

      this.showTyping();

      try {
        await this.generateResponseStreaming(sanitizedMessage);
      } catch (error) {
        this.hideTyping();
        this.addMessage("I'm sorry, I encountered an error. Please try again.", 'bot');
      }
    }

    private addMessage(content: string, type: 'user' | 'bot') {
      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex items-start gap-3';
      
      if (type === 'user') {
        messageDiv.classList.add('flex-row-reverse');
        messageDiv.innerHTML = `
          <div class="w-7 h-7 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="text-white text-xs">👤</span>
          </div>
          <div class="bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg px-3 py-2 shadow-sm max-w-xs">
            <div class="text-sm prose-chatbot-user">${this.escapeHtml(content)}</div>
          </div>
        `;
      } else {
        // For bot messages, parse markdown formatting
        const formattedContent = this.parseMarkdown(content);
        messageDiv.innerHTML = `
          <div class="w-7 h-7 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="text-white text-xs">🤖</span>
          </div>
          <div class="bg-white dark:bg-slate-700 rounded-lg px-3 py-2 shadow-sm border border-slate-200 dark:border-slate-600 max-w-xs">
            <div class="text-sm text-slate-700 dark:text-slate-300 prose-chatbot">${formattedContent}</div>
          </div>
        `;
      }

      this.messages?.appendChild(messageDiv);
      
      // Render math if this is a bot message
      if (type === 'bot') {
        this.renderMath(messageDiv);
      }
      
      this.scrollToBottom();
    }

    private parseMarkdown(text: string): string {
      if (!text) return '';
      
      // Escape HTML first to prevent XSS
      let escaped = this.escapeHtml(text);
      
      // Parse LaTeX math expressions BEFORE other markdown
      // Display math: \[ ... \] or $$ ... $$
      escaped = escaped.replace(/\\\[([\s\S]*?)\\\]/g, (match, math) => {
        return `<div class="math-display" data-math="${this.escapeHtml(math)}"></div>`;
      });
      escaped = escaped.replace(/\$\$([\s\S]*?)\$\$/g, (match, math) => {
        return `<div class="math-display" data-math="${this.escapeHtml(math)}"></div>`;
      });
      
      // Inline math: \( ... \) or $ ... $
      escaped = escaped.replace(/\\\((.*?)\\\)/g, (match, math) => {
        return `<span class="math-inline" data-math="${this.escapeHtml(math)}"></span>`;
      });
      escaped = escaped.replace(/\$([^$\n]+)\$/g, (match, math) => {
        return `<span class="math-inline" data-math="${this.escapeHtml(math)}"></span>`;
      });
      
      // Parse markdown formatting
      // Bold text: **text** or __text__
      escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-800 dark:text-slate-200">$1</strong>');
      escaped = escaped.replace(/__(.*?)__/g, '<strong class="font-bold text-slate-800 dark:text-slate-200">$1</strong>');
      
      // Italic text: *text* or _text_
      escaped = escaped.replace(/\*(.*?)\*/g, '<em class="italic text-slate-700 dark:text-slate-300">$1</em>');
      escaped = escaped.replace(/_(.*?)_/g, '<em class="italic text-slate-700 dark:text-slate-300">$1</em>');
      
      // Inline code: `code`
      escaped = escaped.replace(/`([^`]+)`/g, '<code class="bg-slate-100 dark:bg-slate-800 text-purple-600 dark:text-purple-400 px-1 py-0.5 rounded text-xs font-mono">$1</code>');
      
      // Code blocks: ```code```
      escaped = escaped.replace(/```([\s\S]*?)```/g, '<pre class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 p-2 rounded mt-2 mb-2 text-xs font-mono overflow-x-auto"><code>$1</code></pre>');
      
      // Line breaks: Convert \n to <br>
      escaped = escaped.replace(/\n/g, '<br>');
      
      // Lists: - item or * item
      escaped = escaped.replace(/^[\-\*]\s+(.+)$/gm, '<div class="flex items-start gap-2 my-1"><span class="text-purple-500 text-xs mt-0.5">•</span><span>$1</span></div>');
      
      // Numbered lists: 1. item
      escaped = escaped.replace(/^\d+\.\s+(.+)$/gm, '<div class="flex items-start gap-2 my-1"><span class="text-purple-500 text-xs mt-0.5 font-mono">•</span><span>$1</span></div>');
      
      // Headers: # Header, ## Header, ### Header
      escaped = escaped.replace(/^### (.+)$/gm, '<h3 class="font-semibold text-slate-800 dark:text-slate-200 mt-2 mb-1">$1</h3>');
      escaped = escaped.replace(/^## (.+)$/gm, '<h2 class="font-bold text-slate-800 dark:text-slate-200 mt-2 mb-1">$1</h2>');
      escaped = escaped.replace(/^# (.+)$/gm, '<h1 class="font-bold text-lg text-slate-800 dark:text-slate-200 mt-2 mb-1">$1</h1>');
      
      // Links: [text](url)
      escaped = escaped.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-purple-600 dark:text-purple-400 hover:underline" target="_blank" rel="noopener noreferrer">$1</a>');
      
      // Strikethrough: ~~text~~
      escaped = escaped.replace(/~~(.*?)~~/g, '<del class="line-through text-slate-500 dark:text-slate-400">$1</del>');
      
      return escaped;
    }

    private renderMath(element: HTMLElement) {
      // Render math expressions using KaTeX
      if (window.katex && window.renderMathInElement) {
        // Render inline math
        element.querySelectorAll('.math-inline').forEach(mathEl => {
          const math = mathEl.getAttribute('data-math');
          if (math) {
            try {
              const rendered = window.katex.renderToString(math, {
                displayMode: false,
                throwOnError: false,
                output: 'html'
              });
              mathEl.innerHTML = rendered;
              mathEl.classList.add('katex-rendered');
            } catch (error) {
              console.warn('Failed to render inline math:', math, error);
              mathEl.innerHTML = `\\(${math}\\)`;
            }
          }
        });

        // Render display math
        element.querySelectorAll('.math-display').forEach(mathEl => {
          const math = mathEl.getAttribute('data-math');
          if (math) {
            try {
              const rendered = window.katex.renderToString(math, {
                displayMode: true,
                throwOnError: false,
                output: 'html'
              });
              mathEl.innerHTML = rendered;
              mathEl.classList.add('katex-rendered', 'text-center', 'my-2');
            } catch (error) {
              console.warn('Failed to render display math:', math, error);
              mathEl.innerHTML = `\\[${math}\\]`;
            }
          }
        });
      } else {
        // Fallback: show raw LaTeX if KaTeX not loaded
        setTimeout(() => this.renderMath(element), 100);
      }
    }

    private showTyping() {
      this.isTyping = true;
      this.typingIndicator?.classList.remove('hidden');
      this.sendBtn?.setAttribute('disabled', 'true');
      this.scrollToBottom();
    }

    private hideTyping() {
      this.isTyping = false;
      this.typingIndicator?.classList.add('hidden');
      this.sendBtn?.removeAttribute('disabled');
    }

    private async simulateThinking(): Promise<void> {
      // Realistic delay between 1-3 seconds
      const delay = 1000 + Math.random() * 2000;
      return new Promise(resolve => setTimeout(resolve, delay));
    }

    private async generateResponseStreaming(message: string, retryCount = 0): Promise<void> {
      const MAX_RETRIES = 2;
      const RETRY_DELAY = 2000;

      const startTime = Date.now();

      try {
        const articleElement = document.querySelector('#Article, article, .prose, .mdx-content');
        const articleContent = articleElement ? articleElement.textContent : '';
        
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 60000);

        const fetchStartTime = Date.now();

        const response = await fetch('/api/chatbot', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            message: message,
            articleTitle: this.articleTitle,
            articleContent: articleContent ? articleContent.substring(0, 4000) : ''
          }),
          signal: controller.signal
        });

        const fetchDuration = Date.now() - fetchStartTime;

        clearTimeout(timeoutId);

        if (!response.ok) {
          if (response.status === 429) {
            throw new Error('RATE_LIMIT');
          } else if (response.status >= 500) {
            throw new Error('SERVER_ERROR');
          }
          throw new Error(`API request failed: ${response.status}`);
        }

        this.hideTyping();
        
        const messageDiv = this.createBotMessageContainer();
        const contentDiv = messageDiv.querySelector('.prose-chatbot') as HTMLElement;
        
        const reader = response.body?.getReader();
        const decoder = new TextDecoder();
        let fullResponse = '';

        if (!reader) {
          throw new Error('No response body');
        }

        let chunkCount = 0;
        let firstChunkTime: number | null = null;
        let lastChunkTime = Date.now();
        const STREAM_TIMEOUT = 30000;

        while (true) {
          const streamTimeoutId = setTimeout(() => {
            if (Date.now() - lastChunkTime > STREAM_TIMEOUT) {
              reader.cancel();
              throw new Error('STREAM_TIMEOUT');
            }
          }, 1000);

          const chunkStartTime = Date.now();
          const { done, value } = await reader.read();
          clearTimeout(streamTimeoutId);
          
          if (done) {
            const totalDuration = Date.now() - startTime;
            break;
          }

          chunkCount++;
          if (firstChunkTime === null) {
            firstChunkTime = Date.now();
            const timeToFirstChunk = firstChunkTime - startTime;
          }

          lastChunkTime = Date.now();
          const chunk = decoder.decode(value, { stream: true });
          const lines = chunk.split('\n').filter(line => line.trim());

          for (const line of lines) {
            try {
              const json = JSON.parse(line);
              if (json.response) {
                const renderStartTime = Date.now();
                fullResponse += json.response;
                contentDiv.innerHTML = this.parseMarkdown(fullResponse);
                this.renderMath(messageDiv);
                this.scrollToBottom();
                const renderDuration = Date.now() - renderStartTime;
              }
              if (json.error) {
                if (json.error.includes('rate limit') || json.error.includes('Too many')) {
                  throw new Error('RATE_LIMIT');
                }
                contentDiv.innerHTML = this.parseMarkdown(json.fallback || this.getFallbackResponse(message));
                return;
              }
            } catch (e) {
              if (e instanceof Error && (e.message === 'RATE_LIMIT' || e.message === 'SERVER_ERROR' || e.message === 'STREAM_TIMEOUT')) {
                throw e;
              }
            }
          }
        }

        if (!fullResponse) {
          contentDiv.innerHTML = this.parseMarkdown(this.getFallbackResponse(message));
        }
        
      } catch (error) {
        console.error('Error calling chatbot API:', error);
        this.hideTyping();

        if (error instanceof Error) {
          if (error.name === 'AbortError') {
            this.addErrorMessage(message, 'timeout', retryCount, MAX_RETRIES);
            return;
          }

          if ((error.message === 'RATE_LIMIT' || error.message === 'SERVER_ERROR' || error.message === 'STREAM_TIMEOUT') && retryCount < MAX_RETRIES) {
            this.addRetryMessage(message, retryCount + 1, MAX_RETRIES, error.message);
            await new Promise(resolve => setTimeout(resolve, RETRY_DELAY * (retryCount + 1)));
            this.showTyping();
            await this.generateResponseStreaming(message, retryCount + 1);
            return;
          }

          if (error.message === 'RATE_LIMIT') {
            this.addErrorMessage(message, 'rate_limit', retryCount, MAX_RETRIES);
            return;
          }
        }

        this.addErrorMessage(message, 'generic', retryCount, MAX_RETRIES);
      }
    }

    private addErrorMessage(originalMessage: string, errorType: string, retryCount: number, maxRetries: number) {
      let errorText = '';
      let showRetry = retryCount < maxRetries;

      switch (errorType) {
        case 'timeout':
          errorText = '⏱️ **Request Timeout**\n\nThe request took too long to complete. This might be due to:\n- High server load\n- Network connectivity issues\n- Large article content';
          break;
        case 'rate_limit':
          errorText = '🚦 **Rate Limit Reached**\n\nToo many requests in a short time. Please wait a moment before trying again.';
          showRetry = false;
          break;
        case 'generic':
        default:
          errorText = '❌ **Connection Error**\n\nI\'m having trouble connecting to the AI service. This could be due to:\n- Temporary server issues\n- Network connectivity problems\n- Service maintenance';
          break;
      }

      if (showRetry) {
        errorText += '\n\n*Click the retry button below to try again.*';
      } else if (retryCount >= maxRetries) {
        errorText += '\n\n*Maximum retry attempts reached. Please try again later.*';
      }

      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex flex-col gap-2';
      
      const errorMessageDiv = document.createElement('div');
      errorMessageDiv.className = 'flex items-start gap-3';
      errorMessageDiv.innerHTML = `
        <div class="w-7 h-7 bg-gradient-to-r from-red-500 to-orange-500 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs">⚠️</span>
        </div>
        <div class="bg-red-50 dark:bg-red-900/20 rounded-lg px-3 py-2 shadow-sm border border-red-200 dark:border-red-800 max-w-xs">
          <div class="text-sm text-red-800 dark:text-red-200 prose-chatbot">${this.parseMarkdown(errorText)}</div>
        </div>
      `;

      if (showRetry) {
        const retryButton = document.createElement('button');
        retryButton.className = 'ml-10 px-3 py-1.5 text-xs bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition-colors flex items-center gap-1.5';
        retryButton.innerHTML = `
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          Retry
        `;
        retryButton.onclick = async () => {
          retryButton.disabled = true;
          retryButton.innerHTML = 'Retrying...';
          messageDiv.remove();
          this.showTyping();
          await this.generateResponseStreaming(originalMessage, retryCount);
        };
        messageDiv.appendChild(errorMessageDiv);
        messageDiv.appendChild(retryButton);
      } else {
        messageDiv.appendChild(errorMessageDiv);
      }

      this.messages?.appendChild(messageDiv);
      this.scrollToBottom();
    }

    private addRetryMessage(message: string, retryAttempt: number, maxRetries: number, errorType: string) {
      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex items-start gap-3 retry-message';
      
      let retryReason = 'Connection issue';
      if (errorType === 'RATE_LIMIT') retryReason = 'Rate limit';
      else if (errorType === 'STREAM_TIMEOUT') retryReason = 'Stream timeout';
      else if (errorType === 'SERVER_ERROR') retryReason = 'Server error';

      messageDiv.innerHTML = `
        <div class="w-7 h-7 bg-gradient-to-r from-yellow-500 to-orange-500 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs">🔄</span>
        </div>
        <div class="bg-yellow-50 dark:bg-yellow-900/20 rounded-lg px-3 py-2 shadow-sm border border-yellow-200 dark:border-yellow-800 max-w-xs">
          <div class="text-sm text-yellow-800 dark:text-yellow-200">
            <strong>${retryReason} detected.</strong> Retrying... (Attempt ${retryAttempt}/${maxRetries})
          </div>
        </div>
      `;

      this.messages?.appendChild(messageDiv);
      this.scrollToBottom();

      setTimeout(() => {
        messageDiv.remove();
      }, 3000);
    }

    private createBotMessageContainer(): HTMLElement {
      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex items-start gap-3';
      messageDiv.innerHTML = `
        <div class="w-7 h-7 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs">🤖</span>
        </div>
        <div class="bg-white dark:bg-slate-700 rounded-lg px-3 py-2 shadow-sm border border-slate-200 dark:border-slate-600 max-w-xs">
          <div class="text-sm text-slate-700 dark:text-slate-300 prose-chatbot"></div>
        </div>
      `;
      this.messages?.appendChild(messageDiv);
      return messageDiv;
    }

    private getFallbackResponse(message: string): string {
      // Enhanced fallback responses when API fails
      const lowerMessage = message.toLowerCase();
      
      if (lowerMessage.includes('summary') || lowerMessage.includes('summarize')) {
        return `I'd be happy to help summarize this article! While I'm experiencing some connectivity issues with my AI services, the article **"${this.articleTitle}"** contains valuable insights. 

Here are some ways to explore it:
- Read the **introduction** for context
- Focus on *key examples* and code snippets
- Check out the \`implementation details\`

Please refer to the main sections for the core concepts.`;
      }
      
      if (lowerMessage.includes('explain') || lowerMessage.includes('what is')) {
        return `Great question! While I'm having some technical difficulties accessing my full capabilities, the article provides detailed explanations for the concepts you're asking about.

**Tip**: Look for these sections in **"${this.articleTitle}"**:
- Code examples with \`syntax highlighting\`
- *Step-by-step* explanations
- **Important concepts** highlighted throughout

I recommend checking the relevant sections for detailed explanations.`;
      }
      
      if (lowerMessage.includes('code') || lowerMessage.includes('example')) {
        return `The code examples in **"${this.articleTitle}"** are designed to be self-explanatory with comments. 

While I'm currently experiencing some technical issues, here's how to approach the code:

1. **Read the comments** - they explain each step
2. **Try running** the examples yourself  
3. **Experiment** with different inputs
4. **Look for patterns** in the implementation

The article's examples should help clarify the implementation details.`;
      }
      
      return `I'm currently experiencing some technical difficulties, but I'd still like to help! 

The article **"${this.articleTitle}"** should contain the information you're looking for. Here are some suggestions:

- **Browse the headings** to find relevant sections
- **Look for highlighted concepts** and examples
- **Try the code snippets** if available
- **Check related links** or references

Could you try referring to specific sections of the article, or try your question again?`;
    }

    private updateCharCount() {
      const length = this.input?.value.length || 0;
      if (this.charCount) {
        this.charCount.textContent = `${length}/500`;
        
        // Change color based on character count
        if (length > 450) {
          this.charCount.className = 'text-xs text-red-500';
        } else if (length > 400) {
          this.charCount.className = 'text-xs text-yellow-500';
        } else {
          this.charCount.className = 'text-xs text-slate-400';
        }
      }
    }

    private scrollToBottom() {
      if (this.messages) {
        this.messages.scrollTop = this.messages.scrollHeight;
      }
    }

    private escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  }

  // Initialize chatbot when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    // Use a safer namespaced approach
    (window as any).blogChatbot = new ArticleChatbot();
  });

  // Handle Astro page loads
  document.addEventListener('astro:page-load', () => {
    (window as any).blogChatbot = new ArticleChatbot();
  });
</script>

